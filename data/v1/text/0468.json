[{"i":"df95f1da-9e42-4f3b-b34b-50e23b3b0d86","t":"織婦","a":"處默","d":"唐","g":"短诗","p":["蓬鬢蓬門積恨多，夜闌燈下不停梭。","成縑猶自陪錢納，未直青樓一曲歌。"],"s":"trad","f":"simp"},{"i":"021259c6-3fb7-4e1e-9fce-17b453c4e106","t":"句","a":"處默","d":"唐","g":"短诗","p":["太平時節無人看，雪刃閑封滿匣塵。"],"s":"trad","f":"simp"},{"i":"44f6bfb2-a329-465b-82b5-75400f5ecfd4","t":"秋日閑居","a":"修睦","d":"唐","g":"短诗","p":["是事不相關，誰人似此閑。","卷簾當白晝，移榻對青山。","野鶴眠松上，秋苔長雨間。","岳僧頻有信，昨日得書還。"],"s":"mixed","f":"simp"},{"i":"15234a58-dec1-45d7-9e3a-e06a1484b1c7","t":"宿岳陽開元寺","a":"修睦","d":"唐","g":"短诗","p":["竟夕憑虛檻，何當興歎頻。","往來人自老，今古月常新。","風逆沈魚唱，松疎露鶴身。","無眠鐘又動，幾客在迷津。"],"s":"mixed","f":"simp"},{"i":"c1aa3c81-c47f-4201-bfe0-d85f933fd671","t":"送邊將","a":"修睦","d":"唐","g":"短诗","p":["人盡有離別，而君獨可嗟。","言將身報國，敢望祿榮家。","戰思風吹野，鄉心月照沙。","歸期定何日，塞北樹無花。"],"s":"trad","f":"simp"},{"i":"5d806b2e-0e90-4790-9aa8-1bd34ebd186b","t":"雪中送人北遊","a":"修睦","d":"唐","g":"短诗","p":["然知心去速，其奈雪飛頻。","莫喜無危道，雖平更陷人。","遠郊光接漢，曠野色通秦。","此去迢遙極，却回應過春。"],"s":"mixed","f":"simp"},{"i":"27ce7c9c-eab7-4d70-ac69-4bf7cf7db5a7","t":"落葉","a":"修睦","d":"唐","g":"短诗","p":["雨過閑田地，重重落葉紅。","翻思向春日，肯信有秋風。","幾處隨流水，河邊亂暮空。","秪應松自立，而不與君同。"],"s":"trad","f":"simp"},{"i":"eb09df72-3dd3-4c98-8296-d3add5beec30","t":"落花","a":"修睦","d":"唐","g":"短诗","p":["一片又一片，等閑苔面紅。","不能延數日，開亦是春風。","公子歌聲歇，詩人眼界空。","遙思故山下，經雨兩三叢。"],"s":"trad","f":"simp"},{"i":"0e0cc50d-f64b-4f34-81f3-82162a0e5797","t":"題田道者院","a":"修睦","d":"唐","g":"短诗","p":["入門空寂寂，真箇出家兒。","有行鬼不見，無心人謂癡。","古巖寒柏對，流水落花隨。","欲別一何嬾，相從所恨遲。"],"s":"mixed","f":"simp"},{"i":"ecedbedb-0105-4c06-b1e2-6d228fcc1d66","t":"東林寺","a":"修睦","d":"唐","g":"短诗","p":["欲去不忍去，徘徊吟繞廊。","水光秋澹蕩，僧好語尋常。","碑古苔文疊，山晴鐘韻長。","翻思南嶽上，欠此白蓮香。"],"s":"trad","f":"simp"},{"i":"bbc9b01a-1d32-4f48-8e6e-57608d18727e","t":"寄貫休上人","a":"修睦","d":"唐","g":"短诗","p":["常語亦關詩，常流安得知。","楚郊來未久，吳地住多時。","立月無人近，歸林有鶴隨。","所居渾不遠，相識偶然遲。"],"s":"trad","f":"simp"},{"i":"38e58ff3-3798-41fb-a24c-cf426ac6a448","t":"喜僧友到","a":"修睦","d":"唐","g":"短诗","p":["十年消息斷，空使夢煙蘿。","嵩嶽幾時下，洞庭何日過。","瓶乾離澗久，衲壞臥雲多。","意欲相留住，游方肯舍麽。"],"s":"mixed","f":"simp"},{"i":"c5432009-d47e-4967-a3cf-a69df2097e82","t":"懷虛中上人","a":"修睦","d":"唐","g":"短诗","p":["簷雨滴更殘，思君安未安。","湘川聞不遠，道路去尋難。","吟鬢霜應蝕，禪衣雪漸寒。","倚松因獨立，一鳥下江干。"],"s":"trad","f":"simp"},{"i":"87d6f59f-c5e9-41c3-b50d-425a27118e22","t":"簡寂觀","a":"修睦","d":"唐","g":"短诗","p":["正同高士坐煙霞，思著閑忙又是嗟。","碧岫觀中人似鶴，紅塵路上事如麻。","石肥滯雨添蒼蘚，松老涵風落翠花。","莫道此間無我分，遺民長在惠持家。"],"s":"trad","f":"simp"},{"i":"c0b2822b-c3a2-4131-b389-a26a669cbf34","t":"睡起作","a":"修睦","d":"唐","g":"短诗","p":["長空秋雨歇，睡起覺精神。","看水看山坐，無名無利身。","偈吟諸祖意，茶碾去年春。","此外誰相識，孤雲到砌頻。"],"s":"trad","f":"simp"},{"i":"9286f193-d032-4fa3-bfe4-0be15744c9eb","t":"賣松者","a":"修睦","d":"唐","g":"短诗","p":["求利有何限，將松入市來。","直饒人買去，也向柳邊栽。","細葉猶粘雪，孤根尚惹苔。","知君用心錯，舉世重花開。"],"s":"trad","f":"simp"},{"i":"048b5ca3-0baa-44d1-866a-57ba47125a58","t":"思齊己上人","a":"修睦","d":"唐","g":"短诗","p":["同人與流俗，相謂好襟靈。","有口不他說，長年自誦經。","水聲秋後石，山色晚來庭。","客問修何法，指松千歲青。"],"s":"trad","f":"simp"},{"i":"f7f86afd-654a-4ad9-9716-1c4b159ddbe4","t":"送玄泰禪師","a":"修睦","d":"唐","g":"短诗","p":["去去去何住，一盂兼一瓶。","水邊寒草白，島外晚峰青。","宿處林聞虎，行時天有星。","回期誰可定，浮世重看經。"],"s":"trad","f":"simp"},{"i":"16f0adc7-ea5d-485d-b09b-8e8845044975","t":"三生石","a":"修睦","d":"唐","g":"短诗","p":["聖迹誰會得，每到亦徘徊。","一尚不可得，三從何處來。","清宵寒露滴，白晝野雲隈。","應是表靈異，凡情安可猜。"],"s":"mixed","f":"simp"},{"i":"f020c2a1-d202-4922-bce4-387eeeea7cd4","t":"題僧夢微房","a":"修睦","d":"唐","g":"短诗","p":["東海日未出，九衢人已行。","吾師無事坐，苔蘚入門生。","雨過閑花落，風來古木聲。","天台頻說法，石壁欠題名。"],"s":"trad","f":"simp"},{"i":"25d7f357-1554-43a4-8688-3bd027cadc36","t":"秋臺作","a":"修睦","d":"唐","g":"短诗","p":["獨上高樓上，客情何物同。","孤雲無定處，長日信秋風。","兄弟多年別，關河此夕中。","到頭歸去是，免使歎洪濛。"],"s":"trad","f":"simp"},{"i":"18463c2e-0730-4b72-8214-c8448f6b8566","t":"懷故園","a":"修睦","d":"唐","g":"短诗","p":["故園歸未得，此日意何傷。","獨坐水邊草，水流春日長。"],"s":"trad","f":"simp"},{"i":"079143ac-83f5-48e4-8fc9-40297701aa69","t":"謝武肅王","a":"無作","d":"唐","g":"短诗","p":["雲鶴性孤單，爭堪名利關。","銜恩雖入國，辭命却歸山。"],"s":"mixed","f":"simp"},{"i":"639b3939-c861-43d4-8228-8765fc97b9f8","t":"哭僧","a":"清尚","d":"唐","g":"短诗","p":["道力自超然，身亡同坐禪。","水流元在海，月落不離天。","溪白葬時雪，風香焚處煙。","世人頻下淚，不見我師玄。"],"s":"trad","f":"simp"},{"i":"96fd575b-1bc3-4bc2-ae45-8bab9fc348d0","t":"投謁齊己","a":"乾康","d":"唐","g":"短诗","p":["隔岸紅塵忙似火，當軒青嶂冷如冰。","烹茶童子休相問，報道門前是衲僧。"],"s":"trad","f":"simp"},{"i":"1dff6459-89b1-4569-8bb1-394183e706e3","t":"賦殘雪","a":"乾康","d":"唐","g":"短诗","p":["六出奇花已住開，郡城相次見樓臺。","時人莫把和泥看，一片飛從天上來。"],"s":"trad","f":"simp"},{"i":"84914311-08ad-4d7f-b270-96b68e642831","t":"句","a":"乾康","d":"唐","g":"短诗","p":["鏡湖中有月，處士後無人。","荻笋抽高節，鱸魚躍老鱗。"],"s":"mixed","f":"simp"},{"i":"36721980-a020-45b3-a6c5-aef15ffeac13","t":"招隱","a":"曇翼","d":"唐","g":"古体","p":["連峰數千里，修林帶平津。","雲起遠山翳，風至□荒榛。","茅茨隱不見，雞鳴知有人。","躡磴踐其跡，處處見遺薪。","乃知百代下，固有上皇民。"],"s":"trad","f":"simp"},{"i":"3ff1c567-fdc9-4074-a407-5e924babb4c3","t":"石橋琪樹","a":"隱求","d":"唐","g":"短诗","p":["山上天將近，人間路漸遙。","誰當雲裏見，知欲渡仙橋。"],"s":"mixed","f":"simp"},{"i":"468989a5-0c33-488a-ab49-05d65c5444e0","t":"律僧","a":"智遠","d":"唐","g":"短诗","p":["濾水與龕燈，長長護有情。","自從青草出，便不下階行。","北闕應無夢，南山舊有名。","將何喻浮世，惟指浪漚輕。"],"s":"trad","f":"simp"},{"i":"bec8a074-2a1c-4859-a40e-24e878910fff","t":"暮春送人","a":"無悶","d":"唐","g":"短诗","p":["折柳亭邊手重攜，江煙澹澹草萋萋。","杜鵑不解離人意，更向落花枝上啼。"],"s":"trad","f":"simp"},{"i":"00a09c6e-99bd-4d5d-8bb5-a55d580673be","t":"寒林石屏","a":"無悶","d":"唐","g":"短诗","p":["草堂無物伴身閑，惟有屏風枕簟間。","本向他山求得石，却於石上看他山。"],"s":"mixed","f":"simp"},{"i":"7a5c02f2-ba1a-4d02-938e-99c57e580258","t":"江上秋志","a":"尚志","d":"唐","g":"短诗","p":["到來江上久，誰念旅游心。","故國無秋信，隣家有暮砧。","坐遙翻不睡，愁極却成吟。","即恐髭連鬢，還爲白所侵。"],"s":"mixed","f":"simp"},{"i":"fada1a94-40e4-4c5a-a484-febb24eb2e78","t":"路","a":"玄寶","d":"唐","g":"短诗","p":["南北東西去，茫茫萬古塵。","關河無盡處，風雪有行人。","險極山通蜀，平多地入秦。","營營名利者，來往豈辭頻。"],"s":"trad","f":"simp"},{"i":"0c2fd0f8-90e3-4790-94ba-7714cca5905d","t":"贈智舟三藏","a":"懷浦","d":"唐","g":"短诗","p":["壯歲心難伏，師心伏豈難。","尋常獨在院，行坐不離壇。","岳雪當禪暝，松聲入咒寒。","更因文字外，多把史書看。"],"s":"mixed","f":"simp"},{"i":"63c10bec-1587-4264-9821-0c16864d5f01","t":"初冬旅舍早懷","a":"懷浦","d":"唐","g":"短诗","p":["枕上角聲微，離情未息機。","夢回三楚寺，寒入五更衣。","月沒棲禽動，霜晴凍葉飛。","自慙行役早，深與道相違。"],"s":"trad","f":"simp"},{"i":"02f270a1-676f-4385-a33e-2d4b7db7be5e","t":"對御書後一絕","a":"亞棲","d":"唐","g":"短诗","p":["通神筆法得玄門，親入長安謁至尊。","莫怪出來多意氣，草書曾悅聖明君。"],"s":"trad","f":"simp"},{"i":"dec2fee7-6e47-4f44-b57e-f3c4c40ceef5","t":"題英禪師","a":"亞棲","d":"唐","g":"短诗","p":["將知德行異尋常，每見持經在道場。","欲識用心精潔處，一瓶秋水一爐香。"],"s":"trad","f":"simp"},{"i":"5455b735-c6e9-4a0b-ba42-b9222d745bf9","t":"別友人","a":"惟審","d":"唐","g":"短诗","p":["一身無定處，萬里獨銷魂。","芳草迷歸路，春衣滴淚痕。","幾時休旅食，向夜宿江村。","欲識異鄉苦，空山啼暮猨。"],"s":"mixed","f":"simp"},{"i":"011b8349-5bb4-4515-8c7c-15d806536c9d","t":"賦得聞曉鶯啼","a":"惟審","d":"唐","g":"短诗","p":["捲簾清夢後，芳樹引流鶯。","隔葉傳春意，穿花送曉聲。","未調雲路翼，空負桂枝情。","莫盡關關興，羇愁正厭生。"],"s":"trad","f":"simp"},{"i":"9d1b26f2-0a5d-4b77-80ee-91f44dead780","t":"春日旅懷呈知己","a":"惟審","d":"唐","g":"短诗","p":["生涯萬事有蒼蒼，應任流萍便越鄉。","春水獨行人漸遠，故園歸夢夜空長。","一聲隔浦猨啼處，數滴驚心淚滿裳。","不爲知音皆鮑叔，信誰江上去茫茫。"],"s":"mixed","f":"simp"},{"i":"898882b9-127f-4f74-9b98-f5258036076e","t":"劒客","a":"慕幽","d":"唐","g":"短诗","p":["去住知何處，空將一劒行。","殺人雖取次，爲事愛公平。","戟立嗔髭鬢，星流忿眼睛。","曉來湘市說，拂曙別遼城。"],"s":"mixed","f":"simp"},{"i":"eb994ba4-7e85-41f6-886f-95cb38771e7d","t":"酬和友人見寄","a":"慕幽","d":"唐","g":"短诗","p":["勞歌好自看，終久偶齊桓。","五字若教易，一名爭得難。","侵窓紅樹老，蔭砌雪花殘。","莫効齊僚屬，東歸翦釣竿。"],"s":"trad","f":"simp"},{"i":"495e2566-51a4-4aa0-ae50-8868e1942ddd","t":"冬日淮上別文上人","a":"慕幽","d":"唐","g":"短诗","p":["家國各萬里，同吟六七年。","可堪隨北雁，迢遰向南天。","水共行人遠，山將落日連。","春淮有雙鯉，莫忘尺書傳。"],"s":"mixed","f":"simp"},{"i":"1379e014-4fd6-49dc-b247-f0da2f901ee2","t":"柳","a":"慕幽","d":"唐","g":"短诗","p":["今古憑君一贈行，幾回折盡復重生。","五株斜傍淵明宅，千樹低垂太尉營。","臨水帶煙藏翡翠，倚風兼雨宿流鶯。","隋皇隄畔依依在，曾惹當時歌吹聲。"],"s":"trad","f":"simp"},{"i":"27869dc6-5d63-42a1-879c-8f59d7cb8d13","t":"三峽聞猨","a":"慕幽","d":"唐","g":"短诗","p":["誰向茲來不恨生，聲聲都是斷腸聲。","七千里外一家住，十二峰前獨自行。","瘴雨晚藏神女廟，蠻煙寒鎖夜郎城。","憑君且聽哀吟好，會待青雲道路平。"],"s":"mixed","f":"simp"},{"i":"8a5c8257-7977-4e22-b1ae-0f9eeba6c10e","t":"燈","a":"慕幽","d":"唐","g":"短诗","p":["鐘斷危樓鳥不飛，熒熒何處最相宜。","香然水寺僧開卷，筆寫春幃客著詩。","忽爾思多穿壁處，偶然心盡斷纓時。","孫康勤苦誰能念，少減餘光借與伊。"],"s":"trad","f":"simp"},{"i":"2976c300-2c2e-4853-8603-bfe0feba7b6e","t":"寶琴","a":"釋彪","d":"唐","g":"短诗","p":["吾有一寶琴，價重雙南金。","刻作龍鳳象，彈爲山水音。","星從徽裏發，風來弦上吟。","鍾期不可遇，誰辨曲中心。"],"s":"mixed","f":"simp"},{"i":"848877f9-a8d2-43eb-890d-ba7cbad2426a","t":"觀大駕出敘事寄懷","a":"法輪","d":"唐","g":"古体","p":["紫臺宵漏竭，青門曙鼓通。","輕霞照複道，徐吹轉相風。","玉鸞光萬騎，金輿鬱五戎。","鳴笳猶度闕，清蹕尚喧宮。","雲旗亂陌紫，羽斾雜塵紅。","百城歸北麗，兩漢久慚雄。","吾曹陋薄技，餘慶洽微躬。","平原已起洛，印手亦還豐。","得奉衣冠盛，仍觀書軌同。","猶言待封告，未忍向華嵩。"],"s":"trad","f":"simp"},{"i":"102a90fd-ea23-4952-841e-ea1790ad20da","t":"中秋旅懷","a":"尚能","d":"唐","g":"短诗","p":["所畜惟騷雅，兼之得固窮。","望鄉連北斗，聽雨帶西風。","稼穡村坊遠，煙波路逕通。","冥搜清絕句，恰似有神功。"],"s":"trad","f":"simp"},{"i":"7381d894-f04d-4e34-b9e1-ca73a9464ebd","t":"句","a":"尚能","d":"唐","g":"短诗","p":["霜洲楓落盡，月館竹生寒。"],"s":"trad","f":"simp"},{"i":"63b0385a-7165-484b-afcc-d827c4cd4223","t":"題伍相廟","a":"常雅","d":"唐","g":"短诗","p":["蒼蒼古廟映林巒，漠漠煙霞覆古壇。","精魄不知何處在，威風猶入浙江寒。"],"s":"trad","f":"simp"},{"i":"1c650469-d210-4636-95ee-35d61db64c52","t":"懷舊山","a":"滄浩","d":"唐","g":"短诗","p":["一坐西林寺，從來未下山。","不因尋長者，無事到人間。","宿雨愁爲客，寒花笑未還。","空懷舊山月，童子誦經閑。"],"s":"mixed","f":"simp"},{"i":"2798a0f7-37cc-4f0a-ab07-142f30060b4c","t":"題慧山泉","a":"若水","d":"唐","g":"短诗","p":["石脈綻寒光，松根噴曉涼。","注缾雲母滑，漱齒茯苓香。","野客偷煎茗，山僧借淨牀。","安禪何所問，孤月在中央。"],"s":"mixed","f":"simp"},{"i":"97c62642-6862-4ebd-b939-1b2073f2f24b","t":"題馬跡山","a":"文鑒","d":"唐","g":"短诗","p":["瀛洲西望沃洲山，山在平湖縹緲間。","常說使君千里馬，至今龍跡尚堪攀。"],"s":"trad","f":"simp"},{"i":"8edb1c49-bcac-4f90-9b45-9aa8a9913ade","t":"和御製遊慈恩寺","a":"慈恩寺沙門","d":"唐","g":"短诗","p":["皇風扇祇樹，至德茂禪林。","仙華曜日彩，神旛曳遠陰。","綺殿籠霞影，飛閣出雲心。","細草希慈澤，恩光重更深。"],"s":"trad","f":"simp"},{"i":"d7b84a93-68f2-4417-9393-a8f9a829196e","t":"贈賈松先輩","a":"水心寺僧","d":"唐","g":"短诗","p":["嵯峨山上石，歲歲色長新。","若使盡成寶，誰爲知己人。"],"s":"mixed","f":"simp"},{"i":"462a9b2c-c4cf-422f-838f-9f3565a84b35","t":"古梅","a":"無名釋","d":"唐","g":"短诗","p":["火虐風饕水漬根，霜皴雪皺古苔痕。","東風未肯隨寒暑，又蘖清香與返魂。"],"s":"mixed","f":"simp"},{"i":"568c138d-8242-488f-bc93-400338a27dac","t":"月","a":"南唐失名僧","d":"唐","g":"短诗","p":["徐徐東海出，漸漸上天衢。","此夜一輪滿，清光何處無。"],"s":"trad","f":"simp"},{"i":"0b48cfab-7638-4dff-b054-f5feea86bb07","t":"武肅王有旨石橋設齋會進士一詩共六首 一","a":"吳越僧","d":"唐","g":"短诗","p":["南有天台事可尊，孕靈含秀獨超羣。","重重曲澗侵危石，步步層巖踏碎雲。","金雀每從雲裏現，異香多向夜深聞。","當知此界非凡界，一道幽奇各自分。"],"s":"mixed","f":"simp"},{"i":"026b6449-e74d-4bd0-a8f0-8b7a4ff7ffa0","t":"武肅王有旨石橋設齋會進士一詩共六首 二","a":"吳越僧","d":"唐","g":"短诗","p":["仙源佛窟有天台，今古嘉名遍九垓。","石磴嵌空神匠出，瀑泉雄壯雨聲來。","景強偏感高僧上，地勝能令遠思開。","一等翹誠依此處，自然靈貺作梯媒。"],"s":"trad","f":"simp"},{"i":"c4d9400d-14e7-463f-83b0-701ee6123fc2","t":"武肅王有旨石橋設齋會進士一詩共六首 三","a":"吳越僧","d":"唐","g":"短诗","p":["智泉福海莫能逾，親自王恩運睿謨。","感現盡冥心境界，資持全固道根株。","石梁低翥紅鸚鵡，煙嶺高翔碧鷓鴣。","勝妙重重惟禱祝，永資軍庶息災虞。"],"s":"trad","f":"simp"},{"i":"cc8f7407-9df6-4071-8799-86081d66ed98","t":"武肅王有旨石橋設齋會進士一詩共六首 四","a":"吳越僧","d":"唐","g":"短诗","p":["凌晨迎請倍精誠，親散鮮花異處清。","羅漢攀枝呈梵相，巖僧倚樹現真形。","神幡雙出紅霞動，寶塔全開白氣生。","都爲王心標意切，滿空盈月瑞分明。"],"s":"mixed","f":"simp"},{"i":"9474841a-b631-4692-83f7-58e4d9f6bac4","t":"武肅王有旨石橋設齋會進士一詩共六首 五","a":"吳越僧","d":"唐","g":"短诗","p":["幡花寶蓋滿青川，祈禱迎來聖半千。","莫道勝緣無影響，須知嘉會有因緣。","空中長似聞天樂，巖畔常疑有地仙。","何必更尋兜率去，重重靈應事昭然。"],"s":"trad","f":"simp"},{"i":"5becd9b9-3fd4-4485-a2e8-115ceaffbc99","t":"武肅王有旨石橋設齋會進士一詩共六首 六","a":"吳越僧","d":"唐","g":"短诗","p":["登雲步嶺涉煙程，好景隨心次第生。","聖者已符祥瑞事，地靈全副禱祈情。","洞深重疊拖雲濕，灘淺潺湲漱水清。","願滿事圓歸去路，便風相送片帆輕。"],"s":"trad","f":"simp"},{"i":"006a07c2-01cc-4e9f-b94e-1857378337ec","t":"題戶詩","a":"唐末僧","d":"唐","g":"短诗","p":["枕有思鄉淚，門無問疾人。","塵埋牀下履，風動架頭巾。"],"s":"mixed","f":"simp"},{"i":"f3c2f321-a0d3-48bd-a36c-02c4aba1de66","t":"逸句","a":"神迥","d":"唐","g":"短诗","p":["鵶鳴東牖曙，草秀南湖春。"],"s":"trad","f":"simp"},{"i":"d51049d5-bcca-44ef-a38f-01aec94313c1","t":"逸句","a":"可隆","d":"唐","g":"短诗","p":["萬般思後行，一失廢前功。"],"s":"trad","f":"simp"},{"i":"0f8c2662-3ed0-440f-a89d-5d6f02ea9abf","t":"逸句","a":"爾鳥","d":"唐","g":"短诗","p":["鯨目光燒半海紅，鰲頭浪蹙掀天白。"],"s":"trad","f":"simp"},{"i":"1726123e-d3ac-4bee-8aab-03fdcb2d7a67","t":"逸句","a":"元礎","d":"唐","g":"短诗","p":["寺隔殘潮去，採藥過泉聲。","林塘秋半宿，風雨夜深來。"],"s":"trad","f":"simp"},{"i":"d15a7252-5797-40a8-8a93-20cd9a617f5d","t":"逸句","a":"悟清","d":"唐","g":"短诗","p":["鳥歸花影動，魚沒浪痕圓。"],"s":"trad","f":"simp"},{"i":"4c4cb6ad-13cd-4da7-91f2-7adc70de3f1f","t":"逸句","a":"契盈","d":"唐","g":"短诗","p":["三千里外一條水，十二時中兩度潮。"],"s":"trad","f":"simp"},{"i":"fd9858ca-7aaf-4f06-82f4-d10c7852f2ae","t":"逸句","a":"淡然","d":"唐","g":"短诗","p":["到處自鑿井，不能飲常流。"],"s":"trad","f":"simp"},{"i":"aa0e89fd-8ab6-4ee4-8d61-8d423389866e","t":"逸句","a":"庭實","d":"唐","g":"短诗","p":["吟中雙鬢白，笑裏一生貧。"],"s":"mixed","f":"simp"},{"i":"a907660e-e1b4-4a04-b3f2-354cac81780a","t":"逸句","a":"知業","d":"唐","g":"短诗","p":["接岸橋通何處路，倚欄人[是阿]誰家。"],"s":"trad","f":"simp"},{"i":"10002fb5-b269-4bf5-b1fd-c1b624915b57","t":"逸句","a":"雲容","d":"唐","g":"短诗","p":["木末上明星。"],"s":"trad","f":"simp"},{"i":"f708e169-9b50-47c6-b58d-5e2b29da7fa1","t":"逸句","a":"玄幽","d":"唐","g":"短诗","p":["三萬蓮經三十春，半生不蹋院門塵。"],"s":"trad","f":"simp"},{"i":"bb0821f2-2099-4c6e-81f5-83820891699e","t":"逸句","a":"志定","d":"唐","g":"短诗","p":["惟有罇前今夜月，當時曾照墮樓人。","梧桐葉老蟬聲死，一夜洞庭波上風。"],"s":"trad","f":"simp"},{"i":"c883641c-c4d9-4ea5-9307-db987330fa0f","t":"逸句","a":"靈準","d":"唐","g":"短诗","p":["晴看漢水廣，秋覺峴山高。"],"s":"trad","f":"simp"},{"i":"c968e274-ab29-4fc0-ab16-d4b1acef77c6","t":"逸句","a":"荆州僧","d":"唐","g":"短诗","p":["犬熟護鄰房。"],"s":"mixed","f":"simp"},{"i":"2f2c78e6-76b6-4ae9-8845-4518df36967d","t":"荅宋之問","a":"司馬承禎","d":"唐","g":"短诗","p":["時既暮兮節欲春，山林寂兮懷幽人。","登奇峰兮望白雲，悵緬邈兮象欲紛。","白雲悠悠去不返，寒風颼颼吹日晚。","不見其人誰與言，歸坐彈琴思逾遠。"],"s":"trad","f":"simp"},{"i":"afd8310a-2b65-40a3-88d0-adb26822917b","t":"醉吟三首 一","a":"張氳","d":"唐","g":"短诗","p":["去歲無田種，今春乏酒材。","從他花鳥笑，佯醉臥樓臺。"],"s":"trad","f":"simp"},{"i":"21c5f628-2276-4adb-8951-2f6283fb049e","t":"醉吟三首 二","a":"張氳","d":"唐","g":"短诗","p":["下調無人睬，高心又被瞋。","不知時俗意，教我若爲人。"],"s":"mixed","f":"simp"},{"i":"2283af39-ff3f-474e-9d69-7521b0ac958a","t":"醉吟三首 三","a":"張氳","d":"唐","g":"短诗","p":["入市非求利，過朝不爲名。","有時隨俗物，相伴且營營。"],"s":"mixed","f":"simp"},{"i":"096601bd-576c-441c-a572-1b5b2ce14598","t":"洗心","a":"司馬退之","d":"唐","g":"古体","p":["不踐名利道，始覺塵土腥。","不味稻粱食，始覺精神清。","羅浮奔走外，日月無短明。","山瘦松亦勁，鶴老飛更輕。","逍遙此中客，翠髮皆長生。","草木多古色，雞犬無新聲。","君有出俗志，不貪英雄名。","傲然脫冠帶，改換人間情。","去矣丹霄路，向曉雲冥冥。"],"s":"trad","f":"simp"},{"i":"926f4798-8d1b-4d11-bb9b-b981667832e5","t":"夜醉臥街","a":"裴翛然","d":"唐","g":"短诗","p":["遮莫鼕鼕動，須傾滿滿杯。","金吾如借問，但道玉山頹。"],"s":"trad","f":"simp"},{"i":"aafc69a3-07c7-4347-8938-416bda2f482f","t":"謁堯帝廟","a":"軒轅彌明","d":"唐","g":"短诗","p":["祖龍開國盡遐荒，廟建唐堯鎮此邦。","山卷白雲朝帝座，林疎紅日列仙幢。","巍巍聖蹟陵松嶠，蕩蕩恩波洽桂江。","瞻仰威靈共回首，紫霞深處鎖軒窗。"],"s":"trad","f":"simp"},{"i":"57dfb63c-4a91-4227-ad7a-c5e7ddaf0008","t":"山居 一","a":"陳寡言","d":"唐","g":"短诗","p":["照水冰如鑑，掃雪玉爲塵。","何須問今古，便是上皇人。"],"s":"mixed","f":"simp"},{"i":"714c780c-f630-42be-88d1-ceb90bae92e7","t":"山居 二","a":"陳寡言","d":"唐","g":"短诗","p":["醉臥茅堂不閉關，覺來開眼見青山。","松花落處宿猨在，麋鹿羣羣林際還。"],"s":"mixed","f":"simp"},{"i":"2fe8eced-e7e0-4621-aaa7-4ace58739200","t":"臨化示弟子","a":"陳寡言","d":"唐","g":"短诗","p":["我本無形暫有形，偶來人世逐營營。","輪迴債負今還畢，搔首翛然歸上清。"],"s":"trad","f":"simp"},{"i":"4988dee8-c0d1-46b4-953d-38384f7933d5","t":"元白席上作","a":"李昇","d":"唐","g":"短诗","p":["生在儒家遇太平，懸纓垂帶布衣輕。","誰能世路趨名利，臣事玉皇歸上清。"],"s":"trad","f":"simp"},{"i":"4a5163e2-e99f-43c1-8e1f-88d550fabc87","t":"一字至七字詩 書","a":"范堯佐","d":"唐","g":"古体","p":["書，憑鴈，寄魚。","出王屋，入匡廬。","文生益智，道著清虛。","葛洪一萬卷，惠子五車餘。","銀鉤屈曲索靖，題橋司馬相如。","別後莫暌千里信，數封緘送到閑居。"],"s":"mixed","f":"simp"},{"i":"000c1478-af14-4ddd-b0b6-6a60eb367e7f","t":"言志獻浙東廉訪辭召","a":"徐靈府","d":"唐","g":"短诗","p":["野性歌三樂，皇恩出九重。","那煩紫宸命，遠下白雲峰。","多媿書傳鶴，深慚紙畫龍。","將何佐明主，甘老在巖松。"],"s":"trad","f":"simp"},{"i":"cf467a58-45e1-42b7-8bec-e6db8ed049b9","t":"自詠二首 一","a":"徐靈府","d":"唐","g":"短诗","p":["寂寂凝神太極初，無心應物等空虛。","性修自性非求得，欲識真人祗是渠。"],"s":"trad","f":"simp"},{"i":"5ffa103a-c0a2-4cdc-a558-fc9eb861c60e","t":"自詠二首 二","a":"徐靈府","d":"唐","g":"短诗","p":["學道全真在此生，何須待死更求生。","今生不了無生理，縱復生知那處生。"],"s":"trad","f":"simp"},{"i":"fb8797cf-0bf8-4914-99ac-fc31dfc6170a","t":"留觀中詩二首 一","a":"吳子來","d":"唐","g":"短诗","p":["終日草堂間，清風常往還。","耳無塵事擾，心有翫雲閑。","對酒惟思月，餐松不厭山。","時時吟內景，自合駐童顏。"],"s":"trad","f":"simp"},{"i":"8e783367-449b-4b65-8c47-dd2061bbca24","t":"留觀中詩二首 二","a":"吳子來","d":"唐","g":"短诗","p":["此生此物當生涯，白石青松便是家。","對月臥雲如野鹿，時時買酒醉煙霞。"],"s":"trad","f":"simp"},{"i":"15310db9-e651-401d-9ff0-c9fd6112c67f","t":"遊仙二十四首 一","a":"吳筠","d":"唐","g":"古体","p":["啓冊觀往載，搖懷考今情。","終古已寂寂，舉世何營營。","悟彼衆仙妙，超然含至精。","凝神契沖玄，化服凌太清。","心同宇宙廣，體合雲霞輕。","翔風吹羽蓋，慶霄拂霓旌。","龍駕朝紫微，後天保令名。","豈如寰中士，軒冕矜蹔榮。"],"s":"mixed","f":"simp"},{"i":"ed5e3c07-5cb6-4dd9-a326-66238e611261","t":"遊仙二十四首 二","a":"吳筠","d":"唐","g":"古体","p":["鸞鳳棲瑤林，鵰鶚集平楚。","飲啄本殊好，翺翔終異所。","吾方遺諠囂，立節慕高舉。","解茲區中戀，結彼霄外侶。","誰謂天路遐，感通自無阻。"],"s":"trad","f":"simp"},{"i":"dfd38f3b-0634-483c-b5a8-37b3ffbadede","t":"遊仙二十四首 三","a":"吳筠","d":"唐","g":"古体","p":["愍俗從遷謝，尋仙去淪沒。","三元有真人，與我生道骨。","凌晨吸丹景，入夜飲黃月。","百關彌調暢，方寸益清越。","棲神合虛無，洞覽周恍惚。","不覺隨玉皇，焚香詣金闕。"],"s":"trad","f":"simp"}]