[{"i":"c04bee0c-2dd1-4ce8-8363-3be2f06db71b","t":"送楊閑侍御拜命赴上都","a":"劉商","d":"唐","g":"短诗","p":["賀客移星使，絲綸出紫微。","手中霜作簡，身上繡爲衣。","驄馬朝天疾，臺烏向日飛。","親朋皆避路，不是送人稀。"],"s":"mixed","f":"simp"},{"i":"86d693be-a8d4-4ad2-a205-cf0d30255e90","t":"賦得月下聞蛩送別","a":"劉商","d":"唐","g":"短诗","p":["物候改秋節，炎涼此夕分。","暗蟲聲徧草，明月夜無雲。","清逈簷外見，淒其籬下聞。","感時兼惜別，羇思自紛紛。"],"s":"trad","f":"simp"},{"i":"3fba7ff9-acd9-4dce-bfbc-2e071547103d","t":"重陽日寄上饒李明府","a":"劉商","d":"唐","g":"短诗","p":["重陽秋雁未啣蘆，始覺他鄉節候殊。","旅館但知聞蟋蟀，郵童不解獻茱萸。","陶潛何處登高醉，倦客停橈一事無。","來歲公田多種黍，莫敎黃菊笑楊朱。"],"s":"trad","f":"simp"},{"i":"dd5f08ab-e872-48df-978b-369433e46e7d","t":"同諸子哭張元易","a":"劉商","d":"唐","g":"短诗","p":["盛德高名總是空，神明福善大朦朧。","遊魂永永無歸日，流水年年自向東。","素帷旅櫬鄉關遠，丹旐孤燈客舍中。","伯道共悲無後嗣，孀妻老母斷根蓬。"],"s":"trad","f":"simp"},{"i":"35922d1a-9bd6-4c05-aa45-274cf51ded24","t":"合肥至日愁中寄鄭明府","a":"劉商","d":"唐","g":"古体","p":["失計爲卑吏，三年滯楚鄉。","不能隨世俗，應是昧行藏。","白璧空無玷，黃沙只自傷。","暮天鄉思亂，曉鏡鬢毛蒼。","灰管移新律，窮陰變一陽。","歲時人共換，幽憤日先長。","拙宦慚知己，無媒悔自強。","迍邅羞薄命，恩惠費餘光。","衆口誠難稱，長川却易防。","魚竿今尚在，行此掉滄浪。"],"s":"mixed","f":"simp"},{"i":"a0bfd0f1-c4ef-46fe-a535-5effc4ca87b6","t":"送廬州賈使君拜命","a":"劉商","d":"唐","g":"古体","p":["考績朝稱貴，時清武用文。","二天移外府，三命佐元勳。","佩玉兼高位，摐金閱上軍。","威容冠是鐵，圖畫閣名芸。","人詠甘棠茂，童謠竹馬羣。","懸旌風肅肅，臥轍淚紛紛。","特達恩難報，升沈路易分。","侯嬴不得從，心逐信陵君。"],"s":"mixed","f":"simp"},{"i":"356e693d-f163-4cfb-ba12-54c808e63828","t":"怨婦","a":"劉商","d":"唐","g":"短诗","p":["淨掃黃金階，飛霜皎如雪。","下簾彈箜篌，不忍見秋月。"],"s":"trad","f":"simp"},{"i":"1af41365-8613-43b1-b7e7-ec4bc29016a2","t":"綠珠怨","a":"劉商","d":"唐","g":"短诗","p":["從來上臺榭，不敢倚闌干。","零落知成血，高樓直下看。"],"s":"mixed","f":"simp"},{"i":"8d40eb55-efed-44ae-a45d-994044bd05e7","t":"古意","a":"劉商","d":"唐","g":"短诗","p":["達曉寢衣冷，開帷霜露凝。","風吹昨夜淚，一片枕前冰。"],"s":"trad","f":"simp"},{"i":"8f6704ae-d21f-4be6-ab2c-b2627696130a","t":"哭蕭掄","a":"劉商","d":"唐","g":"短诗","p":["何處哭故人，青門水如箭。","當時水頭別，從此不相見。"],"s":"trad","f":"simp"},{"i":"62c07bf8-fca7-4c72-91d2-f7043d2c972a","t":"送從弟赴上都","a":"劉商","d":"唐","g":"短诗","p":["車騎秦城遠，囊裝楚客貧。","月明思遠道，詩罷訴何人。"],"s":"trad","f":"simp"},{"i":"72f97955-cff6-4990-879b-acd33c85c53d","t":"登相國寺閣","a":"劉商","d":"唐","g":"短诗","p":["晴日登臨好，春風各望家。","垂楊夾城路，客思逐楊花。"],"s":"trad","f":"simp"},{"i":"465abfc8-fe1f-4cc3-a9f3-5479f87cbfc0","t":"酬濬上人采藥見寄","a":"劉商","d":"唐","g":"短诗","p":["玉英期共采，雲嶺獨先過。","應得靈芝也，詩情一倍多。"],"s":"mixed","f":"simp"},{"i":"65d6b275-c8b1-4bd6-9670-8a50b5be44d1","t":"曲水寺枳實","a":"劉商","d":"唐","g":"短诗","p":["枳實遶僧房，攀枝置藥囊。","洞庭山上橘，霜落也應黃。"],"s":"trad","f":"simp"},{"i":"29cf1bbc-2b05-497a-89d2-961b2f7235d6","t":"酬問師","a":"劉商","d":"唐","g":"短诗","p":["虛空無處所，髣髴似琉璃。","詩境何人到，禪心又過詩。"],"s":"trad","f":"simp"},{"i":"1d70ecfb-07ba-41c3-81ed-d4f8fbc8e1e4","t":"殷秀才求詩","a":"劉商","d":"唐","g":"短诗","p":["傾蓋見芳姿，晴天瓊樹枝。","連城猶隱石，唯有卞和知。"],"s":"trad","f":"simp"},{"i":"2f7723ef-bcde-4e91-8d32-dd66a03dadbe","t":"行營即事","a":"劉商","d":"唐","g":"短诗","p":["萬姓厭干戈，三邊尚未和。","將軍誇寶劒，功在殺人多。"],"s":"trad","f":"simp"},{"i":"02efac18-657f-49cc-aec7-bb821b0fa2d4","t":"送劉寰北歸","a":"劉商","d":"唐","g":"短诗","p":["南巢登望縣城孤，半是青山半是湖。","知爾素多山水興，此回歸去更來無。"],"s":"trad","f":"simp"},{"i":"119ad018-c432-46e0-8ead-829e7ed61524","t":"送王閈歸蘇州","a":"劉商","d":"唐","g":"短诗","p":["深山窮谷沒人來，邂逅相逢眼漸開。","雲鶴洞宮君未到，夕陽帆影幾時回。"],"s":"trad","f":"simp"},{"i":"3a4541bc-5bdc-49d4-9124-e6933d65476f","t":"送人往虔州","a":"劉商","d":"唐","g":"短诗","p":["莫歎乘軺道路賒，高樓日日望還家。","人到南康皆下淚，唯君笑向此中花。"],"s":"trad","f":"simp"},{"i":"17774136-42b0-4654-9f76-ba85f51636bd","t":"送僧往湖南","a":"劉商","d":"唐","g":"短诗","p":["閑出東林日影斜，稻苗深淺映袈裟。","船到南湖風浪靜，可憐秋水照蓮花。"],"s":"trad","f":"simp"},{"i":"61d2b298-db42-432a-b85d-06e27c0fcb69","t":"送元使君自楚移越","a":"劉商","d":"唐","g":"短诗","p":["露冕行春向若耶，野人懷惠欲移家。","東風二月淮陰郡，唯見棠棃一樹花。"],"s":"trad","f":"simp"},{"i":"59943608-abc3-4a86-bc2b-9f8b908e7de8","t":"移居深山謝別親故","a":"劉商","d":"唐","g":"短诗","p":["不食黃精不采薇，葛苗爲帶草爲衣。","孤雲更入深山去，人絕音書鴈自飛。"],"s":"mixed","f":"simp"},{"i":"9006f890-2596-4f9a-a3e3-d089ece014f9","t":"送王永二首 一","a":"劉商","d":"唐","g":"短诗","p":["君去春山誰共遊，鳥啼花落水空流。","如今送別臨溪水，他日相思來水頭。"],"s":"trad","f":"simp"},{"i":"371339b3-696f-43ab-8715-80ea68d66c43","t":"送王永二首 二","a":"劉商","d":"唐","g":"短诗","p":["綿衣似熱裌衣寒，時景雖和春已闌。","誠知暫別那惆悵，明日藤花獨自看。"],"s":"trad","f":"simp"},{"i":"cb2df11c-a56d-4f06-99c6-3e6aebb5735a","t":"送別","a":"劉商","d":"唐","g":"短诗","p":["灞岸青門有弊廬，昨來聞道半丘墟。","陌頭空送長安使，舊里無人可寄書。"],"s":"mixed","f":"simp"},{"i":"64d26413-135b-4aca-a9e4-2fdb38e9f179","t":"送王貞","a":"劉商","d":"唐","g":"短诗","p":["清陽玉潤復多才，邂逅佳期過早梅。","槿花亦可浮杯上，莫待東籬黃菊開。"],"s":"trad","f":"simp"},{"i":"3745633d-edd0-42dd-b7d3-8282a9c4f717","t":"送薛六暫遊揚州","a":"劉商","d":"唐","g":"短诗","p":["志在乘軒鳴玉珂，心期未快隱青蘿。","廣陵行路風塵合，城郭新秋砧杵多。"],"s":"trad","f":"simp"},{"i":"3a8ebc78-ed9b-4fae-a972-2ebbae61ebce","t":"送楊行元赴舉","a":"劉商","d":"唐","g":"短诗","p":["晚渡邗溝惜別離，漸看烽火馬行遲。","千鈞何處穿楊葉，二月長安折桂枝。"],"s":"trad","f":"simp"},{"i":"46334573-2f4a-4e35-9e18-4deb7a7c8ac1","t":"行營送人","a":"劉商","d":"唐","g":"短诗","p":["鞞鼓喧喧對古城，獨尋歸鳥馬蹄輕。","回來看覓鶯飛處，即是將軍細柳營。"],"s":"trad","f":"simp"},{"i":"22b4b3ec-cdb5-4bc7-93a3-e3fbcd60a43d","t":"滑州送人先歸","a":"劉商","d":"唐","g":"短诗","p":["河水冰消鴈北飛，寒衣未足又春衣。","自憐漂蕩經年客，送別千回獨未歸。"],"s":"trad","f":"simp"},{"i":"110ef313-093d-49d2-b5f0-1ce203b9e115","t":"送濬上人","a":"劉商","d":"唐","g":"短诗","p":["木落前山霜露多，手持寒錫遠頭陀。","眼看庭樹梅花發，不見詩人獨詠歌。"],"s":"trad","f":"simp"},{"i":"80a8cfd4-93a0-4db4-8448-3401f948ae00","t":"高郵送弟遇北遊","a":"劉商","d":"唐","g":"短诗","p":["門臨楚國舟船路，易見行人易別離。","今日送君心最恨，孤帆水下又風吹。"],"s":"trad","f":"simp"},{"i":"9efe2dcf-cbd4-4c86-82f7-053e645ff62e","t":"送豆盧郎赴海陵","a":"劉商","d":"唐","g":"短诗","p":["煙波極目已霑襟，路出東塘水更深。","看取海頭秋草色，一如江上別離心。"],"s":"trad","f":"simp"},{"i":"a9b677e8-2657-4d20-9572-1a7479846124","t":"送女子","a":"劉商","d":"唐","g":"短诗","p":["青娥宛宛聚爲裳，烏鵲橋成別恨長。","惆悵梧桐非舊影，不悲鴻鴈暫隨陽。"],"s":"mixed","f":"simp"},{"i":"0490ac79-e0b9-40e7-bad3-08f6bdd09813","t":"酬道芬寄晝松","a":"劉商","d":"唐","g":"短诗","p":["聞道鉛華學沈寧，寒枝淅瀝葉青青。","一株將比囊中樹，若箇年多有茯苓。"],"s":"trad","f":"simp"},{"i":"8e7272cc-f032-47e6-abf5-bff9c8970617","t":"山翁持酒相訪以畫松酬之","a":"劉商","d":"唐","g":"短诗","p":["白社風霜驚暮年，銅瓶桑落慰秋天。","憐君意厚留新畫，不著松枝當酒錢。"],"s":"trad","f":"simp"},{"i":"a0193ce9-d07b-4ee6-8424-c57ba5b5d7ee","t":"題潘師房","a":"劉商","d":"唐","g":"短诗","p":["渡水傍山尋石壁，白雲飛處洞門開。","仙人來往行無跡，石徑春風長綠苔。"],"s":"trad","f":"simp"},{"i":"545620e3-fea4-4afe-935e-3cd3c8f51abd","t":"謝自然却還舊居","a":"劉商","d":"唐","g":"短诗","p":["仙侶招邀自有期，九天升降五雲隨。","不知辭罷虛皇日，更向人間住幾時。"],"s":"mixed","f":"simp"},{"i":"700e128d-c100-4b71-a469-14714de0e8c0","t":"寄李俌","a":"劉商","d":"唐","g":"短诗","p":["挂却衣冠披薜荔，世人應是笑狂愚。","年來漸覺髭鬚黑，欲寄松花君用無。"],"s":"mixed","f":"simp"},{"i":"b80cd84e-66c5-4a2d-af2d-bafbb18166b6","t":"贈頭陀師","a":"劉商","d":"唐","g":"短诗","p":["少壯從戎馬上飛，雪山童子未緇衣。","秋山年長頭陀處，說我軍前射虎歸。"],"s":"trad","f":"simp"},{"i":"9cb198d6-9540-49cd-9762-1731f35d58f0","t":"贈嚴四草屨","a":"劉商","d":"唐","g":"短诗","p":["輕微菅蒯將何用，容足偷安事頗同。","日入信陵賓館靜，贈君閑步月明中。"],"s":"trad","f":"simp"},{"i":"0efece9a-8bfe-4b25-a872-1dcd7ccbd49e","t":"題劉偃莊","a":"劉商","d":"唐","g":"短诗","p":["何事退耕滄海畔，閑看富貴白雲飛。","門前種稻三回熟，縣裏官人四考歸。"],"s":"mixed","f":"simp"},{"i":"ae9eab98-ccff-4285-97a1-4d91ca67fd8a","t":"題黃陂夫人祠","a":"劉商","d":"唐","g":"短诗","p":["蒼山雲雨逐明神，唯有香名萬歲春。","東風三月黃陂水，只見桃花不見人。"],"s":"trad","f":"simp"},{"i":"9d110d8e-e1d9-4b4e-81ee-46d2993148a0","t":"題道濟上人房","a":"劉商","d":"唐","g":"短诗","p":["何處營求出世間，心中無事即身閑。","門外水流風葉落，唯將定性對前山。"],"s":"trad","f":"simp"},{"i":"d8b88762-5c84-4462-a912-aba1899853e2","t":"棃樹陰","a":"劉商","d":"唐","g":"短诗","p":["福庭人靜少攀援，雨露偏滋影易繁。","磊落紫香香亞樹，清陰滿地晝當軒。"],"s":"trad","f":"simp"},{"i":"b6a372a3-e248-4d31-a452-5dcbe7370636","t":"秋蟬聲","a":"劉商","d":"唐","g":"短诗","p":["蕭條旅舍客心驚，斷續僧房靜又清。","借問蟬聲何所爲，人家古寺兩般聲。"],"s":"mixed","f":"simp"},{"i":"e6547d07-69dc-469d-8d28-ec60b009af96","t":"歸山留別子姪二首 一","a":"劉商","d":"唐","g":"短诗","p":["車馬驅馳人在世，東西南北鶴隨雲。","莫言貧病無留別，百代簪纓將付君。"],"s":"trad","f":"simp"},{"i":"1410e9c4-3ffc-4895-b5c4-c58fd4fdc88c","t":"歸山留別子姪二首 二","a":"劉商","d":"唐","g":"短诗","p":["不逐浮雲不羨魚，杏花茅屋向陽居。","鶴鳴華表應傳語，鴈度霜天懶寄書。"],"s":"trad","f":"simp"},{"i":"9c72b4fa-7c83-481f-9096-ad0fc6aa8235","t":"與湛上人院畫松","a":"劉商","d":"唐","g":"短诗","p":["水墨乍成巖下樹，摧殘半隱洞中[雲]。","猷公曾住天台寺，陰雨猨聲何處聞。"],"s":"trad","f":"simp"},{"i":"7e86ab12-f4fd-4c3d-abbf-617af182cf1f","t":"白沙宿竇常宅觀妓","a":"劉商","d":"唐","g":"短诗","p":["楊子澄江映晚霞，柳條垂岸一千家。","主人留客江邊宿，十月繁霜見杏花。"],"s":"mixed","f":"simp"},{"i":"915e667e-09aa-43dd-bd83-3db7715c0d75","t":"上巳日兩縣寮友會集時主郵不遂馳赴輒題以寄方寸","a":"劉商","d":"唐","g":"短诗","p":["踏青看竹共佳期，春水晴山祓禊詞。","獨坐郵亭心欲醉，櫻桃落盡暮愁時。"],"s":"trad","f":"simp"},{"i":"c7bfc7f7-1890-4597-8d4f-cd15dda7e301","t":"懷張璪","a":"劉商","d":"唐","g":"短诗","p":["苔石蒼蒼臨澗水，陰風褭褭動松枝。","世間唯有張通會，流向衡陽那得知。"],"s":"trad","f":"simp"},{"i":"8a6fff6a-6621-4194-a596-4e0d19f33788","t":"與于中丞","a":"劉商","d":"唐","g":"短诗","p":["萬頃荒臨不敢看，買山容足擬求安。","田園失計全蕪沒，何處春風種蕙蘭。"],"s":"mixed","f":"simp"},{"i":"5081bebf-3c51-40c4-a615-d41487a273ca","t":"袁十五遠訪山門","a":"劉商","d":"唐","g":"短诗","p":["僻居謀道不謀身，避病桃源不避秦。","遠入青山何所見，寒花滿徑白頭人。"],"s":"trad","f":"simp"},{"i":"3cdd5eb8-5768-4964-919c-f6d50f4aeda3","t":"行營病中","a":"劉商","d":"唐","g":"短诗","p":["心許征南破虜歸，可言羸病臥戎衣。","遲遲不見憐弓箭，惆悵秋鴻敢近飛。"],"s":"trad","f":"simp"},{"i":"0f08289a-2852-4411-87cb-6aae32733852","t":"合谿水漲寄敬山人","a":"劉商","d":"唐","g":"短诗","p":["共愛碧谿臨水住，相思來往踐莓苔。","而今却欲嫌谿水，雨漲春流隔往來。"],"s":"mixed","f":"simp"},{"i":"b55eaf9f-f4da-427c-8c6a-3a4061e6fba5","t":"不羨花","a":"劉商","d":"唐","g":"短诗","p":["惆悵朝陽午又斜，剩栽桃李學仙家。","花開花落人如舊，誰道容顏不及花。"],"s":"trad","f":"simp"},{"i":"732e0045-a7cc-49f4-a55d-1f247560c770","t":"醉後","a":"劉商","d":"唐","g":"短诗","p":["春草秋風老此身，一瓢長醉任家貧。","醒來還愛浮萍草，漂寄官河不屬人。"],"s":"trad","f":"simp"},{"i":"ebcb34d5-39e8-4cc1-9ec0-2adb8b0c7106","t":"題水洞二首 一","a":"劉商","d":"唐","g":"短诗","p":["桃花流出武陵洞，夢想仙家雲樹春。","今看水入洞中去，却是桃花源裏人。"],"s":"mixed","f":"simp"},{"i":"a2d9200a-2ba4-4232-8ebc-3c07e377b060","t":"題水洞二首 二","a":"劉商","d":"唐","g":"短诗","p":["長看巖穴泉流出，忽聽懸泉入洞聲。","莫摘山花拋水上，花浮出洞世人驚。"],"s":"trad","f":"simp"},{"i":"7c7c5f83-8f11-4174-ac35-fb3acdf4ba7a","t":"代人村中悼亡二首 一","a":"劉商","d":"唐","g":"短诗","p":["花落茅簷轉寂寥，魂隨暮雨此中銷。","邇來庭柳無人折，長得垂枝一萬條。"],"s":"trad","f":"simp"},{"i":"5c11e69f-a174-486b-967e-4b8c1717b997","t":"代人村中悼亡二首 二","a":"劉商","d":"唐","g":"短诗","p":["虛室無人乳燕飛，蒼苔滿地履痕稀。","庭前唯有薔薇在，花似殘妝葉似衣。"],"s":"trad","f":"simp"},{"i":"7070a110-e4f7-4db0-a389-aaa8303665a6","t":"觀獵三首 一","a":"劉商","d":"唐","g":"短诗","p":["夢非熊虎數年間，驅盡豺狼宇宙閑。","傳道單于聞校獵，相期不敢過陰山。"],"s":"mixed","f":"simp"},{"i":"61b6f683-2b9e-41c0-88cb-46df7a1cc9af","t":"觀獵三首 二","a":"劉商","d":"唐","g":"短诗","p":["日隱寒山獵未歸，鳴絃落羽雪霏霏。","梁園射盡南飛鴈，淮楚人驚陽鳥啼。"],"s":"trad","f":"simp"},{"i":"dece4ca9-85a1-49fb-aa4a-85d004bb7574","t":"觀獵三首 三","a":"劉商","d":"唐","g":"短诗","p":["松月東軒許獨遊，深恩未報復淹留。","梁園日暮從公獵，每過青山不舉頭。"],"s":"trad","f":"simp"},{"i":"fd933711-1b4d-4fec-aa26-c87d4484c886","t":"畫石","a":"劉商","d":"唐","g":"短诗","p":["蒼蘚千年粉繪傳，堅貞一片色猶全。","那知忽遇非常用，不把分銖補上天。"],"s":"trad","f":"simp"},{"i":"d2782132-3d54-4bf4-8d68-d2b9c2803bda","t":"詠雙開蓮花","a":"劉商","d":"唐","g":"短诗","p":["菡萏新花曉竝開，濃妝美笑面相隈。","西方采畫迦陵鳥，早晚雙飛池上來。"],"s":"mixed","f":"simp"},{"i":"265957da-73d9-4c7c-be73-7768cbfb58a3","t":"夜聞鄰管","a":"劉商","d":"唐","g":"短诗","p":["何事霜天月滿空，鸝雛百囀向春風。","鄰家思婦更長短，楊柳如絲在管中。"],"s":"trad","f":"simp"},{"i":"73a6d10e-ee40-4b4c-9b2a-284b12b70e71","t":"山中寄元二侍御二首 一","a":"劉商","d":"唐","g":"短诗","p":["心期汗漫臥雲扃，家計漂零水上萍。","桃李向秋彫落盡，一枝松色獨青青。"],"s":"trad","f":"simp"},{"i":"61e43314-6f9b-4881-ab52-ecd073db4d74","t":"山中寄元二侍御二首 二","a":"劉商","d":"唐","g":"短诗","p":["拖紫鏘金濟世才，知君倚玉望三台。","深山窮谷無人到，唯有狂愚獨自來。"],"s":"mixed","f":"simp"},{"i":"02073a29-4c9c-4d60-b2fa-c92796cb24f2","t":"上崔十五老丈","a":"劉商","d":"唐","g":"短诗","p":["天漢乘槎可問津，寂寥深景到無因。","看花獨往尋詩客，不爲經時謁丈人。"],"s":"mixed","f":"simp"},{"i":"60a2019f-2e72-472b-8b8f-03150f7b986a","t":"袁德師求畫松","a":"劉商","d":"唐","g":"短诗","p":["柏偃松𢼮勢自分，森梢古意出浮雲。","如今眼暗畫不得，舊有三株持贈君。"],"s":"trad","f":"simp"},{"i":"9bb54aba-3845-4717-9dec-1ed03b254f79","t":"早夏月夜問王開","a":"劉商","d":"唐","g":"短诗","p":["清風首夏夜猶寒，嫩笋侵階竹數竿。","君向蘇臺長見月，不知何事此中看。"],"s":"mixed","f":"simp"},{"i":"cc075307-65e8-4814-90fa-3bf93d48608f","t":"裴十六廳即事","a":"劉商","d":"唐","g":"短诗","p":["主人能政訟庭閑，帆影雲峰戶牖間。","每到夕陽嵐翠近，只言籬障倚前山。"],"s":"trad","f":"simp"},{"i":"d82bf4d8-ee33-41ad-a008-d4dbfcabd803","t":"春日行營即事","a":"劉商","d":"唐","g":"短诗","p":["風引雙旌馬首齊，曹南戰勝日平西。","爲儒不解從戎事，花落春深聞鼓鼙。"],"s":"mixed","f":"simp"},{"i":"f2ac2ab6-d983-4f81-a059-b6fdea86d9aa","t":"畫樹後呈濬師","a":"劉商","d":"唐","g":"短诗","p":["翔鳳邊風十月寒，蒼山古木更摧殘。","爲君壁上畫松柏，勁雪嚴霜君試看。"],"s":"mixed","f":"simp"},{"i":"de848ea1-22cb-4dd5-94e3-9000a8cd754e","t":"弔從甥","a":"劉商","d":"唐","g":"短诗","p":["日晚河邊訪惸獨，衰柳寒蕪遶茅屋。","兒童驚走報人來，孀婦開門一聲哭。"],"s":"trad","f":"simp"},{"i":"c50e5462-3ccc-4aa7-b24b-d8f96f823aa2","t":"句","a":"劉商","d":"唐","g":"短诗","p":["郵筒不解獻茱萸。","趙侯首帶鹿耳巾，規模出自陶弘景。"],"s":"trad","f":"simp"},{"i":"c58d0fc5-6167-4f0b-b55c-7fd132aeec8e","t":"登城樓作","a":"陳翊","d":"唐","g":"短诗","p":["井邑白雲間，嚴城遠帶山。","沙墟陰欲暮，郊色淡方閑。","孤徑迴榕岸，層巒破枳關。","寥寥分遠望，暫得一開顏。"],"s":"trad","f":"simp"},{"i":"a94630e9-8d05-4f23-b942-1844901f030d","t":"宴柏臺","a":"陳翊","d":"唐","g":"短诗","p":["華臺陳桂席，密榭宴清真。","柏葉猶霜氣，桃花似漢津。","青尊照深夕，綠綺映芳春。","欲憶相逢後，無言嶺海人。"],"s":"trad","f":"simp"},{"i":"301cc127-a514-4c46-af4f-5ccecaa32d2a","t":"過馬侍中亭","a":"陳翊","d":"唐","g":"短诗","p":["草色照雙扉，軒車到客稀。","苔衣香屐迹，花綬少塵飛。","薄望憐池淨，開畦愛雨肥。","相過忘日昃，坐待白雲歸。"],"s":"mixed","f":"simp"},{"i":"0e3b3e00-9cd5-410e-af4f-7465e0d0d273","t":"寄邵校書楚萇","a":"陳翊","d":"唐","g":"短诗","p":["愛酒時稱僻，高情自不凡。","向人方白眼，違俗有青巖。","雲際開三徑，煙中挂一帆。","相期同歲晚，閑興與松杉。"],"s":"mixed","f":"simp"},{"i":"7206fb5e-9794-4926-a77c-d49a48b66235","t":"龍池春草","a":"陳翊","d":"唐","g":"古体","p":["青春光鳳苑，細草徧龍池。","曲渚交蘋葉，迴塘惹柳枝。","因風初苒苒，覆岸欲離離。","色帶金堤靜，陰連玉樹移。","日光浮靃靡，波影動參差。","豈比生幽遠，芳馨衆不知。"],"s":"mixed","f":"simp"},{"i":"3b986600-ebf4-4bfe-b2c9-0d625e290cd5","t":"郊行示友人","a":"陳翊","d":"唐","g":"短诗","p":["水開長鏡引諸巒，春洞花深落翠寒。","醉向絲蘿驚自醒，與君清耳聽松湍。"],"s":"trad","f":"simp"},{"i":"2759a051-c5c9-4b72-bcf6-fcbefe90ad40","t":"送別蕭二","a":"陳翊","d":"唐","g":"短诗","p":["橘花香覆白蘋洲，江引輕帆入遠遊。","千里雲天風雨夕，憶君不敢再登樓。"],"s":"trad","f":"simp"},{"i":"201ebc09-9beb-4a5d-a962-92dc6afff5d4","t":"遊仙","a":"劉復","d":"唐","g":"古体","p":["稅駕倚扶桑，逍遙望九州。","二老佐軒轅，移戈戮蚩尤。","功成棄之去，乘龍上天遊。","天上見玉皇，壽與天地休。","俯視崑崙宮，五城十二樓。","王母何窈眇，玉質清且柔。","揚袂折瓊枝，寄我天東頭。","相思千萬歲，大運浩悠悠。","安用知吾道，日月不能周。","寄音青鳥翼，謝爾碧海流。"],"s":"trad","f":"simp"},{"i":"45f5c07c-6fd7-4884-9107-e86be9cefe2d","t":"寺居清晨","a":"劉復","d":"唐","g":"古体","p":["高枕對曉月，衣巾清且涼。","露華朝未晞，滴瀝含虛光。","隔竹聞汲井，開扉見焚香。","幽心感衰病，結念依法王。","青冥早雲飛，杳靄空鳥翔。","此情皆有釋，悠然知所忘。"],"s":"trad","f":"simp"},{"i":"db1c8f32-7a4a-432e-9e8c-c16945988fca","t":"出東城","a":"劉復","d":"唐","g":"古体","p":["步出東城門，獨行已徬徨。","伊洛汎清流，密林含朝陽。","芳景雖可矚，憂懷在中腸。","人生幾何時，苒苒隨流光。","願得心所親，尊酒坐高堂。","一爲浮沈隔，會合殊未央。","雙戲水中鳧，和鳴自翱翔。","我無此羽翼，安可以比方。"],"s":"mixed","f":"simp"},{"i":"3f8eb0b3-d997-49f6-90bf-74a3400e9a73","t":"經禁城","a":"劉復","d":"唐","g":"古体","p":["日沒路且長，遊子欲涕零。","荒城無人路，秋草飛寒螢。","東南古丘墟，莽蒼馳郊坰。","黃雲晦斷岸，枯井臨崩亭。","昔人竟何之，窮泉獨冥冥。","蒼苔沒碑版，朽骨無精靈。","俛仰寄世間，忽如流波萍。","金石非汝壽，浮生等臊腥。","不如學神仙，服食求丹經。"],"s":"trad","f":"simp"},{"i":"054b8e52-9a8f-49b2-8341-801a5bff34be","t":"出三城留別幕中三判官","a":"劉復","d":"唐","g":"古体","p":["翔禽託高柯，倦客念主人。","恩義有所知，四海同一身。","況皆曠大姿，翰音見良辰。","陳規佐武略，高視據要津。","常願投素誠，今果得所申。","金罍列四座，廣廈無氛塵。","留連徂暑中，觀望歷數旬。","河山險以固，士卒勇且仁。","飭裝去未歸，相追越城闉。","愧無青玉案，緘佩永不泯。"],"s":"trad","f":"simp"},{"i":"6f000ab0-251b-480a-abfe-28d565c08797","t":"送劉秀才南歸","a":"劉復","d":"唐","g":"短诗","p":["鳥啼楊柳垂，此別千萬里。","古路入商山，春風生灞水。","停車落日在，罷酒離人起。","蓬戶寄龍沙，送歸情詎已。"],"s":"mixed","f":"simp"},{"i":"fe915623-7e9c-4ad3-8f87-8947fa3d6934","t":"送王倫","a":"劉復","d":"唐","g":"古体","p":["春江日未曛，楚客酣送君。","翩翩孤黃鶴，萬里滄洲雲。","四方各有志，豈得常顧羣。","山連巴湘遠，水與荆吳分。","清光日修阻，尺素安可論。","相思寄夢寐，瑤草空氛氳。"],"s":"mixed","f":"simp"},{"i":"0a988f56-b22d-48cb-94f1-fc75e2532eab","t":"長相思","a":"劉復","d":"唐","g":"古体","p":["長相思，在桂林，蒼梧山遠瀟湘深。","秋堂零淚倚金瑟，朱顏搖落隨光陰。","長宵嘹唳鴻命侶，河漢蒼蒼隔牛女。","寧知一水不可渡，況復萬山修且阻。","綵絲織綺文雙鴛，昔時贈君君可憐。","何言一去瓶落井，流塵歇滅金爐前。"],"s":"trad","f":"simp"},{"i":"7cd26645-b9bd-4b2c-bbbd-7af03d8bc1b0","t":"長歌行","a":"劉復","d":"唐","g":"古体","p":["淮南木落秋雲飛，楚宮商歌今正悲。","青春白日不與我，當壚舉酒勸君持。","出門驅馳四方事，徒用辛勤不得意。","三山海底無見期，百齡世間莫虛棄。","君不見金城帝業漢家有，東制諸侯欲長久。","姦雄竊命風塵昏，函谷重關不能守。","龍蛇出沒經兩朝，胡虜憑陵大道銷。","河水東流宮闕盡，五陵松柏自蕭蕭。"],"s":"trad","f":"simp"},{"i":"57d4ff2e-1617-4bbc-a647-be4beb69097a","t":"春遊曲","a":"劉復","d":"唐","g":"短诗","p":["春風戲狹斜，相見莫愁家。","細酌蒲桃酒，嬌歌玉樹花。","裁衫催白紵，迎客走朱車。","不覺重城暮，爭栖柳上鵶。"],"s":"mixed","f":"simp"},{"i":"d0892fc2-dffd-4c1c-bb5d-7e1191d6b3d6","t":"雜曲","a":"劉復","d":"唐","g":"短诗","p":["寶劒飾文犀，當風似切泥。","逢君感意氣，貰酒杜陵西。","趙女顏雖少，宛駒齒正齊。","嬌多不肯別，更待夜烏啼。"],"s":"trad","f":"simp"},{"i":"664fbadd-e1f7-4f7e-b8b4-919f553258fd","t":"春雨","a":"劉復","d":"唐","g":"短诗","p":["細雨度深閨，鶯愁欲嬾啼。","如煙飛漠漠，似露濕淒淒。","草色行看靡，花枝暮欲低。","曉聽鐘鼓動，早送錦障泥。"],"s":"trad","f":"simp"},{"i":"0db8ad0c-911f-4fe2-88de-4cb245fcfd0d","t":"夕次襄邑","a":"劉復","d":"唐","g":"短诗","p":["何處成吾道，經年遠路中。","客心猶向北，河水自歸東。","古戍飄殘角，疎林振夕風。","輕舟難載月，那與故人同。"],"s":"trad","f":"simp"},{"i":"8b45440d-9cf5-4912-97b6-ed2dbf4b28e5","t":"夏日","a":"劉復","d":"唐","g":"短诗","p":["暎日紗窗深且閑，含桃紅日石榴殷。","銀瓶綆轉桐花井，沈水煙銷金博山。","文簟象牀嬌倚瑟，綵匳銅鏡嬾拈環。","明朝戲去誰相伴，年少相逢狹路間。"],"s":"mixed","f":"simp"}]