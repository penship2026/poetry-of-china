[{"i":"3cf4b849-79d3-4f39-a383-eea07abb3aae","t":"齊 小兒執燭","a":"孫元晏","d":"唐","g":"短诗","p":["謝公情量已難量，忠宋心誠豈暫忘。","執燭小兒渾放去，略無言語與君王。"],"s":"trad","f":"simp"},{"i":"661c4823-2114-4bc1-9970-d1d4daa8bc51","t":"齊 王僧祐","a":"孫元晏","d":"唐","g":"短诗","p":["肯與公卿作等倫，澹然名德只推君。","任他車騎來相訪，簫鼓盈庭似不聞。"],"s":"trad","f":"simp"},{"i":"c2fe4e3f-f6ab-4df8-a6c6-8a4aad4b03b5","t":"齊 王僧虔","a":"孫元晏","d":"唐","g":"短诗","p":["位高名重不堪疑，懇讓儀同帝亦知。","不學常流爭進取，却憂門有二台司。"],"s":"mixed","f":"simp"},{"i":"ecba34f9-c6e8-45e3-bee2-723a4f711bb4","t":"齊 明帝裹蒸","a":"孫元晏","d":"唐","g":"短诗","p":["至尊尊貴異人間，御膳天廚豈等閑。","惜得裹蒸無用處，不如安霸取江山。"],"s":"trad","f":"simp"},{"i":"abf444a2-990d-43d2-aee5-de67df71d49a","t":"齊 鬱林王","a":"孫元晏","d":"唐","g":"短诗","p":["強哀強慘亦從伊，歸到私庭喜可知。","喜字漫書三十六，到頭能得幾多時。"],"s":"trad","f":"simp"},{"i":"21f8e75b-407c-4d67-9d8d-bc303517bf4c","t":"齊 何氏小山","a":"孫元晏","d":"唐","g":"短诗","p":["顯達何曾肯繫心，築居郊外好園林。","賺他謝朏出山去，贏得高名直至今。"],"s":"trad","f":"simp"},{"i":"a1e8545d-87e4-454d-a632-ec0988107271","t":"齊 王倫之","a":"孫元晏","d":"唐","g":"短诗","p":["豫章太守重詞林，圖畫陳蕃與華歆。","更奠子將幷孺子，爲君千載作知音。"],"s":"mixed","f":"simp"},{"i":"17b3a1a0-1f9f-419d-a7a8-f5ca86b7e936","t":"齊 潘妃","a":"孫元晏","d":"唐","g":"短诗","p":["曾步金蓮寵絕倫，豈甘今日委埃塵。","玉兒還有懷恩處，不肯將身嫁小臣。"],"s":"trad","f":"simp"},{"i":"085adf86-1ddf-4c7b-a094-c605472201da","t":"齊 王亮","a":"孫元晏","d":"唐","g":"短诗","p":["後見梁王未免哀，奈何無計拯傾頹。","若教彼相顛扶得，爭遣明公到此來。"],"s":"trad","f":"simp"},{"i":"842fba13-93e6-45bd-90b8-549319543770","t":"梁 分宮女","a":"孫元晏","d":"唐","g":"短诗","p":["滌蕩齊宮法令新，分張宮女二千人。","可憐無限如花貌，重見世間桃李春。"],"s":"trad","f":"simp"},{"i":"e9c3113b-d02d-47fb-a208-6e3160b8aaa8","t":"梁 馬仙埤","a":"孫元晏","d":"唐","g":"短诗","p":["齊朝太守不甘降，忠節當時動四方。","義士要教天下見，且留君住待袁昂。"],"s":"trad","f":"simp"},{"i":"6b9f8aa2-813e-46dd-8b1a-15ed7e121367","t":"梁 勍敵","a":"孫元晏","d":"唐","g":"短诗","p":["傳聞天子重儒才，特爲皇華綺宴開。","今日方驚遇勍敵，此人元自北朝來。"],"s":"mixed","f":"simp"},{"i":"b6f38bc8-a6d3-4b3a-b183-eca22a7a886f","t":"梁 蔡撙","a":"孫元晏","d":"唐","g":"短诗","p":["紫茄白莧以爲珍，守任清真轉更貧。","不飲吳興郡中水，古今能有幾多人。"],"s":"mixed","f":"simp"},{"i":"d26cbaab-ccf0-45bd-b0ef-3e90d4e31d78","t":"梁 楚祠","a":"孫元晏","d":"唐","g":"短诗","p":["曾與蕭侯醉玉桮，此時神影盡傾頹。","莫云千古無靈聖，也向西川助敵來。"],"s":"mixed","f":"simp"},{"i":"02c01ff4-e324-4d1d-906e-a5668ec96029","t":"梁 謝朏小輿","a":"孫元晏","d":"唐","g":"短诗","p":["小輿升殿掌鈞台，不免無憀却憶回。","應恨被他何胤誤，悔先容易出山來。"],"s":"mixed","f":"simp"},{"i":"d97d355f-0c96-41c6-910d-37899aaf63e0","t":"梁 八關齋","a":"孫元晏","d":"唐","g":"短诗","p":["依憑金地甚虔誠，忍溺空王爲聖明。","內殿設齋申禱祝，豈無功德及臺城。"],"s":"mixed","f":"simp"},{"i":"d42dd1ac-fc7d-4487-8f36-e0a7e597321b","t":"梁 庾信","a":"孫元晏","d":"唐","g":"短诗","p":["苦心詞賦向誰談，淪落周朝志豈甘。","可惜多才庾開府，一生惆悵憶江南。"],"s":"trad","f":"simp"},{"i":"f722c666-e64d-4a02-babf-0571a029977e","t":"陳 王僧辨","a":"孫元晏","d":"唐","g":"短诗","p":["彼此英雄各有名，石頭高臥擬爭衡。","當時堪笑王僧辨，待欲將心託聖明。"],"s":"trad","f":"simp"},{"i":"9be1afb4-54ca-4adf-bc04-758a4e5ec6ff","t":"陳 武帝蚌盤","a":"孫元晏","d":"唐","g":"短诗","p":["金翠絲黃略不舒，蚌盤清宴意何如。","豈知三閣繁華日，解爲君王妙破除。"],"s":"mixed","f":"simp"},{"i":"7b05353a-6a61-4908-8b0a-9e19b9d08cfa","t":"陳 虞居士","a":"孫元晏","d":"唐","g":"短诗","p":["苦諫將軍總不知，幾隨煙焰作塵飛。","東山居士何人識，惟有君王却許歸。"],"s":"mixed","f":"simp"},{"i":"0d86caf5-fc10-4ebc-8d7a-f3688857c71d","t":"陳 姚察","a":"孫元晏","d":"唐","g":"短诗","p":["曾佐徐陵向北遊，剖陳疑事動名流。","却歸掌選清何甚，一匹花綀不肯收。"],"s":"mixed","f":"simp"},{"i":"f8433b5d-4e0d-419f-be28-25b39fede0c9","t":"陳 宣帝傷將卒","a":"孫元晏","d":"唐","g":"短诗","p":["前後兵師戰勝回，百餘城壘盡歸來。","當時將卒應知感，況得君王爲舉哀。"],"s":"mixed","f":"simp"},{"i":"28ce92a9-063a-4091-91a8-42b92556e10d","t":"陳 臨春閣","a":"孫元晏","d":"唐","g":"短诗","p":["臨春高閣上侵雲，風起香飄數里聞。","自是君王正沈醉，豈知消息報隋軍。"],"s":"mixed","f":"simp"},{"i":"891e5f83-460a-4824-8eff-40709539ffbd","t":"陳 [結]綺閣","a":"孫元晏","d":"唐","g":"短诗","p":["結綺高宜眺海涯，上凌丹漢拂雲霞。","一千朱翠同居此，爭奈恩多屬麗華。"],"s":"trad","f":"simp"},{"i":"1d56783b-2d55-4497-9306-f9008d148523","t":"陳 望僊閣","a":"孫元晏","d":"唐","g":"短诗","p":["多少沈檀結築成，望仙爲號倚青冥。","不知孔氏何形狀，醉得君主不解醒。"],"s":"mixed","f":"simp"},{"i":"1d3b34d0-32ce-4f87-a1b5-95585c5b1317","t":"陳 三閣","a":"孫元晏","d":"唐","g":"短诗","p":["三閣相通綺宴開，數千朱翠遶周回。","只知斷送君王醉，不道韓擒已到來。"],"s":"mixed","f":"simp"},{"i":"d8cd45dc-274f-4b7f-ba31-2f8932e6c9c1","t":"陳 狎客","a":"孫元晏","d":"唐","g":"短诗","p":["八宮妃盡賦篇章，風揭歌聲錦繡香。","選得十人爲狎客，有誰能解諫君王。"],"s":"mixed","f":"simp"},{"i":"50152499-6d45-4892-b857-6d1f1830cf14","t":"陳 淮水","a":"孫元晏","d":"唐","g":"短诗","p":["文物衣冠盡入秦，六朝繁盛忽埃塵。","自從淮水乾枯後，不見王家更有人。"],"s":"trad","f":"simp"},{"i":"df67c3cd-47fc-4b31-bca5-bf321e745d99","t":"陳 江令宅","a":"孫元晏","d":"唐","g":"短诗","p":["不向南朝立諫名，舊居基在事分明。","令人惆悵江中令，只作篇章過一生。"],"s":"trad","f":"simp"},{"i":"f392e396-6adc-4339-9132-dabc6787532d","t":"陳 後庭舞","a":"孫元晏","d":"唐","g":"短诗","p":["嬿婉回風態若飛，麗華翹袖玉爲姿。","後庭一曲從教舞，舞破江山君未知。"],"s":"mixed","f":"simp"},{"i":"6eab8c6e-fcf9-45cf-9750-471fc2dbf153","t":"班倢伃","a":"嚴識玄","d":"唐","g":"短诗","p":["賤妾如桃李，君王若歲時。","秋風一已勁，搖落不勝悲。","寂寂蒼苔滿，沈沈綠草滋。","繁華非此日，指輦競何辭。"],"s":"trad","f":"simp"},{"i":"fc0723bf-29c7-4277-b1d9-3c12f2f7594a","t":"賦得御製句朔野陣雲飛","a":"何象","d":"唐","g":"短诗","p":["塞日穿痕斷，邊鴻背影飛。","縹緲浮黃屋，陰沈護御衣。"],"s":"trad","f":"simp"},{"i":"7b7b8b92-a509-4fb1-9b50-bca62b4ec925","t":"宿金河戍","a":"張震","d":"唐","g":"短诗","p":["朝發鐵麟驛，夕宿金河戍。","奔波急王程，一日千里路。","但見容鬢改，不知歲華暮。","悠悠沙漠行，王事彌多故。"],"s":"trad","f":"simp"},{"i":"b0c7c934-5567-451d-8e47-1e736eb6fac0","t":"補新宮 一","a":"丘光庭","d":"唐","g":"短诗","p":["奐奐新宮，禮樂其融。","爾德惟賢，爾□維忠。","爲忠以公，斯筵是同。","人之醉我，與我延賓。"],"s":"mixed","f":"simp"},{"i":"4b06c7fd-46b6-44f6-bed0-9de353df57b7","t":"補新宮 二","a":"丘光庭","d":"唐","g":"短诗","p":["奐奐新宮，既奐而輪。","其固如山，其儼如雲。","其寢斯安，□□□分。","我既考落，以燕羣臣。"],"s":"mixed","f":"simp"},{"i":"4d42007c-124c-4aa1-94ef-d228140bb294","t":"補新宮 三","a":"丘光庭","d":"唐","g":"短诗","p":["奐奐新宮，既祭既延。","我□□鏞，于以醉賢。","有禮無愆，我有斯宮。","斯宮以安，康後萬年。"],"s":"mixed","f":"simp"},{"i":"4ddba38c-4ffa-487d-89bf-468826b264de","t":"補茅鴟 一","a":"丘光庭","d":"唐","g":"短诗","p":["茅鴟茅鴟，無集我岡。","汝食汝飽，莫我爲祥。","願彈去汝，來彼鳳凰。","來彼鳳凰，其儀有章。"],"s":"mixed","f":"simp"},{"i":"9de3b6a3-cdf9-43ed-903a-1a098af5c426","t":"補茅鴟 二","a":"丘光庭","d":"唐","g":"短诗","p":["茅鴟茅鴟，無啄我雀。","汝食汝飽，莫我肯略。","願彈去汝，來彼瑞鵲。","來彼瑞鵲，其音可樂。"],"s":"trad","f":"simp"},{"i":"79874942-d8cc-4d1f-9dd0-d30241d1e20d","t":"補茅鴟 三","a":"丘光庭","d":"唐","g":"短诗","p":["茅鴟茅鴟，無搏鷅鶹。","汝食汝飽，莫我爲休。","願彈去汝，來彼鳲鳩。","來彼鳲鳩，食子其周。"],"s":"mixed","f":"simp"},{"i":"f5177fc1-3b2d-41b4-befb-c10d8b94ce8f","t":"補茅鴟 四","a":"丘光庭","d":"唐","g":"短诗","p":["茅鴟茅鴟，無㗲我陵。","汝食汝飽，莫我好聲。","願彈去汝，來彼蒼鷹。","來彼蒼鷹，祭鳥是徵。"],"s":"trad","f":"simp"},{"i":"1c8c0395-f63b-49cf-b055-2b10ea8afb78","t":"瑕瑜不相掩","a":"武翊黃","d":"唐","g":"古体","p":["抱璞應難辨，妍媸每自融。","貞姿偏特達，微玷遇磨礱。","涇渭流終異，瑕瑜自不同。","半曾光透石，未掩氣如虹。","縝密誠爲智，包藏豈謂忠。","停看分美惡，今得值良工。"],"s":"mixed","f":"simp"},{"i":"ccffe9d4-a66c-41ea-b04c-f4b374c83a94","t":"袁江口懷王司勳王吏部","a":"李祜","d":"唐","g":"短诗","p":["京華不啻三千里，客淚如今一萬雙。","若箇最爲相憶處，青楓黃竹入袁江。"],"s":"mixed","f":"simp"},{"i":"bafddc67-dc33-441c-8839-8d81601a9b87","t":"贈進士李守微","a":"韓嶼","d":"唐","g":"短诗","p":["一定童顏老歲華，貧寒游歷貴人家。","煉成正氣功應大，養得元神道不差。","舃曳鶴毛乾毾𣬬，杖攜筇節瘦槎牙。","如何蓬閬不歸去，落盡蟠桃幾度花。"],"s":"mixed","f":"simp"},{"i":"02d6505c-901e-4e90-a5da-78a864f9d4f2","t":"馬上有見","a":"李茂復","d":"唐","g":"短诗","p":["行盡疎林見小橋，綠楊深處有紅蕉。","無端眼界無分別，安置心頭不肯銷。"],"s":"trad","f":"simp"},{"i":"04d056a9-ca1e-45ff-af60-7a865eb9cffa","t":"自歎","a":"李茂復","d":"唐","g":"短诗","p":["落日西山近一竿，世間恩愛極難𢬵。","近來不作顛狂事，免被冤家惡眼看。"],"s":"trad","f":"simp"},{"i":"2f09b13c-f19d-45c5-af6e-cf099e8be705","t":"贈吳圓","a":"李曜","d":"唐","g":"短诗","p":["經年理郡少歡娛，爲習干戈間飲徒。","今日臨行盡交割，分明收取媚川珠。"],"s":"mixed","f":"simp"},{"i":"ae4156ff-c06a-446e-803b-131e304e1440","t":"答李曜","a":"吳圓","d":"唐","g":"短诗","p":["曳履優容日日歡，須言達德倍汍瀾。","韶光今已輸先手，領得蠙珠掌上看。"],"s":"trad","f":"simp"},{"i":"ccf25078-3cae-4ad7-9100-5a8512db0b7a","t":"和訾家洲宴游","a":"陸弘休","d":"唐","g":"短诗","p":["新春蘂綻訾家洲，信是南方最勝游。","酒滿百分殊不怕，人添一歲更堪愁。","鶯聲暗逐歌聲豔，花態還隨舞態羞。","莫惜今朝同酩酊，任他龜鶴與蜉蝣。"],"s":"mixed","f":"simp"},{"i":"13039106-f805-483a-b073-7e04517c87bf","t":"題賈島墓","a":"安錡","d":"唐","g":"短诗","p":["倚恃才難繼，昂藏貌不恭。","騎驢衝大尹，奪卷忤宣宗。","馳譽超先輩，居官下我儂。","司倉舊曹署，一見一心忡。"],"s":"trad","f":"simp"},{"i":"41d3aec4-a237-4e5b-97d2-43957c68c4a2","t":"贈別營妓卿卿","a":"油蔚","d":"唐","g":"短诗","p":["憐君無那是多情，枕上相看直到明。","日照綠窗人去住，鴉啼紅粉淚縱橫。","愁腸只向金閨斷，白髮應從玉塞生。","爲報花時少惆悵，此生終不負卿卿。"],"s":"mixed","f":"simp"},{"i":"3c530a5c-4785-44dd-8702-a7c2bb644f10","t":"巢燕","a":"胡玢","d":"唐","g":"短诗","p":["燕來巢我簷，我屋非高大。","所貴兒童善，保爾無殃禍。","莫巢孀婦家，孀婦怨孤坐。","妬爾長雙飛，打爾危巢破。"],"s":"trad","f":"simp"},{"i":"dd8476a2-6337-4d8b-a879-260811639ee2","t":"廬山桑落洲","a":"胡玢","d":"唐","g":"短诗","p":["莫問桑田事，但看桑落洲。","數家新住處，昔日大江流。","古岸崩欲盡，平沙長未休。","想應百年後，人世更悠悠。"],"s":"trad","f":"simp"},{"i":"dde4c549-84a9-4238-a1d4-db974bb54e6d","t":"石楠樹","a":"胡玢","d":"唐","g":"短诗","p":["本自清江石上生，移栽此處稱閑情。","青雲士盡識珍木，白屋人多喚俗名。","重布綠陰滋蘚色，深藏好鳥引雛聲。","余今一日千迴看，每度看來眼益明。"],"s":"mixed","f":"simp"},{"i":"c4c54bcd-4108-4ca9-9b33-b9c796b3dc8a","t":"句","a":"胡玢","d":"唐","g":"短诗","p":["輪中別有物，光外更無空。"],"s":"trad","f":"simp"},{"i":"d63d1035-09c2-473d-b8e0-c43e976f601a","t":"酒胡子","a":"盧注","d":"唐","g":"古体","p":["同心相遇思同歡，擎出酒胡當玉盤。","盤中臲卼不自定，四座清賓注意看。","可亦不在心，否亦不在面，徇客隨時自圓轉。","酒胡五藏屬他人，十分亦是無情勸。","爾不耕，亦不飢。","爾不蠶，亦有衣。","有眼不能分黼黻，有口不能明是非。","鼻何尖，眼何碧，儀形本非天地力。","雕鐫匠意苦多端，翠帽朱衫巧妝飾。","長安斗酒十千酤，劉伶平生爲酒徒。","劉伶虛向酒中死，不得酒池中拍浮。","酒胡一滴不入眼，空令酒胡名酒胡。"],"s":"mixed","f":"simp"},{"i":"47f5de23-d195-4308-8f41-b338c254a927","t":"西施","a":"盧注","d":"唐","g":"短诗","p":["惆悵興亡繫綺羅，世人猶自選青娥。","越王解破夫差國，一箇西施已是多。"],"s":"trad","f":"simp"},{"i":"c5944a00-b312-43f8-94ce-f59c3b2ec15c","t":"題西施浣紗石","a":"胡幽貞","d":"唐","g":"短诗","p":["一朝入紫宮，萬古遺芳塵。","至今溪邊花，不敢嬌青春。"],"s":"trad","f":"simp"},{"i":"4b35033b-44a4-4886-98c0-32a4ec016706","t":"歸四明","a":"胡幽貞","d":"唐","g":"短诗","p":["海色連四明，仙舟去容易。","天籍豈輙問，不是卑朝士。"],"s":"trad","f":"simp"},{"i":"7f9a3f44-57d4-4214-9c17-56325d206675","t":"送人游邵州","a":"狄煥","d":"唐","g":"短诗","p":["春江正渺渺，送別兩依依。","煙裏棹將遠，渡頭人未歸。","漁家侵疊浪，島樹挂殘暉。","況入湖湘路，那堪花亂飛。"],"s":"mixed","f":"simp"},{"i":"8f2d4534-c99a-4639-8b0b-c02d34b56b4c","t":"題柳","a":"狄煥","d":"唐","g":"短诗","p":["天南與天北，此處影婆娑。","翠色折不盡，離情生更多。","雨餘籠灞岸，煙暝夾隋河。","自有佳名在，秦松繼得麽。"],"s":"mixed","f":"simp"},{"i":"31fce595-d7f2-44dc-821f-f692a1a27d16","t":"詠南嶽徑松","a":"狄煥","d":"唐","g":"短诗","p":["一陣雨聲歸嶽嶠，兩條寒色下瀟湘。","客吟晚景停孤櫂，僧踏清陰徹上方。"],"s":"trad","f":"simp"},{"i":"ed2249ab-f00c-4a51-8add-257c5e794e72","t":"句","a":"狄煥","d":"唐","g":"短诗","p":["數點當秋霽，不知何處峰？更無聲接續，空有影相隨。"],"s":"trad","f":"simp"},{"i":"9d74df0b-604b-45dc-802c-841be59f0112","t":"潯陽觀水","a":"韓溉","d":"唐","g":"短诗","p":["朝宗漢水接陽臺，唅呀填坑吼作雷。","莫見九江平穩去，還從三峽嶮巇來。","南經夢澤寬浮日，西出岷山劣泛杯。","直至滄溟涵貯盡，沈深不動浸昭回。"],"s":"trad","f":"simp"},{"i":"14b55283-69b8-480c-8008-a762da10d4cc","t":"水","a":"韓溉","d":"唐","g":"短诗","p":["方圓不定性空求，東注滄溟早晚休。","高截碧塘長耿耿，遠飛青嶂更悠悠。","瀟湘月浸千年色，夢澤煙含萬古愁。","別有嶺頭嗚咽處，爲君分作斷腸流。"],"s":"mixed","f":"simp"},{"i":"ffb6bc82-a940-47dc-bb6a-8ad208454518","t":"松","a":"韓溉","d":"唐","g":"短诗","p":["倚空高檻冷無塵，往事閑徵夢欲分。","翠色本宜霜後見，寒聲偏向月中聞。","啼猿想帶蒼山雨，歸鶴應和紫府雲。","莫向東園競桃李，春光還是不容君。"],"s":"trad","f":"simp"},{"i":"a114e227-28f2-4877-b744-12cdb34cb7e6","t":"柳","a":"韓溉","d":"唐","g":"短诗","p":["雪盡青門弄影微，暖風遲日早鶯歸。","如憑細葉留春色，須把長條繫落暉。","彭澤有情還鬱鬱，隋堤無主自依依。","世間惹恨偏饒此，可是行人折贈稀。"],"s":"trad","f":"simp"},{"i":"c457dc82-d65a-4575-af65-1a6ea5e72862","t":"竹","a":"韓溉","d":"唐","g":"短诗","p":["樹色連雲萬葉開，王孫不厭滿庭栽。","凌霜盡節無人見，終日虛心待鳳來。","誰許風流添興詠，自憐瀟灑出塵埃。","朱門處處多閑地，正好移陰覆翠苔。"],"s":"trad","f":"simp"},{"i":"f59dbad4-f4cd-47e4-a839-9d9597d5ab7a","t":"鵲","a":"韓溉","d":"唐","g":"短诗","p":["纔見離巢羽翼開，盡能輕颺出塵埃。","人間樹好紛紛占，天上橋成草草回。","幾度送風臨玉戶，一時傳喜到妝臺。","若教顏色如霜雪，應與清平作瑞來。"],"s":"mixed","f":"simp"},{"i":"4678e71d-2920-4548-a8ea-1cb759c445d3","t":"燈","a":"韓溉","d":"唐","g":"短诗","p":["分影由來恨不同，綠窗孤館兩何窮。","熒煌短焰長疑暗，零落殘花旋委空。","幾處隔簾愁夜雨，誰家當戶怯秋風。","莫言明滅無多重，曾比人生一世中。"],"s":"trad","f":"simp"},{"i":"710f1b9a-9b92-44a9-90f9-4d0e238fcd2b","t":"句","a":"韓溉","d":"唐","g":"短诗","p":["門掩落花人別後，窗含殘月酒醒時。"],"s":"trad","f":"simp"},{"i":"18d34867-5ad9-4787-8ebd-8fd03e6a0cc1","t":"放猨","a":"曾麻幾","d":"唐","g":"短诗","p":["孤猨鎖檻歲年深，放出城南百丈林。","綠水任從聯臂飲，青山不用斷腸吟。"],"s":"trad","f":"simp"},{"i":"3189af41-4de5-42ed-99ce-aa99ab2de0fa","t":"觀兄弟同夜成婚","a":"鄭軌","d":"唐","g":"短诗","p":["棠棣開雙萼，夭桃照兩花。","分庭含佩響，隔扇偶妝華。","迎風俱似雪，映綺共如霞。","今宵二神女，幷在一仙家。"],"s":"trad","f":"simp"},{"i":"f947de8c-92fe-4321-b627-721ffd429241","t":"夏彈琴","a":"劉戩","d":"唐","g":"古体","p":["碧山本岑寂，素琴何清幽。","彈爲風入松，崖谷颯已秋。","庭鶴舞白雪，泉魚躍洪流。","予欲娛世人，明月難暗投。","感歎未終曲，淚下不可收。","嗚呼鍾子期，零落歸荒丘。","死而若有知，魂兮從我游。"],"s":"mixed","f":"simp"},{"i":"e86e8bf4-f3a8-414e-94fc-007f80e4354e","t":"過函谷關","a":"楊齊哲","d":"唐","g":"短诗","p":["地險崤函北，途經分陝東。","逶迤衆山盡，荒涼古塞空。","河光流曉日，樹影散朝風。"],"s":"mixed","f":"simp"},{"i":"40b3c2f6-393c-4968-9b1e-c3d592592d9a","t":"傷死奴","a":"劉夷道","d":"唐","g":"短诗","p":["丹籍生涯淺，黃泉歸路深。","不及江陵樹，千秋長作林。"],"s":"trad","f":"simp"},{"i":"2cabf81a-c85e-4b1a-ab19-572d4d719d3f","t":"侍宴賦得起坐彈鳴琴二首 一","a":"楊希道","d":"唐","g":"短诗","p":["北林鵲夜飛，南軒月初進。","調弦發清徵，蕩心怯褊恡。","變作離鴻聲，還入思歸引。","長歎未終極，秋風飄素鬢。"],"s":"trad","f":"simp"},{"i":"b9801b4c-510e-45b1-ba22-ebf5090704e3","t":"侍宴賦得起坐彈鳴琴二首 二","a":"楊希道","d":"唐","g":"短诗","p":["絲傳園客意，曲奏楚妃情。","罕有知音者，空勞流水聲。"],"s":"trad","f":"simp"},{"i":"6b84794e-f7ac-43fe-9356-82bb680bfb7c","t":"詠琴","a":"楊希道","d":"唐","g":"短诗","p":["久擅龍門質，孤竦嶧陽名。","齊[娥]初發弄，趙女正調聲。","嘉客勿遽反，繁弦曲未成。"],"s":"trad","f":"simp"},{"i":"c5bc841e-5d20-49d2-a91b-61222eb792fb","t":"詠笙","a":"楊希道","d":"唐","g":"短诗","p":["短長插鳳翼，洪細摹鸞音。","能令楚妃歎，復使荆王吟。","切切孤竹管，來應雲和琴。"],"s":"mixed","f":"simp"},{"i":"55300d72-52fa-43d6-8a05-fac0c6e4bf40","t":"詠舞","a":"楊希道","d":"唐","g":"短诗","p":["二八如同雪，三春類早花。","分行向燭轉，一種逐風斜。"],"s":"trad","f":"simp"},{"i":"2d09a638-dd14-44ac-ac17-ed416422bdca","t":"詠妓","a":"王勣","d":"唐","g":"短诗","p":["妖姬飾靚妝，窈窕出蘭房。","日照當軒影，風吹滿路香。","早時歌扇薄，今日舞衫長。","不應令曲誤，持此試周郎。"],"s":"trad","f":"simp"},{"i":"bb34b393-79b9-4ebe-9760-86e6f6be66d1","t":"益州城西張超亭觀妓","a":"王勣","d":"唐","g":"短诗","p":["落日明歌席，行雲逐舞人。","江前飛暮雨，梁上下輕塵。","冶服看疑畫，妝臺望似春。","高車勿遽返，長袖欲相親。"],"s":"trad","f":"simp"},{"i":"d91474a0-27fa-4e20-b243-10acb4190cc7","t":"辛司法宅觀妓","a":"王勣","d":"唐","g":"短诗","p":["南國佳人至，北堂羅薦開。","長裙隨鳳管，促柱送鸞杯。","雲光身後落，雪態掌中回。","到愁金谷晚，不怪玉山頹。"],"s":"trad","f":"simp"},{"i":"ef029348-a389-4705-8903-d17de5734933","t":"秋池一枝蓮","a":"郭恭","d":"唐","g":"短诗","p":["秋至皆零落，凌波獨吐紅。","托根方得所，未肯即隨風。"],"s":"trad","f":"simp"},{"i":"9236e030-9820-49e0-b5be-aef19dcaf9b3","t":"婕妤怨","a":"張烜","d":"唐","g":"短诗","p":["賤妾裁紈扇，初搖明月姿。","君王看舞席，坐起秋風時。","玉樹清御路，金陳翳垂絲。","昭陽無分理，愁寂任前期。"],"s":"trad","f":"simp"},{"i":"76519323-4e3f-4442-b757-dce23dc21c5d","t":"長門怨","a":"張修之","d":"唐","g":"短诗","p":["長門落景盡，洞房秋月明。","玉階草露積，金屋網塵生。","妾妒今應改，君恩昔未平。","寄語臨邛客，何時作賦成。"],"s":"trad","f":"simp"},{"i":"d1b0278c-d198-48e5-954b-fbc27eb7b526","t":"王昭君","a":"梁獻","d":"唐","g":"短诗","p":["圖畫失天真，容華坐誤人。","君恩不可再，妾命在和親。","淚點關山月，衣銷邊塞塵。","一聞陽鳥至，思絕漢宮春。"],"s":"trad","f":"simp"},{"i":"605e8805-d2fa-41ff-a7e9-7140c78ef7ac","t":"芳樹","a":"符子珪","d":"唐","g":"短诗","p":["芳樹宜三月，曈曈豔綺年。","香交珠箔氣，陰占綠庭煙。","小葉風吹長，繁花露濯鮮。","遂令穠李兒，折取簪花鈿。"],"s":"mixed","f":"simp"},{"i":"54c32e1f-8b27-41d9-a0b5-e5f2582f9dba","t":"觀妓","a":"李何","d":"唐","g":"短诗","p":["向晚小乘遊，朝來新上頭。","從來許長袖，未有客難留。"],"s":"trad","f":"simp"},{"i":"062e81ae-95dc-4d3e-b9f9-ea23451c82c5","t":"邯鄲俠少年","a":"鄭鏦","d":"唐","g":"短诗","p":["夜渡濁河津，衣中劒滿身。","兵符劫晉鄙，匕首刺秦人。","執事非無膽，高堂念有親。","昨緣秦苦趙，來往大梁頻。"],"s":"trad","f":"simp"},{"i":"9fe17dde-0803-4a16-b0af-30048872d60a","t":"玉階怨","a":"鄭鏦","d":"唐","g":"短诗","p":["昔日同飛燕，今朝似伯勞。","情深爭擲果，寵罷怨殘桃。","別殿春心斷，長門夜樹高。","雖能不自悔，誰見舊衣褒。"],"s":"trad","f":"simp"},{"i":"2bf75b4d-b436-4606-be25-38d14287b43f","t":"婕妤怨","a":"鄭鏦","d":"唐","g":"短诗","p":["南國承歡日，東方候曉時。","那能妒褒姒，祗愛笑唐兒。","寶葉隨雲髻，珠絲鍛履綦。","不知飛燕意，何事苦相疑。"],"s":"trad","f":"simp"},{"i":"c85a7438-8498-42aa-a9f3-f0f89c1887b4","t":"入塞曲","a":"鄭鏦","d":"唐","g":"短诗","p":["留滯邊庭久，歸思歲月賒。","黃雲同入塞，白首獨還家。","宛馬隨秦草，胡人問漢花。","還傷李都尉，獨自沒黃沙。"],"s":"trad","f":"simp"},{"i":"55655ff6-aef0-4f87-b017-157afe23cee6","t":"賞殘花","a":"紇干著","d":"唐","g":"短诗","p":["零落多依草，芳香散著人。","低簷一枝在，猶占滿堂春。"],"s":"mixed","f":"simp"},{"i":"569ed0de-4674-4941-bd23-c1a0634d26b8","t":"古仙詞","a":"紇干著","d":"唐","g":"短诗","p":["珠幡絳節曉霞中，漢武清齋待少翁。","不向人間戀春色，桃花自滿紫陽宮。"],"s":"mixed","f":"simp"},{"i":"5ac2ecfc-6d6e-4a3c-a503-d23fac7c0ae2","t":"感春詞","a":"紇干著","d":"唐","g":"短诗","p":["未得鳴珂謁漢宮，江頭寂寞向春風。","悲歌一曲心應醉，萬葉千花淚眼中。"],"s":"mixed","f":"simp"},{"i":"5c47ef80-a127-446d-8ecb-31eaabcd34d0","t":"灞上","a":"紇干著","d":"唐","g":"短诗","p":["鳴鞭晚日禁城東，渭水晴煙灞岸風。","都傍柳陰回首望，春天樓閣五雲中。"],"s":"mixed","f":"simp"},{"i":"8004b06b-41b5-43aa-ba43-ce8e418407fe","t":"凌雲寺","a":"李習","d":"唐","g":"短诗","p":["古寺臨江間碧波，石梯深入白雲窠。","僧禪寂寂無人跡，滿地落花春又過。"],"s":"trad","f":"simp"},{"i":"18575368-2853-4fc0-b1ee-8f98e9e0e42a","t":"鳳棲怨","a":"顏舒","d":"唐","g":"短诗","p":["佳人名莫愁，珠箔上花鉤。","清鏡鴛鴦匣，新妝翡翠樓。","擣衣明月夜，吹管白雲秋。","惟恨金吾子，年年向隴頭。"],"s":"trad","f":"simp"},{"i":"d5475f18-667a-4f89-a97a-35b1a4550ac8","t":"春女怨","a":"朱絳","d":"唐","g":"短诗","p":["獨坐紗窗刺繡遲，紫荆花下囀黃鸝。","欲知無限傷春意，盡在停針不語時。"],"s":"mixed","f":"simp"}]