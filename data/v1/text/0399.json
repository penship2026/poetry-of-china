[{"i":"a1951ae4-c079-47e1-90e9-fc5fe1c7c98e","t":"春晚","a":"崔道融","d":"唐","g":"短诗","p":["三月寒食時，日色濃於酒。","落盡牆頭花，鶯聲隔原柳。"],"s":"trad","f":"simp"},{"i":"2a815db8-4abd-4219-aeeb-02be5d657b19","t":"漢宮詞","a":"崔道融","d":"唐","g":"短诗","p":["獨詔胡衣出，天花落殿堂。","他人不敢妬，垂淚向君王。"],"s":"trad","f":"simp"},{"i":"42dfbd71-6a02-4779-b13f-90e9f9d2be42","t":"旅行","a":"崔道融","d":"唐","g":"短诗","p":["少壯經勤苦，衰年始浪遊。","誰憐不龜手，他處却封侯。"],"s":"mixed","f":"simp"},{"i":"265fb53a-27c6-41bb-9050-ada25e9f9ee9","t":"班婕妤","a":"崔道融","d":"唐","g":"短诗","p":["寵極辭同輦，恩深棄後宮。","自題秋扇後，不敢怨春風。"],"s":"trad","f":"simp"},{"i":"68edd417-9da1-4f1a-b003-2aa0cf97e535","t":"元日有題","a":"崔道融","d":"唐","g":"短诗","p":["十載元正酒，相歡意轉深。","自量麋鹿分，只合在山林。"],"s":"trad","f":"simp"},{"i":"8f95780a-5805-4778-9005-869907237587","t":"古樹","a":"崔道融","d":"唐","g":"短诗","p":["古樹春風入，陽和力太遲。","莫言生意盡，更引萬年枝。"],"s":"trad","f":"simp"},{"i":"6a9661cf-57ca-449b-b308-69c113506170","t":"春題二首 一","a":"崔道融","d":"唐","g":"短诗","p":["青春未得意，見花却如讐。","路逢白面郎，醉插花滿頭。"],"s":"mixed","f":"simp"},{"i":"b5feb89f-dc1b-4d9b-b523-43934ff19d07","t":"春題二首 二","a":"崔道融","d":"唐","g":"短诗","p":["滿眼桃李花，愁人如不見。","別有惜花人，東風莫吹散。"],"s":"trad","f":"simp"},{"i":"3a56e675-4972-41f5-9b57-7a676203580a","t":"長安春","a":"崔道融","d":"唐","g":"短诗","p":["長安牡丹開，繡轂輾晴雷。","若使花長在，人應看不回。"],"s":"trad","f":"simp"},{"i":"2c67f463-679f-4c52-8e1e-dea47735aa94","t":"病起二首 一","a":"崔道融","d":"唐","g":"短诗","p":["病起春已晚，曳筇傷綠苔。","強攀庭樹枝，喚作花未開。"],"s":"trad","f":"simp"},{"i":"939a80cc-e75e-499e-9251-bdeee7d598ec","t":"病起二首 二","a":"崔道融","d":"唐","g":"短诗","p":["病起遶庭除，春泥黏屐齒。","如從萬里來，骨肉滿面喜。"],"s":"mixed","f":"simp"},{"i":"74add4ef-98f9-4833-8e5c-062bdfbab8f7","t":"峽路","a":"崔道融","d":"唐","g":"短诗","p":["清猨啼不住，白水下來新。","八月莫爲客，夜長愁殺人。"],"s":"mixed","f":"simp"},{"i":"db70d0ad-809e-4236-999d-7a773d0aaf46","t":"長門怨","a":"崔道融","d":"唐","g":"短诗","p":["長門春欲盡，明月照花枝。","買得相如賦，君恩不可移。"],"s":"trad","f":"simp"},{"i":"974b9ab5-5e91-4a0c-a515-f9516043ab2d","t":"月夕有懷","a":"崔道融","d":"唐","g":"短诗","p":["圓光照一海，遠客在孤舟。","相憶無期見，中宵獨上樓。"],"s":"trad","f":"simp"},{"i":"ac21d367-6082-451f-8c04-d00f406a7c7b","t":"夜泊九江","a":"崔道融","d":"唐","g":"短诗","p":["夜泊江門外，歡聲月裏樓。","明朝歸去路，猶隔洞庭秋。"],"s":"mixed","f":"simp"},{"i":"cfc8ccb7-1fc2-4a61-905d-7b59c79d5571","t":"寒食夜","a":"崔道融","d":"唐","g":"短诗","p":["滿地梨花白，風吹碎月明。","大家寒食夜，獨貯望鄉情。"],"s":"trad","f":"simp"},{"i":"1addc82e-6d17-47d7-b089-3f7273fede40","t":"歸燕","a":"崔道融","d":"唐","g":"短诗","p":["海燕頻來去，西人獨滯留。","天邊又相送，腸斷故園秋。"],"s":"trad","f":"simp"},{"i":"9f5efe86-5e9a-4e12-9b71-73710139bd5c","t":"長安春","a":"崔道融","d":"唐","g":"短诗","p":["珠箔映高柳，美人紅袖垂。","忽聞半天語，不見上樓時。"],"s":"trad","f":"simp"},{"i":"4973c3cd-702f-470d-abfa-c194e4688dca","t":"鑾駕東回","a":"崔道融","d":"唐","g":"短诗","p":["兩川花捧御衣香，萬歲山呼輦路長。","天子還從馬嵬過，別無惆悵似明皇。"],"s":"trad","f":"simp"},{"i":"1a808ecb-f462-4c8d-9ae3-b8f7e0401e8a","t":"釣魚","a":"崔道融","d":"唐","g":"短诗","p":["閑釣江魚不釣名，瓦甌斟酒暮山青。","醉頭倒向蘆花裏，却笑無端犯客星。"],"s":"mixed","f":"simp"},{"i":"28acff24-003a-4fd0-bf3a-b8a3a5dbfc65","t":"西施","a":"崔道融","d":"唐","g":"短诗","p":["苧蘿山下如花女，占得姑蘇臺上春。","一笑不能亡敵國，五湖何處有功臣。"],"s":"mixed","f":"simp"},{"i":"2b15cfb0-61fb-4081-aa00-3504ea2c69f4","t":"馬嵬","a":"崔道融","d":"唐","g":"短诗","p":["萬乘淒涼蜀路歸，眼前珠翠與心違。","重華不是風流主，湘水猶傳泣二妃。"],"s":"trad","f":"simp"},{"i":"c0695c4d-445c-4f5e-876a-66ed7276ba7c","t":"羯鼓","a":"崔道融","d":"唐","g":"短诗","p":["華清宮裏打撩聲，供奉絲簧束手聽。","寂莫鑾輿斜谷裏，是誰翻得雨淋鈴。"],"s":"mixed","f":"simp"},{"i":"bd98b37a-ab9e-4091-993a-275807aaa109","t":"寄李左司","a":"崔道融","d":"唐","g":"短诗","p":["柏臺蘭省共清風，鳴玉朝聯夜被同。","肯信人間有兄弟，一生長在別離中。"],"s":"trad","f":"simp"},{"i":"a6216d09-d483-41dc-9d17-0b06080cca81","t":"梅","a":"崔道融","d":"唐","g":"短诗","p":["溪上寒梅初滿枝，夜來霜月透芳菲。","清光寂莫思無盡，應待琴尊與解圍。"],"s":"trad","f":"simp"},{"i":"e1e02bad-41af-4ef2-93fd-18e5b496a648","t":"天台陳逸人","a":"崔道融","d":"唐","g":"短诗","p":["絕粒空山秋復春，欲看滄海化成塵。","近拋三井更深去，不怕虎狼唯怕人。"],"s":"trad","f":"simp"},{"i":"a7691e6d-8859-45d2-b4c7-36554d206f51","t":"雪竇禪師","a":"崔道融","d":"唐","g":"短诗","p":["雪竇峰前一派懸，雪竇五月無炎天。","客塵半日洗欲盡，師到白頭林下禪。"],"s":"trad","f":"simp"},{"i":"f585e4de-95f0-45f7-a34e-7c4221b6d3d4","t":"溪上遇雨二首 一","a":"崔道融","d":"唐","g":"短诗","p":["回塘雨脚如繰絲，野禽不起沈魚飛。","耕蓑釣笠取未暇，秋田有望從淋漓。"],"s":"mixed","f":"simp"},{"i":"df968053-5d06-4c13-ac3f-5b8cf26e433f","t":"溪上遇雨二首 二","a":"崔道融","d":"唐","g":"短诗","p":["坐看黑雲銜猛雨，噴灑前山此獨晴。","忽驚雲雨在頭上，却是山前晚照明。"],"s":"mixed","f":"simp"},{"i":"9cf0386a-3b8e-430c-937f-2c7bb5a88634","t":"長門怨","a":"崔道融","d":"唐","g":"短诗","p":["長門花泣一枝春，爭奈君恩別處新。","錯把黃金買詞賦，相如自是薄情人。"],"s":"trad","f":"simp"},{"i":"c4cbf5d5-0022-4269-8b56-9a96630563d2","t":"秋夕","a":"崔道融","d":"唐","g":"短诗","p":["自憐三十未西遊，傍山尋水過却秋。","一夜雨聲多少事，不思量盡到心頭。"],"s":"mixed","f":"simp"},{"i":"f0e62035-a049-4814-b33b-06c0a39a1368","t":"過隆中","a":"崔道融","d":"唐","g":"短诗","p":["玄德蒼黃起臥龍，鼎分天下一言中。","可憐蜀國關張後，不見商量徐庶功。"],"s":"trad","f":"simp"},{"i":"3d4e4652-222a-4e7c-aca6-2f7dcd113df6","t":"關下","a":"崔道融","d":"唐","g":"短诗","p":["百二山河壯帝畿，關門何事更開遲。","應從漏却田文後，每度聞雞不免疑。"],"s":"mixed","f":"simp"},{"i":"8aa7a4d3-1116-4528-a746-409f534c4af2","t":"寒食客中有懷","a":"崔道融","d":"唐","g":"短诗","p":["江上聞鶯禁火時，百花開盡柳依依。","故園兄弟別來久，應到清明猶望歸。"],"s":"trad","f":"simp"},{"i":"1ea4c7c1-96de-468a-b4dc-2b7ae6e1679b","t":"溪夜","a":"崔道融","d":"唐","g":"短诗","p":["積雪消來溪水寬，滿樓明月碎琅玕。","漁人拋得釣筒盡，却放輕舟下急灘。"],"s":"mixed","f":"simp"},{"i":"4c6d58fb-45bb-4da0-9a27-c47b583dffc9","t":"山居臥疾廣利大師見訪","a":"崔道融","d":"唐","g":"短诗","p":["桐谷孫枝已上弦，野人猶臥白雲邊。","九天飛錫應相誚，三到行朝二十年。"],"s":"trad","f":"simp"},{"i":"b19282c0-6f4c-4824-a886-31587743db98","t":"村墅","a":"崔道融","d":"唐","g":"短诗","p":["正月二月村墅閑，餘糧未乏人心寬。","南鄰雨中揭屋笑，酒熟數家來相看。"],"s":"trad","f":"simp"},{"i":"a3ba3aaa-56fb-4349-8f6c-993e59c02f11","t":"悲李拾遺二首 一","a":"崔道融","d":"唐","g":"短诗","p":["故友從來匪石心，諫多難得主恩深。","行朝半夜煙塵起，曉殿吁嗟一鏡沈。"],"s":"trad","f":"simp"},{"i":"0759e765-e492-4a53-86d3-adbd90226f36","t":"悲李拾遺二首 二","a":"崔道融","d":"唐","g":"短诗","p":["天涯時有北來塵，因話它人及故人。","也是先皇能罪己，殿前頻得觸龍鱗。"],"s":"trad","f":"simp"},{"i":"e90db7a5-9194-43db-999b-321a6111b8db","t":"題李將軍傳","a":"崔道融","d":"唐","g":"短诗","p":["猨臂將軍去似飛，彎弓百步虜無遺。","漢文自與封侯得，何必傷嗟不遇時。"],"s":"trad","f":"simp"},{"i":"9f3e021b-7f42-4a98-b8da-1cd77f15ba57","t":"酒醒","a":"崔道融","d":"唐","g":"短诗","p":["酒醒撥剔殘灰火，多少淒涼在此中。","爐畔自斟還自醉，打窗深夜雪兼風。"],"s":"trad","f":"simp"},{"i":"a60dc4e6-debb-4173-b3a9-4860533b2dd7","t":"郊居友人相訪","a":"崔道融","d":"唐","g":"短诗","p":["柴門深掩古城秋，背郭緣溪一徑幽。","不有小園新竹色，君來那肯暫淹留。"],"s":"trad","f":"simp"},{"i":"3493b6cf-3c6e-449e-977f-e318c970d58e","t":"鏡湖雪霽貽方干","a":"崔道融","d":"唐","g":"短诗","p":["天外曉嵐和雪望，月中歸棹帶冰行。","相逢半醉吟詩苦，應抵寒猨褭樹聲。"],"s":"mixed","f":"simp"},{"i":"e067dc71-805f-4574-90f0-8405411ec5a0","t":"秋霽","a":"崔道融","d":"唐","g":"短诗","p":["雨霽長空蕩滌清，遠山初出未知名。","夜來江上如鉤月，時有驚魚擲浪聲。"],"s":"trad","f":"simp"},{"i":"df58e4c6-146a-4a87-8d30-73b746131439","t":"謝朱常侍寄貺蜀茶剡紙二首 一","a":"崔道融","d":"唐","g":"短诗","p":["瑟瑟香塵瑟瑟泉，驚風驟雨起爐煙。","一甌解却山中醉，便覺身輕欲上天。"],"s":"mixed","f":"simp"},{"i":"9882b179-0e51-4177-a7bd-bcbed5160927","t":"謝朱常侍寄貺蜀茶剡紙二首 二","a":"崔道融","d":"唐","g":"短诗","p":["百幅輕明雪未融，薛家凡紙漫深紅。","不應點染閑言語，留記將軍蓋世功。"],"s":"trad","f":"simp"},{"i":"6825dad7-653d-4a02-85c0-ce50569da4bd","t":"讀杜紫微集","a":"崔道融","d":"唐","g":"短诗","p":["紫微才調復知兵，長覺風雷筆下生。","還有枉拋心力處，多於五柳賦閑情。"],"s":"trad","f":"simp"},{"i":"745d0d5f-a3e4-4d37-a1a1-8dce3c7c8781","t":"寓題","a":"崔道融","d":"唐","g":"短诗","p":["海上乘查便合仙，若無仙骨未如船。","人間亦有支機石，虛被聲名到洞天。"],"s":"trad","f":"simp"},{"i":"cd25b8b0-12a6-4e4a-afd5-6d8a81d814dd","t":"寓吟集","a":"崔道融","d":"唐","g":"短诗","p":["陶集篇篇皆有酒，崔詩句句不無杯。","醉來已共身安約，讓却詩人作酒魁。"],"s":"mixed","f":"simp"},{"i":"82bb1412-3207-44e7-befd-d3ee9f3d4b96","t":"溪居即事","a":"崔道融","d":"唐","g":"短诗","p":["籬外誰家不繫船，春風吹入釣魚灣。","小童疑是有村客，急向柴門去却關。"],"s":"mixed","f":"simp"},{"i":"061dfcc6-b614-4c62-a405-2316d5a108be","t":"雞","a":"崔道融","d":"唐","g":"短诗","p":["買得晨雞共雞語，常時不用等閑鳴。","深山月黑風雨夜，欲近曉天啼一聲。"],"s":"trad","f":"simp"},{"i":"053c7b0a-88ca-451f-84dc-76df195bc167","t":"獻浙東柳大夫","a":"崔道融","d":"唐","g":"短诗","p":["屬城甘雨幾經春，聖主全分付越人。","俗眼不知青瑣貴，江頭爭看碧油新。"],"s":"trad","f":"simp"},{"i":"9c5a93c9-8486-4e2c-a496-e9512e5ea123","t":"楊柳枝詞","a":"崔道融","d":"唐","g":"短诗","p":["霧撚煙搓一索春，年年長似染來新。","應須喚作風流線，繫得東西南北人。"],"s":"trad","f":"simp"},{"i":"07f43cb8-2a57-46e7-9037-da9b7c8c5f04","t":"楚懷王","a":"崔道融","d":"唐","g":"短诗","p":["宮花一朵掌中開，緩急翻爲敵國媒。","六里江山天下笑，張儀容易去還來。"],"s":"mixed","f":"simp"},{"i":"a8ff7592-9643-4cdc-a6c3-5a8bde83b40f","t":"對早梅寄友人二首 一","a":"崔道融","d":"唐","g":"短诗","p":["憶得前年君寄詩，海邊三見早梅詞。","與君猶是海邊客，又見早梅花發時。"],"s":"trad","f":"simp"},{"i":"d8351dd2-c045-42a4-ac5b-6ae504f541be","t":"對早梅寄友人二首 二","a":"崔道融","d":"唐","g":"短诗","p":["憶得去年有遺恨，花前未醉到無花。","清芳一夜月通白，先脫寒衣送酒家。"],"s":"trad","f":"simp"},{"i":"6266f79f-b404-4018-ae32-25d31a2eadd0","t":"句","a":"崔道融","d":"唐","g":"短诗","p":["萬里一點白，長空鳥不飛。","如今却羨相如富，猶有人間四壁居。"],"s":"mixed","f":"simp"},{"i":"3b947d6b-04dc-4edd-97f1-782fe327d022","t":"苦吟","a":"盧延讓","d":"唐","g":"短诗","p":["莫話詩中事，詩中難更無。","吟安一箇字，撚斷數莖鬚。","險覓天應悶，狂搜海亦枯。","不同文賦易，爲著者之乎。"],"s":"mixed","f":"simp"},{"i":"11602a93-e149-48e0-9efb-8a0911951926","t":"雪","a":"盧延讓","d":"唐","g":"短诗","p":["瑞雪落紛華，隨風一向斜。","地平鋪作月，天迥撒成花。","客滿燒煙舍，牛牽賣炭車。","吾皇憂挾纊，猶自問君家。"],"s":"trad","f":"simp"},{"i":"c9c61b9a-b463-43e2-b6cd-b50deb767676","t":"松寺","a":"盧延讓","d":"唐","g":"短诗","p":["山寺取涼當夏夜，共僧蹲坐石堦前。","兩三條電欲爲雨，七八箇星猶在天。","衣汗稍停牀上扇，茶香時撥澗中泉。","通宵聽論蓮華義，不藉松窗一覺眠。"],"s":"mixed","f":"simp"},{"i":"dd011c73-a35f-47cf-a44a-5410db21f04f","t":"贈僧","a":"盧延讓","d":"唐","g":"短诗","p":["浮世浮華一斷空，偶拋煩惱到蓮宮。","高僧解語牙無水，老鶴能飛骨有風。","野色吟餘生竹外，山陰坐久入池中。","禪師莫問求名苦，滋味過於食蓼蟲。"],"s":"trad","f":"simp"},{"i":"f1402199-f1c2-4457-8db1-fe4f31568caf","t":"逢友人赴闕","a":"盧延讓","d":"唐","g":"短诗","p":["正當天下待雍熙，丹詔徴來早爲遲。","倚馬才高猶愛藝，問牛心在肯容私。","吏開黃閣排班處，民擁青門看入時。","却笑郡人留不得，感恩唯擬立生祠。"],"s":"mixed","f":"simp"},{"i":"f723ecc8-751a-4fb8-8ae0-ef1485c35d58","t":"哭李郢端公","a":"盧延讓","d":"唐","g":"短诗","p":["軍門半掩槐花宅，每過猶聞哭臨聲。","北固暴亡兼在路，東都權葬未歸塋。","漸窮老僕慵看馬，著慘佳人暗理箏。","詩侶酒徒消散盡，一場春夢越王城。"],"s":"trad","f":"simp"},{"i":"37752376-3872-4130-b9e9-ffaf2c9e6657","t":"謝楊尚書惠櫻桃","a":"盧延讓","d":"唐","g":"短诗","p":["滿合虛紅怕動搖，尚書知重賜櫻桃。","揉藍尚帶新鮮葉，潑血猶殘舊折條。","萬顆真珠輕觸破，一團甘露軟含消。","春來老病尤珍荷，併食中腸似火燒。"],"s":"trad","f":"simp"},{"i":"5ca58cb9-dce4-4730-92d6-d12c5d50c81d","t":"寒食日戲贈李侍御","a":"盧延讓","d":"唐","g":"短诗","p":["十二街如市，紅塵咽不開。","灑蹄驄馬汗，沒處看花來。"],"s":"trad","f":"simp"},{"i":"79c5dff5-e887-460a-a766-002473728f95","t":"樊川寒食二首 一","a":"盧延讓","d":"唐","g":"短诗","p":["寒食權豪盡出行，一川如畫雨初晴。","誰家絡絡游春盛，擔入花間軋軋聲。"],"s":"mixed","f":"simp"},{"i":"7d6d512f-ab71-444b-a59a-57087be8ffec","t":"樊川寒食二首 二","a":"盧延讓","d":"唐","g":"短诗","p":["鞍馬和花總是塵，歌聲處處有佳人。","五陵年少麤於事，栲栳量金買斷春。"],"s":"trad","f":"simp"},{"i":"ca59afa8-a895-413f-8296-aa45f5c5e77e","t":"句","a":"盧延讓","d":"唐","g":"古体","p":["只訛些子緣，應耗沒多光。","臂鷹健卒懸氈帽，騎馬佳人卷畫衫。","每過私第邀看鶴，長著公裳送上驢。","名紙毛生五門下，家僮骨立六街中。","雲間鬧鐸騾駝至，雪裏殘骸虎拽來。","樹上諮諏批頰鳥，窗間壁駮叩頭蟲。","莫欺零落殘牙齒，曾吃紅綾餅餤來。","渡水蹇驢雙耳直，避風羸僕一肩高。","高據襄陽播盛名，問人人道是詩星。","涼雨打低殘菡萏，急風吹散小蜻蜓。"],"s":"mixed","f":"simp"},{"i":"34c46af4-c563-4579-b9d5-ba21cc8c6e43","t":"示門生馬侍郎胤孫","a":"裴皞","d":"唐","g":"短诗","p":["宦途最重是文衡，天與愚夫著盛名。","三主禮闈年八十，門生門下見門生。"],"s":"trad","f":"simp"},{"i":"8eea7761-3835-4f12-a870-8f53367f2e49","t":"贈杜荀鶴","a":"王希羽","d":"唐","g":"短诗","p":["金榜曉懸生世日，玉書潛記上升時。","九華山色高千尺，未必高於第八枝。"],"s":"trad","f":"simp"},{"i":"b26c5161-22f5-4a5f-b324-e9f2928a73e4","t":"宮怨二首 一","a":"柯崇","d":"唐","g":"短诗","p":["塵滿金爐不炷香，黃昏獨自立重廊。","笙歌何處承恩寵，一一隨風入上陽。"],"s":"trad","f":"simp"},{"i":"032611ff-1328-4dba-b3cf-9c02c70f7033","t":"宮怨二首 二","a":"柯崇","d":"唐","g":"短诗","p":["長門槐柳半蕭疎，玉輦沈思恨有餘。","紅淚漸消傾國態，黃金誰爲達相如。"],"s":"mixed","f":"simp"},{"i":"a7c1f03c-ed0b-4f82-991d-c010c6de03c4","t":"早春池亭獨游三首 一","a":"劉象","d":"唐","g":"短诗","p":["春意送殘臘，春晴融小洲。","蒲茸纔簇岸，柳頰已遮樓。","便有杯觴興，可攄羈旅愁。","鳧鷖亦相狎，盡日戲清流。"],"s":"mixed","f":"simp"},{"i":"04abc7f9-21aa-40bb-90e0-d134b4dd008c","t":"早春池亭獨游三首 二","a":"劉象","d":"唐","g":"短诗","p":["清流環綠篠，清景媚虹橋。","鶯刷初遷羽，莎拳擬拆苗。","細沙擢暖岸，淑景動和飆。","倍憶同袍侶，相歡倒一瓢。"],"s":"mixed","f":"simp"},{"i":"42037650-82e1-41bf-9242-4f15afa08db2","t":"早春池亭獨游三首 三","a":"劉象","d":"唐","g":"短诗","p":["一瓢歡自足，一日興偏多。","幽意人先賞，疎叢蝶未過。","知音新句苦，窺沼醉顏酡。","萬慮從相擬，今朝欲奈何。"],"s":"mixed","f":"simp"},{"i":"8e1dbe55-0d25-4eb7-84f5-85674dfc2951","t":"鷺鷥","a":"劉象","d":"唐","g":"短诗","p":["潔白孤高生不同，頂絲清軟冷搖風。","窺魚翹立荷香裏，慕侶低翻柳影中。","幾日下巢辭紫閣，多時凝目向晴空。","摩霄志在潛修羽，會接鑾凰別葦叢。"],"s":"mixed","f":"simp"},{"i":"6fe73140-9715-4692-9f01-056a4beccf6a","t":"春夜二首 一","a":"劉象","d":"唐","g":"短诗","p":["幾處兵戈阻路岐，憶山心切與山違。","時難何處披懷抱，日日日斜空醉歸。"],"s":"trad","f":"simp"},{"i":"10152af1-e8bf-4b0c-9c68-a4ef266f738a","t":"春夜二首 二","a":"劉象","d":"唐","g":"短诗","p":["一別杜陵歸未期，秪憑魂夢接親知。","近來欲睡兼難睡，夜夜夜深聞子規。"],"s":"trad","f":"simp"},{"i":"59e1c771-c1d1-47f4-bb5a-d5a56902892b","t":"曉登迎春閣","a":"劉象","d":"唐","g":"短诗","p":["未櫛憑欄眺錦城，煙籠萬井二江明。","香風滿閣花盈戶，樹樹樹梢啼曉鶯。"],"s":"trad","f":"simp"},{"i":"e35b0794-45a0-4f3a-a8a9-6b68d0f2a28a","t":"詠仙掌","a":"劉象","d":"唐","g":"短诗","p":["萬古亭亭倚碧霄，不成擎亦不成招。","何如掬取天池水，灑向人間救旱苗。"],"s":"trad","f":"simp"},{"i":"63223863-df5d-4277-b245-4cff39f7c87f","t":"郪中感舊","a":"劉象","d":"唐","g":"短诗","p":["頃年曾住此中來，今日重游事可哀。","憶得幾家歡宴處，家家家業盡成灰。"],"s":"mixed","f":"simp"},{"i":"dce6d5a0-b9b3-405d-9d6a-f4bb00c2808c","t":"白髭","a":"劉象","d":"唐","g":"短诗","p":["到處逢人求至藥，幾回染了又成絲。","素絲易染髭難染，墨翟當時合泣髭。"],"s":"trad","f":"simp"},{"i":"acc0fa45-42bd-45b9-886e-394ce63f7770","t":"題縣令范傳真化洽亭","a":"沈顏","d":"唐","g":"短诗","p":["前有淺山，屹然如屏。","後有卑嶺，繚然如城。","跨池左右，足以建亭。","斯亭何名，化洽而成。"],"s":"mixed","f":"simp"},{"i":"ef77519a-bf95-4d2d-82f8-6b45675ede51","t":"書懷寄友人","a":"沈顏","d":"唐","g":"短诗","p":["江湖勞遍尋，祗自長愁襟。","到處慵開口，何人可話心。","登樓得句遠，望月抒情深。","却憶山齋後，猿聲相伴吟。"],"s":"mixed","f":"simp"},{"i":"c1847ed8-c71b-4e23-adb5-2cb4bdfeb836","t":"題壁","a":"楊凝式","d":"唐","g":"短诗","p":["院似禪心靜，花如覺性圓。","自然知了義，爭肯學神仙。"],"s":"trad","f":"simp"},{"i":"b45062b3-208b-4629-83e4-b5cbb0545fb3","t":"贈張全義","a":"楊凝式","d":"唐","g":"短诗","p":["洛陽風景實堪哀，昔日曾爲瓦子堆。","不是我公重葺理，至今猶是一堆灰。"],"s":"mixed","f":"simp"},{"i":"f6b06b80-2106-478e-9d16-34454c4fb6a1","t":"題懷素酒狂貼後","a":"楊凝式","d":"唐","g":"短诗","p":["十年揮素學臨池，始識王公學衛非。","草聖未須因酒發，筆端應解化龍飛。"],"s":"trad","f":"simp"},{"i":"33709353-14db-44a6-8853-2abfcbfd6fdb","t":"句","a":"楊凝式","d":"唐","g":"短诗","p":["押引蝗蟲到洛京，合消郡守遠相迎。","到此今經三紀春。"],"s":"trad","f":"simp"},{"i":"c08cf828-4af2-4026-8e3f-4ad565f219eb","t":"奉試詔用拓拔思恭爲京北收復都統","a":"李琪","d":"唐","g":"短诗","p":["飛騎經巴棧，鴻恩及夏臺。","將從天上去，人自日邊來。","此處金門遠，何時玉輦迴。","早平關右賊，莫待詔書催。"],"s":"mixed","f":"simp"},{"i":"ea069414-3057-4b62-ace3-b1258ed5c167","t":"題廣愛寺楞伽山","a":"李琪","d":"唐","g":"短诗","p":["善高天外遠，方丈海中遙。","自有山神護，應無劫火燒。","壞文侵古壁，飛劍出寒霄。","何似蒼蒼色，嚴妝十七朝。"],"s":"trad","f":"simp"},{"i":"ac426724-c5fb-45a5-9438-4a294d2dcc82","t":"句","a":"李琪","d":"唐","g":"短诗","p":["哀痛不下詔，登封誰上書。"],"s":"trad","f":"simp"},{"i":"ebd38359-8583-4024-8d49-8c9d24b4e945","t":"寄桂帥","a":"劉崇龜","d":"唐","g":"短诗","p":["碧幢仁施合洪鈞，桂樹林前倍得春。","莫戀此時好風景，磻溪不是釣漁人。"],"s":"trad","f":"simp"},{"i":"5b6b5efd-247f-4458-ad94-8e91be044942","t":"席上吟","a":"劉崇魯","d":"唐","g":"短诗","p":["南行忽見李深之，手舞如蜚令不疑。","任有風流兼蘊藉，天生不似鄭都知。"],"s":"trad","f":"simp"},{"i":"7b9570d1-808c-4adb-b0ed-11ced6affb6a","t":"寄孫儲","a":"孫定","d":"唐","g":"短诗","p":["行行血淚灑塵襟，事逐東流渭水深。","秋跨蹇驢風尚緊，靜投孤店日初沈。","一枝猶挂東堂夢，千里空馳北巷心。","明月悲歌又前去，滿城煙樹噪春禽。"],"s":"mixed","f":"simp"},{"i":"15a8ebcd-bd40-495a-8d32-f2a4730d64e5","t":"江南行","a":"許晝","d":"唐","g":"古体","p":["江南蕭灑地，本自與君宜。","固節還同我，虛心欲待誰。","澗泉傍借響，山木共含滋。","粉膩蟲難篆，叢疎鳥易窺。","盡應逢野渡，中忽見村祠。","葉掃秋空靜，根橫古塹危。","影迷寒靄裏，聲出夜風時。","客棹深深過，人家遠遠移。","游邊曾結念，到此數題詩。","莫恨成龍晚，成龍會有期。"],"s":"mixed","f":"simp"},{"i":"2e92858e-1b32-49fb-87d7-4ccd3f21e8d5","t":"中秋月","a":"許晝","d":"唐","g":"短诗","p":["應是蟾宮別有情，每逢秋半倍澄清。","清光不向此中見，白髮爭教何處生？","閑地占將真可惜，幽窗分得始爲明。","殷勤好長來年桂，莫遣平人道不平。"],"s":"mixed","f":"simp"},{"i":"830c5d07-a36a-4250-a13a-f07414dd3915","t":"臨終詩","a":"薛凖","d":"唐","g":"短诗","p":["舊國深恩不易酬，又離繼母出他州。","誰知天怒無因息，積媿終身乞速休。"],"s":"trad","f":"simp"},{"i":"d1ec7c49-9bfb-40ef-8272-280670328274","t":"觀修處士畫桃花圖歌","a":"裴諧","d":"唐","g":"古体","p":["一從天寶王維死，于今始遇修夫子。","能向鮫綃四幅中，丹青暗與春爭工。","勾芒若見應羞殺，暈綠勻紅漸分別。","堪憐彩筆似東風，一朵一枝隨手發。","燕支乍溼如含露，引得嬌鶯癡不去。","多少遊蜂盡日飛，看遍花心求入處。","工夫妙麗實奇絕，似對韶光好時節。","偏宜留著待深冬，鋪向樓前殛霜雪。"],"s":"mixed","f":"simp"},{"i":"1dd55721-a10f-45ce-9790-b3f92cef1c14","t":"句","a":"裴諧","d":"唐","g":"短诗","p":["風回山火斷，朝落岸冰高。","名終埋不得，骨任朽何妨。"],"s":"trad","f":"simp"},{"i":"60e7f3f5-a13c-48c4-8577-59a84f02f5bd","t":"長安春日","a":"曹松","d":"唐","g":"短诗","p":["浩浩看花晨，六街揚遠塵。","塵中一丈日，誰是晏眠人。","御柳舞着水，野鸎啼破春。","徒云多失意，猶自惜離秦。"],"s":"mixed","f":"simp"}]