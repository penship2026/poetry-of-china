[{"i":"c-31cc61079453","t":"踏莎行","a":"郭应祥","d":"宋","g":"词","p":["明月清风，绿尊红袖。","厌厌夜饮胜如昼。","虽然文字有馀欢，也须闲把笙歌奏。","十雨如期，三秋届候。","去年丰稔今年又。","东阡西陌稼如云，笑他齐量区兼豆。"],"s":"simp","f":"trad"},{"i":"c-79c00208b173","t":"踏莎行","a":"郭应祥","d":"宋","g":"词","p":["一撮精神，百般体态。","兰心蕙性谁能赛。","霎时不见早思量，许多日子如何捱。","我已安排，你须宁耐。","看看重了鸳鸯债。","此生永愿不分飞，傍人一任胡瞋怪。"],"s":"mixed","f":"trad"},{"i":"c-2f988b154ad1","t":"踏莎行","a":"郭应祥","d":"宋","g":"词","p":["自昔中元，多生上相。","麒麟今又来天上。","云衢虽未掇勋名，月评先已腾声望。","宝鼎浓熏，金翘绝唱。","真珠百斛倾家酿。","斯辰聊用祝龟龄，他年端合扶鸠杖。"],"s":"simp","f":"trad"},{"i":"c-941ae7d4aad2","t":"踏莎行","a":"郭应祥","d":"宋","g":"词","p":["春已经旬，历方换岁。","六花依旧来呈瑞。","细思残腊与新年，一般清绝元非二。","宿麦连云，遗蝗入地。","坡仙有句谁能继。","元宵此去日无多，会看霁色生和气。"],"s":"simp","f":"trad"},{"i":"c-cda311859235","t":"南歌子","a":"郭应祥","d":"宋","g":"词","p":["生世逢端午，齐头五十番。","一番须作一般看。","又听竞船萧鼓、沸江干。","不用丝缠臂，休将艾插门。","及时蒲黍漫登盘。","只恐岁华催促、鬓毛斑。"],"s":"simp","f":"trad"},{"i":"c-2f16942431f3","t":"南歌子","a":"郭应祥","d":"宋","g":"词","p":["心下悬悬地，侬家好好儿。","相怜相惜许多时。","岂料一朝轻拆、便轻离。","要见无由见，教归不肯归。","数珠懒把镜慵窥。","只有新添鬓雪、减腰围。"],"s":"simp","f":"trad"},{"i":"c-262db6341dfe","t":"好事近","a":"郭应祥","d":"宋","g":"词","p":["春事日相催，红尽浅桃深杏。","可惜窥园无暇，任绿苔封径。","凭谁说与雨和风，休要太狂横。","等待禁烟予告，要选幽寻胜。"],"s":"simp","f":"trad"},{"i":"c-0c26c86e37bf","t":"卜算子","a":"郭应祥","d":"宋","g":"词","p":["午夜一声雷，急雨如飞雹。","枝上残红半点无，密叶都成幄。","苦恨薄书尘，刚把闲身缚。","却意湄湘春暮时，处处堪行乐。"],"s":"simp","f":"trad"},{"i":"c-ec6164c7b5ba","t":"卜算子","a":"郭应祥","d":"宋","g":"词","p":["城上著裴亭，亭下临湘水。","泼黛揉蓝画不成，暝色仍含紫。","忙里不知春，却问今馀几。","相与偷将半日闲，共把尘襟洗。"],"s":"simp","f":"trad"},{"i":"c-63dbe8837767","t":"更漏子","a":"郭应祥","d":"宋","g":"词","p":["月蟠根，天雨粟。","宜贮阿娇金屋。","心欲醉，眼偏明。","无穷佳思生。","焰银红，纷宝斝。","倒著接䍦花下。","人已散，梦初回。","渴心犹望梅。"],"s":"mixed","f":"trad"},{"i":"c-4a4cdc1b382a","t":"谒金门","a":"郭应祥","d":"宋","g":"词","p":["香篆袅。","瓶里梅英犹小。","鸳瓦霜华睛欲晓。","今年生日好。","鬓绿颜朱不老。","女嫁儿婚将了。","四世团栾同一笑。","人间如此少。"],"s":"simp","f":"trad"},{"i":"c-e8642c2c2513","t":"鹧鸪天","a":"郭应祥","d":"宋","g":"词","p":["屈指新年五十三。","未嫌垂领雪毵毵。","设弧届旦人交贺，题座无功我自惭。","荣莫羡，富休贪。","寿龄也不慕彭聃。","只思了却痴儿事，一榻香凝晓梦酣。"],"s":"simp","f":"trad"},{"i":"c-3387996a153c","t":"秦楼月・忆秦娥","a":"郭应祥","d":"宋","g":"词","p":["三月一。","题舆恰届垂弧日。","垂弧日。","武安门外，欢声扬溢。","双瞳炯炯头如漆。","天公付与长生质。","长生质。","云霄稳坐，持荷簪笔。"],"s":"simp","f":"trad"},{"i":"c-cfa4fcae199d","t":"卜算子","a":"郭应祥","d":"宋","g":"词","p":["绿烛间红花，绝艳交相照。","不分花时雨又风，折取供吟笑。","拟把插乌巾，却恨非年少。","点笔舒笺领略渠，座客词俱妙。"],"s":"simp","f":"trad"},{"i":"c-9b4351f54675","t":"临江仙","a":"郭应祥","d":"宋","g":"词","p":["姑射仙人肌雪莹，笑他红紫纷纷。","从教藏白后庭深。","虬枝才破蕾，鼻观已遥闻。","花正繁时春又暮，年华荏苒催人。","惜花心事与谁论。","长哦清绝句，目断古南云。"],"s":"simp","f":"trad"},{"i":"c-ec461f6c9eb7","t":"浣溪沙","a":"李壁","d":"宋","g":"词","p":["只记梅花破腊前。","恼人春色又薰然。","山头井似陆公泉。","上客长谣追楚些，娇娃短舞看胡旋。","崇桃积李自年年。"],"s":"simp","f":"trad"},{"i":"c-f40ba31644da","t":"朝中措","a":"李壁","d":"宋","g":"词","p":["东风歌吹发重闉。","飞旆入山新。","小雨不妨酥润，江头一并霜晴。","年年心似，输他钗燕，蟠带迎春。","怎得尊前避酒，史君精鉴如神。"],"s":"mixed","f":"trad"},{"i":"c-adbc5cd2c2e3","t":"小重山","a":"李壁","d":"宋","g":"词","p":["燕雀风轻二月天。","一枝何处是家园。","有花不惜是谁怜。","生嫌怕，不为老人妍。","眉黛拥连娟。","高情时载酒、雁湖边。","略无雕饰自天然。","新诗好，品第入朱弦。"],"s":"simp","f":"trad"},{"i":"c-67e90e5811df","t":"满江红","a":"李壁","d":"宋","g":"词","p":["帘卷东风，□林外、鸟啼姑恶。","政迤逦、花梢红绽，柳梢黄著。","散策丘园容懒□，折冲樽俎须雄略。","但有书盈屋酒盈缸，还堪乐。","嗟每被，浮云缚。","黄梁梦，新来觉。","悄祗愁湖海，故交辽邈。","一纸素书来问我，数峰苍玉何如昨。","更几时、夜雨落檐花，同春酌。"],"s":"simp","f":"trad"},{"i":"c-c62661b77560","t":"南歌子","a":"李壁","d":"宋","g":"词","p":["紫绶新符竹，叶赪老兄弟。","西风吹棹过湖亭。","杨柳夫渠相伴、也多情。","况是瀛洲侣，来同酒盏倾。","白沤浑不避双旌。","一种风流人似、玉壶清。"],"s":"simp","f":"trad"},{"i":"c-d2f0f6f59590","t":"好事近","a":"李壁","d":"宋","g":"词","p":["莫惜一樽留，共醉锦屏山色。","多少飞花悠扬，送征轮南陌。","曲湖归去未多时，还捧诏黄湿。","生怕别来凄断，看满园行迹。"],"s":"simp","f":"trad"},{"i":"c-6c4291973d1c","t":"江神子・江城子","a":"李壁","d":"宋","g":"词","p":["露荷香泛小池台。","水云堆。","好风催。","宝扇胡床，无事且徘徊。","帘外海榴裙一色，判共酹、两三杯。","此怀能得几番开。","玉山颓。","不须推。","回首慈恩，前梦老堪咍。","好是上林多少树，应早晚、待公来。"],"s":"simp","f":"trad"},{"i":"c-e465d73c4dd0","t":"阮郎归","a":"李壁","d":"宋","g":"词","p":["苏台一别费三年。","锦书凭雁传。","风姿重见阆江边。","玉壶秋井泉。","翻短舞，趁么弦。","篆香同夕烟。","多情莫惜为留连。","落花中酒天。"],"s":"simp","f":"trad"},{"i":"c-47a67bdf23d0","t":"鹧鸪天","a":"李壁","d":"宋","g":"词","p":["岸柳阴阴跃锦鳞。","并湖莲子恰尝新。","谁教故岁应官去，会老堂中少个人。","归未久，意弥新。","吹香不断酒倾银。","行藏判已天公付，且斗而今见在身。"],"s":"simp","f":"trad"},{"i":"c-3724a0070ed4","t":"西江月","a":"李壁","d":"宋","g":"词","p":["又送鹏程轩翥，几看驹隙推移。","多端时事只天知。","不饮沈忧如醉。","白首已甘蓬艾，苍生正倚丞疑。","楚台风转一帆吹。","朝列问君来未。"],"s":"simp","f":"trad"},{"i":"c-894915fbb683","t":"临江仙","a":"韩淲","d":"宋","g":"词","p":["难老一杯春酒美，主人玉监清秋。","九华山下共追游。","朝来多爽气，都向笔端收。","台阁功名归去好，便应衮衮公侯。","未妨含笑看吴钩。","当年佳梦日，和气瑞光浮。"],"s":"simp","f":"trad"},{"i":"c-cb83889a5f66","t":"满江红","a":"韩淲","d":"宋","g":"词","p":["五老峰前，九江上、曾生仙客。","相邂逅、贵池亭下，定交金石。","我辈风流宜啸咏，官曹尘冗从煎逼。","且簿书、丛里举清觞，偷闲日。","同一笑，当今夕。","梅正好，香浮白。","便相忘尔汝，醉巾沾湿。","已向琼楼夸意态，似闻金殿传消息。","想君今、归去际风云，应相忆。"],"s":"simp","f":"trad"},{"i":"c-e9140993eca1","t":"柳梢青","a":"韩淲","d":"宋","g":"词","p":["云淡秋空。","一江流水，烟雨濛濛。","岸转溪回，野平山远，几点征鸿。","行人独倚孤篷。","算此景、如图画中。","莫问功名，且寻诗酒，一棹西风。"],"s":"mixed","f":"trad"},{"i":"c-732e96f3c523","t":"醉蓬莱","a":"韩淲","d":"宋","g":"词","p":["问西湖好处，楼上薰风，有谁称寿。","十里荷香，对槐阴清昼。","细浪揉蓝，远山凝黛，更管弦初奏。","醉舞嗟嗟，欢声沸沸，生申时候。","膝下婆娑，老莱儿戏，帝所辉光，使衣呈绣。","眷倚方隆，赐金章华绶。","自此飞腾，凤阁鸾台，好满斟醇酎。","道骨仙风，朱颜青鬓，年年依旧。"],"s":"simp","f":"trad"},{"i":"c-5beb9ec98e77","t":"水调歌头","a":"韩淲","d":"宋","g":"词","p":["明月到花影，把酒对香红。","此情飘洒，但觉清景满帘栊。","人被好花相恼，花亦知人幽韵，佳处本同风。","挥手谢尘网，举袂步蟾宫。","秋已半，幽涧侧，乱山中。","故人过我，终夕乘兴可千锺。","赖有曲江才子，坐上平章花月，不管老英雄。","心事将何寄，醉语又匆匆。"],"s":"simp","f":"trad"},{"i":"c-81376ef35277","t":"贺新郎","a":"韩淲","d":"宋","g":"词","p":["万事佯休去。","漫栖迟、灵山起雾，玉溪流渚。","击楫凄凉千古意，怅怏衣冠南渡。","泪暗洒、神州沈处。","多少胸中经济略，气□□、郁郁愁金鼓。","空自笑，听鸡舞。","天关九虎寻无路。","叹都把、生民膏血，尚交胡虏。","吴蜀江山无自好，形势何能尽语。","但目尽、东南风土。","赤壁楼船应似旧，问子瑜、公瑾今安否。","割舍了，对君举。"],"s":"simp","f":"trad"},{"i":"c-cd691314394e","t":"贺新郎","a":"韩淲","d":"宋","g":"词","p":["病起情怀恶。","小帘栊、杨花坠絮，木阴成幄。","试问春光今几许，都把年华忘却。","更多少、从前盟约。","拟待莺边寻好语，恍残红、零乱风回薄。","思住事，信如昨。","清明寒食须行乐。","算人生、何时富贵，自徒萧索。","试著春衫从酒伴，乱插繁英嫩萼。","信莫被、功名担阁。","随分溪山供笑傲，这一身、闲处谁能缚。","琴剑外，尽杯酌。"],"s":"simp","f":"trad"},{"i":"c-0c651c1cdd68","t":"清平乐","a":"韩淲","d":"宋","g":"词","p":["鸣琴单父。","凫舄宜飞去。","不比河阳花满树。","此意直高千古。","清秋诞日相逢。","乃同涧上村侬。","笑指壶山为寿，仁心静处加功。"],"s":"simp","f":"trad"},{"i":"c-fb91b65e3918","t":"水龙吟","a":"韩淲","d":"宋","g":"词","p":["从来江左夷吾，大名迥诸出公右。","金堂玉室，瑶林琼树，龙麟蟠走。","志在神皋，气雄云梦，十吞八九。","问三槐盛事，当年初度，人应羡、青毡旧。","说与文章太守。","庆千秋、好为亲寿。","冰桃雪藕，霞裾月佩，莺鸾歌奏。","雨熟西畴，星躔南极，宝香凝昼。","趁新凉，便约乘云绕日，饮天浆酒。"],"s":"simp","f":"trad"},{"i":"c-4534b6d8ff43","t":"清平乐","a":"韩淲","d":"宋","g":"词","p":["萧然在涧。","景色秋来冠。","几缕明霞红未断。","矫首时时遐观。","回思五马清游。","分明前辈风流。","留作山间佳话，更谁愁上眉头。"],"s":"simp","f":"trad"},{"i":"c-c7a12cfdf9d8","t":"踏莎行","a":"韩淲","d":"宋","g":"词","p":["雨意生凉，云容催暮。","画楼人倚阑干处。","柳边新月已微明，银潢隐隐疏星渡。","今古佳期，漫传牛女。","一杯试与寻新句。","幽怀冷眼是青山，旧欢往恨浑无据。"],"s":"simp","f":"trad"},{"i":"c-2e9588ecf4ef","t":"清平乐","a":"韩淲","d":"宋","g":"词","p":["常思高致。","又见凉风起。","欢喜年时为寿意。","快写山歌重寄。","愿公好德康宁。","青云收取功名。","莫道而今官小，吾儒正要仁民。"],"s":"simp","f":"trad"},{"i":"c-1dacd2055388","t":"柳梢青","a":"韩淲","d":"宋","g":"词","p":["雨洗元宵。","楼台烟锁，隐隐笙箫。","且插梅花，自烧银烛，沈水香飘。","软红尘里星桥。","想霁色、皇都绛霄。","屏掩潇湘，醉和衣倒，春梦迢迢。"],"s":"simp","f":"trad"},{"i":"c-702815b5dbac","t":"菩萨蛮","a":"韩淲","d":"宋","g":"词","p":["雪云收尽晴风软。","小山春浪晴波远。","梅片已飞香。","海棠红试妆。","人言诗易与。","酒盏谁分付。","不是没心情。","夕阳啼鸟声。"],"s":"simp","f":"trad"},{"i":"c-0d7e4b8d99ea","t":"一翦梅","a":"韩淲","d":"宋","g":"词","p":["说著相思梦亦愁。","芳草斜阳，春满秦楼。","楼前新绿水西流。","一曲阳关，分付眉头。","多少风流事已休。","纷薄香浓，怕见绸缪。","淡云笼月小庭幽。","明日山长，清恨悠悠。"],"s":"simp","f":"trad"},{"i":"c-f4a11813733e","t":"海月谣","a":"韩淲","d":"宋","g":"词","p":["晚秋烟渚。","更舟倚、萧萧雨。","水痕清汜，迤逦渐整，云帆西去。","三叠阳关，留下别离情绪。","溪南一坞。","对风月、谁为主。","酒徒诗社，自此冷落，胸怀尘土。","目送鸿飞，莫听数柔橹。"],"s":"simp","f":"trad"},{"i":"c-f19a4473e2b7","t":"好事近","a":"韩淲","d":"宋","g":"词","p":["春色入芳梢，点缀万枝红玉。","莫道怕愁贪睡，倚新妆如束。","纷纷桃李太妖娆，相对夜阑烛。","记取疏花横处，有暗香飘馥。"],"s":"simp","f":"trad"},{"i":"c-f985a3773320","t":"菩萨蛮","a":"韩淲","d":"宋","g":"词","p":["平生常为梅花醉。","数枝滴滴香沾袂。","雪后月华明*胆瓶无限清。","夜深灯影瘦。","饮尽杯中酒。","明日景尤新。","人间都是春。"],"s":"simp","f":"trad"},{"i":"c-3f07d85d5733","t":"西江月","a":"韩淲","d":"宋","g":"词","p":["春色著人多少，溪头桃杏舒红。","杖藜相与过桥东。","往事旧欢如梦。","花底醉眠芳草，柳边嘶入骄骢。","如今憔悴坐诗穷。","莫问醯鸡舞瓮。"],"s":"simp","f":"trad"},{"i":"c-d0ad43189e29","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["一曲青山映小池。","林疏人静月明时。","相逢杯酒也相宜。","醉眼不知春事少，欢情犹得漏声迟。","神仙何处梦魂飞。"],"s":"simp","f":"trad"},{"i":"c-befb9b50ced5","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["宝鸭香消酒未醒。","锦衾春暖梦初惊。","鬓云撩乱玉钗横。","半怯夜寒褰绣幌，尚馀娇困剔银灯。","粉痕微褪脸霞生。"],"s":"simp","f":"trad"},{"i":"c-8a5af7f4e961","t":"西江月","a":"韩淲","d":"宋","g":"词","p":["风暖晨光寂寂，月明夜气沈沈。","山间林下步轻阴。","花柳飞绵布锦。","酒病向谁能遣，春愁惟我难禁。","尊前一曲断肠声。","梦破晓窗敧枕。"],"s":"simp","f":"trad"},{"i":"c-d1ca8da05683","t":"朝中措","a":"韩淲","d":"宋","g":"词","p":["池塘春草燕飞飞。","人醉牡丹时。","多少姚黄魏紫，搦成腻粉燕支。","谪仙醉把平章看，晴影度帘迟。","花外一声鶗鴂，柳边几个黄鹂。"],"s":"simp","f":"trad"},{"i":"c-753ac6c19fb0","t":"水调歌头","a":"韩淲","d":"宋","g":"词","p":["今古钓台下，行客系扁舟。","扁舟何似，云山千叠亦东游。","我欲停桡一醉，与写平生幽愤，横管更清讴。","小上客星阁，短鬓独搔头。","风乍起，烟未敛，雨初收。","一年花事，数声鶗鴂欲春休。","吊古怀贤情味，只有浮名如故，谁复识羊裘。","赖得玄英隐，相望此溪流。"],"s":"simp","f":"trad"},{"i":"c-05aa8d543cad","t":"西江月","a":"韩淲","d":"宋","g":"词","p":["梅蕊小春天气，橘林良月风光。","五云边近九霞觞。","美景初无尽藏。","老矣相逢湖海，年来游遍潇湘。","诗情满眼兴何长。","赢得烟霄直上。"],"s":"simp","f":"trad"},{"i":"c-bbe680c6acdd","t":"卜算子","a":"韩淲","d":"宋","g":"词","p":["花底醉东风，好景宜同寿。","海角天涯今几春，邂逅新丰酒。","内集记高阳，南渡闲回首。","但愿长年饱饭休，一笑风尘表。"],"s":"simp","f":"trad"},{"i":"c-10eee00bcd83","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["小雨收晴作社寒。","月桥花院篆香残。","杏腮桃脸黛眉弯。","歌拂燕梁牵客恨，醉临鸾镜怕人看。","良宵春梦绕屏山。"],"s":"simp","f":"trad"},{"i":"c-4aad97db73b5","t":"菩萨蛮","a":"韩淲","d":"宋","g":"词","p":["海棠欲谢绵飞柳。","柳丝自拂行人首。","上巳是清明。","新烟带粥饧。","轻阴帘幕冷。","闲却秋千影。","曲水兴无涯。","丽人花半遮。"],"s":"simp","f":"trad"},{"i":"c-340eeb95355b","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["湖海相逢更日边。","槐风莲雨寿杯前。","琴书图画水沈烟。","共指金銮当儤直，不应彭泽尚回旋。","今年初度想超然。"],"s":"simp","f":"trad"},{"i":"c-907ddcbf11c1","t":"恋绣衾","a":"韩淲","d":"宋","g":"词","p":["欢浓两点笑靥儿。","雪初消、梅欲放时。","不信道、伤春瘦，怕人猜、犹待皱眉。","香浓翠被屏山曲，把珊枕、侧过又移。","试与伴、江头去，但醉翁、亭上要诗。"],"s":"simp","f":"trad"},{"i":"c-d7187eb8420d","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["一曲霓裳舞未终。","玉钗垂额鬓云松。","梦回金殿月华东。","燕子莺儿情脉脉，柳枝桃叶恨匆匆。","罗襟空惹御香浓。"],"s":"simp","f":"trad"},{"i":"c-19e40f1a542c","t":"步蟾宫","a":"韩淲","d":"宋","g":"词","p":["三年重到严滩路。","叹须鬓、衣冠尘土。","倚孤篷、闲自濯清风，见一片、飞鸿归去。","人间何用论今古。","漫赢得、个般情绪。","雨吹来云、乱处水东流，但只有、青山如故。"],"s":"simp","f":"trad"},{"i":"c-22dbd322ae01","t":"水调歌头","a":"韩淲","d":"宋","g":"词","p":["一枕暑风外，事事且随缘。","随缘何处琴剑，闲泊此层巅。","日绕九天楼殿，烟抹四山林薄，尘土市声前。","老眼醉还醒，犹得到诗边。","桥南院，双桂隐，有名言。","江湖人物，好在收拾付书帘。","回首吾庐无恙，寄卧僧窗何事，鸿鹄本高骞。","水调赋明月，谁道更超然。"],"s":"simp","f":"trad"},{"i":"c-76116d2462a0","t":"鹧鸪天","a":"韩淲","d":"宋","g":"词","p":["雨湿西风水面烟。","一巾华发上溪船。","帆迎山色来还去，橹破滩痕散复圆。","寻浊酒，试吟篇。","避人鸥鹭更翩翩。","五更犹作钱塘梦，睡觉方知过眼前。"],"s":"simp","f":"trad"},{"i":"c-80e80e69d3eb","t":"水调歌头","a":"韩淲","d":"宋","g":"词","p":["嘉节已吹帽，谁复见南山。","南山佳处，台上云绕一溪环。","犹记使君同醉，化鹤千年何在，今古自应悭。","胜事漫陈迹，风物只高寒。","都莫问，归酒畔，集毫端。","等闲吟笑而已，赖有孔融尊。","伟矣广平心致，赢得相遭淡泊，感旧唱酬闲。","且看小斋菊，抵掌共凭阑。"],"s":"simp","f":"trad"},{"i":"c-10fa9d7c35f0","t":"减字木兰花","a":"韩淲","d":"宋","g":"词","p":["年光虚度。","能得几多消散处。","莫恨归迟。","得见新词不自持。","山中酒里。","笑语喧哗知有弟。","此意谁如。","世事纷纷一任渠。"],"s":"simp","f":"trad"},{"i":"c-c1a4c9355fff","t":"生查子","a":"韩淲","d":"宋","g":"词","p":["霜叶柳塘风，烟蕊梅溪渡。","茅店问村醪，未许空归去。","倚杖小徘徊，写我吟边句。","醉眼复何之，落日孤鸿处。"],"s":"simp","f":"trad"},{"i":"c-2f94885032aa","t":"西江月","a":"韩淲","d":"宋","g":"词","p":["闻道晚春时候，暖风是处花飘。","游人争渡水南桥。","多少池塘春草。","跃马谁联玉勒，钓鱼应泛兰桡。","韶光何限不逍遥。","输与溪鸥野鸟。"],"s":"simp","f":"trad"},{"i":"c-cfa492c7d7e4","t":"朝中措","a":"韩淲","d":"宋","g":"词","p":["春浓人静倦游嬉。","烟雨战棠梨。","翠径乱红无数，频啼枝上黄鹂。","小园流水溅溅处，绿遍谢家池。","怨月恨花滋味，泪痕犹染罗衣。"],"s":"simp","f":"trad"},{"i":"c-73ece6e0c36b","t":"小重山","a":"韩淲","d":"宋","g":"词","p":["云影收晴雨外明。","碧溪春滟滟，落花平。","莺声催我过桥行。","人何在，诗酒淡心情。","闲里兴还生。","锦鳞题尺素，有谁能。","草边芳径柳边城。","归来也，清梦绕山屏。"],"s":"simp","f":"trad"},{"i":"c-6ad3b774cc86","t":"临江仙","a":"韩淲","d":"宋","g":"词","p":["脆管繁弦无觅处，小楼空掩遥山。","柳丝直下曲阑干。","海棠红欲褪，玉钏怯春衫。","殢酒不成芳信断，社寒新燕呢喃。","雕盘慵整宝香残。","绮疏明薄暮，帘外雨潺潺。"],"s":"simp","f":"trad"},{"i":"c-aeabe48c5873","t":"朝中措","a":"韩淲","d":"宋","g":"词","p":["五湖烟水百花洲。","别乘最风流。","人道紫枢家世，清时衮衮公侯。","名园绿水春无价，蜀锦舞缠头。","眉寿年年今日，宝杯香霭飞浮。"],"s":"simp","f":"trad"},{"i":"c-79f29724186b","t":"月宫春","a":"韩淲","d":"宋","g":"词","p":["柳娇花妒燕莺喧。","断肠空眼穿。","一春风雨夜厌厌。","不闻钟鼓传。","香冷曲屏罗帐掩，园林谁与上秋千。","忆得年时凤枕，日高犹醉眠。"],"s":"simp","f":"trad"},{"i":"c-764fde094650","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["芍药酴醿满院春。","门前杨柳媚晴曛。","重帘双燕语沈沈。","花映绿娇初日嫩，叶栖红小晚烟昏。","轻雷不觉送微阴。"],"s":"simp","f":"trad"},{"i":"c-0821c5249872","t":"鹧鸪天","a":"韩淲","d":"宋","g":"词","p":["烟禁荒荒雨湿云。","近郊争出满城人。","儿童藉草几成市，杯酒沾花不觉村。","身又老，眼增明。","回头一任是红尘。","山中谁信无寒食，涧上何如且采苹。"],"s":"simp","f":"trad"},{"i":"c-4c81c3516946","t":"一丛花","a":"韩淲","d":"宋","g":"词","p":["翻空雪浪送飞花。","春晓媚霜华。","风回点点迷人处，峭寒轻、诗思殊佳。","双燕未来，断鸿何在，微雨又天涯。","绮窗明暗是谁家。","雕槛馥兰芽。","画檐帘幕黄昏后，试倾杯、笑语喧哗。","聚散人生，吾侪老矣，醉墨任横斜。"],"s":"simp","f":"trad"},{"i":"c-8f80d2236fe2","t":"眼儿媚","a":"韩淲","d":"宋","g":"词","p":["东风拂槛露犹寒。","花重湿阑干。","淡云殢日，晨光微透，帘幕香残。","阴晴不定瑶阶润，新恨觉心阑。","凭高望断，绿杨南陌，无限关山。"],"s":"simp","f":"trad"},{"i":"c-d48364b3eaba","t":"青玉案","a":"韩淲","d":"宋","g":"词","p":["苏公堤上西湖路。","柳外跃、青骢去。","多少韶华惊暗度。","南山游遍，北山归后，总是题诗处。","如今老矣伤春暮。","泽畔行吟漫寻句。","落拓情怀空自许。","小园芳草，短篱修竹，点点飞花雨。"],"s":"simp","f":"trad"},{"i":"c-09e003f8a7e5","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["只恐山灵俗驾回。","海鸥飞下莫惊猜。","机心消尽重徘徊。","宿雨乍晴千涧落，晓云微露两山排。","新苗时翼好风来。"],"s":"simp","f":"trad"},{"i":"c-a40c11bb69e9","t":"朝中措","a":"韩淲","d":"宋","g":"词","p":["扁舟撑月转江湖。","烟水湛金铺。","篷底晓凉歌罢，肌肤冰雪初扶。","诗人自是风尘表，佳处句能摹。","属玉一双飞去，荷花香动菰蒲。"],"s":"simp","f":"trad"},{"i":"c-83c79c985486","t":"明月棹孤舟・夜行船","a":"韩淲","d":"宋","g":"词","p":["忽得相逢惊似旧。","问山中、酒徒诗友。","闲倚睛楼，长安市上，华发为君搔首。","绿竹疏梅今在否。","对西湖、夕阳烟岫。","鸿雁声中，人间今古，还是醉醒时候。"],"s":"simp","f":"trad"},{"i":"c-50586bb0421e","t":"江城子","a":"韩淲","d":"宋","g":"词","p":["天孙应为织云裳。","试宫妆。","问刘郎。","湖上波寒，依旧远山苍。","自是老来心事懒，空落拓，少年场。","挥豪闲与细端相。","记严扬。","陋苏张。","兴到一杯，微醉亦成章。","回首片帆西去也，何日更，共清狂。"],"s":"simp","f":"trad"},{"i":"c-39e3503ac26b","t":"冉冉云","a":"韩淲","d":"宋","g":"词","p":["倚遍阑干弄花雨。","卷珠帘、草迷芳树。","山崦里、几许云烟来去。","画不就、人家院宇。","社寒梁燕呢喃舞。","小桃红、海棠初吐。","谁信道、午醉醒时情绪。","闲整春衫自语。"],"s":"simp","f":"trad"},{"i":"c-8b0db6d35c68","t":"谒金门","a":"韩淲","d":"宋","g":"词","p":["花影半。","晴色乍开云卷。","择胜寻春愁日短。","雨馀山路晚。","涧底桃深红满。","人意不禁闲远。","胡蝶绕枝啼鸟怨。","东风吹酒面。"],"s":"simp","f":"trad"},{"i":"c-30253e17eb0e","t":"满庭芳","a":"韩淲","d":"宋","g":"词","p":["点点淮山，迢迢江水，分明别是风光。","地灵人杰，星斗烂文章。","初度充闾佳气，当年瑞、应弄珪璋。","薰弦奏，凉宵宝月，玉井藕花香。","清真，如逸少，兰亭修竹，曲水流觞。","想醉乡日永，地久天长。","小驻屏星怀玉，飞凫舄、元在鹓行。","功名事，云龙风虎，行矣佩金章。"],"s":"simp","f":"trad"},{"i":"c-63bb1ba19ced","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["一曲西风醉木犀。","天香吹梦入瑶池。","钗横犹记未开枝。","花重嫩舒红笑脸，叶稀轻拂翠颦眉。","酒醒残月雁声迟。"],"s":"simp","f":"trad"},{"i":"c-9f5aa03f7dd2","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["山气吹云宝月凉。","园英承露菊花黄。","吾生只合醉为乡。","怅望佳人因共赋，分明佳节是重阳。","酒边犹发少年狂。"],"s":"simp","f":"trad"},{"i":"c-63e161f959d2","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["莫问星星鬓染霜。","一杯同看月昏黄。","放歌渔父濯沧浪。","却忆手栽双柳句，真成云汉抉天章。","苏仙何在立苍茫。"],"s":"simp","f":"trad"},{"i":"c-fcebed750bcc","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["霜后黄花尚自开。","老年情绪为何哉。","株株浑是手亲栽。","秋际有言挥玉尘，冬来无梦绕金钗。","相思一夜发窗梅。"],"s":"simp","f":"trad"},{"i":"c-6b77877fb2dd","t":"江城子","a":"韩淲","d":"宋","g":"词","p":["雪消霜入小溪舟。","试浮游。","上山头。","薄薄寒烟，依旧未全收。","问道梅花开也未，吟不尽，一春愁。","襟怀如此老还休。","懒凝眸。","转深幽。","诗罢一眉，新月又如钩。","腊后春前村意远，回棹稳，水西流。"],"s":"simp","f":"trad"},{"i":"c-9e5c742b9ee8","t":"浣溪沙","a":"韩淲","d":"宋","g":"词","p":["月角珠庭映伏犀。","扶摇当上凤凰池。","广寒曾折最高枝。","壮志还同诸葛膝，清名还似紫芝眉。","梅花春寿酒行迟。"],"s":"simp","f":"trad"},{"i":"c-99f18e090952","t":"鹧鸪天","a":"韩淲","d":"宋","g":"词","p":["老去情怀酒味中。","水边林下古人风。","岁云暮矣江空晚，谁识儋州秃鬓翁。","人易远，语难工。","春时犹记一尊同。","苦心未免皆如此，只合挥弦目送鸿。"],"s":"simp","f":"trad"},{"i":"c-1aa9b6d2d66c","t":"风入松","a":"韩淲","d":"宋","g":"词","p":["小楼春映远山横。","绿遍高城。","望中一片斜阳静，更萋萋、芳草还生。","疏雨冷烟寒食，落花飞絮清明。","数声弦管忍重听。","犹带微酲。","问春何事春将老，春不语、春恨难平。","莫把风流时节，都归闲淡心情。"],"s":"simp","f":"trad"},{"i":"c-97df61776a1d","t":"菩萨蛮","a":"韩淲","d":"宋","g":"词","p":["小园红入春无际。","新声休写花间意。","一笑唤真真。","香腮酒未醒。","惜芳追胜事。","畅饮馀诗思。","无处说衷情。","暗尘罗帐生。"],"s":"simp","f":"trad"},{"i":"c-6f917155e852","t":"谒金门","a":"韩淲","d":"宋","g":"词","p":["花肃肃。","杨柳三眠未足。","一棹溪山新涨绿。","旧欢无梦续。","莫问杜鹃啼蜀。","只有江南水竹。","北客凄凉无伴独。","春山生草木。"],"s":"simp","f":"trad"},{"i":"c-54091f204240","t":"谒金门","a":"韩淲","d":"宋","g":"词","p":["幽意熟。","吟啸春风自足。","爽气初生晴未燠。","相逢休问卜。","画出高山盘谷。","岩上飞云相逐。","他日江东思渭北。","断舷谁为续。"],"s":"simp","f":"trad"},{"i":"c-2e4a5554f5e4","t":"卜算子","a":"韩淲","d":"宋","g":"词","p":["一雨已秋深，月色寒而静。","夜半披衣草树间，玉露团清影。","长笛倚楼声，听彻还重省。","手启柴门倦复关，云卧衣裳冷。"],"s":"simp","f":"trad"},{"i":"c-4c7c9cc513c7","t":"醉蓬莱","a":"韩淲","d":"宋","g":"词","p":["庆文章太守，燕寝凝香，诞弥佳节。","庾岭归来，又经年梅发。","棋酒心情，笙歌滋味，便合朝天阙。","玉作山前，冰为水际，几多风月。","绿鬓朱颜，浩然相对，自是中原，旧家人物。","鹓鹭班回，尚记陪清切。","好把胸蟠万卷，谈笑了、济时勋业。","锦幄初温，宝杯深劝，舞回香雪。"],"s":"simp","f":"trad"},{"i":"c-e4a2c95f6cd2","t":"朝中措","a":"韩淲","d":"宋","g":"词","p":["为兹春酒寿诗翁。","我辈一尊同。","香动梅梢圆月，年年先得东风。","冰溪清浅流环玉，莲幕漫从容。","但愿人生长久，挥弦目送飞鸿。"],"s":"simp","f":"trad"},{"i":"c-2b48100a139d","t":"太常引","a":"韩淲","d":"宋","g":"词","p":["小春时候腊前梅。","还知道、为谁开。","应绕百千回。","夜色转、参横斗魁。","十分孤静，替伊愁绝，片月共徘徊。","一阵暗香来。","便觉得、诗情有涯。"],"s":"simp","f":"trad"},{"i":"c-c21bc2c9e0ff","t":"朝中措","a":"韩淲","d":"宋","g":"词","p":["谁翻新曲玉溪滨。","何日得为邻。","醉里行歌相答，步随泉石松云。","如今又是梅时候，只有眼中人。","魂断幽香孤影，花前闲整衣巾。"],"s":"simp","f":"trad"},{"i":"c-b0092af8b8b9","t":"恋绣衾","a":"韩淲","d":"宋","g":"词","p":["溪风吹雨晚打窗。","把心情、阑入醉乡。","记取在、山深处，我如今、双鬓已苍。","夜阑寒影灯花淡，梦难成、清漏更长。","宝瑟断、鸾胶续，泪珠弹、犹带粉香。"],"s":"simp","f":"trad"},{"i":"c-0a21e9f1de18","t":"一翦梅","a":"韩淲","d":"宋","g":"词","p":["一朵梅花百和香。","浅色春风，别样宫妆。","西湖衣钵更难忘。","雪意江天，浑断人肠。","清夜横斜竹影窗。","赢得相思，魂梦悠扬。","玉溪山外水云乡。","茅舍疏篱，不换金章。"],"s":"simp","f":"trad"},{"i":"c-4b697c85f66d","t":"蝶恋花","a":"韩淲","d":"宋","g":"词","p":["道上疏梅花一树。","人去人来，不管流年度。","闲过南豅同散步。","东风为我吹香去。","试问青春今几许。","明日新正，溪影横山暮。","遮莫攀翻君且住。","心儿却在题诗处。"],"s":"simp","f":"trad"},{"i":"c-f8136d584347","t":"蝶恋花","a":"韩淲","d":"宋","g":"词","p":["尽道今年春较早。","梅与人情，觉得梅偏好。","一树南豅香未老。","春风已自生芳草。","来自城中犹带晓。","行到君家，细雨吹池沼。","怅望沙坑须会到。","玉溪此意年时少。"],"s":"simp","f":"trad"}]