[{"i":"c11f31b0-1281-4177-b874-b85ce67272e4","t":"獻歲書情","a":"裴夷直","d":"唐","g":"短诗","p":["白髮添雙鬢，空宮又一年。","音書鴻不到，夢寐兔空懸。","地遠星辰側，天高雨露偏。","聖期知有感，雲海漫相連。"],"s":"trad","f":"simp"},{"i":"3730d401-ecd8-46d1-acb3-f8c577d7e1da","t":"奉和大梁相公重九日軍中宴會之什","a":"裴夷直","d":"唐","g":"短诗","p":["今古同嘉節，歡娛但異名。","陶公緣綠醑，謝傅爲蒼生。","酒泛金英麗，詩通玉律清。","何言辭物累，方繫萬人情。"],"s":"mixed","f":"simp"},{"i":"3cc7e2e0-9bf5-4198-8d41-53a109a56646","t":"奉和大梁相公同張員外重九日宴集","a":"裴夷直","d":"唐","g":"短诗","p":["重九思嘉節，追歡從謝公。","酒清欺玉露，菊盛愧金風。","不待秋蟾白，須沈落照紅。","更將門下客，酬和管弦中。"],"s":"mixed","f":"simp"},{"i":"582a0b30-3ddf-4db9-bbcd-dd0f231c46bf","t":"同樂天中秋夜洛河翫月二首 一","a":"裴夷直","d":"唐","g":"短诗","p":["清洛半秋懸璧月，綵船當夕泛銀河。","蒼龍頷底珠皆沒，白帝心邊鏡乍磨。","海上幾時霜雪積，人間此夜管弦多。","須知天地爲鑪意，盡取黃金鑄作波。"],"s":"mixed","f":"simp"},{"i":"4ca69275-b6e0-4ba4-b6bb-15c60e2755d8","t":"同樂天中秋夜洛河翫月二首 二","a":"裴夷直","d":"唐","g":"短诗","p":["不熱不寒三五夕，晴川明月正相臨。","千珠競沒蒼龍頷，一鏡高懸白帝心。","幾處淒涼緣地遠，有時惆悵值雲陰。","如何清洛如清晝，共見初升又見沈。"],"s":"trad","f":"simp"},{"i":"39a9c5be-5c56-4a01-9634-3f20c87910f4","t":"和邢郎中病中重陽強遊樂遊原","a":"裴夷直","d":"唐","g":"短诗","p":["嘉晨令節共陶陶，風景牽情並不勞。","曉日整冠蘭室靜，秋原騎馬菊花高。","晴光一一呈金剎，詩思浸浸逼水曹。","何必銷憂憑外物，祗將清韻敵春醪。"],"s":"trad","f":"simp"},{"i":"8d9d4cb8-12a4-4302-9e2d-97518ef94a2c","t":"觀淬龍泉劒","a":"裴夷直","d":"唐","g":"古体","p":["歐冶將成器，風胡幸見逢。","發硎思剸玉，投水化爲龍。","詎肯藏深匣，終朝用刜鐘。","蓮花生寶鍔，秋日勵霜鋒。","鍊質纔三尺，吹毛過百重。","擊磨如不倦，提握願長從。"],"s":"mixed","f":"simp"},{"i":"9880bab3-5a87-4657-a6f4-c66ce5931fb5","t":"春色滿皇州","a":"裴夷直","d":"唐","g":"古体","p":["寒銷山水地，春遍帝王州。","北闕晴光動，南山喜氣浮。","夭紅粧暖樹，急綠走陰溝。","思婦開香閣，王孫上玉樓。","氛氳直城北，駘蕩曲江頭。","今日靈臺下，翻然却是愁。"],"s":"mixed","f":"simp"},{"i":"a929a248-6353-4d90-9a93-d68c1906a77b","t":"亞夫碎玉斗","a":"裴夷直","d":"唐","g":"古体","p":["雄謀竟不決，寶玉終不愛。","倏爾霜刃揮，颯然春冰碎。","飛光動旗幟，散響驚環珮。","霜灑繡障前，星流錦筵內。","圖王業已失，爲虜言空悔。","獨有青史中，英風觀千載。"],"s":"mixed","f":"simp"},{"i":"72ba6026-1a1a-45e5-9cda-3f2f7658d3c3","t":"水亭","a":"裴夷直","d":"唐","g":"短诗","p":["歲律行將變，君恩竟未回。","門前即潮水，朝去暮常來。"],"s":"trad","f":"simp"},{"i":"e3dfda23-2574-40f6-a9f6-7b959ec7e6a9","t":"揚州寄諸子","a":"裴夷直","d":"唐","g":"短诗","p":["千里隔烟波，孤舟宿何處？遙思耿不眠，淮南夜風雨。"],"s":"mixed","f":"simp"},{"i":"4869e77e-9503-47b5-aaeb-0dabb8044034","t":"酬盧郎中遊寺見招不遇","a":"裴夷直","d":"唐","g":"短诗","p":["偶出送山客，不知遊梵宮。","秋光古松下，誰伴一仙翁。"],"s":"trad","f":"simp"},{"i":"0383802f-8df0-48e7-8b03-a5fe917219b8","t":"寓言","a":"裴夷直","d":"唐","g":"短诗","p":["秋樹却逢暖，未凋能幾時。","何須尚松桂，搖動暫青枝。"],"s":"mixed","f":"simp"},{"i":"13b17855-ecdd-4c6b-bc27-3e3058342d95","t":"唁人喪侍兒","a":"裴夷直","d":"唐","g":"短诗","p":["夜情河耿耿，春恨草綿綿。","唯有嫦娥月，從今照墓田。"],"s":"trad","f":"simp"},{"i":"740f7f75-3cd3-40b3-9db0-193d38ba6427","t":"席上夜別張主簿","a":"裴夷直","d":"唐","g":"短诗","p":["紅燭剪還明，綠尊添又滿。","不愁前路長，只畏今宵短。"],"s":"trad","f":"simp"},{"i":"949f2149-80c4-4124-b7d2-62385bc304b0","t":"方丈泉","a":"裴夷直","d":"唐","g":"短诗","p":["循涯不知淺，見底似非深。","永日無波浪，澄澄照我心。"],"s":"trad","f":"simp"},{"i":"f5f6a6a7-b517-4a68-9943-1b38e7e64443","t":"晚望","a":"裴夷直","d":"唐","g":"短诗","p":["日下夕陰長，前山凝積翠。","白鳥一行飛，聯聯粉書字。"],"s":"trad","f":"simp"},{"i":"5c917902-e58b-4003-bc0b-49566ea06222","t":"前山","a":"裴夷直","d":"唐","g":"短诗","p":["只謂一蒼翠，不知猶數重。","晚來雲映處，更見兩三峰。"],"s":"trad","f":"simp"},{"i":"df1d6ea3-1664-4261-a5ae-36efee30fbd7","t":"發交州日留題解鍊師房","a":"裴夷直","d":"唐","g":"短诗","p":["久喜房廊接，今成道路賒。","明朝回首處，此地是天涯。"],"s":"trad","f":"simp"},{"i":"906f6ab4-fdda-41f8-91d9-d20f60ae6bb3","t":"令和州買松","a":"裴夷直","d":"唐","g":"短诗","p":["好覓凌霜質，仍須帶雨栽。","須知剖竹日，便是看松來。"],"s":"trad","f":"simp"},{"i":"de128788-7eef-4d87-a60c-5152856bd7f4","t":"題斷金集後","a":"裴夷直","d":"唐","g":"短诗","p":["一覽斷金集，再悲埋玉人。","牙弦千古絕，珠淚萬行新。"],"s":"trad","f":"simp"},{"i":"b82f94fe-d45c-460e-b3fb-2561a407f4ec","t":"晚涼","a":"裴夷直","d":"唐","g":"短诗","p":["簷前蔽日多高樹，竹下添池有小渠。","山客野僧歸去後，晚涼移案獨臨書。"],"s":"trad","f":"simp"},{"i":"88dc28ce-3d20-4cd7-868a-7b2bfcca3409","t":"和周侍御洛城雪","a":"裴夷直","d":"唐","g":"短诗","p":["天街飛轡踏瓊英，四顧全疑在玉京。","一種相如抽祕思，兔園那比鳳凰城。"],"s":"mixed","f":"simp"},{"i":"f9bd587e-9af3-49a9-a0ff-7addb0037627","t":"奉和大梁相公送人二首 一","a":"裴夷直","d":"唐","g":"短诗","p":["謝公日日傷離別，又向西堂送阿連。","想到越中秋已盡，鏡河應羨月團圓。"],"s":"trad","f":"simp"},{"i":"6f8a6d72-8e29-4466-b249-f4c80165ed15","t":"奉和大梁相公送人二首 二","a":"裴夷直","d":"唐","g":"短诗","p":["北津楊柳迎烟綠，南岸闌干映水紅。","君到襄陽渡江處，始應回首憶羊公。"],"s":"mixed","f":"simp"},{"i":"5fd0402b-5e34-4b02-937b-4bcbf3368b12","t":"酬唐仁烈相別後喜阻風未發見寄","a":"裴夷直","d":"唐","g":"短诗","p":["離心一起淚雙流，春浪無情也白頭。","風若有知須放去，莫教重別又重愁。"],"s":"trad","f":"simp"},{"i":"ebf1be33-e0ab-4659-9d0c-5e3ef6c6c06e","t":"秦中臥病思歸","a":"裴夷直","d":"唐","g":"短诗","p":["索索涼風滿樹頭，破窗殘月五更秋。","病身歸處吳江上，一寸心中萬里愁。"],"s":"mixed","f":"simp"},{"i":"e9d6c3ff-165e-4e52-a810-63d544b9afea","t":"送王繢","a":"裴夷直","d":"唐","g":"短诗","p":["翠羽長將玉樹期，偶然飛下肯多時。","翩翩一路嵐陰晚，却入青葱宿舊枝。"],"s":"mixed","f":"simp"},{"i":"eb90f26f-4c0f-4d55-a65c-aa23ed550ef6","t":"贈美人琴絃","a":"裴夷直","d":"唐","g":"短诗","p":["應從玉指到金徽，萬態千情料可知。","今夜燈前湘水怨，殷勤封在七條絲。"],"s":"trad","f":"simp"},{"i":"267b9325-1630-4ee9-bd02-d24b45af8338","t":"病中知皇子陂荷花盛發寄王繢","a":"裴夷直","d":"唐","g":"短诗","p":["十里蓮塘路不賒，病來簾外是天涯。","煩君四句遙相寄，應得詩中便看花。"],"s":"trad","f":"simp"},{"i":"88e8dc78-b2ca-48a3-a980-dfed27b83bd1","t":"戲唐仁烈","a":"裴夷直","d":"唐","g":"短诗","p":["自知年幾偏應少，先把屠蘇不讓春。","儻更數年逢此日，還應惆悵羨他人。"],"s":"trad","f":"simp"},{"i":"a93800bc-9f72-4a28-b6e9-559244a382c8","t":"上下七盤二首 一","a":"裴夷直","d":"唐","g":"短诗","p":["斗回山路掩皇州，二載歡娛一望休。","從此萬重青嶂合，無因更得重回頭。"],"s":"mixed","f":"simp"},{"i":"0905ae6f-f389-4d57-91d6-f1013f5ce8fd","t":"上下七盤二首 二","a":"裴夷直","d":"唐","g":"短诗","p":["商山半月雨漫漫，偶值新晴下七盤。","山似換來天似洗，可憐風日到長安。"],"s":"trad","f":"simp"},{"i":"22b4e3e6-44af-4666-8316-1293c3daa861","t":"八月十五日夜","a":"裴夷直","d":"唐","g":"短诗","p":["去年今夜在商州，還爲清光上驛樓。","宛是依依舊顏色，自憐人換幾般愁。"],"s":"mixed","f":"simp"},{"i":"4707beb7-4039-41f6-a587-21d15b54358f","t":"南詔朱藤杖","a":"裴夷直","d":"唐","g":"短诗","p":["六節南藤色似朱，拄行階砌勝人扶。","會須將入深山去，倚看雲泉作老夫。"],"s":"trad","f":"simp"},{"i":"e386882b-d0cd-480a-8c38-08ad675c36f8","t":"夜意","a":"裴夷直","d":"唐","g":"短诗","p":["蕭疎盡地林無影，浩蕩連天月有波。","獨立空亭人睡後，洛橋風便水聲多。"],"s":"trad","f":"simp"},{"i":"ffd11ad7-83bd-45e1-824a-44767f23f200","t":"漫作","a":"裴夷直","d":"唐","g":"短诗","p":["月色莫來孤寢處，春風又向別人家。","梁園桃李雖無數，斷定今年不看花。"],"s":"trad","f":"simp"},{"i":"fc6f8268-7565-4789-9e03-bca065508f47","t":"訪劉君","a":"裴夷直","d":"唐","g":"短诗","p":["擾擾馳蹄又走輪，五更飛盡九衢塵。","靈芝破觀深松院，還有齋時未起人。"],"s":"trad","f":"simp"},{"i":"dac1571e-697d-44bb-9e4d-d10febd20d3b","t":"楊柳枝詞","a":"裴夷直","d":"唐","g":"短诗","p":["已作綠絲籠曉日，又成飛絮撲晴波。","隋家不合栽楊柳，長遣行人春恨多。"],"s":"trad","f":"simp"},{"i":"81763d8b-d9a8-446e-8abf-c33ebb1bb604","t":"寄杭州崔使君","a":"裴夷直","d":"唐","g":"短诗","p":["朝下歸來只閉關，羨君高步出人寰。","三年不見塵中事，滿眼江濤送雪山。"],"s":"trad","f":"simp"},{"i":"2b84a089-3498-4aa7-9249-8a6390b0b631","t":"窮冬曲江閑步","a":"裴夷直","d":"唐","g":"短诗","p":["雪盡南坡鴈北飛，草根春意勝春暉。","曲江永日無人到，獨遶寒池又獨歸。"],"s":"trad","f":"simp"},{"i":"f168ea1d-968d-464a-b7b0-1fc9bd1b0b5b","t":"省中題新植雙松","a":"裴夷直","d":"唐","g":"短诗","p":["端坐高宮起遠心，雲高水闊共幽沈。","更堂寓直將誰語，自種雙松伴夜吟。"],"s":"trad","f":"simp"},{"i":"568b1483-0cc5-44d9-b0b1-a8c56462dc28","t":"崇山郡","a":"裴夷直","d":"唐","g":"短诗","p":["地盡炎荒瘴海頭，聖朝今又放驩兜。","交州已在南天外，更過交州四五州。"],"s":"trad","f":"simp"},{"i":"a5dc4fdc-10ec-4d67-8b84-a94d039a23e7","t":"臨水","a":"裴夷直","d":"唐","g":"短诗","p":["一見心原斷百憂，益知身世兩悠悠。","江亭獨倚闌干處，人亦無言水自流。"],"s":"mixed","f":"simp"},{"i":"e8eeefaa-8d04-47d0-b1a8-3b6bb7568e55","t":"題江上柳寄李使君","a":"裴夷直","d":"唐","g":"短诗","p":["桂江南渡無楊柳，見此令人眼暫明。","應學郡中賢太守，依依相向許多情。"],"s":"trad","f":"simp"},{"i":"7a638998-267d-4ec3-b561-706e818cadd5","t":"江上見月懷古","a":"裴夷直","d":"唐","g":"短诗","p":["月上江平夜不風，伏波遺跡半成空。","今宵倍欲悲陵谷，銅柱分明在水中。"],"s":"trad","f":"simp"},{"i":"64c5e24c-c5d3-47c5-98fd-8eb5961e1f78","t":"鸚鵡","a":"裴夷直","d":"唐","g":"短诗","p":["勸爾莫移禽鳥性，翠毛紅觜任天真。","如今漫學人言巧，解語終須累爾身。"],"s":"trad","f":"simp"},{"i":"11c1842c-f5ee-4737-816d-b4849264e56f","t":"寄婺州李給事二首 一","a":"裴夷直","d":"唐","g":"短诗","p":["心盡玉皇恩已遠，跡留江郡宦應孤。","不知壯氣今何似，猶得凌雲貫日無。"],"s":"trad","f":"simp"},{"i":"ff034545-4628-48e5-807e-b50583f8c907","t":"寄婺州李給事二首 二","a":"裴夷直","d":"唐","g":"短诗","p":["瘴鬼翻能念直心，五年相遇不相侵。","目前唯有思君病，無底滄溟未是深。"],"s":"trad","f":"simp"},{"i":"f00b6726-356f-4788-a808-e1183268d964","t":"秋日","a":"裴夷直","d":"唐","g":"短诗","p":["六眸龜北涼應早，三足烏南日正長。","常記京關怨搖落，如今目斷滿林霜。"],"s":"trad","f":"simp"},{"i":"3ae868cd-3210-4e46-89c8-034fb2ec3bc5","t":"遣意","a":"裴夷直","d":"唐","g":"短诗","p":["梧桐墜露悲先朽，松桂凌霜倚後枯。","不是世間長在物，蹔分貞脆竟何殊。"],"s":"trad","f":"simp"},{"i":"f380223e-fb6e-415c-bf49-96719507967e","t":"戲酬惟賞上人","a":"裴夷直","d":"唐","g":"短诗","p":["師是浮雲無著身，我居塵網敢相親。","應從海上秋風便，偶自飛來不爲人。"],"s":"mixed","f":"simp"},{"i":"e090d81a-0753-4556-a91b-1f78e3c87df9","t":"寓言","a":"裴夷直","d":"唐","g":"短诗","p":["流水頹陽不暫停，東流西落兩無情。","不是世間人自老，古來華髮此中生。"],"s":"trad","f":"simp"},{"i":"96797f24-909e-4fbd-88a8-4576d3bd6a14","t":"憶家","a":"裴夷直","d":"唐","g":"短诗","p":["天海相連無盡處，夢魂來往尚應難。","誰言南海無霜雪，試向愁人兩鬢看。"],"s":"trad","f":"simp"},{"i":"ca25d9b3-ed25-44d9-9976-700b5475edd2","t":"留客","a":"裴夷直","d":"唐","g":"短诗","p":["青梅欲熟笋初長，嫩綠新陰遶砌涼。","湖館翛然無俗客，白衣居士且匡牀。"],"s":"mixed","f":"simp"},{"i":"c1d8d427-9ddb-47dd-9702-f1ddbda34bd7","t":"別蘄春王判官","a":"裴夷直","d":"唐","g":"短诗","p":["四十年來[真]久故，三千里外暫相逢。","今日一杯成遠別，烟波眇眇恨重重。"],"s":"mixed","f":"simp"},{"i":"8eb0d609-7145-40c2-a553-1890da2c70ec","t":"將發循州社日於所居館宴送","a":"裴夷直","d":"唐","g":"短诗","p":["浪花如雪疊江風，社過高秋萬恨中。","明日便隨江燕去，依依俱是故巢空。"],"s":"trad","f":"simp"},{"i":"028b1794-eae0-4142-aef7-d25b2cc2afc6","t":"泛溪","a":"朱慶餘","d":"唐","g":"短诗","p":["曲渚迴花舫，生衣臥向風。","鳥飛溪色裏，人語棹聲中。","餘卉纔分影，新蒲自作叢。","前灣更幽絕，雖淺去猶通。"],"s":"mixed","f":"simp"},{"i":"3f206dce-b488-46c6-8ec7-ffd730373db9","t":"宿陳處士書齋","a":"朱慶餘","d":"唐","g":"短诗","p":["結茅當此地，下馬見高情。","菰葉寒塘晚，杉陰白石明。","向爐新茗色，隔雪遠鐘聲。","閑得相逢少，吟多寐不成。"],"s":"trad","f":"simp"},{"i":"dcf41cfc-d052-44b3-8f5c-e52eee610cda","t":"上宣州沈大夫","a":"朱慶餘","d":"唐","g":"短诗","p":["科名繼世古來稀，高步何年下紫微。","帝命幾曾移重鎮，時清猶望領春闈。","登朝舊友常思見，開幕賢人併望歸。","今日得遊風化地，却回滄海有光輝。"],"s":"mixed","f":"simp"},{"i":"b1147a91-a65d-4449-a3c0-e6b177b511c9","t":"杭州送蕭寶校書","a":"朱慶餘","d":"唐","g":"短诗","p":["馬識青山路，人隨白浪船。","別君猶有淚，學道謾經年。"],"s":"trad","f":"simp"},{"i":"996a613d-4623-416f-925f-7b3b4034f997","t":"送盛長史","a":"朱慶餘","d":"唐","g":"短诗","p":["莫辭東路遠，此別豈閑行。","職處中軍要，官兼上佐榮。","野亭楓葉暗，秋水藕花明。","拜省期將近，孤舟促去程。"],"s":"trad","f":"simp"},{"i":"02836fc6-a0f8-4b4a-8bc2-d4ac59990067","t":"宿道士觀","a":"朱慶餘","d":"唐","g":"短诗","p":["堂閉僊人影，空壇月露初。","閑聽道家子，盥漱讀靈書。"],"s":"trad","f":"simp"},{"i":"c45eef97-a07f-4999-9f67-e863e9828310","t":"湖州韓使君置宴","a":"朱慶餘","d":"唐","g":"短诗","p":["老大成名仍足病，縱聽絲竹也無歡。","高情太守容閑坐，借與青山盡日看。"],"s":"trad","f":"simp"},{"i":"1e63f4cf-a078-44df-814f-8bea0929e526","t":"題僊遊寺","a":"朱慶餘","d":"唐","g":"短诗","p":["石抱龍堂蘚石乾，山遮白日寺門寒。","長松瀑布饒奇狀，曾有仙人駐鶴看。"],"s":"trad","f":"simp"},{"i":"2dcb7fd8-a1a6-434b-bb80-fa6923197085","t":"公子行","a":"朱慶餘","d":"唐","g":"短诗","p":["閑從結客冶遊時，忘却紅樓薄暮期。","醉上黃金堤上去，馬鞭捎斷綠楊絲。"],"s":"mixed","f":"simp"},{"i":"c6e38b16-b83d-41e0-8839-d6d29bb3bf15","t":"送陳摽","a":"朱慶餘","d":"唐","g":"短诗","p":["滿酌勸童僕，好隨郎馬蹄。","春風慎行李，莫上白銅鞮。"],"s":"trad","f":"simp"},{"i":"8c7e86af-7eac-43e4-95ff-e1e4c3cd9ab0","t":"尋古觀","a":"朱慶餘","d":"唐","g":"短诗","p":["僊觀曾過知不遠，花藏石室杳難尋。","泉邊白鹿聞人語，看過天壇漸入深。"],"s":"trad","f":"simp"},{"i":"8b92e129-ad6b-4fd6-a097-20aff22782bf","t":"南嶺路","a":"朱慶餘","d":"唐","g":"短诗","p":["越嶺向南風景異，人人傳說到京城。","經冬來往不踏雪，盡在刺桐花下行。"],"s":"trad","f":"simp"},{"i":"a94fee19-9e17-47d9-a9c2-7c1d6536d14b","t":"陪江州李使君重陽宴百花亭","a":"朱慶餘","d":"唐","g":"短诗","p":["閑攜九日酒，共到百花亭。","醉裏求詩境，回看島嶼青。"],"s":"mixed","f":"simp"},{"i":"a741fa0a-099c-425e-91c5-e1d67a946da2","t":"上張水部","a":"朱慶餘","d":"唐","g":"短诗","p":["出入門闌久，兒童亦有情。","不忘將姓字，常說向公卿。","每許連牀坐，仍容並馬行。","恩深轉無語，懷抱甚分明。"],"s":"mixed","f":"simp"},{"i":"062ac841-d778-469b-ae73-3dcc872b25a9","t":"鳳翔西池與賈島納涼","a":"朱慶餘","d":"唐","g":"短诗","p":["四面無炎氣，清池闊復深。","蝶飛逢草住，魚戲見人沉。","拂石安茶器，移牀選樹陰。","幾迴同到此，盡日得閑吟。"],"s":"mixed","f":"simp"},{"i":"6b980f56-638a-45b7-8466-99a3be06dcc7","t":"上汴州令狐相公","a":"朱慶餘","d":"唐","g":"短诗","p":["罷相恩猶在，那容處靜司。","政嚴初領節，名重更因詩。","公事巡營外，戎裝拜勅時。","恭聞長與善，應念出身遲。"],"s":"trad","f":"simp"},{"i":"3ce4374a-ac10-45b6-9a47-cc5582ed76f1","t":"送于中丞入蕃冊立","a":"朱慶餘","d":"唐","g":"短诗","p":["上馬生邊思，戎裝別衆僚。","雙旌銜命重，空磧去程遙。","迥沒沙中樹，孤飛雪外鵰。","蕃庭過冊禮，幾日却回朝。"],"s":"mixed","f":"simp"},{"i":"52fef130-01f0-46c7-987a-5bd24ec02b44","t":"送淮陰丁明府","a":"朱慶餘","d":"唐","g":"短诗","p":["之官未入境，已有愛人心。","遣吏回中路，停舟對遠林。","島聲淮浪靜，雨色稻苗深。","暇日公門掩，唯應伴客吟。"],"s":"trad","f":"simp"},{"i":"dc2c5e6b-d9f7-4fdd-913b-875760551bea","t":"送韋校書佐靈州幕","a":"朱慶餘","d":"唐","g":"短诗","p":["共知行處樂，猶惜此時分。","職已爲書記，官曾校典墳。","寒城初落葉，高戍遠生雲。","邊事何須問，深謀祗在君。"],"s":"mixed","f":"simp"},{"i":"a0487b39-8c88-4ca4-b541-f83ebfd93c3b","t":"上江州李史君","a":"朱慶餘","d":"唐","g":"短诗","p":["起家聲望重，自古更誰過。","得在朝廷少，還因諫諍多。","經年愁瘴癘，幾處遇恩波。","入境無餘事，唯聞父老歌。"],"s":"trad","f":"simp"},{"i":"6714559c-639e-4b92-8354-b78a55e2fd27","t":"發鳳翔後塗中懷田少府","a":"朱慶餘","d":"唐","g":"短诗","p":["識君春未半，意欲住經秋。","見酒連詩句，逢花跋馬頭。","別來唯獨宿，夢裏尚同游。","所在求飱過，無因離得愁。"],"s":"mixed","f":"simp"},{"i":"446315f0-3740-4248-8cf7-1dce97d9336e","t":"雪夜與真上人宿韓協律宅","a":"朱慶餘","d":"唐","g":"短诗","p":["斜雪微霑砌，空堂夜語清。","逆風聽漏短，回燭向樓明。","盥漱隨禪伴，謳吟得野情。","此歡那敢忘，世貴丈夫名。"],"s":"trad","f":"simp"},{"i":"54f56607-3ef1-4686-b1b6-2c9c3ff3fd48","t":"與賈島顧非熊無可上人宿萬年姚少府宅","a":"朱慶餘","d":"唐","g":"短诗","p":["莫厭通宵坐，貧中會聚難。","堂虛雪氣入，燈在漏聲殘。","役思因生病，當禪豈覺寒。","開門各有事，非不惜餘歡。"],"s":"trad","f":"simp"},{"i":"efd28f83-a3b4-4297-9de7-80a215b4f84d","t":"震爲蒼筤竹","a":"朱慶餘","d":"唐","g":"古体","p":["爲擢東方秀，修然異衆筠。","青蒼纔映粉，蒙密正含春。","嫩籜霑微雨，幽根絕細塵。","乍憐分徑小，偏覺帶煙新。","結實皆留鳳，垂陰似庇人。","顧唯竿在手，深水掛頳鱗。"],"s":"mixed","f":"simp"},{"i":"ba7b4d84-d1e4-4ca1-96c1-06c5fbf84549","t":"題青龍寺","a":"朱慶餘","d":"唐","g":"短诗","p":["寺好因崗勢，登臨值夕陽。","青山當佛閣，紅葉滿僧廊。","竹色連平地，蟲聲在上方。","最憐東面靜，爲近楚城牆。"],"s":"mixed","f":"simp"},{"i":"44b4e1e8-5c87-4cd6-8bbd-9b702a9d1ab8","t":"送滕庶子致仕歸江南","a":"朱慶餘","d":"唐","g":"短诗","p":["常懷獨往意，此日去朝簪。","丹詔榮歸騎，清風滿故林。","諸侯新起敬，遺老重相尋。","在處饒山水，堪行慰所心。"],"s":"trad","f":"simp"},{"i":"24066101-5b6f-4fea-9e95-bd01a687c6ed","t":"夏日題武功姚主簿","a":"朱慶餘","d":"唐","g":"短诗","p":["亭午無公事，垂簾樹色間。","僧來茶竈動，吏去印牀閑。","傍竹行尋巷，當門立看山。","吟詩老不倦，未省話官班。"],"s":"mixed","f":"simp"},{"i":"25bc9104-e1ed-4156-a8f0-757d015e7b8c","t":"送張景宣下第東歸","a":"朱慶餘","d":"唐","g":"短诗","p":["歸省值花時，閑吟落第詩。","高情憐道在，公論覺才遺。","春雨連淮暗，私船過馬遲。","離心可惆悵，爲有入城期。"],"s":"mixed","f":"simp"},{"i":"59c05369-714c-43ba-842a-76548b3f21d7","t":"送顧非熊下第歸","a":"朱慶餘","d":"唐","g":"短诗","p":["但取詩名遠，寧論下第頻。","惜爲今日別，共受幾年貧。","聽雨宿吳寺，過江逢越人。","知從本府薦，秋晚又辭親。"],"s":"mixed","f":"simp"},{"i":"94810bad-0859-4cac-894c-e0de17e1a50e","t":"送韋繇校書赴浙東幕","a":"朱慶餘","d":"唐","g":"短诗","p":["丞相辟書新，秋關獨去人。","官離芸閣早，名占甲科頻。","水驛迎船火，山城候騎塵。","湖邊寄家久，到日喜榮親。"],"s":"mixed","f":"simp"},{"i":"432dda35-564f-44cf-b5a8-a5dc9b75f544","t":"尋賈島所居","a":"朱慶餘","d":"唐","g":"短诗","p":["求閑身未得，此日到京東。","獨在鐘聲外，相逢樹色中。","誰言人漸老，所向意皆同。","月上因留宿，移牀對藥叢。"],"s":"mixed","f":"simp"},{"i":"93f39a48-846f-4b29-9a0e-3b9cce64608b","t":"題毗陵上人院","a":"朱慶餘","d":"唐","g":"短诗","p":["院深終日靜，落葉覆秋蟲。","盥漱新齋後，修行未老中。","映松山色遠，隔水磬聲通。","此處宜清夜，高吟永與同。"],"s":"trad","f":"simp"},{"i":"57c950fd-3711-48dc-8df3-09555f1d7a7c","t":"送李侍御入蕃","a":"朱慶餘","d":"唐","g":"短诗","p":["遠使隨雙節，新官屬外臺。","戎裝非好武，書記本多才。","移帳依泉宿，迎人帶雪來。","心知玉關道，稀見一花開。"],"s":"trad","f":"simp"},{"i":"65b5093e-0faf-4f93-ab77-a843168acea5","t":"望蕭關","a":"朱慶餘","d":"唐","g":"短诗","p":["漸見風沙暗，蕭關欲到時。","兒童能探火，婦女解縫旗。","川絕銜魚鷺，林多帶箭麋。","暫來戎馬地，不敢苦吟詩。"],"s":"trad","f":"simp"},{"i":"40401dc2-a6a3-46f2-bd6f-68198b7a2309","t":"送韓校書赴江西幕","a":"朱慶餘","d":"唐","g":"古体","p":["從軍五湖外，終是稱詩人。","酒後愁將別，塗中過却春。","山橋槲葉暗，水館燕巢新。","驛舫迎應遠，京書寄自頻。","野情隨到處，公務日關身。","久共趨名利，龍鍾獨滯秦。"],"s":"mixed","f":"simp"},{"i":"f7a50917-4a37-4197-9af5-dd104c82d60c","t":"題寄王秘書","a":"朱慶餘","d":"唐","g":"短诗","p":["唯求買藥價，此外更無機。","扶病看紅葉，辭官著白衣。","斷籬通野徑，高樹蔭鄰扉。","時復留僧宿，餘人得見稀。"],"s":"trad","f":"simp"},{"i":"e58addbd-ee94-461a-9905-8423b62f91ac","t":"山居","a":"朱慶餘","d":"唐","g":"短诗","p":["歸來青壁下，又見滿籬霜。","轉覺琴齋靜，閑從菊地荒。","山泉共鹿飲，林果讓僧嘗。","時復收新藥，隨雲過石梁。"],"s":"trad","f":"simp"},{"i":"c01fed66-e625-4e38-b851-055447c08c02","t":"重過惟貞上人院","a":"朱慶餘","d":"唐","g":"短诗","p":["老去唯求靜，都忘外學名。","掃牀秋葉滿，對客遠雲生。","香閤閑留宿，晴階暖共行。","窗西暮山色，依舊入詩情。"],"s":"mixed","f":"simp"},{"i":"bcb03337-0b1d-4b63-b8e1-2cb73ed4aca3","t":"與石晝秀才過普照寺","a":"朱慶餘","d":"唐","g":"短诗","p":["問人知寺路，松竹暗春山。","潭黑龍應在，巢空鶴未還。","經年爲客倦，半日與僧閑。","更共嘗新茗，聞鐘笑語間。"],"s":"mixed","f":"simp"},{"i":"7429e111-8b2d-4626-8d4e-f6630e6734b5","t":"題任處士幽居","a":"朱慶餘","d":"唐","g":"短诗","p":["惜與幽人別，停舟對草堂。","湖雲侵臥位，杉露滴茶牀。","山月吟時在，池花覺後香。","生涯無一物，誰與讀書糧。"],"s":"mixed","f":"simp"},{"i":"a18165e9-9e12-4231-b2b3-19c8b0bcc87f","t":"送僧往太原謁李司空","a":"朱慶餘","d":"唐","g":"短诗","p":["已共鄰房別，應無更住心。","中時過野店，後夜宿寒林。","寺去人煙遠，城連塞雪深。","禪餘得新句，堪對上公吟。"],"s":"trad","f":"simp"},{"i":"237b7a55-7821-44b5-b17f-4d30fa311028","t":"將之上京別淮南書記李侍御","a":"朱慶餘","d":"唐","g":"短诗","p":["心地偶相見，語多爲別難。","詩成公府晚，路入翠微寒。","逢石自應坐，有花誰共看。","身爲當去鴈，雲盡到長安。"],"s":"mixed","f":"simp"},{"i":"34f91a91-b322-4bc3-b9d1-ac8e7987cc4a","t":"韓協律相送精舍讀書四韻奉寄呈陸補闕","a":"朱慶餘","d":"唐","g":"短诗","p":["白鶴西山別，更看上去船。","遙知尋寺路，應念宿江煙。","到處無閑日，迴期已隔年。","何因陪夜坐，清論諫臣邊。"],"s":"trad","f":"simp"}]