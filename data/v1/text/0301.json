[{"i":"9ba15920-f15e-4d0f-a239-6ac06fd075eb","t":"十無詩寄桂府楊中丞 六","a":"趙嘏","d":"唐","g":"短诗","p":["望斷南雲日已晡，便應憑夢過重湖。","不知自古登龍者，曾有因詩泥得無。"],"s":"trad","f":"simp"},{"i":"627c1d99-08a3-4b6c-b93a-8bc420b4fdb5","t":"十無詩寄桂府楊中丞 七","a":"趙嘏","d":"唐","g":"短诗","p":["早游門館一樵夫，祗愛吟詩傍藥爐。","旌斾滿江身不見，思言記得穎川無。"],"s":"mixed","f":"simp"},{"i":"4ae3c442-0ede-47d5-b311-e230a0de0c5f","t":"十無詩寄桂府楊中丞 八","a":"趙嘏","d":"唐","g":"短诗","p":["孔融襟抱稱名儒，愛物憐才與世殊。","今日賓堦忘姓字，當時省記薦雄無。"],"s":"trad","f":"simp"},{"i":"acd0c10e-587a-4b45-91a3-34ae63bd9658","t":"十無詩寄桂府楊中丞 九","a":"趙嘏","d":"唐","g":"短诗","p":["僻愛江山俯坐隅，人間不是便爲圖。","尊前爲問神仙伴，肯向三清慰薦無。"],"s":"mixed","f":"simp"},{"i":"21c2e074-4b54-4742-83af-3a05c76be088","t":"十無詩寄桂府楊中丞 十","a":"趙嘏","d":"唐","g":"短诗","p":["膺門不避額逢珠，絕境由來卷軸須。","早忝阿戎詩友契，趨庭曾薦禰生無。"],"s":"trad","f":"simp"},{"i":"e48666fa-7a93-4116-bffb-d97fb415b83a","t":"寄山僧","a":"趙嘏","d":"唐","g":"短诗","p":["雲裏幽僧不置房，橡花藤葉蓋禪牀。","朝來逢著山中伴，聞說新移最上方。"],"s":"mixed","f":"simp"},{"i":"c8aa719b-824f-4082-94f7-27d904718d68","t":"喜張濆及第","a":"趙嘏","d":"唐","g":"短诗","p":["九轉丹成最上仙，青天暖日踏雲軒。","春風賀喜無言語，排比花枝滿杏園。"],"s":"trad","f":"simp"},{"i":"a24d8a04-59dd-4729-820d-2553759d1ccd","t":"贈張濆榜頭被駮落","a":"趙嘏","d":"唐","g":"短诗","p":["莫向花前泣酒杯，謫仙依舊是仙才。","猶堪與世爲祥瑞，曾到蓬山頂上來。"],"s":"mixed","f":"simp"},{"i":"5c83dafb-da9d-4c87-b3cd-cb4e835d2098","t":"悼亡二首 一","a":"趙嘏","d":"唐","g":"短诗","p":["一燭從風到奈何，二年衾枕逐流波。","雖知不得公然淚，時泣闌干恨更多。"],"s":"mixed","f":"simp"},{"i":"ff4284b9-7b5e-4c32-b6ff-ddd71b422ee5","t":"悼亡二首 二","a":"趙嘏","d":"唐","g":"短诗","p":["明月蕭蕭海上風，君歸泉路我飄蓬。","門前雖有如花貌，爭奈如花心不同。"],"s":"trad","f":"simp"},{"i":"1c135ff0-a6f5-4ecb-a7f9-0d7c10710581","t":"宮烏栖","a":"趙嘏","d":"唐","g":"短诗","p":["宮烏棲處玉樓深，微月生簷夜夜心。","香輦不回花自落，春來空佩辟寒金。"],"s":"mixed","f":"simp"},{"i":"1b5a070c-e194-4cef-b8e0-fa1a15f9b4d0","t":"長信宮","a":"趙嘏","d":"唐","g":"短诗","p":["君恩已盡欲何歸，猶有殘香在舞衣。","自恨身輕不如燕，春來長遶御簾飛。"],"s":"trad","f":"simp"},{"i":"d4f72b44-1624-4663-bbe8-31242962ccd5","t":"廣陵城","a":"趙嘏","d":"唐","g":"短诗","p":["紅映高臺綠繞城，城邊春草傍墻生。","隋家不向此中盡，汴水應無東去聲。"],"s":"trad","f":"simp"},{"i":"65b32e14-32af-489d-b17a-482733889713","t":"冷日過驪山","a":"趙嘏","d":"唐","g":"短诗","p":["冷日微煙渭水愁，翠華宮樹不勝秋。","霓裳一曲千門鎖，白盡梨園弟子頭。"],"s":"trad","f":"simp"},{"i":"5db0b23a-1dc1-40db-b1f8-941de2fc2614","t":"下第後歸永樂里自題二首 一","a":"趙嘏","d":"唐","g":"短诗","p":["無地無媒只一身，歸來空拂滿牀塵。","尊前盡日誰相對，唯有南山似故人。"],"s":"mixed","f":"simp"},{"i":"9a806597-f7f6-4f1e-b033-57b757ce1bfd","t":"下第後歸永樂里自題二首 二","a":"趙嘏","d":"唐","g":"短诗","p":["玄髮侵愁忽似翁，暖塵寒袖共東風。","公卿門戶不知處，立馬九衢春影中。"],"s":"mixed","f":"simp"},{"i":"9f1414de-02df-465b-840a-31570cb16e0e","t":"出試日獨遊曲江","a":"趙嘏","d":"唐","g":"短诗","p":["江莎漸映花邊綠，樓日自開池上春。","雙鶴遶空來又去，不知臨水有愁人。"],"s":"trad","f":"simp"},{"i":"dfe5d78a-8fc0-46ab-916c-6afacddc4ff0","t":"題曹娥廟","a":"趙嘏","d":"唐","g":"短诗","p":["青娥埋沒此江濱，江樹颼飀慘暮雲。","文字在碑碑已墮，波濤辜負色絲文。"],"s":"trad","f":"simp"},{"i":"9f937e33-dc40-4ae8-a244-55cfbfa8f813","t":"題段氏中臺","a":"趙嘏","d":"唐","g":"短诗","p":["看山臺下水無塵，碧篠前頭曲水春。","獨對一尊風雨夜，不知家有早朝人。"],"s":"trad","f":"simp"},{"i":"06c9e6d5-f91d-497d-b40e-471f4c289d67","t":"華州座中獻盧給事","a":"趙嘏","d":"唐","g":"短诗","p":["送迎皆到三峰下，滿面煙霜滿馬塵。","自是追攀認知己，青雲不假送迎人。"],"s":"trad","f":"simp"},{"i":"ea49850f-bc2d-492a-96d5-92bee9655ba5","t":"商山道中","a":"趙嘏","d":"唐","g":"短诗","p":["和如春色淨如秋，五月商山是勝遊。","當晝火雲生不得，一溪縈作萬重愁。"],"s":"trad","f":"simp"},{"i":"601e3e64-7d56-4e5b-9ba4-7ff6162e1f10","t":"贈歙州妓","a":"趙嘏","d":"唐","g":"短诗","p":["灩灩橫波思有餘，庾樓明月墮雲初。","揚州寒食春風寺，看遍花枝盡不如。"],"s":"trad","f":"simp"},{"i":"026890c8-c99f-48ac-9cd9-77cd215dcb99","t":"贈王明府","a":"趙嘏","d":"唐","g":"短诗","p":["五柳逢秋影漸微，陶潛戀酒不知歸。","但存物外醉鄉在，誰向人間問是非。"],"s":"trad","f":"simp"},{"i":"24ad7bfb-5fb3-4175-a11c-8f7f881ef756","t":"呂校書雨中見訪","a":"趙嘏","d":"唐","g":"短诗","p":["竹閣斜溪小檻明，惟君來賞見山情。","馬嘶風雨又歸去，獨聽子規千萬聲。"],"s":"trad","f":"simp"},{"i":"41a1eea7-0cd8-415f-9dec-91638ecaa5b4","t":"千秋嶺下","a":"趙嘏","d":"唐","g":"短诗","p":["知有巖前萬樹桃，未逢搖落思空勞。","年年盛發無人見，三十六溪春水高。"],"s":"trad","f":"simp"},{"i":"0f3cc689-1a60-43d5-a2a7-6f1227e0ca16","t":"歙州道中僕逃","a":"趙嘏","d":"唐","g":"短诗","p":["去跳風雨幾奔波，曾共辛勤奈若何。","莫遣窮歸不知處，秋山重疊戍旗多。"],"s":"trad","f":"simp"},{"i":"95512aed-4fe7-4e32-b698-d68e8fa28dc0","t":"重陽日寄韋舍人","a":"趙嘏","d":"唐","g":"短诗","p":["節過重陽菊委塵，江邊病起杖扶身。","不知此日龍山會，誰是風流落帽人。"],"s":"trad","f":"simp"},{"i":"b10ee1ae-744a-4af9-933a-05ca3cd49c06","t":"贈薛勛下第","a":"趙嘏","d":"唐","g":"短诗","p":["一擲雖然未得盧，驚人不用繞牀呼。","牢之坐被青雲逼，祗問君能酷似無。"],"s":"mixed","f":"simp"},{"i":"a3e20bc3-b48a-4439-8c12-da9489021df5","t":"宛陵望月寄沈學士","a":"趙嘏","d":"唐","g":"短诗","p":["一川如畫敬亭東，待詔閑遊處處同。","天竺山前鏡湖畔，何如今日庾樓中。"],"s":"trad","f":"simp"},{"i":"40b14c6a-1ee6-4703-ba08-780fa7d023b9","t":"翡翠巖","a":"趙嘏","d":"唐","g":"短诗","p":["芙蓉幕裏千場醉，翡翠巖前半日閑。","惆悵晉朝人不到，謝公拋力上東山。"],"s":"mixed","f":"simp"},{"i":"742eb740-805e-4e63-bd6c-a86eb5bb661b","t":"發新安後途中寄盧中丞二首 一","a":"趙嘏","d":"唐","g":"短诗","p":["樓上風流庾使君，笙歌曾醉此中聞。","目前已是陵陽路，回首叢山滿眼雲。"],"s":"trad","f":"simp"},{"i":"cec64e0f-fe44-4486-9a72-5f2918eca31d","t":"發新安後途中寄盧中丞二首 二","a":"趙嘏","d":"唐","g":"短诗","p":["晚樹蕭蕭促織愁，風簾似水滿牀秋。","千山不礙笙歌月，誰伴羊公上夜樓。"],"s":"mixed","f":"simp"},{"i":"0376ad8f-cf2c-4088-93e3-482c8395e20e","t":"留題興唐寺","a":"趙嘏","d":"唐","g":"短诗","p":["滿水樓臺滿寺山，七年今日共躋攀。","月高對菊問行客，去折芳枝早晚還。"],"s":"trad","f":"simp"},{"i":"dc71446e-1119-464f-a37a-070cad1ab353","t":"廣陵道","a":"趙嘏","d":"唐","g":"短诗","p":["鬬雞臺邊花照塵，煬帝陵下水含春。","青雲回翅北歸雁，白首哭途何處人。"],"s":"trad","f":"simp"},{"i":"3d99abf1-bc08-41b0-b347-2f0b340d6634","t":"茅山道中","a":"趙嘏","d":"唐","g":"短诗","p":["溪樹重重水亂流，馬嘶殘雨晚程秋。","門前便是仙山路，目送歸雲不得遊。"],"s":"trad","f":"simp"},{"i":"e8dbee52-3fc7-4f5f-9d65-8817156d0460","t":"江上與兄別","a":"趙嘏","d":"唐","g":"短诗","p":["楚國湘江兩渺瀰，暖川晴雁背帆飛。","人間離別盡堪哭，何況不知何日歸。"],"s":"trad","f":"simp"},{"i":"62dbebd9-bd38-42e0-9747-1c8ac17f9eb9","t":"落第","a":"趙嘏","d":"唐","g":"短诗","p":["九陌初晴處處春，不能回避看花塵。","由來得喪非吾事，本是釣魚船上人。"],"s":"mixed","f":"simp"},{"i":"c78d4a35-d541-449a-a7e0-373adff95945","t":"宛陵館冬青樹","a":"趙嘏","d":"唐","g":"短诗","p":["碧樹如煙覆晚波，清秋欲盡客重過。","故園亦有如煙樹，鴻雁不來風雨多。"],"s":"trad","f":"simp"},{"i":"459acb00-3fd5-4061-9c51-d7d3fcd73699","t":"贈五老韓尊師","a":"趙嘏","d":"唐","g":"短诗","p":["有客齋心事玉晨，對山鬚鬢綠無塵。","住山道士年如鶴，應識當時五老人。"],"s":"trad","f":"simp"},{"i":"3e75a42e-ffa6-4c5f-8e4a-da82361c0464","t":"經汾陽舊宅","a":"趙嘏","d":"唐","g":"短诗","p":["門前不改舊山河，破虜曾輕馬伏波。","今日獨經歌舞地，古槐疎冷夕陽多。"],"s":"trad","f":"simp"},{"i":"cb2535d9-d47f-4975-bec5-4cc216403169","t":"寄盧中丞","a":"趙嘏","d":"唐","g":"短诗","p":["葉覆清溪灩灩紅，路橫秋色馬嘶風。","獨攜一榼郡齋酒，吟對青山憶謝公。"],"s":"trad","f":"simp"},{"i":"63b4fd17-3860-4666-8aa2-e0e8e4697298","t":"途中","a":"趙嘏","d":"唐","g":"短诗","p":["故園回首雁初來，馬上千愁付一杯。","惟有新詩似相識，暮山吟處共徘徊。"],"s":"trad","f":"simp"},{"i":"9f26c917-df1f-494b-822b-673770a3d6fd","t":"寄裴瀾","a":"趙嘏","d":"唐","g":"短诗","p":["綺雲初墮亭亭月，錦席惟橫灩灩波。","宋玉逢秋正高臥，一篇吟盡奈情何。"],"s":"trad","f":"simp"},{"i":"2e74b3cb-5da6-497f-a984-51699e983940","t":"淮南丞相坐贈歌者虞姹","a":"趙嘏","d":"唐","g":"短诗","p":["綺筵無處避梁塵，虞姹清歌日日新。","來值渚亭花欲盡，一聲留得滿城春。"],"s":"mixed","f":"simp"},{"i":"6f739aca-2573-4d41-abb7-26dc65e714a5","t":"酬段侍御","a":"趙嘏","d":"唐","g":"短诗","p":["蓮花上客思閑閑，數首新詩到篳關。","吟得楚天風雨霽，一條江水兩三山。"],"s":"trad","f":"simp"},{"i":"2d00b3f4-5a3d-4fcf-9e24-945d8cf55e87","t":"尋僧二首 一","a":"趙嘏","d":"唐","g":"短诗","p":["臺殿參差日墮塵，塢西歸去一庵雲。","寒泉何處夜深落，聲隔半巖疎葉聞。"],"s":"trad","f":"simp"},{"i":"6a06afff-5756-4039-99c3-9c471a29613b","t":"尋僧二首 二","a":"趙嘏","d":"唐","g":"短诗","p":["溪戶無人谷鳥飛，石橋橫木掛禪衣。","看雲日暮倚松立，野水亂鳴僧未歸。"],"s":"trad","f":"simp"},{"i":"cd34dbf1-3a5e-4dcc-bd1b-a5d2d7449f0a","t":"發栢梯寺","a":"趙嘏","d":"唐","g":"短诗","p":["一泓秋水千竿竹，靜得勞生半日身。","猶有向西無限地，別僧騎馬入紅塵。"],"s":"trad","f":"simp"},{"i":"0b7225ba-73e3-49ee-be99-6725380a2edb","t":"西江晚泊","a":"趙嘏","d":"唐","g":"短诗","p":["茫茫靄靄失西東，柳浦桑村處處同。","戍鼓一聲帆影盡，水禽飛起夕陽中。"],"s":"trad","f":"simp"},{"i":"a7f13f76-a9a2-4d24-9260-0a30faab44ff","t":"南池","a":"趙嘏","d":"唐","g":"短诗","p":["照影池邊多少愁，往來重見此塘秋。","芙蓉苑外新經雨，紅葉相随何處流。"],"s":"mixed","f":"simp"},{"i":"244610b1-65f6-41fb-a29a-490e3a75d3ce","t":"江樓舊感","a":"趙嘏","d":"唐","g":"短诗","p":["獨上江樓思渺然，月光如水水如天。","同來望月人何處，風景依稀似去年。"],"s":"trad","f":"simp"},{"i":"8baa85eb-1ea9-4cda-9112-795185abc4d2","t":"南園","a":"趙嘏","d":"唐","g":"短诗","p":["雨過郊園綠尚微，落花惆悵滿塵衣。","芳尊有酒無人共，日暮看山還獨歸。"],"s":"trad","f":"simp"},{"i":"a65f7dff-61ac-4c5e-aa5e-30bf1946c60d","t":"南亭","a":"趙嘏","d":"唐","g":"短诗","p":["孤亭影在亂花中，悵望無人此醉同。","聽盡暮鐘猶獨坐，水邊襟袖起春風。"],"s":"trad","f":"simp"},{"i":"667ca439-8933-4f8c-bf92-49452c433865","t":"贈女仙","a":"趙嘏","d":"唐","g":"短诗","p":["水思雲情小鳳仙，月涵花態語如絃。","不因金骨三清客，誰識吳州有洞天。"],"s":"trad","f":"simp"},{"i":"e95b7df0-66de-40c6-ae6c-b119688a937e","t":"宣州送判官","a":"趙嘏","d":"唐","g":"短诗","p":["來時健筆佐嫖姚，去折槐花度野橋。","誰見尊前此惆悵，一聲歌盡路迢迢。"],"s":"trad","f":"simp"},{"i":"9258ebe8-568b-4306-b8dc-81590d5e02bd","t":"宿僧院","a":"趙嘏","d":"唐","g":"短诗","p":["月滿長空樹滿霜，度雲低拂近簷牀。","林中夜半一聲磬，臥見高僧入道場。"],"s":"mixed","f":"simp"},{"i":"1362acd7-e6e8-4178-aac6-266cb346faf2","t":"尋僧","a":"趙嘏","d":"唐","g":"短诗","p":["斜日橫窗起暗塵，水邊門戶閉閒春。","千竿竹裏花枝動，只道無人似有人。"],"s":"mixed","f":"simp"},{"i":"94f49863-1b47-4373-b109-3833d2626a41","t":"經王先生故居","a":"趙嘏","d":"唐","g":"短诗","p":["晚波東去海茫茫，誰識蓬山不死鄉。","弄玉已歸蕭史去，碧樓紅樹倚斜陽。"],"s":"trad","f":"simp"},{"i":"120086c5-198f-4ce9-9c10-15f2892f1f63","t":"送從翁中丞奉使黠戛斯六首 一","a":"趙嘏","d":"唐","g":"短诗","p":["揚雄詞賦舉天聞，萬里油幢照塞雲。","僕射峰西幾千騎，一時迎著漢將軍。"],"s":"mixed","f":"simp"},{"i":"5afc432e-1115-44f7-9dbb-2056ff04741b","t":"送從翁中丞奉使黠戛斯六首 二","a":"趙嘏","d":"唐","g":"短诗","p":["旌旗杳杳雁蕭蕭，春盡窮沙雪未消。","料得堅昆受宣後，始知公主已歸朝。"],"s":"trad","f":"simp"},{"i":"5a873c91-9b2e-4e3b-a4bd-9f7947f1ea60","t":"送從翁中丞奉使黠戛斯六首 三","a":"趙嘏","d":"唐","g":"短诗","p":["雖言窮北海雲中，屬國當時事不同。","九姓如今盡臣妾，歸期那肯待秋風。"],"s":"trad","f":"simp"},{"i":"1ce6e84a-ef90-4870-aad3-b11948c19d92","t":"送從翁中丞奉使黠戛斯六首 四","a":"趙嘏","d":"唐","g":"短诗","p":["牢山望斷絕塵氛，灩灩河西拂地雲。","誰見魯儒持漢節，玉關降盡可汗軍。"],"s":"trad","f":"simp"},{"i":"d148287e-cb8f-4e95-92bc-9d7e9b81ac20","t":"送從翁中丞奉使黠戛斯六首 五","a":"趙嘏","d":"唐","g":"短诗","p":["山川險易接胡塵，秦漢圖來或未真。","自此盡知邊塞事，河湟更欲託何人。"],"s":"trad","f":"simp"},{"i":"59cb7178-6cb1-4f8f-881c-e88d38d75aab","t":"送從翁中丞奉使黠戛斯六首 六","a":"趙嘏","d":"唐","g":"短诗","p":["秦皇無策建長城，劉氏仍窮北路兵。","若遇單于舊牙帳，却應傷歎漢公卿。"],"s":"mixed","f":"simp"},{"i":"857f534a-8077-4932-b335-c845b7c2fa47","t":"東亭柳","a":"趙嘏","d":"唐","g":"短诗","p":["拂水斜煙一萬條，幾隨春色倚河橋。","不知別後誰攀折，猶自風流勝舞腰。"],"s":"trad","f":"simp"},{"i":"cb969fae-a944-4186-b1ff-fff7ada5dd90","t":"僧舍二首 一","a":"趙嘏","d":"唐","g":"短诗","p":["秖言雙鬢未蹉跎，獨奈牛羊送日何。","禪客不歸車馬去，晚簷山色爲誰多。"],"s":"mixed","f":"simp"},{"i":"0660d11e-db79-4fd7-9a3d-9210857877d4","t":"僧舍二首 二","a":"趙嘏","d":"唐","g":"短诗","p":["溪上禪關水木間，水南山色與僧閑。","春風盡日無來客，幽磬一聲高鳥還。"],"s":"trad","f":"simp"},{"i":"d2a2351d-06b8-4425-956b-6e6a32570c13","t":"新月","a":"趙嘏","d":"唐","g":"短诗","p":["玉鉤斜傍畫簷生，雲匣初開一寸明。","何事最能悲少婦，夜來依約落邊城。"],"s":"trad","f":"simp"},{"i":"d52f23e0-29a9-4dab-9359-a0a0597c4853","t":"贈皇甫垣","a":"趙嘏","d":"唐","g":"短诗","p":["養由弓箭已無功，牢落生涯事事同。","相勸一杯寒食酒，幾多辛苦到春風。"],"s":"trad","f":"simp"},{"i":"7672fee3-837f-4485-bf36-8d4bc85b7ae1","t":"四祖寺","a":"趙嘏","d":"唐","g":"短诗","p":["千株松下雙峰寺，一盞燈前萬里身。","自爲心猿不調伏，祖師元是世間人。"],"s":"mixed","f":"simp"},{"i":"bd0fe66f-7b88-4249-8fb1-9bd892496e53","t":"聽蟬","a":"趙嘏","d":"唐","g":"短诗","p":["噪蟬聲亂日初曛，絃管樓中永不聞。","獨奈愁人數莖髮，故園秋隔五湖雲。"],"s":"trad","f":"simp"},{"i":"a06be1d4-e9d9-4e50-9447-adc4118c8b68","t":"寄遠","a":"趙嘏","d":"唐","g":"短诗","p":["禁鐘聲盡見棲禽，關塞迢迢故國心。","無限春愁莫相問，落花流水洞房深。"],"s":"trad","f":"simp"},{"i":"1def6971-c540-4e99-b642-7351749cabde","t":"池上","a":"趙嘏","d":"唐","g":"短诗","p":["正憐佳月夜深坐，池上暖回燕雁聲。","猶有漁舟繫江岸，故人歸盡獨何情。"],"s":"trad","f":"simp"},{"i":"27c25ad5-91a1-49fe-95e2-4dc5c14eb09c","t":"春日書懷","a":"趙嘏","d":"唐","g":"短诗","p":["暖鶯春日舌難窮，枕上愁生曉聽中。","應褭綠窗殘夢斷，杏園零落滿枝風。"],"s":"trad","f":"simp"},{"i":"ba29023a-ed78-449a-9de5-2b05cdcbe5bc","t":"贈別","a":"趙嘏","d":"唐","g":"短诗","p":["水邊秋草暮萋萋，欲駐殘陽恨馬蹄。","曾是管絃同醉伴，一聲歌盡各東西。"],"s":"trad","f":"simp"},{"i":"29b12ed6-731e-4b61-af99-604abbc9fd04","t":"靈巖寺","a":"趙嘏","d":"唐","g":"短诗","p":["館娃宮伴千年寺，水闊雲多客到稀。","聞說春來更惆悵，百花深處一僧歸。"],"s":"trad","f":"simp"},{"i":"d9f971b5-1bcc-488a-90c4-6abde891ee7f","t":"代人聽琴二首 一","a":"趙嘏","d":"唐","g":"短诗","p":["抱琴花夜不勝春，獨奏相思淚滿巾。","第五指中心最恨，數聲嗚咽爲何人。"],"s":"mixed","f":"simp"},{"i":"c6733b73-bd2e-415e-b77c-526b05a24ded","t":"代人聽琴二首 二","a":"趙嘏","d":"唐","g":"短诗","p":["湘娥不葬九疑雲，楚水連天坐憶君。","惟有啼烏舊名在，忍敎嗚咽夜長聞。"],"s":"trad","f":"simp"},{"i":"8a3438e4-946a-47f7-8457-9a80f0e4c3b8","t":"訪沈舍人不遇","a":"趙嘏","d":"唐","g":"短诗","p":["溪翁強訪紫微郎，曉鼓聲中滿鬢霜。","知在禁闈人不見，好風飄下九天香。"],"s":"trad","f":"simp"},{"i":"990164b1-47e8-432f-b7cf-d976f92c4952","t":"座上獻元相公","a":"趙嘏","d":"唐","g":"短诗","p":["寂寞堂前日又曛，陽臺去作不歸雲。","從來聞說沙[吒]利，今日青娥屬使君。"],"s":"trad","f":"simp"},{"i":"397819cc-e9a2-4f8c-849c-d4ddd546c505","t":"遣興二首 一","a":"趙嘏","d":"唐","g":"短诗","p":["溪花入夏漸稀疎，雨氣如秋麥熟初。","終日苦吟人不會，海邊兄弟久無書。"],"s":"trad","f":"simp"},{"i":"8b8ddf58-7516-430c-b341-91a949972d97","t":"遣興二首 二","a":"趙嘏","d":"唐","g":"短诗","p":["讀徹殘書弄水回，暮天何處笛聲哀？花前獨立無人會，依舊去年雙燕來。"],"s":"trad","f":"simp"},{"i":"e4e01365-143a-428f-baf7-905a2e6e3180","t":"送李給事","a":"趙嘏","d":"唐","g":"短诗","p":["眼前軒冕是鴻毛，天上人間漫自勞。","脫却朝衣獨歸去，青雲不及白雲高。"],"s":"mixed","f":"simp"},{"i":"2ebc6009-94a1-4c43-ba9e-654d3b6a5608","t":"宿僧舍","a":"趙嘏","d":"唐","g":"短诗","p":["高僧夜滴芙蓉漏，遠客窗含楊柳風。","何處相逢話心地，月明身在磬聲中。"],"s":"trad","f":"simp"},{"i":"a16c1aea-ad3c-48c1-9136-d9efa03f4225","t":"吳門夢故山","a":"趙嘏","d":"唐","g":"短诗","p":["心熟家山夢不迷，孤峰寒遶一條溪。","秋窗覺後情無限，月墮館娃宮樹西。"],"s":"trad","f":"simp"},{"i":"c949afb6-9040-48f8-8007-facc32e766d1","t":"別李譜","a":"趙嘏","d":"唐","g":"短诗","p":["尊前路映暮塵紅，池上琴橫醉席風。","今日別君如別鶴，聲容長在楚絃中。"],"s":"trad","f":"simp"},{"i":"ecd2bcf2-6a2b-4c85-b5ce-7f53dffc9e11","t":"和杜侍郎題禪智寺南樓","a":"趙嘏","d":"唐","g":"短诗","p":["樓畔花枝拂檻紅，露天香動滿簾風。","誰知野寺遺鈿處，盡在相如春思中。"],"s":"trad","f":"simp"},{"i":"fedea37c-9971-4004-9bd8-b0ef4c5804a1","t":"發青山","a":"趙嘏","d":"唐","g":"短诗","p":["鳧鷖聲暖野塘春，鞍馬嘶風驛路塵。","一宿青山又前去，古來難得是閑人。"],"s":"trad","f":"simp"},{"i":"a0d995b3-6a67-4e5d-8fa4-a84d64e89b18","t":"入藍關","a":"趙嘏","d":"唐","g":"短诗","p":["微煙已辨秦中樹，遠夢更依江上臺。","看落晚花還悵望，鯉魚時節入關來。"],"s":"trad","f":"simp"},{"i":"1954529d-bba3-4792-b937-57a7e5924785","t":"落第寄沈詢","a":"趙嘏","d":"唐","g":"短诗","p":["穿楊力盡獨無功，華髮相期一夜中。","別到江頭舊吟處，爲將雙淚問春風。"],"s":"mixed","f":"simp"},{"i":"7be9bf0f-d5e9-4ca5-9b16-14505c9fd885","t":"送韋中丞","a":"趙嘏","d":"唐","g":"短诗","p":["二年恩意是春輝，清淨胸襟似者希。","泣盡楚人多少淚，滿船唯載酒西歸。"],"s":"trad","f":"simp"},{"i":"b51c1702-9c66-4b9d-9863-f6c12ca79921","t":"詠端正春樹","a":"趙嘏","d":"唐","g":"短诗","p":["一樹繁陰先著名，異花奇葉儼天成。","馬嵬此去無多地，祗合楊妃墓上生。"],"s":"trad","f":"simp"},{"i":"96ce99c3-5898-4e39-9a70-07345817dd88","t":"敘事獻同州侍御三首 一","a":"趙嘏","d":"唐","g":"短诗","p":["青雲席中羅襪塵，白首江上吟詩人。","登龍不及三千士，虛度膺門二十春。"],"s":"trad","f":"simp"},{"i":"c3b2b5f8-01d0-4af1-ac31-d5263defb7c9","t":"敘事獻同州侍御三首 二","a":"趙嘏","d":"唐","g":"短诗","p":["平生望斷雲層層，紫府杳是他人登。","却應歸訪溪邊寺，說向當時同社僧。"],"s":"mixed","f":"simp"},{"i":"e40b81b5-e9ce-4dff-aedd-2d04c5527a00","t":"敘事獻同州侍御三首 三","a":"趙嘏","d":"唐","g":"短诗","p":["尊前誰伴謝公遊，蓮岳晴來翠滿樓。","坐見一方金變化，獨吟紅藥對殘秋。"],"s":"mixed","f":"simp"},{"i":"83a5843a-5c93-42cc-ac96-02a6e96e00e1","t":"婺州宴上留別","a":"趙嘏","d":"唐","g":"短诗","p":["雙溪樓影向雲橫，歌舞高臺晚更清。","獨自下樓騎瘦馬，搖鞭重入亂蟬聲。"],"s":"trad","f":"simp"},{"i":"8bccb9f1-cffe-4671-a612-df0aa404ac82","t":"別牛郎中門館","a":"趙嘏","d":"唐","g":"短诗","p":["整襟收淚別朱門，自料難酬顧念恩。","招得片魂騎匹馬，西風斜日入秋原。"],"s":"trad","f":"simp"},{"i":"5ff8447f-af54-4d5f-992d-0f49c2dfaecc","t":"山中寄盧簡求","a":"趙嘏","d":"唐","g":"短诗","p":["竹西池上有花開，日日幽吟看又回。","心憶郡中蕭記室，何時暫别醉鄉来。"],"s":"mixed","f":"simp"},{"i":"b9938b88-61aa-465d-a53d-9160cb9033f7","t":"寄梁佾兄弟","a":"趙嘏","d":"唐","g":"短诗","p":["桃李春多翠影重，竹樓當月夜無風。","荀家兄弟來還去，獨倚欄干花露中。"],"s":"mixed","f":"simp"},{"i":"50bf0399-b363-44e5-9114-37f2db253467","t":"同州南亭陪劉侍郎送劉先輩","a":"趙嘏","d":"唐","g":"短诗","p":["處處雲隨晚望開，洞庭秋水管絃來。","謝公待醉消離恨，莫惜臨川酒一杯。"],"s":"trad","f":"simp"}]