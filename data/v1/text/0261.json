[{"i":"45cf8159-2370-4185-988e-5cd82037d543","t":"春游樂","a":"施肩吾","d":"唐","g":"短诗","p":["一年三百六十日，賞心那似春中物。","草迷曲塢花滿園，東家少年西家出。"],"s":"mixed","f":"simp"},{"i":"375b5e8e-cd0d-4430-9d9d-7159f41684f5","t":"仙客歸鄉詞二首 一","a":"施肩吾","d":"唐","g":"短诗","p":["六合八荒游未半，子孫零落暫歸來。","井邊不認捎雲樹，多是門人在後栽。"],"s":"mixed","f":"simp"},{"i":"9ee0a4f1-c368-4588-8b35-957b2a3d609e","t":"仙客歸鄉詞二首 二","a":"施肩吾","d":"唐","g":"短诗","p":["洞中日月洞中仙，不算離家是幾年。","出郭始知人代變，又須拋却古時錢。"],"s":"mixed","f":"simp"},{"i":"e534c272-e750-4509-b183-60894334a6e1","t":"雲州飲席","a":"施肩吾","d":"唐","g":"短诗","p":["酒腸雖滿少歡情，身在雲州望帝城。","巡次合當誰令改，先須爲我打還京。"],"s":"mixed","f":"simp"},{"i":"f3847ab3-6a25-4df2-b5a1-179c541e2170","t":"戲贈李主簿","a":"施肩吾","d":"唐","g":"短诗","p":["官罷江南客恨遙，二年空被酒中消。","不知暗數春游處，偏憶揚州第幾橋。"],"s":"mixed","f":"simp"},{"i":"f1541605-2557-4216-93de-471947e3bd3c","t":"春詞","a":"施肩吾","d":"唐","g":"短诗","p":["黃鳥啼多春日高，紅芳開盡井邊桃。","美人手暖裁衣易，片片輕雲落剪刀。"],"s":"trad","f":"simp"},{"i":"b42e6e48-4c94-45ee-8595-5e6bd8eb2449","t":"題景上人山門","a":"施肩吾","d":"唐","g":"短诗","p":["水有青蓮沙有金，老僧於此獨觀心。","愁人欲寄中峰宿，只恐白猨啼夜深。"],"s":"mixed","f":"simp"},{"i":"00ae33b4-839a-485e-b7bc-08dabc2b361d","t":"妓人殘粧詞","a":"施肩吾","d":"唐","g":"短诗","p":["雲髻已收金鳳皇，巧勻輕黛約殘粧。","不知昨夜新歌響，猶在誰家繞畫梁。"],"s":"trad","f":"simp"},{"i":"f4edd187-408c-42fc-a01f-e1561bbe8393","t":"臨水亭","a":"施肩吾","d":"唐","g":"短诗","p":["只怪素亭黏黛色，溪煙爲我染莓苔。","欲知源上春風起，看取桃花逐水來。"],"s":"mixed","f":"simp"},{"i":"eea4a211-6ab1-47b2-8e44-1a5c0375b89f","t":"聽范玄長吟","a":"施肩吾","d":"唐","g":"短诗","p":["聲聲扣出碧琅玕，能使秋猨欲呌難。","詩興未窮心更遠，手垂青拂向雲看。"],"s":"mixed","f":"simp"},{"i":"e6bc6d3d-576c-40c2-8736-922e8f15d9e0","t":"觀葉生畫花","a":"施肩吾","d":"唐","g":"短诗","p":["心竅玲瓏貌亦奇，榮枯只在手中移。","今朝故向霜天裏，點破繁花四五枝。"],"s":"mixed","f":"simp"},{"i":"f4d0e8c4-703d-4ffe-8eb3-fa0528a36bc9","t":"洗丹沙詞","a":"施肩吾","d":"唐","g":"短诗","p":["千淘萬洗紫光攢，夜火熒熒照玉盤。","恐是麻姑殘米粒，不曾將與世人看。"],"s":"trad","f":"simp"},{"i":"684ce1ad-fd44-4653-9510-57fd45d8fd6e","t":"長安春夜吟","a":"施肩吾","d":"唐","g":"短诗","p":["露盤滴時河漢微，美人燈下裁春衣。","蟾蜍東去鵲南飛，芸香省中郎不歸。"],"s":"trad","f":"simp"},{"i":"c4881382-e972-4a80-a60c-dd0330570799","t":"自述","a":"施肩吾","d":"唐","g":"短诗","p":["篋貯靈砂日日看，欲成仙法脫身難。","不知誰向交州去，爲謝羅浮葛長官。"],"s":"mixed","f":"simp"},{"i":"5a907177-961e-41ab-a70a-77fd8d115b64","t":"少年行","a":"施肩吾","d":"唐","g":"短诗","p":["醉騎白馬走空衢，惡少皆稱電不如。","五鳳街頭新勒轡，半垂衫袖揖金吾。"],"s":"trad","f":"simp"},{"i":"30fc8128-f699-4222-8d61-407c7cd44c23","t":"越中遇寒食","a":"施肩吾","d":"唐","g":"短诗","p":["去歲清明霅溪口，今朝寒食鏡湖西。","信知天地心不易，還有子規依舊啼。"],"s":"trad","f":"simp"},{"i":"08767d13-f705-47d2-8faf-00bd32e63bf9","t":"贈採藥叟","a":"施肩吾","d":"唐","g":"短诗","p":["老去唯將藥裹行，無家無累一身輕。","却教年少取書卷，小字燈前鬬眼明。"],"s":"mixed","f":"simp"},{"i":"d8d8e95f-b5d5-4887-afb2-475e9032210d","t":"清夜憶仙宮子","a":"施肩吾","d":"唐","g":"短诗","p":["夜靜門深紫洞煙，孤行獨坐憶神仙。","三清宫裏月如晝，十二宫樓何處眠。"],"s":"mixed","f":"simp"},{"i":"3a26677c-2a40-47dc-a6f7-392d9066a3fd","t":"江南怨","a":"施肩吾","d":"唐","g":"短诗","p":["愁見橋邊荇葉新，蘭舟枕水楫生塵。","從來不是無蓮采，十頃蓮塘賣與人。"],"s":"mixed","f":"simp"},{"i":"e09334e8-ee6e-427c-bb5a-7edd8742c48c","t":"送絕塵子歸舊隱二首 一","a":"施肩吾","d":"唐","g":"短诗","p":["雲水千重繞洞門，獨歸何處是桃源？仙方不用隨身去，留與人間老子孫。"],"s":"trad","f":"simp"},{"i":"b5e4cab2-4139-4b84-a049-77938896159c","t":"送絕塵子歸舊隱二首 二","a":"施肩吾","d":"唐","g":"短诗","p":["班藤爲杖草爲衣，萬壑千峰獨自歸。","縱令相憶誰相報，桂樹巖邊人信稀。"],"s":"mixed","f":"simp"},{"i":"155c42c8-4976-4d67-84f6-8ebe31854bff","t":"送裴秀才歸淮南","a":"施肩吾","d":"唐","g":"短诗","p":["怪來頻起詠刀頭，楓葉枝邊一夕秋。","又向江南別才子，却將風景過揚州。"],"s":"mixed","f":"simp"},{"i":"1e7e33fe-c181-4586-95c7-7dc4d206646d","t":"錢塘渡口","a":"施肩吾","d":"唐","g":"短诗","p":["天塹茫茫連沃焦，秦皇何事不安橋。","錢塘渡口無錢納，已失西興兩信潮。"],"s":"trad","f":"simp"},{"i":"b3d48da5-66bc-4247-8687-d9649ccab279","t":"春日宴徐君池亭","a":"施肩吾","d":"唐","g":"短诗","p":["暫憑春酒換愁顏，今日應須醉始還。","池上有門君莫掩，從教野客見青山。"],"s":"trad","f":"simp"},{"i":"e2234542-d763-4045-a5c1-bf07e5419499","t":"山中送友人","a":"施肩吾","d":"唐","g":"短诗","p":["欲折楊枝別恨生，一重枝上一啼鶯。","亂山重疊雲相掩，君向亂山何處行。"],"s":"trad","f":"simp"},{"i":"b0a2a12a-bca3-443c-b823-b1c95333faea","t":"寄王少府","a":"施肩吾","d":"唐","g":"短诗","p":["采松仙子徒銷日，喫菜山僧枉過生。","多謝藍田王少府，人間詩酒最關情。"],"s":"mixed","f":"simp"},{"i":"8a9e9566-7722-4675-98d4-e62c98fedc25","t":"贈女道士鄭玉華二首 一","a":"施肩吾","d":"唐","g":"短诗","p":["玄髮新簪碧藕花，欲添肌雪餌紅砂。","世間風景那堪戀，長笑劉郎漫憶家。"],"s":"trad","f":"simp"},{"i":"1a811379-9526-4288-bde8-5c1e150eb96a","t":"贈女道士鄭玉華二首 二","a":"施肩吾","d":"唐","g":"短诗","p":["明鏡湖中休采蓮，却師阿母學神仙。","朱絲誤落青囊裏，猶是箜篌第幾弦。"],"s":"mixed","f":"simp"},{"i":"3d03ea4b-49bf-4926-a4fc-06dfd459ae36","t":"寄西臺李侍御","a":"施肩吾","d":"唐","g":"短诗","p":["二千餘里採瓊瓌，到處傷心瓦礫堆。","唯有繡衣周柱史，獨將珠玉挂西臺。"],"s":"mixed","f":"simp"},{"i":"b71efa80-e3d4-490a-baf6-89375f9f1bd8","t":"贈凌仙姥","a":"施肩吾","d":"唐","g":"短诗","p":["阿母從天降幾時，前朝惟有漢皇知。","仙桃不啻三回熟，飽見東方一小兒。"],"s":"trad","f":"simp"},{"i":"950caaac-2d3c-4169-85ef-ddbb81fb6acf","t":"晚春送王秀才游剡川","a":"施肩吾","d":"唐","g":"短诗","p":["越山花去剡藤新，才子風光不厭春。","第一莫尋溪上路，可憐仙女愛迷人。"],"s":"mixed","f":"simp"},{"i":"39e200db-3aee-4026-996e-b8379f83d935","t":"馮上人院","a":"施肩吾","d":"唐","g":"短诗","p":["擾擾凡情逐水流，世間多喜復多憂。","一回行到馮公院，便欲令人百事休。"],"s":"trad","f":"simp"},{"i":"c222712b-85bd-4c71-9f32-9dc99fe85e71","t":"金吾詞","a":"施肩吾","d":"唐","g":"短诗","p":["行擁朱輪錦幨兒，望仙門外叱金羈。","染鬚偷嫩無人覺，唯有平康小婦知。"],"s":"trad","f":"simp"},{"i":"bd53787f-12c7-4a4f-a8ab-a65f59027481","t":"觀舞女","a":"施肩吾","d":"唐","g":"短诗","p":["纏紅結紫畏風吹，嫋娜初回弱柳枝。","買笑未知誰是主，萬人心逐一人移。"],"s":"trad","f":"simp"},{"i":"63bc48e0-ff51-4649-8291-5602845d119b","t":"鄠縣村居","a":"施肩吾","d":"唐","g":"短诗","p":["欲住村西日日慵，上山無水引高蹤。","誰能求得秦皇術，爲我先驅紫閣峰。"],"s":"mixed","f":"simp"},{"i":"b0ef18d8-3faf-4ce6-9fb8-f9dd3c965f8f","t":"酬周秀才","a":"施肩吾","d":"唐","g":"短诗","p":["三展蜀牋皆郢曲，我心珍重甚瓊瑤。","應緣水府龍神睡，偷得蛟人五色綃。"],"s":"trad","f":"simp"},{"i":"0a3a0dc5-9bc8-467d-bf42-bc33440e35aa","t":"旅次文水縣喜遇李少府","a":"施肩吾","d":"唐","g":"短诗","p":["爲君三日廢行程，一縣官人是酒朋。","共憶襄陽同醉處，尚書坐上納銀觥。"],"s":"mixed","f":"simp"},{"i":"01fadbde-1e4c-4a5f-bd20-989ee319f27e","t":"夏雨後題青荷蘭若","a":"施肩吾","d":"唐","g":"短诗","p":["僧舍清涼竹樹新，初經一雨洗諸塵。","微風忽起吹蓮葉，青玉盤中瀉水銀。"],"s":"trad","f":"simp"},{"i":"6b6e7fea-f41c-40ab-8aa4-adbec5aba2ff","t":"途中逢少女","a":"施肩吾","d":"唐","g":"短诗","p":["身倚西門笑向東，牡丹初折一枝紅。","市頭日賣千般鏡，知落誰家新匣中。"],"s":"trad","f":"simp"},{"i":"7f4410bc-f0c0-4081-873d-de83848f5e68","t":"山中翫白鹿","a":"施肩吾","d":"唐","g":"短诗","p":["繞洞尋花日易銷，人間無路得相招。","呦呦白鹿毛如雪，踏我桃花過石橋。"],"s":"trad","f":"simp"},{"i":"30354055-e9c3-434f-908b-d96de447bfdb","t":"山居樂","a":"施肩吾","d":"唐","g":"短诗","p":["鸞鶴每於松下見，笙歌常向坐中聞。","手持十節龍頭杖，不指虛空即指雲。"],"s":"trad","f":"simp"},{"i":"c003a336-7adb-4458-9192-31b5b7a3861d","t":"襄陽曲","a":"施肩吾","d":"唐","g":"短诗","p":["大堤女兒郎莫尋，三三五五結同心。","清晨對鏡理容色，意欲取郎千萬金。"],"s":"trad","f":"simp"},{"i":"8c4f231c-c8fc-4b84-ba6a-30898c4048fa","t":"望夫詞二首 一","a":"施肩吾","d":"唐","g":"短诗","p":["看看北鴈又南飛，薄倖征夫久不歸。","蟢子到頭無信處，凡經幾度上人衣。"],"s":"trad","f":"simp"},{"i":"48293382-6e69-433d-a221-695c4b1d3ff3","t":"望夫詞二首 二","a":"施肩吾","d":"唐","g":"短诗","p":["何事經年斷書信，愁聞遠客說風波。","西家還有望夫伴，一種淚痕兒最多。"],"s":"trad","f":"simp"},{"i":"c9e97469-e8bc-4263-8f5a-c60a53ce2b0b","t":"少婦游春詞","a":"施肩吾","d":"唐","g":"短诗","p":["簇錦攢花鬬勝遊，萬人行處最風流。","無端自向春園裏，笑摘青梅呌阿侯。"],"s":"mixed","f":"simp"},{"i":"e6587440-6531-42a2-a8c8-42a82bb2cb23","t":"折柳枝","a":"施肩吾","d":"唐","g":"短诗","p":["傷見路邊楊柳春，一重折盡一重新。","今年還折去年處，不送去年離別人。"],"s":"mixed","f":"simp"},{"i":"29d4bd71-7411-4594-afc3-93696ef28b25","t":"歸將吟","a":"施肩吾","d":"唐","g":"短诗","p":["百戰放歸成老翁，餘生得出死人中。","今朝授敕三回舞，兩賜青娥又拜公。"],"s":"trad","f":"simp"},{"i":"7447fabc-f3c7-4a72-8f7e-d12c32b76694","t":"惜花詞","a":"施肩吾","d":"唐","g":"短诗","p":["千樹繁紅遶碧泉，正宜尊酒對芳年。","明朝欲飲還來此，只怕春風却在前。"],"s":"mixed","f":"simp"},{"i":"a6f7bbd5-76e8-444b-aa2b-c116f09b383d","t":"拋纏頭詞","a":"施肩吾","d":"唐","g":"短诗","p":["翠娥初罷繞梁詞，又見雙鬟對舞時。","一抱紅羅分不足，參差裂破鳳皇兒。"],"s":"trad","f":"simp"},{"i":"79fcfad1-ca4c-4d7d-9a4d-c90efdd58ed7","t":"望騎馬郎","a":"施肩吾","d":"唐","g":"短诗","p":["碧蹄新壓步初成，玉色郎君弄影行。","賺殺唱歌樓上女，伊州誤作石州聲。"],"s":"trad","f":"simp"},{"i":"0e26dafd-08ac-40b6-a324-0132945e95c2","t":"春日錢塘雜興二首 一","a":"施肩吾","d":"唐","g":"短诗","p":["酒姥溪頭桑褭褭，錢塘郭外柳𣯶𣯶。","路逢鄰婦遙相問，小小如今學養蠶。"],"s":"trad","f":"simp"},{"i":"1cbc723f-91d5-4036-8f9d-5ede9a06a1d1","t":"春日錢塘雜興二首 二","a":"施肩吾","d":"唐","g":"短诗","p":["西鄰年少問東鄰，柳岸花隄幾處新。","昨夜雨多春水闊，隔江桃葉喚何人。"],"s":"trad","f":"simp"},{"i":"abed2cda-b3ad-4603-84b7-87caf8d455db","t":"翫手植松","a":"施肩吾","d":"唐","g":"短诗","p":["却思毫末栽松處，青翠纔將衆草分。","今日散材遮不得，看看氣色欲凌雲。"],"s":"mixed","f":"simp"},{"i":"f8a8e67b-0b4a-4039-be48-0738bfe434f4","t":"夜笛詞","a":"施肩吾","d":"唐","g":"短诗","p":["皎潔西樓月未斜，笛聲寥亮入東家。","却令燈下裁衣婦，誤翦同心一半花。"],"s":"mixed","f":"simp"},{"i":"9a5cd3d4-b0de-40af-b7bd-798ef2f59245","t":"贈鄭倫吹鳳管","a":"施肩吾","d":"唐","g":"短诗","p":["喃喃解語鳳皇兒，曾聽棃園竹裏吹。","誰謂五陵年少子，還將此曲暗相隨。"],"s":"mixed","f":"simp"},{"i":"a31eb4b4-a38b-4c62-81d7-f60c100d22b8","t":"蜀茗詞","a":"施肩吾","d":"唐","g":"短诗","p":["越椀初盛蜀茗新，薄煙輕處攪來勻。","山僧問我將何比，欲道瓊漿却畏嗔。"],"s":"mixed","f":"simp"},{"i":"4d9a4ac9-b6ec-4c16-acfe-27f8f452756f","t":"春霽","a":"施肩吾","d":"唐","g":"短诗","p":["煎茶水裏花千片，候客亭中酒一樽。","獨對春光還寂寞，羅浮道士忽敲門。"],"s":"mixed","f":"simp"},{"i":"3e79ad0d-dd06-4283-829f-4f3fda2a2adf","t":"諷山雲","a":"施肩吾","d":"唐","g":"短诗","p":["閑雲生葉不生根，常被重重蔽石門。","賴有風簾能埽蕩，滿山晴日照乾坤。"],"s":"trad","f":"simp"},{"i":"c3e64449-ebb9-4dc3-b16b-b8d735311321","t":"日晚歸山詞","a":"施肩吾","d":"唐","g":"短诗","p":["虎跡新逢雨後泥，無人家處洞邊溪。","獨行歸客晚山裏，賴有鷓鴣臨路岐。"],"s":"mixed","f":"simp"},{"i":"81a94106-b91e-4d2f-b7e1-5b733d4fb80b","t":"翫花詞","a":"施肩吾","d":"唐","g":"短诗","p":["今朝造化使春風，開拆西施面上紅。","竟日眼前猶不足，數株舁入寸心中。"],"s":"trad","f":"simp"},{"i":"5ab875bd-ef9f-444e-af55-48a9704db121","t":"長安早春","a":"施肩吾","d":"唐","g":"短诗","p":["報花消息是春風，未見先教何處紅。","想得芳園十餘日，萬家身在畫屏中。"],"s":"trad","f":"simp"},{"i":"d9188b70-edb6-41c4-b390-b6cdacdd7bb6","t":"再酬李先輩","a":"施肩吾","d":"唐","g":"短诗","p":["清辭再發郢人家，字字新移錦上花。","能使龍宮買綃女，低回不敢織輕霞。"],"s":"mixed","f":"simp"},{"i":"65e1be7d-78ea-4488-9c9e-9390be755430","t":"寄隱者","a":"施肩吾","d":"唐","g":"短诗","p":["路絕空林無處問，幽奇山水不知名。","松門拾得一片屐，知是高人向此行。"],"s":"trad","f":"simp"},{"i":"2b2e8111-f248-4d9c-b444-0876fbd460ab","t":"寄四明山子","a":"施肩吾","d":"唐","g":"短诗","p":["高棲只在千峰裏，塵世望君那得知。","長憶去年風雨夜，向君窗下聽猨時。"],"s":"mixed","f":"simp"},{"i":"348d8d23-941e-4829-8b3d-5a0227d7e66d","t":"觀美人","a":"施肩吾","d":"唐","g":"短诗","p":["漆點雙眸鬢繞蟬，長留白雪占胸前。","愛將紅袖遮嬌笑，往往偷開水上蓮。"],"s":"mixed","f":"simp"},{"i":"660b96e7-bbf6-4e09-a51e-55e9c1b1dfd9","t":"收妝詞","a":"施肩吾","d":"唐","g":"短诗","p":["斜月朧朧照半牀，煢煢孤妾嬾收妝。","燈前再覽青銅鏡，枉插金釵十二行。"],"s":"mixed","f":"simp"},{"i":"80621b4a-d479-47bb-9a95-7e3e234a1030","t":"仙女詞","a":"施肩吾","d":"唐","g":"短诗","p":["仙女羣中名最高，曾看王母種仙桃。","手題金簡非凡筆，道是天邊玉兔毛。"],"s":"mixed","f":"simp"},{"i":"ab9a518b-c0fd-4d4f-91ae-f8fa7216835f","t":"仙翁詞","a":"施肩吾","d":"唐","g":"短诗","p":["世間無遠可爲游，六合朝行夕已周。","壇上夜深風雨靜，小仙乘月繫蒼虯。"],"s":"mixed","f":"simp"},{"i":"a6669eca-ad3a-4012-a6d6-0304b37296de","t":"遇李山人","a":"施肩吾","d":"唐","g":"短诗","p":["游山遊水幾千重，二十年中一度逢。","別易會難君且住，莫交青竹化爲龍。"],"s":"mixed","f":"simp"},{"i":"97dbc518-4324-4420-a216-ae2fcef143f1","t":"同張鍊師溪行","a":"施肩吾","d":"唐","g":"短诗","p":["青溪道士紫霞巾，洞裏仙家舊是鄰。","每見桃花逐流水，無回不憶武陵人。"],"s":"mixed","f":"simp"},{"i":"1a6062dc-c410-404b-89b3-a1f055ac8d01","t":"桃源詞二首 一","a":"施肩吾","d":"唐","g":"短诗","p":["夭夭花裏千家住，總爲當時隱暴秦。","歸去不論無舊識，子孫今亦是他人。"],"s":"mixed","f":"simp"},{"i":"f24d1909-30fd-4c81-a969-41fdb58c0a43","t":"桃源詞二首 二","a":"施肩吾","d":"唐","g":"短诗","p":["秦世老翁歸漢世，還同白鶴返遼城。","縱令記得山川路，莫問當時州縣名。"],"s":"trad","f":"simp"},{"i":"ca19cfe7-213a-4934-b694-5d5233c1fd89","t":"送道友遊山","a":"施肩吾","d":"唐","g":"短诗","p":["欲駐如今未老形，萬重山上九芝清。","君今若問採芝路，踏水踏雲攀杳冥。"],"s":"trad","f":"simp"},{"i":"3843f4c7-eb15-43fc-a850-79de3944f7e9","t":"贈王屋劉道士","a":"施肩吾","d":"唐","g":"短诗","p":["小有洞中長住客，大羅天下後來仙。","出門即是尋常處，未可還它跨鶴鞭。"],"s":"trad","f":"simp"},{"i":"d225df26-9bec-447b-8595-c2d8f668da4d","t":"謝自然升仙","a":"施肩吾","d":"唐","g":"短诗","p":["分明得道謝自然，古來漫說尸解仙。","如花年少一女子，身騎白鶴遊青天。"],"s":"mixed","f":"simp"},{"i":"c3eab095-e09a-42b3-bcea-f16121db3bc8","t":"秋吟獻李舍人","a":"施肩吾","d":"唐","g":"短诗","p":["腸結愁根酒不消，新驚白髮長愁苗。","主司儻許題名姓，筆下看成度海橋。"],"s":"trad","f":"simp"},{"i":"3fdf511e-1350-4034-ac6f-a6ed85ec5270","t":"山中喜靜和子見訪","a":"施肩吾","d":"唐","g":"短诗","p":["絕壁深溪無四鄰，每逢猨鶴即相親。","小奴驚出垂藤下，山犬今朝吠一人。"],"s":"trad","f":"simp"},{"i":"7b9733e3-265c-4c5c-bd04-e82f013a7e27","t":"春日題羅處士山舍","a":"施肩吾","d":"唐","g":"短诗","p":["亂疊千峰掩翠微，高人愛此自忘機。","春風若埽階前地，便是山花帶錦飛。"],"s":"trad","f":"simp"},{"i":"8aa3624d-3b72-475c-9cbf-dc3a1d37e3c5","t":"訪松嶺徐鍊師","a":"施肩吾","d":"唐","g":"短诗","p":["千仞峰頭一謫仙，何時種玉已成田？開經猶在松陰裏，讀到南華第幾篇。"],"s":"mixed","f":"simp"},{"i":"84c4908d-4031-4c39-86be-9ae366e11a5e","t":"江南織綾詞","a":"施肩吾","d":"唐","g":"短诗","p":["卿卿買得越人絲，貪弄金梭嬾畫眉。","女伴能來看新𥷨，鴛鴦正欲上花枝。"],"s":"trad","f":"simp"},{"i":"b6c0e274-6067-467a-93ef-3b8fcaaf5afa","t":"宿蘭若","a":"施肩吾","d":"唐","g":"短诗","p":["聽鐘投宿入孤煙，巖下病僧猶坐禪。","獨夜客心何處是，秋雲影裏一燈然。"],"s":"mixed","f":"simp"},{"i":"60c970c2-c95f-4040-af45-0ea89f1d5b19","t":"題禪僧院","a":"施肩吾","d":"唐","g":"短诗","p":["棲禪枝畔數花新，飛作琉璃池上塵。","谷鳥自啼猨自呌，不能愁得定中人。"],"s":"trad","f":"simp"},{"i":"a0990c21-e4b8-4a34-81d2-23811bcdd1ca","t":"送絕粒僧","a":"施肩吾","d":"唐","g":"短诗","p":["碧洞青蘿不畏深，免將飢渴累禪心。","若期野客來相訪，一室無煙何處尋。"],"s":"trad","f":"simp"},{"i":"b9a16114-a074-419e-8ab6-ed58deded080","t":"早春游曲江","a":"施肩吾","d":"唐","g":"短诗","p":["芳處亦將枯槁同，應緣遭化未施功。","羲和若擬動鑪鞴，先鑄曲江千樹紅。"],"s":"mixed","f":"simp"},{"i":"4541b61a-8fbe-4183-855d-edd0769eedcf","t":"佳人覽鏡","a":"施肩吾","d":"唐","g":"短诗","p":["每坐臺前見玉容，今朝不與昨朝同。","良人一夜出門宿，減却桃花一半紅。"],"s":"mixed","f":"simp"},{"i":"f107de5e-2a83-4703-be27-be868c35a96f","t":"遇王山人","a":"施肩吾","d":"唐","g":"短诗","p":["每欲尋君千萬峰，豈知人世也相逢。","一瓢遺却在何處，應挂天台最老松。"],"s":"mixed","f":"simp"},{"i":"3e13a382-6542-48d9-b0de-e55299a87070","t":"遇醉道士","a":"施肩吾","d":"唐","g":"短诗","p":["霞帔尋常帶酒眠，路傍疑是酒中仙。","醉來不住人家宿，多向遠山松月邊。"],"s":"trad","f":"simp"},{"i":"b6bc3e4b-f9b7-4739-a06b-53d1dd2d940d","t":"送人歸台州","a":"施肩吾","d":"唐","g":"短诗","p":["莫驅歸騎且徘徊，更遣離情四五桮。","醉後不憂迷客路，遙看瀑布識天台。"],"s":"trad","f":"simp"},{"i":"836b9fad-633e-4c30-8116-3edea8545daa","t":"贈施仙姑","a":"施肩吾","d":"唐","g":"短诗","p":["縹緲吾家一女仙，冰容雖小不知年。","有時頻夜看明月，心在嫦娥几案邊。"],"s":"trad","f":"simp"},{"i":"5127a970-c181-4243-8446-e858346e1e67","t":"山院觀花","a":"施肩吾","d":"唐","g":"短诗","p":["初來唯見空樹枝，今朝滿院花如雪。","門前爲報諸少年，明日來遲不堪折。"],"s":"mixed","f":"simp"},{"i":"6cb62e9d-7365-459d-aaea-450ded89d0f6","t":"經桃花夫人廟","a":"施肩吾","d":"唐","g":"短诗","p":["誰能枉駕入荒榛，隨例形相土木身。","不及連山種桃樹，花開猶得識夫人。"],"s":"trad","f":"simp"},{"i":"04f37642-924d-4b6d-9054-3992554647c7","t":"代農叟吟","a":"施肩吾","d":"唐","g":"短诗","p":["且將一笑悅豐年，漸老那能日日眠。","引客特來山地上，坐看秋水落紅蓮。"],"s":"trad","f":"simp"},{"i":"86001a9b-8dee-4f09-b7f0-9fbf765b7600","t":"下第春遊","a":"施肩吾","d":"唐","g":"短诗","p":["羈情含蘖復含辛，淚眼看花只似塵。","天遣春風領春色，不教分付與愁人。"],"s":"mixed","f":"simp"},{"i":"d4231d07-fee5-47cd-91a7-5ff8177e9cc0","t":"送僧遊越","a":"施肩吾","d":"唐","g":"短诗","p":["麻衣年少雪爲顏，却笑孤雲未是閑。","此去若逢花柳月，棲禪莫向苧蘿山。"],"s":"mixed","f":"simp"},{"i":"aef42aa2-be0d-46e7-a150-58e7a711b3c1","t":"遇越州賀仲宣","a":"施肩吾","d":"唐","g":"短诗","p":["君在鏡湖西畔住，四明山下莫經春。","門前幾箇采蓮女，欲泊蓮舟無主人。"],"s":"mixed","f":"simp"},{"i":"6daaee2a-4356-41e6-a6cc-2aa8e749fb37","t":"江南積雨歎","a":"施肩吾","d":"唐","g":"短诗","p":["人厭爲霖水毀溪，牀邊生菌路成泥。","雨師一日三回到，棟裏閑雲豈得棲。"],"s":"mixed","f":"simp"},{"i":"0b66f80f-9b47-472e-9685-ee18aa72835a","t":"雲中道上作","a":"施肩吾","d":"唐","g":"短诗","p":["羊馬羣中覓人道，鴈門關外絕人家。","昔時聞有雲中郡，今日無雲空見沙。"],"s":"mixed","f":"simp"},{"i":"c1c6e30a-c36a-45bb-8838-2cceb53c534b","t":"同諸隱者夜登四明山","a":"施肩吾","d":"唐","g":"短诗","p":["半夜尋幽上四明，手攀松桂觸雲行。","相呼已到無人境，何處玉簫吹一聲。"],"s":"trad","f":"simp"},{"i":"8de8174f-a2c4-4fa7-bf6a-9ca21cdd411f","t":"戲鄭申府","a":"施肩吾","d":"唐","g":"短诗","p":["年少鄭郎那解愁，春來閑臥酒家樓。","胡姬若擬邀他宿，挂却金鞭繫紫騮。"],"s":"mixed","f":"simp"},{"i":"2d1e5e18-57ba-4566-b71b-5808e0ecc718","t":"宿干越亭","a":"施肩吾","d":"唐","g":"短诗","p":["琵琶洲上人行絕，干越亭中客思多。","月滿秋江山冷落，不知誰問夜如何。"],"s":"mixed","f":"simp"}]