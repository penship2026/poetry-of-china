[{"i":"2b730ae2-7e32-4eb7-9b37-e1844e83a743","t":"調笑令 四","a":"王建","d":"唐","g":"短诗","p":["楊柳，楊柳，日暮白沙渡口。","船頭江水茫茫，商人少婦斷腸。","腸斷，腸斷，鷓鴣夜飛失伴。"],"s":"trad","f":"simp"},{"i":"125198bd-4bfd-43ef-ae9c-74bbd8fc114e","t":"調笑令","a":"戴叔倫","d":"唐","g":"短诗","p":["邊草，邊草，邊草盡來兵老。","山南山北雪晴，千里萬里月明。","明月，明月，胡笳一聲愁絕。"],"s":"mixed","f":"simp"},{"i":"45868452-c3f4-449b-be00-11027f4d11c5","t":"紇那曲 一","a":"劉禹錫","d":"唐","g":"短诗","p":["楊柳鬱青青，竹枝無限情。","同郎一回顧，聽唱紇那聲。"],"s":"trad","f":"simp"},{"i":"9f443629-464c-4f44-aab8-ebd11e96e133","t":"紇那曲 二","a":"劉禹錫","d":"唐","g":"短诗","p":["蹋曲興無窮，調同辭不同。","願郎千萬壽，長作主人翁。"],"s":"trad","f":"simp"},{"i":"f98769ab-7570-403c-9cc4-b0a37f53b128","t":"憶江南 一","a":"劉禹錫","d":"唐","g":"短诗","p":["春去也，多謝洛城人。","弱柳從風疑舉袂，叢蘭裛露似霑巾，獨坐亦含嚬。"],"s":"trad","f":"simp"},{"i":"8ba48f1b-7fa7-4af7-b4ee-dabca81e4aa6","t":"憶江南 二","a":"劉禹錫","d":"唐","g":"短诗","p":["春去也，共惜豔陽年。","猶有桃花流水上，無辭竹葉醉尊前，惟待見青天。"],"s":"trad","f":"simp"},{"i":"fe80a80e-47ab-4df7-9caf-38696df0a6d2","t":"瀟湘神 一","a":"劉禹錫","d":"唐","g":"短诗","p":["湘水流，湘水流，九疑雲物至今愁。","若問二妃何處所，零陵芳草露中秋。"],"s":"trad","f":"simp"},{"i":"bb5def99-f902-458f-be0a-0cf05a46f34b","t":"瀟湘神 二","a":"劉禹錫","d":"唐","g":"短诗","p":["斑竹枝，斑竹枝，淚痕點點寄相思。","楚客欲聽瑤瑟怨，瀟湘深夜月明時。"],"s":"trad","f":"simp"},{"i":"d114e7b2-6988-42a2-9715-8bb1571d760d","t":"拋毬樂 一","a":"劉禹錫","d":"唐","g":"短诗","p":["五色繡團圓，登君玳瑁筵。","最宜紅燭下，偏稱落花前。","上客如先起，應須贈一船。"],"s":"trad","f":"simp"},{"i":"0e2e08eb-8931-40e3-94b8-3e0938dc9947","t":"拋毬樂 二","a":"劉禹錫","d":"唐","g":"短诗","p":["春早見花枝，朝朝恨發遲。","及看花落後，却憶未開時。","幸有拋毬樂，一杯君莫辭。"],"s":"mixed","f":"simp"},{"i":"90ad61e9-31b9-47da-8e98-880130a5bb2e","t":"花非花","a":"白居易","d":"唐","g":"短诗","p":["花非花，霧非霧，夜半來，天明去。","來如春夢不多時，去似朝雲無覓處。"],"s":"trad","f":"simp"},{"i":"0449a6d9-ad81-4cea-99d4-70018fc863a2","t":"憶江南 一","a":"白居易","d":"唐","g":"短诗","p":["江南好，風景舊曾諳。","日出江花紅勝火，春來江水綠如藍，能不憶江南。"],"s":"trad","f":"simp"},{"i":"4e8038d4-685d-47fe-a65f-3fb103a42f50","t":"憶江南 二","a":"白居易","d":"唐","g":"短诗","p":["江南憶，最憶是杭州。","山寺月中尋桂子，郡亭枕上看潮頭，何日更重遊。"],"s":"trad","f":"simp"},{"i":"23124f06-e77f-4e20-b28c-f848c1a7479d","t":"憶江南 三","a":"白居易","d":"唐","g":"短诗","p":["江南憶，其次憶吳宮。","吳酒一杯春竹葉，吳娃雙舞醉芙蓉，早晚得相逢。"],"s":"trad","f":"simp"},{"i":"9a0bfa8a-591e-437b-bd39-b5fdbd5b5bd2","t":"如夢令 一","a":"白居易","d":"唐","g":"短诗","p":["前度小花靜院，不比尋常時見。","見了又還休，愁却等閑分散。","腸斷，腸斷，記取釵橫鬢亂。"],"s":"mixed","f":"simp"},{"i":"03c21a01-73a7-4bb0-b5aa-0852c8fce6fb","t":"如夢令 二","a":"白居易","d":"唐","g":"短诗","p":["落月西窗驚起，好箇怱怱些子。","鬒鬢嚲輕鬆，凝了一雙秋水。","告你，告你，休向人間整理。"],"s":"trad","f":"simp"},{"i":"cdaa4410-880c-4830-b7ef-d770ecdc28cc","t":"如夢令 三","a":"白居易","d":"唐","g":"短诗","p":["頻日雅歡幽會，打得來來越曬。","說著暫分飛，蹙損一雙眉黛。","無奈，無奈，兩箇心兒總待。"],"s":"trad","f":"simp"},{"i":"a4c60d0e-3945-4461-a9e1-d1d025227880","t":"長相思 一","a":"白居易","d":"唐","g":"短诗","p":["汴水流，泗水流，流到瓜洲古渡頭，吳山點點愁。","思悠悠，恨悠悠，恨到歸時方始休，月明人倚樓。"],"s":"trad","f":"simp"},{"i":"854a4e93-dc1b-4bde-a05c-d647097f9dcc","t":"長相思 二","a":"白居易","d":"唐","g":"短诗","p":["深畫眉，淺畫眉，蟬鬢鬅鬙雲滿衣，陽臺行雨回。","巫山高，巫山低，暮雨瀟瀟郎不歸，空房獨守時。"],"s":"trad","f":"simp"},{"i":"ad3ff46e-1956-472a-9a70-d9f43d2084ba","t":"謫仙怨","a":"劉長卿","d":"唐","g":"短诗","p":["晴川落日初低，惆悵孤舟解攜。","鳥向平蕪遠近，人隨流水東西。","白雲千里萬里，明月前溪後溪。","獨恨長沙謫去，江潭春草萋萋。"],"s":"mixed","f":"simp"},{"i":"ba3d87f9-cdcb-4f70-ac65-b69464a62794","t":"廣謫仙怨","a":"竇弘餘","d":"唐","g":"短诗","p":["胡塵犯闕衝關，金輅提攜玉顏。","雲雨此時蕭散，君王何日歸還。","傷心朝恨暮恨，回首千山萬山。","獨望天邊初月，蛾眉猶自彎彎。"],"s":"trad","f":"simp"},{"i":"afdfbef0-2c07-4161-bc63-e5840e94a833","t":"廣謫仙怨","a":"康駢","d":"唐","g":"短诗","p":["晴山礙目橫天，綠疊君王馬前。","鑾輅西巡蜀國，龍顏東望秦川。","曲江魂斷芳草，妃子愁凝暮煙。","長笛此時吹罷，何言獨爲嬋娟。"],"s":"mixed","f":"simp"},{"i":"21360c26-9b3a-490b-a231-8fc91d7ceca7","t":"八六子","a":"杜牧","d":"唐","g":"古体","p":["洞房深，畫屏燈照，山色凝翠沈沈。","聽夜雨，冷滴芭蕉，驚斷紅窗好夢，龍煙細飄繡衾。","辭恩久歸長信，鳳帳蕭疎，椒殿閑扃。","輦路苔侵，繡簾垂，遲遲漏傳丹禁。","蕣華偷悴，翠鬟羞整，愁坐望處，金輿漸遠。","何時綵仗重臨，正消魂，梧桐又移翠陰。"],"s":"trad","f":"simp"},{"i":"d46a229e-476e-4696-bd0a-4a5a9f8fe6aa","t":"憶江南","a":"崔懷寶","d":"唐","g":"短诗","p":["平生願，願作樂中箏。","得近玉人纖手子，砑羅裙上放嬌聲，便死也爲榮。"],"s":"mixed","f":"simp"},{"i":"f8dc5127-3cd8-44b8-8be0-7474b3c50891","t":"閑中好","a":"鄭符","d":"唐","g":"短诗","p":["閑中好，盡日松爲侶。","此趣人不知，輕風度僧語。"],"s":"mixed","f":"simp"},{"i":"c4b63d22-e387-4bb6-9770-811082b02653","t":"閑中好","a":"段成式","d":"唐","g":"短诗","p":["閑中好，塵務不縈心。","坐對當窗木，看移三面陰。"],"s":"trad","f":"simp"},{"i":"2f87a7a6-f620-4d6c-a446-09fa9c0d8fbc","t":"閑中好","a":"張希復","d":"唐","g":"短诗","p":["閑中好，幽磬度聲遲。","卷上論題肇，畫盡僧姓支。"],"s":"mixed","f":"simp"},{"i":"d99e2f5e-ee89-4cd7-a863-57c59f6580c1","t":"南歌子 一","a":"溫庭筠","d":"唐","g":"短诗","p":["手裏金鸚鵡，胸前繡鳳凰。","偷眼暗形相。","不如從嫁與，作鴛鴦。"],"s":"mixed","f":"simp"},{"i":"49a955c2-6df5-4738-8cbb-92439838ae5d","t":"南歌子 二","a":"溫庭筠","d":"唐","g":"短诗","p":["似帶如絲柳，團酥握雪花。","簾卷玉鉤斜。","九衢塵欲暮，逐香車。"],"s":"trad","f":"simp"},{"i":"4079336c-10ee-4be9-b3e2-f441de49255a","t":"南歌子 三","a":"溫庭筠","d":"唐","g":"短诗","p":["倭墮低梳髻，連娟細掃眉。","終日兩相思。","爲君憔悴盡，百花時。"],"s":"mixed","f":"simp"},{"i":"584bfc0d-09cb-4658-ae15-bf501081ad0a","t":"南歌子 四","a":"溫庭筠","d":"唐","g":"短诗","p":["臉上金霞細，眉間翠鈿深。","欹枕覆鴛衾。","隔簾鸎百轉，感君心。"],"s":"trad","f":"simp"},{"i":"29d3df5c-6e64-422a-a069-15fd99d50250","t":"南歌子 五","a":"溫庭筠","d":"唐","g":"短诗","p":["撲蘂添黃子，呵花滿翠鬟。","鴛枕映屏山。","月明三五夜，對芳顏。"],"s":"trad","f":"simp"},{"i":"2408519c-0eef-4b3b-b96c-a1259ed1922e","t":"南歌子 六","a":"溫庭筠","d":"唐","g":"短诗","p":["轉盼如波眼，娉婷似柳腰。","花裏暗相招。","憶君腸欲斷，恨春宵。"],"s":"mixed","f":"simp"},{"i":"9e189e4f-276d-4a7e-8e00-8863c6147dd7","t":"南歌子 七","a":"溫庭筠","d":"唐","g":"短诗","p":["嬾拂鴛鴦枕，休縫翡翠裙。","羅帳罷爐熏。","近來心更切，爲思君。"],"s":"mixed","f":"simp"},{"i":"7f11f101-e336-46bd-abc2-85695fb6f265","t":"荷葉杯 一","a":"溫庭筠","d":"唐","g":"短诗","p":["一點露珠凝冷，波影，滿池塘。","綠莖紅豔兩相亂，腸斷，水風涼。"],"s":"trad","f":"simp"},{"i":"bc72eed6-4019-476d-931b-f188b00963c2","t":"荷葉杯 二","a":"溫庭筠","d":"唐","g":"短诗","p":["鏡水夜來秋月，如雪，采蓮時。","小娘紅粉對寒浪，惆悵，正思惟。"],"s":"mixed","f":"simp"},{"i":"4bbcb4bd-3d77-4200-8159-27a16d599c93","t":"荷葉杯 三","a":"溫庭筠","d":"唐","g":"短诗","p":["楚女欲歸南浦，朝雨，濕愁紅。","小船搖漾入花裏，波起，隔西風。"],"s":"mixed","f":"simp"},{"i":"8fedbcda-2e90-45b2-bca9-5ce76a39b0c6","t":"憶江南 一","a":"溫庭筠","d":"唐","g":"短诗","p":["千萬恨，恨極在天涯。","山月不知心裏事，水風空落眼前花，搖曳碧雲斜。"],"s":"mixed","f":"simp"},{"i":"d636903d-bd15-4d66-8198-e245421b2d43","t":"憶江南 二","a":"溫庭筠","d":"唐","g":"短诗","p":["梳洗罷，獨倚望江樓。","過盡千帆皆不是，斜暉脈脈水悠悠，腸斷白蘋洲。"],"s":"trad","f":"simp"},{"i":"3a3c48ce-3087-4345-9060-bcace431fa06","t":"蕃女怨 一","a":"溫庭筠","d":"唐","g":"短诗","p":["萬枝香雪開已遍，細雨雙燕。","鈿蟬箏，金雀扇，畫梁相見。","鴈門消息不歸來，又飛回。"],"s":"trad","f":"simp"},{"i":"2f47370d-d3b1-405d-822c-14cb1bccd6ff","t":"蕃女怨 二","a":"溫庭筠","d":"唐","g":"短诗","p":["磧南沙上驚鴈起，飛雪千里。","玉連環，金鏃箭，年年征戰。","畫樓離恨錦屏空，杏花紅。"],"s":"mixed","f":"simp"},{"i":"0347b7f5-9733-4661-94b3-d32e7b2e41c1","t":"遐方怨 一","a":"溫庭筠","d":"唐","g":"短诗","p":["憑繡檻，解羅幃。","未得君書，斷腸瀟湘春鴈飛。","不知征馬幾時歸。","海棠花謝也，雨霏霏。"],"s":"mixed","f":"simp"},{"i":"d8e18621-ec00-42be-88be-ead999a9b448","t":"遐方怨 二","a":"溫庭筠","d":"唐","g":"短诗","p":["花半拆，雨初晴。","未卷珠簾，夢殘惆悵聞曉鸎。","宿妝眉淺粉山橫。","約鬟鸞鏡裏，繡羅輕。"],"s":"mixed","f":"simp"},{"i":"2352b4ff-5ef8-4823-a9aa-c40b51317d91","t":"訴衷情","a":"溫庭筠","d":"唐","g":"短诗","p":["鸎語，花舞，春晝午，雨霏微。","金帶枕，宮錦，鳳凰帷。","柳弱燕交飛，依依。","遼陽音信稀，夢中歸。"],"s":"trad","f":"simp"},{"i":"09e2a67e-6769-40cb-8e77-5d3997fc0910","t":"定西番 一","a":"溫庭筠","d":"唐","g":"短诗","p":["漢使昔年離別，攀弱柳，折寒梅，上高臺。","千里玉關春雪，鴈來人不來。","羌笛一聲愁絕，月裴回。"],"s":"trad","f":"simp"},{"i":"8c9069ed-53b4-4a1d-a7ee-a8886755fe84","t":"定西番 二","a":"溫庭筠","d":"唐","g":"短诗","p":["海燕欲飛調羽，萱草綠，杏花紅，隔簾櫳。","雙鬢翠霞金縷，一枝春豔濃。","樓上月明三五，瑣窗中。"],"s":"trad","f":"simp"},{"i":"4335ddbc-1bb4-40a8-a1cc-7d54f28b9da7","t":"定西番 三","a":"溫庭筠","d":"唐","g":"短诗","p":["細雨曉鸎春晚，人似玉，柳如眉，正相思。","羅幕翠簾初卷，鏡中花一枝。","腸斷塞門消息，鴈來稀。"],"s":"trad","f":"simp"},{"i":"309d735a-1524-4b44-bdcd-fabcfa11b5de","t":"思帝鄉","a":"溫庭筠","d":"唐","g":"短诗","p":["花花，滿枝紅似霞。","羅袖畫簾腸斷，卓香車。","回面共人閑語，戰箆金鳳斜。","惟有阮郎春盡，不歸家。"],"s":"trad","f":"simp"},{"i":"013cb0b3-b1fa-4af0-90a4-7a9b726de72a","t":"酒泉子 一","a":"溫庭筠","d":"唐","g":"短诗","p":["花映柳條，閑向綠萍池上。","凭欄干，窺細浪，雨蕭蕭。","近來音信兩疎索，洞房空寂寞。","掩銀屏，垂翠箔，度春宵。"],"s":"mixed","f":"simp"},{"i":"b09b9100-ebd2-4273-bce3-ddd1e4aaa0c2","t":"酒泉子 二","a":"溫庭筠","d":"唐","g":"短诗","p":["日映紗窗，金鴨小屏山碧。","故鄉春，煙靄隔，背蘭釭。","宿妝惆悵倚高閣，千里雲影薄。","草初齊，花又落，燕雙飛。"],"s":"trad","f":"simp"},{"i":"b7cf2121-6dad-4ab1-87d5-617011d94aea","t":"酒泉子 三","a":"溫庭筠","d":"唐","g":"短诗","p":["楚女不歸，樓枕小河春水。","月孤明，風又起，杏花稀。","玉釵斜篸雲鬟重，裙上金縷鳳。","八行書，千里夢，鴈南飛。"],"s":"trad","f":"simp"},{"i":"2af81995-8280-4643-97c8-6338ac5b6823","t":"酒泉子 四","a":"溫庭筠","d":"唐","g":"短诗","p":["羅帶惹香，猶繫別時紅豆。","淚痕新，金縷舊，斷離腸。","一雙嬌燕語雕梁，還是去年時節。","綠楊濃，芳草歇，柳花狂。"],"s":"trad","f":"simp"},{"i":"5d0722d8-d700-4352-aa87-65ebb23e15a3","t":"玉蝴蝶","a":"溫庭筠","d":"唐","g":"短诗","p":["秋風淒切傷離，行客未歸時。","塞外草先衰，江南鴈到遲。","芙蓉凋嫩臉，楊柳墮新眉。","搖落使人悲，斷腸誰得知。"],"s":"trad","f":"simp"},{"i":"10cb84f1-60b5-4f09-8534-4e0c7cba518d","t":"女冠子 一","a":"溫庭筠","d":"唐","g":"短诗","p":["含嬌含笑，宿翠殘紅窈窕，鬢如蟬。","寒玉簪秋水，輕紗卷碧煙。","雪胸鸞鏡裏，琪樹鳳樓前。","寄語青娥伴，早求仙。"],"s":"mixed","f":"simp"},{"i":"9d6d08c3-7cc8-4d52-ba70-7182b5e9a82b","t":"女冠子 二","a":"溫庭筠","d":"唐","g":"短诗","p":["霞帔雲髮，鈿鏡仙容似雪，畫愁眉。","遮語回輕扇，含羞下繡幃。","玉樓相望久，花洞恨來遲。","早晚乘鸞去，莫相遺。"],"s":"trad","f":"simp"},{"i":"1a0f1a5e-baa5-4627-aff1-6ffdac55ca26","t":"歸國遙 一","a":"溫庭筠","d":"唐","g":"短诗","p":["香玉，翠鳳寶釵垂{罒/彔}𦌉，鈿筐交勝金粟，越羅春水綠。","畫堂照簾殘燭，夢餘更漏促。","謝娘無限心曲，曉屏山斷續。"],"s":"trad","f":"simp"},{"i":"0083a2d5-c7d0-4be7-a8c3-7c76ebbfe3fe","t":"歸國遙 二","a":"溫庭筠","d":"唐","g":"短诗","p":["雙臉，小鳳戰箆金颭豔，舞衣無力風歛，藕絲秋色染。","錦帳繡幃斜掩，露珠清曉簟。","粉心黃蘂花靨，黛眉山兩點。"],"s":"trad","f":"simp"},{"i":"20e442bb-ecba-4adc-94cd-67ab05096349","t":"菩薩蠻 一","a":"溫庭筠","d":"唐","g":"短诗","p":["小山重疊金明滅，鬢雲欲度香顋雪。","嬾起畫蛾眉，弄妝梳洗遲。","照花前後鏡，花面交相映。","新帖繡羅襦，雙雙金鷓鴣。"],"s":"trad","f":"simp"},{"i":"9f1328cc-d58f-4320-a56a-1f8c2c2b07a4","t":"菩薩蠻 二","a":"溫庭筠","d":"唐","g":"短诗","p":["水精簾裏頗黎枕，暖香惹夢鴛鴦錦。","江上柳如煙，鴈飛殘月天。","藕絲秋色淺，人勝參差翦。","雙鬢隔香紅，玉釵頭上風。"],"s":"mixed","f":"simp"},{"i":"3d653ca8-6648-457e-9174-9787265e7a12","t":"菩薩蠻 三","a":"溫庭筠","d":"唐","g":"短诗","p":["蘂黃無限當山額，宿妝隱笑紗窗隔。","相見牡丹時，暫來還別離。","翠釵金作股，釵上蝶雙舞。","心事竟誰知，月明花滿枝。"],"s":"trad","f":"simp"},{"i":"94d5cd0f-ec65-45e1-83e2-eb316bb347c4","t":"菩薩蠻 四","a":"溫庭筠","d":"唐","g":"短诗","p":["翠翹金縷雙鸂鶒，水文細起春池碧。","池上海棠梨，雨晴紅滿枝。","繡衫遮笑靨，煙草黏飛蝶。","青瑣對芳菲，玉關音信稀。"],"s":"trad","f":"simp"},{"i":"2d3a1249-3b58-4360-996c-8c9408a8cb0e","t":"菩薩蠻 五","a":"溫庭筠","d":"唐","g":"短诗","p":["杏花含露團香雪，綠楊陌上多離別。","燈在月朧明，覺來聞曉鸎。","玉鉤褰翠幕，妝淺舊眉薄。","春夢正關情，鏡中蟬鬢輕。"],"s":"trad","f":"simp"},{"i":"e57f3096-5a69-444e-8454-517585ad99a4","t":"菩薩蠻 六","a":"溫庭筠","d":"唐","g":"短诗","p":["玉樓明月長相憶，柳絲嫋娜春無力。","門外草萋萋，送君聞馬嘶。","畫羅金翡翠，香燭銷成淚。","花落子規啼，綠窗殘夢迷。"],"s":"trad","f":"simp"},{"i":"129d6ad5-e635-4562-9e39-615b639c1d71","t":"菩薩蠻 七","a":"溫庭筠","d":"唐","g":"短诗","p":["鳳凰相對盤金縷，牡丹一夜經微雨。","明鏡照新妝，鬢輕雙臉長。","畫樓相望久，闌外垂絲柳。","音信不歸來，社前雙燕回。"],"s":"trad","f":"simp"},{"i":"b0d6dc9e-67cb-4925-8136-7065816e7dd3","t":"菩薩蠻 八","a":"溫庭筠","d":"唐","g":"短诗","p":["牡丹花謝鸎聲歇，綠楊滿院中庭月。","相憶夢難成，背窗燈半明。","翠鈿金壓臉，寂寞香閨掩。","人遠淚闌干，燕飛春又殘。"],"s":"mixed","f":"simp"},{"i":"aec61346-5b64-4770-9e3e-1a29ae2c80c1","t":"菩薩蠻 九","a":"溫庭筠","d":"唐","g":"短诗","p":["滿宮明月梨花白，故人萬里關山隔。","金鴈一雙飛，淚痕霑繡衣。","小園芳草綠，家住越溪曲。","楊柳色依依，燕歸君不歸。"],"s":"mixed","f":"simp"},{"i":"a35ef9ce-aeb6-4e0e-914d-1aab3aebe6bb","t":"菩薩蠻 十","a":"溫庭筠","d":"唐","g":"短诗","p":["寶函鈿雀金鸂鶒，沈香閣上吳山碧。","楊柳又如絲，驛橋春雨時。","畫樓音信斷，芳草江南岸。","鸞鏡與花枝，此情誰得知。"],"s":"trad","f":"simp"},{"i":"54967543-bf02-46b8-bd97-d49b6919ccc5","t":"菩薩蠻 十一","a":"溫庭筠","d":"唐","g":"短诗","p":["南園滿地堆輕絮，愁聞一霎清明雨。","雨後却斜陽，杏花零落香。","無言勻睡臉，枕上屏山掩。","時節欲黃昏，無憀獨倚門。"],"s":"mixed","f":"simp"},{"i":"a11c4a1d-0988-4501-b592-756fa6317cd8","t":"菩薩蠻 十二","a":"溫庭筠","d":"唐","g":"短诗","p":["夜來皓月纔當午，重簾悄悄無人語。","深處麝煙長，臥時留薄妝。","當年還自惜，往事那堪憶。","花露月明殘，錦衾知曉寒。"],"s":"mixed","f":"simp"},{"i":"c158c424-8616-486f-b519-a348a703b5a6","t":"菩薩蠻 十三","a":"溫庭筠","d":"唐","g":"短诗","p":["雨晴夜合玲瓏日，萬枝香嫋紅絲拂。","閑夢憶金堂，滿庭萱草長。","繡簾垂{罒/彔}𦌉，眉黛遠山綠。","春水渡溪橋，凭闌魂欲消。"],"s":"mixed","f":"simp"},{"i":"1280cd85-731d-4ca7-8f5f-6d70b862a775","t":"菩薩蠻 十四","a":"溫庭筠","d":"唐","g":"短诗","p":["竹風輕動庭除冷，珠簾月上玲瓏影。","山枕隱濃妝，綠檀金鳳凰。","兩蛾愁黛淺，故國吳宮遠。","春恨正關情，畫樓殘點聲。"],"s":"trad","f":"simp"},{"i":"1346cd4b-1453-4020-93fe-99d397977198","t":"菩薩蠻 十五","a":"溫庭筠","d":"唐","g":"短诗","p":["玉纖彈處真珠落，流多暗濕鉛華薄。","春露浥朝花，秋波浸晚霞。","風流心上物，本爲風流出。","看取薄情人，羅衣無此痕。"],"s":"mixed","f":"simp"},{"i":"97837150-d035-4bee-90a1-704fc2f1906f","t":"清平樂 一","a":"溫庭筠","d":"唐","g":"短诗","p":["上陽春晚，宮女愁蛾淺。","新歲清平思同輦，爭奈長安路遠。","鳳帳鴛被徒熏，寂寞花瑣千門。","競把黃金買賦，爲妾將上明君。"],"s":"mixed","f":"simp"},{"i":"692f8ff9-36e0-46d9-b47e-9ddbcebfd6a8","t":"清平樂 二","a":"溫庭筠","d":"唐","g":"短诗","p":["洛陽愁絕，楊柳花飄雪。","終日行人爭攀折，橋下水流嗚咽。","上馬爭勸離觴，南浦鸎聲斷腸。","愁殺平原年少，回首揮淚千行。"],"s":"trad","f":"simp"},{"i":"9b13c8eb-d23f-4587-a32f-45c6e8503c88","t":"更漏子 一","a":"溫庭筠","d":"唐","g":"短诗","p":["柳絲長，春雨細，花外漏聲迢遞。","驚塞鴈，起城烏，畫屏金鷓鴣。","香霧薄，透簾幕，惆悵謝家池閣。","紅燭背，繡簾垂，夢長君不知。"],"s":"trad","f":"simp"},{"i":"4dfde7bc-49f5-4fbd-b0c2-c089c1575cec","t":"更漏子 二","a":"溫庭筠","d":"唐","g":"短诗","p":["星斗稀，鐘鼓歇，簾外曉鸎殘月。","蘭露重，柳風斜，滿庭堆落花。","虛閣上，倚闌望，還似去年惆悵。","春欲暮，思無窮，舊歡如夢中。"],"s":"trad","f":"simp"},{"i":"3e512119-eba8-4410-9cbf-e22eff3aef96","t":"更漏子 三","a":"溫庭筠","d":"唐","g":"短诗","p":["金雀釵，紅粉面，花裏暫時相見。","知我意，感君憐，此情須問天。","香作穗，蠟成淚，還似兩人心意。","山枕膩，錦衾寒，覺來更漏殘。"],"s":"mixed","f":"simp"},{"i":"bd66a36e-6a76-4fc2-afef-fda908827990","t":"更漏子 四","a":"溫庭筠","d":"唐","g":"短诗","p":["相見稀，相憶久，眉淺淡煙如柳。","垂翠幕，結同心，待郎熏繡衾。","城上月，白如雪，蟬鬢美人愁絕。","宮樹暗，鵲橋橫，玉籤初報明。"],"s":"mixed","f":"simp"},{"i":"eb839cc2-8338-4352-8e8a-9bb2267aec34","t":"更漏子 五","a":"溫庭筠","d":"唐","g":"短诗","p":["背江樓，臨海月，城上角聲嗚咽。","堤柳動，島煙昏，兩行征鴈分。","京口路，歸帆渡，正是芳菲欲度。","銀燭盡，玉繩低，一聲村落雞。"],"s":"mixed","f":"simp"},{"i":"238276c5-45e7-40f9-ad7c-dd1f1dbbc334","t":"更漏子 六","a":"溫庭筠","d":"唐","g":"短诗","p":["玉爐香，紅蠟淚，偏照畫堂秋思。","眉翠薄，鬢雲殘，夜長衾枕寒。","梧桐樹，三更雨，不道離情正苦。","一葉葉，一聲聲，空階滴到明。"],"s":"trad","f":"simp"},{"i":"1e69e38f-b892-4d36-9905-33fb2fe6c14e","t":"河瀆神 一","a":"溫庭筠","d":"唐","g":"短诗","p":["河上望叢祠，廟前春雨來時。","楚山無限鳥飛遲，蘭櫂空傷別離。","何處杜鵑啼不歇，豔紅開盡如血。","蟬鬢美人愁絕，百花芳草佳節。"],"s":"trad","f":"simp"},{"i":"58012e00-5719-457d-b52d-bf978ec22547","t":"河瀆神 二","a":"溫庭筠","d":"唐","g":"短诗","p":["孤廟對寒潮，西陵風雨瀟瀟。","謝娘惆悵倚蘭橈，淚流玉筯千條。","暮天愁聽思歸樂，早梅香滿山郭。","回首兩情蕭索，離魂何處飄泊。"],"s":"trad","f":"simp"},{"i":"6a8ae2f7-d5b9-4cc6-bb6e-be9c7b44a2ab","t":"河瀆神 三","a":"溫庭筠","d":"唐","g":"短诗","p":["銅鼓賽神來，滿庭幡蓋裴回。","水村江浦過風雷，楚山如畫煙開。","離別艣聲空蕭索，玉容惆悵妝薄。","青麥燕飛落落，卷簾愁對珠閣。"],"s":"trad","f":"simp"},{"i":"ba91117a-dd0e-4455-8975-99ef02e8b843","t":"河傳 一","a":"溫庭筠","d":"唐","g":"古体","p":["江畔，相喚。","曉妝鮮，仙景箇女采蓮。","請君莫向那岸邊，少年，好花新滿船。","紅袖搖曳逐風輭，垂玉腕，腸向柳絲斷。","浦南歸，浦北歸，莫知，晚來人已稀。"],"s":"mixed","f":"simp"},{"i":"59640eba-5492-4033-8a8c-86b1c43dc6da","t":"河傳 二","a":"溫庭筠","d":"唐","g":"古体","p":["湖上，閑望。","雨蕭蕭，煙浦花橋路遙。","謝娘翠蛾愁不銷，終朝，夢魂迷晚潮。","蕩子天涯歸櫂遠，春已晚，鸎語空腸斷。","若耶溪，溪水西，柳堤，不聞郎馬嘶。"],"s":"trad","f":"simp"},{"i":"3b5c549d-af0b-4f05-9e78-763658c137e5","t":"河傳 三","a":"溫庭筠","d":"唐","g":"古体","p":["同伴，相喚。","杏花稀，夢裏每愁依違。","仙客一去燕已飛，不歸，淚痕空滿衣。","天際雲鳥引情遠，春已晚，煙靄渡南苑。","雪梅香，柳帶長，小娘，轉令人意傷。"],"s":"mixed","f":"simp"},{"i":"d0874544-8b86-4a63-bbf4-cfccf26114ab","t":"木蘭花","a":"溫庭筠","d":"唐","g":"短诗","p":["家臨長信往來道，乳燕雙雙拂煙草。","油壁車輕金犢肥，流蘇帳曉春雞早。","籠中嬌鳥暖猶睡，簾外落花閑不掃。","衰桃一樹近前池，似惜容顏鏡中老。"],"s":"trad","f":"simp"},{"i":"a1cdb255-eda0-45b8-8b59-5894c442174a","t":"竹枝 一","a":"皇甫松","d":"唐","g":"短诗","p":["檳榔花發鷓鴣啼，雄飛煙瘴雌亦飛。"],"s":"trad","f":"simp"},{"i":"73c6fda5-4058-45ad-b06e-ff18a10b2ec6","t":"竹枝 二","a":"皇甫松","d":"唐","g":"短诗","p":["木棉花盡荔支垂，千花萬花待郎歸。"],"s":"trad","f":"simp"},{"i":"ba8145c8-9eff-4780-9aa5-6e726c198f75","t":"竹枝 三","a":"皇甫松","d":"唐","g":"短诗","p":["芙蓉竝蔕一心連，花侵槅子眼應穿。"],"s":"trad","f":"simp"},{"i":"698d2590-f28a-4943-854e-390329352e7f","t":"竹枝 四","a":"皇甫松","d":"唐","g":"短诗","p":["筵中蠟燭淚珠紅，合歡桃核兩人同。"],"s":"trad","f":"simp"},{"i":"c6c142a7-3387-4665-92d9-b3630f385dbd","t":"竹枝 五","a":"皇甫松","d":"唐","g":"短诗","p":["斜江風起動橫波，劈開蓮子苦心多。"],"s":"trad","f":"simp"},{"i":"ed3f9d13-10e8-47cc-a74b-b9c109247630","t":"竹枝 六","a":"皇甫松","d":"唐","g":"短诗","p":["山頭桃花谷底杏，兩花窈窕遙相映。"],"s":"trad","f":"simp"},{"i":"ad0cd96c-0d2a-4e18-98cc-86b5f5cd0e9a","t":"摘得新 一","a":"皇甫松","d":"唐","g":"短诗","p":["酌一巵，須教玉笛吹。","錦筵紅蠟燭，莫來遲。","繁紅一夜經風雨，是空枝。"],"s":"trad","f":"simp"},{"i":"60996354-2277-4a59-a0fd-cce8c675181f","t":"摘得新 二","a":"皇甫松","d":"唐","g":"短诗","p":["摘得新，枝枝葉葉春。","管弦兼美酒，最關人。","平生都得幾十度，展香茵。"],"s":"mixed","f":"simp"},{"i":"08fe7156-eb95-411d-809c-51d92c029aa3","t":"采蓮子 一","a":"皇甫松","d":"唐","g":"短诗","p":["菡萏香連十頃陂，小姑貪戲采蓮遲。","晚來弄水船頭濕，更脫紅裙裹鴨兒。"],"s":"mixed","f":"simp"},{"i":"d489d9db-9571-459d-aceb-8a912abb453c","t":"采蓮子 二","a":"皇甫松","d":"唐","g":"短诗","p":["船動湖光灩灩秋，貪看年少信船流。","無端隔水拋蓮子，遙被人知半日羞。"],"s":"mixed","f":"simp"},{"i":"81f23259-5fc8-488a-9523-85f7759ba8df","t":"拋毬樂 一","a":"皇甫松","d":"唐","g":"短诗","p":["紅撥一聲飄，輕裘墜越綃。","帶翻金孔雀，香滿繡蜂腰。","少少拋分數，花枝正索饒。"],"s":"trad","f":"simp"},{"i":"8af29ea4-4586-4743-ac50-a1569721e712","t":"拋毬樂 二","a":"皇甫松","d":"唐","g":"短诗","p":["金蹙花毬小，真珠繡帶垂。","幾回衝蠟燭，千度入香懷。","上客終須醉，觥盂且亂排。"],"s":"trad","f":"simp"},{"i":"8f659dbb-07e0-4ff0-bf9c-b53d5bde41fe","t":"憶江南 一","a":"皇甫松","d":"唐","g":"短诗","p":["蘭燼落，屏上暗紅蕉。","閑夢江南梅熟日，夜船吹笛雨瀟瀟，人語驛邊橋。"],"s":"trad","f":"simp"}]