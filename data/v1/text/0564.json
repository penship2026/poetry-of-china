[{"i":"9dada24f-4deb-4dda-8532-c1a476396813","t":"顏師古引諺","a":"佚名","d":"唐","g":"短诗","p":["賊無歷底中道回。","（《匡謬正俗》卷八，云「內應導引爲歷底」）。"],"s":"mixed","f":"simp"},{"i":"09b755b9-3925-4b97-a88f-e86528b08ba6","t":"華壤英主爲神迥諺（題擬）","a":"佚名","d":"唐","g":"短诗","p":["大論主，釋迦迥，法界多羅一時領。","（見《續高僧傳》卷十三《神迥傳》）。"],"s":"mixed","f":"simp"},{"i":"753afa51-74ad-47f5-9583-f8d8a81ee562","t":"貞觀時諺（題擬）","a":"佚名","d":"唐","g":"短诗","p":["無知之叟，又指禪師，亂識之夫，共歸明德。","返迷皆有大照，隨妄普翳真科。","（見前書卷二十《僞徹傳》）。"],"s":"mixed","f":"simp"},{"i":"d3f11145-a67f-4416-942e-fbb3a7331441","t":"魏徵引諺","a":"佚名","d":"唐","g":"短诗","p":["豐年珠玉，儉年穀熟。","（《魏鄭公諫錄》卷三）。"],"s":"trad","f":"simp"},{"i":"73fe9eeb-eb36-44ae-815e-567d6d2399b4","t":"王勃引諺","a":"佚名","d":"唐","g":"短诗","p":["禍不入慎家之門。","（見《王子安集》卷十《平臺秘略論》）。"],"s":"trad","f":"simp"},{"i":"4295214a-8ac1-480d-9514-6aad10e12b1f","t":"陳子昂引諺","a":"佚名","d":"唐","g":"短诗","p":["欲知其人，觀其所使。","（見《陳拾遺集》卷八《上軍圖利害事》）。"],"s":"trad","f":"simp"},{"i":"eecda89b-182d-4262-8b75-29cc308341a0","t":"劉知已引今諺","a":"佚名","d":"唐","g":"短诗","p":["季與厥昆，爭知嫂諱。","（見《史通》卷十九《漢書五行志錯誤篇》）。"],"s":"trad","f":"simp"},{"i":"98519f85-6f0d-4943-876a-5e1ae538b4dd","t":"張鷟引諺 一","a":"佚名","d":"唐","g":"短诗","p":["官倉喝雀，猶是向公。","（《施注蘇詩》卷二十一引《朝野僉載》引）。"],"s":"trad","f":"simp"},{"i":"04d314d6-8c26-460d-b021-e728d8cb0c39","t":"張鷟引諺 二","a":"佚名","d":"唐","g":"短诗","p":["心欲專，鑿石穿。","（《遊仙窟》）。"],"s":"trad","f":"simp"},{"i":"c411bd6e-124f-4796-9257-760f36d66375","t":"張說引諺","a":"佚名","d":"唐","g":"短诗","p":["歲在申酉，乞漿得酒。","（見《張燕公集》卷九《請置屯田表》）。"],"s":"trad","f":"simp"},{"i":"ba2223df-53ae-4b08-969a-81be4f202129","t":"李邕引諺","a":"佚名","d":"唐","g":"短诗","p":["河南照，天下少。","（見日本《續藏經》第一五○冊收李邕《唐故白馬寺主翻譯惠沼神塔碑》）（按：此諺當即《續高僧傳》所收「河南一遍照，英聲不從召」之語的別一本，詳後。","）。"],"s":"trad","f":"simp"},{"i":"6ddf5cb5-5dd8-4674-a149-b5d0c0e9b76b","t":"李邕妻溫氏引諺","a":"佚名","d":"唐","g":"短诗","p":["士無賢不肖，入朝見疾。","（見《新唐書》卷二○二《李邕傳》）。"],"s":"trad","f":"simp"},{"i":"22ea841c-d773-4698-9a05-f30992f7803f","t":"崔仁師引諺","a":"佚名","d":"唐","g":"短诗","p":["殺人刖足，亦皆有禮。","（見《新唐書》卷九九《崔仁師傳》）。"],"s":"trad","f":"simp"},{"i":"183611b3-07ee-44a6-9b0e-25a6b83272e4","t":"趙蕤引諺","a":"佚名","d":"唐","g":"短诗","p":["太白入南斗，天子下殿走。","（見《長短經》卷七《懼誡》）。"],"s":"trad","f":"simp"},{"i":"c4fa4f40-3e79-42df-90a8-ca149cd8721d","t":"畫松諺語","a":"佚名","d":"唐","g":"短诗","p":["畫松當如夜叉臂，鸛鵲啄。","（《宣和畫譜》卷十）。"],"s":"trad","f":"simp"},{"i":"12a2f6de-d43e-42d0-9b07-165198b4aa0c","t":"李諲引諺","a":"佚名","d":"唐","g":"短诗","p":["百日斫柴一日燒。","（見《全唐文》卷四○八李諲《妒神頌序》）。"],"s":"trad","f":"simp"},{"i":"5fbac449-9bc0-4ad1-9851-94a469dd7b59","t":"張懷瓘引諺","a":"佚名","d":"唐","g":"短诗","p":["韓《詩》鄭《易》掛著壁。","（見《書斷》卷上、《墨池編》卷七）。"],"s":"mixed","f":"simp"},{"i":"ee0a43b7-c74c-4e22-aaaa-2b19f18fcd19","t":"李觀引諺","a":"佚名","d":"唐","g":"短诗","p":["溜之細穿石，綆之細斷榦。","（見《李元賓文集》卷五《請修太學書》）。"],"s":"trad","f":"simp"},{"i":"d1ab3a46-c759-4e75-8f1b-d68f467f1d2c","t":"省躬諺","a":"佚名","d":"唐","g":"短诗","p":["義盡省躬。","（《宋高僧傳》卷十五《唐揚州慧照寺省躬傳》）。"],"s":"trad","f":"simp"},{"i":"e09f732b-5529-44d3-b333-1e2bfa9b336a","t":"襄陽古諺","a":"佚名","d":"唐","g":"短诗","p":["襄陽無西。","（《元和郡縣圖志》卷二十一）。"],"s":"trad","f":"simp"},{"i":"d1d32af4-11aa-426f-aec5-869676d6a262","t":"邔縣古諺","a":"佚名","d":"唐","g":"短诗","p":["邔無東。","（同前）。"],"s":"trad","f":"simp"},{"i":"6db65ef4-e072-4d24-bb7b-2a95afce6ed8","t":"白居易引諺","a":"佚名","d":"唐","g":"短诗","p":["鄭玄家牛，觸墻成八字。","（見《白氏長慶集》卷二六《雙鸚鵡》詩注引）。"],"s":"trad","f":"simp"},{"i":"17d8e7aa-db3d-494c-93f7-493659a53e0a","t":"范攎引諺","a":"佚名","d":"唐","g":"短诗","p":["徍談巷議，倏有裨於王化。","（《雲溪友議序》）。"],"s":"mixed","f":"simp"},{"i":"08b97768-12af-4756-9054-af97925b1e9d","t":"王叡引諺","a":"佚名","d":"唐","g":"短诗","p":["鳥窮則啄，獸窮則角，人窮則詐。","（見《類說》卷二五《炙轂子》引）。"],"s":"trad","f":"simp"},{"i":"508f1134-589f-4819-9e18-38a56721a0f3","t":"《獨異志》引諺","a":"佚名","d":"唐","g":"短诗","p":["驕奢之災，禍非一致。","（《獨異志》卷下）。"],"s":"trad","f":"simp"},{"i":"641e60a7-386a-4390-8c39-41caca61fd48","t":"李匡文引諺","a":"佚名","d":"唐","g":"短诗","p":["千里井，不及唾。","（見《資暇集》卷下）（按：蘇鶚《蘇氏演義》卷下引杜詩「畏人千里井」注引同。","）。"],"s":"trad","f":"simp"},{"i":"905ffb74-d7b2-4866-9886-88d349ade000","t":"稷下諺","a":"佚名","d":"唐","g":"短诗","p":["學識何如觀點書。","（見《資暇集》卷下）。"],"s":"trad","f":"simp"},{"i":"5679a880-9275-4b01-8d89-6e5a53aeef9e","t":"木奴諺","a":"佚名","d":"唐","g":"短诗","p":["木奴千，無凶年。","（見段公路《北戶錄》卷三、《侯鯖錄》卷四，又見《四時纂要》卷三）。"],"s":"trad","f":"simp"},{"i":"8a79fa93-d6d4-4d13-9321-683c7b2efbf3","t":"瓊振二州人（題擬）","a":"佚名","d":"唐","g":"短诗","p":["跳石牛骨碌，好笑又（《武英殿聚珍版叢書》本《嶺表錄異》無「又」字）好哭。","（見《太平御覽》卷九○○引劉恂《嶺表錄異》）。"],"s":"trad","f":"simp"},{"i":"eeffaba5-6ca0-47f9-a425-57222d349175","t":"安定郡里諺（題擬）","a":"佚名","d":"唐","g":"短诗","p":["峴山張蓋雨滂沱。","（《孔帖》卷二作「沛」。","見皇甫枚《三水小牘》卷下）。"],"s":"mixed","f":"simp"},{"i":"5bc96ed6-4021-48a7-b241-1f2980acb478","t":"徐知諤引諺","a":"佚名","d":"唐","g":"短诗","p":["人生百歲，七十者稀。","（《玉壺清話》卷九）。"],"s":"trad","f":"simp"},{"i":"d2fff7f2-3b82-411f-b07b-ffbd0c17f596","t":"孫光憲引諺","a":"佚名","d":"唐","g":"短诗","p":["好事不出門，惡事行千里。","（《北夢瑣言》卷六，參《古謠諺》卷五十八）。"],"s":"trad","f":"simp"},{"i":"a347a8e6-1a4d-49ba-bc6f-6bf783a9e72d","t":"時人爲張全義諺（題擬）","a":"佚名","d":"唐","g":"短诗","p":["王禱雨，買雨具。","無畏之神耶？齊王之潔誠耶？（見宋張齊賢《洛陽縉紳舊聞記》卷二）。"],"s":"mixed","f":"simp"},{"i":"bf8139e9-46ee-4229-85dc-701407b0e225","t":"王蜀時人爲高道興諺（題擬）","a":"佚名","d":"唐","g":"短诗","p":["高君墜筆亦成畫。","（見宋郭若虛《圖畫見聞志》卷二）。"],"s":"mixed","f":"simp"},{"i":"75ed719c-9310-4dd1-ba13-699978ed8833","t":"王仁裕引諺 一","a":"佚名","d":"唐","g":"短诗","p":["一飲一啄，繫之於分。","（見《太平廣記》卷一五八《玉堂閒話》引）。"],"s":"trad","f":"simp"},{"i":"38c0aa32-6f66-43b9-9b4a-12492aad0c4a","t":"王仁裕引諺 二","a":"佚名","d":"唐","g":"短诗","p":["孤雲兩角，去天一握。","（見《類說》卷五四《玉堂閑話》引）（〖1〗《玉堂閑話》云：「興元中，有南路通巴州，其峭巖頂謂之『孤雲兩角』，諺云〖略〗。","」）。"],"s":"mixed","f":"simp"},{"i":"bb0bd478-b7b5-4a42-ada3-f3942f9e1ee7","t":"楊億引諺","a":"佚名","d":"唐","g":"短诗","p":["不到長安辜負眼，不到兩浙辜負口。","（見《類說》卷五三引《楊文公談苑》）（按：長安於唐末毀於兵災，此諺應爲其前之作。","）。"],"s":"mixed","f":"simp"},{"i":"61e6f39a-20e3-4db4-b139-c6281bc8f222","t":"時人爲省中諺（題從《古謠諺》卷五九擬）","a":"佚名","d":"唐","g":"短诗","p":["司門都官，屯田水部，入省不數。","（見錢易《南部新書》卷丁）（按：《全唐詩》卷八七六所錄不全。","）。"],"s":"mixed","f":"simp"},{"i":"70d4e671-5be2-493b-87df-4e8e8cf542d0","t":"贊寧引諺 一","a":"佚名","d":"唐","g":"短诗","p":["東家種竹，西家種地。"],"s":"trad","f":"simp"},{"i":"fa7c2ea5-be19-4c17-8ff9-2142bd0a7e37","t":"贊寧引諺 二","a":"佚名","d":"唐","g":"短诗","p":["臘月煮筍羹，大人道便是。"],"s":"trad","f":"simp"},{"i":"31e8c8a4-79c6-4a8d-a3a2-470f9634fbd1","t":"贊寧引諺 三","a":"佚名","d":"唐","g":"短诗","p":["恭敬不如從命，受訓莫如從順。","（見《百川學海》本贊寧《筍譜》）。"],"s":"trad","f":"simp"},{"i":"bb1d1983-5489-4638-977b-def8929562db","t":"贊寧引諺 四","a":"佚名","d":"唐","g":"短诗","p":["青成藍，藍謝青。","師何常？在明經。","（《宋高僧傳》卷十二《唐福州雪峯廣福院義存傳》）。"],"s":"mixed","f":"simp"},{"i":"edc91501-e63e-428b-aa1a-a69f29189aef","t":"陶穀引諺","a":"佚名","d":"唐","g":"短诗","p":["闌單帶，疊垛衫，肥人也覺瘦嚴巖。","（見《說郛》卷六一《清異錄》）（〖1〗《清異錄》釋云：「蘭單，破裂之狀。","疊垛，補衲蓋掩之多。","」）。"],"s":"mixed","f":"simp"},{"i":"d0682912-a9ab-4251-9c27-8fd1c470d0ed","t":"南鄭縣旱山諺","a":"佚名","d":"唐","g":"短诗","p":["牛頭戴，旱山晦，家中乾穀莫相貸。","（見《太平寰宇記》卷一三三）。"],"s":"trad","f":"simp"},{"i":"e578cbed-8675-4366-92da-fd2060c2765c","t":"鄜州雲巖縣庫利川土諺","a":"佚名","d":"唐","g":"古体","p":["昔有奴賊，居此川內。","（稽胡呼奴爲庫利。","見同書卷三五）（按：《太平寰宇記》爲樂史於宋初所著書。","其所引二諺，應爲唐五代時之作。","）。"],"s":"mixed","f":"simp"},{"i":"188f74e4-10d8-4749-8673-0c68c738e88b","t":"諺","a":"佚名","d":"唐","g":"短诗","p":["憫忠高閣，去天一握。","（《天府廣記》卷三八）。"],"s":"trad","f":"simp"},{"i":"f9f44158-3795-4f00-9695-5ebece866f96","t":"時人爲神照語（題擬。以下語）","a":"佚名","d":"唐","g":"短诗","p":["河南一遍照，英聲不徒召。","（見《續高僧傳》卷十三《神照傳》）。"],"s":"mixed","f":"simp"},{"i":"8f2eaf17-c251-491c-ad7d-95992ca48345","t":"唐史官引語論冀州民俗（題擬）","a":"佚名","d":"唐","g":"短诗","p":["魏郡清河，天公無奈何。","（《隋書》卷二十五《地理志中》）。"],"s":"trad","f":"simp"},{"i":"fd025a8d-27d8-4c39-96a0-f441a6a044c5","t":"時人爲玄奘法師兄弟語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["昔聞荀氏八龍，今見陳門雙驥。","（見于志寧《〈大唐西域記〉序》引）。"],"s":"mixed","f":"simp"},{"i":"5be19ffa-f683-46c4-b92b-2910a7e19fd2","t":"時人爲來虞二氏子語（題從《古謠諺》卷十六）","a":"佚名","d":"唐","g":"短诗","p":["護兒兒作相，世南男作匠。","（《弘簡錄》卷十三）（按：《新唐書》卷一○五《來濟傳》云此爲許敬宗語。","）。"],"s":"mixed","f":"simp"},{"i":"18ea8c93-7923-453a-87b7-dbda6778434d","t":"鸚鵡谷水世語（題從《古謠諺》卷三十二）","a":"佚名","d":"唐","g":"短诗","p":["此水清，天下平。","（《唐會要》卷二十八）（按：《唐會要》云：「武德元年十二月，新豐鸚鵡谷水清。","世傳云云。","」）。"],"s":"mixed","f":"simp"},{"i":"0ec8c78b-9714-4aca-aea3-90b7cbda4229","t":"中宗時人爲李元恭語（題擬）","a":"佚名","d":"唐","g":"古体","p":["長寧安樂幷狂顛，既教翻地亦翻天。","賣弄大家猶未足，便使元恭來取錢。","（《冊府元龜》卷六三八《銓選部·貪賄》。","此首及下首承陶敏先生見告）（〖1〗《冊府元龜》云：「李元恭中宗時以大理少卿爲長寧、安樂二公主所引用，令知吏部侍郎，分往東都掌選事，亦以贓汙聞於天下。","故時人爲之語曰〖語略〗。","」）。"],"s":"mixed","f":"simp"},{"i":"8f6b928d-ebc1-4adb-a770-36d3451e8a44","t":"中宗時（京師）人爲鄭愔語（題擬）","a":"佚名","d":"唐","g":"古体","p":["殺鄭愔，天必陰。","（同前）（〖1〗《冊府元龜》：「鄭愔謟事武三思及韋氏悖逆庶人，歷選吏侍郎。","愔掌選，專以賣官爲務，人多怨讟。","時京師大旱，爲之語曰〖語略〗。","其爲人所惡如此。","」）。"],"s":"mixed","f":"simp"},{"i":"cf664351-8194-4855-8f10-782ec96445b0","t":"時人爲蘇頲語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["蘇瓌有子，李嶠無兒。","（見《太平御覽》卷四一四引《朝野僉載》）。"],"s":"mixed","f":"simp"},{"i":"64da1c35-4abc-4cfc-94b8-15438e519d3a","t":"京中人作二豹咒（題擬）","a":"佚名","d":"唐","g":"短诗","p":["苦違心負教，橫遭三豹。","（見《朝野僉載》卷二）（按：《全唐詩》卷八七六作三言二句，係錄自《新唐書》卷一八六《王旭傳》。","今重錄。","）。"],"s":"trad","f":"simp"},{"i":"2327f154-3652-445e-a445-1a6fcfce30bb","t":"時人爲韓朝宗語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["生不願封萬戶侯，但願一識韓荆州。","（角《李太白全集》卷二十六《與韓荆州書》引。","）。"],"s":"mixed","f":"simp"},{"i":"68b4412c-23d1-4c7e-9287-25337deaad33","t":"輕薄者爲進士及第語（題擬） 一","a":"佚名","d":"唐","g":"短诗","p":["及第進士，俯視中黃郎；落第進士，揖蒲華長馬。"],"s":"mixed","f":"simp"},{"i":"8787c28e-de9f-4894-99f6-27a0f8da59a1","t":"輕薄者爲進士及第語（題擬） 二","a":"佚名","d":"唐","g":"短诗","p":["進士初及第，頭上七尺焰光。","（見《封氏聞見記》卷三）。"],"s":"mixed","f":"simp"},{"i":"dcb55202-a4c0-4d5a-a88b-f514736a8739","t":"世人爲吳道子王陁子言（題從《古謠諺》卷四十）","a":"佚名","d":"唐","g":"短诗","p":["陁子頭，道子脚。","（《歷代名畫記》卷三）。"],"s":"mixed","f":"simp"},{"i":"047080a1-fb34-498c-aa33-3ca2dcecef64","t":"徐浩引俗語","a":"佚名","d":"唐","g":"短诗","p":["書無百日工。","（《法書要錄》卷三徐浩《論書》引）。"],"s":"trad","f":"simp"},{"i":"690277cb-8a3b-4529-9183-ac719312d141","t":"唐時爲八詩人語（題從《古謠諺》卷十二）","a":"佚名","d":"唐","g":"短诗","p":["前有沈宋王杜，後有錢郎劉李。","（《唐才子傳》卷二《劉長卿傳》）。"],"s":"mixed","f":"simp"},{"i":"81b4e09c-dacf-4f3a-b518-60bd0920b7ac","t":"時人爲魏博牙軍語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["長安天子，魏府牙軍。","（《新唐書》卷二一○《藩鎮魏博傳》）。"],"s":"mixed","f":"simp"},{"i":"f624aa66-66cf-4fe1-b994-fcead78e37df","t":"陳藏器引俗語","a":"佚名","d":"唐","g":"短诗","p":["韭是草鍾乳，芡是水硫磺。","（《古謠諺》卷三十八引陳藏器《本草拾遺》）（按：《重修政和經史證類備用本草》卷二十三引陳藏器《本草》作「韭葉是草種乳」。","）。"],"s":"trad","f":"simp"},{"i":"020e98e0-abae-4db9-8fe5-7f8a9f8d8de0","t":"時人爲陽城鄭剛李周南語（題從《古謠諺》卷五七）","a":"佚名","d":"唐","g":"短诗","p":["轉遠轉高，轉近轉卑。","（《唐國史補》卷上）。"],"s":"mixed","f":"simp"},{"i":"7aec215a-e781-43a8-86ca-c59393482f24","t":"長安人爲宋清語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["人有義聲，賣藥宋清。","（同前卷中）。"],"s":"mixed","f":"simp"},{"i":"c36c695d-b476-4e58-a963-64eccb41a38e","t":"峽中舊語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["五月下峽，死而不弔。","（同前卷下）。"],"s":"trad","f":"simp"},{"i":"3b79e6bd-c8da-490d-ae5c-40030000b3d7","t":"江湖語","a":"佚名","d":"唐","g":"短诗","p":["水不載萬。","（同前）（〖1〗《國史補》云此言「大船不過八九千石」。","）。"],"s":"mixed","f":"simp"},{"i":"e5bd6c54-d5bd-4ec0-9165-c8768e6224d8","t":"時人爲兔褐語（題從《古謠諺》卷五八）","a":"佚名","d":"唐","g":"短诗","p":["兔褐真不如假。","（同前）。"],"s":"mixed","f":"simp"},{"i":"07212746-cd2a-430a-b195-636def9c70c6","t":"鎮海軍壯兒語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["壯兒過大梁，如上龍門。","（《雲溪友議》卷上）。"],"s":"mixed","f":"simp"},{"i":"cad97344-b2f8-41df-924d-45c8688fd460","t":"歷城土人爲光政寺磬語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["磬神聖，戀光政。","（《酉陽雜俎》卷三）。"],"s":"mixed","f":"simp"},{"i":"facbaca3-b3e1-49e6-960f-c1fbaabc65ad","t":"齊人爲妬婦津語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["欲求好婦，立在津口。","婦立水傍，好醜自彰。","（同前卷十六）。"],"s":"mixed","f":"simp"},{"i":"f0df7b0d-b967-4eda-9e18-d08c6681f6ff","t":"文宗時舉場中語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["鄉貢進士，不博上州刺史。","（《太平廣記》卷一八一引《盧氏雜說》）。"],"s":"trad","f":"simp"},{"i":"4fa1d33a-afe1-45dd-99cb-0ced2bb39459","t":"京師語","a":"佚名","d":"唐","g":"短诗","p":["丑侯䁸䁸，多用半裝。","（《續談助》卷三引《牛羊日曆》引）。"],"s":"mixed","f":"simp"},{"i":"e4ba6315-9ae4-4617-a02d-376be81fc091","t":"會昌中長安人語","a":"佚名","d":"唐","g":"短诗","p":["今年長安人喫人。","（《入唐求法巡禮行記》卷四）。"],"s":"mixed","f":"simp"},{"i":"57829cc1-4068-4cdd-b61c-ed97faff18a8","t":"里語","a":"佚名","d":"唐","g":"短诗","p":["當時婦棄夫，今日夫棄婦。","若不逞丹青，空房應獨守。","（見《雲溪友議》卷上）。"],"s":"mixed","f":"simp"},{"i":"69d08894-410e-48ad-935b-4f6ae2649b65","t":"時人爲劉師貞語","a":"佚名","d":"唐","g":"短诗","p":["孝於何，通神明。","漢有丁蘭，唐有師貞。"],"s":"mixed","f":"simp"},{"i":"83e0437f-d1ea-444e-adae-a3f3a6bc914d","t":"俚語","a":"佚名","d":"唐","g":"短诗","p":["騎虎者，勢不得下。"],"s":"trad","f":"simp"},{"i":"25ba709d-46ff-4afa-aba9-600112dc4db1","t":"人爲分香蓮語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["一事南無，折却長鬚。"],"s":"mixed","f":"simp"},{"i":"ee533a91-ca8e-4ac6-9757-4a7c6d453887","t":"宣州人爲弘農王語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["何獨後予，徯其來蘇。"],"s":"mixed","f":"simp"},{"i":"eb5209b0-0081-448b-bf77-a19f95f7fbb2","t":"崔淙引俚語","a":"佚名","d":"唐","g":"短诗","p":["川壅則潰，月盈則匡，善敗由己，吉凶何嘗。","（見《全唐文》卷四五九崔淙《登姑蘇臺賦》引）。"],"s":"trad","f":"simp"},{"i":"055dc8fc-22dc-4db9-919b-f97e535deb56","t":"丹州俗語","a":"佚名","d":"唐","g":"短诗","p":["丹州白室，胡頭漢舌。"],"s":"trad","f":"simp"},{"i":"52d28376-c404-4219-b530-b1cc81069ed4","t":"戶牖俗語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["二十三，日正南。","二十五，日當戶。","（見《國史補》卷中）。"],"s":"trad","f":"simp"},{"i":"68c37f43-aff4-4783-a385-8ae304e058cb","t":"金榆山土人言（題擬）","a":"佚名","d":"唐","g":"短诗","p":["金驢一鳴，天下太平。"],"s":"trad","f":"simp"},{"i":"3fbf603b-ff16-4682-86ca-adb8a389eef7","t":"俗語","a":"佚名","d":"唐","g":"短诗","p":["王母甘桃，食之解勞。","（見前書卷十）。"],"s":"trad","f":"simp"},{"i":"58d00d5c-5b9b-476c-a9ca-3438c460c4d1","t":"時人爲沈警語","a":"佚名","d":"唐","g":"短诗","p":["玄機在席，顛倒賓客。"],"s":"mixed","f":"simp"},{"i":"5b39ea59-9525-453f-a3c3-89df5e39f635","t":"蜀人爲南詔語","a":"佚名","d":"唐","g":"短诗","p":["西戎尚可，南蠻殘我。","（見《新唐書》卷二一五引）。"],"s":"mixed","f":"simp"},{"i":"62e484c9-8b09-41d8-8000-7317e83578e1","t":"乾符中人稱蔣凝語","a":"佚名","d":"唐","g":"短诗","p":["臼頭花鈿滿面，不若徐妃增妝。","（見《唐摭言》卷十。","《釵小志》作諺）。"],"s":"trad","f":"simp"},{"i":"a841a856-8d16-4bc7-9939-afd567c93e37","t":"唐時人爲秘書省太常寺官語（題從《古謠諺》卷六七）","a":"佚名","d":"唐","g":"短诗","p":["正字校書，詠詩騎驢。","奉禮太祝，輕裘食肉。","（見《翰苑新書前集》卷二十四引《雍洛靈異記》）。"],"s":"mixed","f":"simp"},{"i":"05765325-1d9b-4d5e-939c-51ab4db42f08","t":"風流箭語","a":"佚名","d":"唐","g":"古体","p":["風流箭，風流人人願。","（見《說郛》卷六一引《清異錄》）（〖1〗《清異錄》：「寶曆中，帝造紙箭，竹皮弓紙間密貯龍麝末香。","每宮嬪羣聚，帝躬射之，中者濃香，觸體了無痛楚，名風流箭。","爲之語曰〖略〗。","」）。"],"s":"mixed","f":"simp"},{"i":"69b95491-a064-413c-8151-7b57533096fc","t":"韓鄂引俗語 一","a":"佚名","d":"唐","g":"短诗","p":["一年計樹之以穀，十年計樹之以木。"],"s":"trad","f":"simp"},{"i":"ec725194-c398-4386-97e6-82c23c153dae","t":"韓鄂引俗語 二","a":"佚名","d":"唐","g":"短诗","p":["一日之之計在一晨，一年之計在一春。"],"s":"trad","f":"simp"},{"i":"ddcf30b9-68bb-4abf-80fa-dd32bf567b3b","t":"韓鄂引俗語 三","a":"佚名","d":"唐","g":"短诗","p":["以時及澤爲上策。","（均見《四時纂要》卷一）。"],"s":"mixed","f":"simp"},{"i":"e69bbe65-095c-4ddb-b75b-238bf87282dc","t":"韓鄂引俗語 四","a":"佚名","d":"唐","g":"短诗","p":["八月雨班闌，高低盡可憐。","（同前卷三）。"],"s":"trad","f":"simp"},{"i":"737198b5-ef01-40ad-ba55-409ebe4c7807","t":"人爲太白山橫雲語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["南山瀑布，非朝則暮。","（見宋敏求《長安志》卷十四）。"],"s":"mixed","f":"simp"},{"i":"34db2fa2-e221-4e25-b4e7-c4a478e34b2a","t":"清豐故老傳語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["金堤頭，上有秦女樓。","（見《太平寰宇記》卷五七）。"],"s":"trad","f":"simp"},{"i":"f7a0376d-be53-49f7-8c2c-9792baa6e71f","t":"人爲吳道子曹仲達語","a":"佚名","d":"唐","g":"短诗","p":["吳帶當風，曹衣出水。","（見《圖畫見聞志》卷一）。"],"s":"mixed","f":"simp"},{"i":"8b7cadc7-c876-4f2a-9d96-f8b7af16a5ea","t":"梁時人爲吳道子劉彦齐语（题拟）","a":"佚名","d":"唐","g":"短诗","p":["唐朝吳道子手，梁朝劉彥齊眼。","（《圖書見聞志》卷五）。"],"s":"mixed","f":"simp"},{"i":"6c5a9849-8cbd-444a-8cc9-8dbadbd3158e","t":"揚州人爲彭玕語（題從《古謠諺》卷二四）","a":"佚名","d":"唐","g":"短诗","p":["十金易一筆，百金易一篇。","（《十國春秋》卷七三《彭玕傳》）。"],"s":"mixed","f":"simp"},{"i":"59b507b7-cba9-4973-9bb6-9756bf4c3510","t":"蘇州耆舊語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["燕山石鼓，鳴則有兵。","（《太平寰宇記》卷七十）。"],"s":"trad","f":"simp"},{"i":"791231bd-14bb-4a24-8b0e-658ab52f9ac0","t":"南溪故老傳語（題擬）","a":"佚名","d":"唐","g":"短诗","p":["東石從西，乞子將歸。","（《太平寰宇記》卷七九）。"],"s":"trad","f":"simp"}]