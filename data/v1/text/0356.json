[{"i":"c1874d9f-a8b1-4b2d-97fe-3a64abc1c3b4","t":"詠史詩 黃河","a":"胡曾","d":"唐","g":"短诗","p":["博望沈埋不復旋，黃河依舊水茫然。","沿流欲共牛郎語，只得靈槎送上天。"]},{"i":"49928994-807b-4f9a-9f6e-accb0af20648","t":"詠史詩 鳳皇臺","a":"胡曾","d":"唐","g":"短诗","p":["秦娥一別鳳皇臺，東入青冥更不回。","空有玉簫千載後，遺聲時到世間來。"]},{"i":"7b571905-0e31-47f1-8e5e-92e8d2bff993","t":"詠史詩 五丈原","a":"胡曾","d":"唐","g":"短诗","p":["蜀相西驅十萬來，秋風原下久裴回。","長星不爲英雄住，半夜流光落九垓。"]},{"i":"4c3751ee-b2bc-475f-b9da-20da9a2b9d64","t":"詠史詩 平城","a":"胡曾","d":"唐","g":"短诗","p":["漢帝西征陷虜塵，一朝圍解議和親。","當時已有吹毛劍，何事無人殺奉春。"]},{"i":"28426bd8-902d-435d-887c-9ad55874c0a7","t":"詠史詩 汴水","a":"胡曾","d":"唐","g":"短诗","p":["千里長河一旦開，亡隋波浪九天來。","錦帆未落干戈起，惆悵龍舟更不回。"]},{"i":"3b71f76d-6472-4c17-9ff1-b93d028224d8","t":"詠史詩 蘭臺宮","a":"胡曾","d":"唐","g":"短诗","p":["遲遲春日滿長空，亡國離宮蔓草中。","宋玉不憂人事變，從遊那賦大王風。"]},{"i":"b703aed4-149d-46ce-bc8f-e4c3a1409c5c","t":"詠史詩 金牛驛","a":"胡曾","d":"唐","g":"短诗","p":["山嶺千重擁蜀門，成都別是一乾坤。","五丁不鑿金牛路，秦惠何由得併吞。"]},{"i":"eb0de8b5-efdb-40c0-89d1-3643acb5d3ee","t":"詠史詩 望思臺","a":"胡曾","d":"唐","g":"短诗","p":["太子銜冤去不回，臨臯從築望思臺。","至今漢武銷魂處，猶有悲風木上來。"]},{"i":"ddd3edd1-33a0-45b4-af1d-feb407680462","t":"詠史詩 邯鄲","a":"胡曾","d":"唐","g":"短诗","p":["曉入邯鄲十里春，東風吹下玉樓塵。","青娥莫怪頻含笑，記得當年失步人。"]},{"i":"b7b5fd63-f191-4dac-ab02-238e05175e8e","t":"詠史詩 箕山","a":"胡曾","d":"唐","g":"短诗","p":["寂寂箕山春復秋，更無人到此溪頭。","棄瓢巖畔中宵月，千古空聞屬許由。"]},{"i":"06a87924-9f8e-4275-b941-00840794999e","t":"詠史詩 會稽山","a":"胡曾","d":"唐","g":"短诗","p":["越王兵敗已山棲，豈望全生出會稽。","何事夫差無遠慮，更開羅網放鯨鯢。"]},{"i":"553e7e40-3d8d-4167-b9e9-9ac2dbc803de","t":"詠史詩 不周山","a":"胡曾","d":"唐","g":"短诗","p":["共工爭帝力窮秋，因此捐生觸不周。","遂使世間多感客，至今哀怨水東流。"]},{"i":"cda7e67c-6e64-4e69-a68b-72def7dc0b0b","t":"詠史詩 虞坂","a":"胡曾","d":"唐","g":"短诗","p":["悠悠虞坂路欹斜，遲日和風簇野花。","未省孫陽身沒後，幾多騏驥困鹽車。"]},{"i":"86e49eba-77e5-42c9-a1c2-90a2a2351936","t":"詠史詩 秦庭","a":"胡曾","d":"唐","g":"短诗","p":["楚國君臣草莽間，吳王戈甲未東還。","包胥不動咸陽哭，爭得秦兵出武關。"]},{"i":"5509d47c-0ee8-4fbb-be9c-299e77a90e38","t":"詠史詩 延平津","a":"胡曾","d":"唐","g":"短诗","p":["延平津路水溶溶，峭壁巍岑一萬重。","昨夜七星潭底見，分明神劍化爲龍。"]},{"i":"d639934c-e35a-49a8-972f-5b1b22d0e2b9","t":"詠史詩 瑤池","a":"胡曾","d":"唐","g":"短诗","p":["阿母瑤池宴穆王，九天仙樂送瓊漿。","漫矜八駿行如電，歸到人間國已亡。"]},{"i":"54405bf9-eca3-4359-8277-360a11b913cb","t":"詠史詩 銅柱","a":"胡曾","d":"唐","g":"短诗","p":["一柱高標險塞垣，南蠻不敢犯中原。","功成自合分茅土，何事翻銜薏苡冤。"]},{"i":"67cfe4fc-f793-472c-9cf1-6a4d826835ba","t":"詠史詩 關西","a":"胡曾","d":"唐","g":"短诗","p":["楊震幽魂下北邙，關西蹤跡遂荒涼。","四知美譽留人世，應與乾坤共久長。"]},{"i":"5996c466-d41a-40ec-903b-56d82b3e3ca6","t":"詠史詩 高陽池","a":"胡曾","d":"唐","g":"短诗","p":["古人未遇即銜桮，所貴愁腸得酒開。","何事山公持玉節，等閑深入醉鄉來。"]},{"i":"bd6b374e-8dc8-49bd-9363-83ba767ea96e","t":"詠史詩 瀘水","a":"胡曾","d":"唐","g":"短诗","p":["五月驅兵入不毛，月明瀘水瘴煙高。","誓將雄略酬三顧，豈憚征蠻七縱勞。"]},{"i":"251e270e-c9ab-4d52-bb85-560570f12a70","t":"詠史詩 細柳營","a":"胡曾","d":"唐","g":"短诗","p":["文帝鑾輿勞北征，條侯此地整嚴兵。","轅門不峻將軍令，今日爭知細柳營。"]},{"i":"12c06865-5953-478a-86df-2ae3d927be97","t":"詠史詩 葉縣","a":"胡曾","d":"唐","g":"短诗","p":["葉公丘墓已塵埃，雲矗崇墉亦半摧。","借問往年龍見日，幾多風雨送將來。"]},{"i":"6d19a214-2fe2-4d97-8847-f2aa4e0eb652","t":"詠史詩 杜郵","a":"胡曾","d":"唐","g":"短诗","p":["自古功成禍亦侵，武安冤向杜郵深。","五湖煙月無窮水，何事遷延到陸沈。"]},{"i":"5e2305d3-6ec9-4139-b465-88758c2935ae","t":"詠史詩 柯亭","a":"胡曾","d":"唐","g":"短诗","p":["一宿柯亭月滿天，笛亡人沒事空傳。","中郎在世無甄別，爭得名垂爾許年。"]},{"i":"797d83fd-d95f-418b-b47b-ccdbc911200e","t":"詠史詩 葛陂","a":"胡曾","d":"唐","g":"短诗","p":["長房回到葛陂中，人已登真竹化龍。","莫道神仙難頓學，嵇生自是不遭逢。"]},{"i":"ef79bf6c-806d-4b90-a97d-94a4853fa650","t":"詠史詩 博浪沙","a":"胡曾","d":"唐","g":"短诗","p":["嬴政鯨吞六合秋，削平天下虜諸侯。","山東不是無公子，何事張良獨報讐。"]},{"i":"09c3190b-df4b-4342-ab58-4c4a981b22e5","t":"詠史詩 隴西","a":"胡曾","d":"唐","g":"短诗","p":["乘春來到隴山西，隗氏城荒碧草齊。","好笑王元不量力，函關那受一丸泥。"]},{"i":"fe911240-bb2b-46da-841f-44a66a46a399","t":"詠史詩 白帝城","a":"胡曾","d":"唐","g":"短诗","p":["蜀江一帶向東傾，江上巍峩白帝城。","自古山河歸聖主，子陽虛共漢家爭。"]},{"i":"ed4dcc77-2f07-4ce2-b2ce-18acf8fe4d02","t":"詠史詩 牛渚","a":"胡曾","d":"唐","g":"短诗","p":["溫嶠南歸輟棹晨，燃犀牛渚照通津。","誰知萬丈洪流下，更有朱衣躍馬人。"]},{"i":"64840efa-cfcf-48a1-b89a-96b32d050e54","t":"詠史詩 朝歌","a":"胡曾","d":"唐","g":"短诗","p":["長嗟墨翟少風流，急管繁弦似寇讐。","若解聞韶知肉味，朝歌欲到肯回頭。"]},{"i":"4da65b32-330f-4063-8691-2d91beda9ed9","t":"詠史詩 谷口","a":"胡曾","d":"唐","g":"短诗","p":["一旦天真逐水流，虎爭龍戰爲諸侯。","子真獨有煙霞趣，谷口耕鋤到白頭。"]},{"i":"afe48910-1cb8-47ca-b38b-70a65e3a53bd","t":"詠史詩 武陵溪","a":"胡曾","d":"唐","g":"短诗","p":["一溪春水徹雲根，流出桃花片片新。","若到長生是虛語，洞中爭得有秦人。"]},{"i":"d9387877-87e9-4437-96ea-a2901ad30202","t":"詠史詩 大澤","a":"胡曾","d":"唐","g":"短诗","p":["白蛇初斷路人通，漢祖龍泉血刃紅。","不是咸陽將瓦解，素靈那哭月明中。"]},{"i":"b7c039e6-77cd-4db3-b27f-4e32c830b822","t":"詠史詩 澠池","a":"胡曾","d":"唐","g":"短诗","p":["日照荒城芳草新，相如曾此挫強秦。","能令百二山河主，便作樽前擊缶人。"]},{"i":"cb4c81d1-250f-4421-b195-8e83c20edf9b","t":"詠史詩 峴山","a":"胡曾","d":"唐","g":"短诗","p":["曉日登臨感晉臣，古碑零落峴山春。","松間殘露頻頻滴，酷似當時墮淚人。"]},{"i":"db19b3af-8153-48ee-aa9c-af85a7004e15","t":"詠史詩 滎陽","a":"胡曾","d":"唐","g":"短诗","p":["漢祖東征屈未伸，滎陽失律紀生焚。","當時天下方龍戰，誰爲將軍作誄文。"]},{"i":"96b5b4a2-7913-46bc-86cf-fdadf2b51968","t":"詠史詩 長城","a":"胡曾","d":"唐","g":"短诗","p":["祖舜宗堯自太平，秦皇何事苦蒼生。","不知禍起蕭牆內，虛築防胡萬里城。"]},{"i":"ae401595-6d59-4369-a3e6-c4709af78d2e","t":"詠史詩 赤壁","a":"胡曾","d":"唐","g":"短诗","p":["烈火西焚魏帝旗，周郎開國虎爭時。","交兵不假揮長劍，已挫英雄百萬師。"]},{"i":"db6b15f0-c322-4fe9-84a8-97f26a84c702","t":"詠史詩 田橫墓","a":"胡曾","d":"唐","g":"短诗","p":["古墓崔巍約路岐，歌傳薤露到今時。","也知不去朝黃屋，祗爲曾烹酈食其。"]},{"i":"2cb29898-d09b-4c3d-95ec-de16b63c3af3","t":"詠史詩 青門","a":"胡曾","d":"唐","g":"短诗","p":["漢皇提劍滅咸秦，亡國諸侯盡是臣。","唯有東陵守高節，青門甘作種瓜人。"]},{"i":"9264904f-0f2b-4532-bcdd-b2ac5414168e","t":"詠史詩 姑蘇臺","a":"胡曾","d":"唐","g":"短诗","p":["吳王恃霸棄雄才，貪向姑蘇醉醁醅。","不覺錢塘江上月，一宵西送越兵來。"]},{"i":"9e922c90-92da-40b3-b3fc-ce2eb9f0a3be","t":"詠史詩 息城","a":"胡曾","d":"唐","g":"短诗","p":["息亡身入楚王家，回首春風一面花。","感舊不言長掩淚，秪應翻恨有容華。"]},{"i":"ec57e656-91cb-44ae-adeb-62d5aea66a40","t":"詠史詩 上蔡","a":"胡曾","d":"唐","g":"短诗","p":["上蔡東門狡兔肥，李斯何事忘南歸。","功成不解謀身退，直待雲陽血染衣。"]},{"i":"5b8a3515-3aa2-4bcb-b0b3-9dec1084ff4c","t":"詠史詩 武昌","a":"胡曾","d":"唐","g":"短诗","p":["王濬戈鋋發上流，武昌鴻業土崩秋。","思量鐵鎖真兒戲，誰爲吳王畫此籌。"]},{"i":"a4adf73b-b3d9-4ca7-bf8a-72a4aead0417","t":"詠史詩 鴻溝","a":"胡曾","d":"唐","g":"短诗","p":["虎倦龍疲白刃秋，兩分天下指鴻溝。","項王不覺英雄挫，欲向彭門醉玉樓。"]},{"i":"e091cd20-5a86-40f1-a161-3c954dc50ce5","t":"詠史詩 襃城","a":"胡曾","d":"唐","g":"短诗","p":["恃寵嬌多得自由，驪山舉火戲諸侯。","秪知一笑傾人國，不覺胡塵滿玉樓。"]},{"i":"ab19185a-59a9-4d36-870b-f5c091158e2a","t":"詠史詩 金陵","a":"胡曾","d":"唐","g":"短诗","p":["侯景長驅十萬人，可憐梁武坐蒙塵。","生前不得空王力，徒向金田自捨身。"]},{"i":"3c2a658e-428f-4c4f-b5bc-bceaae855db7","t":"詠史詩 洛陽","a":"胡曾","d":"唐","g":"短诗","p":["石勒童年有戰機，洛陽長嘯倚門時。","晉朝不是王夷甫，大智何由得預知。"]},{"i":"8e464d48-4850-41a3-85ca-e8d7b94f81cc","t":"詠史詩 番禺","a":"胡曾","d":"唐","g":"短诗","p":["重岡複嶺勢崔巍，一卒當關萬卒回。","不是大夫多辨說，尉他爭肯築朝臺。"]},{"i":"85969357-32ad-45f1-98ac-13f2e63e8d81","t":"詠史詩 汨羅","a":"胡曾","d":"唐","g":"短诗","p":["襄王不用直臣籌，放逐南來澤國秋。","自向波間葬魚腹，楚人徒倚濟川舟。"]},{"i":"9589c402-2cdb-4c65-8762-6ca899cdefc9","t":"詠史詩 彭澤","a":"胡曾","d":"唐","g":"短诗","p":["英傑那堪屈下僚，便栽門柳事蕭條。","鳳皇不共雞爭食，莫怪先生懶折腰。"]},{"i":"0f6c76bc-fa94-4363-9941-91d523bc026a","t":"詠史詩 涿鹿","a":"胡曾","d":"唐","g":"短诗","p":["涿鹿茫茫白草秋，軒轅曾此破蚩尤。","丹霞遙映祠前水，疑是成川血尚流。"]},{"i":"ce5739ad-e326-44b6-a97c-fb4550906ec9","t":"詠史詩 洞庭","a":"胡曾","d":"唐","g":"短诗","p":["五月扁舟過洞庭，魚龍吹浪水雲腥。","軒轅黃帝今何在，迴首巴山蘆葉青。"]},{"i":"91514ffb-c29d-4129-81e1-9d89cc13c7e7","t":"詠史詩 嶓冢","a":"胡曾","d":"唐","g":"短诗","p":["夏禹崩來一萬秋，水從嶓冢至今流。","當時若訴胼胝苦，更使何人別九州。"]},{"i":"bb0c1ccf-03ad-4af5-96a7-bccd914ad86a","t":"詠史詩 塗山","a":"胡曾","d":"唐","g":"短诗","p":["大禹塗山御座開，諸侯玉帛走如雷。","防風謾有專車骨，何事茲辰最後來。"]},{"i":"f60a0f37-66a9-4e17-967c-166478938f04","t":"詠史詩 商郊","a":"胡曾","d":"唐","g":"短诗","p":["鶯囀商郊百草新，殷湯遺蹟在荒榛。","誰知繼桀爲天子，便是當初祝網人。"]},{"i":"5cd3ed34-34eb-4290-9493-e1c747ba5540","t":"詠史詩 傅巖","a":"胡曾","d":"唐","g":"短诗","p":["巖前版築不求伸，方寸那希據要津。","自是武丁安寢夜，一宵宮裏夢賢人。"]},{"i":"e202e2ce-5825-4c84-b2fd-5f7ebbb28a52","t":"詠史詩 鉅橋","a":"胡曾","d":"唐","g":"短诗","p":["積粟成塵竟不開，誰知拒諫剖賢才。","武王兵起無人敵，遂作商郊一聚灰。"]},{"i":"0b6a1c60-0a12-44df-8e67-1369bd00c2a1","t":"詠史詩 首陽山","a":"胡曾","d":"唐","g":"短诗","p":["孤竹夷齊恥戰爭，望塵遮道請休兵。","首陽山倒爲平地，應始無人說姓名。"]},{"i":"4cf8ce9b-94c2-44c9-b963-ebbf3ddb96ab","t":"詠史詩 孟津","a":"胡曾","d":"唐","g":"短诗","p":["秋風颯颯孟津頭，立馬沙邊看水流。","見說武王東渡日，戎衣曾此叱陽侯。"]},{"i":"2bb1c3b5-a04e-47d0-8c1f-649d6aa14548","t":"詠史詩 流沙","a":"胡曾","d":"唐","g":"短诗","p":["七雄戈戟亂如麻，四海無人得坐家。","老氏却思天竺住，便將徐甲去流沙。"]},{"i":"9cae88c2-1d89-4855-9497-8cb441083011","t":"詠史詩 鄧城","a":"胡曾","d":"唐","g":"短诗","p":["鄧侯城壘漢江干，自謂深根百世安。","不用三甥謀楚計，臨危方覺噬臍難。"]},{"i":"c1084295-a1b0-4098-b207-4cab2e1df049","t":"詠史詩 召陵","a":"胡曾","d":"唐","g":"短诗","p":["小白匡周入楚郊，楚王雄霸亦咆哮。","不思管仲爲謀主，爭取言徵縮酒茅。"]},{"i":"2915ab6c-a9d3-42a9-85c8-066bffae9c3a","t":"詠史詩 綿山","a":"胡曾","d":"唐","g":"短诗","p":["親在要君召不來，亂山重疊使空迴。","如何堅執尤人意，甘向巖前作死灰。"]},{"i":"b353d75d-8f32-4b2b-836b-643f2f5a4887","t":"詠史詩 魯城","a":"胡曾","d":"唐","g":"短诗","p":["魯公城闕已丘墟，荒草無由認玉除。","因笑臧孫才智少，東門鐘鼓祀鶢鶋。"]},{"i":"86a43dc8-d6dd-4e6f-88ff-637aff6a0e29","t":"詠史詩 驌驦陂","a":"胡曾","d":"唐","g":"短诗","p":["行行西至一荒陂，因笑唐公不見機。","莫惜驌驦輸令尹，漢東宮闕早時歸。"]},{"i":"314907e2-1a54-48de-b066-ae103b41251b","t":"詠史詩 夾谷","a":"胡曾","d":"唐","g":"短诗","p":["夾谷鶯啼三月天，野花芳草整相鮮。","來時不見侏儒死，空笑齊人失措年。"]},{"i":"a7873bf4-4a85-47a9-bc03-22d8e13572af","t":"詠史詩 吳宮","a":"胡曾","d":"唐","g":"短诗","p":["草長黃池千里餘，歸來宗廟已丘墟。","出師不聽忠臣諫，徒恥窮泉見子胥。"]},{"i":"64af3efc-661d-49d8-a986-42a47d6da98d","t":"詠史詩 摩笄山","a":"胡曾","d":"唐","g":"短诗","p":["春草綿綿岱日低，山邊立馬看摩笄。","黃鶯也解追前事，來向夫人死處啼。"]},{"i":"beb93e81-a237-4a19-ab33-a0870c6f6fae","t":"詠史詩 房陵","a":"胡曾","d":"唐","g":"短诗","p":["趙王一旦到房陵，國破家亡百恨增。","魂斷叢臺歸不得，夜來明月爲誰升。"]},{"i":"c1fce6c1-e0d4-4f93-9d56-d478e48dd351","t":"詠史詩 濮水","a":"胡曾","d":"唐","g":"短诗","p":["青春行役思悠悠，一曲汀蒲濮水流。","正見塗中龜曳尾，令人特地感莊周。"]},{"i":"691edfc0-e4a9-41de-aad7-db757fd69c36","t":"詠史詩 柏舉","a":"胡曾","d":"唐","g":"短诗","p":["野田極目草茫茫，吳楚交兵此路傍。","誰料伍員入郢後，大開陵寢撻平王。"]},{"i":"b2aeef01-bbe1-4e9f-8732-864fcacc25eb","t":"詠史詩 望夫山","a":"胡曾","d":"唐","g":"短诗","p":["一上青山便化身，不知何代怨離人。","古來節婦皆銷朽，獨爾不爲泉下塵。"]},{"i":"0d1d6881-f415-46ec-a606-ba3282ce8b51","t":"詠史詩 金義嶺","a":"胡曾","d":"唐","g":"短诗","p":["鑿開山嶺引湘波，上去昭回不較多。","無限鵲臨橋畔立，適來天道過天河。"]},{"i":"e0b6fc43-e463-4797-b7d9-03035b1bc914","t":"詠史詩 云云亭","a":"胡曾","d":"唐","g":"短诗","p":["一上高亭日正晡，青山重疊片雲無。","萬年松樹不知數，若箇蚪枝是大夫。"]},{"i":"5b947022-7373-4ec6-b413-8de600ca9d0f","t":"詠史詩 阿房宮","a":"胡曾","d":"唐","g":"短诗","p":["新建阿房壁未乾，沛公兵已入長安。","帝王苦竭生靈力，大業沙崩固不難。"]},{"i":"eab4e94b-055d-4c90-9ead-e369fd0a3837","t":"詠史詩 沙丘","a":"胡曾","d":"唐","g":"短诗","p":["年年遊覽不曾停，天下山川欲遍經。","堪笑沙丘纔過處，鑾輿風過鮑魚腥。"]},{"i":"bd58fb29-15c0-473f-87cf-773c21a471fc","t":"詠史詩 咸陽","a":"胡曾","d":"唐","g":"短诗","p":["一朝閻樂統羣兇，二世朝廷掃地空。","唯有渭川流不盡，至今猶繞望夷宮。"]},{"i":"f960b161-be0d-4a26-8621-467f5ad48f8f","t":"詠史詩 廢丘山","a":"胡曾","d":"唐","g":"短诗","p":["此水雖非禹鑿開，廢丘山下重縈迴。","莫言只解東流去，曾使章邯自殺來。"]},{"i":"5f357246-459f-4780-87e6-3b981681db26","t":"詠史詩 廣武山","a":"胡曾","d":"唐","g":"短诗","p":["數罪楚師應奪氣，底須多論破深艱。","倉皇鬬智成何語，遺笑當時廣武山。"]},{"i":"0deed735-e88d-4b59-850f-0f78a6f742e4","t":"詠史詩 長安","a":"胡曾","d":"唐","g":"短诗","p":["關東新破項王歸，赤幟悠揚日月旗。","從此漢家無敵國，爭教彭越受誅夷。"]},{"i":"3951f2c3-079d-4680-b351-f8946c6cb906","t":"詠史詩 鴻門","a":"胡曾","d":"唐","g":"短诗","p":["項籍鷹揚六合晨，鴻門開宴賀亡秦。","樽前若取謀臣計，豈作陰陵失路人。"]},{"i":"a8e8a4d6-2ff7-4fb0-81de-c74b7a8d358a","t":"詠史詩 漢中","a":"胡曾","d":"唐","g":"短诗","p":["荆棘蒼蒼漢水湄，將壇煙草覆餘基。","適來投石空江上，猶似龍顏納諫時。"]},{"i":"7ff4cc76-df94-4c2f-b943-7f857434af41","t":"詠史詩 泜水","a":"胡曾","d":"唐","g":"短诗","p":["韓信經營按鏌铘，臨戎叱咤有誰加。","猶疑轉戰逢勍敵，更向軍中問左車。"]},{"i":"ac96e898-32cf-4b8b-bd49-2464b72a0ae0","t":"詠史詩 雲夢","a":"胡曾","d":"唐","g":"短诗","p":["漢祖聽讒不可防，僞遊韓信果罹殃。","十年辛苦平天下，何事生擒入帝鄉。"]},{"i":"301228bb-b4a9-4034-9a51-44b0d3060007","t":"詠史詩 高陽","a":"胡曾","d":"唐","g":"短诗","p":["路入高陽感酈生，逢時長揖便論兵。","最憐伏軾東遊日，下盡齊王七十城。"]},{"i":"1ce074b4-f73b-4b60-a075-80d2c301e8ac","t":"詠史詩 四皓廟","a":"胡曾","d":"唐","g":"短诗","p":["四皓忘機飲碧松，石巖雲殿隱高蹤。","不知俱出龍樓後，多在商山第幾重。"]},{"i":"699d92a4-5707-4dae-96db-24767b82a07c","t":"詠史詩 霸陵","a":"胡曾","d":"唐","g":"短诗","p":["原頭日落雪邊雲，猶放韓盧逐兔羣。","況是四方無事日，霸陵誰識舊將軍。"]},{"i":"efbcdbfb-6307-45d0-820c-1d18df752e70","t":"詠史詩 昆明池","a":"胡曾","d":"唐","g":"短诗","p":["欲出昆明萬里師，漢皇習戰此穿池。","如何一面圖攻取，不念生靈氣力疲。"]},{"i":"f8c4b9bc-b775-4fa1-b186-ac41d37992b7","t":"詠史詩 迴中","a":"胡曾","d":"唐","g":"短诗","p":["武皇無路及昆丘，青鳥西沈隴樹秋。","欲問生前躬祀日，幾煩龍駕到涇州。"]},{"i":"98ac4269-52bf-4fd8-b8bf-578e2e7765a9","t":"詠史詩 東門","a":"胡曾","d":"唐","g":"短诗","p":["何人知足反田廬，玉管東門餞二疏。","豈是不榮天子祿，後賢那使久閑居。"]},{"i":"4801c0d9-52d1-4bd3-a263-c3ebbb002599","t":"詠史詩 射熊館","a":"胡曾","d":"唐","g":"短诗","p":["漢帝荒唐不解憂，大誇田獵廢農收。","子雲徒獻長楊賦，肯念高皇沐雨秋。"]},{"i":"bd9066c4-64a1-44ea-b9b7-c71b04eaf807","t":"詠史詩 昆陽","a":"胡曾","d":"唐","g":"短诗","p":["師克由來在協和，蕭王兵馬固無多。","誰知大敵昆陽敗，却笑前朝困楚歌。"]},{"i":"25e28997-3e96-4c7b-bec4-6a0c7b5361eb","t":"詠史詩 七里灘","a":"胡曾","d":"唐","g":"短诗","p":["七里青灘映碧層，九天星象感嚴陵。","釣魚臺上無絲竹，不是高人誰解登。"]},{"i":"7932689a-6c71-4120-838f-b1233f5f959d","t":"詠史詩 潁川","a":"胡曾","d":"唐","g":"短诗","p":["古賢高尚不爭名，行止由來動杳冥。","今日浪爲千里客，看花慙上德星亭。"]},{"i":"5302460c-2666-4f95-96b5-3c76e4a1497b","t":"詠史詩 江夏","a":"胡曾","d":"唐","g":"短诗","p":["黃祖才非長者儔，禰衡珠碎此江頭。","今來鸚鵡洲邊過，惟有無情碧水流。"]},{"i":"e0d2b11b-73ed-41d6-adab-de9ac7d5e227","t":"詠史詩 官渡","a":"胡曾","d":"唐","g":"短诗","p":["本初屈指定中華，官渡相持勒虎牙。","若使許攸財用足，山河爭得屬曹家。"]},{"i":"b68b35df-a8e0-4f72-b82b-051b09958349","t":"詠史詩 灞岸","a":"胡曾","d":"唐","g":"短诗","p":["長安城外白雲秋，蕭索悲風灞水流。","因想漢朝離亂日，仲宣從此向荆州。"]},{"i":"0c9c5f7c-00fe-4d24-a95c-aa09b963ef79","t":"詠史詩 濡須橋","a":"胡曾","d":"唐","g":"短诗","p":["徒向濡須欲受降，英雄才略獨無雙。","天心不與金陵便，高步何由得渡江。"]},{"i":"b27ab6de-7501-4cc2-987b-afddf703bfd6","t":"詠史詩 豫州","a":"胡曾","d":"唐","g":"短诗","p":["策馬行行到豫州，祖生寂寞水空流。","當時更有三年壽，石勒尋爲關下囚。"]}]