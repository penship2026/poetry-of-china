[{"i":"71094f9c-6a99-4ac2-aa15-2fe64d977b0e","t":"比紅兒詩 十五","a":"羅虬","d":"唐","g":"短诗","p":["芳姿不合竝常人，雲在遙天玉在塵。","因事愛思荀奉倩，一生閑坐枉傷神。"],"s":"mixed","f":"simp"},{"i":"40abf11d-56dc-44dd-bbf5-b7e08d0fc020","t":"比紅兒詩 十六","a":"羅虬","d":"唐","g":"短诗","p":["筆底如風思湧泉，賦中休謾說嬋娟。","紅兒若在東家住，不得登牆爾許年。"],"s":"mixed","f":"simp"},{"i":"75a198bc-6224-4a92-8d2d-a2c0733a8606","t":"比紅兒詩 十七","a":"羅虬","d":"唐","g":"短诗","p":["一抹濃紅傍臉斜，妝成不語獨攀花。","當時若是逢韓壽，未必埋蹤在賈家。"],"s":"mixed","f":"simp"},{"i":"f68ba854-2bc3-4cb3-954e-1650e07019de","t":"比紅兒詩 十八","a":"羅虬","d":"唐","g":"短诗","p":["樹褭西風日半沈，地無人跡轉傷心。","阿嬌得似紅兒貌，不費長門買賦金。"],"s":"mixed","f":"simp"},{"i":"833f445e-49b4-4e6a-a22c-2220fda9592c","t":"比紅兒詩 十九","a":"羅虬","d":"唐","g":"短诗","p":["五雲高捧紫金堂，花下投壺侍玉皇。","從到世人都不識，也應知有杜蘭香。"],"s":"mixed","f":"simp"},{"i":"c6323813-4218-4833-b157-c4e8446059ed","t":"比紅兒詩 二十","a":"羅虬","d":"唐","g":"短诗","p":["戲水源頭指舊蹤，當時一笑也難逢。","紅兒若爲迴桃臉，豈比連催舉五烽。"],"s":"mixed","f":"simp"},{"i":"c834af82-e5c3-4010-8a90-16b0a8ceaa85","t":"比紅兒詩 二十一","a":"羅虬","d":"唐","g":"短诗","p":["虢國夫人照夜璣，若爲求得與紅兒。","醉和香態濃春睡，一樹繁花偃繡幃。"],"s":"mixed","f":"simp"},{"i":"9062b081-3c60-4e36-acc6-070e13201bcd","t":"比紅兒詩 二十二","a":"羅虬","d":"唐","g":"短诗","p":["知有持盈玉葉冠，剪雲裁月照人寒。","若使紅兒風帽戴，直使瑤池會上看。"],"s":"mixed","f":"simp"},{"i":"c74506df-e921-410d-874b-11e42400bf96","t":"比紅兒詩 二十三","a":"羅虬","d":"唐","g":"短诗","p":["明媚何曾讓玉環，破瓜年幾百花顏。","若教貌向南朝見，定却梅妝似等閑。"],"s":"mixed","f":"simp"},{"i":"11113a24-3cc2-47cd-9399-012923dec033","t":"比紅兒詩 二十四","a":"羅虬","d":"唐","g":"短诗","p":["世事悠悠未足稱，肯將閑事更爭能。","自從命向紅兒去，不欲留心在裂繒。"],"s":"mixed","f":"simp"},{"i":"8ffd2413-b20f-4710-a3ee-afa1e39aa918","t":"比紅兒詩 二十五","a":"羅虬","d":"唐","g":"短诗","p":["自隱新從夢裏來，嶺雲微步下陽臺。","含情一向春風笑，羞殺凡花盡不開。"],"s":"mixed","f":"simp"},{"i":"d92efa0b-11ef-443a-9cd5-612833296cda","t":"比紅兒詩 二十六","a":"羅虬","d":"唐","g":"短诗","p":["捨却青娥換玉鞍，古來公子苦無端。","莫言一匹追風馬，天驥牽來也不看。"],"s":"mixed","f":"simp"},{"i":"cd2b35df-290f-4d2d-a235-a4923a92a7c2","t":"比紅兒詩 二十七","a":"羅虬","d":"唐","g":"短诗","p":["檻外花低瑞露濃，夢魂驚覺暈春容。","憑君細看紅兒貌，最稱嚴妝待曉鐘。"],"s":"mixed","f":"simp"},{"i":"81634d75-7372-4294-9331-a5b7ea26cc6d","t":"比紅兒詩 二十八","a":"羅虬","d":"唐","g":"短诗","p":["薄羅輕剪越溪紋，鵶翅低垂兩鬢分。","料得相如偷見面，不應琴裏挑文君。"],"s":"mixed","f":"simp"},{"i":"ff8cf61c-defd-4151-b745-b36f404c7737","t":"比紅兒詩 二十九","a":"羅虬","d":"唐","g":"短诗","p":["南國東隣各一時，後來惟有杜紅兒。","若教楚國宮人見，羞把腰身竝柳枝。"],"s":"mixed","f":"simp"},{"i":"a363e26a-4d65-4c65-a69d-8096adc4850a","t":"比紅兒詩 三十","a":"羅虬","d":"唐","g":"短诗","p":["照耀金釵簇膩鬟，見時直向畫屏間。","黃姑阿母能判剖，十斛明珠也是閑。"],"s":"mixed","f":"simp"},{"i":"b15ca13f-c7b1-4cf8-8284-5a06537b49e1","t":"比紅兒詩 三十一","a":"羅虬","d":"唐","g":"短诗","p":["輕小休誇似燕身，生來占斷紫宮春。","漢皇若遇紅兒貌，掌上無因著別人。"],"s":"mixed","f":"simp"},{"i":"627645b2-64f5-4820-85cd-f632ee91aaee","t":"比紅兒詩 三十二","a":"羅虬","d":"唐","g":"短诗","p":["鸚鵡娥如裛露紅，鏡前眉樣自深宮。","稍教得似紅兒貌，不嫁南朝沈侍中。"],"s":"mixed","f":"simp"},{"i":"623cddfa-c76d-4124-9990-09e6312f3711","t":"比紅兒詩 三十三","a":"羅虬","d":"唐","g":"短诗","p":["擬將心地學安禪，爭奈紅兒笑靨圓。","何物把來堪比竝，野塘初綻一枝蓮。"],"s":"mixed","f":"simp"},{"i":"9843b04e-e2b7-412a-b732-2d251495ac7a","t":"比紅兒詩 三十四","a":"羅虬","d":"唐","g":"短诗","p":["浸草漂花遶檻香，最憐穿度樂營牆。","殷勤留滯緣何事，曾照紅兒一面妝。"],"s":"mixed","f":"simp"},{"i":"189c44ee-665f-45a3-8b91-a84d9da849e2","t":"比紅兒詩 三十五","a":"羅虬","d":"唐","g":"短诗","p":["雕陰舊俗騁嬋娟，有箇紅兒賽洛川。","常笑世人語虛誕，今朝自見火中蓮。"],"s":"mixed","f":"simp"},{"i":"9b067cf3-276d-4ccd-83ec-e2d66ffe4021","t":"比紅兒詩 三十六","a":"羅虬","d":"唐","g":"短诗","p":["渡口諸儂樂未休，竟陵西望路悠悠。","石城有箇紅兒貌，兩槳無因迎莫愁。"],"s":"mixed","f":"simp"},{"i":"d517df33-bcf1-48bd-a07f-2e10fec94ffe","t":"比紅兒詩 三十七","a":"羅虬","d":"唐","g":"短诗","p":["誰向深山識大仙，勸人山上引春泉。","定知不及紅兒貌，枉却工夫溉玉田。"],"s":"mixed","f":"simp"},{"i":"5adb67da-9cfd-4916-872c-f82ac3a62493","t":"比紅兒詩 三十八","a":"羅虬","d":"唐","g":"短诗","p":["傾國傾城總絕倫，紅兒花下認真身。","十年東北看燕趙，眼冷何曾見一人。"],"s":"mixed","f":"simp"},{"i":"c21c4e63-d934-4719-88db-eaed333e426b","t":"比紅兒詩 三十九","a":"羅虬","d":"唐","g":"短诗","p":["今時自是不諳知，前代由來豈見遺。","一笑陽城人便惑，何堪教見杜紅兒。"],"s":"mixed","f":"simp"},{"i":"60763208-6856-45d6-a7dc-9c2f5b96c92f","t":"比紅兒詩 四十","a":"羅虬","d":"唐","g":"短诗","p":["京口喧喧百萬人，競傳河鼓謝星津。","柰花似雪簪雲髻，今日夭容是後身。"],"s":"mixed","f":"simp"},{"i":"6853996b-8008-4218-932d-23146c75f435","t":"比紅兒詩 四十一","a":"羅虬","d":"唐","g":"短诗","p":["青史書時未是真，可能纖手却強秦。","再三爲謝齊皇后，要解連環別與人。"],"s":"mixed","f":"simp"},{"i":"b9a05bd4-c0d5-4efc-978f-0ab75f28d17e","t":"比紅兒詩 四十二","a":"羅虬","d":"唐","g":"短诗","p":["繡帳鴛鴦對刺紋，博山微暖麝微曛。","詩成若有紅兒貌，悔道當時月墜雲。"],"s":"mixed","f":"simp"},{"i":"e18eed56-1004-4ae4-a450-4a24348621c7","t":"比紅兒詩 四十三","a":"羅虬","d":"唐","g":"短诗","p":["薄粉輕朱取次施，大都端正亦相宜。","只如花下紅兒態，不籍城中半額眉。"],"s":"mixed","f":"simp"},{"i":"5f1a4414-794e-4462-a2c9-f5a6cb13d863","t":"比紅兒詩 四十四","a":"羅虬","d":"唐","g":"短诗","p":["妝成渾欲認前朝，金鳳雙釵逐步搖。","未必慕容宮裏伴，舞風歌月勝纖腰。"],"s":"mixed","f":"simp"},{"i":"686ee78b-ebc0-49b0-8045-e04f38340e06","t":"比紅兒詩 四十五","a":"羅虬","d":"唐","g":"短诗","p":["琥珀釵成恩正深，玉兒妖惑蕩君心。","莫教回首看妝面，始覺曾虛擲萬金。"],"s":"mixed","f":"simp"},{"i":"61220555-4104-41af-a341-0954c6bc0c30","t":"比紅兒詩 四十六","a":"羅虬","d":"唐","g":"短诗","p":["自有閑花一面春，臉檀眉黛一時新。","殷勤爲報梁家婦，休把啼妝賺後人。"],"s":"mixed","f":"simp"},{"i":"f452cb4d-099d-4e88-b391-055d482008bc","t":"比紅兒詩 四十七","a":"羅虬","d":"唐","g":"短诗","p":["輕梳小髻號慵來，巧中君心不用媒。","可得紅兒拋醉眼，漢皇恩澤一時迴。"],"s":"mixed","f":"simp"},{"i":"1abaaf29-3b56-4be0-8906-e3b0f7c6ad24","t":"比紅兒詩 四十八","a":"羅虬","d":"唐","g":"短诗","p":["千里長江旦暮潮，吳都風俗尚纖腰。","周郎若見紅兒貌，料得無心念小喬。"],"s":"mixed","f":"simp"},{"i":"2c3a3140-008a-4177-b3f9-ebc10885dc1b","t":"比紅兒詩 四十九","a":"羅虬","d":"唐","g":"短诗","p":["月落潛奔暗解攜，本心誰道獨單棲。","還緣交甫非良偶，不肯終身作羿妻。"],"s":"mixed","f":"simp"},{"i":"0c9d3e0c-1b70-4fa5-a14f-12f4082c4670","t":"比紅兒詩 五十","a":"羅虬","d":"唐","g":"短诗","p":["漢皇曾識許飛瓊，寫向人間作畫屏。","昨日紅兒花下見，大都相似更娉婷。"],"s":"mixed","f":"simp"},{"i":"db74640f-a50d-4153-a58e-ea43021c052f","t":"比紅兒詩 五十一","a":"羅虬","d":"唐","g":"短诗","p":["魏帝休誇薛夜來，霧綃雲縠稱身裁。","紅兒秀發君知否，倚檻繁花帶露開。"],"s":"mixed","f":"simp"},{"i":"f8d9d76c-f8fd-4dcc-8b41-d70b7a467bc2","t":"比紅兒詩 五十二","a":"羅虬","d":"唐","g":"短诗","p":["曉月雕梁燕語頻，見花難可比他人。","年年媚景歸何處，長作紅兒面上春。"],"s":"mixed","f":"simp"},{"i":"e7d67ecd-260f-4b51-879d-29d2005c79b3","t":"比紅兒詩 五十三","a":"羅虬","d":"唐","g":"短诗","p":["逗玉濺盆冬殿開，邀恩先賜夜明苔。","紅兒若是三千數，多少芳心似死灰。"],"s":"mixed","f":"simp"},{"i":"bff2ad0f-01bd-4767-a4cb-18accd30dd0e","t":"比紅兒詩 五十四","a":"羅虬","d":"唐","g":"短诗","p":["畫簾垂地紫金牀，暗引羊車駐七香。","若見紅兒此中住，不勞鹽篠灑宮廊。"],"s":"mixed","f":"simp"},{"i":"4e11b141-5dd2-419f-9472-8d4549262993","t":"比紅兒詩 五十五","a":"羅虬","d":"唐","g":"短诗","p":["蘇小空勻一面妝，便留名字在錢塘。","藏鴉門外諸年少，不識紅兒未是狂。"],"s":"mixed","f":"simp"},{"i":"03bb4352-a77c-4c6a-8cbf-f71c21d2ff31","t":"比紅兒詩 五十六","a":"羅虬","d":"唐","g":"短诗","p":["一首長歌萬恨來，惹愁漂泊水難迴。","崔徽有底多頭面，費得微之爾許才。"],"s":"mixed","f":"simp"},{"i":"02c31b55-f809-4dd9-a006-4e6a1214a422","t":"比紅兒詩 五十七","a":"羅虬","d":"唐","g":"短诗","p":["昔年黃閣識奇章，愛說真珠似窈娘。","若見紅兒深夜態，便應休說繡衣裳。"],"s":"mixed","f":"simp"},{"i":"08e4d798-aa70-4179-99e9-3dba785c10c9","t":"比紅兒詩 五十八","a":"羅虬","d":"唐","g":"短诗","p":["鳳折鶯離恨轉深，此身難負百年心。","紅兒若向隋朝見，破鏡無因更重尋。"],"s":"mixed","f":"simp"},{"i":"35feb6ed-2694-451f-8254-7576f6f229a3","t":"比紅兒詩 五十九","a":"羅虬","d":"唐","g":"短诗","p":["行綰穠雲立暗軒，我來猶愛不成冤。","當時若見紅兒貌，未必邢相有此言。"],"s":"mixed","f":"simp"},{"i":"a39eba98-7a5e-46e9-8ec9-990243e699ea","t":"比紅兒詩 六十","a":"羅虬","d":"唐","g":"短诗","p":["總似紅兒媚態新，莫論千度笑爭春。","任伊孫武心如鐵，不辦軍前殺此人。"],"s":"mixed","f":"simp"},{"i":"d48789da-224e-4c28-b630-2bce485affda","t":"比紅兒詩 六十一","a":"羅虬","d":"唐","g":"短诗","p":["暖塘爭赴盪舟期，行唱菱歌著豔詞。","爲問東山謝丞相，可能諸妓勝紅兒。"],"s":"mixed","f":"simp"},{"i":"60476b3f-0089-44e1-8880-e5876543c785","t":"比紅兒詩 六十二","a":"羅虬","d":"唐","g":"短诗","p":["吳興皇后欲辭家，澤國重臺展曙華。","今日紅兒貌傾國，恐須真宰別開花。"],"s":"mixed","f":"simp"},{"i":"fe095972-9ef0-45b2-8213-6f066927cebe","t":"比紅兒詩 六十三","a":"羅虬","d":"唐","g":"短诗","p":["陌上行人歌黍離，三千門客欲何之。","若教麤及紅兒貌，爭取樓前斬愛姬。"],"s":"mixed","f":"simp"},{"i":"0cb44b2a-bcf7-4327-a02f-9f7c2a56127f","t":"比紅兒詩 六十四","a":"羅虬","d":"唐","g":"短诗","p":["休話如臯一笑時，金𩩉中臆錦離披。","陋容枉把雕弓射，射盡春禽未展眉。"],"s":"mixed","f":"simp"},{"i":"1677f456-809b-4acf-bee7-92e21aa1aeda","t":"比紅兒詩 六十五","a":"羅虬","d":"唐","g":"短诗","p":["長恨西風送早秋，低眉深恨嫁牽牛。","若同人世長相對，爭作夫妻得到頭。"],"s":"mixed","f":"simp"},{"i":"a20fb73b-3a5f-4bb4-bc7a-933aacc30635","t":"比紅兒詩 六十六","a":"羅虬","d":"唐","g":"短诗","p":["謝娘休漫逞風姿，未必娉婷勝柳枝。","聞道只因嘲落絮，何曾得似杜紅兒。"],"s":"mixed","f":"simp"},{"i":"67758da2-9aea-4fa8-88a0-9d6b82569838","t":"比紅兒詩 六十七","a":"羅虬","d":"唐","g":"短诗","p":["總傳桃葉渡江時，只爲王家一首詩。","今日紅兒自堪賦，不須重唱舊來詞。"],"s":"mixed","f":"simp"},{"i":"66ccfeaf-0afe-4c08-b371-f7942d73007c","t":"比紅兒詩 六十八","a":"羅虬","d":"唐","g":"短诗","p":["巫山洛浦本無情，總爲佳人便得名。","今日雕陰有神豔，後來公子莫相輕。"],"s":"mixed","f":"simp"},{"i":"3fe95965-0127-46a7-b2ef-0186448ac23a","t":"比紅兒詩 六十九","a":"羅虬","d":"唐","g":"短诗","p":["幾拋雲髻恨金墉，淚洗花顏百戰中。","應有紅兒些子貌，却言皇后長深宮。"],"s":"mixed","f":"simp"},{"i":"ac8f3200-c886-436f-8470-2fbc40cee571","t":"比紅兒詩 七十","a":"羅虬","d":"唐","g":"短诗","p":["倚檻還應有所思，半開東閣見嬌姿。","可中得似紅兒貌，若遇韓朋好殺伊。"],"s":"mixed","f":"simp"},{"i":"76961a46-727f-45a9-9aed-67c63058dd6f","t":"比紅兒詩 七十一","a":"羅虬","d":"唐","g":"短诗","p":["曉向妝臺與畫眉，鏡中長欲助嬌姿。","若教得似紅兒貌，走馬章臺任道遲。"],"s":"mixed","f":"simp"},{"i":"e1c1e4a3-4c1e-43e9-ad6f-7a692b8de559","t":"比紅兒詩 七十二","a":"羅虬","d":"唐","g":"短诗","p":["練得霜華助翠鈿，相期朝謁玉皇前。","依稀有似紅兒貌，方得吹簫引上天。"],"s":"mixed","f":"simp"},{"i":"64593fe3-27b3-4486-8c73-e7472cfde4df","t":"比紅兒詩 七十三","a":"羅虬","d":"唐","g":"短诗","p":["重門深掩幾枝花，未勝紅兒莫大誇。","王相不能探物理，可能虛上短轅車。"],"s":"mixed","f":"simp"},{"i":"1b44fbc3-93bc-4bc6-b9a7-8ca466d19e29","t":"比紅兒詩 七十四","a":"羅虬","d":"唐","g":"短诗","p":["前代休憐事可奇，後來還出有光輝。","爭知晝臥紗窗裏，不見神人覆玉衣。"],"s":"mixed","f":"simp"},{"i":"96fc80c7-a798-4841-9e5c-871f58d06737","t":"比紅兒詩 七十五","a":"羅虬","d":"唐","g":"短诗","p":["化羽嘗聞赴九天，只疑塵世是虛傳。","自從一見紅兒貌，始信人間有謫仙。"],"s":"mixed","f":"simp"},{"i":"270caa14-0611-4c73-bd14-8215fa28e39d","t":"比紅兒詩 七十六","a":"羅虬","d":"唐","g":"短诗","p":["從道長陵小市東，巧將花貌占春風。","紅兒若是同時見，未必伊先入紫宮。"],"s":"mixed","f":"simp"},{"i":"40ef3ea3-22a6-461f-8a2b-a011ebf8c718","t":"比紅兒詩 七十七","a":"羅虬","d":"唐","g":"短诗","p":["人間難免是深情，命斷紅兒向此生。","不似前時李丞相，枉拋才力爲鶯鶯。"],"s":"mixed","f":"simp"},{"i":"f5662a5a-00f1-4a52-82ce-9835a0a76cb5","t":"比紅兒詩 七十八","a":"羅虬","d":"唐","g":"短诗","p":["鳳舞香飄繡幕風，暖穿馳道百花中。","還緣有似紅兒貌，始道迎將入漢宮。"],"s":"mixed","f":"simp"},{"i":"b3125e54-d800-4281-a2b2-595040e7e60b","t":"比紅兒詩 七十九","a":"羅虬","d":"唐","g":"短诗","p":["休道將軍出世才，盡驅諸妓下歌臺。","都緣沒箇紅兒貌，致使輕教後閣開。"],"s":"mixed","f":"simp"},{"i":"ea6278f0-3327-43cf-882e-cf82ad2291f8","t":"比紅兒詩 八十","a":"羅虬","d":"唐","g":"短诗","p":["馮媛須知住漢宮，將身只是解當熊。","不聞有貌傾人國，爭得今朝更似紅。"],"s":"mixed","f":"simp"},{"i":"1cf8b684-301f-4668-a0e9-4a33cc2cdd5b","t":"比紅兒詩 八十一","a":"羅虬","d":"唐","g":"短诗","p":["能將一笑使人迷，花豔何須上大堤。","疎屬便同巫峽路，洛川真是武陵溪。"],"s":"mixed","f":"simp"},{"i":"caeb49a8-5819-4799-8546-62e2ee95937d","t":"比紅兒詩 八十二","a":"羅虬","d":"唐","g":"短诗","p":["辭輦當時意可知，寵深還恐寵先衰。","若教得似紅兒貌，占却君恩自不疑。"],"s":"mixed","f":"simp"},{"i":"a132ad66-a7f5-4cf8-9039-501234b07c27","t":"比紅兒詩 八十三","a":"羅虬","d":"唐","g":"短诗","p":["三吳時俗重風光，未見紅兒一面妝。","好寫妖嬈與教看，便應休更話真娘。"],"s":"mixed","f":"simp"},{"i":"68602aae-0354-44a5-8a0e-b55e9b4abd68","t":"比紅兒詩 八十四","a":"羅虬","d":"唐","g":"短诗","p":["波平楚澤浸星辰，臺上君王宴早春。","畢竟章華會中客，冠纓虛絕爲何人。"],"s":"mixed","f":"simp"},{"i":"74becf1f-4f55-4e40-8fd0-09c0e72ab1c7","t":"比紅兒詩 八十五","a":"羅虬","d":"唐","g":"短诗","p":["紅兒不向漢宮生，便使雙成謾得名。","疑是麻姑惱塵世，暫教微步下層城。"],"s":"mixed","f":"simp"},{"i":"4c9a0923-b63d-455a-9cc1-368f7e90b72b","t":"比紅兒詩 八十六","a":"羅虬","d":"唐","g":"短诗","p":["天碧輕紗只六銖，宛如含露透肌膚。","便教漢曲爭明媚，應沒心情更弄珠。"],"s":"mixed","f":"simp"},{"i":"531e9264-c993-4084-a4b3-e79170015596","t":"比紅兒詩 八十七","a":"羅虬","d":"唐","g":"短诗","p":["共嗟含恨向衡陽，方寸花牋寄沈郎。","不似紅兒些子貌，當時爭得少年狂。"],"s":"mixed","f":"simp"},{"i":"8761ab06-216f-4fbe-8466-c98068fee128","t":"比紅兒詩 八十八","a":"羅虬","d":"唐","g":"短诗","p":["淺色桃花亞短牆，不因風送也聞香。","凝情盡日君知否，還似紅兒淡薄妝。"],"s":"mixed","f":"simp"},{"i":"77499824-5ddf-4770-a8b8-8b672e085fe6","t":"比紅兒詩 八十九","a":"羅虬","d":"唐","g":"短诗","p":["火色櫻桃摘得初，仙宮只有世間無。","凝情盡日君知否，真似紅兒口上朱。"],"s":"mixed","f":"simp"},{"i":"ca1b9c5f-e95d-4d6c-9558-1d00e4c7c7e3","t":"比紅兒詩 九十","a":"羅虬","d":"唐","g":"短诗","p":["宿雨初晴春日長，入簾花氣靜難忘。","凝情盡日君知否，真似紅兒舞袖香。"],"s":"mixed","f":"simp"},{"i":"0a695742-0317-47a5-99b4-c7cc028a3d94","t":"比紅兒詩 九十一","a":"羅虬","d":"唐","g":"短诗","p":["初月纖纖映碧池，池波不動獨看時。","凝情盡日君知否，真似紅兒罷舞眉。"],"s":"mixed","f":"simp"},{"i":"7f579f6a-a7aa-435f-bdb2-bfa4cd421587","t":"比紅兒詩 九十二","a":"羅虬","d":"唐","g":"短诗","p":["濃豔濃香雪壓枝，褭煙和露曉風吹。","紅兒被掩妝成後，含笑無人獨立時。"],"s":"mixed","f":"simp"},{"i":"ceff3574-8f5e-49c1-a037-29e15bf87d54","t":"比紅兒詩 九十三","a":"羅虬","d":"唐","g":"短诗","p":["樓上嬌歌褭夜霜，近來休數踏歌娘。","紅兒謾唱伊州遍，認取輕敲玉韻長。"],"s":"mixed","f":"simp"},{"i":"e3e0be92-8f86-4b4d-b95c-1cb17d15eb77","t":"比紅兒詩 九十四","a":"羅虬","d":"唐","g":"短诗","p":["金粟妝成扼臂環，舞腰輕薄瑞雲間。","紅兒生在開元末，羞殺新豐謝阿蠻。"],"s":"mixed","f":"simp"},{"i":"c6468afd-ebea-42a5-8cc3-a767699ea31e","t":"比紅兒詩 九十五","a":"羅虬","d":"唐","g":"短诗","p":["君看紅兒學醉妝，誇裁宮襭砑裙長。","誰能更把閑心力，比竝當時武媚娘。"],"s":"mixed","f":"simp"},{"i":"d46b6a56-03a6-4c4d-8215-5f52e02caab4","t":"比紅兒詩 九十六","a":"羅虬","d":"唐","g":"短诗","p":["梔子同心裛露垂，折來深恐沒人知。","花前醉客頻相問，不贈紅兒贈阿誰。"],"s":"mixed","f":"simp"},{"i":"84413e00-9309-4525-a6ad-667060ae69e2","t":"比紅兒詩 九十七","a":"羅虬","d":"唐","g":"短诗","p":["雲間翡翠一雙飛，水上鴛鴦不暫離。","寫向人間百般態，與君題作比紅詩。"],"s":"mixed","f":"simp"},{"i":"ea19a565-d34a-459a-b5f0-46a40c89078e","t":"比紅兒詩 九十八","a":"羅虬","d":"唐","g":"短诗","p":["舊恨長懷不語中，幾回偷泣向春風。","還緣不及紅兒貌，却得生教入楚宮。"],"s":"mixed","f":"simp"},{"i":"d1cde0ca-ca8b-4752-9a84-7a476dfa041e","t":"比紅兒詩 九十九","a":"羅虬","d":"唐","g":"短诗","p":["一舸春深指鄂君，好風從度水成紋。","越人若見紅兒貌，繡被應羞徹夜薰。"],"s":"mixed","f":"simp"},{"i":"76a06d68-949a-4fa1-b742-0eeb039e197a","t":"比紅兒詩 一百","a":"羅虬","d":"唐","g":"短诗","p":["花落塵中玉墮泥，香魂應上窈娘堤。","欲知此恨無窮處，長倩城烏夜夜啼。"],"s":"mixed","f":"simp"},{"i":"b59ebaa7-8bae-4973-a57a-e032b22a2e74","t":"句","a":"羅虬","d":"唐","g":"短诗","p":["窗前遠岫懸生碧，簾外殘霞挂熟紅。"],"s":"mixed","f":"simp"},{"i":"00702981-1884-4b20-99fc-354e8ced4aa0","t":"星精亭","a":"鄭損","d":"唐","g":"短诗","p":["星沈萬古痕，孤絕勢無鄰。","地窄少留竹，空多剩占雲。","釣篷和雨看，樵斧帶霜聞。","莫惜尋常到，清風不負人。"],"s":"mixed","f":"simp"},{"i":"f57365ae-b81f-4729-ac92-8b9da3ebf708","t":"釣閣","a":"鄭損","d":"唐","g":"短诗","p":["小閣愜幽尋，周遭萬竹森。","誰知一沼內，亦有五湖心。","釣直魚應笑，身閑樂自深。","晚來春醉熟，香餌任浮沈。"],"s":"trad","f":"simp"},{"i":"30f95f18-fa3a-4bb9-8a75-61744687a5f1","t":"玉聲亭","a":"鄭損","d":"唐","g":"短诗","p":["世間泉石本無價，那更天然落景中。","漢佩琮琤寒溜雨，秦簫縹緲夜敲風。","一方清氣羣陰伏，半局閑棋萬慮空。","借問主人能住久，後來好事有誰同。"],"s":"mixed","f":"simp"},{"i":"5efaec0e-670b-4f46-89a6-214d5cf06f5b","t":"藝堂","a":"鄭損","d":"唐","g":"短诗","p":["堂開凍石千年翠，藝講秋膠百步威。","揖讓未能忘典禮，英雄孰不慣戎衣。","風波險似金機駭，日月忙如雪羽飛。","莫怪尊前頻浩歎，男兒志願與時違。"],"s":"trad","f":"simp"},{"i":"85edeea7-a75d-43df-aebd-b92720f096ee","t":"星精石","a":"鄭損","d":"唐","g":"短诗","p":["突險呀空龍虎蹲，由來英氣蓄寒根。","蒼苔點染雲生靨，老雨淋漓鐵漬痕。","松韻遠趨疑認祖，山陰輕覆似憐孫。","孤巖恰恰容幽搆，可愛江南釋子園。"],"s":"trad","f":"simp"},{"i":"bdca155c-6b4e-493f-8e12-f9705df9e1eb","t":"泛香亭","a":"鄭損","d":"唐","g":"短诗","p":["流杯處處稱佳致，何似斯亭出自然。","山溜穿雲來幾里，石盤和蘚鑿何年。","聲交鳴玉歌沈板，色幌寒金酒滿船。","莫怪坐中難得醉，醒人心骨有潺湲。"],"s":"mixed","f":"simp"},{"i":"d7ef9625-cf5a-4a58-a217-26c26733f917","t":"巴州寒食晚眺","a":"張禕","d":"唐","g":"短诗","p":["東望青天周與秦，杏花榆葉故園春。","野寺一傾寒食酒，晚來風景重愁人。"],"s":"trad","f":"simp"},{"i":"8493466b-7eb6-4de2-8143-12786a652f70","t":"題擊甌樓","a":"張禕","d":"唐","g":"短诗","p":["駐旌元師遺風在，擊缶高人逸興酣。","水轉巴文清溜急，山連蒙岫翠光涵。"],"s":"trad","f":"simp"},{"i":"6107fb38-ce0c-497c-a35f-ac7d24961f84","t":"題司空圖壁","a":"盧攜","d":"唐","g":"短诗","p":["姓氏司空貴，官班御史卑。","老夫如且在，不用歎屯奇。"],"s":"trad","f":"simp"},{"i":"d7ce5740-8899-4cc1-ae6b-7aad23851365","t":"愁詩","a":"李廷璧","d":"唐","g":"短诗","p":["到來難遣去難留，著骨黏心萬事休。","潘岳愁絲生鬢裏，婕妤悲色上眉頭。","長途詩盡空騎馬，遠雁聲初獨倚樓。","更有相思不相見，酒醒燈背月如鉤。"],"s":"mixed","f":"simp"},{"i":"4b2492bf-0268-4378-9572-b1d9991e930b","t":"題菖蒲廢觀","a":"許三畏","d":"唐","g":"短诗","p":["本是安期燒藥處，今來改作坐禪宮。","數僧梵響滿樓月，深谷猨聲半夜風。","金簡事移松閣逈，綵雲影散閬山空。","我來不見修真客，却得真如問遠公。"],"s":"mixed","f":"simp"},{"i":"6f709530-f1bd-452c-af6d-eb87040360ab","t":"致孫狀元訴醵罰錢","a":"盧嗣業","d":"唐","g":"短诗","p":["未識都君面，頻輸復分錢。","苦心事筆硯，得志助花鈿。","徒步求秋賦，持杯給暮饘。","力微多謝病，非不奉同年。"],"s":"trad","f":"simp"},{"i":"e4962c05-fe08-4951-a08c-d92d4b36600e","t":"紅薔薇","a":"牛嶠","d":"唐","g":"短诗","p":["曉啼珠露渾無力，繡簇羅襦不著行。","若綴壽陽公主額，六宮爭肯學梅妝。"],"s":"trad","f":"simp"}]