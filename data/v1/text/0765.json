[{"i":"c-2bfaf1cdeb92","t":"多丽","a":"无名氏","d":"宋","g":"词","p":["日初长，宝炉一缕沈烟。","绿阴新，垂杨亭榭，知谁巧擘香绵。","有时共、落红零乱，有时共、芳草留连。","只道无情，那知有意，几回飞过绮窗前。","人争讶，艳阳三月，乾雪舞晴天。","游丝外，不堪燕掠，无奈蜂黏。","那小鬟、忒�山苛樱�镇日地、倚阑干。","轻吹处、樱桃的的，闲拈处、笋指纤纤。","爱点猩罗，装成粉缬，嗔人不许放朱帘。","端相好、蓦然风起，特送上秋千。","明朝看，池塘雨过，萍翠应添。"]},{"i":"c-63b1b0a31ec5","t":"沁园春","a":"无名氏","d":"宋","g":"词","p":["我善观梅，识梅妙处，舍我其谁。","待裁冰翦雪，已无足道，凝酥弄粉，愈不为奇。","枉费心神，巡檐索笑，点检南枝并北枝。","梅应道，似这般题品，未是相知。","分明有个端倪。","遮莫把人间凡眼窥。","那精神全在，半含蕊处，风流全在，未有香时。","万木丛边，两三点白，此是生生化化机。","花开也，又怎生消得，个样词儿。"]},{"i":"c-35fcf0ea2fb0","t":"壶中天・念奴娇","a":"无名氏","d":"宋","g":"词","p":["日长晴昼。","厌厌地、懒向窗前絣绣。","因倚屏风无意绪，□把眉儿双皱。","似醉还醒，才眠又起，频拈梨花嗅。","看他儿女，闲寻百草来斗。","相思能几何时，料归期不到，清和时候。","生怕鸳鸯香被冷，旋爇沈檀薰透。","欲把单衣，鼎新裁翦，又怕供春瘦。","试看今夜，孤灯还有花否。"]},{"i":"c-38cc6d5c3694","t":"满江红","a":"无名氏","d":"宋","g":"词","p":["一点阳和，天不许、凡花先得。","这些儿深意，蜂蝶怎生窥测。","北陆正当风凛冽，南枝却漏春消息。","教琼仙、翦水缀成葩，天然白。","影横处，寒窗月。","香浮处，寒梢雪。","被东皇做就，这般标格。","虽是腊前年后景，终非竹外篱边物。","不安排、顿放玉堂中，真堪惜。"]},{"i":"c-c1b822d943df","t":"买坡塘・摸鱼儿","a":"无名氏","d":"宋","g":"词","p":["喜西风、朝来如约，新凉一雨初霁。","家山望断知何处，渺渺长天秋水。","空眼底。","叹雁杳鱼沈，尺纸无人寄。","芸窗草砌。","渐影颤疏桐，声敲落叶，孤枕怎成睡。","逢场戏。","遮莫悲秋憔悴。","今朝有酒须醉。","尊前待唤佳人道，为雪藕丝轻脆。","闲省记。","便笑口频开，一岁知能几。","归期尚未。","且蜡屐兰桡，湖山深处，同赏月中桂。"]},{"i":"c-b9666870c5a6","t":"瑞鹤仙","a":"无名氏","d":"宋","g":"词","p":["赏残陶径菊。","正袅袅愁予，风凄露肃。","何人抱幽独。","更檐马锵金，廊鱼响木。","此情谁属。","向底处、骋怀游目。","小窗前，频览菱花，一笑鬓丝犹绿。","萧索。","故国云迷，佳人日暮，轻颦倚竹。","短钗敲玉。","算几夜，恁孤宿。","问旅情如许，怎生排遣，应费酒尊诗轴。","最无端、谁隔西楼，正调弦促。"]},{"i":"c-331577d7d52c","t":"更漏子","a":"无名氏","d":"宋","g":"词","p":["画楼深，春昼永。","帘幕东风微冷。","莺啭罢，燕归来。","佳人午梦回。","鬓钗横，眉黛浅。","一捻楚腰纤软。","推绣户，倚雕阑。","无言看牡丹。"]},{"i":"c-f424b8fd1210","t":"更漏子","a":"无名氏","d":"宋","g":"词","p":["鬓慵梳，眉懒画。","独自行来花下。","情脉脉，泪垂垂。","此情知为谁。","雨初晴，帘半卷。","两两衔泥新燕。","人比燕，不成双。","枉教人断肠。"]},{"i":"c-82db7ef8048d","t":"更漏子","a":"无名氏","d":"宋","g":"词","p":["粉墙低，蓬户小。","一点尘运不到。","眠纱帐，坐蒲团。","道人随分安。","笋芽新，蔬甲嫩。","日日家常羹饭。","羹饭罢，怎消闲。","携筇出看山。"]},{"i":"c-18af65bb478a","t":"愁倚阑令・春光好","a":"无名氏","d":"宋","g":"词","p":["东风恶，宿云凝。","忒无情。","合造梨花深院雨，断肠声。","枕上春梦初醒。","红窗外、何处啼莺。","已办春游双画舫，几时晴。"]},{"i":"c-73864b052561","t":"红窗迥","a":"无名氏","d":"宋","g":"词","p":["河可挽。","石可转。","那一个愁字，却难驱遣。","眉向酒边暂展。","酒后依旧见。","枫叶满阶红万片。","待拾来、一一题写教遍。","却倩霜风吹卷。","直到沙岛远。"]},{"i":"c-ed8a8d13b643","t":"一翦梅","a":"无名氏","d":"宋","g":"词","p":["漠漠春阴酒半酣。","风透春衫。","雨透春衫。","人家蚕事欲眠三。","桑满筐篮。","柘满筐篮。","先自离怀百不堪。","樯燕呢喃。","梁燕呢喃。","篝灯强把锦书看。","人在江南。","心在江南。"]},{"i":"c-fd37940b244f","t":"长相思","a":"无名氏","d":"宋","g":"词","p":["不思量。","又思量。","一点寒灯耿夜光。","鸳衾闲半床。","雨声长。","漏声长。","几阵斜风摇纸窗。","如何不断肠。"]},{"i":"c-a899576d9cc1","t":"长相思","a":"无名氏","d":"宋","g":"词","p":["云垂垂。","雨霏霏。","只恐今年花事迟。","不然孤负伊。","燕飞飞。","柳依依。","有个人人倚翠扉。","深攒双黛眉。"]},{"i":"c-9a8b9a66fd38","t":"长相思","a":"无名氏","d":"宋","g":"词","p":["雨如丝。","柳如丝。","织出春来一段奇。","莺梭来往飞。","酒如池。","醉如泥。","遮莫教人有醒时。","雨晴都不知。"]},{"i":"c-696a56a4f829","t":"长相思","a":"无名氏","d":"宋","g":"词","p":["燕成双。","蝶成双。","飞去飞来杨柳旁。","问伊因底忙。","绿纱窗。","篆炉香。","午梦惊回书满床。","棋声春昼长。"]},{"i":"c-1851300c151c","t":"采桑子","a":"无名氏","d":"宋","g":"词","p":["年年才到花时候，风雨成旬。","不肯开晴。","误却寻花陌上人。","今朝报道天晴也，花已成尘。","寄语花神。","何似当初莫做春。"]},{"i":"c-4fa31e1345f1","t":"风光好","a":"无名氏","d":"宋","g":"词","p":["柳阴阴。","水深深。","风约双凫不自禁。","碧波心。","孤村桥断人迷路。","舟横渡。","旋买村醪浅浅斟。","更微吟。"]},{"i":"c-8954b70838fe","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["□□□□□□□。","□□□□□。","□□□□□□□。","□□□□□□、□□□。","□□□□□□处。","归向桃源住。","桃源有路透渔溪。","自恨仙凡从此、隔云泥。"]},{"i":"c-ba9c28d828ec","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["绮疏人把罗衣叠。","岫幌铺残月。","宝烟细袅博山中。","梦惹暖红鸳锦、醉香风。","觉来犹记乘鸾处。","不是蓝桥住。","落花流水认前溪。","想见五云为路、静无泥。"]},{"i":"c-4ee5b4e5f9d4","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["悲商吹尽枝间绿。","绛萼含冰玉。","为谁搀早冒寒开。","应念天涯憔悴、挽春回。","玉壶自酌清漪满。","又识东风面。","夜深斜月印窗纱。","好在数枝疏瘦、两三花。"]},{"i":"c-d18d16d223e2","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["萧萧风竹千蛟舞。","云阁催诗雨。","中秋时节变新凉。","又是一番红叶、下三湘。","君如膝上王文度。","早晚乡关去。","绣香佳处且留连。","正好橙黄橘绿、未寒天。"]},{"i":"c-e1e48e9106ca","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["当年合德并飞燕。","涎涎无人见。","清魂沦入海棠枝。","料想天寒同著、翠罗衣。","同心佩带连环玉。","并髻云鬟绿。","谁教红萼自成双。","恰似新荷叶里、睡鸳鸯。"]},{"i":"c-75adb103eb10","t":"木兰花・玉楼春","a":"无名氏","d":"宋","g":"词","p":["小桃枝上东风转。","□□草绿江南岸。","绿杨学舞小蛮腰，红药惜开菩萨面。","故乡何处天涯远。","黄梁梦断行云断。","登楼准拟故人书，殷勤试问西归雁。"]},{"i":"c-5ac0cad05ab6","t":"朝中措","a":"无名氏","d":"宋","g":"词","p":["严霜封草树凋红。","叶落小园空。","何事洛阳花面，却来冠冕秋风。","尊前羞损，篱边野菊，池上芙蓉。","莫放花归崑阆，且留客醉金锺。"]},{"i":"c-ae897fb7c8d4","t":"朝中措","a":"无名氏","d":"宋","g":"词","p":["红鸾飞下绿云中。","天淡日和融。","回首小园桃杏，怜伊独困霜风。","妖姿丽质，天然富贵，不假铅红。","梦作一双蝴蝶，翻翻绕遍芳丛。"]},{"i":"c-f3b68e314ea9","t":"朝中措","a":"无名氏","d":"宋","g":"词","p":["洛阳常见画图中。","春去只心融。","国色辉开寒日，天香熏破霜风。","平生看了，姚黄魏紫，一捻深红。","莫是神仙韩令，裁成顷刻花丛。"]},{"i":"c-0e3880a10077","t":"朝中措","a":"无名氏","d":"宋","g":"词","p":["从来黄菊占秋风。","红只许芙蓉。","正是百花浓睡，如何唤起春工。","小桃破萼，胭脂淡伫，妆粉轻笼。","为报多情刘阮，武陵消息先通。"]},{"i":"c-136661e15dda","t":"朝中措","a":"无名氏","d":"宋","g":"词","p":["宦游只欲赋归休。","花为解离愁。","看取星星潘鬓，花应羞上人头。","武陵流水，桃源路远，空误渔舟。","把住春光一醉，从教风叶悲秋。"]},{"i":"c-e76722d030d9","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["草市人归日落，荒城风急鸦翻。","独携尊酒上高寒。","缥缈云横楚观。","柳外半篙绿水，烟中数笔青山。","天涯流落岁将残。","望断故园心眼。"]},{"i":"c-786b7be0a571","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["扑扑云垂四野。","冥冥雁下平芜。","萧萧风叶乱黄芦。","寒入一滩鸥鹭。","准拟云窗水榭。","装成玉树冰壶。","卷帘独坐拈髭须。","待看六花飞舞。"]},{"i":"c-ea3a33d4b48b","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["风雨朝来恶甚，池塘春去无多。","绿杨阴里溜莺棱。","枝上老红犹堕。","酒满蚁浮金匜，烛残泪滴铜荷。","更阑孤枕奈情何。","只恐巫山梦破。"]},{"i":"c-07779137e712","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["花下春光正好，柳边春色才多。","雨声日夜长沧波。","暗地芳心滴破。","拍拍浪飞白雪，冥冥山点青螺。","汀兰岸芷有情麽。","还惜江城春过。"]},{"i":"c-80cec3c8dde9","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["膝下红金不暖，窗前绛蜡犹然。","夜深城麓走风烟。","的砾还飘雪霰。","海上正迷蝶梦，山阴未棹溪船。","愿骑白凤玉为鞭。","西赴瑶池芳宴。"]},{"i":"c-a8956b3d4b6a","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["琼沼融成沆瀣，冰檐滴尽真珠。","一园草木气方苏。","又学杨花飞舞。","何必乱飘密洒，却疑细糁轻铺。","谁将粉墨画成图。","玉做小亭高树。"]},{"i":"c-ff3c7b73cfa6","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["翦翦轻寒雨后，瞳瞳晓日晴时。","春风先到绿杨枝。","金缕野桥山市。","鶗鴂巧调琴筑，海棠惜吐胭脂。","玉骢未解锦障泥。","且挂征鞭一醉。"]},{"i":"c-d8623a6a96dd","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["翠岭游仙梦破，暖香残酒醒时。","子规啼月下花枝。","日涌山光照市。","柳拂眉间黛色，桃匀脸上胭脂。","凄凄芳草路无泥。","脉脉归心似醉。"]},{"i":"c-aaa61fd6b526","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["风雨馀寒过了，池塘春水生时。","迁莺飞上拂云枝。","春遍柳村花市。","酒面清空似水，玉杯温莹如脂。","莫教花谢涴尘泥。","把住东君索醉。"]},{"i":"c-397260d2bcd6","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["晓翠初分，挂藤窈窕穿深静。","乌啼风径。","竹舞千蛟影。","又过重阳，感叹伤流景。","人多病。","酒杯慵问。","闲却金卮柄。"]},{"i":"c-948f4103c259","t":"好事近","a":"无名氏","d":"宋","g":"词","p":["篱落晓来霜，花嫩不禁寒力。","脉脉自摇疏影，印一奁空碧。","天生潇洒谢夫人，绝世有谁识。","何必嫣然一笑，已倾城倾国。"]},{"i":"c-4bc7a2e7e30b","t":"秦楼月・忆秦娥","a":"无名氏","d":"宋","g":"词","p":["□□□。","□□□□□□□。","□□□。","□□□□，□□□□。","白鸥飞下屏山曲。","行人点破秋郊绿。","秋郊绿。","细看重咏，怎生得足。"]},{"i":"c-c14b877b5904","t":"秦楼月・忆秦娥","a":"无名氏","d":"宋","g":"词","p":["秋漠漠。","登临常羡东飞鹤。","东飞鹤。","一襟乡泪，为君双落。","明年不负黄花约。","故人须我归舟泊。","归舟泊。","荆溪亭下，晚秋寒薄。"]},{"i":"c-f1f651f52a40","t":"秦楼月・忆秦娥","a":"无名氏","d":"宋","g":"词","p":["风淅淅。","天容暗淡梅花白。","梅花白。","点酥凝粉，比君不得。","清歌飞下龙沙雪。","绮疏休印蟾宫月。","蟾宫月。","婵娟虽好，有时圆缺。"]},{"i":"c-93319f2de418","t":"西地锦","a":"无名氏","d":"宋","g":"词","p":["重过黄梁古驿。","著一鞭春色。","长亭细柳，青青尚浅，不禁攀折。","且醉章台风月。","莫归鞍催发。","紫泥诏下，朝天去了，如何来得。"]},{"i":"c-88e1147b297a","t":"如梦令","a":"无名氏","d":"宋","g":"词","p":["试问春归何处。","红入小桃花树。","同访古章台，把盏重听金缕。","休去。","休去。","应被好山留住。"]},{"i":"c-5c12af9b8f54","t":"清平乐","a":"无名氏","d":"宋","g":"词","p":["风不定。","舞碎海棠红影。","数点雨声池上听。","湿尽一庭花冷。","倚阑多少心情。","轻寒未放春晴。","谁管天涯憔悴，楚乡又过清明。"]},{"i":"c-314dd8a46c9f","t":"浣溪沙","a":"无名氏","d":"宋","g":"词","p":["遍地轻阴绿满枝。","乍晴初试袷罗衣。","东风院落日长时。","鸂鶒池边飞燕子，海棠花里闹蜂儿。","一春心事只春知。"]},{"i":"c-b2057938e836","t":"望江南・忆江南","a":"无名氏","d":"宋","g":"词","p":["清夜老，流水淡疏星。","云母窗前生晓色，梧桐叶上得秋声。","村落一鸡鸣。","催唤起，带梦著冠缨。","老去悲秋如宋玉，病来止酒似渊明。","满院竹风清。"]},{"i":"c-150dfcb71f14","t":"醉蓬莱","a":"无名氏","d":"宋","g":"词","p":["见笋成新竹，燕教雏飞，画堂清昼。","萱草榴花，遍小庭如绣。","角簟纱厨，葛巾葵扇，正麦秋时候。","玉尘生风，け然隐几，香蟠金兽。","又值生初，故乡何在，三楚云高，谩劳回首。","睡起情怀，况渊明止酒。","赖有宾朋，惠来相顾，尽一时英秀。","旋涤瑶觞，重歌金缕，与公同寿。"]},{"i":"c-09fa044443e8","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["梅子成阴，海棠初谢，小园才过清明。","百花扫地，红紫践为尘。","别有烟红露绿，嫣然笑、管领东君。","还知否，天香国色，独步殿馀春。","轻盈。","多态度，洛阳图画，韩令经营。","想谪仙风韵，洒面词成。","一捻深红尚透，谁信道、花亦通灵。","君休待、花归阆苑，莫惜醉山倾。"]},{"i":"c-a0cb32c778e7","t":"汉宫春","a":"无名氏","d":"宋","g":"词","p":["争似我，随时临风对月，畅饮更高歌。"]},{"i":"c-fb925fc316c7","t":"瑞鹤仙","a":"无名氏","d":"宋","g":"词","p":["恨佳人命薄。","似春云无定，杨花飘泊。"]},{"i":"c-918466dc6f42","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["须信道、颜色如花，命如秋叶。"]},{"i":"c-c1bff5544310","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["但入新年，愿百事、皆如意。"]},{"i":"c-78bc823b7451","t":"水龙吟","a":"无名氏","d":"宋","g":"词","p":["□□含娇眼。"]},{"i":"c-66935838524c","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["雨后轻寒。"]},{"i":"c-e60efe97e697","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["柳丝柔无力。"]},{"i":"c-c19596504f96","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["伤怀长是蹙双眉。","怎禁持。"]},{"i":"c-4fa1d0674f06","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["杨花飞絮。","搅乱少年情绪。"]},{"i":"c-ba56896d0f17","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["天气阴阴。"]},{"i":"c-3f2d8e39b168","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["倚遍阑干十二楼。"]},{"i":"c-62960278ac82","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["柳眠花心，此夜欢会。"]},{"i":"c-c2c9ed7e53e6","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["蝶意蜂情，恣还飘逸。"]},{"i":"c-6bdfbbca4d46","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["金鸭香消。"]},{"i":"c-aa4dcdd0e434","t":"念奴娇","a":"无名氏","d":"宋","g":"词","p":["脉脉此情难识。"]},{"i":"c-8457e108508e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["无计奈愁何。"]},{"i":"c-87f6ef9016e0","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["知他今夜，好好为谁梳洗。"]},{"i":"c-809eb3a11e57","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["西楼独上等多时。","月团圆、人未归。"]},{"i":"c-127acb799727","t":"最高楼","a":"无名氏","d":"宋","g":"词","p":["南陌踏青游。"]},{"i":"c-5125f65088d3","t":"青玉案","a":"无名氏","d":"宋","g":"词","p":["更憔悴、羞人见。"]},{"i":"c-87d3246b7d5c","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["任他春去春来。"]},{"i":"c-e72675f31696","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["嫩草初抽匀细绿。"]},{"i":"c-678e654f75ee","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["湖腻烟光，柳垂新绿。"]},{"i":"c-7caee54c8b1d","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["语燕飞来绕画梁。"]},{"i":"c-7325a313cbd2","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["一钩新月。"]},{"i":"c-356d745122ba","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["怕到黄昏转凄切。"]},{"i":"c-6c7bcb3dcbf2","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["凝情羞对海棠花。"]},{"i":"c-8c037b1169af","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["枝头点检，退尽芳菲。"]},{"i":"c-d814b648896f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["寸心如铁不关愁。"]},{"i":"c-2c36e381bd23","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["入到春来转见愁。"]},{"i":"c-6a38e2a198c0","t":"最高楼","a":"无名氏","d":"宋","g":"词","p":["却教人，逢春怕，见花羞。"]},{"i":"c-a5cba02ddb93","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["不如柳絮，穿帘透幕，飞到伊行。"]},{"i":"c-c52648843084","t":"菩萨蛮","a":"无名氏","d":"宋","g":"词","p":["衔泥双燕来还去。"]},{"i":"c-b0906bed1b17","t":"天仙子","a":"无名氏","d":"宋","g":"词","p":["谷雨清明空屈指。"]},{"i":"c-9cdd588144cd","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["这愁绪、仗他谁。"]},{"i":"c-8ba76c5e0f81","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["樱桃新荐小梅红。"]},{"i":"c-dbcc9b09a1a4","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["恩爱顿成离别恨。"]},{"i":"c-0c4dbffa85f2","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["要解心头愁闷，除非殢酒。"]},{"i":"c-2c0b2e580945","t":"洞仙歌","a":"无名氏","d":"宋","g":"词","p":["惟有莺莺燕燕。"]},{"i":"c-123fd9219867","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["病酒厌厌，未解馀酲，三竿丽日。"]},{"i":"c-36c99a3e7b98","t":"千秋岁","a":"无名氏","d":"宋","g":"词","p":["一声啼鸟，常道无消息。"]},{"i":"c-f1c6b322b2c5","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["暗把归期数。"]},{"i":"c-492553bd1a86","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["危楼愁独倚。"]},{"i":"c-857c8f9bf285","t":"谒金门","a":"无名氏","d":"宋","g":"词","p":["满地落红千片。"]},{"i":"c-e3338948d0f5","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["频拭脸边新泪。"]},{"i":"c-d9915c35a43b","t":"好事近","a":"无名氏","d":"宋","g":"词","p":["更一声啼鸟。"]},{"i":"c-c1325e693131","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["落花狼藉无行处。"]},{"i":"c-6dbd85e7d3c1","t":"贺新郎","a":"无名氏","d":"宋","g":"词","p":["一点芳心事。"]},{"i":"c-8b59f53a0bcb","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["东君去后无踪迹。"]},{"i":"c-5017730573b4","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["登楼欲认经由处，无奈云山遮望眼。"]}]