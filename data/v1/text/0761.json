[{"i":"c-0e78617bdfa4","t":"鬓边华","a":"无名氏","d":"宋","g":"词","p":["小梅香细艳浅。","过楚岸、尊前偶见。","爱闲淡，天与精神，掠青鬓、开人醉眼。","如今抛掷经春，恨不见、芳枝寄远。","向心上、谁解相思，赖长对、妆楼粉面。"],"s":"simp","f":"trad"},{"i":"c-474faeab1ccf","t":"御阶行・御街行","a":"无名氏","d":"宋","g":"词","p":["平生有个风流愿。","愿长与梅为伴。","问伊因甚破寒来，只恐百花先绽。","比兰比麝，比酥比玉，休恁闲撩乱。","瑶台月下分明见。","依旧残妆浅。","不知分得几多香，一片清如一片。","直须遮断，恐人眼毒，不解轻轻看。"],"s":"simp","f":"trad"},{"i":"c-a4b462f2de05","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["北岭天饶瑞雪，南枝地段红苞。","朦胧霁月映寒梢。","谁把玉人纱罩。","香胜炉薰龙麝，奇过庭拥琼瑶。","一杯清酒愿相招。","慰我茅堂清瘦。"],"s":"simp","f":"trad"},{"i":"c-f33a3112b68e","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["翡翠枝头晚萼，婵娟月里飘香。","春兰秋蕙作寻常。","不与夭桃朋党。","笑见深红浅白，从教蝶舞蜂忙。","风流标致道家妆。","潇洒得来别样。"],"s":"simp","f":"trad"},{"i":"c-5527a37be5a4","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["黄蜡谁将点缀，红膏不许施妆。","孤根来自水云乡。","风味天然酝酿。","看取玉奴呵手，摘来珠露沾裳。","翠环斜插一枝香。","似簇蜂儿头上。"],"s":"simp","f":"trad"},{"i":"c-6183833c3cae","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["万木经霜冻折，孤根独报春来。","前村雪里一枝开。","将缓月华光彩。","一点唇红不褪，妆如傅粉皑皑。","和羹端的禀天才。","终入庖人鼎鼐。"],"s":"simp","f":"trad"},{"i":"c-902feb62f45e","t":"蝶恋花","a":"无名氏","d":"宋","g":"词","p":["暖发黄宫和气软。","雪里精神，巧借东君翦。","嫩蕊商量春色浅。","青枝疑是香酥溅。","谁道和羹芳信远。","点点微酸，已向枝头见。","休待玉英飞四散。","且移疏影横金盏。"],"s":"simp","f":"trad"},{"i":"c-be13e50acbee","t":"桃源忆故人","a":"无名氏","d":"宋","g":"词","p":["园林万木凋零尽。","惟是寒梅香喷。","不许雪霜欺损。","迥有天然性。","南枝渐吐红苞嫩。","冠绝夭桃繁杏。","不记故人音信。","对景成离恨。"],"s":"simp","f":"trad"},{"i":"c-bd61bc33f76d","t":"桃源忆故人","a":"无名氏","d":"宋","g":"词","p":["江天雪意云飞重。","却倚阑干初冻。","回傍小楼独拥。","尽日无人共。","墙梅未落春先纵。","欲寄一枝谁送。","月夜暗香浮动。","似作离人梦。"],"s":"simp","f":"trad"},{"i":"c-a88284da8b00","t":"桃源忆故人","a":"无名氏","d":"宋","g":"词","p":["南枝向暖清香喷。","谁付骚人词咏。","一种陇头春信。","不借胭脂晕。","梢头谁把轻黄搵。","浑似不忺施粉。","疑是寿阳孤冷。","染得相思病。"],"s":"mixed","f":"trad"},{"i":"c-ce6a04c300c3","t":"桃源忆故人","a":"无名氏","d":"宋","g":"词","p":["寒苞初吐黄金莹。","色染蔷薇犹嫩。","枝上紫檀香喷。","洒落饶风韵。","南枝一种同春信。","何事不忺朱粉。","自称霓裳孤冷。","怨感宫腰恨。"],"s":"simp","f":"trad"},{"i":"c-3f0329b1330f","t":"添字浣溪沙・山花子","a":"无名氏","d":"宋","g":"词","p":["雪态冰姿好似伊。","料应尝笑水仙迟。","驿使初传芳信早，赏佳期。","暗想花神多巧妙，黏酥缀玉压纤枝。","粉面临鸾宜月殿，整妆时。"],"s":"simp","f":"trad"},{"i":"c-5aa251079fbd","t":"添字浣溪沙・山花子","a":"无名氏","d":"宋","g":"词","p":["谁染深红酥缀来。","意浓含笑美颜开。","误认浣溪人饮罢，上香腮。","辨杏疑桃称好句，名园色异占多才。","折得一枝斜插鬓，坠金钗。"],"s":"simp","f":"trad"},{"i":"c-36128abc5981","t":"添字浣溪沙・山花子","a":"无名氏","d":"宋","g":"词","p":["取次匀妆粉有痕。","参差玉软淡精神。","姑射重绡风卷乱，喜相迎。","蝶戏飞层双翅重，清中富贵最多情。","全似寿阳当日事，点残英。"],"s":"simp","f":"trad"},{"i":"c-ee18ca1f698a","t":"添字浣溪沙・山花子","a":"无名氏","d":"宋","g":"词","p":["蜜室蜂房别有香。","腊前偏会泄春光。","凝伫清容何所似，笑姚黄。","蜡注金锺诚得意，风飘气味压群芳。","不似寿阳夸粉面，道家妆。"],"s":"simp","f":"trad"},{"i":"c-967bd2eff93d","t":"玉交枝・忆秦娥","a":"无名氏","d":"宋","g":"词","p":["胆样瓶儿几点春。","翦来犹带水云痕。","且移孤冷，相伴最深樽。","每为惜花无晓夜，教人甚处不销魂。","为君惆怅，独自倚黄昏。"],"s":"simp","f":"trad"},{"i":"c-9bd1b2c2d1a8","t":"玉交枝・忆秦娥","a":"无名氏","d":"宋","g":"词","p":["蕙子兰孙小样儿。","化工簇就寄南枝。","笑他兰蕙，虽韵带轻肥。","香霭紫檀和雾重，色攒黄蜡界金徽。","有人潇洒，插向鬓边宜。"],"s":"simp","f":"trad"},{"i":"c-758f392c1413","t":"玉交枝・忆秦娥","a":"无名氏","d":"宋","g":"词","p":["谁道花房采蜜脾。","翦成黄蜡小花儿。","恶嫌朱粉，不肯肖青枝。","檀吐暗香兰许韵，月移芳影雪生肌。","不妨花蕊，羌笛尽教吹。"],"s":"simp","f":"trad"},{"i":"c-5723a3868198","t":"玉楼春","a":"无名氏","d":"宋","g":"词","p":["迢递前村深雪里。","望断行云香细细。","笛中宫里慕芳姿，怨曲啼妆长见泪。","不会同心荣落易。","冷艳翻随分岭水。","有谁曾念陇头人，远寄江南春日意。"],"s":"simp","f":"trad"},{"i":"c-745f101ec3e3","t":"玉楼春","a":"无名氏","d":"宋","g":"词","p":["萧萧海上风长起。","也有梅花开玉蕊。","爱君风措莹如冰，伴我情怀清似水。","诗人纵复工难似。","莫把闲花容易比。","浓香吹尽不须愁，细雨微风催结子。"],"s":"simp","f":"trad"},{"i":"c-4d052abce707","t":"玉楼春","a":"无名氏","d":"宋","g":"词","p":["腊前先报东君信。","清似龙涎香得润。","黄轻不肯整齐开，比着红梅仍旧韵。","纤枝瘦绿天生嫩。","可惜轻寒摧挫损。","刘郎只解误桃花，怅恨今年春又尽。"],"s":"simp","f":"trad"},{"i":"c-3c6d4daa18c3","t":"捣练子","a":"无名氏","d":"宋","g":"词","p":["欺万木，怯寒时。","倚阑初认月宫姬。","拭新妆，披素衣。","孤标韵，暗香奇。","冰容玉艳缀琼枝。","借阳和，天付伊。"],"s":"simp","f":"trad"},{"i":"c-f1366319711e","t":"喜团圆","a":"无名氏","d":"宋","g":"词","p":["轻攒碎玉，玲珑竹外，脱去繁华。","尤殢东君，最先点破，压倒群花。","瘦影生香，黄昏月馆，清浅溪沙。","仙标淡伫，偏宜么凤，肯带栖鸦。"],"s":"simp","f":"trad"},{"i":"c-064785ebd78a","t":"愁倚栏・春光好","a":"无名氏","d":"宋","g":"词","p":["冰肌玉骨精神。","不风尘。","昨夜窗前都折尽，忽疑君。","清泪拂拂沾巾。","谁相念、折赠芳春。","羌管休吹别塞曲，有人听。"],"s":"simp","f":"trad"},{"i":"c-c9944148e573","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["庭梅初绽。","风递幽香清更远。","别有孤根。","不待阳和一点恩。","雪中风韵。","皓质冰姿真莹静。","月下精神。","来到窗前疑是君。"],"s":"simp","f":"trad"},{"i":"c-5d272eaaf527","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["疏梅风韵。","不许游蜂飞蝶近。","要识芳容。","除向瑶台月下逢。","尊前一见。","换尽平生桃李眼。","却笑襄王。","楚梦无踪空断肠。"],"s":"simp","f":"trad"},{"i":"c-82b770247dde","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["山城驿近。","又报寒梅传驿信。","远水孤村。","月下何人与断魂。","幽芳在手。","花木无情那得瘦。","似此天真。","好赠东阳姓沈人。"],"s":"simp","f":"trad"},{"i":"c-e46176726767","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["香肌清瘦。","泪湿轻红疏雨后。","笑靥微开。","宿雨微醺越女腮。","多情无奈。","玉管休吹帘影外。","薄晚池台。","惆怅繁华梦里来。"],"s":"simp","f":"trad"},{"i":"c-ed2ca573bea5","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["东君有待。","留得一枝香雪在。","晚日融融。","只恐轻酥暖渐熔。","歌催管送。","芳酒一尊谁与共。","寂寞墙东。","潇洒黄昏满院风。"],"s":"simp","f":"trad"},{"i":"c-a51d5fbc8c35","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["鹅黄初吐。","无数蜂儿飞不去。","别有香风。","不与南枝斗浅红。","凭谁折取。","拟把玉人分付与。","碧玉搔头。","淡淡霓裳人倚楼。"],"s":"simp","f":"trad"},{"i":"c-a42cebb85768","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["园林衰槁。","一品梅花开太早。","紫蕊檀心。","独占中央色似金。","幽香清远。","对景开尊同赏玩。","雅称仙姿。","莫是多情染相思。"],"s":"simp","f":"trad"},{"i":"c-539c2a1b3ec3","t":"临江仙","a":"无名氏","d":"宋","g":"词","p":["漏出春光三四朵，冰肌玉骨偏宜。","乍开应笑百花迟。","将军曾止渴，画角已先知。","素艳不容蜂蝶采，清香自有人知。","而今虽被霜雪欺。","和羹终待手，金鼎自逢时。"],"s":"simp","f":"trad"},{"i":"c-935a4f378049","t":"临江仙","a":"无名氏","d":"宋","g":"词","p":["陇首云收天色暮，寒光射月初开。","崑荆山玉莫疑猜。","琳琅疑此地，仙子不红腮。","丽质霜裾真性雅，馀香暗送人来。","乱将碎玉缀枝排。","雪中寻不见，青萼辨奇才。"],"s":"mixed","f":"trad"},{"i":"c-e2ede4f02b3a","t":"临江仙","a":"无名氏","d":"宋","g":"词","p":["昨夜新阳回候馆，芳菲正满霜林。","此时珍赏重千金。","谁知红粉艳，还有岁寒心。","风动霞衣香散漫，酒醺丹脸深沈。","妖娆偏称美人簪。","一枝无处赠，折得自孤吟。"],"s":"mixed","f":"trad"},{"i":"c-6afc71e8466f","t":"临江仙","a":"无名氏","d":"宋","g":"词","p":["爱日新添春一线，化工先到寒梅。","不随桃李傍熙台。","前村深雪里，昨夜一枝开。","姑射仙人标格韵，凝墙粉谢香腮。","数家清弄笛声衰。","愁人不怨听，自向枕边来。"],"s":"simp","f":"trad"},{"i":"c-a31ef1efb996","t":"临江仙","a":"无名氏","d":"宋","g":"词","p":["玉貌香腮天赋与，清姿不假铅华。","素芳寻在五陵家。","欲知春信息，庾岭一枝斜。","别有玲珑潇洒处，月梢淡影笼遮。","休教羌笛一声嗟。","宫妆犹未似，留取意无涯。"],"s":"simp","f":"trad"},{"i":"c-09063ee5d7dd","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["枝绿初匀，萼红犹浅。","化工妆点年华晚。","暗香疏影水亭边，黄昏月下依稀见。","十二危楼，谁人倚遍。","只愁羌笛声幽怨。","少留情意待春来，东君准拟长拘管。"],"s":"simp","f":"trad"},{"i":"c-8b4705a5f009","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["萼破前村，枝横江路。","铁心应也频凝伫。","怕愁惟恐不禁愁，宁教雪月相分付。","不测春来，难追香去。","无人知我心先误。","多情总道是东君，东君也有无情处。"],"s":"simp","f":"trad"},{"i":"c-2c9c6bce107d","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["点点琼酥，初寒乍结。","看来未忍轻轻折。","园林正告久萧条，春工著意饶先发。","眼底不凡，枝头自别。","也知彻苦宜霜雪。","这般风味凭馨香，怎教桃李同时节。"],"s":"simp","f":"trad"},{"i":"c-8d2e5c165b83","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["玉母池边，曾记旧识。","玉京仙苑新移得。","素娥青女好精神，比看终是无颜色。","传入汉宫，偷拟妆饰。","寿阳空恁劳心力。","寒香都不为春来，莫将远寄春消息。"],"s":"simp","f":"trad"},{"i":"c-208bb1cfc4d8","t":"渔家傲","a":"无名氏","d":"宋","g":"词","p":["蕙死兰枯篱菊槁。","返魂香入江南早。","竹外一枝斜更好。","谁解道。","只今惟有东坡老。","去岁花前人醉倒。","酒醒花落嫌人扫。","人去不来春又到。","愁满抱。","青山一带连芳草。"],"s":"simp","f":"trad"},{"i":"c-2a80d7d861ca","t":"渔家傲","a":"无名氏","d":"宋","g":"词","p":["雪点江梅才可可。","梅心暗弄纤纤朵。","疑是月娥庭下过。","仙翘亸。","云衫密缀真珠颗。","玉斝金瓯连臂坐。","芳辰莫把离魂挫。","一曲绣筵娇婀娜。","情无那。","阳关声里樱桃破。"],"s":"simp","f":"trad"},{"i":"c-8dd72c14feec","t":"定风波","a":"无名氏","d":"宋","g":"词","p":["又是春归烟雨村。","一枝香雪度黄昏。","竹外云低疏影亚。","潇洒。","水清沙浅见天真。","瘦玉欺寒香不暖。","堪羡。","冰姿照夜月无痕。","楼上笛声休听取。","说与。","江南人远易销魂。"],"s":"simp","f":"trad"},{"i":"c-a04e18b187eb","t":"定风波","a":"无名氏","d":"宋","g":"词","p":["一树寒梅傍小溪。","夜来陡觉绽南枝。","冷艳冰姿金蕊浅。","堪羡。","凝明因与雪霜期。","折赠美人临宝鉴。","云脸。","鬓边斜插最相宜。","凭仗高楼频祝付。","说与。","马融羌管且停吹。"],"s":"simp","f":"trad"},{"i":"c-dcabbcb23598","t":"鹊踏枝・蝶恋花","a":"无名氏","d":"宋","g":"词","p":["南国寒轻山自碧。","庭际梅花，先报春消息。","绮萼玉英何忍摘。","真堪树下陈瑶席。","旋嗅清香消酒力。","翦采无功，粉笔争描得。","一曲新欢须共惜。","等闲零落随羌笛。"],"s":"simp","f":"trad"},{"i":"c-b12c9248a41f","t":"鹊踏枝・蝶恋花","a":"无名氏","d":"宋","g":"词","p":["故里山遥春霭碧。","为想繁枝，清梦何曾息。","缧带霜英人不摘。","纷纷日暮飘絪席。","休抱离肠凭酒力。","只有轻纨，依约应传得。","白发未归空自惜。","柔肠寄尽平阳笛。"],"s":"mixed","f":"trad"},{"i":"c-69ded18cbc5c","t":"清平乐","a":"无名氏","d":"宋","g":"词","p":["寒溪过雪。","梅蕊春前发。","照影弄姿香苒苒，临水一枝风月。","梦游仿佛仙乡。","绿窗曾见幽芳。","事往无人共说，愁闻玉笛声长。"],"s":"simp","f":"trad"},{"i":"c-046c1027f3f3","t":"春光好","a":"无名氏","d":"宋","g":"词","p":["看看腊尽春回。","消息到、江南早梅。","昨夜前村深雪里，一朵花开。","盈盈玉蕊如裁。","更风细、清香暗来。","空使行人肠欲断，驻马裴回。"],"s":"simp","f":"trad"},{"i":"c-ad4e4e72aaee","t":"人娇","a":"无名氏","d":"宋","g":"词","p":["玉瘦香浓，檀深雪散。","今年恨、探梅较晚。","江楼楚馆。","云闲水远。","清昼永，凭阑翠帘低卷。","坐上客来，尊中酒满。","歌声共、水流云断。","南枝可插，便须频翦。","莫直待、西楼数声羌管。"],"s":"simp","f":"trad"},{"i":"c-a5a6cea7c057","t":"二色宫桃","a":"无名氏","d":"宋","g":"词","p":["镂玉香苞酥点萼。","正万木、园林萧索。","惟有一枝雪里开，江南有信凭谁托。","前年记赏登高阁。","叹年来、旧欢如昨。","听取乐天一句云，花开处、且须行乐。"],"s":"simp","f":"trad"},{"i":"c-6335cc6e8e35","t":"河传","a":"无名氏","d":"宋","g":"词","p":["香苞素质。","天赋与、倾城标格。","应是晓来，暗传东君消息。","把孤芳、回暖律。","寿阳粉面增妆饰。","说与高楼，休更吹羌笛。","花下醉赏，留取时倚阑干，斗清香、添酒力。"],"s":"simp","f":"trad"},{"i":"c-b840b6c33036","t":"七娘子","a":"无名氏","d":"宋","g":"词","p":["清香浮动到黄昏，向水边、疏影梅开尽。","溪边畔，轻蕊，有如浅杏。","一枝喜得东君信。","风吹只怕霜侵损。","更新来、插向多情鬓。","寿阳妆鉴，雪肌玉莹。","岭头别后微添粉。"],"s":"simp","f":"trad"},{"i":"c-7135a3168349","t":"忆少年","a":"无名氏","d":"宋","g":"词","p":["疏疏整整，斜斜淡淡，盈盈脉脉。","徒怜暗香句，笑梨花颜色。","羁马萧萧行又急。","空回首、水寒沙白。","天涯倦牢落，忍一声羌笛。"],"s":"simp","f":"trad"},{"i":"c-631e9145117a","t":"浪淘沙","a":"无名氏","d":"宋","g":"词","p":["春色入横塘。","变尽凄凉。","青梢弄粉雪溪傍。","疑是化工偏著意，欲试新妆。","玉蓓锁春藏。","占断寒芳。","他时鼎鼐不须忙。","泄漏清香方有思，别是春光。"],"s":"simp","f":"trad"},{"i":"c-d65e309ab479","t":"浪淘沙","a":"无名氏","d":"宋","g":"词","p":["雪里暗香浓。","乍吐琼英。","横斜疏影月明中。","学傅胭脂桃与杏，虚废春工。","素艳有谁同。","不并妖红。","应如褒姒笑时容。","绝胜梨花春带雨，旖旎春风。"],"s":"simp","f":"trad"},{"i":"c-c43f7865284b","t":"浪淘沙","a":"无名氏","d":"宋","g":"词","p":["村左小溪傍。","粉黛宜芳。","寒添潇洒冷添霜。","清瘦几枝堪入画，竹映苔墙。","疏影浸横塘。","月暗浮香。","当时曾伴寿阳妆。","不似东君先倚栏，泄漏春光。"],"s":"simp","f":"trad"},{"i":"c-31da02cd2926","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["破萼江梅，迥然标格冰肌莹。","暗香疏影。","月张银塘静。","折取一枝，与插多情鬓。","临鸾镜。","粉容相并。","试问谁端正。"],"s":"simp","f":"trad"},{"i":"c-a8e7ca6aee25","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["烟淡黄昏，小移疏影横斜去。","暗香微度。","点缀梢头雨。","玉管休吹，更要留春住。","人何处。","对花无语。","望断江南路。"],"s":"simp","f":"trad"},{"i":"c-0615efd4d805","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["点点江梅，向疏篱处香风逗。","未容春透。","花亦知人瘦。","姑射山头，谁伴黄昏后。","君知否。","自然孤秀。","横玉休三奏。"],"s":"simp","f":"trad"},{"i":"c-5a3e53173919","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["雪里芳丛，岭头还报东君信。","寿阳妆靓。","姑射冰肌莹。","曲岸横斜，清浅波相应。","风不定。","暗香疏影。","占断花中韵。"],"s":"simp","f":"trad"},{"i":"c-2a282c910dbe","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["万木凋残，早梅独占孤根暖。","前村雪满。","昨夜南枝绽。","堪恨倚栏，容易吹羌管。","飘琼片。","翠蛾争选。","贴向桃花面。"],"s":"simp","f":"trad"},{"i":"c-9a36fd4a7074","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["昨夜寒梅，一枝雪里多风措。","幽香无数。","不与群花语。","最是凝情，月夜交光处。","谁为主。","待须折取。","羌管休轻举。"],"s":"simp","f":"trad"},{"i":"c-5dcc592059db","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["春日芳心，暗香偏向黄昏逗。","玉肌寒透。","抵死添清瘦。","影落横塘，月淡人归后。","君知否。","一枝先秀。","应向东君奏。"],"s":"simp","f":"trad"},{"i":"c-a83e0b1f1c1a","t":"点绛唇","a":"无名氏","d":"宋","g":"词","p":["赋雪归来，绿窗一夜霜风紧。","也知春信。","消息南枝近。","隐映斜阳，玉暖香成阵。","西湖景。","繁英有恨。","只□□□□。"],"s":"simp","f":"trad"},{"i":"c-f7e964240c72","t":"惜双双・惜分飞","a":"无名氏","d":"宋","g":"词","p":["冒雪披风开数点。","万花厌、欺寒探暖。","掩映闲庭院。","月下疏影横斜，幽香远。","命友开尊同宴玩。","听丽质、歌声宛转。","对景侧金盏。","任他结实和羹，归仙馆。"],"s":"simp","f":"trad"},{"i":"c-4fb2f8b7bf0b","t":"朝中措","a":"无名氏","d":"宋","g":"词","p":["山城水隘小桥傍。","竹里早梅芳。","纵有丹青图画，难描幽韵清香。","妖娆天赋，偏宜素淡，杨氏宫妆。","雅态何须艳丽，孤标不在春光。"],"s":"simp","f":"trad"},{"i":"c-0019a81e8a7f","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["清江一曲君应见。","昨夜潮头浅。","不争落落斗奇奇。","看取水边寒蕊、雪边枝。","日斜疏影还敧倒。","沙上娇鶄老。","只今何处有新诗。","好在小春十月、醉翁辞。"],"s":"mixed","f":"trad"},{"i":"c-1882b00c6b3f","t":"醉落魄・一斛珠","a":"无名氏","d":"宋","g":"词","p":["琼搓粉滴。","南枝只报江南坼。","横斜疏影溪边窄。","翦碎白云，分付陇头客。","冰肌绰约疑姑射。","铅华消尽见真色。","不随桃李开红白。","我为东君，来报春消息。"],"s":"simp","f":"trad"},{"i":"c-45a73f8a76b4","t":"醉落魄・一斛珠","a":"无名氏","d":"宋","g":"词","p":["梅花似雪。","赏花记得同欢悦。","更阑犹自贪攀折。","不怯春寒，须要待明月。","如今月上花争发。","疏枝冷蕊对离缺。","人心只道花争别。","不道人心，不似旧时节。"],"s":"simp","f":"trad"},{"i":"c-19782eb589f2","t":"更漏子","a":"无名氏","d":"宋","g":"词","p":["宝香瓶，桐叶卷。","荡水痕微还远。","思乡信，觉春迟。","野梅初见时。","上潮风，临晚渡。","人欲过西江去。","吹寒管，陇云低。","江南花未知。"],"s":"simp","f":"trad"},{"i":"c-3f41a57536c9","t":"更漏子","a":"无名氏","d":"宋","g":"词","p":["绛纱笼，金叶盖。","向晓灯花犹在。","冰未结，小琉璃。","陇梅香满枝。","雪无香，花有意。","不是江南新寄。","霜月尽，碧天寒。","玉楼人倚阑。"],"s":"simp","f":"trad"},{"i":"c-6df13bb4a258","t":"落梅风・落梅","a":"无名氏","d":"宋","g":"词","p":["宫烟如水湿芳晨。","寒梅似雪相亲。","玉楼侧畔数枝春。","惹香尘。","寿阳娇面偏怜惜，妆成一面花新。","镜中重把玉纤匀。","酒初醺。"],"s":"simp","f":"trad"},{"i":"c-97a1be609f43","t":"古记・如梦令","a":"无名氏","d":"宋","g":"词","p":["一枕厌厌春困。","记得小梅风韵。","何处最关情，嫩蕊初传芳信。","堪恨。","堪恨。","谁傍横斜疏影。"],"s":"simp","f":"trad"},{"i":"c-a23e67c52fad","t":"古记・如梦令","a":"无名氏","d":"宋","g":"词","p":["腊半雪梅初绽。","玉屑琼英碎翦。","素艳与清香，别有风流堪羡。","苞嫩。","蕊嫩。","羞破寿阳人面。"],"s":"simp","f":"trad"},{"i":"c-4add34f95a27","t":"古记・如梦令","a":"无名氏","d":"宋","g":"词","p":["疑是水晶宫殿。","云女天仙宝宴。","吟赏欲黄昏，风送一声羌管。","烟淡。","霜淡。","月在画楼西畔。"],"s":"simp","f":"trad"},{"i":"c-5eba215c3ccd","t":"生查子","a":"无名氏","d":"宋","g":"词","p":["朔风吹冻云，云破天容碧。","新月过溪来，隐见横云色。","天与水争妍，花与月争白。","一倩管城君，寄此春消息。"],"s":"simp","f":"trad"},{"i":"c-c383aeb4e085","t":"蓦山溪","a":"无名氏","d":"宋","g":"词","p":["青春三月。"],"s":"simp","f":"trad"},{"i":"c-6384879726fa","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["夜寒斗觉罗衣薄。"],"s":"simp","f":"trad"},{"i":"c-735e805eaf69","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["深诚杳隔无疑。"],"s":"simp","f":"trad"},{"i":"c-4e1d04567496","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["千里。","楚江水。","明月楼高愁独倚。","井梧宫殿生秋意。","望断巫山十二。","雪肌花貌参差是。","朱阁五云仙子。"],"s":"simp","f":"trad"},{"i":"c-c257cbcb42dd","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["相误。","桃源路。","万里苍苍烟水暮。","留君不住君须去。","秋月春风闲度。","桃花零乱如红雨。","人面不知何处。"],"s":"simp","f":"trad"},{"i":"c-6dc5b291d258","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["非雾。","花无语。","远似朝云何处去。","凌波不过横塘路。","燕燕莺莺飞舞。","风吹仙袂飘飘举。","拟倩游丝惹住。"],"s":"simp","f":"trad"},{"i":"c-28ba17d6a76b","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["相忆。","无消息。","目断遥天云自白。","寒山一带伤心碧。","风土萧疏胡国。","长安不见浮云隔。","纵使君来争得。"],"s":"simp","f":"trad"},{"i":"c-e7760c101ae8","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["来见。","蕊宫殿。","记得随班迎凤辇。","馀花落尽苍苔院。","斜掩金铺一片。","千金买笑无方便。","和泪盈盈娇眼。"],"s":"simp","f":"trad"},{"i":"c-68bd46b76710","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["君去。","逐鸳侣。","斜倚绿窗鸳鉴女。","琴弹秋思明心素。","一寸还成千缕。","锦城春色知何许。","那似远山眉妩。"],"s":"simp","f":"trad"},{"i":"c-d255de22d159","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["无处。","难轻诉。","锦瑟华年谁与度。","黄昏更下潇潇雨。","况是青春将暮。","花虽无语莺能语。","来道曾逢郎否。"],"s":"simp","f":"trad"},{"i":"c-fd958276cf4a","t":"调笑・调笑令","a":"无名氏","d":"宋","g":"词","p":["衫湿。","情何极。","上下花间声转急。","满船明月芦花白。","秋水长天一色。","芳年未老时难得。","目断远空凝碧。"],"s":"simp","f":"trad"},{"i":"c-a3a7f1a40f03","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["一张机。","织梭光景去如飞。","兰房夜永愁无寐。","呕呕轧轧，织成春恨，留著待郎归。"],"s":"simp","f":"trad"},{"i":"c-83cc421ada09","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["两张机。","月明人静漏声稀。","千丝万缕相萦系。","织成一段，回纹锦字。","将去寄呈伊。"],"s":"simp","f":"trad"},{"i":"c-25d91fe04fac","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["三张机。","中心有朵耍花儿。","娇红嫩绿春明媚。","君须早折，一枝浓艳，莫待过芳菲。"],"s":"simp","f":"trad"},{"i":"c-42fc08654543","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["四张机。","鸳鸯织就欲双飞。","可怜未老头先白，春波碧草，晓寒深处，相对浴红衣。"],"s":"simp","f":"trad"},{"i":"c-df07cd7c23c5","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["五张机。","芳心密与巧心期。","合欢树上枝连理。","双头花下，两同心处，一对化生儿。"],"s":"simp","f":"trad"},{"i":"c-c21cd6563dac","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["六张机。","雕花铺锦半离披。","兰房别有留春计。","炉添小篆，日长一线，相对绣工迟。"],"s":"simp","f":"trad"},{"i":"c-34978cc37936","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["七张机。","春蚕吐尽一生丝。","莫教容易裁罗绮。","无端翦破，仙鸾彩凤，分作两般衣。"],"s":"simp","f":"trad"},{"i":"c-829e0be22bbd","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["八张机。","纤纤玉手住无时。","蜀江濯尽春波媚。","香遗囊麝，花房绣被。","归去意迟迟。"],"s":"simp","f":"trad"},{"i":"c-3f36eae1be3f","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["九张机。","一心长在百花枝。","百花共作红堆被。","都将春色，藏头里面，不怕睡多时。"],"s":"simp","f":"trad"},{"i":"c-cbddedebb943","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["轻丝。","象床玉手出新奇。","千花万草光凝碧。","裁缝衣著，春天歌舞，飞蝶语黄鹂。"],"s":"simp","f":"trad"},{"i":"c-8d40a01fa380","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["春衣。","素丝染就已堪悲。","尘世昏污无颜色。","应同秋扇，从兹永弃。","无复奉君时。"],"s":"simp","f":"trad"},{"i":"c-0bf23151f567","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["一张机。","采桑陌上试春衣。","风晴日暖慵无力。","桃花枝上，啼莺言语，不肯放人归。"],"s":"simp","f":"trad"},{"i":"c-027410523ab3","t":"九张机","a":"无名氏","d":"宋","g":"词","p":["两张机。","行人立马意迟迟。","深心未忍轻分付，回头一笑，花间归去，只恐被花知。"],"s":"simp","f":"trad"}]