[{"i":"887e37c0-7878-4078-9f37-f30c0b85d5e8","t":"繡袈裟衣緣","a":"長屋","d":"唐","g":"短诗","p":["山川異域，風月同天。","寄諸佛子，共結來緣。"],"s":"trad","f":"simp"},{"i":"01813f10-27a6-49e9-9ba4-18a75b8b31fe","t":"憤怨詩","a":"王巨仁","d":"唐","g":"短诗","p":["于公慟哭三年旱，鄒衍含愁五月霜。","今我幽愁還似古，皇天無語但蒼蒼。"],"s":"mixed","f":"simp"},{"i":"c6de2910-2263-43e1-a829-33c2e458a434","t":"立木海上刻詩","a":"李贊華","d":"唐","g":"短诗","p":["小山壓大山，大山全無力。","羞見故鄉人，從此投外國。"],"s":"trad","f":"simp"},{"i":"3107d287-37fc-4d27-8ac8-a6ac2c890014","t":"戲語","a":"成輔端","d":"唐","g":"短诗","p":["秦地城池二百年，何期如此賤田園。","一頃麥苗碩伍米，三間堂屋二千錢。"],"s":"trad","f":"simp"},{"i":"23a35503-2f15-45a3-a46e-54f189b1ab4d","t":"萬壽寺歌詞","a":"張隱","d":"唐","g":"短诗","p":["位乖燮理致傷殘，四面牆匡不忍看。","正是花時堪下淚，相公何必更追歡。"],"s":"trad","f":"simp"},{"i":"c2a54f85-16d9-4b63-9465-13d497558ce3","t":"迎孫刺史","a":"朱元","d":"唐","g":"短诗","p":["昔日郎君今刺史，朱元依舊守朱門。","今朝竹馬諸童子，盡是當時竹馬孫。"],"s":"trad","f":"simp"},{"i":"de3b5f15-1a1d-423e-b3b0-aa612e693247","t":"臨刑詩","a":"陳璠","d":"唐","g":"短诗","p":["積玉堆金官又崇，禍來倏忽變成空。","五年榮貴今何在，不異南柯一夢中。"],"s":"trad","f":"simp"},{"i":"b300ad66-301d-4b9a-b903-63a1350010d3","t":"詩","a":"捧劒僕","d":"唐","g":"短诗","p":["青鳥銜葡萄，飛上金井欄。","美人恐驚去，不敢捲簾看。"],"s":"trad","f":"simp"},{"i":"955572f1-5c58-4f75-958a-ae824f049a8c","t":"題牡丹","a":"捧劒僕","d":"唐","g":"短诗","p":["一種芳菲出後庭，却輸桃李得佳名。","誰能爲向天人說，從此移根近太清。"],"s":"mixed","f":"simp"},{"i":"fbdcc1a3-f685-483d-bba4-ec8ca33802dc","t":"將竄留詩","a":"捧劒僕","d":"唐","g":"短诗","p":["珍重郭四郎，臨行不得別。","曉漏動離心，輕車冒殘雪。","欲出主人門，零涕暗嗚咽。","萬里隔關山，一心思漢月。"],"s":"mixed","f":"simp"},{"i":"1010f9b1-01b2-44a9-a499-ecc0dad48405","t":"淮陽感懷","a":"李密","d":"唐","g":"古体","p":["金風蕩初節，玉露凋晚林。","此夕窮塗士，鬱陶傷寸心。","野平葭葦合，村荒藜藿深。","眺聽良多感，徙倚獨霑襟。","霑襟何所爲，悵然懷古意。","秦俗猶未平，漢道將何翼。","樊噲市井徒，蕭何刀筆吏。","一朝時運會，千古傳名諡。","寄言世上雄，虛生真可媿。"],"s":"mixed","f":"simp"},{"i":"3299eb9b-32bb-4bfc-862b-7c577921db27","t":"南隱遊泉山","a":"孔德紹","d":"唐","g":"古体","p":["名山狎招隱，俗外遠相求。","還如倒景望，忽似閬風遊。","臨崖俯大壑，披霧仰飛流。","歲積松方偃，年深椿欲秋。","野花開石鏡，雲葉掩山樓。","何須問方士，此處即瀛洲。"],"s":"trad","f":"simp"},{"i":"2c266c8b-bb64-4902-87c7-c2e405588092","t":"行經太華","a":"孔德紹","d":"唐","g":"古体","p":["紛吾世網暇，靈岳展幽尋。","寥廊風塵遠，杳冥川谷深。","山昏五里霧，日落二華陰。","疎峰起蓮葉，危塞隱桃林。","何必東都外，此處可抽簪。"],"s":"mixed","f":"simp"},{"i":"96978520-b66d-433a-82bb-0b54fc559183","t":"夜宿荒村","a":"孔德紹","d":"唐","g":"古体","p":["綿綿夕漏深，客恨轉傷心。","撫弦無人聽，對酒時獨斟。","故鄉萬里絕，窮愁百慮侵。","秋草思邊馬，遶枝驚夜禽。","風度谷餘響，月斜山半陰。","勞歌欲敘意，終是白頭吟。"],"s":"mixed","f":"simp"},{"i":"a8789dec-8a0f-4334-abca-5e4622a6f70b","t":"王澤嶺遭洪水","a":"孔德紹","d":"唐","g":"古体","p":["地籟風聲急，天津雲色愁。","悠然萬頃滿，俄爾百川浮。","遠似金堤溢，翻如碧海流。","驚濤遙起鷺，迴岸不分牛。","徒知懷趙景，終是倦陽侯。","木梗誠無託，蘆灰豈暇求。","思得乘槎便，蕭然河漢遊。"],"s":"trad","f":"simp"},{"i":"6f4c09bc-65c6-4f17-a7be-a5d6359c747b","t":"登白馬山護明寺","a":"孔德紹","d":"唐","g":"古体","p":["名岳標形勝，危峰遠鬱紆。","成象建環極，大壯闡規模。","層臺從靈鷲，高殿邇陽烏。","暫同遊閬苑，還類入仙都。","三休開碧嶺，萬戶洞金鋪。","攝心罄前禮，訪道挹中虛。","遙瞻盡地軸，長望極天隅。","白雲起梁棟，丹霞映栱櫨。","露花疑濯錦，泉月似沈珠。","今日桃源客，相顧失歸塗。"],"s":"mixed","f":"simp"},{"i":"b4a74c09-0fb7-4705-973d-eba7241be475","t":"送舍利宿定普巖","a":"孔德紹","d":"唐","g":"古体","p":["仁祠表虛曠，祗園展肅恭。","棲息翠微嶺，登頓白雲峰。","映流看夜月，臨峰聽曉鐘。","澗芳十步草，崖陰百丈松。","蕭然遙路絕，無復市朝蹤。"],"s":"trad","f":"simp"},{"i":"6d2b797e-4492-4bf5-80f2-41963cf4e5ef","t":"觀太常奏新樂","a":"孔德紹","d":"唐","g":"古体","p":["大君膺寶曆，出豫表功成。","鈞天金石響，洞庭弦管清。","八音動繁會，九變叶希聲。","和雲留睿賞，熏風悅聖情。","盛烈光韶濩，易俗邁咸英。","竊吹良無取，率舞抃羣生。"],"s":"mixed","f":"simp"},{"i":"861d5fd9-d498-4beb-b16e-4a4a9e15bea1","t":"賦得涉江采芙蓉","a":"孔德紹","d":"唐","g":"短诗","p":["蓮舟泛錦磧，極目眺江干。","沿流渡檝易，逆浪取花難。","有霧疑川廣，無風見水寬。","朝來採摘倦，詎得久盤桓。"],"s":"mixed","f":"simp"},{"i":"f3797664-352d-40cd-b10a-1adb0947710f","t":"賦得華亭鶴","a":"孔德紹","d":"唐","g":"短诗","p":["華亭失侶鶴，乘軒寵遂終。","三山凌苦霧，千里激悲風。","心危白露下，聲斷綵弦中。","何言斯物變，翻復似遼東。"],"s":"trad","f":"simp"},{"i":"48543b6f-b767-4421-b93f-60070e0c4ec6","t":"送蔡君知入蜀二首 一","a":"孔德紹","d":"唐","g":"短诗","p":["金陵已去國，銅梁忽背飛。","失路遠相送，他鄉何日歸。"],"s":"trad","f":"simp"},{"i":"71b1b257-1bc0-4a62-9c19-dbdd25c86910","t":"送蔡君知入蜀二首 二","a":"孔德紹","d":"唐","g":"短诗","p":["靈關九折險，蜀道二星遙。","乘槎若有便，希泛廣陵潮。"],"s":"trad","f":"simp"},{"i":"afb9c85b-d867-4bda-8c84-516d90b554e0","t":"落葉","a":"孔德紹","d":"唐","g":"短诗","p":["早秋驚葉落，飄零似客心。","翻飛未肯下，猶言惜故林。"],"s":"trad","f":"simp"},{"i":"d0913c25-e918-4952-b798-44f0a09389cf","t":"句","a":"孔德紹","d":"唐","g":"短诗","p":["誰分菱花影，還看蓬鬢秋。"],"s":"trad","f":"simp"},{"i":"209365b3-4cbc-430d-987a-056b27ce10b0","t":"臨刑詩","a":"鄭頲","d":"唐","g":"短诗","p":["幻生還幻滅，大幻莫過身。","安心自有處，求人無有人。"],"s":"trad","f":"simp"},{"i":"ab76c0fc-144b-4884-a054-efec2987e260","t":"和謁孔子廟","a":"劉斌","d":"唐","g":"古体","p":["性與雖天縱，主世乃無由。","何言泰山毀，空驚逝水流。","及門思往烈，入室想前修。","寂寞荒堦暮，摧殘古木秋。","遺風曖如此，聊以慰蒸求。"],"s":"trad","f":"simp"},{"i":"0412bbd4-4dcc-42dd-95d2-40c53e1ef120","t":"和許給事傷牛尚書","a":"劉斌","d":"唐","g":"古体","p":["名臣不世出，百工之所求。","況乃非常器，遭逢興運秋。","符彩照千里，銓衡綜九流。","經綸資百物，樽俎寄皇猷。","韶濩傾復理，典禮紊還修。","雖貞棟梁任，兼好藝文游。","佇聞和鼎實，行當奉介丘。","高衢翻稅駕，閱水遽遷舟。","傳呼更何日，曳履聞無由。","歸魂藐脩路，征櫂艤邗溝。","林薄長風慘，江上寒雲愁。","夜臺終不曙，遺芳徒自留。"],"s":"mixed","f":"simp"},{"i":"a9971af6-ff43-4a0c-9659-c4690ea261fd","t":"送劉散員同賦陳思王詩得好鳥鳴高枝","a":"劉斌","d":"唐","g":"短诗","p":["春林已自好，時鳥復和鳴。","枝交難奮翼，谷靜易流聲。","間關纔得性，[矰]繳遽相驚。","安知背飛遠，拂霧獨晨征。"],"s":"mixed","f":"simp"},{"i":"d83f4859-18c6-481b-b9ef-5aef52e35602","t":"詠山","a":"劉斌","d":"唐","g":"短诗","p":["靈山峙千仞，蔽日且嵯峨。","紫蓋雲陰遠，香爐煙氣多。","石梁高鳥路，瀑水近天河。","欲知聞道里，別自有仙歌。"],"s":"trad","f":"simp"},{"i":"77ec8e4f-8eba-49b9-8ae3-f5e9925f44d8","t":"登樓望月二首 一","a":"劉斌","d":"唐","g":"古体","p":["圓月當新霽，高樓見最明。","素波流粉壁，丹桂拂飛甍。","下瞰千門靜，旁觀萬象生。","梧桐窗下影，鳥鵲檻前聲。","嘯逸劉琨興，吟資庾亮情。","遊人莫登眺，迢遞故鄉程。"],"s":"trad","f":"simp"},{"i":"0bb587ba-21d0-4437-a519-6bc7a7317fa0","t":"登樓望月二首 二","a":"劉斌","d":"唐","g":"古体","p":["皎潔三秋月，巍峨百丈樓。","下分征客路，上有美人愁。","帳卷芙蓉帶，簾褰玳瑁鉤。","倚窗情渺渺，憑檻思悠悠。","末得金波轉，俄成玉筯流。","不堪三五夕，夫壻在邊州。"],"s":"mixed","f":"simp"},{"i":"0939af03-3cbb-4f62-bbcf-d5dcaed9c2ea","t":"題菊花","a":"黃巢","d":"唐","g":"短诗","p":["颯颯西風滿院栽，蘂寒香冷蝶難來。","他年我若爲青帝，報與桃花一處開。"],"s":"mixed","f":"simp"},{"i":"4a38ccaa-e3e3-4920-9f22-3a686c934000","t":"不第後賦菊","a":"黃巢","d":"唐","g":"短诗","p":["待到秋來九月八，我花開後百花殺。","衝天香陣透長安，滿城盡帶黃金甲。"],"s":"trad","f":"simp"},{"i":"e90727d6-db93-49ba-8850-13629dcec59a","t":"自題像","a":"黃巢","d":"唐","g":"短诗","p":["記得當年草上飛，鐵衣著盡著僧衣。","天津橋上無人識，獨倚欄干看落暉。"],"s":"mixed","f":"simp"},{"i":"9af71473-30cc-45f1-bbf5-dbc548c8a611","t":"柳","a":"羅紹威","d":"唐","g":"短诗","p":["妝點青春更有誰，青春常許占先知。","亞夫營畔風輕處，元亮門前日暖時。","花密宛如飄六出，葉繁何惜借雙眉。","交情別緒論多少，好向仁人贈一枝。"],"s":"mixed","f":"simp"},{"i":"94f6a5a6-3e3a-49cb-98ad-06e288f3ca3f","t":"白菊","a":"羅紹威","d":"唐","g":"短诗","p":["雖被風霜競欲催，皎然顏色不低摧。","已疑素手能妝出，又似金錢未染來。","香散自宜飄淥酒，葉交仍得蔭蒼苔。","尋思閉戶中宵見，應認寒窗雪一堆。"],"s":"trad","f":"simp"},{"i":"d492634f-f9c7-460d-ac55-940178c624a2","t":"句","a":"羅紹威","d":"唐","g":"短诗","p":["樓前澹澹雲頭日，簾外蕭蕭雨脚風。"],"s":"mixed","f":"simp"},{"i":"37f35117-c17b-469d-b3aa-9774e47ef532","t":"清明登奉先城樓","a":"羅衮","d":"唐","g":"短诗","p":["年來年去只艱危，春半堯山草尚衰。","四海清平耆舊見，五陵寒食小臣悲。","煙銷井邑隈樓檻，雪滿川原泥酒巵。","拭盡賈生無限淚，一行歸雁遠參差。"],"s":"mixed","f":"simp"},{"i":"e5932ce9-aae5-4200-ab22-d88fc81e7d96","t":"清明赤水寺居","a":"羅衮","d":"唐","g":"短诗","p":["榆火輕煙處處新，旋從閑望到諸鄰。","浮生浮世祗多事，野水野花娛病身。","濁酒不禁雲外景，碧峰猶冷寺前春。","蓑衣毳衲誠吾黨，自結村園一社貧。"],"s":"mixed","f":"simp"},{"i":"a4602a50-d302-413b-9fca-07c7aeb05f9c","t":"贈羅隱","a":"羅衮","d":"唐","g":"短诗","p":["平日時風好涕流，讒書雖盛一名休。","寰區歎屈瞻天問，夷貊聞詩過海求。","向夕便思青瑣拜，近年尋伴赤松遊。","何當世祖從人望，早以公台命卓侯。"],"s":"mixed","f":"simp"},{"i":"e4e53053-451e-4a40-9997-e879e4d8df66","t":"哭趙州和尚二首 一","a":"王鎔","d":"唐","g":"短诗","p":["師離㴲水動王侯，心印光潛麈尾收。","碧落霧霾松嶺月，滄溟浪覆濟人舟。","一燈乍滅波旬喜，雙眼重昏道侶愁。","縱是了然雲外客，每瞻缾几淚還流。"],"s":"mixed","f":"simp"},{"i":"d894a481-af39-4b7d-9e5a-2aa62aa71dd5","t":"哭趙州和尚二首 二","a":"王鎔","d":"唐","g":"短诗","p":["佛日西傾祖印隳，珠沈丹沼月沈輝。","影敷丈室爐煙慘，風起禪堂松韻微。","隻履乍來留化跡，五天何處又逢歸。","解空弟子絕悲喜，猶自潸然對雪幃。"],"s":"trad","f":"simp"},{"i":"272300a0-b692-4c21-a18c-3ed56547c867","t":"荅同年李昉見贈次韻","a":"鄧洵美","d":"唐","g":"短诗","p":["詞場幾度讓長鞭，又向清朝賀九遷。","品秩雖然殊此日，歲寒終不改當年。","馳名早已超三院，侍直仍忻步八磚。","今日相逢翻自媿，閑吟對酒倍潸然。"],"s":"trad","f":"simp"},{"i":"0522e427-d0fd-4297-b951-b49d6fecb260","t":"除夜長安作","a":"李京","d":"唐","g":"短诗","p":["長安朔風起，窮巷掩雙扉。","新歲明朝是，故鄉何路歸。","鬢絲饒鏡色，隙雪奪燈輝。","却羨秦州雁，逢春盡北飛。"],"s":"mixed","f":"simp"},{"i":"2de02ac5-cdd6-497f-8b77-4857a3567202","t":"登嶺望","a":"許鼎","d":"唐","g":"短诗","p":["淼淼三江水，悠悠五嶺關。","雁飛猶不度，人去若爲還。"],"s":"mixed","f":"simp"},{"i":"dac9f65e-2498-4818-8ec7-61e0594493a7","t":"㟧嶺四望","a":"許鼎","d":"唐","g":"短诗","p":["漢家仙仗在咸陽，洛水東流出建章。","野老至今猶望辛，離宮秋樹獨蒼蒼。"],"s":"mixed","f":"simp"},{"i":"9b51815e-1a80-46ec-adb5-fd0c03e11c71","t":"官左拾遺歸隱作","a":"王易簡","d":"唐","g":"短诗","p":["汨沒朝班媿不才，誰能低折向塵埃。","青山得去且歸去，官職有來還自來。"],"s":"trad","f":"simp"},{"i":"9f2ca905-f6f9-430a-9d92-98842e2cd081","t":"悼楊氏妓琴弦","a":"朱褒","d":"唐","g":"短诗","p":["魂歸寥廊魄歸泉，只住人間十五年。","昨日施僧裙帶上，斷腸猶繫琵琶弦。"],"s":"mixed","f":"simp"},{"i":"483abfe4-ae97-42bb-a0f8-c92752d51df3","t":"公子行","a":"黃損","d":"唐","g":"短诗","p":["春草綠綿綿，驕驂驟煖煙。","微風飄樂韻，半日醉花邊。","打鵲拋金盞，招人舉玉鞭。","田翁與蠶婦，平地看神仙。"],"s":"trad","f":"simp"},{"i":"b517a5c3-3975-4638-8a1f-5c51eddcd8c2","t":"讀史","a":"黃損","d":"唐","g":"短诗","p":["逐鹿走紅塵，炎炎火德新。","家肥生孝子，國霸有餘臣。","帝道雲龍合，民心草木春。","須知煙閣上，一半老儒真。"],"s":"trad","f":"simp"},{"i":"42fab1cf-ad7f-4c48-be72-f4a1f215aca2","t":"出山吟","a":"黃損","d":"唐","g":"短诗","p":["來書初出白雲扃，乍躡秋風馬走輕。","遠近留連分岳色，別離嗚咽亂泉聲。","休將巢許爭喧雜，自共伊臯論太平。","昨夜細看雲色裏，進賢星座甚分明。"],"s":"mixed","f":"simp"},{"i":"77af18b1-1de2-4000-860f-6d6da8349e2f","t":"書壁","a":"黃損","d":"唐","g":"短诗","p":["一別人間歲月多，歸來人事已銷磨。","惟有門前鑑池水，春風不改舊時波。"],"s":"trad","f":"simp"},{"i":"e1ffb563-e56f-46de-8667-9c6e3562b55a","t":"句","a":"黃損","d":"唐","g":"古体","p":["機關纔運動，勝敗便相隨。","忽遇南遷客，若爲西入心。","往來三島近，活計一囊空。","三通明主詔，一片白雲心。","掃地待明月，踏花迎野僧。","水諳彭澤闊，山憶武陵深。","金鐙冷光風宛轉，錦袍紅潤雨霏微。","高齊日月方爲道，動合乾坤始是心。","傍水野禽通體白，飣盤山菓半邊紅。","而今世上多離別，莫向相思樹下啼。"],"s":"mixed","f":"simp"},{"i":"684bc1a4-1b63-497b-9df6-93e387f45752","t":"梁郊祀樂章 慶肅","a":"張衮","d":"唐","g":"短诗","p":["籩豆簠簋，黍稷非馨。","懿茲彝器，厥德惟明。","金石匏革，以和以平。","由此無疆，期乎永寧。"],"s":"mixed","f":"simp"},{"i":"64aaf38c-58b2-4b25-a2d2-d03388c2c215","t":"梁郊祀樂章 慶熙","a":"張衮","d":"唐","g":"短诗","p":["哲后躬享，旨酒斯陳。","王恭無斁，嚴祀惟寅。","皇祖以配，大孝以振。","宜錫景福，永休下民。"],"s":"mixed","f":"simp"},{"i":"02122e2d-f7f5-47b5-9e42-0924f4e45acc","t":"梁郊祀樂章 慶隆","a":"張衮","d":"唐","g":"短诗","p":["恭祀上帝，于國之陽。","爵醴是荷，鴻基永昌。"],"s":"mixed","f":"simp"},{"i":"c19ffb32-9417-4fcf-9a88-0365f13e78ba","t":"梁郊祀樂章 慶融","a":"張衮","d":"唐","g":"短诗","p":["導和氣兮襲氤氳，宣皇使兮彰聖神。","服遐裔兮敷質文，格苗扈兮息煙塵。"],"s":"mixed","f":"simp"},{"i":"6bf741e0-5fdc-4608-bac9-0ba36f47de03","t":"梁郊祀樂章 慶休","a":"張衮","d":"唐","g":"短诗","p":["大業來四夷，仁風和萬國。","白日體無私，皇天輔有德。","七旬罪已服，六旬師方克。","偉哉帝道隆，終始常作則。"],"s":"mixed","f":"simp"},{"i":"2533cef0-3afa-4c02-995d-109b62814792","t":"梁郊祀樂章 慶和","a":"張衮","d":"唐","g":"短诗","p":["煙燎昇，禮容徹。","誠感達，人神悅。","靈貺彰，聖情結。","玉座寂，金罏歇。"],"s":"mixed","f":"simp"},{"i":"9cbda0f3-35f6-4a45-ac70-b08a79eec38c","t":"梁郊祀樂章 慶和 一","a":"趙光逢","d":"唐","g":"短诗","p":["就陽位，昇圜丘。","佩雙玉，御大裘。","膺天命，擁神休。","萬靈感，百祿遒。"],"s":"trad","f":"simp"},{"i":"d512676d-d05d-43ba-a2dc-387c41b5f8f7","t":"梁郊祀樂章 慶和 二","a":"趙光逢","d":"唐","g":"短诗","p":["秉黃鉞，建朱旗。","震八表，清二儀。","帝業顯，王道夷。","受景命，啓皇基。"],"s":"mixed","f":"simp"},{"i":"2e2e7e2a-c8b1-49a4-9c81-ad84d3000fa8","t":"梁郊祀樂章 慶和 三","a":"趙光逢","d":"唐","g":"短诗","p":["開九門，懷百神。","通肸蠁，接氤氳。","明粢薦，廣樂陳。","奠嘉璧，燎芳薪。"],"s":"trad","f":"simp"},{"i":"9b51eef9-6a73-4e67-a878-a42ba109cb39","t":"梁郊祀樂章 慶和 四","a":"趙光逢","d":"唐","g":"短诗","p":["膺寶圖，執左契。","德應天，聖饗帝。","薦表衷，荷靈惠。","壽萬年，祚百世。"],"s":"trad","f":"simp"},{"i":"d152f46d-9fa4-403d-ab40-672416710ee1","t":"梁郊祀樂章 慶和 五","a":"趙光逢","d":"唐","g":"短诗","p":["惟德動天，有感必通。","秉茲一德，禋於六宗。","欽夤寶命，恭肅禮容。","來顧來享，永穆皇風。"],"s":"trad","f":"simp"},{"i":"87792c2e-d2b7-4eac-8d2d-2aa1fa6240a2","t":"梁郊祀樂章 慶和 六","a":"趙光逢","d":"唐","g":"短诗","p":["天惟佑德，辟乃奉天。","交感斯在，昭事罔愆。","歲功已就，王道無偏。","於焉報本，是用告虔。"],"s":"mixed","f":"simp"},{"i":"0f5202c1-6836-4721-bce6-06bdb058466b","t":"梁郊祀樂章 慶順","a":"趙光逢","d":"唐","g":"短诗","p":["聖皇戾止，天步舒遲。","乾乾睿相，穆穆皇儀。","進退必肅，陟降是祗。","六變克協，萬靈協隨。"],"s":"trad","f":"simp"},{"i":"50b3e7d3-dbc8-403f-80bd-432b02ac60ca","t":"梁郊祀樂章 慶平","a":"趙光逢","d":"唐","g":"短诗","p":["天命降鑒，帝德惟馨。","享祀不忒，禮容孔明。","奠璧布幣，薦純獻精。","神祐以荅，敷錫永寧。"],"s":"trad","f":"simp"},{"i":"a55092e8-0ff9-4291-89a9-085f5ea53724","t":"宮詞百首 一","a":"和凝","d":"唐","g":"短诗","p":["紫燎光銷大駕歸，御樓初見赭黃衣。","千聲鼓定將宣赦，竿上金雞翅欲飛。"],"s":"trad","f":"simp"},{"i":"9962a1b2-55f8-4aac-a8f7-8150f5ea6d32","t":"宮詞百首 二","a":"和凝","d":"唐","g":"短诗","p":["北闕晴分五鳳樓，嵩山秀色護神州。","洛河自契千年運，更擬波中出九疇。"],"s":"trad","f":"simp"},{"i":"d806ecc3-fec4-4995-bc77-2588deca4ba0","t":"宮詞百首 三","a":"和凝","d":"唐","g":"短诗","p":["中興殿上曉光融，一炷天香舞瑞風。","百辟虔心齊稽首，捲簾遙見御衣紅。"],"s":"trad","f":"simp"},{"i":"bccda39f-8653-4646-98e2-c2b1a9b699b2","t":"宮詞百首 四","a":"和凝","d":"唐","g":"短诗","p":["日和風暖御樓時，萬姓齊瞻八彩眉。","瑞氣祥烟籠細仗，閤門宣赦四方知。"],"s":"mixed","f":"simp"},{"i":"d47db8c4-ad10-4c53-abc1-768716215c98","t":"宮詞百首 五","a":"和凝","d":"唐","g":"短诗","p":["鳳吹鸞歌曉日明，豐年觀稼出神京。","封人爭獻南山壽，五色雲中御輦平。"],"s":"trad","f":"simp"},{"i":"1bf0edf7-f8f5-4abb-84f8-b0f0adea887b","t":"宮詞百首 六","a":"和凝","d":"唐","g":"短诗","p":["聖主臨軒待曉時，穿花宮漏正遲遲。","雞人一唱乾坤曉，百辟分班儼羽儀。"],"s":"trad","f":"simp"},{"i":"886a47d9-bdde-41be-a827-e2072c705f40","t":"宮詞百首 七","a":"和凝","d":"唐","g":"短诗","p":["朦朧西月照池亭，初夜椒房掩畫屏。","宮女相呼有何事，上樓同看老人星。"],"s":"trad","f":"simp"},{"i":"2e2c40fb-62a7-43cb-b0d2-e33d11b8da9e","t":"宮詞百首 八","a":"和凝","d":"唐","g":"短诗","p":["紅泥椒殿綴珠璫，帳蹙金龍窣地長。","紅獸慢然天色暖，鳳爐時復爇沈香。"],"s":"trad","f":"simp"},{"i":"ff00e8da-9f3c-453b-9584-ae7246131fa0","t":"宮詞百首 九","a":"和凝","d":"唐","g":"短诗","p":["九重樓殿簇丹青，高柳含烟覆井亭。","宮內不知今日幾，自來階下數堯蓂。"],"s":"mixed","f":"simp"},{"i":"798f19b6-66eb-411f-b8cc-c4c7178d47d1","t":"宮詞百首 十","a":"和凝","d":"唐","g":"短诗","p":["寢殿香濃玉漏嚴，雲隨涼月下西南。","帳前宮女低聲道，主上還應夢傅巖。"],"s":"trad","f":"simp"},{"i":"d7133c7f-b36f-4bde-a65e-2c3096342cb5","t":"宮詞百首 十一","a":"和凝","d":"唐","g":"短诗","p":["遶殿鉤欄壓玉階，內人輕語凭蔥薹。","皆言明主垂衣理，不假朱雲傍檻來。"],"s":"mixed","f":"simp"},{"i":"2006fd35-62b4-49e6-acd5-8fe7a8857379","t":"宮詞百首 十二","a":"和凝","d":"唐","g":"短诗","p":["顢頇冰面瑩池心，風刮瑤階臘雪深。","怪得宮中無獸炭，步搖釵是辟寒金。"],"s":"mixed","f":"simp"},{"i":"aee17ffc-eba8-415d-b08b-c5a342f6e59c","t":"宮詞百首 十三","a":"和凝","d":"唐","g":"短诗","p":["蘭殿春融自靘笙，玉顏風透象紗明。","金簧如語鶯聲滑，可使雲和獨得名。"],"s":"trad","f":"simp"},{"i":"dd4d993b-7808-418e-8725-b582e707201a","t":"宮詞百首 十四","a":"和凝","d":"唐","g":"短诗","p":["蘭燭時將鳳髓添，寒星遙映夜光簾。","龍樓露著鴛鴦瓦，誰近螭頭擲玉籤。"],"s":"trad","f":"simp"},{"i":"eecfb756-93c5-41fd-b5c3-2f6cfabbca56","t":"宮詞百首 十五","a":"和凝","d":"唐","g":"短诗","p":["玉甃蓮池春水平，小魚雙竝錦鱗行。","內中知是黃河樣，九曲今年徹底清。"],"s":"trad","f":"simp"},{"i":"e4908530-bd4b-4664-bbf6-ec6e6cedf0f9","t":"宮詞百首 十六","a":"和凝","d":"唐","g":"短诗","p":["真珠簾外靜無塵，耿耿涼天景象新。","金殿夜深銀燭晃，宮嬪來奏月重輪。"],"s":"trad","f":"simp"},{"i":"7f156b9f-d033-44cc-8a3b-57dc28f2a825","t":"宮詞百首 十七","a":"和凝","d":"唐","g":"短诗","p":["魚犀月掌夜通頭，自著盤鶯錦臂韝。","多把沈檀配龍麝，宮中掌浸十香油。"],"s":"trad","f":"simp"},{"i":"2e545b86-8026-4d49-843d-4bb2f2d979d1","t":"宮詞百首 十八","a":"和凝","d":"唐","g":"短诗","p":["香雲雙颭玉蟬輕，侍從君王苑裏行。","嘉瑞忽逢連理木，一時跪拜賀文明。"],"s":"mixed","f":"simp"},{"i":"fd80718b-1764-439b-b605-7f14622de429","t":"宮詞百首 十九","a":"和凝","d":"唐","g":"短诗","p":["金鸞雙立紫檀槽，暖殿無風韻自高。","含笑試彈紅蘂調，君王宣賜酪櫻桃。"],"s":"trad","f":"simp"},{"i":"ec9c2ae1-b5dc-4334-aea7-a3bf422a6ebf","t":"宮詞百首 二十","a":"和凝","d":"唐","g":"短诗","p":["斑簟如霞可殿鋪，更開新進瑞蓮圖。","誰人築損珊瑚架，子細看時認瀝蘇。"],"s":"trad","f":"simp"},{"i":"4983b102-f06d-479b-b5d5-a897f19f89c1","t":"宮詞百首 二十一","a":"和凝","d":"唐","g":"短诗","p":["金盆初曉洗纖纖，銀鴨香焦特地添。","出戶忽看春雪下，六宮齊捲水晶簾。"],"s":"trad","f":"simp"},{"i":"bad15ec0-9b1f-4126-aa61-24a3ad2f7570","t":"宮詞百首 二十二","a":"和凝","d":"唐","g":"短诗","p":["暖金盤裏點酥山，擬望君王子細看。","更向眉中分曉黛，巖邊染出碧琅玕。"],"s":"mixed","f":"simp"},{"i":"c55168d9-3cc8-471e-970e-c98a2c3c6139","t":"宮詞百首 二十三","a":"和凝","d":"唐","g":"短诗","p":["雲母屏前繡柱衣，龍牀閑卷諫書幃。","黃金檻外螭頭活，日照紅蘭露未晞。"],"s":"mixed","f":"simp"},{"i":"b2be5e48-2b13-4f93-b547-f440af96ab9f","t":"宮詞百首 二十四","a":"和凝","d":"唐","g":"短诗","p":["樓西殘月尚朧明，中禁雞人報曉聲。","清旦司天臺進狀，夜來晴霽泰階平。"],"s":"trad","f":"simp"},{"i":"6b3da3a0-3d67-42f1-bd5a-3eb293b69c75","t":"宮詞百首 二十五","a":"和凝","d":"唐","g":"短诗","p":["纖轡摩軒響佩環，銀臺門外集鴛鸞。","三鐘五鼓祥烟歛，日照仙人捧露盤。"],"s":"mixed","f":"simp"},{"i":"54651f4d-ed98-42fe-8cad-4a8a4d65a4c6","t":"宮詞百首 二十六","a":"和凝","d":"唐","g":"短诗","p":["司膳廚中也禁烟，春宮相對畫秋千。","清明節日頒新火，蠟炬星飛下九天。"],"s":"mixed","f":"simp"},{"i":"a6134b65-35e0-43e6-b8d9-ce0119906190","t":"宮詞百首 二十七","a":"和凝","d":"唐","g":"短诗","p":["宮木交芳色盡深，和風輕舞早鶯吟。","侍臣不異東方朔，應喜仙桃滿禁林。"],"s":"trad","f":"simp"},{"i":"6d5be5c3-d894-4148-bbf0-287feb6ecaee","t":"宮詞百首 二十八","a":"和凝","d":"唐","g":"短诗","p":["貢橘香勻䩋𩉙容，星光初滿小金籠。","近臣押賜諸王宅，拜了方開敕字封。"],"s":"trad","f":"simp"},{"i":"9ac5aee3-394e-4bb8-b427-abe5d0206f13","t":"宮詞百首 二十九","a":"和凝","d":"唐","g":"短诗","p":["獻壽朝元欲偃戈，航深梯險競駢羅。","若論萬國來朝日，比竝塗山更較多。"],"s":"trad","f":"simp"},{"i":"0f280a12-b84e-4eda-bc9d-87add378de33","t":"宮詞百首 三十","a":"和凝","d":"唐","g":"短诗","p":["豔陽風景簇神州，杏蘂桃心照鳳樓。","遙望青青河畔草，幾多歸馬與休牛。"],"s":"trad","f":"simp"},{"i":"b70481ef-25bd-4961-9ce6-2a569bcfb8ea","t":"宮詞百首 三十一","a":"和凝","d":"唐","g":"短诗","p":["鑾輿觀稼晚方歸，日月旗中見御衣。","萬姓焚香惟頂禮，瑞雪隨繖入宮闈。"],"s":"trad","f":"simp"},{"i":"e63e56bd-a0bb-42f2-97be-597712edabea","t":"宮詞百首 三十二","a":"和凝","d":"唐","g":"短诗","p":["宮庭皆應紫微垣，壯麗宸居顯至尊。","赤子顒顒瞻父母，已將仁德比乾坤。"],"s":"trad","f":"simp"},{"i":"91ad589f-8ba0-4588-b5c7-c0b37f436652","t":"宮詞百首 三十三","a":"和凝","d":"唐","g":"短诗","p":["三農皆已闢田疇，又見金門出土牛。","塊雨條風符聖化，嘉禾看却報新秋。"],"s":"mixed","f":"simp"}]