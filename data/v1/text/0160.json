[{"i":"1c0d2513-d896-4ce1-a06d-8810f696e545","t":"雨過山村","a":"王建","d":"唐","g":"短诗","p":["雨裏雞鳴一兩家，竹溪村路板橋斜。","婦姑相喚浴蠶去，閑看中庭梔子花。"],"s":"mixed","f":"simp"},{"i":"d33abcca-535d-47ae-8cd9-725c0f0f1b5e","t":"山店","a":"王建","d":"唐","g":"短诗","p":["登登石路何時盡，決決溪泉到處聞。","風動葉聲山犬吠，一家松火隔秋雲。"],"s":"trad","f":"simp"},{"i":"ca16fd7a-26e1-431e-8ca9-21dc29a7a988","t":"雨中寄東溪韋處士","a":"王建","d":"唐","g":"短诗","p":["雨中溪破無乾地，浸著牀頭濕著書。","一箇月來山水隔，不知茅屋若爲居。"],"s":"mixed","f":"simp"},{"i":"210ba813-2a72-42c0-ad24-23bab9962f5a","t":"乞竹","a":"王建","d":"唐","g":"短诗","p":["乞取池西三兩竿，房前栽著病時看。","亦知自惜難判割，猶勝橫根引出欄。"],"s":"trad","f":"simp"},{"i":"a792fe89-52b2-40d9-bd42-c4e8dc6949aa","t":"人家看花","a":"王建","d":"唐","g":"短诗","p":["年少狂疎逐君馬，去來憔悴到京華。","恨無閑地栽仙藥，長傍人家看好花。"],"s":"trad","f":"simp"},{"i":"6bbe646d-8cba-4ce4-83f0-be2335d014e5","t":"未央風","a":"王建","d":"唐","g":"短诗","p":["五更先起玉階東，漸入千門萬戶中。","總向高樓吹舞袖，秋風還不及春風。"],"s":"trad","f":"simp"},{"i":"84c5ec2e-c2ac-4651-beb1-e135a51087d5","t":"歸山莊","a":"王建","d":"唐","g":"短诗","p":["長安寄食半年餘，重向人邊乞薦書。","山路獨歸衝夜雪，落斜騎馬避柴車。"],"s":"trad","f":"simp"},{"i":"9894e249-6b01-4703-ae50-dbc73beb1249","t":"寒食憶歸","a":"王建","d":"唐","g":"短诗","p":["京中曹局無多事，寒食貧兒要在家。","遮莫杏園勝別處，亦須歸看傍村花。"],"s":"trad","f":"simp"},{"i":"5e4c26bb-a622-4b23-b501-d9c3d94d8547","t":"留別張廣文","a":"王建","d":"唐","g":"短诗","p":["謝恩新入鳳皇城，亂定相逢合眼明。","千萬求方好將息，杏花寒食的同行。"],"s":"mixed","f":"simp"},{"i":"53eb8316-b634-449c-8af7-c402bc9fe6c9","t":"送鄭山人歸山","a":"王建","d":"唐","g":"短诗","p":["玉作車轅蒲作輪，當初不起潁陽人。","一家總入嵩山去，天子何因得諫臣。"],"s":"trad","f":"simp"},{"i":"20e125a1-8206-4227-a842-317875fa7d59","t":"傷墮水烏","a":"王建","d":"唐","g":"短诗","p":["一烏墮水百烏啼，相吊相號遶故堤。","眼見行人車輾過，不妨同伴各東西。"],"s":"trad","f":"simp"},{"i":"3b8d611d-361b-4cdd-ad6a-7f840533d9f6","t":"看碁","a":"王建","d":"唐","g":"短诗","p":["彼此抽先局勢平，傍人道死的還生。","兩邊對坐無言語，盡日時聞下子聲。"],"s":"trad","f":"simp"},{"i":"90e41a0d-5d0e-420b-a07b-7612bf95243d","t":"設酒寄獨孤少府","a":"王建","d":"唐","g":"短诗","p":["自看和釀一依方，緣看松花色較黃。","不分君家新酒熟，好詩收得被回將。"],"s":"trad","f":"simp"},{"i":"727ef1d7-5360-49e3-9c70-2e02ec31fe40","t":"贈人二首 一","a":"王建","d":"唐","g":"短诗","p":["金爐煙裏要班頭，欲得歸山可自由。","每度報朝愁入閣，在先教示小千牛。"],"s":"mixed","f":"simp"},{"i":"3517beea-e904-4f17-afa9-a2937b1fa386","t":"贈人二首 二","a":"王建","d":"唐","g":"短诗","p":["多在蓬萊少在家，越緋衫上有紅霞。","朝回不向諸餘處，騎馬城西檢校花。"],"s":"trad","f":"simp"},{"i":"34ad3c3f-ec93-4855-89ca-ae75de234ed3","t":"樓前","a":"王建","d":"唐","g":"短诗","p":["天寶年前勤政樓，每年三日作千秋。","飛龍老馬曾教舞，聞著音聲總舉頭。"],"s":"trad","f":"simp"},{"i":"5b67af64-69c2-42ec-9df6-7cfc3258fe06","t":"寄劉蕡問疾","a":"王建","d":"唐","g":"短诗","p":["年少病多應爲酒，誰家將息過今春。","賒來半夏重熏盡，投著山中舊主人。"],"s":"mixed","f":"simp"},{"i":"ad7b03c0-c364-464d-92cd-a5e0556d6dbe","t":"聽雨","a":"王建","d":"唐","g":"短诗","p":["半夜思家睡裏愁，雨聲落落屋簷頭。","照泥星出依前黑，淹爛庭花不肯休。"],"s":"mixed","f":"simp"},{"i":"97dc68d1-e571-485c-843d-cac07a7cab81","t":"新晴","a":"王建","d":"唐","g":"短诗","p":["夏夜新晴星校少，雨收殘水入天河。","簷前熟著衣裳坐，風冷渾無撲火蛾。"],"s":"trad","f":"simp"},{"i":"18b920d0-5616-48aa-9753-73af6ccf8813","t":"秋日後","a":"王建","d":"唐","g":"短诗","p":["住處近山常足雨，聞晴曬曝舊芳茵。","立秋日後無多熱，漸覺生衣不著身。"],"s":"trad","f":"simp"},{"i":"178dce62-9f2c-4c71-9097-efece2e43708","t":"哭孟東野二首 一","a":"王建","d":"唐","g":"短诗","p":["吟損秋天月不明，蘭無香氣鶴無聲。","自從東野先生死，側近雲山得散行。"],"s":"trad","f":"simp"},{"i":"f8919dad-b1f9-4bc8-a6e9-42c9b4f96e89","t":"哭孟東野二首 二","a":"王建","d":"唐","g":"短诗","p":["老松臨死不生枝，東野先生早哭兒。","但是洛陽城裏客，家傳一本杏殤詩。"],"s":"mixed","f":"simp"},{"i":"43f2a986-5f8e-4e70-92a0-6d5838262dde","t":"寄蜀中薛濤校書","a":"王建","d":"唐","g":"短诗","p":["萬里橋邊女校書，枇杷花裏閉門居。","掃眉才子於今少，管領春風總不如。"],"s":"mixed","f":"simp"},{"i":"f0ecaa9a-f72e-4c01-bbaf-1420710e25d6","t":"路中上田尚書","a":"王建","d":"唐","g":"短诗","p":["去路何詞見六親，手中刀尺不如人。","可憐池閣秋風夜，愁綠嬌紅一遍新。"],"s":"trad","f":"simp"},{"i":"6acb536a-2868-40c5-b09f-64e84e290f8f","t":"于主簿廳看花","a":"王建","d":"唐","g":"短诗","p":["小葉稠枝粉壓摧，暖風吹動鶴翎開。","若無別事爲留滯，應便拋家宿看來。"],"s":"mixed","f":"simp"},{"i":"1ac781c0-55ba-4854-bcb7-8ceda3849a53","t":"江樓對雨寄杜書記","a":"王建","d":"唐","g":"短诗","p":["竹煙花雨細相和，看著閑書睡更多。","好是主人無事日，應持小酒按新歌。"],"s":"trad","f":"simp"},{"i":"76bfa201-6d01-40e7-8115-714ab1c10b9e","t":"觀蠻妓","a":"王建","d":"唐","g":"短诗","p":["欲說昭君歛翠蛾，清聲委曲怨于歌。","誰家年少春風裏，拋與金錢唱好多。"],"s":"mixed","f":"simp"},{"i":"4e70707e-2204-4948-9632-492fb98e6a20","t":"送顧非熊秀才歸丹陽","a":"王建","d":"唐","g":"短诗","p":["江城柳色海門煙，欲到茅山始下船。","知道君家當瀑布，菖蒲潭在草堂前。"],"s":"trad","f":"simp"},{"i":"aabc8b89-aa9f-4b74-ae78-3d9f74be7133","t":"老人歌","a":"王建","d":"唐","g":"短诗","p":["白髮老人垂淚行，上皇生日出京城。","如今供奉多新意，錯唱當時一半聲。"],"s":"trad","f":"simp"},{"i":"8f22c077-c772-4f0c-90ea-8a3978a29dee","t":"和元郎中從八月十二至十五夜翫月五首 一","a":"王建","d":"唐","g":"短诗","p":["半秋初入中旬夜，已向堦前守月明。","從未圓時看却好，一分分見傍輪生。"],"s":"mixed","f":"simp"},{"i":"5c237906-5af5-411e-9a0e-9174330d100b","t":"和元郎中從八月十二至十五夜翫月五首 二","a":"王建","d":"唐","g":"短诗","p":["亂雲遮却臺東月，不許教依次第看。","莫爲詩家先見鏡，被他寵與作艱難。"],"s":"mixed","f":"simp"},{"i":"b0b6b249-3dce-46bf-9b4d-373b4cd34a35","t":"和元郎中從八月十二至十五夜翫月五首 三","a":"王建","d":"唐","g":"短诗","p":["今夜月明勝昨夜，新添桂樹近東枝。","立多地濕舁牀坐，看過牆西寸寸遲。"],"s":"mixed","f":"simp"},{"i":"1f883ef7-297d-4b93-891a-24ab34badd79","t":"和元郎中從八月十二至十五夜翫月五首 四","a":"王建","d":"唐","g":"短诗","p":["月似圓來色漸凝，玉盆盛水欲侵稜。","夜深盡放家人睡，直到天明不炷燈。"],"s":"trad","f":"simp"},{"i":"59583a2e-fc8d-457d-9e3a-4f8c63e7da91","t":"和元郎中從八月十二至十五夜翫月五首 五","a":"王建","d":"唐","g":"短诗","p":["合望月時常望月，分明不得似今年。","仰頭五夜風中立，從未圓時直到圓。"],"s":"trad","f":"simp"},{"i":"b355c8fc-db00-4e76-8cab-3f9bf5d8a72f","t":"對酒","a":"王建","d":"唐","g":"短诗","p":["爲病比來渾斷絕，緣花不免却知聞。","從來事事關身少，主領春風只在君。"],"s":"mixed","f":"simp"},{"i":"8f4bc049-274b-493b-a481-2546ada10200","t":"曉望華清宮","a":"王建","d":"唐","g":"短诗","p":["曉來樓閣更鮮明，日出闌干見鹿行。","武帝自知身不死，看修玉殿號長生。"],"s":"mixed","f":"simp"},{"i":"531c8fdd-7e2d-457e-8e0d-b2e9333f5e81","t":"贈李愬僕射二首 一","a":"王建","d":"唐","g":"短诗","p":["和雪翻營一夜行，神旗凍定馬無聲。","遙看火號連營赤，知是先鋒已上城。"],"s":"trad","f":"simp"},{"i":"75cc728f-c062-449f-a8e3-f19f6361d0e2","t":"贈李愬僕射二首 二","a":"王建","d":"唐","g":"短诗","p":["旗幡四面下營稠，手詔頻來老將憂。","每日城南空挑戰，不知生縛入唐州。"],"s":"trad","f":"simp"},{"i":"538b37af-a94b-4881-9008-171a22b3a679","t":"秋夜對雨寄石甕寺二秀才","a":"王建","d":"唐","g":"短诗","p":["夜山秋雨滴空廊，燈照堂前樹葉光。","對坐讀書終卷後，自披衣被掃僧房。"],"s":"trad","f":"simp"},{"i":"12fe62b3-64cb-41db-8b46-9b2b61d2f250","t":"華清宮前柳","a":"王建","d":"唐","g":"短诗","p":["楊柳宮前忽地春，在先驚動探春人。","曉來唯欠驪山雨，洗却枝頭綠上塵。"],"s":"mixed","f":"simp"},{"i":"00677727-a9af-4f71-8828-26c450dbe87b","t":"別楊校書","a":"王建","d":"唐","g":"短诗","p":["從軍秣馬十三年，白髮營中聽早蟬。","故作老丞身不避，縣名昭應管山泉。"],"s":"trad","f":"simp"},{"i":"67b22b61-6cda-485b-a863-51e433f16daa","t":"和門下武相公春曉聞鶯","a":"王建","d":"唐","g":"短诗","p":["侵黑行飛一兩聲，春寒囀小未分明。","若教更解諸餘語，應向宮花不惜情。"],"s":"trad","f":"simp"},{"i":"d9789e09-3b2a-44e8-b262-c7ab66992c6e","t":"田侍郎歸鎮 一","a":"王建","d":"唐","g":"短诗","p":["去處長將決勝籌，回回身在陣前頭。","賊城破後先鋒入，看著紅妝不敢收。"],"s":"trad","f":"simp"},{"i":"d49656e0-2313-441d-a3b1-11349454f56f","t":"田侍郎歸鎮 二","a":"王建","d":"唐","g":"短诗","p":["熨帖朝衣拋戰袍，夔龍班裏侍中高。","對時先奏牙間將，次第天恩與節旄。"],"s":"mixed","f":"simp"},{"i":"5e22d372-6a01-4578-ab93-2ee7182f71b2","t":"田侍郎歸鎮 三","a":"王建","d":"唐","g":"短诗","p":["踏著家鄉馬腳輕，暮山秋色眼前明。","老人上酒齊頭拜，得侍中來盡再生。"],"s":"trad","f":"simp"},{"i":"e79e1752-434f-414a-a722-65a02714a3ef","t":"田侍郎歸鎮 四","a":"王建","d":"唐","g":"短诗","p":["功成誰不擁藩方，富貴還須是本鄉。","萬里雙旌汾水上，玉鞭遙指白雲莊。"],"s":"mixed","f":"simp"},{"i":"5714a972-d577-4402-a1d4-e62d53d79acf","t":"田侍郎歸鎮 五","a":"王建","d":"唐","g":"短诗","p":["鼓吹旛旗道兩邊，行男走女喜駢闐。","舊交省得當時別，指點如今却少年。"],"s":"mixed","f":"simp"},{"i":"d17ebc8b-4230-4123-a14e-dfabf626e1f3","t":"田侍郎歸鎮 六","a":"王建","d":"唐","g":"短诗","p":["廣場破陣樂初休，彩纛高于百尺樓。","老將氣雄爭起舞，管弦回作大纏頭。"],"s":"mixed","f":"simp"},{"i":"da159cc5-ae80-4fb9-99d4-ed49aa8b3d0b","t":"田侍郎歸鎮 七","a":"王建","d":"唐","g":"短诗","p":["笳聲萬里動燕山，草白天清塞馬閑。","觸處不如別處樂，可憐秋月照江關。"],"s":"mixed","f":"simp"},{"i":"06124ae1-83c0-48ea-a0ae-c8cd7c2181f1","t":"田侍郎歸鎮 八","a":"王建","d":"唐","g":"短诗","p":["將士請衣忘却貧，綠窗紅燭酒樓新。","家家盡踏還鄉曲，明月街中不絕人。"],"s":"mixed","f":"simp"},{"i":"193c8e13-19a9-49c0-8553-406704c1422b","t":"寄廣文張博士","a":"王建","d":"唐","g":"短诗","p":["春明門外作卑官，病友經年不得看。","莫道長安近于日，昇天却易到城難。"],"s":"mixed","f":"simp"},{"i":"2adaaab8-0538-477d-babe-254b4cc9205f","t":"早春書情","a":"王建","d":"唐","g":"短诗","p":["漸老風光不著人，花溪柳陌早逢春。","近來行到門前少，趁暖閑眠似病人。"],"s":"trad","f":"simp"},{"i":"d39a6efc-8e25-46d6-bcc9-d0c3cc5a9796","t":"唐昌觀玉蕋花","a":"王建","d":"唐","g":"短诗","p":["一樹籠𩮀玉刻成，飄廊點地色輕輕。","女冠夜覓香來處，唯見階前碎月明。"],"s":"trad","f":"simp"},{"i":"dce8e95c-03c0-45f5-89a3-d0a1ac788ac2","t":"眼病寄同官","a":"王建","d":"唐","g":"短诗","p":["天寒眼痛少心情，隔霧看人夜裏行。","年少往來常不住，牆西凍地馬蹄聲。"],"s":"mixed","f":"simp"},{"i":"0308766c-4823-4c11-b046-648c66694b8b","t":"九日登叢臺","a":"王建","d":"唐","g":"短诗","p":["平原池閣在誰家，雙塔叢臺野菊花。","零落故宮無入路，西來澗水繞城斜。"],"s":"trad","f":"simp"},{"i":"e88c0a93-25d4-483b-9458-cbbd01ae2fff","t":"題酸棗縣蔡中郎碑","a":"王建","d":"唐","g":"短诗","p":["蒼苔滿字土埋龜，風雨銷磨絕妙詞。","不向圖經中舊見，無人知是蔡邕碑。"],"s":"trad","f":"simp"},{"i":"7556d5b5-6c70-4d7d-9035-82324f377648","t":"江陵使至汝州","a":"王建","d":"唐","g":"短诗","p":["回看巴路在雲間，寒食離家麥熟還。","日暮數峰青似染，商人說是汝州山。"],"s":"trad","f":"simp"},{"i":"7d6c16de-1d7e-4564-979b-e93e42ab176b","t":"十五夜望月寄杜郎中","a":"王建","d":"唐","g":"短诗","p":["中庭地白樹棲鴉，冷露無聲濕桂花。","今夜月明人盡望，不知秋思在誰家。"],"s":"trad","f":"simp"},{"i":"c43af341-9b07-472d-b881-402d053bb96c","t":"寄同州田長史","a":"王建","d":"唐","g":"短诗","p":["除聽好語耳常聾，不見詩人眼底空。","莫怪出城爲長史，總緣山在白雲中。"],"s":"mixed","f":"simp"},{"i":"95f49e0e-117f-43ed-a1be-176bf07fa24d","t":"外按","a":"王建","d":"唐","g":"短诗","p":["夾城門向野田開，白鹿非時出洞來。","日暮秦陵塵土起，從東外按使初回。"],"s":"trad","f":"simp"},{"i":"a82ac4bb-b67d-4e05-a73d-f2f4552e311f","t":"宮詞一百首 一","a":"王建","d":"唐","g":"短诗","p":["蓬萊正殿壓金鼇，紅日初生碧海濤。","閑著五門遙北望，柘黃新帕御牀高。"],"s":"mixed","f":"simp"},{"i":"f6676981-e083-47f3-af47-cf93762c9f10","t":"宮詞一百首 二","a":"王建","d":"唐","g":"短诗","p":["殿前傳點各依班，召對西來八詔蠻。","上得青花龍尾道，側身偷覷正南山。"],"s":"trad","f":"simp"},{"i":"5883d5de-6c74-425b-a502-d04eb49aef7c","t":"宮詞一百首 三","a":"王建","d":"唐","g":"短诗","p":["龍煙日暖紫曈曈，宣政門當玉殿風。","五刻閣前卿相出，下簾聲在半天中。"],"s":"trad","f":"simp"},{"i":"185a5cd7-628e-46a1-85bc-05c7a57ffc59","t":"宮詞一百首 四","a":"王建","d":"唐","g":"短诗","p":["白玉窗前起草臣，櫻桃初赤賜嘗新。","殿頭傳語金階遠，只進詞來謝聖人。"],"s":"trad","f":"simp"},{"i":"e2e17937-790f-42fa-9add-95c27eb16022","t":"宮詞一百首 五","a":"王建","d":"唐","g":"短诗","p":["內人對御疊花牋，繡坐移來玉案邊。","紅蠟燭前呈草本，平明舁出閣門宣。"],"s":"trad","f":"simp"},{"i":"daaf31ca-9e62-41ed-acba-073c77b4d1b0","t":"宮詞一百首 六","a":"王建","d":"唐","g":"短诗","p":["千牛仗下放朝初，玉案傍邊立起居。","每日進來金鳳紙，殿頭無事不多書。"],"s":"trad","f":"simp"},{"i":"40becd46-16d8-4e81-a