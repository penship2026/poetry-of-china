[{"i":"39ff5d21-333b-41f0-8985-d3728a5eed44","t":"嘲李瑒題名","a":"韋蟾","d":"唐","g":"短诗","p":["渭水秦山照眼明，希仁何事寡詩情。","只因學得虞姬壻，書字纔能記姓名。"]},{"i":"bea387d6-c934-4229-bfa4-d0fec315043d","t":"聞鹿鳴互謔","a":"嚴震","d":"唐","g":"短诗","p":["釜戴山中鹿又鳴，此際多應到表兄。","表兄不是嚴家子，合是三兄與四兄。"]},{"i":"de4de19c-e5ab-42fb-a9ee-77c05cce3ed7","t":"及第後寄李紳","a":"章孝標","d":"唐","g":"短诗","p":["及第全勝十政官，金鞍鍍了出長安。","馬頭漸入揚州郭，爲報時人洗眼看。"]},{"i":"af5670b6-a62b-4ebc-95ec-0b6ee21b9129","t":"荅章孝標","a":"李紳","d":"唐","g":"短诗","p":["假金只用真金鍍，若是真金不鍍金。","十載長安得一第，何須空腹用高心。"]},{"i":"0aa6f166-ea50-4941-83fd-d6c163bfcbf8","t":"戲柳棠","a":"楊汝士","d":"唐","g":"短诗","p":["文章漫道能吞鳳，杯酒何曾解喫魚。","今日梓州張社會，應須遭這老尚書。"]},{"i":"4223b9a6-5ec5-4bf6-bab2-627b02c7e69e","t":"荅楊尚書","a":"柳棠","d":"唐","g":"短诗","p":["未向燕臺逢厚禮，幸因社會接餘歡。","一魚喫了終無媿，鯤化爲鵬也不難。"]},{"i":"6d46a870-f18f-471a-8d82-a26c259d0452","t":"又忤楊尚書詩","a":"柳棠","d":"唐","g":"短诗","p":["莫言名位未相儔，風月何曾阻獻酬。","前輩不須輕後輩，靖安今日在衡州。"]},{"i":"47d8d098-7eb0-4411-a400-ef90874664e3","t":"嘲郭凝素","a":"朱澤","d":"唐","g":"短诗","p":["三春桃李本無言，苦被殘陽鳥雀喧。","借問東鄰效西子，何如郭素擬王軒。"]},{"i":"ae6c6496-7638-4e49-89ce-9c63a146f522","t":"紀中表試案","a":"鄭光業","d":"唐","g":"短诗","p":["新糊案子，其白如銀。","入試出試，千春萬春。"]},{"i":"c48232e4-c4ba-440b-902e-74efb9514633","t":"醉題廣州使院","a":"鄭愚","d":"唐","g":"短诗","p":["數年百姓受飢荒，太守貪殘似虎狼。","今日海隅魚米賤，大須慙媿石榴黃。"]},{"i":"9a88d5b2-0301-4937-9474-e577eca17641","t":"擬權龍褒體贈鄠縣李令及寄朝右","a":"鄭愚","d":"唐","g":"短诗","p":["鄠縣李長官，橫琴膝上弄。","不聞有政聲，但見手子動。"]},{"i":"ab63a001-d9d9-436e-9da8-57a9af708f67","t":"題滄浪峽牓","a":"鄭仁表","d":"唐","g":"短诗","p":["分峽東西路正長，行人名利火然湯。","路傍著板滄浪峽，真是將閑攪撩忙。"]},{"i":"2f3dda59-01cf-40c2-ad9b-8af42c278264","t":"戲妻族語不正","a":"胡曾","d":"唐","g":"短诗","p":["呼十却爲石，喚針將作真。","忽然雲雨至，總道是天因。"]},{"i":"2fb60afc-1c26-4078-86d7-3fa799aaa138","t":"婢僕詩 一","a":"李昌符","d":"唐","g":"短诗","p":["春娘愛上酒家樓，不怕歸遲總不憂。","推道那家娘子臥，且留教住待梳頭。"]},{"i":"d529e239-1a4a-4643-9a62-86c75dcebd1a","t":"婢僕詩 二","a":"李昌符","d":"唐","g":"短诗","p":["不論秋菊與春花，箇箇能噇空腹茶。","無事莫教頻入庫，一名閑物要些些。"]},{"i":"55f0f350-bd42-4b13-9c8c-7bcb603bb6a5","t":"嘲鄭傪妓","a":"孫子多","d":"唐","g":"短诗","p":["相公經文復經武，常侍好今兼好古。","昔人曾聞阿武婆，今日親見阿婆舞。"]},{"i":"888a9b5d-6b80-4e71-b235-b8386b657639","t":"嘲趙璘 一","a":"薛能","d":"唐","g":"短诗","p":["巡關每傍摴蒲局，望月還登乞巧樓。","第一莫教嬌太過，緣人衣帶上人頭。"]},{"i":"ad497017-115e-4449-a5ee-ef722931a6b2","t":"嘲趙璘 二","a":"薛能","d":"唐","g":"短诗","p":["不知原在鞍轎裏，將謂空馱席帽歸。"]},{"i":"814ee97c-84c3-43d5-a30e-f7ff9d3d2cfe","t":"嘲趙璘 三","a":"薛能","d":"唐","g":"短诗","p":["火爐牀上平身立，便與夫人作鏡臺。"]},{"i":"8aae3c10-0234-4ac1-acff-07523bd5d3e3","t":"口號","a":"薛能","d":"唐","g":"短诗","p":["素脊鳴秋杖，烏鞾響暮廳。","刃飛三尺雪，白日落文星。"]},{"i":"786aa650-2834-4fdd-a991-9c541ea4a576","t":"嘲歸仁紹龜詩","a":"皮日休","d":"唐","g":"短诗","p":["硬骨殘形知幾秋，屍骸終是不風流。","頑皮死後鑽須徧，都爲平生不出頭。"]},{"i":"c332420d-5837-4bdc-8156-c42679585b42","t":"詠螃蟹呈浙西從事","a":"皮日休","d":"唐","g":"短诗","p":["未遊滄海早知名，有骨還從肉上生。","莫道無心畏雷電，海龍王處也橫行。"]},{"i":"3f4fafae-f982-45b2-8d6d-36fccb75625f","t":"題中書壁","a":"鄭綮","d":"唐","g":"短诗","p":["側坡蛆蜫蜦，蟻子競來拖。","一朝白雨中，無鈍無嘍羅。"]},{"i":"a47e3068-5c2f-4d4c-a482-a899869de68a","t":"別廬州郡人","a":"鄭綮","d":"唐","g":"短诗","p":["唯有兩行公廨淚，一時灑向渡頭風。"]},{"i":"3d00f20b-f08b-4ad9-9b01-303105e7dced","t":"戲荅成汭","a":"徐彥若","d":"唐","g":"短诗","p":["南海黃茅瘴，不死成和尚。"]},{"i":"8ad02010-ecaf-4652-b6fc-497006aeffe1","t":"醉中謔浙江廉使","a":"崔立言","d":"唐","g":"短诗","p":["山夫留意向丹梯，連帥邀來出藥畦。","常見浙東誇鏡水，鏡湖元在浙江西。"]},{"i":"c6067523-9a43-4ae2-bf7a-5c89347791fe","t":"戲題盱眙邵明府壁","a":"韋鵬翼","d":"唐","g":"短诗","p":["豈肯閑尋竹徑行，却嫌絲管好蛙聲。","自從煮鶴燒琴後，背却青山臥月明。"]},{"i":"7f31dbbc-89da-414c-bc74-6536ad7a2063","t":"題大梁臨汴驛","a":"姚嶸","d":"唐","g":"短诗","p":["近日侯門不重才，莫將文藝擬爲媒。","相逢若要如膠漆，不是紅妝即撥灰。"]},{"i":"a805f242-aae2-4e68-a88e-2591a20cf90d","t":"題仙娥驛","a":"李日新","d":"唐","g":"短诗","p":["商山食店大悠悠，陳鶡䭔鑼古䭃頭。","更有臺中牛肉炙，尚盤數臠紫光毬。"]},{"i":"de87f5c9-6382-4518-99d6-282d657a7258","t":"嘲染家","a":"柳逢","d":"唐","g":"短诗","p":["紫綠終朝染，因何不識非。","莆田竹木貴，背負十柴歸。"]},{"i":"fe864493-5408-4e4e-a0e4-6140a9516e19","t":"贈漳州崔使君鄉飲飜韻詩","a":"黎瓘","d":"唐","g":"短诗","p":["慣向溪邊折柳楊，因循行客到州漳。","無端觸忤王衙押，不得今朝看飲鄉。"]},{"i":"c207359a-1345-4823-9ea5-40055978d0de","t":"示妓牓子","a":"張保胤","d":"唐","g":"短诗","p":["綠羅帬下標三棒，紅粉顋邊淚兩行。","叉手向前咨大使，這迴不敢惱兒郎。"]},{"i":"26c07d83-f75b-4a57-af32-95e1da905984","t":"又留別同院","a":"張保胤","d":"唐","g":"短诗","p":["憶昔當年富貴時，如今頭腦尚依稀。","布袍破後思宮內，錦袴穿時憶御衣。","鶻子背鑽高力士，嬋娟飜畫太真妃。","如今顦顇離南海，恰似當時幸蜀時。"]},{"i":"5451d582-51c6-49ff-92be-32eb6bcf28b0","t":"桂州筵上贈胡予女","a":"陸巖夢","d":"唐","g":"短诗","p":["自道風流不可攀，却堪蹙額更頹顏。","眼睛深却湘江水，鼻孔高於華岳山。","舞態固難居掌上，歌聲應不繞梁間。","孟陽死後欲千載，猶在佳人覓往還。"]},{"i":"b733e47f-c47c-4da6-8afd-9342f9e31dbe","t":"戲荅朝士","a":"李都","d":"唐","g":"短诗","p":["華緘千里到荆門，章草縱橫任意論。","應笑鍾張虛用力，却教羲獻枉勞魂。","惟堪愛惜爲珍寶，不敢傳留誤子孫。","深荷故人相厚處，天行時氣許教吞。"]},{"i":"e493788d-8432-439b-a35a-4b1392f22705","t":"嘲僧惟恭","a":"荆人","d":"唐","g":"短诗","p":["靈巋作盡業，惟恭繼其跡。","地獄千萬重，莫厭排頭人。"]},{"i":"4931459e-cd0f-4872-9671-9799b727a5f8","t":"題酒戶修孔廟狀","a":"馮道幕客","d":"唐","g":"短诗","p":["槐影參差覆杏壇，儒門子弟盡高官。","却教酒戶重脩廟，覓我慚惶也不難。"]},{"i":"6d0db88a-fd4f-49a5-a60c-21f2b5e5bf8c","t":"孔廟口號","a":"李花開","d":"唐","g":"短诗","p":["破落三間屋，蕭條一旅人。","不知負何事，生死厄於陳。"]},{"i":"dc9172de-0a15-4dcb-a159-3fe305e03ac4","t":"荅妻","a":"馮暉","d":"唐","g":"短诗","p":["休說辦不辦，且看甕裏飛出雁。"]},{"i":"089e7241-65c2-4373-a46c-db84eae3522a","t":"題僧院","a":"李濤","d":"唐","g":"短诗","p":["走却坐禪客，移將不動尊。","世間顛倒事，八萬四千門。"]},{"i":"34361a12-5cfc-4216-a840-9752b7c86cf5","t":"詠垂絲蜘蛛嘲雲辨僧","a":"楊苧蘿","d":"唐","g":"短诗","p":["喫得肚嬰撐，尋思繞寺行。","空中設羅網，只待殺衆生。"]},{"i":"8df4bc80-add4-4728-9894-4ad7967db275","t":"自嘲絕句","a":"馮涓","d":"唐","g":"短诗","p":["取水郎中何日了，破柴員外幾時休。","早知蜀地區娵與，悔不長安大比丘。"]},{"i":"125c90a9-26a6-4140-92c5-dbae978a9e3e","t":"哭亡將詩","a":"盧延讓","d":"唐","g":"短诗","p":["自是碙砂發，非干駭石傷。","牒高身上職，盌大背邊創。"]},{"i":"7131b467-0f3a-4149-8878-51a0d45a7c9e","t":"詠王給事","a":"蔣貽恭","d":"唐","g":"短诗","p":["厥父元非道郡奴，允光何事太侏儒。","可中與箇皮裩著，擎得天王左脚無。"]},{"i":"72590b4c-9725-4a02-938f-bce002fdf927","t":"詠金剛","a":"蔣貽恭","d":"唐","g":"短诗","p":["揚眉斗目惡精神，揑合將來恰似真。","剛被時流借拳勢，不知身自是泥人。"]},{"i":"ee5d197f-7d47-4106-adfa-dac889ff17bd","t":"詠傴背子","a":"蔣貽恭","d":"唐","g":"短诗","p":["出得門來背拄天，同行難可與差肩。","若教倚向閑牕下，恰似箜篌不著弦。"]},{"i":"bd214135-8f3b-41cc-b6e7-0719b06f08c4","t":"詠安仁宰擣蒜","a":"蔣貽恭","d":"唐","g":"短诗","p":["安仁縣令好誅求，百姓脂膏滿面流。","半破磁缸成醋酒，死牛腸肚作饅頭。","帳生歲取餐三頓，鄉老盤庚犯五甌。","半醉半醒齊出縣，共傷塗炭不勝愁。"]},{"i":"5189b2f2-83b8-4a5b-9072-faabe6299e5e","t":"五門街望有題","a":"蔣貽恭","d":"唐","g":"短诗","p":["我皇開國十餘年，一輩超升炙手歡。","閑向五門樓下望，衙官騎馬使衙官。"]},{"i":"577d8eeb-67f3-4d87-a286-f05e834d422f","t":"謝郎中惠茶","a":"蔣貽恭","d":"唐","g":"短诗","p":["三斤綠茗賜貽恭，一種頒霑事不同。","想料腸懷無荅處，披毛戴角謝郎中。"]},{"i":"36182c17-4621-4e37-89f7-0069f4652544","t":"詠蝦蟆","a":"蔣貽恭","d":"唐","g":"短诗","p":["坐臥兼行總一般，向人努眼太無端。","欲知自己形骸小，試就蹄涔照影看。"]},{"i":"fd12eafe-2579-4bb8-9c0a-b56ae2647b05","t":"住名山日陳情上府主高太保","a":"蔣貽恭","d":"唐","g":"短诗","p":["名山主簿實堪愁，難齩他家大骨頭。","米納功南錢納府，祗看江面水東流。"]},{"i":"16f2749a-aa1a-4bce-9d10-7761dcf75968","t":"詠刺蝟","a":"李貞白","d":"唐","g":"短诗","p":["行似針氈動，臥若栗毬圓。","莫欺如此大，誰敢便行拳。"]},{"i":"c50bc10a-e1df-411c-bd3c-7ecfb4540872","t":"謁貴公子不禮書格子屏風","a":"李貞白","d":"唐","g":"短诗","p":["道格何曾格，言糊又不糊。","渾身總是眼，還解識人無。"]},{"i":"18449f67-6788-4bd8-85d0-dae0c7561a29","t":"詠月","a":"李貞白","d":"唐","g":"短诗","p":["當塗當塗見，蕪湖蕪湖見。","八月十五夜，一似沒柄扇。"]},{"i":"af3700b6-9f75-4e84-b480-785d3e5c6f87","t":"詠狗蚤","a":"李貞白","d":"唐","g":"短诗","p":["與蝨都來不較多，㩧挑筋斗太嘍囉。","忽然管著一籃子，有甚心情那你何。"]},{"i":"0a5003e6-f76d-440c-aa1e-8d335aec8d95","t":"詠罌粟子","a":"李貞白","d":"唐","g":"短诗","p":["倒排雙陸子，希插碧牙籌。","既似犧牛乳，又如鈴馬兜。","鼓捶幷瀑箭，直是有來由。"]},{"i":"8b9ae6fe-2dbd-455c-8150-759a27bdcf9f","t":"詠蟹","a":"李貞白","d":"唐","g":"短诗","p":["蟬眼龜形脚似蛛，未曾正面向人趨。","如今飣在盤筵上，得似江湖亂走無。"]},{"i":"c326c254-572a-4d33-9d77-d2b329daf9e1","t":"示女詩","a":"郫城令","d":"唐","g":"短诗","p":["深宮富貴事風流，莫忘生身老骨頭。","因與太師歡笑處，爲吾方便覓彭州。"]},{"i":"c29eac77-3cf7-40ae-85c5-0e6d9edad36a","t":"寄女","a":"李令","d":"唐","g":"短诗","p":["有人教我向衡陽，一度思歸欲斷腸。","爲報豔妻兼少女，與吾覓取朗州場。"]},{"i":"30aacfb4-d236-4548-ab67-305f2aaeae4f","t":"諷劉炎索賄詩","a":"太守","d":"唐","g":"短诗","p":["未到桃源時，長憶出家景。","及到桃源了，還似鑑中影。"]},{"i":"69e3d4bc-111a-4284-b8c2-c7666d11389c","t":"被按自悔詩","a":"劉炎","d":"唐","g":"短诗","p":["早知太守如虎狼，獵取膏粱以啗之。"]},{"i":"43290b84-f17e-4356-84f7-2254f8e85726","t":"與王仙客互嘲","a":"甘洽","d":"唐","g":"短诗","p":["王，計爾應姓田，爲你面撥獺，抽却你兩邊。","甘，計爾應姓丹，爲你頭不曲，迴脚向上安。"]},{"i":"823bbd1f-3959-4d09-942d-b1388e63db12","t":"題濠州高塘館","a":"閻敬愛","d":"唐","g":"短诗","p":["借問襄王安在哉，山川此地勝陽臺。","今宵寓宿高塘館，神女何曾入夢來。"]},{"i":"47bc39ef-a668-4da5-96ae-75a12818ee72","t":"題敬愛詩後","a":"李和風","d":"唐","g":"短诗","p":["高唐不是這高塘，淮畔荆南各異方。","若向此中求薦枕，參差笑殺楚襄王。"]},{"i":"bf1812cc-7a2e-4c20-b422-8557a8edbe71","t":"荅日休皮字詩","a":"歸氏子","d":"唐","g":"短诗","p":["八片尖裁浪作毬，火中燖了水中揉。","一包閑氣如長在，惹踢招拳卒未休。"]},{"i":"a7afd439-4a06-49df-974a-b465ee29d54b","t":"謔池亳二州賓佐兼寄宣武軍掌書記李晝","a":"張魯封","d":"唐","g":"短诗","p":["杜叟學仙輕蕙質，韋公事佛畏青娥。","樂營却是閑人管，兩地風情日漸多。"]},{"i":"286ec312-7763-46d6-9b4f-b2ada214e81e","t":"戲酬張魯封","a":"李晝","d":"唐","g":"短诗","p":["秋浦亞卿顏叔子，譙都中憲老桑門。","如今柳巷通車馬，唯恐他時立棘垣。"]},{"i":"77e54dea-ab66-4324-a38e-7b70da2b361c","t":"即事","a":"楊鸞","d":"唐","g":"短诗","p":["白日蒼蠅滿飰盤，夜間蚊子又成團。","每到更深人靜後，定來頭上齩楊鸞。"]},{"i":"5ba37bb9-75d4-40ef-a9ea-08942f3fd528","t":"嘲周顓","a":"座客","d":"唐","g":"短诗","p":["龍津掉尾十年勞，聲價當時鬬月高。","惟有紅妝回舞手，似持霜刀向猨猱。"]},{"i":"2ac6db52-ec7e-4d0b-b41e-5eb95251b145","t":"和座客","a":"周顓","d":"唐","g":"短诗","p":["十載文場敢憚勞，宋都回鶂爲風高。","今朝甘被花枝笑，任道尊前愛縛猱。"]},{"i":"2be3c28a-eacf-4ec8-b395-e20d5413fc20","t":"荅或人","a":"張鷟","d":"唐","g":"短诗","p":["寧可且將朱脣飲酒，誰能遂你黑齒常之。"]},{"i":"831e4a20-b9e3-420c-a1b4-a4cfafc6c480","t":"嘲崔嘏","a":"施肩吾","d":"唐","g":"短诗","p":["二十九人及第，五十七眼看花。"]},{"i":"4d11956c-8fe0-49c2-81a0-6b3c8a635654","t":"嶺南詩句","a":"蘇芸","d":"唐","g":"短诗","p":["郭裏多榕樹，街中足使君。"]},{"i":"a99520c1-cdec-4bb3-a39a-2607aa674352","t":"諧詩逸句 一","a":"包賀","d":"唐","g":"短诗","p":["霧是山巾子，船爲水靸鞋。"]},{"i":"c47738d5-7ee8-4d60-b9e7-bc424d614413","t":"諧詩逸句 二","a":"包賀","d":"唐","g":"短诗","p":["櫂搖船掠鬢，風動水槌胸。"]},{"i":"61faab0f-53ae-494e-a8f8-d5ab4dffcdcc","t":"諧詩逸句 三","a":"包賀","d":"唐","g":"短诗","p":["苦竹筍抽青橛子，石榴樹挂小缾兒。"]},{"i":"7569c3e1-a5f7-4d24-b9a0-a7dcf576550d","t":"題洞庭湖","a":"蔡押衙","d":"唐","g":"短诗","p":["可憐洞庭湖，恰到三冬無髭鬚。"]},{"i":"3751fd48-8fcf-41f8-acb1-00102ba8f7cb","t":"戲令狐相","a":"溫庭筠","d":"唐","g":"短诗","p":["自從元老登庸後，天下諸胡悉帶鈴。"]},{"i":"2d960ff7-d968-49b8-9ae1-6d88cad8c2a7","t":"與羅隱互謔","a":"顧雲","d":"唐","g":"短诗","p":["青蠅被扇扇離席，白澤遭釘釘在門。"]},{"i":"bcca43c9-e103-40fa-9fcc-9f0e2d13e41d","t":"引自落便宜句","a":"孫光憲","d":"唐","g":"短诗","p":["窗下有時留客宿，室中無事伴僧眠。"]},{"i":"50878319-f8f5-4c2c-85f2-e8cc2c3c6130","t":"嘲廩丘令丞","a":"商則","d":"唐","g":"短诗","p":["令丞俱動手，縣尉止回身。"]},{"i":"dc3c57cf-70ee-429d-b484-09b7be883956","t":"題漢祖廟","a":"羅穎","d":"唐","g":"短诗","p":["項羽英雄猶不懼，可憐容得辟陽侯。"]},{"i":"15e02ba3-6405-45b6-b21c-487aa7f76b95","t":"自賦催妝詩","a":"陳嶠","d":"唐","g":"短诗","p":["彭祖尚聞年八百，陳郎猶是小孩兒。"]},{"i":"befce723-3d11-46c0-8b90-7d5961daa036","t":"戲爲舉子對句","a":"何承裕","d":"唐","g":"短诗","p":["曉來犬吠張三婦，日暮猨啼呂四妻。"]},{"i":"585a0777-81ac-4794-80cc-207d3b019798","t":"荅弟婦歇後語","a":"李濤","d":"唐","g":"短诗","p":["慙無竇建，媿作梁山。"]},{"i":"8c977d92-3f1a-431e-9603-ea489f62180c","t":"與釋惠江互謔","a":"程紫霄","d":"唐","g":"短诗","p":["僧錄琵琶腿，先生觱栗頭。"]},{"i":"16bd2098-92df-4539-b8e5-11211aa92e52","t":"與李榮互謔","a":"僧法軌","d":"唐","g":"短诗","p":["姓李應須禮，言榮又不榮。","身長三尺半，頭毛猶未生。"]},{"i":"22adc2c6-e8aa-4420-a06a-1993d0548321","t":"廣州三樵歌","a":"無名氏","d":"唐","g":"短诗","p":["奉敕追三樵，隨侯傍道走。","迴頭語李郎，喚取爾朱九。"]},{"i":"6ba83755-b142-49a0-be57-af5a7eb4069a","t":"三御史詠","a":"無名氏","d":"唐","g":"短诗","p":["韋子凝而密，任生直且狂。","可憐元福慶，也學坐凝牀。"]},{"i":"9eaaaddd-b62a-4b8a-b2ce-0d5953ce40ef","t":"臺中裏行詠","a":"無名氏","d":"唐","g":"短诗","p":["柱下雖爲史，臺中未是官。","何時聞必也，早晚見任端。"]},{"i":"5cf7451f-2238-47aa-99fb-bd0346b14ba4","t":"譏裴休","a":"無名氏","d":"唐","g":"短诗","p":["趙氏兒皆尼氏女，師翁兒即晉公兒。","却教術士難推算，胎月分張與阿誰。"]},{"i":"8fc6c63b-cef7-4ba0-b807-dbeea581b001","t":"嘲四相","a":"無名氏","d":"唐","g":"短诗","p":["確確無餘事，錢財總被收。","商人都不管，貨賂幾時休。"]},{"i":"35949e15-34ad-42e0-9094-3064ddb967ed","t":"放牓詩","a":"無名氏","d":"唐","g":"短诗","p":["乞兒還有大通年，三十三人椀杖全。","薛庶準前騎瘦馬，范酇依舊蓋番氈。"]},{"i":"72599425-eb86-487b-8af3-2aa2bd25a619","t":"改魏扶詩","a":"無名氏","d":"唐","g":"短诗","p":["葉落滿庭陰，朱門試院深。","昔年辛苦地，今日負前心。"]},{"i":"097519cd-13cc-40af-871a-56c7eac18ada","t":"嘲舉子騎驢","a":"無名氏","d":"唐","g":"短诗","p":["今年敕下盡騎驢，短軸長鞦滿九衢。","清瘦兒郎猶自可，就中愁殺鄭昌圖。"]},{"i":"7b2210b9-6b29-4945-a4fd-8004e3167cfe","t":"嘲崔垂休","a":"無名氏","d":"唐","g":"短诗","p":["慈恩塔下親泥壁，滑膩光華玉不如。","何事博陵崔四十，金陵腿上逞歐書。"]},{"i":"71868aee-f230-42e6-b8cc-f7257057a891","t":"嘲主司崔澹","a":"無名氏","d":"唐","g":"短诗","p":["主司何事厭吾王，解把黃巢比武王。"]},{"i":"298d51e6-e6df-4120-bd6e-34ef0bfa5942","t":"朝士戲任轂","a":"無名氏","d":"唐","g":"短诗","p":["雲林應訝鶴書遲，自入京來探事宜。","從此見山須合眼，被山相賺已多時。"]},{"i":"04e9eaba-1ab2-4b54-9e67-659766f7037b","t":"題房魯題名後","a":"無名氏","d":"唐","g":"短诗","p":["姚家新壻是房郎，未解芳顏意欲狂。","見說正調穿羽箭，莫教射破寺家牆。"]},{"i":"bf212c0c-1dfd-417c-b8b7-b994ae33632e","t":"洛陽人嘲跋異","a":"無名氏","d":"唐","g":"短诗","p":["赫赫洛下，唯說異畫。","張氏出頭，跋異無價。"]}]