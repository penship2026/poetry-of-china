[{"i":"c-0f4d58fe98a3","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["公子眼花乱发，老夫鼻观先通。","领巾飘下瑞香风。","惊起谪仙春梦。","后土祠中玉蕊，蓬莱殿后鞓红。","此花清绝更纤秾。","把酒何人心动。"],"s":"simp","f":"trad"},{"i":"c-0801d1dfefcf","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["小院朱阑几曲，重城画鼓三通。","更看微月转光风。","归去香云入梦。","翠袖争浮大白，皂罗半插斜红。","灯花零落酒花秾。","妙语一时飞动。"],"s":"simp","f":"trad"},{"i":"c-a330fce6087d","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["怪此花枝怨泣，托君诗句名通。","凭将草木记吴风。","继取相如云梦。","点笔袖沾醉墨，谤花面有惭红。","知君却是为情秾。","怕见此花撩动。"],"s":"simp","f":"trad"},{"i":"c-de8f4ed63d68","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["闻道双衔凤带，不妨单著鲛绡。","夜香知与阿谁烧。","怅望水沈烟袅。","云鬓风前绿卷，玉颜醉里红潮。","莫教空度可怜宵。","月与佳人共僚。"],"s":"simp","f":"trad"},{"i":"c-ca5cefd6f551","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["点点楼头细雨。","重重江外平湖。","当年戏马会东徐。","今日凄凉南浦。","莫恨黄花未吐。","且教红粉相扶。","酒阑不必看茱萸。","俯仰人间今古。"],"s":"simp","f":"trad"},{"i":"c-c0a33f70cbf5","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["龙焙今年绝品，谷帘自古珍泉。","雪芽双井散神仙。","苗裔来从北苑。","汤发云腴酽白，盏浮花乳轻圆。","人间谁敢更争妍。","斗取红窗粉面。"],"s":"simp","f":"trad"},{"i":"c-07f3abc702cc","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["别梦已随流水，泪巾犹裛香泉。","相如依旧是臞仙。","人在瑶台阆苑。","花雾萦风缥缈，歌珠滴水清圆。","蛾眉新作十分妍。","走马归来便面。"],"s":"simp","f":"trad"},{"i":"c-37dd5212d751","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["世事一场大梦，人生几度秋凉。","夜来风叶已鸣廊。","看取眉头鬓上。","酒贱常愁客少，月明多被云妨。","中秋谁与共孤光。","把盏凄然北望。"],"s":"simp","f":"trad"},{"i":"c-ef5da578d054","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["莫叹平原落落，且应去鲁迟迟。","与君各记少年时。","须信人生如寄。","白发千茎相送，深杯百罚休辞。","拍浮何用酒为池。","我已为君德醉。"],"s":"simp","f":"trad"},{"i":"c-68749d5f9ad6","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["玉骨那愁瘴雾，冰姿自有仙风。","海仙时遣探芳丛。","倒挂绿毛么凤。","素面翻嫌粉涴，洗妆不褪唇红。","高情已逐晓云空。","不与梨花同梦。"],"s":"simp","f":"trad"},{"i":"c-6b67e1be9cf8","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["照野弥弥浅浪，横空暧暧微霄。","障泥未解玉骢骄。","我欲醉眠芳草。","可惜一溪明月，莫教踏破琼瑶。","解鞍敧枕绿杨桥。","杜宇一声春晓。"],"s":"simp","f":"trad"},{"i":"c-3807a6bcc6cc","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["三过平山堂下，半生弹指声中。","十年不见老仙翁。","壁上龙蛇飞动。","欲吊文章太守，仍歌杨柳春风。","休言万事转头空。","未转头时皆梦。"],"s":"simp","f":"trad"},{"i":"c-36da9318913c","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["昨夜扁舟京口，今朝马首长安。","旧官何物与新官。","只有湖山公案。","此景百年几变，个中下语千难。","使君才气卷波澜。","与把新诗判断。"],"s":"simp","f":"trad"},{"i":"c-c19caddf5856","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["细马远驮双侍女，青巾玉带红靴。","溪山好处便为家。","谁知巴峡路，却见洛城花。","面旋落英飞玉蕊，人间春日初斜。","十年不见紫云车。","龙丘新洞府，铅鼎养丹砂。"],"s":"simp","f":"trad"},{"i":"c-86b1a4d848b6","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["诗句端来磨我钝，钝锥不解生鋩。","欢颜为我解冰霜。","酒阑清梦觉，春草满池塘。","应念雪堂坡下老，昔年共采芸香。","功成名遂早还乡。","回车来过我，乔木拥千章。"],"s":"mixed","f":"trad"},{"i":"c-ad32c5affc0e","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["我劝髯张归去好，从来自己忘情。","尘心消尽道心平。","江南与塞北，何处不堪行。","俎豆庚桑真过矣，凭君说与南荣。","愿闻吴越报丰登。","君王如有问，结袜赖王生。"],"s":"simp","f":"trad"},{"i":"c-c4941cde8b37","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["自古相从休务日，何妨低唱微吟。","天垂云重作春阴。","坐中人半醉，帘外雪将深。","闻道分司狂御史，紫云无路追寻。","凄风寒雨是骎骎。","问囚长损气，见鹤忽惊心。"],"s":"simp","f":"trad"},{"i":"c-4dd91ebf38cf","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["忘却成都来十载，因君未免思量。","凭将清泪洒江阳。","故山知好在，孤客自悲凉。","坐上别愁君未见，归来欲断无肠。","殷勤且更尽离觞。","此身如传舍，何处是吾乡。"],"s":"simp","f":"trad"},{"i":"c-00ebea00ea19","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["尊酒何人怀李白，草堂遥指江东。","珠帘十里卷香风。","花开又花谢，离恨几千重。","轻舸渡江连夜到，一时惊笑衰容。","语音犹自带吴侬。","夜阑对酒处，依旧梦魂中。"],"s":"simp","f":"trad"},{"i":"c-5a0eb87cfcad","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["九十日春都过了，贪忙何处追游。","三分春色一分愁。","雨翻榆荚阵，风转柳花球。","阆苑先生须自责，蟠桃动是千秋。","不知人世苦厌求。","东皇不拘束，肯为使君留。"],"s":"simp","f":"trad"},{"i":"c-54697f7d1cd5","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["四大从来都遍满，此间风水何疑。","故应为我发新诗。","幽花香涧谷，寒藻舞沦漪。","借与玉川生两腋，天仙未必相思。","还凭流水送人归。","层巅馀落日，草露已沾衣。"],"s":"simp","f":"trad"},{"i":"c-84d40cd2f8f6","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["一别都门三改火，天涯踏尽红尘。","依然一笑作春温。","无波真古井，有节是秋筠。","惆怅孤帆连夜发，送行淡月微云。","尊前不用翠眉颦。","人生如逆旅，我亦是行人。"],"s":"simp","f":"trad"},{"i":"c-98af2cde02ae","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["多病休文都瘦损，不堪金带垂腰。","望湖楼上暗香飘。","和风春弄袖，明月夜闻箫。","酒醒梦回清漏永，隐床无限更潮。","佳人不见董娇饶。","徘徊花上月，空度可怜宵。"],"s":"simp","f":"trad"},{"i":"c-7d981744a5fc","t":"临江仙","a":"苏轼","d":"宋","g":"词","p":["冬夜夜寒冰合井，画堂明月侵帏。","青缸明灭照悲啼。","青缸挑欲尽，粉泪裛还垂。","未尽一尊先掩泪，歌声半带清悲。","情声两尽莫相违。","欲知肠断处，梁上暗尘飞。"],"s":"simp","f":"trad"},{"i":"c-a928f6022b88","t":"渔家傲","a":"苏轼","d":"宋","g":"词","p":["千古龙蟠并虎踞。","从公一吊兴亡处。","渺渺斜风吹细雨。","芳草渡。","江南父老留公住。","公驾飞车凌彩雾。","红鸾骖乘青鸾驭。","却讶此洲名白鹭。","非吾侣。","翩然欲下还飞去。"],"s":"simp","f":"trad"},{"i":"c-1e64c7fdac77","t":"渔家傲","a":"苏轼","d":"宋","g":"词","p":["送客归来灯火尽。","西楼淡月凉生晕。","明日潮来无定准。","潮来稳。","舟横渡口重城近。","江水似知孤客恨。","南风为解佳人愠。","莫学时流轻久困。","频寄问。","钱塘江上须忠信。"],"s":"simp","f":"trad"},{"i":"c-d047e295a311","t":"渔家傲","a":"苏轼","d":"宋","g":"词","p":["皎皎牵牛河汉女。","盈盈临水无由语。","望断碧云空日暮。","无寻处。","梦回芳草生春浦。","鸟散馀花纷似雨。","汀洲苹老香风度。","明月多情来照户。","但揽取。","清光长送人归去。"],"s":"simp","f":"trad"},{"i":"c-0c137eb1f752","t":"渔家傲","a":"苏轼","d":"宋","g":"词","p":["一曲《阳关》情几许。","知君欲向秦川去。","白马皂貂留不住。","回首处。","孤城不见天霖雾。","到日长安花似雨。","故关杨柳初飞絮。","渐见靴刀迎夹路。","谁得似。","风流膝上王文度。"],"s":"simp","f":"trad"},{"i":"c-86cb73903be0","t":"鹧鸪天","a":"苏轼","d":"宋","g":"词","p":["林断山明竹隐墙。","乱蝉衰草小池塘。","翻空白鸟时时见，照水红蕖细细香。","村舍外，古城旁。","杖藜徐步转斜阳。","殷勤昨夜三更雨，又得浮生一日凉。"],"s":"simp","f":"trad"},{"i":"c-df546db00274","t":"鹧鸪天","a":"苏轼","d":"宋","g":"词","p":["笑拈红梅亸翠翘。","扬州十里最妖饶。","夜来绮席亲曾见，撮得精神滴滴娇。","娇后眼，舞时腰。","刘郎几度欲魂消。","明朝酒醒知何处，肠断云间《紫玉箫》。"],"s":"simp","f":"trad"},{"i":"c-ad093449a820","t":"少年游","a":"苏轼","d":"宋","g":"词","p":["银塘朱槛曲尘波。","圆绿卷新荷。","兰条荐浴，菖花酿酒，天气尚清和。","好将沈醉酬佳节，十分酒、一分歌。","狱草烟深，讼庭人悄，无吝宴游过。"],"s":"mixed","f":"trad"},{"i":"c-68368efa9cd3","t":"少年游","a":"苏轼","d":"宋","g":"词","p":["去年相送，馀杭门外，飞雪似杨花。","今年春尽，杨花似雪，犹不见还家。","对酒卷帘邀明月，风露透窗纱。","恰似姮娥怜双燕，分明照、画梁斜。"],"s":"simp","f":"trad"},{"i":"c-02344e11640e","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["两两轻红半晕腮。","依依独为使君回。","若道使君无此意。","何为。","双花不向别人开。","但看低昂烟雨里。","不已。","劝君休诉十分杯。","更问尊前狂副使。","来岁。","花开时节与谁来。"],"s":"simp","f":"trad"},{"i":"c-daa5367380b0","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["莫听穿林打叶声。","何妨吟啸且徐行。","竹杖芒鞋轻胜马。","谁怕。","一蓑烟雨任平生。","料峭春风吹酒醒。","微冷。","山头斜照却相迎。","回首向来潇洒处。","归去。","也无风雨也无晴。"],"s":"simp","f":"trad"},{"i":"c-c4daa1cd2dce","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["与客携壶上翠微。","江涵秋影雁初飞。","尘世难逢开口笑。","年少。","菊花须插满头归。","酩酊但酬佳节了。","云峤。","登临不用怨斜晖。","古往今来谁不老。","多少。","牛山何必更沾衣。"],"s":"simp","f":"trad"},{"i":"c-6132efbed162","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["莫怪鸳鸯绣带长。","腰轻不胜舞衣裳。","薄幸只贪游冶去。","何处。","垂杨系马恣轻狂。","花谢絮飞春又尽。","堪恨。","断弦尘管伴啼妆。","不信归来但自看。","怕见。","为郎憔悴却羞郎。"],"s":"simp","f":"trad"},{"i":"c-d677fac750c9","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["千古风流阮步兵。","平生游宦爱东平。","千里远来还不住。","归去。","空留风韵照人清。","红粉尊前深懊恼。","休道。","怎生留得许多情。","记得明年花絮乱。","须看。","泛西湖是断肠声。"],"s":"simp","f":"trad"},{"i":"c-08ef1933dca4","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["雨洗娟娟嫩叶光。","风吹细细绿筠香。","秀色乱侵书帙晚。","帘卷。","清阴微过酒尊凉。","人画竹身肥拥肿。","何用。","先生落笔胜萧郎。","记得小轩岑寂夜。","廊下。","月和疏影上东墙。"],"s":"simp","f":"trad"},{"i":"c-c03fc9367ca7","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["好睡慵开莫厌迟。","自怜冰脸不时宜。","偶作小红桃杏色，闲雅，尚馀孤瘦雪霜姿。","休把闲心随物态，何事，酒生微晕沁瑶肌。","诗老不知梅格在，吟咏，更看绿叶与青枝。"],"s":"simp","f":"trad"},{"i":"c-15212aaf6330","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["月满苕溪照夜堂。","五星一老斗光芒。","十五年间真梦里。","何事。","长庚对月独凄凉。","绿鬓苍颜同一醉。","还是。","六人吟笑水云乡。","宾主谈锋谁得似。","看取。","曹刘今对两苏张。"],"s":"simp","f":"trad"},{"i":"c-e7eb24e3d89b","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["常羡人间琢玉郎。","天应乞与点酥娘。","尽道清歌传皓齿。","风起。","雪飞炎海变清凉。","万里归来颜愈少。","微笑。","笑时犹带岭梅香。","试问岭南应不好。","却道。","此心安处是吾乡。"],"s":"simp","f":"trad"},{"i":"c-29affcd768b8","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["晚景落琼杯。","照眼云山翠作堆。","认得岷峨春雪浪，初来。","万顷蒲萄涨渌醅。","暮雨暗阳台。","乱洒高楼湿粉腮。","一阵东风来卷地，吹回。","落照江天一半开。"],"s":"simp","f":"trad"},{"i":"c-1849d44d7575","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["寒雀满疏篱。","争抱寒柯看玉蕤。","忽见客来花下坐，惊飞。","蹋散芳英落酒卮。","痛饮又能诗。","坐客无毡醉不知。","花尽酒阑春到也，离离。","一点微酸已著枝。"],"s":"simp","f":"trad"},{"i":"c-14427e6b1d59","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["不到谢公台。","明月清风好在哉。","旧日髯孙何处去，重来。","短李风流更上才。","秋色渐摧颓。","满院黄英映酒杯。","看取桃花春二月，争开。","尽是刘郎去后栽。"],"s":"simp","f":"trad"},{"i":"c-083ef360c014","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["霜降水痕收。","浅碧鳞鳞露远洲。","酒力渐消风力软，飕飕。","破帽多情却恋头。","佳节若为酬。","但把清尊断送秋。","万事到头都是梦，休休。","明日黄花蝶也愁。"],"s":"simp","f":"trad"},{"i":"c-4af79a74dabd","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["回首乱山横。","不见居人只见城。","谁似临平山上塔，亭亭。","迎客西来送客行。","归路晚风清。","一枕初寒梦不成。","今夜残灯斜照处，荧荧。","秋雨晴时泪不晴。"],"s":"simp","f":"trad"},{"i":"c-1ff26638aa8e","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["冰雪透香肌。","姑射仙人不似伊。","濯锦江头新样锦，非宜。","故著寻常淡薄衣。","暖日下重帏。","春睡香凝索起迟。","曼倩风流缘底事，当时。","爱被西真唤作儿。"],"s":"simp","f":"trad"},{"i":"c-b9c6de924332","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["东武望馀杭。","云海天涯两杳茫。","何日功成名遂了，还乡。","醉笑陪公三万场。","不用诉离觞。","痛饮从来别有肠。","今夜送归灯火冷，河塘。","堕泪羊公却姓杨。"],"s":"simp","f":"trad"},{"i":"c-bc06a2c8c043","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["凉簟碧纱厨。","一枕清风昼睡馀。","睡听晚衙无一事，徐徐。","读尽床头几卷书。","搔首赋归欤。","自觉功名懒更疏。","若问使君才与术，何如。","占得人间一味愚。"],"s":"simp","f":"trad"},{"i":"c-b45d714c82de","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["裙带石榴红。","却水殷勤解赠侬。","应许逐鸡鸡莫怕，相逢。","一点灵犀必暗通。","何处遇良工。","琢刻天真半欲空。","愿作龙香双凤拨，轻拢。","长在环儿白雪胸。"],"s":"simp","f":"trad"},{"i":"c-5a45a1ce46d2","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["旌旆满江湖。","诏发楼船万舳舻。","投笔将军因笑我，迂儒。","帕首腰刀是丈夫。","粉泪怨离居。","喜子垂窗报捷书。","试问伏波三万语，何如。","一斛明珠换绿珠。"],"s":"simp","f":"trad"},{"i":"c-7fe96781d259","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["天与化工知。","赐得衣裳总是绯。","每向华堂深处见，怜伊。","两个心肠一片儿。","自小便相随。","绮席歌筵不暂离。","苦恨人人分拆破，东西。","怎得成双似旧时。"],"s":"simp","f":"trad"},{"i":"c-1b3bffdc238c","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["寒玉细凝肤。","清歌一曲《倒金壶》。","冶叶倡条遍相识，争如。","豆蔻花梢二月初。","年少即须臾。","芳时偷得醉工夫。","罗帐细垂银烛背，欢娱。","豁得平生俊气无。"],"s":"simp","f":"trad"},{"i":"c-46ad669e4522","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["怅望送春杯。","渐老逢春能几回。","花满楚城愁远别，伤怀。","何况清丝急管催。","吟断望乡台。","万里归心独上来。","景物登临闲始见，徘徊。","一寸相思一寸灰。"],"s":"simp","f":"trad"},{"i":"c-2cf0e7bd177c","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["何处倚阑干。","弦管高楼月正圆。","胡蝶梦中家万里，依然。","老去愁来强自宽。","明镜借红颜。","须著人间比梦间。","蜡烛半笼金翡翠，更阑。","绣被焚香独自眠。"],"s":"simp","f":"trad"},{"i":"c-925c442a565a","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["山与歌眉敛，波同醉眼流。","游人都上十三楼。","不羡竹西歌吹、古扬州。","菰黍连昌歜，琼彝倒玉舟。","谁家《水调》唱歌头。","声绕碧山飞去、晚云留。"],"s":"simp","f":"trad"},{"i":"c-dec4d8ed4f7d","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["古岸开青葑，新渠走碧流。","会看光满万家楼。","记取他年扶路、入西州。","佳节连梅雨，馀生寄叶舟。","只将菱角与鸡头。","更有月明千顷、一时留。"],"s":"simp","f":"trad"},{"i":"c-2542936aeb40","t":"南乡子","a":"苏轼","d":"宋","g":"词","p":["雨暗初疑夜，风回忽报晴。","淡云斜照著山明。","细草软沙溪路、马蹄轻。","卯酒醒还困，仙材梦不成。","蓝桥何处觅云英。","只有多情流水、伴人行。"],"s":"simp","f":"trad"},{"i":"c-45eb6dedb3af","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["日出西山雨，无晴又有晴。","乱山深处过清明。","不见彩绳花板、细腰轻。","尽日行桑野，无人与目成。","且将新句琢琼英。","我是世间闲客、此闲行。"],"s":"simp","f":"trad"},{"i":"c-3028911f5c05","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["带酒冲山雨，和衣睡晚晴。","不知钟鼓报天明。","梦里栩然蝴蝶、一身轻。","老去才都尽，归来计未成。","求田问舍笑豪英。","自爱湖边沙路、免泥行。"],"s":"simp","f":"trad"},{"i":"c-ff0d4036865f","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["日薄花房绽，风和麦浪轻。","夜来微雨洗郊坰。","正是一年春好、近清明。","已改煎茶火，犹调入粥饧。","使君高会有馀清。","此乐无声无味、最难名。"],"s":"simp","f":"trad"},{"i":"c-44309c37404d","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["海上乘槎侣，仙人萼绿华。","飞升元不用丹砂。","住在潮头来处、渺天涯。","雷辊夫差国，云翻海若家。","坐中安得弄琴牙。","写取馀声归向、水仙夸。"],"s":"simp","f":"trad"},{"i":"c-926ea3435b0b","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["苒苒中秋过，萧萧两鬓华。","寓身化世一尘沙。","笑看潮来潮去、了生涯。","方士三山路，渔人一叶家。","早知身世两聱牙。","好伴骑鲸公子、赋雄夸。"],"s":"simp","f":"trad"},{"i":"c-a63c7100f73b","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["师唱谁家曲，宗风嗣阿谁。","借君拍板与门槌。","我也逢场作戏、莫相疑。","溪女方偷眼，山僧莫眨眉。","却愁弥勒下生迟。","不见老婆三五、少年时。"],"s":"simp","f":"trad"},{"i":"c-b2c461d3e39a","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["欲执河梁手，还升月旦堂。","酒阑人散月侵廊。","北客明朝归去、雁南翔。","窈窕高明玉，风流郑季庄。","一时分散水云乡。","惟有落花芳草、断人肠。"],"s":"simp","f":"trad"},{"i":"c-1fdddaf4e8e0","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["山雨潇潇过，溪桥浏浏清。","小园幽榭枕苹汀。","门外月华如水、彩舟横。","苕岸霜花尽，江湖雪阵平。","两山遥指海门青。","回首水云何处、觅孤城。"],"s":"simp","f":"trad"},{"i":"c-fe422abfc6d2","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["紫陌寻春去，红尘拂面来。","无人不道看花回。","惟见石榴新蕊、一枝开。","冰簟堆云髻，金尊滟玉醅。","绿阴青子莫相催。","留取红巾千点、照池台。"],"s":"simp","f":"trad"},{"i":"c-05c3eb6b2ffd","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["卫霍元勋后，韦平外族贤。","吹笙只合在缑山。","闲驾彩峦归去、趁新年。","烘暖烧香阁，轻寒浴佛天。","他时一醉画堂前。","莫忘故人憔悴、老江边。"],"s":"simp","f":"trad"},{"i":"c-e4e0843aaa63","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["笑怕蔷薇罥，行忧宝瑟僵。","美人依约在西厢。","祗恐暗中迷路、认馀香。","午夜风翻幔，三更月到床。","簟纹如水玉肌凉。","何物与侬归去、有残妆。"],"s":"simp","f":"trad"},{"i":"c-3a4246277735","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["寸恨谁云短，绵绵岂易裁。","半年眉绿未曾开。","明月好风闲处、是人猜。","春雨消残冻，温风到冷灰。","尊前一曲为谁哉。","留取曲终一拍、待君来。"],"s":"simp","f":"trad"},{"i":"c-ac7f8788b0dc","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["绀绾双蟠髻，云敧小偃巾。","轻盈红脸小腰身。","叠鼓忽催花拍、斗精神。","空阔轻红歇，风和约柳春。","蓬山才调最清新。","胜似缠头千锦、共藏珍。"],"s":"simp","f":"trad"},{"i":"c-4b16b9d08f32","t":"南歌子","a":"苏轼","d":"宋","g":"词","p":["琥珀装腰佩，龙香入领巾。","只应飞燕是前身。","共看剥葱纤手、舞凝神。","柳絮风前转，梅花雪里春。","鸳鸯翡翠两争新。","但得周郎一顾、胜珠珍。"],"s":"simp","f":"trad"},{"i":"c-0a585d6a1895","t":"好事近","a":"苏轼","d":"宋","g":"词","p":["红粉莫悲啼，俯仰半年离别。","看取雪堂坡下，老农夫凄切。","明年春水漾桃花，柳岸隘舟楫。","从此满城歌吹，看黄州阗咽。"],"s":"simp","f":"trad"},{"i":"c-07072320c2cc","t":"好事近","a":"苏轼","d":"宋","g":"词","p":["湖上雨晴时，秋水半篙初没。","朱槛俯窥寒鉴，照衰颜华发。","醉中吹堕白纶巾，溪风漾流月。","独棹小舟归去，任烟波飘兀。"],"s":"simp","f":"trad"},{"i":"c-27910876aa20","t":"鹊桥仙","a":"苏轼","d":"宋","g":"词","p":["缑山仙子，高情云渺，不学痴牛呆女。","凤箫声断月明中，举手谢、时人欲去。","客槎曾犯，银河微浪，尚带天风海雨。","相逢一醉是前缘，风雨散、飘然何处。"],"s":"simp","f":"trad"},{"i":"c-5dcf5c0aef49","t":"鹊桥仙","a":"苏轼","d":"宋","g":"词","p":["乘槎归去，成都何在，万里江沱汉漾。","与君各赋一篇诗，留织女、鸳鸯机上。","还将旧曲，重赓新韵，须信吾侪天放。","人生何处不儿嬉，看乞巧、朱楼彩舫。"],"s":"simp","f":"trad"},{"i":"c-c542503dd0de","t":"望江南・忆江南","a":"苏轼","d":"宋","g":"词","p":["春已老，春服几时成。","曲水浪低蕉叶稳，舞雩风软纻罗轻。","酣咏乐升平。","微雨过，何处不催耕。","百舌无言桃李尽，柘林深处鹁鸪鸣。","春色属芜菁。"],"s":"simp","f":"trad"},{"i":"c-63c08278f691","t":"望江南・忆江南","a":"苏轼","d":"宋","g":"词","p":["春未老，风细柳斜斜。","试上超然台上看，半壕春水一城花。","烟雨暗千家。","寒食后，酒醒却咨嗟。","休对故人思故国，且将新火试新茶。","诗酒趁年华。"],"s":"simp","f":"trad"},{"i":"c-c97b61e1764f","t":"卜算子","a":"苏轼","d":"宋","g":"词","p":["蜀客到江南，长忆吴山好。","吴蜀风流自古同，归去应须早。","还与去年人，共藉西湖草。","莫惜尊前仔细看，应是容颜老。"],"s":"simp","f":"trad"},{"i":"c-235fd9b973ff","t":"瑞鹧鸪","a":"苏轼","d":"宋","g":"词","p":["碧山影里小红旗。","侬是江南踏浪儿。","拍手欲嘲山简醉，齐声争唱《浪婆词》。","西兴渡口帆初落，渔浦山头日未敧。","侬欲送潮歌底曲，尊前还唱使君诗。"],"s":"simp","f":"trad"},{"i":"c-7d5500813c23","t":"十拍子・破阵子","a":"苏轼","d":"宋","g":"词","p":["白酒新开九酝，黄花已过重阳。","身外傥来都似梦，醉里无何即是乡。","东坡日月长。","玉粉旋烹茶乳，金齑新捣橙香。","强染霜髭扶翠袖，莫道狂夫不解狂。","狂夫老更狂。"],"s":"simp","f":"trad"},{"i":"c-ec43329b156a","t":"清平乐","a":"苏轼","d":"宋","g":"词","p":["清淮蜀汴。","更在江西岸。","红旆到时黄叶乱。","霜入梁王故苑。","秋原何处携壶。","停骖访古踟蹰。","双庙遗风尚在，漆园傲吏应无。"],"s":"simp","f":"trad"},{"i":"c-b433a709e436","t":"昭君怨","a":"苏轼","d":"宋","g":"词","p":["谁作桓伊《三弄》。","惊破绿窗幽梦。","新月与愁烟。","满江天。","欲去又还不去。","明日落花飞絮。","飞絮送行舟。","水东流。"],"s":"simp","f":"trad"},{"i":"c-a56c67734d5b","t":"戚氏","a":"苏轼","d":"宋","g":"词","p":["玉龟山。","东皇灵媲统群仙。","绛阙岧嶢，翠房深迥，倚霏烟。","幽闲。","志萧然。","金城千里锁婵娟。","当时穆满巡狩。","翠华曾到海西边。","风露明霁，鲸波极目，势浮舆盖方圆。","正迢迢丽日。","玄圃清寂，琼草芊绵。","争解绣勒香鞯。","鸾辂驻跸，八马戏芝田。","瑶池近、画楼隐隐，翠鸟翩翩。","肆华筵。","间作脆管鸣弦。","宛若帝所钧天。","稚颜皓齿，绿发方瞳，圆极恬淡高妍。","尽倒琼壶酒，献金鼎药，固大椿年。","缥缈飞琼妙舞，命双成、奏曲醉留连。","云璈韵响泻寒泉。","浩歌畅饮，斜月低河汉。","渐渐绮霞、天际红深浅。","动归思、回首尘寰。","烂漫游、玉辇东还。","杏花风、数里响鸣鞭。","望长安路，依稀柳色，翠点春妍。"],"s":"mixed","f":"trad"},{"i":"c-d33a9aaba77b","t":"醉蓬莱","a":"苏轼","d":"宋","g":"词","p":["笑劳生一梦，羁旅三年，又还重九。","华发萧萧，对荒园搔首。","赖有多情，好饮无事，似古人贤守。","岁岁登高，年年落帽，物华依旧。","此会应须烂醉，仍把紫菊茱萸，细看重嗅。","摇落霜风，有手栽双柳。","来岁今朝，为我西顾，酹羽觞江口。","会与州人，饮公遗爱，一江醇酎。"],"s":"simp","f":"trad"},{"i":"c-d633536649b6","t":"贺新郎","a":"苏轼","d":"宋","g":"词","p":["乳燕飞华屋。","悄无人、桐阴转午，晚凉新浴。","手弄生绡白团扇，扇手一时似玉。","渐困倚、孤眠清熟。","帘外谁来推绣户，枉教人、梦断瑶台曲。","又却是，风敲竹。","石榴半吐红巾蹙。","待浮花、浪蕊都尽，伴君幽独。","秾艳一枝细看取，芳心千重似束。","又恐被、秋风惊绿。","若待得君来向此，花前对酒不忍触。","共粉泪，两蔌蔌。"],"s":"simp","f":"trad"},{"i":"c-129849fc2a5c","t":"洞仙歌","a":"苏轼","d":"宋","g":"词","p":["江南腊尽，早梅花开后。","分付新春与垂柳。","细腰肢、自有入格风流，仍更是、骨体清英雅秀。","永丰坊那畔，尽日无人，惟见金丝弄晴昼。","断肠是，飞絮时，绿叶成阴，无个事、一成消瘦。","又莫是、东风逐君来，便吹散眉间，一点春皱。"],"s":"simp","f":"trad"},{"i":"c-6304966b7db7","t":"洞仙歌","a":"苏轼","d":"宋","g":"词","p":["冰肌玉骨，自清凉无汗。","水殿风来暗香满。","绣帘开、一点明月窥人，人未寝、敧枕钗横鬓乱。","起来携素手，庭户无声，时见疏星渡河汉。","试问夜如何，夜已三更，金波淡、玉绳低转。","但屈指、西风几时来，又不道、流年暗中偷换。"],"s":"simp","f":"trad"},{"i":"c-242f08fae43b","t":"八声甘州","a":"苏轼","d":"宋","g":"词","p":["有情风、万里卷潮来，无情送潮归。","问钱塘江上，西兴浦口，几度斜晖。","不用思量今古，俯仰昔人非。","谁似东坡老，白首忘机。","记取西湖西畔，正暮山好处，空翠烟霏。","算诗人相得，如我与君稀。","约他年、东还海道，愿谢公、雅志莫相违。","西州路，不应回首，为我沾衣。"],"s":"simp","f":"trad"},{"i":"c-6215044a13d3","t":"三部乐","a":"苏轼","d":"宋","g":"词","p":["美人如月。","乍见掩暮云，更增妍绝。","算应无恨，安用阴晴圆缺。","娇甚空只成愁，待下床又懒，未语先咽。","数日不来，落尽一庭红叶。","今朝置酒强起，问为谁减动，一分香雪。","何事散花却病，维摩无疾。","却低眉、惨然不答。","唱金缕、一声怨切。","堪折便折。","且惜取、少年花发。"],"s":"simp","f":"trad"},{"i":"c-5de31a1fd45a","t":"阮郎归","a":"苏轼","d":"宋","g":"词","p":["绿槐高柳咽新蝉。","薰风初入弦。","碧纱窗下水沈烟。","棋声惊昼眠。","微雨过，小荷翻。","榴花开欲然。","玉盆纤手弄清泉。","琼珠碎却圆。"],"s":"simp","f":"trad"},{"i":"c-5b4fc90314d0","t":"阮郎归","a":"苏轼","d":"宋","g":"词","p":["暗香浮动月黄昏。","堂前一树春。","东风何事入西邻。","儿家常闭门。","雪肌冷，玉容真。","香腮粉未匀。","折花欲寄岭头人。","江南日暮云。"],"s":"simp","f":"trad"},{"i":"c-7c6178f68bd6","t":"阮郎归","a":"苏轼","d":"宋","g":"词","p":["一年三度过苏台。","清尊长是开。","佳人相问苦相猜。","这回来不来。","情未尽，老先催。","人生真可咍，他年桃李阿谁栽。","刘郎双鬓衰。"],"s":"simp","f":"trad"},{"i":"c-b5fdf9611da3","t":"江神子・江城子","a":"苏轼","d":"宋","g":"词","p":["梦中了了醉中醒。","只渊明。","是前生。","走遍人间，依旧却躬耕。","昨夜东坡春雨足，乌鹊喜，报新晴。","雪堂西畔暗泉鸣。","北山倾。","小溪横。","南望亭丘，孤秀耸曾城。","都是斜川当日境，吾老矣，寄馀龄。"],"s":"simp","f":"trad"},{"i":"c-725289174daf","t":"江神子・江城子","a":"苏轼","d":"宋","g":"词","p":["翠蛾羞黛怯人看。","掩霜纨。","泪偷弹。","且尽一尊，收泪唱阳关。","漫道帝城天样远，天易见，见君难。","画堂新拘近孤山。","曲阑干。","为谁安。","飞絮落花，春色属明年。","欲棹小舟寻旧事，无处问，水连天。"],"s":"simp","f":"trad"},{"i":"c-54a624dc270c","t":"江神子・江城子","a":"苏轼","d":"宋","g":"词","p":["凤凰山下雨初晴。","水风清。","晚霞明。","一朵芙蕖，开过尚盈盈。","何处飞来双白鹭，如有意，慕娉婷。","忽闻江上弄哀筝。","苦含情，遣谁听。","烟敛云收，依约是湘灵。","欲待曲终寻问取，人不见，数峰青。"],"s":"simp","f":"trad"},{"i":"c-abcdfe5de8cc","t":"江神子・江城子","a":"苏轼","d":"宋","g":"词","p":["老夫聊发少年狂。","左牵黄。","右擎苍。","锦帽貂裘，千骑卷平冈。","为报倾城随太守，亲射虎，看孙郎。","酒酣胸胆尚开张。","鬓微霜。","又何妨。","持节云中，何日遣冯唐。","会挽雕弓如满月，西北望，射天狼。"],"s":"simp","f":"trad"},{"i":"c-656f4be31572","t":"江神子・江城子","a":"苏轼","d":"宋","g":"词","p":["天涯流落思无穷。","既相逢。","却匆匆。","携手佳人，和泪折残红。","为问东风馀几许，春纵在，与谁同。","隋堤三月水溶溶。","背归鸿。","去吴中。","回首彭城，清泗与淮通。","寄我相思千点泪，流不到，楚江东。"],"s":"simp","f":"trad"},{"i":"c-4dbd0d8f2b4f","t":"江神子・江城子","a":"苏轼","d":"宋","g":"词","p":["相逢不觉又初寒。","对尊前。","惜流年。","风紧离亭，冰结泪珠圆。","雪意留君君不住，从此去，少清欢。","转头山下转头看。","路漫漫。","玉花翻。","银海光宽，何处是超然。","知道故人相念否，携翠袖，倚朱阑。"],"s":"simp","f":"trad"},{"i":"c-bc1a50bf8d23","t":"江神子・江城子","a":"苏轼","d":"宋","g":"词","p":["黄昏犹是雨纤纤。","晓开帘。","欲平檐。","江阔天低，无处认青帘。","孤坐冻吟谁伴我，揩病目，拈衰髯。","使君留客醉厌厌。","水晶盐。","为谁甜。","手把梅花，东望忆陶潜。","雪似故人人似雪，虽可爱，有人嫌。"],"s":"simp","f":"trad"}]