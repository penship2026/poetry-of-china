[{"i":"c-320e904caf39","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["双桨。","小舟荡。","唤取莫愁迎叠浪。","武陵豪客青楼上。","不道风高江广。","千金难买倾城样。","那听绕梁清唱。"],"s":"simp","f":"trad"},{"i":"c-9e65fb8eb25b","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["草草。","最年少。","袖户银屏人窈窕。","瑶琴暗写相思调。","一曲关心多少。","临邛客舍成都道。","苦恨相逢不早。"],"s":"simp","f":"trad"},{"i":"c-c53b820e71a0","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["烟暖。","武陵晚。","洞里春长花烂熳。","红英满地溪流浅。","渐听云中鸡犬。","刘朗迷路香风远。","误到蓬莱仙馆。"],"s":"simp","f":"trad"},{"i":"c-538647f6f5f2","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["春艳。","桃花脸。","笑倚银屏施宝靥。","良人少有平戎胆。","归路光生弓剑。","青楼春永香帏掩。","独把韶华都占。"],"s":"simp","f":"trad"},{"i":"c-25c2c584c383","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["相慕。","酒家女。","巧笑明眸年十五。","当垆春永寻芳去。","门外落花飞絮。","银鞍白马金吾子。","多谢结裙情素。"],"s":"simp","f":"trad"},{"i":"c-0f723ea6f61d","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["肠断。","浙江岸。","楼上青帘新酒软。","吴姬绰约开金盏。","的的娇波流盼。","采菱歌罢行云散。","望断侬家心眼。"],"s":"simp","f":"trad"},{"i":"c-d266b043148e","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["苏小。","最娇妙。","几度尊前曾调笑。","云情雨态知多少。","悔恨相逢不早。","刘郎襟韵正年少。","风月今宵偏好。"],"s":"simp","f":"trad"},{"i":"c-fcb2436ff1c1","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["梦悄。","翠屏晓。","帐里薰炉残蜡照。","赏心乐事能多少。","忍听阳关声调。","明朝门外长安道。","怅望王孙芳草。"],"s":"simp","f":"trad"},{"i":"c-130648c43185","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["时节。","白银阙。","洞里春晴百和爇。","兰心底事多悲切。","消尽一团冰雪。","明皇恩爱云山绝。","谁道蓬莱安悦。"],"s":"simp","f":"trad"},{"i":"c-e12dcbfa0fee","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["调笑。","楚江渺。","粉面修眉花斗好。","擎荷折柳争相调。","惊起鸳鸯多少。","渔歌齐唱催残照。","一叶归舟轻小。"],"s":"simp","f":"trad"},{"i":"c-0094ff43d955","t":"调笑转踏・调笑令","a":"郑仅","d":"宋","g":"词","p":["声切。","恨难说。","千里潮平春浪阔。","梅风不解相思结。","忍送落花飞雪。","多才一去芳音绝。","更对珠帘新月。"],"s":"simp","f":"trad"},{"i":"c-d84ca0d28b92","t":"西江月","a":"蔡京","d":"宋","g":"词","p":["八十一年住世，四千里外无家。","如今流落向天涯。","梦到瑶池阙下。","玉殿五回命相，彤庭几度宣麻。","止因贪此恋荣华。","便有如今事也。"],"s":"simp","f":"trad"},{"i":"c-fc1f1eaf7600","t":"西江月","a":"苏琼","d":"宋","g":"词","p":["韩愈文章盖世，谢安情性风流。","良辰美景在西楼。","敢劝一卮芳酒。","记得南宫高第，弟兄争占鳌头。","金炉玉殿瑞烟浮。","高占甲科第九。"],"s":"simp","f":"trad"},{"i":"c-63a46a699122","t":"茶瓶儿","a":"李元膺","d":"宋","g":"词","p":["去年相逢深院宇。","海棠下、曾歌金缕。","歌罢花如雨。","翠罗衫上，点点红无数。","今岁重寻携手处。","空物事、人非春暮。","回首青门路。","乱红飞絮，相逐东风去。"],"s":"simp","f":"trad"},{"i":"c-f980bef619e2","t":"洞仙歌","a":"李元膺","d":"宋","g":"词","p":["廉纤细雨，殢东风如困。","萦断千丝为谁恨。","向楚宫一梦，千古悲凉，无处问。","愁到而今未尽。","分明都是泪，泣柳沾花，常与骚人伴孤闷。","记当年，得意处，酒力方融，怯轻寒、玉炉香润。","又岂识、情怀苦难禁，对点滴檐声，夜寒灯晕。"],"s":"simp","f":"trad"},{"i":"c-e41a657cd02e","t":"洞仙歌","a":"李元膺","d":"宋","g":"词","p":["雪云散尽，放晓晴池院。","杨柳于人便青眼。","更风流多处，一点梅心、相映远。","约略嚬轻笑浅。","一年春好处，不在浓芳，小艳疏香最娇软。","到清明时候，百紫千红花正乱。","已失春风一半。","蚤占取韶光，共追游，但莫管春寒，醉红自暖。"],"s":"simp","f":"trad"},{"i":"c-3c107988ddb0","t":"蓦山溪","a":"李元膺","d":"宋","g":"词","p":["溪堂欢燕。","惯捧玻璃盏。","今日祖西城，更忍把、一杯重劝。","别离情味，自古不堪秋，催泪雨，湿西风，肠共危弦断。","夕阳去路，五马旌旗乱。","便是古都春，应醉恋，曲江池馆。","须知别后，叠翠倚阑情，青嶂晚，碧云深，日近长安远。"],"s":"simp","f":"trad"},{"i":"c-de942873038a","t":"鹧鸪天","a":"李元膺","d":"宋","g":"词","p":["寂寞秋千两绣旗。","日长花影转阶迟。","燕惊午梦周遮语，蝶困春游落拓飞。","思往事，入颦眉。","柳梢阴重又当时。","薄情风絮难拘束，飞过东墙不肯归。"],"s":"simp","f":"trad"},{"i":"c-dd549d753df3","t":"菩萨蛮","a":"李元膺","d":"宋","g":"词","p":["彩旗画柱清明后。","花前姊妹争携手。","先紧绣罗裙。","轻衫束领巾。","琐绳金钏响。","渐出花梢上。","笑里问高低。","盘云亸玉螭。"],"s":"simp","f":"trad"},{"i":"c-38ac6ef9da04","t":"一落索","a":"李元膺","d":"宋","g":"词","p":["天上粉云如扫。","放小楼清晓。","古今何处想风流，最潇洒，龙山帽。","人似年华易老。","且芳樽频倒。","西风于我更多情，露金靥，篱边笑。"],"s":"simp","f":"trad"},{"i":"c-9496a17595f0","t":"浣溪沙","a":"李元膺","d":"宋","g":"词","p":["乞与安仁掠鬓霜。","不须红线小机窗。","剪刀疏下蜀罗长。","纤手捻残针缕细，金钗翻过齿痕香。","同心小绾寄思量。"],"s":"simp","f":"trad"},{"i":"c-f38df41fa3ab","t":"浣溪沙","a":"李元膺","d":"宋","g":"词","p":["饮散兰堂月未中。","骅骝娇簇绛纱笼。","玳簪促坐客从容。","已醉人间千日酒，赐来天上密云龙。","蓬仙清兴欲乘风。"],"s":"simp","f":"trad"},{"i":"c-f679c8813265","t":"调笑令","a":"吕南公","d":"宋","g":"词","p":["行客。","行客。","身世东西南北。","家林迢递不归。","岁时悲盛泪垂。","垂泪。","垂泪。","两鬓与霜相似。"],"s":"simp","f":"trad"},{"i":"c-fd9e812ee3ba","t":"调笑令","a":"吕南公","d":"宋","g":"词","p":["华草。","华草。","秀发乘春更好。","深心密竹纷纷。","妖韶随处动人。","人动。","人动。","王孙公子情重。"],"s":"simp","f":"trad"},{"i":"c-07bf5259fd9c","t":"瑶台第一层","a":"赵顼","d":"宋","g":"词","p":["西母池边宴罢，赠南枝、步玉霄。","绪风和扇，冰华发秀，雪质孤高。","汉陂呈练影，问是谁、独立江皋。","便凝望、壶中珪璧，天下琼瑶。","清标。","曾陪胜赏，坐望愁、解使尘消。","况双成与乳丹点染，都付香梢。","寿妆酥冷，郢韵佩举，麝卷云绡。","乐逍遥。","凤凰台畔，取次忆吹箫。"],"s":"simp","f":"trad"},{"i":"c-12fedbf5a35d","t":"临江仙","a":"吕希纯","d":"宋","g":"词","p":["□□□□□□□，□□□□□□。","莫交闲虑到心头。","有来忧不得，无后不须忧。","□□□□□□□，□□□□□□。","万般希望不如休。","无来求不得，有后不须求。"],"s":"simp","f":"trad"},{"i":"c-cd16cfa4e7cc","t":"蜡梅香","a":"喻陟","d":"宋","g":"词","p":["晓日初长，正锦里轻阴，小寒天气。","未报春消息，早瘦梅先发，浅苞纤蕊。","搵玉匀香，天赋与，风流标致。","问陇头人，音容万里。","待凭谁寄。","一样晓妆新，倚朱楼凝盼，素英如坠。","映月临风处，度几声羌管，愁生乡思。","电转光阴，须信道、飘零容易。","且频欢赏，柔芳正好，满簪同醉。"],"s":"mixed","f":"trad"},{"i":"c-8542a7f08313","t":"无闷","a":"丁注","d":"宋","g":"词","p":["风急还收，云冻又开，海阔无人翦水。","算六出工夫，怎教容易。","刚被郢歌楚舞。","镇独向，尊前夸轻细。","想谢庭诗咏，梁园赋赏，未成欢计。","天意。","是则是。","便下得控持，柳梢梅蕊。","又争奈、看看渐回春意。","好趁东君未觉，预先把、园林都装缀。","看是处，玉树琼枝，胜却万红千翠。"],"s":"simp","f":"trad"},{"i":"c-b1b240414261","t":"宝鼎现","a":"刘弇","d":"宋","g":"词","p":["浓阴堆积，回野空旷，将回微煦。","还是觉、早梅依旧，清艳枝枝攒晓树。","弄霁影、尽脂凝香蒂，琼削纤葩竞吐。","对几处园林，芳菲消息，都因传去。","取次台榭，等闲院落，偏宜独擅芳步。","长恁恐、寿阳妆面，姑射冰肤成暗妒。","笑杏坞、共桃蹊夸丽，一霎狂风骤雨。","又争似、年年此际，先得东皇为主。","好似雪里精神，曾解恼、游人吟顾。","想当时折赠，端的凭谁付与。","荡醉目、恨同云阻。","画角声将暮。","想异时成实，和羹止渴，还应得路。"],"s":"simp","f":"trad"},{"i":"c-dc3514e23815","t":"洞仙歌","a":"刘弇","d":"宋","g":"词","p":["凄凉楚弄，行客肠曾断。","涛卷秋容暗淮甸。","去年时、还是今日孤舟，烟浪里，身与江云共远。","别来丹枕梦，几过沧洲，皓月而今为谁满。","薄幸苦无端，误却婵娟，有人在、玉楼天半。","最不愤、西风破帆来，甚时节，收拾望中心眼。"],"s":"simp","f":"trad"},{"i":"c-828e7bb3f93e","t":"金明春・金明池","a":"刘弇","d":"宋","g":"词","p":["宝历延洪，昌辰开泰，崧岳储灵特异。","贤才并、□时间出，尽一一惊人绝艺。","捧乡书、气格飘飘，似阆苑神仙，参差相继。","纵子墨文章，相如才调，骤觉雷声平地。","太守宾兴当此际。","正瑞霭寒轻，虚堂风细。","舞腰旋、飞尘仿佛，歌管递、清声嘹唳。","况相将、桂籍荣登，对酒面鳞红，何妨沈醉。","但管取明年，宫花重戴，共赏金明春意。"],"s":"mixed","f":"trad"},{"i":"c-ed37a5aec979","t":"内家娇","a":"刘弇","d":"宋","g":"词","p":["绰约群芳里，阳和意，偏向一枝浓。","南国骤惊，动人奇艳，未饶西洛，百本千丛。","斩新弄，晓来无比格，半坼断肠红。","三月洞天，又还疑是，赋情楚客，窥见墙东。","朱阑干、遍倚生愁，怕无计、奈雨禁风。","别有瑞烟幕幕，时与遮笼。","便纵使当日，文忠品第，赵昌模写，难更形容。","应念故园桃李，羞怨春工。"],"s":"simp","f":"trad"},{"i":"c-5280e2779c6c","t":"安平乐慢","a":"刘弇","d":"宋","g":"词","p":["细想劳生，等闲聚散，冉冉轻似秋烟。","莲心暗苦，月意难圆。","神京去路三千。","当日风流，有妖饶枕上，软媚尊前。","何计访蓬仙。","断肠中、一叶晴川。","到而今、追思往事，奈向梦也难到奴边。","自恨不如兰灯，通宵尚照伊眠。","恰道无缘。","被人劝休莫瞒天。","多应是、前生负你，今世使我偿填。"],"s":"simp","f":"trad"},{"i":"c-c91fbeb589ea","t":"佳人醉","a":"刘弇","d":"宋","g":"词","p":["月到楼台第几。","十里金虫成缀。","袅琅玕、争罥绛球起。","试新妆、嬉春粉黛，盈盈暗香，接谁家秾李。","拥缇骑。","箫鼓沸三市。","别指春风画隼，归度鳌山影里。","闲红翠。","挥觞不待、游人分袂。","悄珠帘十二。"],"s":"simp","f":"trad"},{"i":"c-683f1c44a79b","t":"惜双双令・惜分飞","a":"刘弇","d":"宋","g":"词","p":["风外桔花香暗度。","飞絮绾、残春归去。","酝造黄梅雨。","冷烟晓占横塘路。","翠屏人在天低处。","惊梦断、行云无据。","此恨凭谁诉。","恁情却情危弦语。"],"s":"simp","f":"trad"},{"i":"c-c466e7d89467","t":"清平乐","a":"刘弇","d":"宋","g":"词","p":["东风依旧。","著意随堤柳。","搓得鹅儿黄欲就。","天色清明厮句。","去年紫陌朱门。","今朝雨魄云魂。","断送一生憔悴，知他几个黄昏。"],"s":"simp","f":"trad"},{"i":"c-1e4c8a536985","t":"瑶池宴令・越江吟","a":"廖正一","d":"宋","g":"词","p":["飞花成阵。","春心困。","寸寸。","别肠多少愁闷。","无人问。","偷啼自搵。","残妆粉。","抱瑶琴、寻出新韵。","玉纤趁。","南风未解幽愠。","低云鬓。","眉峰敛晕。","娇和恨。"],"s":"mixed","f":"trad"},{"i":"c-17b8e1140d24","t":"失调名","a":"董武子","d":"宋","g":"词","p":["畴昔寻芳秘殿西。","日压金铺，宫柳垂垂。"],"s":"simp","f":"trad"},{"i":"c-c14868d813fd","t":"醉落魄・一斛珠","a":"哑女","d":"宋","g":"词","p":["风波未息。","虚名浮利终无益。","不如早去备蓑笠。","高卧烟霞，千古企难及。","君今既已装行色。","定应雁塔题名籍。","他年若到南雄驿。","玉石休分，徒累卞和泣。"],"s":"simp","f":"trad"},{"i":"c-f872d1ba1b91","t":"望海潮","a":"秦观","d":"宋","g":"词","p":["星分牛斗，疆连淮海，扬州万井提封。","花发路香，莺啼人起，珠帘十里东风。","豪俊气如虹。","曳照春金紫，飞盖相从。","巷入垂杨，画桥南北翠烟中。","追思故国繁雄。","有迷楼挂斗，月观横空。","纹锦制帆，明珠溅雨，宁论爵马鱼龙。","往事逐孤鸿。","但乱云流水，萦带离宫。","最好挥毫万字，一饮拼千锺。"],"s":"simp","f":"trad"},{"i":"c-73e3de691b6b","t":"望海潮","a":"秦观","d":"宋","g":"词","p":["秦峰苍翠，耶溪潇洒，千岩万壑争流。","鸳瓦雉城，谯门画戟，蓬莱燕阁三休。","天际识归舟。","泛五湖烟月，西子同游。","茂草台荒，苎萝村冷起闲愁。","何人览古凝眸。","怅朱颜易失，翠被难留。","梅市旧书，兰亭古墨，依稀风韵生秋。","狂客鉴湖头。","有百年台沼，终日夷犹。","最好金龟换酒，相与醉沧洲。"],"s":"simp","f":"trad"},{"i":"c-6978d4410975","t":"望海潮","a":"秦观","d":"宋","g":"词","p":["奴如飞絮，郎如流水，相沾便肯相随。","微月户庭，残灯帘幕，匆匆共惜佳期。","才话暂分携。","早抱人娇咽，双泪红垂。","画舸难停，翠帷轻别两依依。","别来怎表相思。","有分香帕子，合数松儿。","红粉脆痕，青笺嫩约，丁宁莫遣人知。","成病也因谁。","更自言秋杪，亲去无疑。","但恐生时注著，合有分于飞。"],"s":"simp","f":"trad"},{"i":"c-57a80f523372","t":"沁园春","a":"秦观","d":"宋","g":"词","p":["宿霭迷空，腻云笼日，昼景渐长。","正兰皋泥润，谁家燕喜，蜜脾香少，触处蜂忙。","尽日无人帘幕挂，更风递游丝时过墙。","微雨后，有桃愁杏怨，红泪淋浪。","风流寸心易感，但依依伫立，回尽柔肠。","念小奁瑶鉴，重匀绛蜡，玉笼金斗，时熨沈香。","柳下相将游冶处，便回首青楼成异乡。","相忆事，纵蛮笺万叠，难写微茫。"],"s":"mixed","f":"trad"},{"i":"c-e5479c5abb40","t":"水龙吟","a":"秦观","d":"宋","g":"词","p":["小楼连远横空，下窥绣毂雕鞍骤。","朱帘半卷，单衣初试，清明时候。","破暖轻风，弄晴微雨，欲无还有。","卖花声过尽，斜阳院落，红成阵、飞鸳甃。","玉佩丁东别后。","怅佳期、参差难又。","名缰利锁，天还知道，和天也瘦。","花下重门，柳边深巷，不堪回首。","念多情但有，当时皓月，向人依旧。"],"s":"simp","f":"trad"},{"i":"c-dbe5bf746878","t":"八六子","a":"秦观","d":"宋","g":"词","p":["倚危亭。","恨如芳草，萋萋剗尽还生。","念柳外青骢别后，水边红袂分时，怆然暗惊。","无端天与娉婷。","夜月一帘幽梦，春风十里柔情。","怎奈向、欢娱渐随流水，素弦声断，翠绡香减，那堪片片飞花弄晚，濛濛残雨笼晴。","正销凝。","黄鹂又啼数声。"],"s":"mixed","f":"trad"},{"i":"c-d70e2c5071d7","t":"风流子","a":"秦观","d":"宋","g":"词","p":["东风吹碧草，年华换、行客老沧洲。","见梅吐旧英，柳摇新绿，恼人春色，还上枝头。","寸心乱，北随云黯黯，东逐水悠悠。","斜日半山，暝烟两岸，数声横笛，一叶扁舟。","青门同携手，前欢记、浑似梦里扬州。","谁念断肠南陌，回首西楼。","算天长地久，有时有尽，奈何绵绵，此恨难休。","拟待倩人说与，生怕人愁。"],"s":"simp","f":"trad"},{"i":"c-4d07641a688f","t":"梦扬州","a":"秦观","d":"宋","g":"词","p":["晚云收。","正柳塘、烟雨初休。","燕子未归，恻恻清寒如秋。","小阑外、东风软，透绣帷、花蜜香稠。","江南远，人何处，鹧鸪啼破春愁。","长记曾陪燕游。","酬妙舞清歌，丽锦缠头。","殢酒为花，十载因谁淹留。","醉鞭拂面归来晚，望翠楼、帘卷金钩。","佳会阻，离情正乱，频梦扬州。"],"s":"simp","f":"trad"},{"i":"c-aa4161d23131","t":"雨中花・夜行船","a":"秦观","d":"宋","g":"词","p":["指点虚无征路，醉乘斑虬，远访西极。","正天风吹落，满空寒白。","玉女明星迎笑，何苦自淹尘域。","正火轮飞上，雾卷烟开，洞观金碧。","重重观阁，横枕鳌峰，水面倒衔苍石。","随处有、奇香幽火，杳然难测。","好是蟠桃熟后，阿环偷报消息。","在青天碧海，一枝难遇，占取春色。"],"s":"simp","f":"trad"},{"i":"c-61d8f617adb1","t":"一丛花","a":"秦观","d":"宋","g":"词","p":["年时今夜见师师。","双颊酒红滋。","疏帘半卷微灯外，露华上、烟袅凉风。","簪髻乱抛，偎人不起，弹泪唱新词。","佳期。","谁料久参差。","愁绪暗萦丝。","想应妙舞清歌罢，又还对、秋色嗟咨。","惟有画楼，当时明月，两处照相思。"],"s":"simp","f":"trad"},{"i":"c-e7de77f42eac","t":"鼓笛慢・水龙吟","a":"秦观","d":"宋","g":"词","p":["乱花丛里曾携手，穷艳景，迷欢赏。","到如今谁把，雕鞍锁定，阻游人来往。","好梦随春远，从前事、不堪思想。","念香闺正杳，佳欢未偶，难留恋、空惆怅。","永夜婵娟未满，叹玉楼，几时重上。","那堪万里，却寻归路，指阳关孤唱。","苦恨东流水，桃源路、欲回双桨。","仗何人，细与丁宁问呵，我如今怎向。"],"s":"simp","f":"trad"},{"i":"c-fcf95607bd4f","t":"促拍满路花","a":"秦观","d":"宋","g":"词","p":["露颗添花色。","月彩投窗隙。","春思如中酒，恨无力。","洞房咫尺，曾寄情鸾翼。","云散无踪迹。","罗帐薰残，梦回无处寻觅。","轻红腻白。","步步熏兰泽。","约腕金环重，宜妆饰。","未知安否，一向无消息。","不似寻常忆。","忆后教人，片时存济不得。"],"s":"simp","f":"trad"},{"i":"c-d2223e935865","t":"长相思","a":"秦观","d":"宋","g":"词","p":["铁瓮城高，蒜山渡阔，干云十二层楼。","开尊待月，掩箔披风，依然灯火扬州。","绮陌南头。","记歌名宛转，乡号温柔。","曲槛俯清流。","想花阴、谁系兰舟。","念凄绝秦弦，感深荆赋，相望几许凝愁。","勤勤裁尺素，奈双鱼、难渡瓜洲。","晓鉴堪羞。","潘鬓点、吴霜渐稠。","幸于飞、鸳鸯未老，不应同是悲秋。"],"s":"simp","f":"trad"},{"i":"c-abe10363ff49","t":"满庭芳","a":"秦观","d":"宋","g":"词","p":["山抹微云，天连衰草，画角声断谯门。","暂停征棹，聊共引离尊。","多少蓬莱旧事，空回首、烟霭纷纷。","斜阳外，寒鸦万点，流水绕孤村。","销魂。","当此际，香囊暗解，罗带轻分。","谩赢得、青楼薄幸名存。","此去何时见也，襟袖上、空惹啼痕。","伤情处，高城望断，灯火已黄昏。"],"s":"simp","f":"trad"},{"i":"c-d18f857c31fa","t":"满庭芳","a":"秦观","d":"宋","g":"词","p":["红蓼花繁，黄芦叶乱，夜深玉露初零。","霁天空阔，云淡楚江清。","独棹孤篷小艇，悠悠过、烟渚沙汀。","金钩细，丝纶慢卷，牵动一潭星。","时时，横短笛，清风浩月，相与忘形。","任人笑生涯，泛梗飘萍。","饮罢不妨醉卧，尘劳事、有耳谁听。","江风静，日高未起，枕上酒微醒。"],"s":"simp","f":"trad"},{"i":"c-5dc5d37d3d74","t":"满庭芳","a":"秦观","d":"宋","g":"词","p":["碧水惊秋，黄云凝暮，败叶零乱空阶。","洞房人静，斜月照徘徊。","又是重阳近也，几处处，砧杵声催。","西窗下，风摇翠竹，疑是故人来。","伤怀。","增怅望，新欢易失，往事难猜。","问篱边黄菊，知为谁开。","谩道愁须殢酒，酒未醒、愁已先回。","凭阑久，金波渐转，白露点苍苔。"],"s":"simp","f":"trad"},{"i":"c-a178c6dd9a2d","t":"江城子","a":"秦观","d":"宋","g":"词","p":["西城杨柳弄春柔。","动离忧。","泪难收。","犹记多情，曾为系归舟。","碧野朱桥当日事，人不见，水空流。","韶华不为少年留。","恨悠悠。","几时休。","飞絮落花时候、一登楼。","便做春江都是泪，流不尽，许多愁。"],"s":"simp","f":"trad"},{"i":"c-18aa30aadc83","t":"江城子","a":"秦观","d":"宋","g":"词","p":["南来飞燕北归鸿。","偶相逢。","惨愁容。","绿鬓朱颜，重见两衰翁。","别后悠悠君莫问，无限事，不言中。","小槽春酒滴珠红。","莫匆匆。","满金锺。","饮散落花流水、各西东。","后会不知何处是，烟浪远，暮云重。"],"s":"simp","f":"trad"},{"i":"c-79a3693f1a55","t":"江城子","a":"秦观","d":"宋","g":"词","p":["枣花金钏约柔荑。","昔曾携。","事难期。","咫尺玉颜，和泪锁春闺。","恰似小园桃与李，虽同处，不同枝。","玉笙初度颤鸾篦。","落花飞。","为谁吹。","月冷风高，此恨只天知。","任是行人无定处，重相见，是何时。"],"s":"simp","f":"trad"},{"i":"c-e28f133c03a8","t":"满园花・促拍满路花","a":"秦观","d":"宋","g":"词","p":["一向沈吟久。","泪珠盈襟袖。","我当初不和、苦撋就。","惯纵得软顽，见底心先有。","行待痴心守。","甚捻著脉子，倒把人来僝僽。","近日来、非常罗皂丑。","佛也须眉皱。","怎掩得众人口。","待收了孛罗，罢了从来斗。","从今后。","休道共我，梦见也、不能得句。"],"s":"mixed","f":"trad"},{"i":"c-825205c2b3ed","t":"迎春乐","a":"秦观","d":"宋","g":"词","p":["菖蒲叶叶知多少。","惟有个、蜂儿妙。","雨晴红粉齐开了。","露一点、娇黄小。","早是被、晓风力暴。","更春共、斜阳俱老。","怎得香香深处，作个蜂儿抱。"],"s":"simp","f":"trad"},{"i":"c-2fdf0e87e9b8","t":"鹊桥仙","a":"秦观","d":"宋","g":"词","p":["纤云弄巧，飞星传恨，银汉迢迢暗度。","金风玉露一相逢，便胜却、人间无数。","柔情似水，佳期如梦，忍顾鹊桥归路。","两情若是长久时，又岂在、朝朝暮暮。"],"s":"simp","f":"trad"},{"i":"c-8ddf4b11dcc3","t":"菩萨蛮","a":"秦观","d":"宋","g":"词","p":["虫声泣露惊秋枕。","罗帏泪湿鸳鸯锦。","独卧玉肌凉。","残更与恨长。","阴风翻翠幔。","雨涩灯花暗。","毕竟不成眠。","鸦啼金井寒。"],"s":"simp","f":"trad"},{"i":"c-0ff6701bdd62","t":"减字木兰花","a":"秦观","d":"宋","g":"词","p":["天涯旧恨。","独自凄凉人不问。","欲见回肠。","断尽金炉小篆香。","黛峨长敛。","任是春风吹不展。","困倚危楼。","过尽飞鸿字字愁。"],"s":"simp","f":"trad"},{"i":"c-a4392e4645da","t":"木兰花・玉楼春","a":"秦观","d":"宋","g":"词","p":["秋容老尽芙蓉院。","草上霜花匀似翦。","西楼促坐酒杯深，风压绣帘香不卷。","玉纤慵整银筝雁。","红袖时笼金鸭暖。","岁华一任委西风，独有春红留醉脸。"],"s":"simp","f":"trad"},{"i":"c-42191fc678ec","t":"画堂春","a":"秦观","d":"宋","g":"词","p":["落红铺尽水平池。","弄晴小雨霏霏。","杏园憔悴杜鹃啼。","无奈春归。","柳外画楼独上，凭阑手拈花枝。","放花无语对斜晖。","此恨谁知。"],"s":"simp","f":"trad"},{"i":"c-43ba955a1ee1","t":"千秋岁","a":"秦观","d":"宋","g":"词","p":["水边沙外。","城郭春寒退。","花影乱，莺声碎。","飘零疏酒盏，离别宽衣带。","人不见，碧云暮合空相对。","忆昔西池会。","鹓鹭同飞盖。","携手处，今谁在。","日边清梦断，镜里朱颜改。","春去也，飞红万点愁如海。"],"s":"simp","f":"trad"},{"i":"c-70367d337e0f","t":"踏莎行","a":"秦观","d":"宋","g":"词","p":["雾失楼台，月迷津渡。","桃源望断无寻处。","可堪孤馆闭春寒，杜鹃声里斜阳暮。","驿寄梅花，鱼传尺素。","砌成此恨无重数。","郴江幸自绕郴山，为谁流下潇湘去。"],"s":"simp","f":"trad"},{"i":"c-bf8b42cc5ba1","t":"蝶恋花","a":"秦观","d":"宋","g":"词","p":["晓日窥轩双燕语。","似与佳人，共惜春将暮。","屈指艳阳都几许。","可无时霎闲风雨。","流水落花无问处。","只有飞云，冉冉来还去。","持酒劝云云且住。","凭君碍断春归路。"],"s":"simp","f":"trad"},{"i":"c-3082804ee76f","t":"一落索","a":"秦观","d":"宋","g":"词","p":["杨花终日空飞舞。","奈久长难驻。","海潮虽是暂时来，却有个、堪凭处。","紫府碧云为路。","好相将归去。","肯如薄幸五更风，不解与、花为主。"],"s":"simp","f":"trad"},{"i":"c-8153b4ec2fc7","t":"丑奴儿・采桑子","a":"秦观","d":"宋","g":"词","p":["夜来酒醒清无梦，愁倚阑干。","露滴轻寒。","雨打芙蓉泪不乾。","佳人别后音尘悄，瘦尽难拼。","明月无端。","已过红楼十二间。"],"s":"mixed","f":"trad"},{"i":"c-b79f8a2fee59","t":"南乡子","a":"秦观","d":"宋","g":"词","p":["妙手写徽真。","水翦双眸点绛唇。","疑是昔年窥宋玉，东邻。","只露墙头一半身。","往事已酸辛。","谁记当年翠黛颦。","尽道有些堪恨处，无情。","任是无情也动人。"],"s":"simp","f":"trad"},{"i":"c-281b0c0fe441","t":"醉桃源・阮郎归","a":"秦观","d":"宋","g":"词","p":["碧天如水月如眉。","城头银漏迟。","绿波风动画船移。","娇羞初见时。","银烛暗，翠帘垂。","芳心两自知。","楚台魂断晓云飞。","幽欢难再期。"],"s":"simp","f":"trad"},{"i":"c-15125c5698b5","t":"河传","a":"秦观","d":"宋","g":"词","p":["乱花飞絮。","又望空斗合，离人愁苦。","那更夜来，一霎薄情风雨。","暗掩将、春色去。","篱枯壁尽因谁做。","若说相思，佛也眉儿聚。","莫怪为伊，底死萦肠惹肚。","为没教、人恨处。"],"s":"simp","f":"trad"},{"i":"c-4118c8697afd","t":"河传","a":"秦观","d":"宋","g":"词","p":["恨眉醉眼。","甚轻轻覰著，神魂迷乱。","常记那回，小曲阑干西畔。","鬓云松、罗袜剗。","丁香笑吐娇无限。","语软声低，道我何曾惯。","云雨未谐，早被东风吹散。","闷损人、天不管。"],"s":"mixed","f":"trad"},{"i":"c-679b5473e674","t":"浣溪沙","a":"秦观","d":"宋","g":"词","p":["香靥凝羞一笑开。","柳腰如醉暖相挨。","日长春困下楼台。","照水有情聊整鬓，倚阑无绪更兜鞋。","眼边牵系懒归来。"],"s":"simp","f":"trad"},{"i":"c-e64295a3a957","t":"浣溪沙","a":"秦观","d":"宋","g":"词","p":["霜缟同心翠黛连。","红绡四角缀金钱。","恼人香爇是龙涎。","枕上忽收疑是梦，灯前重看不成眠。","又还一断恶因缘。"],"s":"simp","f":"trad"},{"i":"c-7658da06d42e","t":"浣溪沙","a":"秦观","d":"宋","g":"词","p":["脚上鞋儿四寸罗。","唇边朱粉一樱多。","见人无语但回波。","料得有心怜宋玉，只应无奈楚襄何。","今生有分共伊麽。"],"s":"mixed","f":"trad"},{"i":"c-e3eb2d30e3a7","t":"浣溪沙","a":"秦观","d":"宋","g":"词","p":["锦帐重重卷暮霞。","屏风曲曲斗红牙。","恨人何事苦离家。","枕上梦魂飞不去，觉来红日又西斜。","满庭芳草衬残花。"],"s":"simp","f":"trad"},{"i":"c-d1c34d941a51","t":"如梦令","a":"秦观","d":"宋","g":"词","p":["门外鸦啼杨柳。","春色著人如酒。","睡起熨沈香，玉腕不胜金斗。","消瘦。","消瘦。","还是褪花时候。"],"s":"mixed","f":"trad"},{"i":"c-97ba2cd65dad","t":"如梦令","a":"秦观","d":"宋","g":"词","p":["遥夜沈沈如水。","风紧驿亭深闭。","梦破鼠窥灯，霜送晓寒侵被。","无寐。","无寐。","门外马嘶人起。"],"s":"simp","f":"trad"},{"i":"c-84c79817356d","t":"如梦令","a":"秦观","d":"宋","g":"词","p":["幽梦匆匆破后。","妆粉乱痕沾袖。","遥想酒醒来，无奈玉销花瘦。","回首。","回首。","绕岸夕阳疏柳。"],"s":"simp","f":"trad"},{"i":"c-b43b65dee044","t":"如梦令","a":"秦观","d":"宋","g":"词","p":["楼外残阳红满。","春入柳条将半。","桃李不禁风，回首落英无限。","肠断。","肠断。","人共楚天俱远。"],"s":"simp","f":"trad"},{"i":"c-5753b24c4478","t":"如梦令","a":"秦观","d":"宋","g":"词","p":["池上春归何处。","满目落花飞絮。","孤馆悄无人，梦断月堤归路。","无绪。","无绪。","帘外五更风雨。"],"s":"simp","f":"trad"},{"i":"c-fe575be7aeb8","t":"阮郎归","a":"秦观","d":"宋","g":"词","p":["褪花新绿渐团枝。","扑人风絮飞。","秋千未拆水平堤。","落红成地衣。","游蝶困，乳莺啼。","怨春春怎知。","日长早被酒禁持。","那堪更别离。"],"s":"simp","f":"trad"},{"i":"c-45f23aacadcb","t":"阮郎归","a":"秦观","d":"宋","g":"词","p":["宫腰袅袅翠鬟松。","夜堂深处逢。","无端银烛殒秋风。","灵犀得暗通。","身有恨，恨无穷。","星河沈晓空。","陇头流水各西东。","佳期如梦中。"],"s":"simp","f":"trad"},{"i":"c-b527ab146136","t":"阮郎归","a":"秦观","d":"宋","g":"词","p":["潇湘门外水平铺。","月寒征棹孤。","红妆饮罢少踟蹰。","有人偷向隅。","挥玉箸，洒真珠。","梨花春雨馀。","人人尽道断肠初。","那堪肠已无。"],"s":"simp","f":"trad"},{"i":"c-767e1d616e3a","t":"满庭芳","a":"秦观","d":"宋","g":"词","p":["北苑研膏，方圭圆璧，名动万里京关。","碎身粉骨，功合上凌烟。","尊俎风流战胜，降春睡、开拓愁边。","纤纤捧，香泉溅乳，金缕鹧鸪斑。","相如，方病酒，一觞一咏，宾有群贤。","便扶起灯前，醉玉颓山。","搜揽胸中万卷，还倾动，三峡词源。","归来晚，文君未寝，相对晓妆残。"],"s":"simp","f":"trad"},{"i":"c-ce4cad1fdff6","t":"满庭芳","a":"秦观","d":"宋","g":"词","p":["晓色云开，春随人意，骤雨才过还晴。","古台芳榭，飞燕蹴红英。","舞困榆钱自落，秋千外、绿水桥平。","东风里，朱门映柳，低底按小秦筝。","多情。","行乐处，珠钿翠盖，玉辔红缨。","渐酒空金榼，花困蓬瀛。","豆蔻梢头旧恨，十年梦，屈指堪惊。","凭阑久，疏烟淡日，寂寞下芜城。"],"s":"simp","f":"trad"},{"i":"c-ff64641cf4cb","t":"满庭芳","a":"秦观","d":"宋","g":"词","p":["雅燕飞觞，清谈挥座，使君高会群贤。","密云双凤，初破缕金团。","窗外炉烟似动，开瓶试、一品香泉。","轻淘起，香生玉尘，雪溅紫瓯圆。","娇鬟。","宜美盼，双擎翠袖，稳步红莲。","坐中客翻愁，酒醒歌阑。","点上纱笼画烛，花骢弄、月影当轩。","频相顾，馀欢未尽，欲去且流连。"],"s":"simp","f":"trad"},{"i":"c-e059d32fdbdf","t":"桃源忆故人","a":"秦观","d":"宋","g":"词","p":["玉楼深锁薄情种。","清夜悠悠谁共。","羞见枕衾鸳凤。","闷即和衣拥。","无端画角严城动。","惊破一番新梦。","窗外月华霜重。","听彻梅花弄。"],"s":"simp","f":"trad"},{"i":"c-66ec2e3d9e8f","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["回顾。","汉宫路。","捍拨檀槽鸾对舞。","玉容寂寞花无主。","顾影偷弹玉箸。","未央宫殿知何处。","目送征鸿南去。"],"s":"simp","f":"trad"},{"i":"c-ca4a8bcc305e","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["辇路。","江枫古。","楼上吹箫人在否。","菱花半璧香尘污。","往日繁华何处。","旧欢新爱谁是主。","啼笑两难分付。"],"s":"simp","f":"trad"},{"i":"c-7ea3a6ae110f","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["翡翠。","好容止。","谁使庸奴轻点缀。","裴郎一见心如醉。","笑里偷传深意。","罗衣中夜与门吏。","暗结城西幽会。"],"s":"simp","f":"trad"},{"i":"c-673741674329","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["相慕。","无双女。","当日尚书先曾许。","王郎明俊神仙侣。","肠断别离情苦。","数年睽恨今复遇。","笑指襄江归去。"],"s":"simp","f":"trad"},{"i":"c-a9e72a431f87","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["肠断。","绣帘卷。","妾愿身为梁上燕。","朝朝暮暮长相见。","莫遣恩迁情变。","红绡粉泪知何限。","万古空传遗怨。"],"s":"simp","f":"trad"},{"i":"c-27215d7a61b2","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["恋恋。","楼中燕。","燕子楼空春色晚。","将军一去音容远。","空锁楼中深怨。","春风重到人不见。","十二阑干倚遍。"],"s":"simp","f":"trad"},{"i":"c-6047a420ec4e","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["春梦。","神仙洞。","冉冉拂墙花树动。","西厢待月知谁共。","更觉玉人情重。","红娘深夜行云送。","困亸钗横金凤。"],"s":"simp","f":"trad"},{"i":"c-c1569b370f66","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["柳岸。","水清浅。","笑折荷花呼女伴。","盈盈日照新妆面。","水调空传幽怨。","扁舟日暮笑声远。","对此令人肠断。"],"s":"simp","f":"trad"},{"i":"c-a71dadffa7fd","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["眷恋。","西湖岸。","湖面楼台侵云汉。","阿溪本是飞琼伴。","风月朱扉斜掩。","谢郎巧思诗裁翦。","能动芳怀幽怨。"],"s":"simp","f":"trad"},{"i":"c-528a1d52b643","t":"调笑令","a":"秦观","d":"宋","g":"词","p":["心素。","与谁语。","始信别离情最苦。","兰舟欲解春江暮。","精爽随君归去。","异时携手重来处。","梦觉春风庭户。"],"s":"simp","f":"trad"}]