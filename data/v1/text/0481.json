[{"i":"61b92c46-76c1-4fcb-824d-39f14eb82601","t":"又報王審知十字讖","a":"不詳","d":"唐","g":"短诗","p":["不怕羊入屋，只怕錢入腹。"],"s":"trad","f":"simp"},{"i":"208fa8e7-dad9-4226-8c13-7e43c3fc5492","t":"錢處士李氏讖","a":"不詳","d":"唐","g":"短诗","p":["髣髴之間一倍楊。"],"s":"trad","f":"simp"},{"i":"2e18ee99-dfe4-47ce-a19c-bc8fbdb4ed3a","t":"孫咸題廬山神廟詩","a":"不詳","d":"唐","g":"短诗","p":["獨入玄宮禮至真，焚香不爲賤貧身。","秦淮兩岸沙埋骨，湓浦千家血染塵。","廬阜煙霞誰是主，虎溪風月屬何人。","九江太守勤王室，好放天兵渡要津。"],"s":"mixed","f":"simp"},{"i":"0b39a689-d862-4d3d-9397-15c67fd59f33","t":"南唐江州風墜詩","a":"不詳","d":"唐","g":"短诗","p":["由來秉節世無雙，獨守孤城死不降。","何似知機早回首，免教流血滿長江。"],"s":"trad","f":"simp"},{"i":"4cd4c3e1-4abf-4e38-8fa3-93dd7b0d7b9e","t":"杭州還鄉和尚唱","a":"不詳","d":"唐","g":"短诗","p":["還鄉寂寂杳無蹤，不挂征帆水陸通。","蹋得故鄉回地穩，更無南北與西東。"],"s":"mixed","f":"simp"},{"i":"162eac2f-9ce7-4a3b-a2b8-76853563a8c4","t":"福州記","a":"不詳","d":"唐","g":"短诗","p":["潮水來，巖頭沒。","潮水去，矢口出。"],"s":"trad","f":"simp"},{"i":"a61c89c6-65de-4ffd-8600-8f7cce89a11b","t":"黃涅槃讖","a":"不詳","d":"唐","g":"短诗","p":["先打南，後打北，留取清源作佛國。"],"s":"trad","f":"simp"},{"i":"fcc3fcf0-1122-4f0b-9412-664340a10534","t":"陳智廣讖","a":"不詳","d":"唐","g":"短诗","p":["騎馬來，騎馬去。"],"s":"trad","f":"simp"},{"i":"4af91408-fdb5-43bb-9f05-cbfba3c3170c","t":"又讖","a":"不詳","d":"唐","g":"短诗","p":["功下田，力交連。","井底坐，二十年。"],"s":"trad","f":"simp"},{"i":"20b44e91-29f2-444f-b745-415e24f68614","t":"僧緘示王處厚","a":"不詳","d":"唐","g":"短诗","p":["周士同成，二王殊名。","王居一焉，百日爲程。"],"s":"mixed","f":"simp"},{"i":"4de40025-fdd4-43cf-822a-f09f6224686b","t":"任叟書授劉生","a":"不詳","d":"唐","g":"短诗","p":["承欲往梁宋，梁宋災方重。","旦夕爲人訟，承欲訪鄭生。","鄭生將有厄，即爲千里客，兼亦變衫色。"],"s":"mixed","f":"simp"},{"i":"293b1796-ab54-40d1-92db-5b4319727956","t":"昌明里中讖","a":"不詳","d":"唐","g":"短诗","p":["欲知修續者，脚下是生毛。"],"s":"mixed","f":"simp"},{"i":"ca83dd60-d648-4104-969d-13525d661ccd","t":"宋善威詩","a":"不詳","d":"唐","g":"短诗","p":["月落三株樹，日映九重天。","良夜歡宴罷，暫別庚申年。"],"s":"trad","f":"simp"},{"i":"0d643f49-362d-42a2-8058-3f220ad372af","t":"田承嗣誑李寶臣僞讖","a":"不詳","d":"唐","g":"短诗","p":["二帝同功勢萬全，將田作伴入幽燕。"],"s":"mixed","f":"simp"},{"i":"ee4325dc-b923-4401-9ad9-6a2cf3848403","t":"皮日休造黃巢讖","a":"不詳","d":"唐","g":"短诗","p":["欲知聖人姓，田八二十一。","欲知聖人名，果頭三屈律。"],"s":"trad","f":"simp"},{"i":"d5d6bca4-7f88-43f7-b410-fc00aa7f0f87","t":"上元初嵩山石記","a":"不詳","d":"唐","g":"古体","p":["木子當天下。","止戈龍。","李代代不移宗。","中鼎顯真容。","基千萬歲。"],"s":"trad","f":"simp"},{"i":"716e15a7-dc80-46b3-9155-7e0207014a5f","t":"上陽銅器篆","a":"不詳","d":"唐","g":"短诗","p":["長宜子孫。"],"s":"trad","f":"simp"},{"i":"5082ad43-9f50-4664-a14c-d69c207ca244","t":"永安渠石銘","a":"不詳","d":"唐","g":"短诗","p":["百年爲市後爲池。"],"s":"mixed","f":"simp"},{"i":"88a86386-a27a-4aaa-b0ca-3a264dbb1f9f","t":"漳泉分地神篆","a":"不詳","d":"唐","g":"短诗","p":["漳泉兩州，分地太平。","永安龍溪，山高氣清。","千年不惑，萬古作程。"],"s":"trad","f":"simp"},{"i":"b897ae6d-1f25-4c73-adac-f12a13803be3","t":"含元殿丹石隱語","a":"不詳","d":"唐","g":"短诗","p":["天漢二年，赤光生栗。","木下有子，傷心遇酷。"],"s":"trad","f":"simp"},{"i":"fc428eb1-f8f7-4c0b-9cc3-0f6c010f8bc7","t":"長安空宅銘篆","a":"不詳","d":"唐","g":"短诗","p":["夏天子紫金三千斤，賜有德者。"],"s":"trad","f":"simp"},{"i":"0193d4af-9481-4066-a8b4-ea9bc185fb2b","t":"莆田石記","a":"不詳","d":"唐","g":"短诗","p":["石敢當，鎮百鬼，壓災殃。","官吏福，百姓康。","風教盛，禮樂昌。"],"s":"trad","f":"simp"},{"i":"105f5340-4763-4829-b3c2-8ebb426cbd0a","t":"符離樹穴中石篆","a":"不詳","d":"唐","g":"短诗","p":["旁有水，上有道，八百年中逢栲栳。"],"s":"trad","f":"simp"},{"i":"5132e200-c112-44ac-9872-2621fe04fe8e","t":"淮西池濠石銘","a":"不詳","d":"唐","g":"短诗","p":["井底一竿竹，竹色深綠綠。","雞未肥，酒未熟，障車兒郎且須縮。"],"s":"trad","f":"simp"},{"i":"48c8bc5f-3d8f-4c1d-9f71-9783e4f6f7fa","t":"羅池石刻","a":"不詳","d":"唐","g":"短诗","p":["龍城柳，神所守。","驅厲鬼，山左首。","福士氓，制九醜。"],"s":"trad","f":"simp"},{"i":"b2e838ad-239f-4388-8acf-3290f9d0927b","t":"道者遺記","a":"不詳","d":"唐","g":"古体","p":["武之在卯，堯王八季。","我棄其寢，我去其扆。","深深然，高高然。","人不吾知，又不吾謂。","由今之後，二百餘祀。","燄燄其光，和和其始。","東方有兔，小首元尾。","經過吾道，來至吾里。","飲吾泉以醉，登吾榻而寐。","刻乎其壁，奧乎其義。","人誰以辨，其東平子。"],"s":"mixed","f":"simp"},{"i":"64ce5c22-06b8-4955-a399-fc99a74c2e2a","t":"王璠石銘","a":"不詳","d":"唐","g":"短诗","p":["山有石，石有玉。","玉有瑕，即休也。"],"s":"trad","f":"simp"},{"i":"dab00c5d-f461-4636-98e8-c1f3320c28a8","t":"玄元觀棟桁記","a":"不詳","d":"唐","g":"短诗","p":["山水誰無言，元年有福重修。"],"s":"trad","f":"simp"},{"i":"725c1d62-aa54-44f1-8998-e029b46f6138","t":"天台觀石簡記","a":"不詳","d":"唐","g":"短诗","p":["海水竭，台山缺，皇家寶祚無休歇。"],"s":"trad","f":"simp"},{"i":"bd29e453-d8e4-425a-8384-3a81e1c91f9b","t":"成都羅城北門石記","a":"不詳","d":"唐","g":"短诗","p":["五五復五五，五五逾重數。","浮世若浮雲，金石一如故。","與君相見時，杳杳非今土。"],"s":"trad","f":"simp"},{"i":"b6f2896c-ad09-41a4-b1f5-f92a1d5c1d84","t":"青羊宮甎記","a":"不詳","d":"唐","g":"短诗","p":["太平平中元災。"],"s":"trad","f":"simp"},{"i":"20690d53-7f5a-40cc-95e9-627ef385ba41","t":"銅雀臺玉板篆","a":"不詳","d":"唐","g":"短诗","p":["上土巴灰除虛除，伊尹東北八九餘。","秦趙多應分五玉，絲竹木子世世居。","但看六六百中外，世主難留如國如。"],"s":"trad","f":"simp"},{"i":"21d7ce4c-deef-4aeb-9ee2-c5182d770702","t":"顯德道宮石記","a":"不詳","d":"唐","g":"短诗","p":["瑞雲靈跡鎮梁東，他日多應與古同。","歲月遷移人事改，再來閑處又興功。"],"s":"trad","f":"simp"},{"i":"b79cea79-87fe-4b35-ae19-20b02be9ccc5","t":"南唐昇元殿基下石記","a":"不詳","d":"唐","g":"短诗","p":["莫問江南事，江南事可憑。","抱雞升寶位，跨犬出金陵。","子建司南位，安仁秉夜燈。","東鄰嬌小女，騎虎渡河冰。"],"s":"trad","f":"simp"},{"i":"6541b507-5e32-44e6-bf78-65bd6affe6a2","t":"馬殷浚城石碣篆","a":"不詳","d":"唐","g":"短诗","p":["龍舉頭，猳掉尾。","羊爲兄，猴作弟。","羊歸穴，猴離次。"],"s":"mixed","f":"simp"},{"i":"140b43a1-d4a5-495d-9c8c-9b1e4bdbe8b9","t":"王霸仙壇甎刻","a":"不詳","d":"唐","g":"古体","p":["樹枯不用伐，壇壞不須結。","未滿一千歲，自有系孫列。","後來是三皇，潮水蕩禍殃。","巖逢二乍間，未免有消亡。","子孫依吾道，代代封閩疆。"],"s":"trad","f":"simp"},{"i":"1d71dc04-00ad-4e16-a909-cbcf19cfee66","t":"劉龑石讖","a":"不詳","d":"唐","g":"短诗","p":["人人有一，山山值牛。","兔絲吞骨，蓋海承劉。"],"s":"trad","f":"simp"},{"i":"5e0bca56-4c6b-41c9-91fd-103b4ea575c6","t":"南漢羅浮古劒篆文","a":"不詳","d":"唐","g":"短诗","p":["丁與水同宮，王將耳口同。","尹來居口上，山岫獲重重。"],"s":"trad","f":"simp"},{"i":"fde0348c-0a2f-49d4-b2aa-1a0625e7663c","t":"司馬承禎含象鑑文 一","a":"不詳","d":"唐","g":"短诗","p":["天地含象，日月貞明。","寫規萬物，洞鑒百靈。"],"s":"trad","f":"simp"},{"i":"aab021b1-1d2f-4393-8a83-962c78f718bf","t":"司馬承禎含象鑑文 二","a":"不詳","d":"唐","g":"短诗","p":["龜自卜，鏡自照。","吉可募，光不曜。"],"s":"trad","f":"simp"},{"i":"96cc24bb-a878-421f-af61-0ad16aec3a98","t":"司馬承禎含象鑑文 三","a":"不詳","d":"唐","g":"短诗","p":["青蓋作鏡大吉昌，巧工刊之成文章。","左龍右虎辟不祥，朱鳥玄武順於旁，子孫富貴居中央。"],"s":"mixed","f":"simp"},{"i":"19b28bd5-7c64-49b5-822b-879e5d8869e1","t":"景震劒文 一","a":"不詳","d":"唐","g":"短诗","p":["撝雷電，運玄星。","摧凶惡，亨利貞。"],"s":"mixed","f":"simp"},{"i":"37ebd484-8ba0-4508-a88a-cf4fa9071f8a","t":"景震劒文 二","a":"不詳","d":"唐","g":"短诗","p":["乾降精，坤應靈。","日月象，岳瀆形。"],"s":"mixed","f":"simp"},{"i":"a08feced-2d31-4e1c-b7b4-13bec141385c","t":"高麗鏡文","a":"不詳","d":"唐","g":"短诗","p":["三水中，四維下，上帝降子於辰馬。","先操雞，後搏鴨。","己年中，二龍見。","一則藏身青木中，一則見形黑金東。"],"s":"trad","f":"simp"},{"i":"15c94992-f5dc-4fdc-b0eb-6d53dc734f62","t":"京西市放生池墓銘","a":"不詳","d":"唐","g":"短诗","p":["龜言市，蓍言水。"],"s":"trad","f":"simp"},{"i":"20443250-ca50-45dc-9b3e-41f6b26bd16a","t":"古墓卜地詞","a":"不詳","d":"唐","g":"短诗","p":["爾後一千歲，此地化爲泉。","賴逢鄔侍御，移我向高原。"],"s":"mixed","f":"simp"},{"i":"816a3132-7972-4830-ba11-8046800e13a2","t":"衛先生墓銘","a":"不詳","d":"唐","g":"短诗","p":["姜師度，更移向南三五步。"],"s":"trad","f":"simp"},{"i":"0e95e238-e2f6-44ba-9a57-3c8e6bd8196e","t":"隱者瘞男銘","a":"不詳","d":"唐","g":"短诗","p":["神真鍊形年未足，化爲我子功相續。","丞相瘞之刻玄玉，仙路何長死何促。"],"s":"mixed","f":"simp"},{"i":"1da51193-6972-4fcf-871c-dc5cf4e28c62","t":"烏氏葬碑","a":"不詳","d":"唐","g":"短诗","p":["牛領岡頭，紅簫籠下。","葬用兩日，手板相亞。"],"s":"trad","f":"simp"},{"i":"ed564cbb-70e0-4c3d-b1cd-717d5694dbea","t":"巖腹棺銘","a":"不詳","d":"唐","g":"短诗","p":["欲墮不墮逢王果，五百年中重收我。"],"s":"trad","f":"simp"},{"i":"758542b4-896b-41e7-832e-6df14f9f4502","t":"古棺石銘","a":"不詳","d":"唐","g":"短诗","p":["欲陷不陷被藤縛，欲落不落被沙閣，五百年後遇熊博。"],"s":"trad","f":"simp"},{"i":"7125f23e-e1aa-4ec9-9113-83be55fc7dcb","t":"漣水古冢缾文","a":"不詳","d":"唐","g":"短诗","p":["一雙青烏子，飛來五兩頭。","借問船輕重，寄信到揚州。"],"s":"trad","f":"simp"},{"i":"c4cca7ac-9514-4fb2-843f-6b75a67d8150","t":"沈彬壙篆","a":"不詳","d":"唐","g":"短诗","p":["佳城今已開，雖開不葬埋。","漆燈猶未滅，留待沈彬來。"],"s":"trad","f":"simp"},{"i":"45304bf4-4738-461d-8428-5a44882200bb","t":"廣陵古冢石刻","a":"不詳","d":"唐","g":"短诗","p":["日爲箭兮月爲弓，四時躬人兮無窮。","但得天將明月死，不覺人隨流水空。","山川秀兮碧穹窿，崇夫人墓兮直其中。","猨啼鳥嘯煙濛濛，千年萬年松柏風。"],"s":"mixed","f":"simp"},{"i":"906e243c-eb25-47d2-a783-a9831c53e313","t":"王承檢掘得墓銘","a":"不詳","d":"唐","g":"古体","p":["車道之北，邽山之陽。","深深葬玉，鬱鬱埋香。","刻斯貞石，煥乎遺芳。","地變陵谷，嶮列城隍。","乾德丙年，壞者合郎。"],"s":"trad","f":"simp"