[{"i":"8bd75875-20ad-4b0c-8e73-948d5f282e4b","t":"春草凝露","a":"張友正","d":"唐","g":"古体","p":["蒼蒼芳草色，含露對青春。","已賴陽和長，仍慙潤澤頻。","日臨殘未滴，風度欲成津。","蕙葉垂偏重，蘭叢洗轉新。","將行愁裛逕，欲采畏濡身。","獨愛池塘畔，清華遠襲人。"],"s":"mixed","f":"simp"},{"i":"8162fe87-00b8-44fc-b2f4-1d27e0019246","t":"錦帶佩吳鉤","a":"張友正","d":"唐","g":"古体","p":["帶劒誰家子，春朝紫陌遊。","結邊霞聚錦，懸處月隨鉤。","綵縷迴文出，雄芒練影浮。","葉依花裏豔，霜向鍔中秋。","的皪宜驄馬，斕斒映綺裘。","應須待報國，一刎月支頭。"],"s":"mixed","f":"simp"},{"i":"5b3cb41e-72c6-4d91-af6a-cbc0c2e32d4d","t":"山中臥寄盧郎中","a":"伍唐珪","d":"唐","g":"短诗","p":["十年耕釣水雲間，住僻家貧少往還。","一徑綠苔凝曉露，滿頭白髮對青山。","野僧採藥來醫病，樵客攜觴爲解顏。","空戀舊時恩獎地，無因匍匐出柴關。"],"s":"mixed","f":"simp"},{"i":"6163908f-5c01-47d1-b46c-0f61a2b28717","t":"寒食日獻郡守","a":"伍唐珪","d":"唐","g":"短诗","p":["入門堪笑復堪憐，三徑苔荒一釣船。","慙愧四隣教斷火，不知廚裏久無煙。"],"s":"mixed","f":"simp"},{"i":"b2b0119e-9bd7-4b5b-b453-2fdf81f79c77","t":"上蘇使君","a":"伍唐珪","d":"唐","g":"短诗","p":["江西昔日推韓注，袁水今朝數趙祥。","縱使文翁能待客，終栽桃李不成行。"],"s":"trad","f":"simp"},{"i":"4219be47-4add-40a6-9eff-bd78b2d028e0","t":"贈妓人王福娘","a":"孫棨","d":"唐","g":"短诗","p":["綵翠仙衣紅玉膚，輕盈年在破瓜初。","霞杯醉勸劉郎賭，雲髻慵邀阿母梳。","不怕寒侵緣帶寶，每憂風舉倩持裾。","謾圖西子晨粧樣，西子元來未得如。"],"s":"trad","f":"simp"},{"i":"67690f1a-568e-4837-be62-689fdb9cb58c","t":"題妓王福娘墻 一","a":"孫棨","d":"唐","g":"短诗","p":["移壁迴窗費幾朝，指鐶偷解博紅椒。","無端鬬草輸鄰女，更被拈將玉步搖。"],"s":"trad","f":"simp"},{"i":"a55c2233-1ef7-4b7c-bd37-20f801d512b9","t":"題妓王福娘墻 二","a":"孫棨","d":"唐","g":"短诗","p":["寒繡衣裳餉阿嬌，新團香獸不禁燒。","東鄰起樣裙腰闊，剩蹙黃金線幾條。"],"s":"trad","f":"simp"},{"i":"9858abdb-024f-4c4d-819a-722b227e8a1f","t":"題妓王福娘墻 三","a":"孫棨","d":"唐","g":"短诗","p":["試共卿卿語笑初，畫堂連遣侍兒呼。","寒肌不耐金如意，白獺爲膏郎有無。"],"s":"mixed","f":"simp"},{"i":"3b58bfa5-9a3a-4d93-aa01-1a3a7f2e6d0e","t":"戲李文遠","a":"孫棨","d":"唐","g":"短诗","p":["引君來訪洞中仙，新月如眉拂戶前。","領取嫦娥攀取桂，便從陵谷一時遷。"],"s":"trad","f":"simp"},{"i":"57d46fc4-2e0f-453d-86fc-5b23af5b4497","t":"題劉泰娘舍","a":"孫棨","d":"唐","g":"短诗","p":["尋常凡木最輕樗，今日尋樗桂不如。","漢高新破咸陽後，英俊奔波遂喫虛。"],"s":"mixed","f":"simp"},{"i":"dafcc512-e764-422d-9b9a-e6f12ef1b23b","t":"戲張道人不飲酒","a":"顏蕘","d":"唐","g":"短诗","p":["言自雲山訪我來，每聞奇秘覺叨陪。","吾師不飲人間酒，應待流霞即舉杯。"],"s":"trad","f":"simp"},{"i":"e32e0433-911d-4e9e-b834-0102f4fc02b5","t":"句","a":"顏蕘","d":"唐","g":"短诗","p":["爽籟盡成鳴鳳曲，遊人多是弄珠仙。"],"s":"trad","f":"simp"},{"i":"88ee9037-f145-4538-8397-f1e8b1cce4c5","t":"秋醉歌","a":"張爲","d":"唐","g":"古体","p":["金風颯已起，還是招漁翁。","攜酒天姥岑，自彈嶧陽桐。","脫却登山履，赤脚翹青筇。","泉聲掃殘暑，猨臂攀長松。","翠微泛罇綠，苔蘚分煙紅。","造化處術內，相對數壺空。","醉眠嶺上草，不覺夜露濃。","一夢到天曉，始覺一醉中。","皎然夢中路，直到瀛洲東。","初平把我臂，相與騎白龍。","三留對上帝，玉樓十二重。","上帝賜我酒，送我敲金鍾。","寶閣香斂苒，琪樹寒玲瓏。","動葉如笙篁，音律相怡融。","珍重此一醉，百骸出天地。","長如此夢魂，永謝名與利。"],"s":"mixed","f":"simp"},{"i":"0de89bd5-852d-4a30-be20-a7c8c6f49eb9","t":"謝別毛仙翁","a":"張爲","d":"唐","g":"古体","p":["羸形感神藥，削骨生豐肌。","蘭炷飄靈煙，妖怪立誅夷。","重覩日月光，何報父母慈。","黃河濁衮衮，別淚流澌澌。","黃河清有時，別淚無收期。"],"s":"mixed","f":"simp"},{"i":"a2341666-1fc9-4c72-8e99-2775ab5dff14","t":"漁陽將軍","a":"張爲","d":"唐","g":"短诗","p":["霜髭擁頷對窮秋，著白貂裘獨上樓。","向北望星提劒立，一生長爲國家憂。"],"s":"mixed","f":"simp"},{"i":"98ae2afc-2ec3-4fbf-8561-78d373464a45","t":"句","a":"張爲","d":"唐","g":"短诗","p":["到處即閉戶，逢君方展眉。"],"s":"mixed","f":"simp"},{"i":"30156080-0d07-4b6c-ad53-7ff3ac764b6d","t":"岑公巖","a":"馬冉","d":"唐","g":"短诗","p":["南溪有仙澗，咫尺非人間。","泠泠松風下，日暮空蒼山。"],"s":"trad","f":"simp"},{"i":"2ba5b680-8c05-46fa-8ca3-80cff02ee98a","t":"諸暨五洩山","a":"周鏞","d":"唐","g":"短诗","p":["路入蒼煙九過溪，九穿巖曲到招提。","天分五溜寒傾北，地秀諸峰翠插西。","鑿徑破崖來木杪，駕泉鳴竹落榱題。","當年老默無消息，猶有詞堂一杖藜。"],"s":"trad","f":"simp"},{"i":"819a6b2a-6337-4ca8-bcaa-405ca5766415","t":"贈羅隱","a":"劉贊","d":"唐","g":"短诗","p":["人皆言子屈，獨我謂君非。","明主既難謁，青山何不歸？","年虛侵雪鬢，塵枉汚麻衣。","自古逃名者，至今名豈微。"],"s":"trad","f":"simp"},{"i":"2dacb6eb-7a73-482c-9d02-aedecfd386f0","t":"句","a":"劉贊","d":"唐","g":"短诗","p":["絮花飛起雪漫漫，長得宮娥帶笑看。"],"s":"trad","f":"simp"},{"i":"2171e44d-f83c-4277-9155-6d06f66a9fab","t":"洛陽道","a":"任翻","d":"唐","g":"古体","p":["憧憧洛陽道，塵下生青草。","行者豈無家，無人在家老。","雞鳴前結束，爭去恐不早。","百年路傍盡，白日車中曉。","求富江海狹，取貴山岳小。","二端立在途，奔走無由了。"],"s":"mixed","f":"simp"},{"i":"6e5cf931-e8ba-4eb5-bba1-08180cb72982","t":"春晴","a":"任翻","d":"唐","g":"短诗","p":["楚國多春雨，柴門喜晚晴。","幽人臨水坐，好鳥隔花鳴。","野色臨空闊，江流接海平。","門前到溪路，今夜月分明。"],"s":"trad","f":"simp"},{"i":"f3d9b0ff-0a97-4993-9279-5bed56560e90","t":"秋晚郊居","a":"任翻","d":"唐","g":"短诗","p":["遠聲霜後樹，秋色水邊村。","野徑無來客，寒風自動門。","海山藏日影，江月落潮痕。","惆悵高飛晚，年年別故園。"],"s":"trad","f":"simp"},{"i":"dcd30036-50f3-4374-bcc5-940b466d54f2","t":"秋晚途次","a":"任翻","d":"唐","g":"短诗","p":["秋色滿行路，此時心不閑。","孤貧遊上國，少壯有衰顏。","衆鳥已歸樹，旅人猶過山。","蕭條遠林外，風急水潺潺。"],"s":"mixed","f":"simp"},{"i":"300aa35a-b18a-4b04-8c8b-9f625cb15c7b","t":"葛仙井","a":"任翻","d":"唐","g":"短诗","p":["古井碧沈沈，分明見百尋。","味甘傳邑內，脉冷應山心。","圓入月輪淨，直涵峰影深。","自從仙去後，汲引到如今。"],"s":"mixed","f":"simp"},{"i":"78c6e097-b066-4e41-bec8-341110b60443","t":"桐柏觀","a":"任翻","d":"唐","g":"短诗","p":["飄飄雲外者，蹔宿聚仙堂。","半夜人無語，中宵月送涼。","鶴歸高樹靜，螢過小池光。","不得多時住，門開是事忙。"],"s":"trad","f":"simp"},{"i":"8b4ccdea-b064-4e64-a8d8-81fe36fc9be4","t":"冬暮野寺","a":"任翻","d":"唐","g":"短诗","p":["江東寒近臘，野寺水天昏。","無酒可銷夜，隨僧早閉門。","照墻燈影短，著瓦雪聲繁。","飄泊仍千里，清吟欲斷魂。"],"s":"trad","f":"simp"},{"i":"aae858de-d014-439b-b33b-d919dbdeab21","t":"贈濟禪師","a":"任翻","d":"唐","g":"短诗","p":["碧峰秋寺內，禪客已無情。","半頂髮根白，一生心地清。","竹房侵月靜，石徑到門平。","山下塵囂路，終年誓不行。"],"s":"trad","f":"simp"},{"i":"4a3a07b0-9369-4e7f-99dd-32685256e16b","t":"經墮淚碑","a":"任翻","d":"唐","g":"短诗","p":["羊公傳化地，千古事空存。","碑已無文字，人猶敬子孫。","峴山長閉恨，漢水自流恩。","數處煙嵐色，分明是淚痕。"],"s":"trad","f":"simp"},{"i":"3abfdba9-2a0c-41fd-83db-17b9a1d18e96","t":"長安冬夜書事","a":"任翻","d":"唐","g":"短诗","p":["憂來長不寐，往事重思量。","清渭幾年客，故衣今夜霜。","春風誰識面，水國但牽腸。","十二門車馬，昏明各自忙。"],"s":"trad","f":"simp"},{"i":"92e403e1-8dc4-49fe-83f8-b5fcd551be40","t":"越江漁父","a":"任翻","d":"唐","g":"短诗","p":["借問釣魚者，持竿多少年。","眼明汀島畔，頭白子孫前。","櫂入花時浪，燈留雨夜船。","越江深見底，誰識此心堅。"],"s":"trad","f":"simp"},{"i":"cc087581-acef-4440-9e83-f3d53cdf7bde","t":"哭友人","a":"任翻","d":"唐","g":"短诗","p":["逢著南州史，江邊哭問君。","送終時有雪，歸葬處無雲。","官庫惟留劒，隣僧共結墳。","兒孫未成立，誰與集遺文。"],"s":"trad","f":"simp"},{"i":"7597bff3-6104-4b19-96ca-b377b5a53424","t":"送李衡","a":"任翻","d":"唐","g":"短诗","p":["羈棲親故少，遠別惜清才。","天畔出相送，路長知未迴。","欲銷今日恨，強把異鄉杯。","君去南堂後，應無客到來。"],"s":"trad","f":"simp"},{"i":"f69af4c2-f99b-4593-a732-969d99243fd3","t":"宮怨","a":"任翻","d":"唐","g":"短诗","p":["淚乾紅落臉，心盡白垂頭。","自此方知怨，從來豈信愁。"],"s":"trad","f":"simp"},{"i":"b4ca5669-16d6-4b2c-b60a-8b424c1e5d12","t":"惜花","a":"任翻","d":"唐","g":"短诗","p":["無語與花別，細看枝上紅。","明年又相見，還恐是愁中。"],"s":"trad","f":"simp"},{"i":"25748fc8-5511-4aa3-b7b2-ee7c7b8af56d","t":"宿巾子山禪寺","a":"任翻","d":"唐","g":"短诗","p":["絕頂新秋生夜涼，鶴翻松露滴衣裳。","前峰月映半江水，僧在翠微開竹房。"],"s":"mixed","f":"simp"},{"i":"f709816d-d21d-45db-963e-814ce89aba20","t":"再遊巾子山寺","a":"任翻","d":"唐","g":"短诗","p":["靈江江上幘峰寺，三十年來兩度登。","野鶴尚巢松樹徧，竹房不見舊時僧。"],"s":"trad","f":"simp"},{"i":"28b2104f-d0ca-46e5-af36-f99951136d3a","t":"三遊巾子山寺感述","a":"任翻","d":"唐","g":"短诗","p":["清秋絕頂竹房開，松鶴何年去不迴。","惟有前峰明月在，夜深猶過半江來。"],"s":"trad","f":"simp"},{"i":"cc0bdb14-572d-41d2-993e-925e8fb7d36e","t":"畫山水圖荅大愚","a":"荆浩","d":"唐","g":"短诗","p":["恣意縱橫埽，峰巒次第成。","筆尖寒樹瘦，墨澹野雲輕。","巖石噴泉窄，山根到水平。","禪房時一展，兼稱苦空情。"],"s":"mixed","f":"simp"},{"i":"77b8c821-bdbc-43c9-819c-1d57ee5a7db0","t":"宿顧城二首 一","a":"張直","d":"唐","g":"古体","p":["綠草展青裀，樾影連春樹。","茅屋八九家，農器六七具。","主人有好懷，搴衣留我住。","春酒新潑醅，香美連糟濾。","一醉臥花陰，明朝送君去。"],"s":"trad","f":"simp"},{"i":"33086607-fc85-487b-adfb-cb937624403d","t":"宿顧城二首 二","a":"張直","d":"唐","g":"古体","p":["醉臥夜將半，土底聞雞啼。","驚駭問主人，爲我剖荒迷。","武湯東伐韋，固君含悲悽。","神奪悔悟魄，幻化爲石雞。","形骸僅盈寸，咿喔若啁蜺。","吾村耕耘叟，多獲於鋤犂。"],"s":"mixed","f":"simp"},{"i":"24f25d1e-409b-4d27-bb36-6e9e071e432b","t":"題桃源僧","a":"陳光","d":"唐","g":"短诗","p":["桃源有僧舍，跬步異人天。","花亂似無主，鶴鳴疑有仙。","軒廊明野色，松檜濕春煙。","定擬辭塵境，依師過晚年。"],"s":"trad","f":"simp"},{"i":"b7cf3faf-ef1c-48db-82f6-99bc2ddfabbc","t":"吟敘","a":"周曇","d":"唐","g":"短诗","p":["歷代興亡億萬心，聖人觀古貴知今。","古今成敗無多事，月殿花臺幸一吟。"],"s":"trad","f":"simp"},{"i":"35b0faff-992f-41d0-a4a3-b00784bcfb34","t":"閑吟","a":"周曇","d":"唐","g":"短诗","p":["考摭妍媸用破心，翦裁千古獻當今。","閑吟不是閑吟事，事有閑思閑要吟。"],"s":"trad","f":"simp"},{"i":"5acb2c09-00ec-442b-a39f-8e83ade6609a","t":"唐虞門 唐堯","a":"周曇","d":"唐","g":"短诗","p":["祆氛不起瑞煙輕，端拱垂衣日月明。","傳事四方無外役，茅茨深處土堦平。"],"s":"trad","f":"simp"},{"i":"f86ad4d8-a515-4030-91be-293704881180","t":"唐虞門 虞舜","a":"周曇","d":"唐","g":"短诗","p":["進善懲奸立帝功，功成揖讓益溫恭。","滿朝卿士多元凱，爲黜兜苗與四兇。"],"s":"mixed","f":"simp"},{"i":"246656d3-3a46-430e-b6fd-a8ce60ef9bf3","t":"唐虞門 舜妃","a":"周曇","d":"唐","g":"短诗","p":["蒼梧一望隔重雲，帝子悲尋不記春。","何事淚痕偏在竹，貞姿應念節高人。"],"s":"trad","f":"simp"},{"i":"093748bf-fe6e-4301-99a7-8bd51c2eccaf","t":"唐虞門 再吟","a":"周曇","d":"唐","g":"短诗","p":["瀟湘何代泣幽魂，骨化重泉志尚存。","若道地中休下淚，不應新竹有啼痕。"],"s":"trad","f":"simp"},{"i":"19399c9e-e48a-4a8c-add2-7556ea8f2169","t":"三代門 夏禹","a":"周曇","d":"唐","g":"短诗","p":["堯違天孽賴詢謨，頓免洪波浸碧虛。","海內生靈微伯禹，盡應隨浪化爲魚。"],"s":"mixed","f":"simp"},{"i":"811f6a9c-d8f3-4f84-9226-e4fc8b47b8ad","t":"三代門 再吟","a":"周曇","d":"唐","g":"短诗","p":["萬古龍門一旦開，無成甘死作黃能。","司空定有匡堯術，九載之前何處來。"],"s":"trad","f":"simp"},{"i":"13b7acca-48f9-4a53-afea-0bb85af686de","t":"三代門 太康","a":"周曇","d":"唐","g":"短诗","p":["師保何人爲琢磨，安知父祖苦辛多。","酒酣禽色方爲樂，詎肯閑聽五子歌。"],"s":"mixed","f":"simp"},{"i":"8c0c0124-9ede-4c66-9704-924bf61dcdf7","t":"三代門 后稷","a":"周曇","d":"唐","g":"短诗","p":["人惟邦本本由農，曠古誰高后稷功。","百穀且繁三曜在，牲牢郊祀信無窮。"],"s":"trad","f":"simp"},{"i":"76e6ea54-baf8-4f83-a9d9-4e1eb5bd4f12","t":"三代門 文王","a":"周曇","d":"唐","g":"短诗","p":["昭然明德報天休，禴祭惟馨勝殺牛。","二老五侯何所詐，不歸商受盡歸周。"],"s":"trad","f":"simp"},{"i":"984b76f8-e10e-499e-9e0f-20617a927408","t":"三代門 武王","a":"周曇","d":"唐","g":"短诗","p":["文王寢膳武王隨，內豎言安色始怡。","七載豈堪囚羑里，一夫爲報亦何疑。"],"s":"mixed","f":"simp"},{"i":"3c5fdfab-f430-4d11-ac34-7a1e0304f0d7","t":"三代門 太公","a":"周曇","d":"唐","g":"短诗","p":["昌獵關西紂獵東，紂憐崇虎棄非熊。","危邦自謂多麟鳳，肯把王綱取釣翁。"],"s":"trad","f":"simp"},{"i":"9d76fbbb-4ab7-4fe5-a40b-a0c7850bd7df","t":"三代門 再吟","a":"周曇","d":"唐","g":"短诗","p":["東鄰不事事西鄰，御物卑和物自親。","天下言知天下者，兆人無主屬賢人。"],"s":"trad","f":"simp"},{"i":"c7b9a52e-4625-48b5-957f-a9741ffb77dd","t":"三代門 又吟","a":"周曇","d":"唐","g":"短诗","p":["千妖萬態逞妍姿，破國亡家更是誰。","匡政必能除苟媚，去邪當斷勿狐疑。"],"s":"trad","f":"simp"},{"i":"26f94d29-6753-4938-94ab-dce13656557f","t":"三代門 子牙妻","a":"周曇","d":"唐","g":"短诗","p":["陵柏無心竹變秋，不能同戚擬同休。","歲寒焉在空垂涕，覆水如何欲再收。"],"s":"trad","f":"simp"},{"i":"7d897850-fcae-4af6-b9f1-611d6a8f99b4","t":"三代門 周公","a":"周曇","d":"唐","g":"短诗","p":["文武傳芳百代基，幾多賢哲守成規。","仍聞吐握延儒素，猶恐民疵未盡知。"],"s":"trad","f":"simp"},{"i":"30a542a9-6133-4d5c-bb54-39498fd9be57","t":"三代門 夷齊","a":"周曇","d":"唐","g":"短诗","p":["讓國由衷義亦乖，不知天命匹夫才。","將除暴虐誠能阻，何異崎嶇助紂來。"],"s":"trad","f":"simp"},{"i":"12aa7146-6503-406e-ad47-dd6218c9f547","t":"三代門 管蔡","a":"周曇","d":"唐","g":"短诗","p":["伊商胡越尚同圖，管蔡如何有異謨。","不念祖宗危社稷，強于仁聖遣行誅。"],"s":"mixed","f":"simp"},{"i":"c0708543-def3-40eb-baf5-f17924a73f5d","t":"三代門 成王","a":"周曇","d":"唐","g":"短诗","p":["成王有過伯禽笞，聖惠能新日自奇。","王道既成何所感，越裳呈瑞鳳來儀。"],"s":"trad","f":"simp"},{"i":"204b8f0c-c742-462e-94f5-adad0b1b0d98","t":"三代門 幽王","a":"周曇","d":"唐","g":"短诗","p":["狼煙篝火爲邊塵，烽候那宜悅婦人。","厚德未聞聞厚色，不亡家國幸亡身。"],"s":"mixed","f":"simp"},{"i":"22ff374f-deba-4c5a-b61c-96e399973fa5","t":"三代門 平王","a":"周曇","d":"唐","g":"短诗","p":["犬戎西集殺幽王，邦土何由不便亡。","宜臼東來年更遠，川流難絕信源長。"],"s":"trad","f":"simp"},{"i":"5ac393dd-7f75-472e-a0da-b6e246724eea","t":"春秋戰國門 祭足","a":"周曇","d":"唐","g":"短诗","p":["吳魯燕韓豈別宗，曾無外禦但相攻。","當時周鄭誰爲相，交質將何服遠戎。"],"s":"mixed","f":"simp"},{"i":"e81c7639-f9f2-4967-868c-9bd3f63ee8d8","t":"春秋戰國門 再吟","a":"周曇","d":"唐","g":"短诗","p":["周室衰微不共匡，干戈終日互爭強。","諸侯若解尊天子，列國何因次第亡。"],"s":"trad","f":"simp"},{"i":"dc2e934a-6d91-4849-9d45-167a1d92454b","t":"春秋戰國門 隱公","a":"周曇","d":"唐","g":"短诗","p":["今古難隄是小人，苟希榮寵任相親。","陳謀不信懷憂懼，反間須防却害身。"],"s":"mixed","f":"simp"},{"i":"e0bee03c-c04b-4c8f-9725-cf433a04a23f","t":"春秋戰國門 莊公","a":"周曇","d":"唐","g":"短诗","p":["齊甲強臨力有餘，魯莊爲戰念區區。","魚麗三鼓微曹劌，肉食安能暇遠謨。"],"s":"mixed","f":"simp"},{"i":"bd13166f-d052-420a-bd66-12e907754e10","t":"春秋戰國門 哀公","a":"周曇","d":"唐","g":"短诗","p":["賢爲鄰用國憂危，廟算無非委豔奇。","兩葉翠娥春乍展，一毛須去不難吹。"],"s":"mixed","f":"simp"},{"i":"31319f1a-06c4-441d-a68a-de98bc663a47","t":"春秋戰國門 再吟","a":"周曇","d":"唐","g":"短诗","p":["好龍天爲降真龍，及見真龍瘁厥躬。","接下不勤徒好士，葉公何異魯哀公。"],"s":"mixed","f":"simp"},{"i":"5b8e9657-45ed-46d5-8a0b-f579da9f8f84","t":"春秋戰國門 平公","a":"周曇","d":"唐","g":"短诗","p":["鴻鵠輕騰萬里高，何殊朝野得賢豪。","能知翼戴穹蒼力，不是蒙茸腹背毛。"],"s":"mixed","f":"simp"},{"i":"5033659a-77e0-4e66-bb3f-ce3b09162c67","t":"春秋戰國門 文公","a":"周曇","d":"唐","g":"短诗","p":["滅虢吞虞未息兵，柔秦敗楚霸威成。","文公徒欲三強服，分晉元來是六卿。"],"s":"trad","f":"simp"},{"i":"4c0eb62e-d588-4036-9a56-6e118eeb3e1e","t":"春秋戰國門 景公","a":"周曇","d":"唐","g":"短诗","p":["覺病當宜早問師，病深難療恨難追。","晉侯徒有秦醫緩，疾在膏肓救已遲。"],"s":"trad","f":"simp"},{"i":"608b0b2a-3e65-4a34-bd34-1b78b107c04e","t":"春秋戰國門 衛靈公","a":"周曇","d":"唐","g":"短诗","p":["子魚無隱欲源清，死不忘忠感衛靈。","伯玉既親知德潤，殘桃休喫悟蘭馨。"],"s":"mixed","f":"simp"},{"i":"5a527e4e-6972-4edd-97c3-bf5ce983f0fe","t":"春秋戰國門 陳靈公","a":"周曇","d":"唐","g":"短诗","p":["誰與陳君嫁禍來，孔寧行父夏姬媒。","靈公徒認徴舒面，至死何曾識禍胎。"],"s":"trad","f":"simp"},{"i":"3eb2ee60-69ef-4034-a563-c4ec487cf30c","t":"春秋戰國門 陳蔡君","a":"周曇","d":"唐","g":"短诗","p":["楚聘宣尼欲道光，是時陳蔡畏鄰強。","庸謀但解遮賢路，不解迎賢謀自昌。"],"s":"trad","f":"simp"},{"i":"1e770443-6a95-464e-bfa8-1c5cc8c53013","t":"春秋戰國門 楚惠王","a":"周曇","d":"唐","g":"短诗","p":["芹中遇蛭強爲吞，不欲緣微有害人。","何事免成心腹疾，皇天惟德是相親。"],"s":"mixed","f":"simp"},{"i":"92a6d3a0-914d-4982-a18a-fed6ea83b82d","t":"春秋戰國門 楚懷王","a":"周曇","d":"唐","g":"短诗","p":["不聽陳軫信張儀，六里商於果見欺。","既舍黔中西換得，又令生去益堪悲。"],"s":"trad","f":"simp"},{"i":"25e584a2-98bd-413c-b3c8-6b661b942867","t":"春秋戰國門 再吟","a":"周曇","d":"唐","g":"短诗","p":["不得商於又失齊，楚懷方寸一何迷。","明知秦是虎狼國，更忍車輪獨向西。"],"s":"trad","f":"simp"},{"i":"1f95457b-eca8-458c-8940-e757edf9470a","t":"春秋戰國門 韓惠王","a":"周曇","d":"唐","g":"短诗","p":["韓惠開渠止暴秦，營田萬頃飽秦人。","何殊般肉供羸獸，獸壯安知不害身。"],"s":"trad","f":"simp"},{"i":"55ace381-6f44-4b02-8347-cc439d0ff119","t":"春秋戰國門 頃襄王","a":"周曇","d":"唐","g":"短诗","p":["秦陷荆王死不還，秪緣偏聽子蘭言。","頃襄還信子蘭語，忍使江魚葬屈原。"],"s":"mixed","f":"simp"},{"i":"704d2b78-b094-4113-844e-9792e2def575","t":"春秋戰國門 武公","a":"周曇","d":"唐","g":"短诗","p":["猛獸來兵秪爲文，豈宜涼德擬圖尊。","君看豹彩蒙麋質，人取無難必不存。"],"s":"mixed","f":"simp"},{"i":"51a0432c-08d9-4ec3-9fe7-924380140c5d","t":"春秋戰國門 華元","a":"周曇","d":"唐","g":"短诗","p":["未知軍法忌偏頗，徒解于思腹漫皤。","昔日羊斟曾不預，今朝爲政事如何。"],"s":"mixed","f":"simp"},{"i":"449a8c03-8fcb-410f-b7ca-390ed2602d12","t":"春秋戰國門 臧孫","a":"周曇","d":"唐","g":"短诗","p":["諸孟憎吾似犬獰，賢臧哭孟倍傷情。","季孫愛我如甘疾，疾足亡身藥故寧。"],"s":"trad","f":"simp"},{"i":"3a6729a2-c9bc-45a7-a5a2-e324edba4346","t":"春秋戰國門 公叔","a":"周曇","d":"唐","g":"短诗","p":["吳起南奔魏國荒，必聽公叔失賢良。","無謀縱欲離安邑，可免河溝徙大梁。"],"s":"trad","f":"simp"},{"i":"2521ab0b-cd2a-4a41-8b3b-d5c157729d83","t":"春秋戰國門 莊辛","a":"周曇","d":"唐","g":"短诗","p":["莊辛正諫謂妖詞，兵及鄢陵始悔思。","見兔必能知顧犬，亡羊補棧未爲遲。"],"s":"mixed","f":"simp"},{"i":"82587e00-c82e-4a89-9dbf-d439034df2d3","t":"春秋戰國門 孫臏","a":"周曇","d":"唐","g":"短诗","p":["曾嫌勝己害賢人，鑽火明知速自焚。","斷足爾能行不足，逢君誰肯不酬君。"],"s":"trad","f":"simp"},{"i":"ce907471-05e8-4a83-acae-70ad0ee1f076","t":"春秋戰國門 靈[輒]","a":"周曇","d":"唐","g":"短诗","p":["失水枯鱗得再生，翳桑無地謝深情。","朱輪爲染酬恩血，公子何由見赤誠。"],"s":"mixed","f":"simp"},{"i":"84e7dad7-4cb9-448b-bbb7-d7e543859aa4","t":"春秋戰國門 郭開","a":"周曇","d":"唐","g":"短诗","p":["秦襲邯鄲歲月深，何人沾贈郭開金。","廉頗還國李牧在，安得趙王爲爾擒。"],"s":"mixed","f":"simp"},{"i":"65bc738e-d53f-4baa-9024-714ce6a25c02","t":"春秋戰國門 樂羊","a":"周曇","d":"唐","g":"短诗","p":["桮羹忍啜得非忠，巧佞胡爲惑主聰。","盈篋謗書能寢默，中山不是樂羊功。"],"s":"mixed","f":"simp"},{"i":"9f05d684-2335-4aef-9deb-dec38328bb7b","t":"春秋戰國門 虞卿","a":"周曇","d":"唐","g":"短诗","p":["割地求和國必危，安知堅守絕來思。","年年來伐年年割，割盡韓鄲何所之。"],"s":"trad","f":"simp"},{"i":"6179a728-52b3-45f9-884d-c97e42305dc0","t":"春秋戰國門 豫讓","a":"周曇","d":"唐","g":"短诗","p":["門客家臣義莫儔，漆身吞炭不能休。","中行智伯思何異，國士終期國士酬。"],"s":"trad","f":"simp"},{"i":"b02b80ac-caf6-4f52-bb43-ab491108ad34","t":"春秋戰國門 毛遂","a":"周曇","d":"唐","g":"短诗","p":["不識囊中頴脫錐，功成方信有英奇。","平原門下三千客，得力何曾是素知。"],"s":"trad","f":"simp"},{"i":"7bc113e9-7c38-4429-a9ad-eff7e88483da","t":"春秋戰國門 再吟","a":"周曇","d":"唐","g":"短诗","p":["定獲英奇不在多，然須設網遍山河。","禽雖一目羅中得，豈可空張一目羅。"],"s":"trad","f":"simp"},{"i":"1959138b-5885-46ef-8843-7833bfb71d78","t":"春秋戰國門 田文","a":"周曇","d":"唐","g":"短诗","p":["下客常才不足珍，誰爲狗盜脫強秦。","秦關若待雞鳴出，笑殺臨淄土偶人。"],"s":"mixed","f":"simp"},{"i":"33abfaee-72d6-4ebe-a17d-1cc30f6ddba5","t":"春秋戰國門 再吟","a":"周曇","d":"唐","g":"短诗","p":["門下三千各自矜，頻彈劍客獨無能。","田文不厭無能客，三窟全身果有憑。"],"s":"trad","f":"simp"},{"i":"4d0328d2-9a89-40a5-bf72-987c5820211b","t":"春秋戰國門 馮讙","a":"周曇","d":"唐","g":"短诗","p":["兔窟穿成主再興，輩流狐伏敢驕矜。","馮讙不是無能者，要試君心欲展能。"],"s":"trad","f":"simp"},{"i":"f0ee59ad-9ce7-403d-b015-da0547999e15","t":"春秋戰國門 章子","a":"周曇","d":"唐","g":"短诗","p":["在家能子必能臣，齊將功成以孝聞。","改葬義無欺死父，臨戎安肯背生君。"],"s":"trad","f":"simp"},{"i":"c8a7294f-1830-4952-bfda-248d57e5b38a","t":"春秋戰國門 卞和","a":"周曇","d":"唐","g":"短诗","p":["磷磷誰爲惑溫溫，至寶凡姿甚易分。","自是時人多貴耳，目無明鑒使俱焚。"],"s":"mixed","f":"simp"}]