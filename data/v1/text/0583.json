[{"i":"c-b28c02817f20","t":"愁倚阑令・春光好","a":"晏几道","d":"宋","g":"词","p":["春罗薄，酒醒寒。","梦初残。","敧枕片时云雨事，已关山。","楼上斜日阑干。","楼前路、曾试雕鞍。","拼却一襟怀远泪，倚阑看。"]},{"i":"c-00ca8cc8a9e0","t":"御街行","a":"晏几道","d":"宋","g":"词","p":["年光正似花梢露。","弹指春还暮。","翠眉仙子望归来，倚遍玉城珠树。","岂知别后，好风良月，往事无寻处。","狂情错向红尘住。","忘了瑶台路。","碧桃花蕊已应开，欲伴彩云飞去。","回思十载，朱颜青鬓，枉被浮名误。"]},{"i":"c-8b68a1044f60","t":"浪淘沙","a":"晏几道","d":"宋","g":"词","p":["高阁对横塘。","新燕年光。","柳花残梦隔潇湘。","绿浦归帆看不见，还是斜阳。","一笑解愁肠。","人会娥妆。","藕丝衫袖郁金香。","曳雪牵云留客醉，且伴春狂。"]},{"i":"c-cf60205ba421","t":"浪淘沙","a":"晏几道","d":"宋","g":"词","p":["小绿间长红。","露蕊烟丛。","花开花落昔年同。","惟恨花前携手处，往事成空。","山远水重重。","一笑难逢。","已拼长在别离中。","霜鬓知他从此去，几度春风。"]},{"i":"c-c2ed9132659f","t":"浪淘沙","a":"晏几道","d":"宋","g":"词","p":["丽曲醉思仙。","十二哀弦。","秾蛾叠柳脸红莲。","多少雨条烟叶恨，红泪离筵。","行子惜流年。","鹈鴂枝边。","吴堤春水舣兰船。","南去北来今渐老，难负尊前。"]},{"i":"c-40fe673c6a8e","t":"浪淘沙","a":"晏几道","d":"宋","g":"词","p":["翠幕绮筵张。","淑景难忘。","阳关声巧绕雕梁。","美酒十分谁与共，玉指持觞。","晓枕梦高唐。","略话衷肠。","小山池院竹风凉。","明夜月圆帘四卷，今夜思量。"]},{"i":"c-387cf93f15ab","t":"丑奴儿・采桑子","a":"晏几道","d":"宋","g":"词","p":["昭华凤管知名久。","长闭帘栊。","日日春慵。","闲倚庭花晕脸红。","应说金谷无人后，此会相逢。","三弄临风。","送得当筵玉盏空。"]},{"i":"c-36c85c3e043e","t":"丑奴儿・采桑子","a":"晏几道","d":"宋","g":"词","p":["日高庭院杨花转，闲淡春风。","莺语惺忪。","似笑金屏昨夜空。","娇慵未洗匀妆手，闲印斜红。","新恨重重。","都与年时旧意同。"]},{"i":"c-74e7c8dbdd6f","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["种花人自蕊宫来。","牵衣问小梅。","今年芳意何似，应向旧枝开。","凭寄语，谢瑶台。","客无才。","粉香传信，玉盏开筵，莫待春回。"]},{"i":"c-fd76db134c6c","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["净揩妆脸浅匀眉。","衫子素梅儿。","苦无心绪梳洗，闲淡也相宜。","云态度，柳腰肢。","入相思。","夜来月底，今日尊前，未当佳期。"]},{"i":"c-db802aca2a81","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["渚莲霜晓坠残红。","依约旧秋同。","玉人团扇恩浅，一意恨西风。","云去住，月朦胧。","夜寒浓。","此时还是，泪墨书成，未有归鸿。"]},{"i":"c-982cd74ad992","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["凭觞静忆去年秋，桐落故溪头。","诗成自写红叶，和恨寄东流。","人脉脉，水悠悠。","几多愁。","雁书不到，蝶梦无凭，漫倚高楼。"]},{"i":"c-2d1b2efad096","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["小梅风韵最妖娆。","开处雪初消。","南枝欲附春信，长恨陇人遥。","闲记忆，旧江皋。","路迢迢。","暗香浮动，疏影横斜，几处溪桥。"]},{"i":"c-9314dae2d6f0","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["长因蕙草记罗裙。","绿腰沈水熏。","阑干曲处人静，曾共倚黄昏。","风有韵，月无痕。","暗消魂。","拟将幽恨，试写残花，寄与朝云。"]},{"i":"c-cc87d1178bd8","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["御纱新制石榴裙。","沈香慢火熏。","越罗双带宫样，飞鹭碧波纹。","随锦字，叠香痕。","寄文君。","系来花下，解向尊前，谁伴朝云。"]},{"i":"c-7882d330abac","t":"诉衷情","a":"晏几道","d":"宋","g":"词","p":["都人离恨满歌筵。","清唱倚危弦。","星屏别后千里，更见是何年。","骢骑稳，绣衣鲜。","欲朝天。","北人欢笑，南国悲凉，迎送金鞭。"]},{"i":"c-991ef3cfc9e0","t":"破阵子","a":"晏几道","d":"宋","g":"词","p":["柳下笙歌庭院，花间姊妹秋千。","记得春楼当日事，写向红窗夜月前。","凭谁寄小莲。","绛蜡等闲陪泪，吴蚕到了缠绵。","绿鬓能供多少恨，未肯无情比断弦。","今年老去年。"]},{"i":"c-4762ef34c6e4","t":"好女儿","a":"晏几道","d":"宋","g":"词","p":["绿遍西池。","梅子青时。","尽无端、尽日东风恶，更霏微细雨，恼人离恨，满路春泥。","应是行云归路，有闲泪、洒相思。","想旗亭、望断黄昏月，又依前误了，红笺香信，翠袖欢期。"]},{"i":"c-10a0ae0eecda","t":"好女儿","a":"晏几道","d":"宋","g":"词","p":["酌酒殷勤。","尽更留春。","忍无情、便赋馀花落，待花前细把、一春心事，问个人人。","莫似花开还谢，愿芳意、且长新。","倚娇红、待得欢期定，向水沈烟底，金莲影下，睡过佳辰。"]},{"i":"c-cc32f3b7811e","t":"点绛唇","a":"晏几道","d":"宋","g":"词","p":["花信来时，恨无人似花依旧。","又成春瘦。","折断门前柳。","天与多情，不与长相守。","分飞后。","泪痕和酒。","占了双罗袖。"]},{"i":"c-5f1cd922dc56","t":"点绛唇","a":"晏几道","d":"宋","g":"词","p":["明日征鞭，又将南陌垂杨折。","自怜轻别。","拼得音尘绝。","杏子枝边，倚处阑干月。","依前缺。","去年时节。","旧事无人说。"]},{"i":"c-843cd6985a20","t":"点绛唇","a":"晏几道","d":"宋","g":"词","p":["碧水东流，漫题凉叶津头寄。","谢娘春意。","临水颦双翠。","日日骊歌，空费行人泪。","成何计。","未如浓醉。","闲掩红楼睡。"]},{"i":"c-d1cfb02f57c9","t":"点绛唇","a":"晏几道","d":"宋","g":"词","p":["妆席相逢，旋匀红泪歌金缕。","意中曾许。","欲共吹花去。","长爱荷香，柳色殷桥路。","留人住。","淡烟微雨。","好个双栖处。"]},{"i":"c-e9294ee184c4","t":"点绛唇","a":"晏几道","d":"宋","g":"词","p":["湖上西风，露花啼处秋香老。","谢家春草。","唱得清商好。","笑倚兰舟，转尽新声了。","烟波渺。","暮云稀少。","一点凉蟾小。"]},{"i":"c-c207edd608ab","t":"两同心","a":"晏几道","d":"宋","g":"词","p":["楚乡春晚，似入仙源。","拾翠处、闲随流水，踏青路、暗惹香尘。","心心在，柳外青帘，花下朱门。","对景且醉芳尊。","莫话消魂。","好意思、曾同明月，恶滋味、最是黄昏。","相思处，一纸红笺，无限啼痕。"]},{"i":"c-cd598a25ee15","t":"少年游","a":"晏几道","d":"宋","g":"词","p":["绿勾阑畔，黄昏淡月，携手对残红。","纱窗影里，朦腾春睡，繁杏小屏风。","须愁别后，天高海阔，何处更相逢。","幸有花前，一杯芳酒，欢计莫匆匆。"]},{"i":"c-54c26ce716d1","t":"少年游","a":"晏几道","d":"宋","g":"词","p":["西溪丹杏，波前媚脸，珠露与深匀。","南楼翠柳，烟中愁黛，丝雨恼娇颦。","当年此处，闻歌殢酒，曾对可怜人。","今夜相思，水长山远，闲卧送残春。"]},{"i":"c-8c43f231c892","t":"少年游","a":"晏几道","d":"宋","g":"词","p":["离多最是，东西流水，终解两相逢。","浅情终似，行云无定，犹到梦魂中。","可怜人意，薄於云水，佳会更难重。","细想从来，断肠多处，不与者番同。"]},{"i":"c-68dc6973cb57","t":"少年游","a":"晏几道","d":"宋","g":"词","p":["西楼别后，风高露冷，无奈月分明。","飞鸿影里，捣衣砧外，总是玉关情。","王孙此际，山重水远，何处赋西征。","金闺魂梦枉丁宁。","寻尽短长亭。"]},{"i":"c-f7c2480cebd7","t":"少年游","a":"晏几道","d":"宋","g":"词","p":["雕梁燕去，裁诗寄远，庭院旧风流。","黄花醉了，碧梧题罢，闲卧对高秋。","繁云破后，分明素月，凉影挂金钩。","有人凝澹倚西楼。","新样两眉愁。"]},{"i":"c-97b5f8ecc5b7","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["闲敲玉镫隋堤路。","一笑开朱户。","素云凝澹月婵娟。","门外鸭头春水、木兰船。","吹花拾蕊嬉游惯。","天与相逢晚。","一声长笛倚楼时。","应恨不题红叶、寄相思。"]},{"i":"c-0f348ab0dac2","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["飞花自有牵情处。","不向枝边坠。","随风飘荡已堪愁。","更伴东流流水、过秦楼。","楼中翠黛含春怨。","闲倚阑干见。","远弹双泪惜香红。","暗恨玉颜光景、与花同。"]},{"i":"c-f9b976279536","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["疏梅月下歌金缕。","忆共文君语。","更谁情浅似春风。","一夜满枝新绿、替残红。","苹香已有莲开信。","两桨佳期近。","采莲时节定来无。","醉后满身花影、倩人扶。"]},{"i":"c-0dd6d8ba7ae6","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["玉箫吹遍烟花路。","小谢经年去。","更教谁画远山眉。","又是陌头风细、恼人时。","时光不解年年好。","叶上秋声早。","可怜蝴蝶易分飞。","只有杏梁双燕、每来归。"]},{"i":"c-4b6e4ce61540","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["秋风不似春风好。","一夜金英老。","更谁来凭曲阑干。","惟有雁边斜月、照关山。","双星旧约年年在。","笑尽人情改。","有期无定是无期。","说与小云新恨、也低眉。"]},{"i":"c-082cc3462029","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["小梅枝上东君信。","雪后花期近。","南枝开尽北枝开。","长被陇头游子、寄春来。","年年衣袖年年泪。","总为今朝意。","问谁同是忆花人。","赚得小鸿眉黛、也低颦。"]},{"i":"c-746e787a1ddf","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["湿红笺纸回纹字。","多少柔肠事。","去年双燕欲归时。","还是碧云千里、锦书迟。","南楼风月长依旧。","别恨无端有。","倩谁横笛倚危阑。","今夜落梅声里、怨关山。"]},{"i":"c-9101ddb565e5","t":"虞美人","a":"晏几道","d":"宋","g":"词","p":["一弦弹尽仙韶乐。","曾破千金学。","玉楼银烛夜深深。","愁见曲中双泪、落香襟。","从来不奈离声怨。","几度朱弦断。","未知谁解赏新音。","长是好风明月、暗知心。"]},{"i":"c-71f23acf34ec","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["秋千散后朦胧月，满院人闲。","几处雕阑。","一夜风吹杏粉残。","昭阳殿里春衣就，金缕初乾。","莫信朝寒。","明日花前试舞看。"]},{"i":"c-56fe5812c48e","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["花前独占春风早，长爱江梅。","秀艳清杯。","芳意先愁凤管催。","寻香已落闲人后，此恨难裁。","更晚须来。","却恐初开胜未开。"]},{"i":"c-fa42fd777fd8","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["芦鞭坠遍杨花陌，晚见珍珍。","疑是朝云。","来作高唐梦里人。","应怜醉落楼中帽，长带歌尘。","试拂香茵。","留解金鞍睡过春。"]},{"i":"c-5ceb1aee907a","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["日高庭院杨花转，闲淡春风。","昨夜匆匆。","颦入遥山翠黛中。","金盆水冷菱花净，满面残红。","欲洗犹慵。","弦上啼乌此夜同。"]},{"i":"c-f9ed674aba6d","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["征人去日殷勤嘱，莫负心期。","寒雁来时。","第一传书慰别离。","轻春织就机中素，泪墨题诗。","欲寄相思。","日日高楼看雁飞。"]},{"i":"c-a4280a348fee","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["花时恼得琼枝瘦，半被残香。","睡损梅妆。","红泪今春第一行。","风流笑伴相逢处，白马游缰。","共折垂杨。","手拈芳条说夜长。"]},{"i":"c-67a4743099b2","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["春风不负年年信，长趁花期。","小锦堂西。","红杏初开第一枝。","碧箫度曲留人醉，昨夜归迟。","短恨凭谁。","莺语殷勤月落时。"]},{"i":"c-dae089b12ff4","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["秋来更觉消魂苦，小字还稀。","坐想行思。","怎得相看似旧时。","南楼把手凭肩处，风月应知。","别后除非。","梦里时时得见伊。"]},{"i":"c-40ffd1f01b1a","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["谁将一点凄凉意，送入低眉。","画箔闲垂。","多是今宵得睡迟。","夜痕记尽窗间月，曾误心期。","准拟相思。","还是窗间记月时。"]},{"i":"c-8cbf1d83b6c8","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["宜春苑外楼堪倚，雪意方浓。","雁影冥濛。","正共银屏小景同。","可无人解相思处，昨夜东风。","梅蕊应红。","知在谁家锦字中。"]},{"i":"c-ccc42d6130b7","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["白莲池上当时月，今夜重圆。","曲水兰船。","忆伴飞琼看月眠。","黄花绿酒分携后，泪湿吟笺。","旧事年年。","时节南湖又采莲。"]},{"i":"c-ad119c1ebe2b","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["高吟烂醉淮西月，诗酒相留。","明日归舟。","碧藕花中醉过秋。","文姬赠别双团扇，自写银钩。","散尽离愁。","携得清风出画楼。"]},{"i":"c-e69b33c1b954","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["前欢几处笙歌地，长负登临。","月幌风襟。","犹忆西楼著意深。","莺花见尽当时事，应笑如今。","一寸愁心。","日日寒蝉夜夜砧。"]},{"i":"c-99b3feae16c4","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["无端恼破桃源梦，明日青楼。","玉腻花柔。","不学行云易去留。","应嫌衫袖前香冷，重傍金虬。","歌扇风流。","遮尽归时翠黛愁。"]},{"i":"c-1eaeaf1e1cd5","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["年年此夕东城见，欢意匆匆。","明日还重。","却在楼台缥缈中。","垂螺拂黛清歌女，曾唱相逢。","秋月春风。","醉枕香衾一岁同。"]},{"i":"c-62188ffe6ce2","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["双螺未学同心绾，已占歌名。","月白风清。","长倚昭华笛里声。","知音敲尽朱颜改，寂寞时情。","一曲离亭。","惜与青楼忍泪听。"]},{"i":"c-7638f0d0c30e","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["西楼月下当时见，泪粉偷匀。","歌罢还颦。","恨隔炉烟看未真。","别来楼外垂杨缕，几换青春。","倦客红尘。","长记楼中粉泪人。"]},{"i":"c-6853206ac6db","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["非花非雾前时见，满眼娇春。","浅笑微颦。","恨隔垂帘看未真。","殷勤借问家何处，不在红尘。","若是朝云。","宜作今宵梦里人。"]},{"i":"c-7c47713d137f","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["当时月下分飞处，依旧凄凉。","也会思量。","不道孤眠夜更长。","泪痕搵遍鸳鸯枕，重绕回廊。","月上东窗。","长到如今欲断肠。"]},{"i":"c-ef3c6cc5e7ff","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["湘妃浦口莲开尽，昨夜红稀。","懒过前溪。","闲舣扁舟看雁飞。","去年谢女池边醉，晚雨霏微。","记得归时。","旋折新荷盖舞衣。"]},{"i":"c-b283c2b65e6b","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["别来长记西楼事，结遍兰襟。","遗恨重寻。","弦断相如绿绮琴。","何时一枕逍遥夜，细话初心。","若问如今。","也似当时著意深。"]},{"i":"c-c9e1df3976ad","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["红窗碧玉新名旧，犹绾双螺。","一寸秋波。","千斛明珠觉未多。","小来竹马同游客，惯听清歌。","今日蹉跎。","恼乱工夫晕翠蛾。"]},{"i":"c-8a9457c168da","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["昭华凤管知名久，长闭帘栊。","闻道春慵。","方倚庭花晕脸红。","可怜金谷无人后，此会相逢。","三弄临风。","送得当筵玉盏空。"]},{"i":"c-8ae3ca777540","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["金风玉露初凉夜，秋草窗前。","浅醉闲眠。","一枕江风梦不圆。","长情短恨难凭寄，枉费红笺。","试拂么弦。","却恐琴心可暗传。"]},{"i":"c-5e5d88d35973","t":"采桑子","a":"晏几道","d":"宋","g":"词","p":["心期昨夜寻思遍，犹负殷勤。","齐斗堆金。","难买丹诚一寸真。","须知枕上尊前意，占得长春。","寄语东邻。","似此相看有几人。"]},{"i":"c-7ea7a973ee18","t":"踏莎行","a":"晏几道","d":"宋","g":"词","p":["柳上烟归，池南雪尽。","东风渐有繁华信。","花开花谢蝶应知，春来春去莺能问。","梦意犹疑，心期欲近。","云笺字字萦方寸。","宿妆曾比杏腮红，忆人细把香英认。"]},{"i":"c-4715cce9069c","t":"踏莎行","a":"晏几道","d":"宋","g":"词","p":["宿雨收尘，朝霞破暝。","风光暗许花期定。","玉人呵手试妆时，粉香帘幕阴阴静。","斜雁朱弦，孤鸾绿镜。","伤春误了寻芳兴。","去年今日杏墙西，啼莺唤得闲愁醒。"]},{"i":"c-021c1e2be46d","t":"踏莎行","a":"晏几道","d":"宋","g":"词","p":["绿径穿花，红楼压水。","寻芳误到蓬莱地。","玉颜人是蕊珠仙，相逢展尽双蛾翠。","梦草闲眠，流觞浅醉。","一春总见瀛洲事。","别来双燕又西飞，无端不寄相思字。"]},{"i":"c-5f31b440dbde","t":"踏莎行","a":"晏几道","d":"宋","g":"词","p":["雪尽寒轻，月斜烟重。","清欢犹记前时共。","迎风朱户背灯开，拂檐花影侵帘动。","绣枕双鸳，香苞翠凤。","从来往事都如梦。","伤心最是醉归时，眼前少个人人送。"]},{"i":"c-9bbfa2a81774","t":"满庭芳","a":"晏几道","d":"宋","g":"词","p":["南苑吹花，西楼题叶，故园欢事重重。","凭阑秋思，闲记旧相逢。","几处歌云梦雨，可怜便、流水西东。","别来久，浅情未有，锦字系征鸿。","年光还少味，开残槛菊，落尽溪桐。","漫留得，尊前淡月西风。","此恨谁堪共说，清愁付、绿酒杯中。","佳期在，归时待把，香袖看啼红。"]},{"i":"c-445cc32104a7","t":"留春令","a":"晏几道","d":"宋","g":"词","p":["采莲舟上，夜来陡觉，十分秋意。","懊恼寒花暂时香，与情浅、人相似。","玉蕊歌清招晚醉。","恋小桥风细。","水湿红裙酒初消，又记得、南溪事。"]},{"i":"c-ed6360ebf53b","t":"留春令","a":"晏几道","d":"宋","g":"词","p":["海棠风横，醉中吹落，香红强半。","小粉多情怨花飞，仔细把、残香看。","一抹浓檀秋水畔。","缕金衣新换。","鹦鹉杯深艳歌迟，更莫放、人肠断。"]},{"i":"c-8e2eacfa58ea","t":"风入松","a":"晏几道","d":"宋","g":"词","p":["柳阴庭院杏梢墙。","依旧巫阳。","凤箫已远青楼在，水沈谁、复暖前香。","临镜舞鸾离照，倚筝飞雁辞行。","坠鞭人意自凄凉。","泪眼回肠。","断云残雨当年事，到如今、几处难忘。","两袖晓风花陌，一帘夜月兰堂。"]},{"i":"c-d1c17cef9513","t":"风入松","a":"晏几道","d":"宋","g":"词","p":["心心念念忆相逢。","别恨谁浓。","就中懊恼难拼处，是擘钗、分钿匆匆。","却似桃源路失，落花空记前踪。","彩笺书尽浣溪红。","深意难通。","强欢殢酒图消遣，到醒来、愁闷还重。","若是初心未改，多应此意须同。"]},{"i":"c-cda724c79926","t":"清商怨","a":"晏几道","d":"宋","g":"词","p":["庭花香信尚浅。","最玉楼先暖。","梦觉春衾，江南依旧远。","回纹锦字暗翦。","漫寄与、也应归晚。","要问相思，天涯犹自短。"]},{"i":"c-1c233a645dd1","t":"秋蕊香","a":"晏几道","d":"宋","g":"词","p":["池苑清阴欲就。","还傍送春时候。","眼中人去难欢偶。","谁共一杯芳酒。","朱阑碧砌皆如旧。","记携手。","有情不管别离久。","情在相逢终有。"]},{"i":"c-966f361c2c8a","t":"秋蕊香","a":"晏几道","d":"宋","g":"词","p":["歌彻郎君秋草。","别恨远山眉小。","无情莫把多情恼。","第一归来须早。","红尘自古长安道。","故人少。","相思不比相逢好。","此别朱颜应老。"]},{"i":"c-e90b7747d56c","t":"碧牡丹","a":"晏几道","d":"宋","g":"词","p":["翠袖疏纨扇。","凉叶催归燕。","一夜西风，几处伤高怀远。","细菊枝头，开嫩香还遍。","月痕依旧庭院。","事何限。","怅望秋意晚。","离人鬓华将换。","静忆天涯，路比此情犹短。","试约鸾笺，传素期良愿。","南云应有新雁。"]},{"i":"c-e3e82dea7556","t":"长相思","a":"晏几道","d":"宋","g":"词","p":["长相思。","长相思。","若问相思甚了期。","除非相见时。","长相思。","长相思。","欲把相思说似谁。","浅情人不知。"]},{"i":"c-a915999e9a97","t":"醉落魄・一斛珠","a":"晏几道","d":"宋","g":"词","p":["满街斜月。","垂鞭自唱阳关彻。","断尽柔肠思归切。","都为人人，不许多时别。","南桥昨夜风吹雪。","短长亭下征尘歇。","归时定有梅堪折。","欲把离愁，细拈花枝说。"]},{"i":"c-425134f16f46","t":"醉落魄・一斛珠","a":"晏几道","d":"宋","g":"词","p":["鸾孤月缺。","两春惆怅音尘绝。","如今若负当时节。","信道欢缘，狂向衣襟结。","若问相思何处歇。","相逢便是相思彻。","尽饶别后留心别。","也待相逢，细把相思说。"]},{"i":"c-9e46a6438259","t":"醉落魄・一斛珠","a":"晏几道","d":"宋","g":"词","p":["天教命薄。","青楼占得声名恶。","对酒当歌寻思著。","月户星窗，多少旧期约。","相逢细语初心错。","两行红泪尊前落。","霞觞且共深深酌。","恼乱春宵，翠被都闲却。"]},{"i":"c-6c998a17fdf6","t":"醉落魄・一斛珠","a":"晏几道","d":"宋","g":"词","p":["休休莫莫。","离多还是因缘恶。","有情无奈思量著。","月夜佳期，近写青笺约。","心心口口长恨昨。","分飞容易当时错。","后期休似前欢薄。","买断青楼，莫放春闲却。"]},{"i":"c-d08397bfe405","t":"望仙楼・胡捣练","a":"晏几道","d":"宋","g":"词","p":["小春花信日边来，未上江楼先坼。","今岁东君消息。","还自南枝得。","素衣染尽天香，玉酒添成国色。","一自故溪疏隔。","肠断长相忆。"]},{"i":"c-46b5ca58876a","t":"凤孤飞","a":"晏几道","d":"宋","g":"词","p":["一曲画楼钟动，宛转歌声缓。","绮席飞尘满。","更少待、金蕉暖。","细雨轻寒今夜短。","依前是、粉墙别馆。","端的欢期应未晚。","奈归云难管。"]},{"i":"c-196c9b600df9","t":"西江月","a":"晏几道","d":"宋","g":"词","p":["愁黛颦成月浅，啼妆印得花残。","只消鸳枕夜来闲。","晓镜心情便懒。","醉帽檐头风细，征衫袖口香寒。","绿江春水寄书难。","携手佳期又晚。"]},{"i":"c-86e894ed57eb","t":"西江月","a":"晏几道","d":"宋","g":"词","p":["南苑垂鞭路冷，西楼把袂人稀。","庭花犹有鬓边枝。","且插残红自醉。","画幕凉催燕去，香屏晓放云归。","依前青枕梦回时。","试问闲愁有几。"]},{"i":"c-501531c51518","t":"武陵春","a":"晏几道","d":"宋","g":"词","p":["绿蕙红兰芳信歇，金蕊正风流。","应为诗人多怨秋。","花意与消愁。","梁王苑路香英密，长记旧嬉游。","曾看飞琼戴满头。","浮动舞梁州。"]},{"i":"c-608079880e9e","t":"武陵春","a":"晏几道","d":"宋","g":"词","p":["九日黄花如有意，依旧满珍丛。","谁似龙山秋兴浓。","吹帽落西风。","年年岁岁登高节，欢事旋成空。","几处佳人此会同。","今在泪痕中。"]},{"i":"c-e7eb7578c4b1","t":"武陵春","a":"晏几道","d":"宋","g":"词","p":["烟柳长堤知几曲，一曲一魂消。","秋水无情天共遥。","愁送木兰桡。","熏香绣被心情懒，期信转迢迢。","记得来时倚画桥。","红泪满鲛绡。"]},{"i":"c-70af7a3ad3f8","t":"解佩令","a":"晏几道","d":"宋","g":"词","p":["玉阶秋感，年华暗去。","掩深宫、团扇无绪。","记得当时，自翦下、机中轻素。","点丹青、画成秦女。","凉襟犹在，朱弦未改，忍霜纨、飘零何处。","自古悲凉，是情事、轻如云雨。","倚么弦、恨长难诉。"]},{"i":"c-e9b627348b36","t":"行香子","a":"晏几道","d":"宋","g":"词","p":["晚绿寒红。","芳意匆匆。","惜年华、今与谁同。","碧云零落，数字征鸿。","看渚莲凋，宫扇旧，怨秋风。","流波坠叶，佳期何在，想天教、离恨无穷。","试将前事，闲倚梧桐。","有消魂处，明月夜，粉屏空。"]},{"i":"c-02ec0dee61a4","t":"庆春时","a":"晏几道","d":"宋","g":"词","p":["倚天楼殿，升平风月，彩仗春移。","鸾丝凤竹，长生调里，迎得翠舆归。","雕鞍游罢，何处还有心期。","浓熏翠被，深停画烛，人约月西时。"]},{"i":"c-53a764b5e4b9","t":"庆春时","a":"晏几道","d":"宋","g":"词","p":["梅梢已有，春来音信，风意犹寒。","南楼暮雪，无人共赏，闲却玉阑干。","殷勤今夜，凉月还似眉弯。","尊前为把，桃根丽曲，重倚四弦看。"]},{"i":"c-488bf8122161","t":"喜团圆","a":"晏几道","d":"宋","g":"词","p":["危楼静锁，窗中远岫，门外垂杨。","珠帘不禁春风度，解偷送馀香。","眠思梦想，不如双燕，得到兰房。","别来只是，凭高泪眼，感旧离肠。"]},{"i":"c-ed6abf0519c7","t":"忆闷令","a":"晏几道","d":"宋","g":"词","p":["取次临鸾匀画浅。","酒醒迟来晚。","多情爱惹闲愁，长黛眉低敛。","月底相逢花下见。","有深深良愿。","愿期信、似月如花，须更教长远。"]},{"i":"c-ebaf076c6cd5","t":"梁州令","a":"晏几道","d":"宋","g":"词","p":["莫唱阳关曲。","泪湿当年金缕。","离歌自古最消魂，闻歌更在魂消处。","南楼杨柳多情绪。","不系行人住。","人情却似飞絮。","悠扬便逐春风去。"]},{"i":"c-8ab11918a71a","t":"燕归梁","a":"晏几道","d":"宋","g":"词","p":["莲叶雨，蓼花风。","秋恨几枝红。","远烟收尽水溶溶。","飞雁碧云中。","衷肠事。","鱼笺字。","情绪年年相似。","凭高双袖晚寒浓。","人在月桥东。"]},{"i":"c-52db148ed33c","t":"胡捣练","a":"晏几道","d":"宋","g":"词","p":["小亭初报一枝梅，惹起江南归兴。","遥想玉溪风景，水漾横斜影。","异香直到醉乡中，醉后还因香醒。","好是玉容相并。","人与花争莹。"]},{"i":"c-3e84bd61c71e","t":"扑蝴蝶","a":"晏几道","d":"宋","g":"词","p":["风梢雨叶，绿遍江南岸。","思归倦客，寻芳来最晚。","酒边红日初长，陌上飞花正满。","凄凉数声弦管。","怨春短。","玉人应在，明月楼中画眉懒。","鱼笺锦字，多时音信断。","恨如去水空长，事与行云渐远。","罗衾旧香馀暖。"]},{"i":"c-add7b9bb5332","t":"丑奴儿・采桑子","a":"晏几道","d":"宋","g":"词","p":["夜来酒醒清无梦，愁倚阑干。","露滴轻寒。","雨打芙蓉泪不乾。","佳人别后音尘悄，瘦尽难拼。","明月无端。","已过红楼十二间。"]},{"i":"c-94adc1e02c2f","t":"谒金门","a":"晏几道","d":"宋","g":"词","p":["溪声急。","无数落花漂出。","燕子分泥蜂酿蜜。","迟迟艳风日。","须信芳菲随失。","况复佳期难必。","拟把此情书万一。","愁多翻阁笔。"]}]