[{"i":"c-18e65aaf6f45","t":"双","a":"朱敦儒","d":"宋","g":"词","p":["拂破秋江烟碧。","一对双飞鸂鶒。","应是远来无力。","捎下相偎沙碛。","小艇谁吹横笛。","惊起不知消息。","悔不当时描得。","如今何处寻觅。"]},{"i":"c-9e8676ca7eb2","t":"鼓笛令","a":"朱敦儒","d":"宋","g":"词","p":["纸帐绸衾忒暖。","尽自由、横翻倒转。","睡觉西窗灯一盏。","恰听打、三更三点。","残梦不须深念。","这些个、光阴煞短。","解散缰绳休系绊。","把从前、一笔句断。"]},{"i":"c-573b68a51e10","t":"西湖曲・玉楼春","a":"朱敦儒","d":"宋","g":"词","p":["今冬寒早风光好。","休怪搀先敧絮帽。","蟹肥一个可称斤，酒美三杯真合道。","年年闲梦垂垂了。","且喜风松吹不倒。","平分两月是新春，却共梅花依旧笑。"]},{"i":"c-454fa7570f59","t":"风蝶令・南歌子","a":"朱敦儒","d":"宋","g":"词","p":["试看何时有，元来总是空。","丹砂只在酒杯中。","看取乃公双颊、照人红。","花外庄周蝶，松间御寇风。","古人漫尔说西东。","何似自家识取、卖油翁。"]},{"i":"c-671ceea2a7f4","t":"谒金门","a":"朱敦儒","d":"宋","g":"词","p":["春怎恋。","楼外绿催红殿。","短袖迎风愁半卷。","手寒无处暖。","目断蓬莱宫殿。","引去谁怜谁怨。","相见不如青翅燕。","举头长安远。"]},{"i":"c-25adde819fa9","t":"洛妃怨・昭君怨","a":"朱敦儒","d":"宋","g":"词","p":["拾翠当年延伫。","解佩感君诚素。","微步过南冈。","献明珰。","襟上泪难再会。","惆怅幽兰心事。","心事永难忘。","寄君王。"]},{"i":"c-5e4de557e904","t":"燕归梁","a":"朱敦儒","d":"宋","g":"词","p":["帐掩秋风一半开。","闲将玉笛吹。","过云微雨散轻雷。","夜参差、认楼台。","暗香移枕新凉住，竹外漏声催。","放教明月上床来。","共清梦、两徘徊。"]},{"i":"c-af8028c95301","t":"相见欢","a":"朱敦儒","d":"宋","g":"词","p":["泷州几番清秋。","许多愁。","叹我等闲白了、少年头。","人间事。","如何是。","去来休。","自是不归归去、有谁留。"]},{"i":"c-e5e2e17ad8cd","t":"相见欢","a":"朱敦儒","d":"宋","g":"词","p":["东风吹尽江梅。","橘花开。","旧日吴王宫殿、长青苔。","今古事。","英雄泪。","老相催。","长恨夕阳西去、晚潮回。"]},{"i":"c-101dd07fb61f","t":"相见欢","a":"朱敦儒","d":"宋","g":"词","p":["金陵城上西楼。","倚清秋。","万里夕阳垂地、大江流。","中原乱。","簪缨散。","几时收。","试倩悲风吹泪、过扬州。"]},{"i":"c-63d0c9d76243","t":"相见欢","a":"朱敦儒","d":"宋","g":"词","p":["秋风又到人间。","叶珊珊。","四望烟波无尽、欠青山。","浮生事。","长江水。","几时闲。","幸是古来如此、且开颜。"]},{"i":"c-ae8caa99176c","t":"相见欢","a":"朱敦儒","d":"宋","g":"词","p":["吟蛩作尽秋声。","月西沈。","凄断馀香残梦、下层城。","人不见。","屏空掩。","数残更。","还自搴帷独坐、看青灯。"]},{"i":"c-9fbcb3190bec","t":"相见欢","a":"朱敦儒","d":"宋","g":"词","p":["当年两上蓬瀛。","燕殊庭。","曾共群仙携手、斗吹笙。","云涛晚。","霓旌散。","海鸥轻。","却钓松江烟月、醉还醒。"]},{"i":"c-4bc325dbcefa","t":"相见欢","a":"朱敦儒","d":"宋","g":"词","p":["深秋庭院初凉。","近重阳。","篱畔一枝金菊、露微黄。","鲈脍韵。","橙齑品。","酒新香。","我是升平闲客、醉何妨。"]},{"i":"c-8e32f9ed9303","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["一夜新秋风雨。","客恨客愁无数。","我是卧云人，悔到红尘深处。","难住。","难住。","拂袖青山归去。"]},{"i":"c-ff1c9e052827","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["好个中秋时节。","莫恨今宵无月。","岩壑一灯青，寒浸水香留客。","留客。","留客。","相对无言无说。"]},{"i":"c-4b91d322434b","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["盏底一盘金凤。","满泛酒光浮动。","引我上烟霞，智力一时无用。","无用。","无用。","蹋破十洲三洞。"]},{"i":"c-870a2a07d84c","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["真个先生爱睡。","睡里百般滋味。","转面又翻身，随意十方游戏。","游戏。","游戏。","到了元无一事。"]},{"i":"c-e651f6dbc5e3","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["莫恨中秋无月。","月又不甜不辣。","幸有瓮头春，闲坐暖云香雪。","香雪。","香雪。","满引水晶蕉叶。"]},{"i":"c-14fe9bc89b10","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["莫恨中秋无月。","多点金缸红蜡。","取酒拥丝簧，迎取轻盈桃叶。","桃叶。","桃叶。","唱我新歌白雪。"]},{"i":"c-150d6fc4b067","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["一夜蟠桃吹坼。","刚道有人偷折。","幸自没踪由，无奈蝶蜂胡说。","胡说。","胡说。","方朔不须耳热。"]},{"i":"c-e7b5a435c488","t":"如梦令","a":"朱敦儒","d":"宋","g":"词","p":["好笑山翁年纪。","不觉七十有四。","生日近元宵，占早烧灯欢会。","欢会。","欢会。","坐上人人千岁。"]},{"i":"c-8cfd3327a1fe","t":"春晓曲","a":"朱敦儒","d":"宋","g":"词","p":["西楼落月鸡声急。","夜浸疏香寒淅沥。","玉人酒渴嚼春冰。","晓色入帘横宝瑟。"]},{"i":"c-1f75a7e86d43","t":"柳枝・杨柳枝","a":"朱敦儒","d":"宋","g":"词","p":["江南岸。","江北岸。","折送行人无尽时。","恨分离。","酒一杯。","泪双垂。","君到长安百事违。","几时归。"]},{"i":"c-c25fe4541859","t":"念奴娇","a":"朱敦儒","d":"宋","g":"词","p":["别离情绪，奈一番好景，一番悲戚。","燕语莺啼人乍远，还是他乡寒食。","桃李无言，不堪攀折，总是风流客。","东君也自，怪人冷淡踪迹。","花艳草草春工，酒随花意薄，疏狂何益。","除却清风并皓月，脉脉此情谁识。","料得文君，重帘不卷，且等闲消息。","不如归去，受他真个怜惜。"]},{"i":"c-52047d80baf8","t":"浣溪沙","a":"孙觌","d":"宋","g":"词","p":["弱骨轻肌不耐春。","一枝江路玉梅新。","巡檐索笑为何人。","素影徘徊波上月，醉香摇荡竹间云。","酒醒人散梦仙村。"]},{"i":"c-ed39e05a360b","t":"浣溪沙","a":"慕容卿妻","d":"宋","g":"词","p":["满目江山忆旧游。","汀洲花草弄春柔。","长亭舣住木兰舟。","好梦易随流水去，芳心空逐晓云愁。","行人莫上望京楼。"]},{"i":"c-d4b23dfedf13","t":"水龙吟","a":"周紫芝","d":"宋","g":"词","p":["黄金双阙横空，望中隐约三山眇。","春皇欲降，渚烟收尽，青虹正绕。","日到层宵，九枝光满，普天俱照。","看海中桃熟，云幡绛节，冉冉度、沧波渺。","遥想建章宫阙，□熏风、月寒清晓。","红鸾影上，云韶声里，蒙天一笑。","万国朝元，百蛮款塞，太平多少。","听尧云深处，人人尽祝，似天难老。"]},{"i":"c-f9b33220271d","t":"水龙吟","a":"周紫芝","d":"宋","g":"词","p":["楚山千叠浮空，楚云只在巫山往。","鸾飞凤舞，当时空记，梦中奇语。","晓日瞳昽，夕阳零乱，袅红萦素。","问如今依旧，霏霏冉冉，知他为、谁朝暮。","玉佩烟鬟飞动，炯星眸、人间相遇。","嫣然一笑，阳城下蔡，尽成惊顾。","蕙帐春浓，兰衾日暖，未成行雨。","但丁宁莫似，阳台梦断，又随风去。"]},{"i":"c-429f47430dc0","t":"水龙吟","a":"周紫芝","d":"宋","g":"词","p":["楚山木落风高，暮云黯黯孤容瘦。","天晴似洗，明霞消尽，玉峦排秀。","九凤飞来，五云深处，一时轻矫。","恨三山不见，六鳌去后，天空远，人将老。","堪笑此生如寄，信扁舟、朅来江表。","望中愁眼，依稀犹认，数峰林杪。","万里东南，跨江云梦，此情多少。","问何时还我，千岩万壑，卧霜天晓。"]},{"i":"c-cabeb75002f0","t":"浣溪沙","a":"周紫芝","d":"宋","g":"词","p":["近腊风光一半休。","南枝未动北枝愁。","嫦娥莫是见人羞。","么凤不传蓬岛信，杜鹃空办鹤林秋。","便须千杖打梁州。"]},{"i":"c-4f0771c857aa","t":"浣溪沙","a":"周紫芝","d":"宋","g":"词","p":["欲醉江梅兴未休。","待篘春瓮洗春愁。","不成欢绪却成羞。","天意若教花似雪，客情宁恨鬓如秋。","趁他何逊在扬州。"]},{"i":"c-878d8bac852b","t":"浣溪沙","a":"周紫芝","d":"宋","g":"词","p":["无限春情不肯休。","江梅未动使人愁。","东昏觑得玉奴羞。","对酒情怀疑是梦，忆花天气黯如秋。","唤春云梦泽南州。"]},{"i":"c-fa3b8ef4a361","t":"浣溪沙","a":"周紫芝","d":"宋","g":"词","p":["水上鸣榔不系船。","醉来深闭短篷眠。","潮生潮落自年年。","一尺鲈鱼新活计，半蓑烟雨旧衣冠。","庙堂空有画图看。"]},{"i":"c-8c26a704413e","t":"浣溪沙","a":"周紫芝","d":"宋","g":"词","p":["多病嫌秋怕上楼。","苦无情绪懒抬头。","雁来不寄小银钩。","一点离情深似海，万重凄恨黯如秋。","怎生禁得许多愁。"]},{"i":"c-20d6d04ff55b","t":"浣溪沙","a":"周紫芝","d":"宋","g":"词","p":["醽醁新翻碧玉壶。","水精钗袅绛纱符。","吴姬亲手碎菖蒲。","彩索系时新睡起，榴花剪处要人扶。","心情还似去年无。"]},{"i":"c-5db58640dbc0","t":"浣溪沙","a":"周紫芝","d":"宋","g":"词","p":["学画双蛾苦未成。","鬓云新结翠鬟轻。","伴人歌笑已多情。","飞絮乱花闲院宇，舞鸾歌凤小娉婷。","阳关休唱断肠声。"]},{"i":"c-2370e23d0275","t":"卜算子","a":"周紫芝","d":"宋","g":"词","p":["江北上归舟，再见江南岸。","江北江南几度秋，梦里朱颜换。","人是岭头云，聚散天谁管。","君似孤云何处归，我似离群雁。"]},{"i":"c-dfde5a5a8ed2","t":"卜算子","a":"周紫芝","d":"宋","g":"词","p":["霜叶下孤篷，船在垂杨岸。","早是凄凉惜别时，更惜年华换。","别酒解留人，拚醉君休管。","醉里朱弦莫谩弹，愁入参差雁。"]},{"i":"c-3e5458052851","t":"卜算子","a":"周紫芝","d":"宋","g":"词","p":["絮尽柳成空，春去花如扫。","窗外枝枝海石榴，特为幽人好。","密叶过疏篱，薄艳明芳草。","剪得花时却倚阑，楼上人垂手。"]},{"i":"c-13b181d723e8","t":"木兰花・玉楼春","a":"周紫芝","d":"宋","g":"词","p":["嫦娥天上人谁识。","家在蓬山烟水隔。","不应著意眼前人，便是登瀛当日客。","双眸炯炯秋波滴。","也解人间青与白。","檀郎未摘月边枝，枉是不教花爱惜。"]},{"i":"c-b1d1650a2d16","t":"木兰花・玉楼春","a":"周紫芝","d":"宋","g":"词","p":["江头雨后山如髻。","催送新凉风有意。","月来杨柳绿阴中，秋在梧桐疏影外。","小窗纹簟凉如水。","岁岁年年同此味。","眼前不忍对西风，梦里是堪追往事。"]},{"i":"c-fc3371c3e128","t":"减字木兰花","a":"周紫芝","d":"宋","g":"词","p":["春闲昼永。","城下江深山倒影。","净扫风埃。","收拾烟光入句来。","短窗闲倚。","身似浮云门似水。","谁伴馀年。","结得青山一个缘。"]},{"i":"c-4381b9ec33a7","t":"减字木兰花","a":"周紫芝","d":"宋","g":"词","p":["蓬莱三岛。","上有青青千岁草。","玉佩烟鬟。","来作人间一笑欢。","麻姑行酒。","萼绿华歌清韵袅。","玉秀兰芳。","醉舞东风彩袖长。"]},{"i":"c-6db246dc87ef","t":"减字木兰花","a":"周紫芝","d":"宋","g":"词","p":["西山岩桂。","常恨香闻烟雨外。","何似君家。","戏彩堂前早试花。","黄金千粟。","风撼芳条香馥馥。","一剪无多。","桃李漫山奈俗何。"]},{"i":"c-2552e65dc6e4","t":"减字木兰花","a":"周紫芝","d":"宋","g":"词","p":["当年文伯。","曾是东坡门下客。","文采风流。","奕叶传芳总未休。","为公持酒。","愿祝彩衣无限寿。","归觐枫宸。","剩醉长安几度春。"]},{"i":"c-9772ca78b59a","t":"摊破浣溪沙・山花子","a":"周紫芝","d":"宋","g":"词","p":["苍璧新敲小凤团。","赤泥开印煮清泉。","醉捧纤纤双玉笋，鹧鸪斑。","雪浪溅翻金缕袖，松风吹醒玉酡颜。","更待微甘回齿颊，且留连。"]},{"i":"c-d8d8d3cceac1","t":"减字木兰花","a":"周紫芝","d":"宋","g":"词","p":["门外青骢月下嘶。","映阶笼烛画帘垂。","一曲阳关声欲尽，不多时。","凤饼未残云脚乳，水沈催注玉花瓷。","忍看捧瓯春笋露，翠鬟低。"]},{"i":"c-2dffb9674ab8","t":"水调歌头","a":"周紫芝","d":"宋","g":"词","p":["白发三千丈，双鬓不胜垂。","人间忧喜如梦，老矣更何之。","蘧玉行年过了，未必如今俱是，五十九年非。","拟把彭殇梦，分付与痴儿。","君莫羡，客起舞，寿琼卮。","此生但愿，长遣猿鹤共追随。","金印借令如斗，富贵那能长久，不饮竟何为。","莫问蓬莱路，从古少人知。"]},{"i":"c-f3c6ae29ff2f","t":"水调歌头","a":"周紫芝","d":"宋","g":"词","p":["濯锦桥边月，几度照中秋。","年年此夜清景，伴我与君游。","万里相随何处，看尽吴波越嶂，更向古徐州。","应为霜髯老，西望倚黄楼。","天如水，云似扫，素魂流。","不知今夕何夕，相对语羁愁。","故国归来何事，记易南枝惊鹊，还对玉蟾羞。","踏尽疏桐影，更复为君留。"]},{"i":"c-208286679db6","t":"水调歌头","a":"周紫芝","d":"宋","g":"词","p":["岁晚念行役，江阔渺风烟。","六朝文物何在，回首更凄然。","倚尽危楼杰观，暗想琼枝璧月，罗袜步承莲。","桃叶山前鹭，无语下寒滩。","潮寂寞，浸孤垒，涨平川。","莫愁艇子何处，烟树杳无边。","王谢堂前双燕，空绕乌衣门巷，斜日草连天。","只有台城月，千古照婵娟。"]},{"i":"c-324c7facdf68","t":"水调歌头","a":"周紫芝","d":"宋","g":"词","p":["落日在烟树，云水两空濛。","澹霞消尽，何事依约有微红。","湖上晚来风细，吹尽一天残雨，苍翠湿千峰。","谁遣长空月，冷浸玉壶中。","问明月，应解笑，白头翁。","不堪老去，依旧临水照衰容。","良夜几横烟棹，独倚危墙西望，目断远山重。","但恨故人远，此乐与谁同。"]},{"i":"c-3fe7c7d98d72","t":"沙塞子","a":"周紫芝","d":"宋","g":"词","p":["秋云微淡月微羞。","云黯黯、月彩难留。","只应是、嫦娥心里，也似人愁。","几时回步玉移钩。","人共月、同上南楼。","却重听、画阑西角，月下轻讴。"]},{"i":"c-d2446cb6b959","t":"沙塞子","a":"周紫芝","d":"宋","g":"词","p":["玉溪秋月浸寒波。","忍持酒、重听骊歌。","不堪对、绿阴飞阁，月下羞蛾。","夜深惊鹊转南柯。","惨别意、无奈愁何。","他年事、不须重问，转更愁多。"]},{"i":"c-7a0357ab4c64","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["荷气吹凉到枕边。","薄纱如雾亦如烟。","清泉浴后花垂雨，白酒倾时玉满船。","钗欲溜，髻微偏。","却寻霜粉扑香绵。","冰肌近著浑无暑，小扇频摇最可怜。"]},{"i":"c-5a8cc7e06543","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["乌鹊桥边河汉流。","洗车微雨湿清秋。","相逢不似长相忆，一度相逢一度愁。","云却静，月垂钩。","金针穿得喜回头。","只应人倚阑干处，便似天孙梳洗楼。"]},{"i":"c-758b2ec65a5c","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["尊酒年年乐事多。","古铜犹得几摩挲。","他时人物君须记，玉笋班中李泰和。","烦翠袖，把金荷。","功名馀事且高歌。","新来学得长生诀，写就黄庭不换鹅。"]},{"i":"c-a1b4e024f128","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["名在休文季孟间。","一时风味更萧然。","琼林不逐春风老，安用丹砂巧驻颜。","春入户，酒吹澜。","小桃枝上锦阑斑。","明年欲与君为寿，无路相从入道山。"]},{"i":"c-c1ca094a78da","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["袅袅云梳晓髻堆。","涓涓秋净眼波回。","旧家十二峰前住，偶为襄王下楚台。","闲院静，小桃开。","刘郎前度几回来。","东风易行云散，花里传觞莫谩催。"]},{"i":"c-768b515f05a0","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["晴日烘帘暖似春。","菊回霜晕浅仍深。","谁知此地栽花手，便是当时嗅蕊人。","秋渺渺，夜沈沈。","一声清唱袅残音。","娇痴应挽香罗比，六幅双裙染郁金。"]},{"i":"c-1c677ba2f89a","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["年少登高意气多。","黄花压帽醉嵯峨。","如今满眼看华发，强拈茱萸奈老何。","千垒岫，万重波。","一时分付与秦娥。","明年身健君休问，且对秋风卷翠螺。"]},{"i":"c-7cc1dd8dd0b7","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["终日看山不厌山。","寻思百计不如闲。","何时得到重阳日，醉把茱萸仔细看。","敧醉帽，倚雕阑。","偶然携酒却成欢。","篱边黄菊关心事，触误愁人到酒边。"]},{"i":"c-43811e950492","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["读尽牙签玉轴书。","不知门外有园蔬。","借令未解銮坡去，也合雠书在石渠。","微雨后，小寒初。","满斟长寿碧琳腴。","不须更问荆州路，便上追锋御府车。"]},{"i":"c-870550fda896","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["楼上缃桃一萼红。","别来开谢几东风。","武陵春尽无人处，犹有刘郎去后踪。","香阁小，翠帘重。","今宵何事偶相逢。","行云又被风吹散，见了依前是梦中。"]},{"i":"c-15abf052f3c7","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["彩鹢双飞雪浪翻。","楚歌声转绿杨湾。","一川红旆初衔日，两岸朱楼不下帘。","阑倚处，玉垂纤。","白团扇底藕丝衫。","未成密约回秋水，看得羞时隔画檐。"]},{"i":"c-74291f0f5a6e","t":"鹧鸪天","a":"周紫芝","d":"宋","g":"词","p":["花褪残红绿满枝。","嫩寒犹透薄罗衣。","池塘雨细双鸳睡，杨柳风轻小燕飞。","人别后，酒醒时。","午窗残梦子规啼。","尊前心事人谁问，花底闲愁春又归。"]},{"i":"c-7032cf63d742","t":"采桑子","a":"周紫芝","d":"宋","g":"词","p":["跳珠雨罢风初静，阑槛凭虚。","绛阙清都。","只在仙人碧玉壶。","九原唤起王摩诘，画作新图。","十城芙蕖。","乞与知章老鉴湖。"]},{"i":"c-21bdd14819ab","t":"西江月","a":"周紫芝","d":"宋","g":"词","p":["画幕灯前细雨，垂莲盏里清歌。","玉纤持板隔香罗。","不放行云飞过。","今夜尘生洛浦，明朝雨在巫山。","羞蛾且莫斗弯环。","不似司空见惯。"]},{"i":"c-89888c7c87bc","t":"西江月","a":"周紫芝","d":"宋","g":"词","p":["池面风翻弱絮，树头雨退嫣红。","扑花蝴蝶杳无踪。","又做一场春梦。","便是一成去了，不成没个来时。","眼前无处说相思。","要说除非梦里。"]},{"i":"c-4d9c6803a55b","t":"西江月","a":"周紫芝","d":"宋","g":"词","p":["罗袖云轻雾薄，醉肌玉软花柔。","相逢不道有春愁。","只道春来微瘦。","一点人间深意，数声柳下轻讴。","带将离恨上归舟。","肠断月斜时候。"]},{"i":"c-981670945e87","t":"西江月","a":"周紫芝","d":"宋","g":"词","p":["发白犹敧旅枕，溪深未挂烟莎。","往来苕霅意如何。","应有轻鸥笑我。","细算年来活计，只消一个渔舟。","金鱼无分不须求。","只乞鲈鱼换酒。"]},{"i":"c-1a1830947370","t":"西江月","a":"周紫芝","d":"宋","g":"词","p":["连理枝头并蒂，同心带上双垂。","背灯偷赠语低低。","一点浓情先寄。","翡翠钗头摘处，鸳鸯枕上醒时。","酸甜红颗阿谁知。","别是人间滋味。"]},{"i":"c-1f1a0a50afab","t":"西江月","a":"周紫芝","d":"宋","g":"词","p":["天意未教秋老，花容剗地宜霜。","酒肌红软玉肌香。","不与梨花同样。","来伴孙郎小宴，临风为舞霓裳。","更深绿水照红妆。","便是采莲船上。"]},{"i":"c-78ad375c1761","t":"西江月","a":"周紫芝","d":"宋","g":"词","p":["谁把蓝揉翡翠，天将蜡做梅花。","晚来秋水映残霞。","水墨新描图画。","纸上写将心去，眼边送却愁来。","今回相见比前回。","心下忡忡越㬠。"]},{"i":"c-51b4981b1409","t":"小重山","a":"周紫芝","d":"宋","g":"词","p":["溪上晴山簇翠螺。","晓来霜叶醉，小池荷。","琐窗秋意苦无多。","帘绣卷，黄菊两三窠。","小睡拥香罗。","起来匀醉粉，玉垂梭。","只愁无奈夜长何。","你去也，今夜早来麽。"]},{"i":"c-3ce4e7500c7a","t":"小重山","a":"周紫芝","d":"宋","g":"词","p":["碧玉山围十里湖。","水云天共远，戏双凫。","河阳花县锦屏铺。","人不老，长日在蓬壶。","一笑且踟蹰。","会骑箕尾去，上云衢。","十分深注碧琳腴。","休惜醉，醉后有人扶。"]},{"i":"c-e1129c908e19","t":"汉宫春","a":"周紫芝","d":"宋","g":"词","p":["秋意还深，渐银床露冷，梧叶风高。","婵娟也应为我，羞照霜毛。","流年老尽，漫银蟾、冷浸香醪。","除尽把，平生怨感，一时分付离骚。","伤心故人千里，问阴晴何处，还记今宵。","楼高共谁同看，玉桂烟梢。","南枝鹊绕，叹此生、飘转江皋。","须更约，他年清照，为人常到寒霄。"]},{"i":"c-846522b6adb2","t":"汉宫春","a":"周紫芝","d":"宋","g":"词","p":["香满箱奁，看沈犀弄水，浓麝含薰。","荀郎一时旧事，尽属王孙。","残膏剩馥，须倾囊、乞与兰荪。","金兽暖，云窗雾阁，为人洗尽馀醺。","依稀雪梅风味，似孤山尽处，马上烟村。","从来甲煎浅俗，那忍重闻。","苏台燕寝，下重帏、深闭孤云。","都占得，横斜乱影，伴他月下黄昏。"]},{"i":"c-203e7ddc15a0","t":"醉落魄・一斛珠","a":"周紫芝","d":"宋","g":"词","p":["江天云薄。","江头雪似杨花落。","寒灯不管人离索。","照得人来，真个睡不著。","归期已负梅花约。","又还春动空飘泊。","晓寒谁看伊梳掠。","雪满西楼，人在阑干角。"]},{"i":"c-281438ab177f","t":"醉落魄・一斛珠","a":"周紫芝","d":"宋","g":"词","p":["柳边池阁。","晚来卷地东风恶。","人生不解频行乐。","昨日花开，今日风吹落。","杨花却似人飘泊。","春云更似人情薄。","如今始信从前错。","为个蝇头，轻负青山约。"]},{"i":"c-988a7ea1263b","t":"醉落魄・一斛珠","a":"周紫芝","d":"宋","g":"词","p":["薰风池阁。","小红桥下荷花薄。","沙平水浅山如削。","水上鸳鸯，何处风吹落。","今朝端午新梳掠。","锦丝围腕花柔弱。","人生只有尊前乐。","前度刘郎，莫负重来约。"]},{"i":"c-62bf84d3ccd3","t":"醉落魄・一斛珠","a":"周紫芝","d":"宋","g":"词","p":["云深海阔。","天风吹上黄金阙。","酒醒不记归时节。","三十年来，往事无人说。","浮生正似风中雪。","丹砂岂是神仙诀。","世间生死无休歇。","长伴君闲，只有山中月。"]},{"i":"c-fc7c5d956e98","t":"阮郎归","a":"周紫芝","d":"宋","g":"词","p":["酴醿花谢日迟迟。","杨花无数飞。","章台侧畔尽风吹。","飘零无定期。","烟漠漠，草萋萋。","江南春尽时。","可怜踪迹尚东西。","故园何日归。"]},{"i":"c-2ed47659719b","t":"阮郎归","a":"周紫芝","d":"宋","g":"词","p":["月棂疏影照婵娟。","闲临小玉盘。","枣花金钏出纤纤。","棋声敲夜寒。","飞雹冷，水精圆。","夜深人未眠。","笑催炉兽暖衾鸳。","莫教银漏残。"]},{"i":"c-93b8c3aa6937","t":"阮郎归","a":"周紫芝","d":"宋","g":"词","p":["西湖山下水潺潺。","满山风雨寒。","枝头红日晓斓斑。","越梅催晓丹。","连翠叶，拥金盘。","玉池生乳泉。","此生三度试甘酸。","欲归归尚难。"]},{"i":"c-c3cd1e8a933e","t":"青玉案","a":"周紫芝","d":"宋","g":"词","p":["青鞋忍踏江沙路。","恨人已、骑鲸去。","笔底骅骝谁与度。","西州重到，可怜不见，华屋生存处。","秋江渺渺高台暮。","满壁栖鸦醉时句。","飞上金鸾人漫许。","清歌低唱，小蛮犹在，空湿梨花雨。"]},{"i":"c-4cb7f2513d04","t":"青玉案","a":"周紫芝","d":"宋","g":"词","p":["梅花落尽人谁管。","暗凄断、伤春眼。","雪后平芜春尚浅。","一簪华发，满襟离恨，羞作东风伴。","斗花小斛兰芽短。","犹是当时旧庭院。","拟把新愁凭酒遣。","春衫重看，酒痕犹在，忍放金杯满。"]},{"i":"c-86de188e765f","t":"菩萨蛮","a":"周紫芝","d":"宋","g":"词","p":["翠蛾懒画妆痕浅。","香肌得酒花柔软。","粉汗湿吴绫。","玉钗敲枕稜。","鬓丝云卸腻。","罗带还重系。","含笑出房栊。","羞随脸上红。"]},{"i":"c-e0adae2c93a3","t":"菩萨蛮","a":"周紫芝","d":"宋","g":"词","p":["风头不定云来去。","天教月到湖心住。","遥夜一襟愁。","水风浑似秋。","藕花迎露笑。","暗水飞萤照。","渔笛莫频吹。","客愁人不知。"]},{"i":"c-c73554e7ec49","t":"菩萨蛮","a":"周紫芝","d":"宋","g":"词","p":["宝薰拂拂浓如雾。","暗惊梅蕊风前度。","依约似江村。","馀香马上闻。","画桥风雨暮。","零落知无数。","收拾小窗春。","金炉檀炷深。"]},{"i":"c-d07b285e8329","t":"西地锦","a":"周紫芝","d":"宋","g":"词","p":["雨细欲收还滴。","满一庭秋色。","阑干独倚，无人共说，这些愁寂。","手把玉郎书迹。","怎不教人忆。","看看又是黄昏也，敛眉峰轻碧。"]},{"i":"c-526336a6894d","t":"谒金门","a":"周紫芝","d":"宋","g":"词","p":["春雨细。","开尽一番桃李。","柳暗曲阑花满地。","日高人睡起。","绿浸小池春水。","沙暖鸳鸯双戏。","薄幸更无书一纸。","画楼愁独倚。"]},{"i":"c-6cae62b5e5e1","t":"生查子","a":"周紫芝","d":"宋","g":"词","p":["春寒入翠帷，月淡云来去。","院落半晴天，风撼梨花树。","人醉掩金铺，闲倚秋千柱。","满眼是相思，无说相思处。"]},{"i":"c-958710d782ca","t":"生查子","a":"周紫芝","d":"宋","g":"词","p":["青丝结晓鬟，临镜心情懒。","知为晓愁浓，画得双蛾浅。","柳困玉楼空，花落红窗暖。","相对语春愁，只有春闺燕。"]},{"i":"c-0934a753cf68","t":"生查子","a":"周紫芝","d":"宋","g":"词","p":["新欢君未成，往事无人记。","行雨共行云，如梦还如醉。","相见又难言，欲住浑无计。","眉翠莫频低，我已无多泪。"]},{"i":"c-5fe636889b7c","t":"生查子","a":"周紫芝","d":"宋","g":"词","p":["清歌忆去年，共唱秦楼曲。","门外月横波，帐里人如玉。","秋风吹彩云，梦断惊难续。","别调不堪闻，红泪销残烛。"]},{"i":"c-cee824c17a9b","t":"生查子","a":"周紫芝","d":"宋","g":"词","p":["金鞍欲别时，芳草溪边渡。","不忍上西楼，怕看来时路。","帘幕卷东风，燕子双双语。","薄幸不归来，冷落春情绪。"]},{"i":"c-5277a29d4f29","t":"生查子","a":"周紫芝","d":"宋","g":"词","p":["轻云浅护霜，晓日红生砌。","烟共宝薰浓，人与山长翠。","银浪酒杯浓，锦幄双鸾戏。","庭下彩衣郎，共祝千千岁。"]},{"i":"c-302f1b4126ca","t":"昭君怨","a":"周紫芝","d":"宋","g":"词","p":["满院融融花气。","红绣一帘垂地。","往事忆年时。","只春知。","风又暖。","花渐满。","人似行云不见。","无计奈离情。","恶销凝。"]},{"i":"c-22b0eb07af17","t":"秦楼月・忆秦娥","a":"周紫芝","d":"宋","g":"词","p":["东风歇。","香尘满院花如雪。","花如雪。","看看又是，黄昏时节。","无言独自添香鸭。","相思情绪无人说。","无人说。","照人只有，西楼斜月。"]}]