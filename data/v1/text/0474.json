[{"i":"c01c75d6-9182-4429-8e42-1ab52d7e45a5","t":"自吟","a":"徐釣者","d":"唐","g":"短诗","p":["曾見秦皇架石橋，海神忙迫漲驚潮。","蓬萊隔海雖難到，直上三清却不遙。"],"s":"mixed","f":"simp"},{"i":"d8b3c234-7cd9-4ab4-a001-4d57fa62c592","t":"踏歌","a":"藍采和","d":"唐","g":"古体","p":["踏歌踏歌藍采和，世界能幾何。","紅顏三春樹，流年一擲梭。","古人混混去不返，今人紛紛來更多。","朝騎鸞鳳到碧落，暮見桑田生白波。","長景明暉在空際，金銀宮闕高嵯峨。"],"s":"mixed","f":"simp"},{"i":"7bbe42bc-0412-46ec-b8e1-a58ae1f4d95e","t":"同沈恭子遊虎丘寺有作","a":"清遠道士","d":"唐","g":"古体","p":["我本長殷周，遭罹歷秦漢。","四瀆與五嶽，名山盡幽竄。","及此寰區中，始有近峰翫。","近峰何鬱鬱，平湖渺瀰漫。","吟俯川之陰，步上山之岸。","山川共澄澈，光彩交凌亂。","白雲蓊欲歸，青松忽消半。","客去川島靜，人來山鳥散。","谷深中見日，崖幽曉非旦。","聞子盛遊遨，風流足詞翰。","嘉茲好松石，一言常累嘆。","勿謂余鬼神，忻君共幽贊。"],"s":"mixed","f":"simp"},{"i":"5e11e9ac-3f88-4891-903f-1fa15b16e46f","t":"遊春臺詩 一","a":"春臺仙","d":"唐","g":"短诗","p":["玉幢亘碧虛，此乃真人居。","裴回仍未進，邪省猶難除。"],"s":"mixed","f":"simp"},{"i":"bc2a766e-12b5-48b0-a013-cb7b703e87a6","t":"遊春臺詩 二","a":"春臺仙","d":"唐","g":"短诗","p":["日落煙水黯，驪珠色豈昏。","寒光射萬里，霜縞遍千門。"],"s":"mixed","f":"simp"},{"i":"1c5ac119-58ff-4416-85f7-3e5cc6d77e46","t":"遊春臺詩 三","a":"春臺仙","d":"唐","g":"短诗","p":["玉魄東方開，嫦娥逐影來。","洗心兼滌目，怳若遊春臺。"],"s":"trad","f":"simp"},{"i":"64069405-dd7d-4745-b1c1-9cef66185a84","t":"遊春臺詩 四","a":"春臺仙","d":"唐","g":"短诗","p":["清波滔碧天，烏藏黯黮連。","二儀不辨處，忽吐清光圓。"],"s":"trad","f":"simp"},{"i":"b3405e8f-7046-4d8c-adb6-00179a11d247","t":"遊春臺詩 五","a":"春臺仙","d":"唐","g":"短诗","p":["烏沈海西岸，蟾吐天東頭。"],"s":"mixed","f":"simp"},{"i":"e095f4c2-a53c-44b8-a3ec-32dc4091e0c0","t":"遊春臺詩 六","a":"春臺仙","d":"唐","g":"短诗","p":["鳳凰三十六，碧天高太清。","元君夫人蹋雲語，冷風颯颯吹鵝笙。"],"s":"trad","f":"simp"},{"i":"a13f9d44-c003-4e31-9b8c-754bac6316ca","t":"醉吟","a":"酒肆布衣","d":"唐","g":"短诗","p":["陽春時節天氣和，萬物芳盛人如何。","素秋時節天地肅，榮秀叢林立衰促。","有同人世當少年，壯心儀貌皆儼然。","一旦形羸又髮白，舊遊空使淚連連。"],"s":"trad","f":"simp"},{"i":"8bd6bf69-f889-404e-81cd-0ffeafc12703","t":"又吟","a":"酒肆布衣","d":"唐","g":"短诗","p":["有形皆朽孰不知，休吟春景與秋時。","爭如且醉長安酒，榮華零悴總奚爲。"],"s":"mixed","f":"simp"},{"i":"1351909f-b4e7-40ce-a690-1d1d197c1799","t":"嫁女詩 一","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["勸君酒，爲君悲且吟。","自從頻見市朝改，無復瑤池宴樂心。"],"s":"mixed","f":"simp"},{"i":"fa8ff655-ce5a-4aaf-8020-eb6b25a5031e","t":"嫁女詩 二","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["奉君酒，休嘆市朝非。","早知無復瑤池興，悔駕驊騮草草歸。"],"s":"trad","f":"simp"},{"i":"cf5cc0be-253a-4c2c-b2e3-bb4547ce3707","t":"嫁女詩 三","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["八馬迴乘汗漫風，猶思往事憩昭宮。","宴移玄圃情方洽，樂奏鈞天曲未終。","斜漢露凝殘月冷，流霞杯泛曙光紅。","崑崙回首不知處，疑是酒酣魂夢中。"],"s":"trad","f":"simp"},{"i":"063483cc-84e5-4744-8ee7-ece291ccee2e","t":"嫁女詩 四","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["一曲笙歌瑤水濱，曾留逸足駐征輪。","人間甲子週千歲，靈境杯觴初一巡。","玉兔銀河終不夜，奇花好樹鎮長春。","悄知碧海饒詞句，歌向俗流疑誤人。"],"s":"mixed","f":"simp"},{"i":"a4301493-2219-4e5a-ab4b-0272c4773196","t":"嫁女詩 五","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["珠露金風下界秋，漢家陵樹冷脩脩。","當時不得仙桃力，尋作浮塵飄隴頭。"],"s":"trad","f":"simp"},{"i":"533fd12d-45c9-4a3a-a295-14ac997ddf7d","t":"嫁女詩 六","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["五十餘年四海清，自親丹藥得長生。","若言盡是仙桃力，看取神仙簿上名。"],"s":"trad","f":"simp"},{"i":"9f4d2800-7e04-4363-822c-68f231e6955a","t":"嫁女詩 七","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["月照驪山露泣花，似悲先帝早昇遐。","至今猶有長生鹿，時遶溫泉望翠華。"],"s":"trad","f":"simp"},{"i":"450aa66d-85e8-4233-ae45-2b245b69ebcf","t":"嫁女詩 八","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["幽薊煙塵別九重，貴妃湯殿罷歌鐘。","中宵扈從無全杖，大駕蒼黃發六龍。","妝匣尚留金翡翠，暖池猶浸玉芙蓉。","荆榛一閉朝元路，唯有悲風吹晚松。"],"s":"mixed","f":"simp"},{"i":"38880671-e1c7-4c4a-a793-59c8a983b551","t":"嫁女詩 九","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["上清神女，玉京仙郎。","樂此今夕，和鳴鳳凰。","鳳凰和鳴，將翱將翔。","與天齊休，慶流無央。"],"s":"trad","f":"simp"},{"i":"52cb1bfd-de19-49dd-9e67-05bea3195c8d","t":"嫁女詩 十","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["玉爲質兮花爲顏，蟬爲鬢兮雲爲鬟。","何勞傅粉兮施渥丹，早出娉婷兮縹緲間。"],"s":"mixed","f":"simp"},{"i":"ff86a73d-8b4f-4479-a406-b2448c64cfa1","t":"嫁女詩 十一","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["水晶帳開銀燭明，風搖珠珮連雲清。","休勻紅粉飾花態，早駕雙鸞朝玉京。"],"s":"trad","f":"simp"},{"i":"49ac397c-37de-485d-8187-447f37a27200","t":"嫁女詩 十二","a":"嵩嶽諸仙","d":"唐","g":"短诗","p":["三星在天銀河迴，人間曙色東方來。","玉苗瓊蕊亦宜夜，莫使一花衝曉開。"],"s":"trad","f":"simp"},{"i":"b5618c22-4c31-4d2d-953f-0defc39fbb45","t":"吟 一","a":"芙蓉古丈夫　毛女","d":"唐","g":"短诗","p":["餌柏身輕疊嶂間，是非無意到塵寰。","冠裳暫備論浮世，一餉雲遊碧落間。"],"s":"trad","f":"simp"},{"i":"3ae38509-509e-47a6-aabd-a7c8754cb5ac","t":"吟 二","a":"芙蓉古丈夫　毛女","d":"唐","g":"短诗","p":["誰知古是與今非，閑躡青霞與翠微。","簫管秦樓應寂寂，彩雲空惹薜蘿衣。"],"s":"trad","f":"simp"},{"i":"337c322e-6d63-449d-ad4e-06b51857913e","t":"授炙轂子歌二首 一","a":"希道","d":"唐","g":"短诗","p":["木津天魂，金液地魄。","坎離運行寬無成，金木有數秦晉合。","近効宜六旬，遠期三載闊。"],"s":"trad","f":"simp"},{"i":"cf4f6b0e-d404-4189-a02b-f1495a3b69e7","t":"授炙轂子歌二首 二","a":"希道","d":"唐","g":"短诗","p":["魄微入魂牝牡結，陽呴陰滋神鬼滅。","千歌萬讚皆未決，古往今來拋日月。"],"s":"trad","f":"simp"},{"i":"4f8c2bb6-8a4a-4be1-87cd-54807999f16f","t":"李泌庭黑石詩","a":"隱者","d":"唐","g":"短诗","p":["神真鍊形年未足，化爲我子功相續。","丞相瘞之刻玄玉，仙路何長死何促。"],"s":"mixed","f":"simp"},{"i":"4baf8178-97f7-4e0c-be1c-025d5a6931a8","t":"戲吟","a":"廣陵道士","d":"唐","g":"短诗","p":["無事到揚州，相攜上酒樓。","藥囊爲贈別，千載更何求。"],"s":"mixed","f":"simp"},{"i":"eeb950ba-8c7b-4aad-926f-4a2a22fe4c13","t":"授馬氏女詩","a":"黃冠野夫","d":"唐","g":"短诗","p":["女是寄生枝，男是冬青木。","冬青駕白鵝，寄生跨黃鹿。","若遇寇相凌，穩便拋家族。","早早上三清，莫候丹砂熟。"],"s":"trad","f":"simp"},{"i":"18ef8ed5-8172-4253-9845-e5920076cb47","t":"歌","a":"蜀中酒閣道人","d":"唐","g":"短诗","p":["尾閭不禁滄溟竭，九轉神丹都謾說。","惟有班龍頂上珠，能補玉堂關下穴。"],"s":"trad","f":"simp"},{"i":"f43708d2-ea9b-4a67-b8aa-7229835c2036","t":"吟","a":"章江書生","d":"唐","g":"短诗","p":["西去長沙東上船，思量此事已千年。","長春殿掩無人掃，滿眼梨花哭杜鵑。"],"s":"trad","f":"simp"},{"i":"c1dddb66-ccc3-43b1-ac6a-ddd1b9001d20","t":"示邊洞元","a":"萼嶺書生","d":"唐","g":"短诗","p":["邂逅相逢萼嶺邊，對傾浮蟻共談玄。","擬將劒法親傳授，却爲迷人未有緣。"],"s":"mixed","f":"simp"},{"i":"61ed6d48-5c52-4ca3-b1ee-6fe17cd73101","t":"示胡二郎歌","a":"成都醉道士","d":"唐","g":"古体","p":["欲究丹砂理，幽玄無處尋。","不離鉛與汞，無出水中金。","金欲煉時須得水，水遇土兮終不起。","但知火候不參差，自得還丹微妙旨。","人世分明知有死，剛只留心戀朱紫。","豈知光景片時間，將謂人生長似此。","何不迴心師至道？免逐年光虛自老。","臨樽只解醉醺酣，對鏡方知漸枯槁。","二郎切切聽我語，仙鄉咫尺無寒暑。","與君說盡只如斯，莫戀嬌奢不肯去。","感君恩義言方苦，火急迴心求出路。","吟成數句贈君辭，不覺便成今與古。"],"s":"trad","f":"simp"},{"i":"ea5cd8f3-6231-4f39-9b20-ac738434e4e7","t":"貽白永年詩","a":"樵夫","d":"唐","g":"短诗","p":["清秋無所事，乘露出遙天。","憑杖樵人語，相期白永年。"],"s":"trad","f":"simp"},{"i":"776e7e9f-f5de-4ebf-ab98-20b301a94a74","t":"留詩","a":"李公佐僕","d":"唐","g":"古体","p":["我有衣中珠，不嫌衣上塵。","我有長生理，不厭有生身。","江南神仙窟，吾當混其真。","不嫌市井諠，來救世間人。","蘇子跡已往，顓蒙事可親。","莫言東海變，天地有長春。"],"s":"mixed","f":"simp"},{"i":"2615c5d4-457d-42fc-816f-82bb85b0bbed","t":"酒盡君莫沽","a":"木客","d":"唐","g":"短诗","p":["酒盡君莫沽，壺傾我當發。","城市多囂塵，還山弄明月。"],"s":"trad","f":"simp"},{"i":"78239a47-56a4-4a63-97d7-82947fdeb06f","t":"西山吟","a":"許大","d":"唐","g":"短诗","p":["自從明府歸仙後，出入塵寰直至今。","不是藏名混時俗，賣藥沽酒要安心。"],"s":"trad","f":"simp"},{"i":"8d3f3711-b1b2-4126-8f37-f609a74e9a96","t":"東洛貨丹","a":"許學士","d":"唐","g":"短诗","p":["三千功滿去升天，一住人間數百年。","華表他時却歸日，滄溟應恐變桑田。"],"s":"mixed","f":"simp"},{"i":"34e2b8a8-5aee-4673-be41-955b3c460333","t":"天關回到世吟","a":"許學士","d":"唐","g":"短诗","p":["九霄雲路奇哉險，曾把沖身入太和。","今日東歸渾似夢，望崖回首隔天波。"],"s":"trad","f":"simp"},{"i":"d07d9ba2-5d63-4c03-b970-9e05a2b88a57","t":"送青城丈人酒","a":"紫微孫處士","d":"唐","g":"短诗","p":["深羨青城好洞天，白龍一覺已千年。","鋪雲枕石長松下，朝退看書盡日眠。"],"s":"trad","f":"simp"},{"i":"96e2a57c-2297-40e9-9b09-530ead194007","t":"送王懿昌酒","a":"紫微孫處士","d":"唐","g":"短诗","p":["將知骨分到仙鄉，酒飲金華玉液漿。","莫道人間只如此，回頭已是一年強。"],"s":"trad","f":"simp"},{"i":"a2e54ceb-225e-47e3-891b-81284d3fb345","t":"送太乙真君酒","a":"青城丈人","d":"唐","g":"短诗","p":["峨嵋仙府靜沈沈，玉液金華莫厭斟。","凡客欲知真一洞，劒門西北五雲深。"],"s":"trad","f":"simp"},{"i":"a3092192-fdea-4e98-a34f-19d7cb0e06ec","t":"送紫微處士酒","a":"太乙真君","d":"唐","g":"短诗","p":["此中何必羨青城，玉樹雲棲不記名。","悶即乘龍遊紫府，北辰南斗逐君行。"],"s":"trad","f":"simp"},{"i":"a9bc3391-8069-4dc8-b356-af49d180854a","t":"題法雲寺雙檜","a":"方壺居士","d":"唐","g":"短诗","p":["謝郎雙檜綠於雲，昏曉濃陰色未分。","若竝毫宮仙鹿跡，定知高峭不如君。"],"s":"trad","f":"simp"},{"i":"8f76ddf2-da35-4984-b91b-75c1ef2ce11f","t":"隋堤詞","a":"方壺居士","d":"唐","g":"短诗","p":["嘗憶江都大業秋，曾隨鑾蹕戲龍舟。","傷心一覺興亡夢，堤柳無情識世愁。"],"s":"trad","f":"simp"},{"i":"1e2394c7-642a-4cfa-83b2-dd495e88863a","t":"畫地吟","a":"太白山玄士","d":"唐","g":"短诗","p":["學得丹青數萬年，人間幾度變桑田。","桑田雖變丹青在，誰向丹青合得仙。"],"s":"trad","f":"simp"},{"i":"d336a7f5-22b8-41fe-869d-b217e6c8e2a1","t":"貨丹吟","a":"鄰道場人","d":"唐","g":"短诗","p":["尋仙何必三山上，但使神存九竅清。","煉得綿綿元氣定，自然不食亦長生。"],"s":"trad","f":"simp"},{"i":"05959fee-eb71-40e6-8a05-98b1827b5574","t":"靈響詞 一","a":"無名氏","d":"唐","g":"短诗","p":["此響非俗響，心知是靈仙。","不曾離耳裏，高下如秋蟬。"],"s":"mixed","f":"simp"},{"i":"b7ed2d16-92a6-4f2d-baa8-ceac17823765","t":"靈響詞 二","a":"無名氏","d":"唐","g":"短诗","p":["入夜聲則厲，在晝聲則微。","神靈斥衆惡，與我作風威。"],"s":"mixed","f":"simp"},{"i":"2359ceff-0750-479a-ae74-bbeb8b415895","t":"靈響詞 三","a":"無名氏","d":"唐","g":"短诗","p":["妙響無住時，晝夜常輪迴。","那是偶然事，上界特使來。"],"s":"trad","f":"simp"},{"i":"5e1534f6-8e4a-48d4-98cb-30335eebfb64","t":"靈響詞 四","a":"無名氏","d":"唐","g":"短诗","p":["何以辨靈應，事須得梯媒。","自從靈響降，如有真人來。"],"s":"trad","f":"simp"},{"i":"bff45d27-8f28-46a4-a864-d6c853b02bc2","t":"靈響詞 五","a":"無名氏","d":"唐","g":"短诗","p":["存念長在心，展轉無停音。","可憐清爽夜，靜聽秋蟬吟。"],"s":"trad","f":"simp"},{"i":"9f67387d-9060-4b9f-8e1f-c66fe91bf46b","t":"度世古玄歌","a":"無名氏","d":"唐","g":"短诗","p":["始青之下月與日，兩半同升合爲一。","大如彈丸甘如蜜，出彼玉堂入金室，子若得之慎勿失。"],"s":"mixed","f":"simp"},{"i":"f6ddf5ce-7454-4a70-b615-fde66abf7146","t":"鬻丹砂醉吟","a":"劉道昌","d":"唐","g":"短诗","p":["心田但使靈芝長，氣海常教法水朝。","功滿自然留不住，更將何物馭丹霄。"],"s":"trad","f":"simp"},{"i":"111f978a-abf0-4c47-973a-438ae907d768","t":"龜市告別","a":"劉道昌","d":"唐","g":"短诗","p":["還丹功滿氣成胎，九百年來混俗埃。","自此三山一歸去，無因重到世間來。"],"s":"trad","f":"simp"},{"i":"20aabd19-401a-4bfe-8e76-9d8ecee24de2","t":"摘紫芝","a":"李太玄","d":"唐","g":"短诗","p":["偶游洞府到芝田，星月茫茫欲曙天。","雖則似離塵世了，不知何處偶真仙。"],"s":"mixed","f":"simp"},{"i":"58d64337-d60d-4f53-ad11-24095c57d3c4","t":"玉女舞霓裳","a":"李太玄","d":"唐","g":"短诗","p":["舞勢隨風散復收，歌聲似磬韻還幽。","千迴赴節填詞處，嬌眼如波入鬢流。"],"s":"trad","f":"simp"},{"i":"2ad52fb8-67f9-4608-a9e8-e008fcd611b6","t":"翫月詩 一","a":"曲龍山仙","d":"唐","g":"短诗","p":["曲龍橋頂翫瀛洲，凡骨空陪汗漫流。","不假丹梯躡霄漢，水晶盤冷桂花秋。"],"s":"trad","f":"simp"},{"i":"187e98d1-5166-4068-a6d5-7522ae508f29","t":"翫月詩 二","a":"曲龍山仙","d":"唐","g":"短诗","p":["月砌瑤階泉滴乳，玉簫催鳳和煙舞。","青城丈人何處遊，玄鶴唳天雲一縷。"],"s":"trad","f":"simp"},{"i":"202bd0c0-4003-4749-a804-f28a5995b752","t":"翫月詩 三","a":"曲龍山仙","d":"唐","g":"短诗","p":["造化天橋碧海東，玉輪還過輾晴虹。","霓襟似拂瀛洲頂，顥氣潛消橐籥中。"],"s":"trad","f":"simp"},{"i":"2c11ac9c-ae64-4654-9968-b1fdb2302d3a","t":"翫月詩 四","a":"曲龍山仙","d":"唐","g":"短诗","p":["危橋橫石架雲端，跨鹿登臨景象寬。","顥魄洗煙澄碧落，桂花低拂玉簪寒。"],"s":"trad","f":"simp"},{"i":"1b285612-82cf-4ef7-8533-af42833beee6","t":"句","a":"陳復休","d":"唐","g":"短诗","p":["夜坐空庭月色微，一樹寒梅發兩枝。"],"s":"trad","f":"simp"},{"i":"422d7b14-d3e8-4064-ac77-18e1ca55734b","t":"句","a":"鄭冠卿","d":"唐","g":"短诗","p":["不緣過去行方便，安得今朝會碧虛。"],"s":"trad","f":"simp"},{"i":"9b5d86f6-d66f-4463-9634-3753e9e5ce87","t":"句","a":"陳蓬","d":"唐","g":"短诗","p":["竹籬疎見浦，茅屋漏通星。"],"s":"trad","f":"simp"},{"i":"03b05e5a-b124-44b7-8cb9-149888bfe281","t":"句","a":"伊夢昌","d":"唐","g":"短诗","p":["惟有松杉空弄月，更無雲鶴暗迷人。","露凝金盞滴殘酒，檀點佳人噴異香。"],"s":"trad","f":"simp"},{"i":"40abdb78-a574-4b93-9a1a-1946075a5537","t":"與薛昭合婚詩 一","a":"張雲容","d":"唐","g":"短诗","p":["臉花不綻幾含幽，今夕陽春獨換秋。","我守孤燈無白日，寒雲隴上更添愁。"],"s":"trad","f":"simp"},{"i":"668d0d0b-807b-4e5f-8716-c85bcdd20eb8","t":"與薛昭合婚詩 二","a":"張雲容","d":"唐","g":"短诗","p":["幽谷啼鶯整羽翰，犀沈玉冷自長歎。","月華不向扃泉戶，露滴松枝一夜寒。"],"s":"trad","f":"simp"},{"i":"003f3fa7-49f4-4e11-a072-d290bccc1e56","t":"與薛昭合婚詩 三","a":"張雲容","d":"唐","g":"短诗","p":["韶光不見分成塵，曾餌金丹忽有神。","不意薛生攜舊律，獨開幽谷一枝春。"],"s":"trad","f":"simp"},{"i":"51fffd2c-1820-4b38-a14e-7d5481c8fc25","t":"與薛昭合婚詩 四","a":"張雲容","d":"唐","g":"短诗","p":["誤入宮垣漏網人，月華靜洗玉階塵。","自疑飛到蓬萊頂，瓊豔三枝半夜春。"],"s":"trad","f":"simp"},{"i":"0e723de9-7675-492d-b821-06f1af9b9294","t":"留別盧陲","a":"崔少玄","d":"唐","g":"古体","p":["得之一元，匪受自天。","太老之真，無上之僊。","光含影藏，形于自然。","真安匪求，神之久留。","淑美其真，體性剛柔。","丹霄碧虛，上聖之儔。","百歲之後，空餘墳丘。"],"s":"mixed","f":"simp"},{"i":"0da4409b-3d2a-448d-bdff-b6356db6e80a","t":"歌","a":"戚逍遙","d":"唐","g":"短诗","p":["笑看滄海欲成塵，王母花前別衆真。","千歲却歸天上去，一心珍重世間人。"],"s":"mixed","f":"simp"},{"i":"0759d92a-c588-46e9-a778-8f11692c4afc","t":"錦城春望","a":"卓英英","d":"唐","g":"短诗","p":["和風裝點錦城春，細雨如絲壓玉塵。","漫把詩情訪奇景，豔花濃酒屬閑人。"],"s":"trad","f":"simp"},{"i":"6ee7eda5-12d4-49ac-bd9f-d23ed459da96","t":"理笙","a":"卓英英","d":"唐","g":"短诗","p":["頻倚銀屏理鳳笙，調中幽意起春情。","因思往事成惆悵，不得緱山和一聲。"],"s":"trad","f":"simp"},{"i":"97e23250-e1b5-4761-a191-4febf347709c","t":"遊福感寺荅少年","a":"卓英英","d":"唐","g":"短诗","p":["牡丹未及開時節，況是秋風莫近前。","留待來年二三月，一枝和露壓神仙。"],"s":"trad","f":"simp"},{"i":"b807c4a1-cd03-4076-b007-aedcf4e59e21","t":"荅玄士","a":"卓英英","d":"唐","g":"短诗","p":["數載幽欄種牡丹，裹香包豔待神仙。","神仙既有丹青術，攜取何妨入洞天。"],"s":"trad","f":"simp"},{"i":"4fc6928d-c9d6-4136-8802-05c4aa96ac8f","t":"和卓英英錦城春望","a":"眉娘","d":"唐","g":"短诗","p":["蠶市初開處處春，九衢明豔起香塵。","世間總有浮華事，爭及仙山出世人。"],"s":"trad","f":"simp"},{"i":"0e4436e7-02b4-4391-a4cd-4da467111030","t":"和卓英英理笙","a":"眉娘","d":"唐","g":"短诗","p":["但於閨閣熟吹笙，太白真仙自有情。","他日丹霄驂白鳳，何愁子晉不聞聲。"],"s":"trad","f":"simp"},{"i":"33b1eac8-0b17-4bc9-a58e-b6489172b0a1","t":"太白山玄士畫地吟","a":"眉娘","d":"唐","g":"短诗","p":["學得丹青數萬年，人間幾度變桑田。","桑田雖變丹青在，誰向丹青合得仙。"],"s":"trad","f":"simp"},{"i":"604cb9a3-0a04-425c-ab63-be76101ff193","t":"荅張鬱歌 一","a":"洛川仙女","d":"唐","g":"短诗","p":["彩雲入帝鄉，白鶴又回翔。","久留深不可，蓬島路遐長。"],"s":"mixed","f":"simp"},{"i":"b932a380-a7d4-4c61-99d9-fb092de80735","t":"荅張鬱歌 二","a":"洛川仙女","d":"唐","g":"短诗","p":["空愛長生術，不是長生人。","今日洛川別，可惜洞中春。"],"s":"trad","f":"simp"},{"i":"07ef2b1e-4baa-49e4-8c2f-cd508ef9aefb","t":"張鬱洛川沿步吟","a":"洛川仙女","d":"唐","g":"短诗","p":["浮生如夢能幾何，浮生復更憂患多。","無人與我長生術，洛川春日且長歌。"],"s":"trad","f":"simp"},{"i":"0585f71e-3c84-4580-b91c-5d213eed607e","t":"題玉壺贈元柳二子","a":"南溟夫人","d":"唐","g":"短诗","p":["來從一葉舟中來，去向百花橋上去。","若到人間扣玉壺，鴛鴦自解分明語。"],"s":"trad","f":"simp"},{"i":"e8766390-3e63-4a71-85a8-516cab5ee53e","t":"會真詩 一","a":"雲臺峰五女仙","d":"唐","g":"短诗","p":["人世徒紛擾，其生似夢華。","誰言今昔裏，俯首視雲霞。"],"s":"mixed","f":"simp"},{"i":"c983ffdd-1e10-4cb7-bcf7-a202671fbef6","t":"會真詩 二","a":"雲臺峰五女仙","d":"唐","g":"短诗","p":["幾劫澄煩思，今身僅小成。","誓將雲外隱，不向世間存。"],"s":"trad","f":"simp"},{"i":"3de3ced0-a7ca-4ee4-a30e-992a33b16bee","t":"會真詩 三","a":"雲臺峰五女仙","d":"唐","g":"短诗","p":["綽約離塵世，從容上太清。","雲衣無綻日，鶴駕沒遙程。"],"s":"trad","f":"simp"},{"i":"befc1b90-edf1-48e1-b402-447816929e52","t":"會真詩 四","a":"雲臺峰五女仙","d":"唐","g":"短诗","p":["華嶽無三尺，東瀛僅一杯。","入雲騎彩鳳，歌舞上蓬萊。"],"s":"trad","f":"simp"},{"i":"cf2ce37a-a9f4-461b-81dd-3f06bf24fc88","t":"會真詩 五","a":"雲臺峰五女仙","d":"唐","g":"短诗","p":["共作雲山侶，俱辭世界塵。","靜思前日事，拋却幾年身。"],"s":"mixed","f":"simp"},{"i":"8580c305-a052-4d7b-be42-0579ca839a92","t":"仙詩五首 一","a":"吳清妻","d":"唐","g":"短诗","p":["道啓真心覺漸清，天教絕粒應精誠。","雲外仙歌笙管合，花間風引步虛聲。"],"s":"mixed","f":"simp"},{"i":"eaf88b4d-2563-4679-b475-992b21e89510","t":"仙詩五首 二","a":"吳清妻","d":"唐","g":"短诗","p":["□□□□□□□，□君隱處當一星。","□□蓮花山頭飯，黃精仙人掌上經。"],"s":"trad","f":"simp"},{"i":"e8d9bab0-0e0a-46dd-8cb8-5d95385d6f51","t":"仙詩五首 三","a":"吳清妻","d":"唐","g":"短诗","p":["飛鳥莫到人莫攀，一隱十年不下山。","袖中短書誰爲達，華山道士賣藥還。"],"s":"mixed","f":"simp"},{"i":"06a280c6-9c12-4703-bb5e-e149f72e1a86","t":"仙詩五首 四","a":"吳清妻","d":"唐","g":"短诗","p":["日落焚香坐醮壇，庭花露濕漸更闌。","淨水仙童調玉液，春宵羽客化金丹。"],"s":"trad","f":"simp"},{"i":"5eaa249d-615d-41cf-8873-5a9976993c7d","t":"仙詩五首 五","a":"吳清妻","d":"唐","g":"短诗","p":["攝念精思引彩霞，焚香虛室對煙花。","道合雲霄遊紫府，湛然真境瑞皇家。"],"s":"trad","f":"simp"},{"i":"c557591c-b092-4a60-914e-ace3a9662646","t":"贈封陟","a":"上元夫人","d":"唐","g":"短诗","p":["謫居蓬島別瑤池，春媚煙花有所思。","爲愛君心能潔白，願操箕帚奉屏幃。"],"s":"mixed","f":"simp"},{"i":"b73f06b8-f693-4843-8408-3d0ca2ee49f7","t":"再贈","a":"上元夫人","d":"唐","g":"短诗","p":["弄玉有夫皆得道，劉綱兼室盡登仙。","君能仔細窺朝露，須逐雲車拜洞天。"],"s":"trad","f":"simp"},{"i":"97103e07-6a9e-425d-9670-0e6b2abaa7cd","t":"留別","a":"上元夫人","d":"唐","g":"短诗","p":["蕭郎不顧鳳樓人，雲澀回車淚臉新。","愁想蓬瀛歸去路，難窺舊苑碧桃春。"],"s":"trad","f":"simp"},{"i":"65c1865a-d2d0-4ca1-83da-4e8df710425c","t":"題寺廊柱 一","a":"慈恩塔院女仙","d":"唐","g":"短诗","p":["皇子陂頭好月明，忘却華筵到曉行。","煙收山低翠黛橫，折得荷花遠恨生。"],"s":"mixed","f":"simp"},{"i":"cbc000e0-7f7b-4cb7-8ccb-a01e324c212b","t":"題寺廊柱 二","a":"慈恩塔院女仙","d":"唐","g":"短诗","p":["湖水團團夜如鏡，碧樹紅花相掩映。","北斗闌干移曉柄，有似佳期常不定。"],"s":"mixed","f":"simp"},{"i":"52160537-660c-4cf7-9fb6-5ea26145534b","t":"后土夫人","a":"蜀宮羣仙","d":"唐","g":"短诗","p":["偶引羣仙到世間，熏風殿裏醉華筵。","等閑貪賞不歸去，愁殺韋郎一覺眠。"],"s":"mixed","f":"simp"},{"i":"456df2e5-f564-4d94-a0cc-3cf62fde77a7","t":"王母","a":"蜀宮羣仙","d":"唐","g":"短诗","p":["滄海成塵幾萬秋，碧桃花發長春愁。","不來便是數千載，周穆漢皇何處遊。"],"s":"mixed","f":"simp"}]