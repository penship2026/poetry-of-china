[{"i":"c-88e443af5229","t":"眼儿媚","a":"赵长卿","d":"宋","g":"词","p":["一钩新月照西楼。","清夜思悠悠。","那堪更被，征鸿嘹唳，绊惹离愁。","倚栏不语情如醉，都总寄眉头。","从前只为，惜他伶俐，举措风流。"],"s":"simp","f":"trad"},{"i":"c-a0b542c507e0","t":"别怨","a":"赵长卿","d":"宋","g":"词","p":["娇马频嘶。","晓霜浓、寒色侵衣。","凤帷私语处，翻成离怨不胜悲。","更与叮咛祝后期。","素约谐心事，重来了、比看相思。","如何见得，明年春事浓时。","稳乘金腰袅，来烂醉、玉东西。"],"s":"simp","f":"trad"},{"i":"c-5bbf03418d00","t":"减字木兰花","a":"赵长卿","d":"宋","g":"词","p":["小春天气。","未唱阳关心已醉。","红蓼秋容。","后会何时得再逢。","归期好事。","仰看皇州扬雨露。","百里恩波。","拟欲留公无奈何。"],"s":"simp","f":"trad"},{"i":"c-cc3fb4879e9c","t":"好事近","a":"赵长卿","d":"宋","g":"词","p":["去路马蹄轻，正是小春时节。","爱日暖烘江树，缀梅梢新雪。","范滂揽辔正澄清，知我公明洁。","分此仁风恺悌，济邻邦欢悦。"],"s":"simp","f":"trad"},{"i":"c-971c48cb4d88","t":"霜天晓角","a":"赵长卿","d":"宋","g":"词","p":["合儿幽静处，围炉面小窗。","好是斗头儿坐，梅烟炷、返魂香。","对火怯夜冷，猛饮消漏长。","饮罢且收拾睡，斜月照、满帘霜。"],"s":"simp","f":"trad"},{"i":"c-325eddcddd59","t":"鹧鸪天","a":"赵长卿","d":"宋","g":"词","p":["宝篆龙煤烧欲残。","细听铜漏已更阑。","纱窗斜月移梅影，特地笼灯仔细看。","幽梦断，旧盟寒。","那时屈曲小屏山。","风光得似而今不，肯把花枝作等闲。"],"s":"simp","f":"trad"},{"i":"c-9b92400e2f0d","t":"蓦山溪","a":"赵长卿","d":"宋","g":"词","p":["玉妃整佩，绛节参差御。","一笑唤春回，正江南、天寒岁暮。","孤标独立，占断世间香，云屋冷，雪篱深，长记西湖路。","人间尘土，不是留花处。","羌管一声催，碎琼瑶、纷纷似雨。","枝头著子，聊与世调羹，功就后，盍归休，还记来时不。"],"s":"simp","f":"trad"},{"i":"c-78f06d6235f7","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["雪压前村曲径迷。","万山寒立玉参差。","孤舟独钓一蓑归。","别坞时听风折竹，断桥闲看水流澌。","一枝冻蕊出疏篱。"],"s":"simp","f":"trad"},{"i":"c-c5e78faee2bb","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["风卷霜林叶叶飞。","雁横寒影一行低。","淡烟衰草不胜诗。","白酒已篘浮蚁熟，黄鸡未老藁头肥。","问侬不醉待何时。"],"s":"simp","f":"trad"},{"i":"c-157989a72612","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["忆为梅花醉不醒。","断桥流水去无声。","鹭翘沙嘴亦多情。","疏影卧波波不动，暗香浮月月微明。","高楼羌管未须横。"],"s":"simp","f":"trad"},{"i":"c-13b7036f72db","t":"点绛唇","a":"赵长卿","d":"宋","g":"词","p":["离绪千重，角声偏著羁人枕。","那堪酒醒。","句引愁难整。","门锁黄昏，月浸梅花冷。","人初静。","斗垂天迥。","雁落清江影。"],"s":"simp","f":"trad"},{"i":"c-ed58e4b5276b","t":"鹧鸪天","a":"赵长卿","d":"宋","g":"词","p":["门外寒江泊小船。","月明留客小窗前。","夜香烧尽更声远，斗帐低垂暖意生。","醺著酒，炙些灯。","伴他针线懒成眠。","情知今夜鸳鸯梦，不似孤篷宿雁边。"],"s":"simp","f":"trad"},{"i":"c-05fafe081a36","t":"望江南・忆江南","a":"赵长卿","d":"宋","g":"词","p":["山又水，云岫插峰峦。","断雁飞时霜月冷，乱鸦啼处日衔山。","疑在画图间。","金乌转，游子损朱颜。","别泪盈襟双袖湿，春心不放两眉间。","此去几时还。"],"s":"simp","f":"trad"},{"i":"c-5dc0f6d61028","t":"菩萨蛮","a":"赵长卿","d":"宋","g":"词","p":["枫林飒飒凋寒叶。","汀苹败蓼遥相接。","景物已非秋。","凄凉动客愁。","还家贫亦好。","肯厌杯中草。","香饭滑流匙。","三登快乐时。"],"s":"simp","f":"trad"},{"i":"c-95c4a02cdfa5","t":"菩萨蛮","a":"赵长卿","d":"宋","g":"词","p":["霜风飒飒溪山碧。","寒波一望伤行色。","落日淡荒村。","人家半掩门。","孤舟移野渡。","古木栖鸦聚。","著雨晚风酸。","貂裘不奈寒。"],"s":"simp","f":"trad"},{"i":"c-ea61c078da11","t":"菩萨蛮","a":"赵长卿","d":"宋","g":"词","p":["败荷倒尽芙蓉老。","寒光黯淡迷衰草。","行客易销魂。","笛飞何处村。","云寒天借碧。","树瘦烟笼直。","若个是乡关。","夕阳西去山。"],"s":"simp","f":"trad"},{"i":"c-85a9faadce88","t":"阮郎归","a":"赵长卿","d":"宋","g":"词","p":["年年为客遍天涯。","梦迟归路赊。","无端星月浸窗纱。","一枝寒影斜。","肠未断，鬓先华。","新来瘦转加。","角声吹彻小梅花。","夜长人忆家。"],"s":"simp","f":"trad"},{"i":"c-295bd1de6e97","t":"霜天晓角","a":"赵长卿","d":"宋","g":"词","p":["香来不歇。","谁把南枝折。","的砾疏花初破，都因是、夜来雪。","清绝。","十分绝。","孤标难细说。","独立野塘清浅，谁作伴、空夜月。"],"s":"simp","f":"trad"},{"i":"c-79ad6faa27c6","t":"霜天晓角","a":"赵长卿","d":"宋","g":"词","p":["雪花飞歇。","好向前村折。","行至断桥斜处，寒蕊瘦、不禁雪。","韵绝。","香更绝。","归来人共说。","最爱夜堂深迥，疏影占、半窗月。"],"s":"simp","f":"trad"},{"i":"c-6c8b40ad523e","t":"菩萨蛮","a":"赵长卿","d":"宋","g":"词","p":["客帆卸尽风初定。","夜空霜落无江冷。","幸自不思归。","无端乌夜啼。","鸡鸣残月落。","到枕秋声恶。","有酒不须斟。","酒深愁转深。"],"s":"simp","f":"trad"},{"i":"c-927493d860f8","t":"忆秦娥","a":"赵长卿","d":"宋","g":"词","p":["寒萧索。","征鸿过尽离怀恶。","离怀恶。","江空天迥，夜寒枫落。","有人应误刀头约。","情深翻恨郎情薄。","郎情薄。","梦回长是，半床闲却。"],"s":"simp","f":"trad"},{"i":"c-1d36c4d3c25d","t":"如梦令","a":"赵长卿","d":"宋","g":"词","p":["何处一声鸣橹。","惊起满川寒鹭。","一著画难成，雪霁乱山无数。","且住。","且住。","数遍溪南烟树。"],"s":"simp","f":"trad"},{"i":"c-9f355fc16c10","t":"水龙吟","a":"赵长卿","d":"宋","g":"词","p":["危楼横枕清江上，两岸碧山如画。","夕烟幂幂，晚灯点点，楼台新夜。","明月当天，白沙流水，冷光连野。","浸栏干万顷，琉璃软皱，打鱼艇、相高下。","何处一声羌管，是谁家、倚楼人也。","多情对景，无言有恨，欲歌还罢。","把酒临筵，阿谁知我，此怀难写。","忍思量后夜，芳容不似，暗尘随马。"],"s":"simp","f":"trad"},{"i":"c-e9e400ade283","t":"水调歌头","a":"赵长卿","d":"宋","g":"词","p":["离愁晚如织，托酒与消磨。","奈何酒薄愁重，越醉越愁多。","忍对碧天好夜，皓月流光无际，光影转庭柯。","有恨空垂泪，无语但悲歌。","因凝想，从别后，蹙双蛾。","春来底事，孤负紫袖与红靴。","速整雕鞍归去，著意浅斟低唱，细看小婆娑。","万蕊千花里，一任玉颜酡。"],"s":"simp","f":"trad"},{"i":"c-bb4f9e90fb5e","t":"水龙吟","a":"赵长卿","d":"宋","g":"词","p":["酒潮匀颊双眸溜。","美映远山横秀。","风流俊雅，娇痴体态，眼前稀有。","莲步弯弯，移归拍里，凌波难偶。","对仙源醉眼，玉纤笼巧，拨轻声、鱼纹皱。","我自多情多病，对人前、只推伤酒。","瞒他不得，诗情懒倦，沈腰销瘦。","多谢东君，殷勤知我，曲翻红袖。","拼来朝又是，扶头不起，江楼知不。"],"s":"simp","f":"trad"},{"i":"c-cc318ffdc653","t":"念奴娇","a":"赵长卿","d":"宋","g":"词","p":["夕阳底尽，望楚天空阔，稀星帘幕。","暮霭横江烟万缕，照水参差楼阁。","两两三三，楼前归鹭，飞过栏干角。","霜风何事，绕檐吹动寂寞。","消散我已忘机，而今百念，灰了心头火。","对酒当歌浑冷淡，一任他懑嗔恶。","松竹园林，柳梧庭院，自有人间乐。","闲云休问，去来本是无著。"],"s":"simp","f":"trad"},{"i":"c-8ea41dba2f9b","t":"水调歌头","a":"赵长卿","d":"宋","g":"词","p":["贪痴无了日，人事没休期。","白驹过隙，百岁能得几多时。","自古腰金结绶，著意经营辛苦，回首不胜悲。","名未能安稳，身已至倾危。","空剜刻，休巧诈，莫心欺。","须知天定，只见高塚与新碑。","我已从头识破，赢得当歌临酒，欢笑且随宜。","较甚荣和辱，争甚是和非。"],"s":"mixed","f":"trad"},{"i":"c-4048a66ceaa3","t":"水龙吟","a":"赵长卿","d":"宋","g":"词","p":["�稍�著意斟量过，天下事、无穷尽。","贪荣贪富，朝思夕计，空劳方寸。","蹑足封王，功名盖世，谁如韩信。","更堆金积玉，石崇豪侈，当时望、倾西晋。","长乐宫中一叹，又何须累累悬印。","坠楼效死，轻车东市，头膏血刃。","尤物虚名，於身何补，一齐休问。","遇当歌临酒，舒眉展眼，且随缘分。"],"s":"mixed","f":"trad"},{"i":"c-00fba6108bcb","t":"蓦山溪","a":"赵长卿","d":"宋","g":"词","p":["壶天冰雪，消尽虚堂暑。","多谢故人风，送花香传小树。","香风初过，一曲断肠声，如怨诉。","诉闲愁，落落琵琶语。","江边马上，弹指成千古。","泪眼与啼妆，叹风流、只今何处。","芳心役损，触事起悲酸，招玉素。","拨檀槽，整理金衣缕。"],"s":"simp","f":"trad"},{"i":"c-5fde91412e7c","t":"念奴娇","a":"赵长卿","d":"宋","g":"词","p":["精神俊雅，更那堪、天与风流标格。","罗绮丛中偏艳冶，偷处教人怜惜。","目剪秋波，指纤春笋，新样冠儿直。","高堂云雨，甚人有分消得。","忔戏笑里含羞，回眸低盼，此意谁能识。","密约幽欢空怅望，何日能谐端的。","玳席歌馀，兰堂香散，此际愁如织。","人归空对，晚阴庭树横碧。"],"s":"simp","f":"trad"},{"i":"c-5fd7ceb15e00","t":"瑞鹤仙","a":"赵长卿","d":"宋","g":"词","p":["无言屈指也。","算年年底事，长为旅也。","凄惶受尽也。","把良辰美景，总成虚也。","自嗟叹也。","这情怀、如何诉也。","谩愁明怕暗，单栖独宿，怎生禁也。","闲也。","有时临镜，渐觉形容，日消减也。","光阴换也。","空辜负、少年也。","念仙源深处，暖香小院，赢得群花怨也。","是亏他见了，多教骂几句也。"],"s":"simp","f":"trad"},{"i":"c-f2e3921087d5","t":"蓦山溪","a":"赵长卿","d":"宋","g":"词","p":["无非无是。","好个闲居士。","衣食不求人，又识得、三文两字。","不贪不伪，一味乐天真，三径里。","四时花，随分堪游戏。","学些沓拖，也似没意志。","诗酒度流年，熟谙得、无争三昧。","风波歧路，成败霎时间，你富贵。","你荣华，我自关门睡。"],"s":"simp","f":"trad"},{"i":"c-8919027fe75b","t":"青玉案","a":"赵长卿","d":"宋","g":"词","p":["东门杨柳空盈路。","系得征鞍能驻不。","暗绿枝头新过雨。","柔丝千尺，乳莺百啭，似怨行人去。","行人去后如何处。","去向天边簉鹓鹭。","瑶管琼台多雅趣。","花砖稳上，玉阶阔步，肯念人尘土。"],"s":"simp","f":"trad"},{"i":"c-64aa806340e3","t":"虞美人","a":"赵长卿","d":"宋","g":"词","p":["雨声破晓催行桨。","拍拍溪流长。","绿杨绕岸水痕斜。","恰似画桥西畔、那人家。","人家楼阁临江渚。","应是停歌舞。","珠帘整日不闲钩。","目断征帆、犹未识归舟。"],"s":"simp","f":"trad"},{"i":"c-5158403b48ed","t":"虞美人","a":"赵长卿","d":"宋","g":"词","p":["灯前忍见啼红面。","别酒频斟劝。","愁蛾敛翠不胜情。","报道看看天色、待平明。","殷勤重把阳关唱。","休要教人望。","出门犹自尚叮咛。","厮养频催恰好、趁凉行。"],"s":"simp","f":"trad"},{"i":"c-faec15d8d936","t":"临江仙","a":"赵长卿","d":"宋","g":"词","p":["十里春风杨柳路，年年带雨披云。","柔条万缕不胜情。","还将无意眼，识遍有心人。","饿损宫腰终不似，效颦总是难成。","只愁秋色入高林。","残蝉和落叶，此际不堪论。"],"s":"simp","f":"trad"},{"i":"c-42cda45705f7","t":"渔家傲","a":"赵长卿","d":"宋","g":"词","p":["客里情怀谁可表。","凄凉举目知多少。","强饮强歌还强笑。","心悄悄。","从头彻底思量了。","当日相逢非草草。","果然恩爱成烦恼。","稳整征鞍归去好。","重厮守。","相期待与同偕老。"],"s":"simp","f":"trad"},{"i":"c-98baca3da34e","t":"江神子・江城子","a":"赵长卿","d":"宋","g":"词","p":["当时得意两心齐。","绮窗西。","共于飞。","拂掠宫妆，长与画新眉。","一自别来烟水阔，愁易积，梦还稀。","相逢恰似旧家时。","恨依依。","语低低。","多少关情，冷暖有谁知。","只此定应谐素愿，但指日，约鸾栖。"],"s":"simp","f":"trad"},{"i":"c-34753818d0a0","t":"御街行","a":"赵长卿","d":"宋","g":"词","p":["香熏斗帐相逢乍。","正宫漏、沈沈夜。","月飞梅影上帘栊，标致风流娇雅。","眼波横浸，照人百媚，无限叮咛话。","玉鞍门上嘶归马。","趱行色、难留也。","别来花艳不禁春，浪向东风轻嫁。","空馀小院，博山修竹，依旧窗儿下。"],"s":"simp","f":"trad"},{"i":"c-0886332b35cc","t":"一丛花","a":"赵长卿","d":"宋","g":"词","p":["当歌临酒恨难穷。","酒不似愁浓。","风帆正起归与兴，岸东西、芳草茸茸。","楚梦乍回，吴音初听，谁念我孤踪。","藏春小院暖融融。","眼色与心通。","乌云有意重梳掠，便安排、金屋房栊。","云雨厚因，鸳鸯宿债，作个好家风。"],"s":"simp","f":"trad"},{"i":"c-0a5f5be9b96a","t":"天仙子","a":"赵长卿","d":"宋","g":"词","p":["眼色媚人娇欲度。","行尽巫阳云又雨。","花时还复见芳姿，情几许。","愁何许。","莫向耳边传好语。","往事悠悠曾记否。","忍听黄鹂啼锦树。","啼声惊碎百花心。","分付与。","谁为主。","落蕊飞红知甚处。"],"s":"simp","f":"trad"},{"i":"c-ed5c72335e6b","t":"瑞鹧鸪","a":"赵长卿","d":"宋","g":"词","p":["宝奁常见晓妆时。","面药香融傅口脂。","扰扰亲曾撩绿鬓，纤纤巧与画新眉。","浓欢已散西风远，忆泪无多为你垂。","各自从今好消遣，莫将红叶浪题诗。"],"s":"simp","f":"trad"},{"i":"c-aa10da4dff40","t":"瑞鹧鸪","a":"赵长卿","d":"宋","g":"词","p":["结丝千绪不胜愁。","莫怪安仁鬓早秋。","檀口未歌先愠泪，柳眉将敛半凝羞。","杯倾潋滟送行酒，岸舣飘飘欲去舟。","待得名登天府后，归来茱菊映钗头。"],"s":"simp","f":"trad"},{"i":"c-f9e1f322a5a3","t":"行香子","a":"赵长卿","d":"宋","g":"词","p":["骄马花骢。","柳陌经从。","小春天、十里和风。","个人家住，曲巷墙东。","好轩窗，好体面，好仪容。","烛灺歌慵。","斜月朦胧。","夜新寒、斗帐香浓。","梦回画角，云雨匆匆。","恨相逢，恨分散，恨情锺。"],"s":"simp","f":"trad"},{"i":"c-0dc5a25aade2","t":"夜行船","a":"赵长卿","d":"宋","g":"词","p":["龟甲炉烟轻袅。","帘栊静、乳莺啼晓。","拂掠新妆，时宜头面，绣草冠儿小。","衫子揉蓝初著了。","身材称、就中恰好。","手拈双纨，菱花重照，带朵宜男草。"],"s":"simp","f":"trad"},{"i":"c-7b1dfb93a362","t":"采桑子","a":"赵长卿","d":"宋","g":"词","p":["疏帘乍卷孜孜看，冰玉精神。","体白停匀。","端的于人不薄情。","更无背约和焦燥，各表真诚。","才得相亲。","切莫分张向别人。"],"s":"simp","f":"trad"},{"i":"c-0adc105657fc","t":"蝶恋花","a":"赵长卿","d":"宋","g":"词","p":["闲上西楼供远望。","一曲新声，巧媚谁家唱。","独倚危栏听半晌。","长江快泻澄无浪。","清泪恰同清水涨。","拭尽重流，触事如何向。","不觉黄昏灯已上。","旧愁还是新愁样。"],"s":"simp","f":"trad"},{"i":"c-2584b90a0b5d","t":"蝶恋花","a":"赵长卿","d":"宋","g":"词","p":["天净姮娥初整驾。","桂魄蟾辉，来趁清和夜。","费尽丹青无计画。","纤纤侧向疏桐挂。","人在扶疏桐影下。","耳畔轻轻，细说家常话。","年少难留应不借。","未歌先咽歌还罢。"],"s":"simp","f":"trad"},{"i":"c-824a425f7fc2","t":"蝶恋花","a":"赵长卿","d":"宋","g":"词","p":["叶底蜂衙催日晚。","向晚匀妆，巧画宫眉浅。","翠幕无风香自远。","金船酌酒须教满。","未说别离魂已断。","雨幌云屏，只恐良宵短。","心事不随飞絮乱。","宦情肯把恩情换。"],"s":"simp","f":"trad"},{"i":"c-2331d9264e38","t":"鹧鸪天","a":"赵长卿","d":"宋","g":"词","p":["睡觉扶头听晓钟。","隔帘花雾湿香红。","翠摇钿砌梧桐影，暖透罗襦芍药风。","闲对影，记曾逢。","画眉临镜霎时同。","相思已有无穷恨，忍见孤鸾宿镜中。"],"s":"simp","f":"trad"},{"i":"c-9929b13b891b","t":"鹧鸪天","a":"赵长卿","d":"宋","g":"词","p":["宝篆烟消香已残。","蝉娟月色浸栏干。","歌喉不作寻常唱，酒令从他各自还。","传杯手，莫教闲。","醉红潮脸媚酡颜。","相携共学骖鸾侣，却笑卢郎旧约寒。"],"s":"simp","f":"trad"},{"i":"c-bf6bf6c5d05f","t":"鹧鸪天","a":"赵长卿","d":"宋","g":"词","p":["绿水澄江得胜游。","浪平风软称轻舟。","樽前我易伤前事，柳外人谁独倚楼。","空感慨，惜风流。","风流赢得谩多愁。","愁多著甚销磨得，莫怪安仁鬓早秋。"],"s":"simp","f":"trad"},{"i":"c-42a5f4a9e94d","t":"鹧鸪天","a":"赵长卿","d":"宋","g":"词","p":["一曲清歌金缕衣。","巧佼心事有谁知。","自从别后难相见，空解题红寄好诗。","忆携手，过阶墀。","月笼花影半明时。","玉钗头上轻轻颤，摇落钗头豆蔻枝。"],"s":"simp","f":"trad"},{"i":"c-fb59314e5858","t":"眼儿媚","a":"赵长卿","d":"宋","g":"词","p":["人随社节去匆匆。","此恨几时穷。","阳台寂寞，巫山凄惨，云雨成空。","芭蕉密处窗儿下，冷落旧香中。","黄昏静也，蛩声满院，明月清风。"],"s":"simp","f":"trad"},{"i":"c-630cb710b4c1","t":"眼儿媚","a":"赵长卿","d":"宋","g":"词","p":["槐阴密处啭黄鹂。","午日正长时。","一番过雨，绿荷池面，冷浸琉璃。","红尘不到华堂里，纤楚对蛾眉。","笑偎人道，新词觅个，美底腔儿。"],"s":"simp","f":"trad"},{"i":"c-41197e53d965","t":"眼儿媚","a":"赵长卿","d":"宋","g":"词","p":["当年策马过钱塘。","曲径小平康。","繁红酽白，娇莺姹燕，争唤何郎。","而今又客东风里，浑不似寻常。","只愁别后，月房云洞，啼损红妆。"],"s":"simp","f":"trad"},{"i":"c-22c7610aa63f","t":"临江仙","a":"赵长卿","d":"宋","g":"词","p":["蕊嫩花房无限好，东风一样春工。","百年欢笑酒樽同。","笙吹雏凤语，裙染石榴红。","且向五云深处住，锦衾绣幌从容。","如何即是出樊笼。","蓬莱人少到，云雨事难穷。"],"s":"simp","f":"trad"},{"i":"c-1ee9e6693151","t":"临江仙","a":"赵长卿","d":"宋","g":"词","p":["破靥盈盈巧笑，举杯滟滟迎逢。","慧心端有谢娘风。","烛花香雾，娇困面微红。","别恨彩笺虽寄，清歌浅酌难同。","梦回楚馆雨云空。","相思春暮，愁满绿芜中。"],"s":"simp","f":"trad"},{"i":"c-498df257f6c4","t":"临江仙","a":"赵长卿","d":"宋","g":"词","p":["夜久笙箫吹彻，更深星斗还稀。","醉拈裙带写新诗。","锁窗风露，烛灺月明时。","水调悠扬声美，幽情彼此心知。","古香烟断彩云归。","满倾蕉叶，齐唱传花枝。"],"s":"simp","f":"trad"},{"i":"c-a90558f2ff2a","t":"惜奴娇","a":"赵长卿","d":"宋","g":"词","p":["洛浦娇魂，恐得到、人间少。","把风流、分付花貌。","六出精神，腊寒射、香试到。","清秀。","与江梅、争相先后。","檐卜粗疏，怎似妖娆体调。","比山樊、也应错道。","最是殷勤，捧出金盏银台笑。","拼了。","仙源与、奇葩醉倒。"],"s":"simp","f":"trad"},{"i":"c-32536b5f8ec8","t":"水龙吟","a":"赵长卿","d":"宋","g":"词","p":["无情风掠芭蕉响，还是重门已闭。","银缸独对，相思方切，教人怎睡。","解叹从前事，解叹了、依前鳖气。","想他家那里，知人憔悴，相应是、睡也未。","且恁和衣强寝，奈无寐、依前重起。","起来思想，当初与你，忒煞容易。","及至而今也，半头天眼，不存不济。","最消魂苦是，黄昏前后，冷清清地。"],"s":"simp","f":"trad"},{"i":"c-fde138ccad7e","t":"水调歌头","a":"赵长卿","d":"宋","g":"词","p":["把酒相劳苦，月色耀天章。","冰轮碾破寒碧，飞入酒樽凉。","击节词人妙句，吸此清辉万丈，肺腑亦生光。","揽袂欲仙举，逸兴共天长。","日边客，幕中俊，坐间狂。","浩歌清啸，恍然云海渺茫茫。","唤醒谪仙苏二，何事常愁客少，更恐被云妨。","月与人长好，广大醉为乡。"],"s":"simp","f":"trad"},{"i":"c-44cfa61a1b56","t":"水龙吟","a":"赵长卿","d":"宋","g":"词","p":["先来天与精神，更因丽景添殊态。","拖轻苒苒，才凝一段，还分五彩。","毕竟非烟，有时为雨，惹情无奈。","道无心，怎被歌声遏断，迟迟向、青天外。","宜伴先生醉卧，得饶道、和山须买。","也曾恼杀襄王，谁道依前不会。","我欲乘风归去，翻怅恨、帝乡何在。","念佳期未展，天长莫合，尽空相对。"],"s":"simp","f":"trad"},{"i":"c-1d1ca5803fed","t":"诉衷情","a":"赵长卿","d":"宋","g":"词","p":["花前月下会鸳鸯。","分散两情伤。","临行祝付真意，臂间皓齿留香。","还更毒，又何妨。","尽成疮。","疮儿可后，痕儿见在，见后思量。"],"s":"simp","f":"trad"},{"i":"c-151f3e9cd615","t":"满江红","a":"赵长卿","d":"宋","g":"词","p":["懊恼平生，奈天赋、恩情太薄。","二三岁、看伊受尽，眼尖眉角。","记得当初低耳畔，是谁先有于飞约。","惟到今、划地误盟言，还先恶。","天眼见，人难度。","天易感，人难托。","人心险，天又怎生捉摸。","莫问傍人非与是，手儿但把心儿托。","便不成、厮守许多时，乾休却。"],"s":"mixed","f":"trad"},{"i":"c-233daf2a4f7b","t":"贺新郎","a":"赵长卿","d":"宋","g":"词","p":["负你千行泪。","大都来、一寸心儿，万般萦系。","似恁愁烦那里洎。","故自三年二岁。","为你后、甘心憔悴。","终待说、山盟海誓。","这恩情、到此非容易。","拼做个，久长计。","紧要事须评议。","怕人人、蓦地知时，怎生处置。","毒害心肠祆知是。","怕你生烦到底。","便莫待、将人轻弃。","不是我多疑你。","被傍人、赚后失圈圚。","经一事，长一智。"],"s":"simp","f":"trad"},{"i":"c-da52501a5e7d","t":"眼儿媚","a":"赵长卿","d":"宋","g":"词","p":["连沧危观暮江前。","几醉使君筵。","少年俊气，曾将吟笔，买断江天。","重来细把朋游数，回首一辛酸。","兰成已老，文园多病，负此江山。"],"s":"simp","f":"trad"},{"i":"c-8ca455df8976","t":"簇水","a":"赵长卿","d":"宋","g":"词","p":["长忆当初，是他见我心先有。","一钩才下，便引得鱼儿开口。","好是重门深院，寂寞黄昏后。","厮觑著、一面儿酒。","试撋就。","便把我、得人意处，闵子里、施纤手。","云情雨意，似十二巫山旧。","更向枕前言约，许我长相守。","忺人也，犹自眉头皱。"],"s":"simp","f":"trad"},{"i":"c-3ae4110cda5f","t":"摊破丑奴儿・采桑子","a":"赵长卿","d":"宋","g":"词","p":["最苦是离愁。","行坐里、只在心头。","待要作个巫山梦，孤衾展转，无眠到晓，和梦都休。","梦里也无由。","谁敢望、真个绸缪。","暂时不见浑闲事，只愁柳絮杨花，自来摆荡难留。"],"s":"simp","f":"trad"},{"i":"c-9e24f9127a68","t":"更漏子","a":"赵长卿","d":"宋","g":"词","p":["烛消红，窗送白。","冷落一衾寒色。","鸦唤起，马忘行","月来衣上明。","酒香唇，妆印臂。","亿共人人睡。","魂蝶乱，梦鸾孤。","知他睡也无。"],"s":"simp","f":"trad"},{"i":"c-ad9c33b07833","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["一味风流一味香。","十分浓艳十分妆。","自然娇态自然芳。","楼上好风楼下水，雪前栏槛竹前窗。","也宜单著也宜双。"],"s":"simp","f":"trad"},{"i":"c-7a8495c69b41","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["恻恻笙竽万籁风。","阳关叠遍酒尊空。","相逢草草别匆匆。","满眼泪珠和雨洒，一襟愁绪抵秋浓。","相思今夜五云东。"],"s":"simp","f":"trad"},{"i":"c-1ba315f4e72f","t":"汉宫春","a":"赵长卿","d":"宋","g":"词","p":["讲柳谈花，我从来口快，忺说他家。","眼前见了，无限楚女吴娃。","千停万稳，较量来、终不如他。","便做得，宫仪院体，歌谈不带烟花。","从前万事堪夸。","爱拈笺弄管，锦字敧斜。","新来与人臑著，不许胡巴。","嚎懑谩惹，料福缘、浅似他些。","谁为我，传诗递曲，殷勤题上窗纱。"],"s":"simp","f":"trad"},{"i":"c-f9191fa9d577","t":"雨中花慢","a":"赵长卿","d":"宋","g":"词","p":["帊子分香，罗巾拭泪，别来时、未觅凄惶。","上得船儿来了，剗地凄凉。","可惜花前月里，却成水远山长。","做成恩爱，如今赢得，万里千乡。","情知这场寂寞，不干你事，伤我穷忙。","不道是、久长活路，终要称量。","我则匆匆归去，知你且、种种随娘。","下梢睚彻，有时共你风光。"],"s":"mixed","f":"trad"},{"i":"c-252e26b74d7b","t":"柳梢青","a":"赵长卿","d":"宋","g":"词","p":["小窗闲适。","云髻亸肩，香肌偎膝。","玉局无尘，明琼欲碎，春纤同掷。","不争百万呼卢，赌今夜、鸳帷痛惜。","好忍马儿，若还输了，当甚则剧。"],"s":"simp","f":"trad"},{"i":"c-c03c3a354288","t":"南歌子","a":"赵长卿","d":"宋","g":"词","p":["梅萼和霜晓，梨花带雪春。","玉肌琼艳本无尘。","肯把铅华容易、污天真。","汤饼尝初罢，罗巾拭转新。","几回贪耍失黄昏。","月里归来无处、觅精神。"],"s":"simp","f":"trad"},{"i":"c-a875112b02a5","t":"临江仙","a":"赵长卿","d":"宋","g":"词","p":["人在梦云楼上别，残灯影里迟留。","依稀绿惨更红羞。","露痕双脸湿，山样两眉愁。","几幅片帆天际去，云涛烟浪悠悠。","今宵独立古江头。","水腥鱼菜市，风碎荻花舟。"],"s":"simp","f":"trad"},{"i":"c-882cdd179ecd","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["画角声沈卷暮霞。","寒生促索锦屏遮。","沈檀半爇髻堆鸦。","蝴蝶梦回馀烛影，子规啼处隔窗纱。","夜深明月浸梨花。"],"s":"simp","f":"trad"},{"i":"c-df7ee46c4632","t":"浪淘沙","a":"赵长卿","d":"宋","g":"词","p":["帘卷露花容。","几度相逢。","他知我意欲相通。","偏奈天教多阻间，积恨何穷。","云雨杳无踪。","愁怕东风。","时闻语笑恣欢浓。","惟有俺咱真分浅，往事成空。"],"s":"simp","f":"trad"},{"i":"c-72a9ef60f9b6","t":"如梦令","a":"赵长卿","d":"宋","g":"词","p":["竹外半窥娇面。","真个出尘体段。","没处可偷怜，空恁眼穿肠断。","休恋。","休恋。","只是与伊分浅。"],"s":"simp","f":"trad"},{"i":"c-33a566b752c3","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["闲理丝簧听好音。","西楼剪烛夜深深。","半嗔半喜此时心。","暖语温存无恙语，韵开香靥笑吟吟。","别来烦恼到如今。"],"s":"simp","f":"trad"},{"i":"c-80f92faeccac","t":"减字木兰花","a":"赵长卿","d":"宋","g":"词","p":["阳关唱彻。","断尽离肠声哽咽。","酒已三巡。","今夜王孙是路人。","此情难说。","莫负等闲风与月。","欲问归期。","来戴钗头艾虎儿。"],"s":"simp","f":"trad"},{"i":"c-a7dd29605bdf","t":"减字木兰花","a":"赵长卿","d":"宋","g":"词","p":["半窗斜月。","茅店萧条灯已灭。","床下蛩声。","声动凄凉不忍听。","终宵无寐。","覆去翻来真个是。","屈指归期。","应是梅花烂熳时。"],"s":"simp","f":"trad"},{"i":"c-d841ed361d07","t":"夜行船","a":"赵长卿","d":"宋","g":"词","p":["短棹轻舟排办了。","歌声断、晚霞残照。","红蓼坡头，绿杨堤外，离恨知多少。","别后莫教音信杳。","叹光阴、初自来堪笑。","画角谯门，槐溪归路，正是楚天清晓。"],"s":"simp","f":"trad"},{"i":"c-3212e4b95e82","t":"眼儿媚","a":"赵长卿","d":"宋","g":"词","p":["玉楼初见念奴娇。","无处不妖娆。","眼传密意，樽前烛外，怎不魂消。","西风明月相逢夜，枕簟正凉宵。","殢人记得，叮咛残漏，且慢明朝。"],"s":"simp","f":"trad"},{"i":"c-4ab9577744c7","t":"品令","a":"赵长卿","d":"宋","g":"词","p":["黄昏时候，诮不语、心如醉。","无眠凝想，别来绣阁，多应憔悴。","上了灯儿，知是睡哩坐哩。","蓦思归计。","又还是重屈指。","从今已后，暌离千万，且休容易。","这底凄惶，你看是谁不是。"],"s":"simp","f":"trad"},{"i":"c-e11e01c617cc","t":"柳梢青","a":"赵长卿","d":"宋","g":"词","p":["甜言软语。","长记那时，萧娘叮嘱。","清管危弦，前欢难断，鳞鸿无据。","纷纷眼底浮花，拈弄动、几多思虑。","千结丁香，且须珍重，休胡分付。"],"s":"simp","f":"trad"},{"i":"c-ba5a18a36fe7","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["金兽喷香瑞霭氛。","夜凉如水酒醺醺。","照人娇眼媚生春。","我自愁多魂已断，不禁楚雨带巫云。","人情又是一番新。"],"s":"simp","f":"trad"},{"i":"c-594eff1317b7","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["坐看销金暖帐中。","羔儿酒美兽煤红。","浅斟低唱好家风。","爱客东君多解事，晚妆新与画眉峰。","便须催唤出房栊。"],"s":"simp","f":"trad"},{"i":"c-b626c99548f7","t":"浣溪沙","a":"赵长卿","d":"宋","g":"词","p":["堆枕冠儿翡翠钗。","蒙金领子满絣鞋。","于中沈净好情怀。","新欲晚凉梳洗罢，半娇微笑下堂来。","莲花因甚未曾开。"],"s":"simp","f":"trad"},{"i":"c-8158d63dd5f5","t":"临江仙","a":"赵长卿","d":"宋","g":"词","p":["天外浓云云外雨，雨声初上檐牙。","红蕖应褪洗妆花。","晚凉如有意，霫霫到山家。","为唤山童多索酒，金锺细酌流霞。","晕生玉颊酒潮斜。","闲中无宠辱，醉里是生涯。"],"s":"simp","f":"trad"},{"i":"c-b5b9ae0a2524","t":"夜行船","a":"赵长卿","d":"宋","g":"词","p":["绿盖红幢笼碧水。","鱼跳处、浪痕匀碎。","惜别殷勤，留连无计，歌声与、泪和柔脆。","一叶扁舟烟浪里。","曲滩头、此情无际。","窈窕眉山，暮霞红处，雨云想、翠峰十二。"],"s":"simp","f":"trad"},{"i":"c-8fa029612d22","t":"浪淘沙","a":"赵长卿","d":"宋","g":"词","p":["窈窕绣帏深。","窈窕娉婷。","梅花初试晚妆新。","那更娇痴年纪小，冰雪精神。","举措忒轻盈。","歌彻新声。","柔肠魂断不堪听。","但恐巫山留不住，飞作行云。"],"s":"simp","f":"trad"},{"i":"c-25b108410ba0","t":"如梦令","a":"赵长卿","d":"宋","g":"词","p":["居士年来懒散。","凡事只从宽简。","身外更无求，祗要夏凉冬暖。","美满。","美满。","得过何须积趱。"],"s":"simp","f":"trad"},{"i":"c-0a65214672de","t":"卜算子","a":"赵长卿","d":"宋","g":"词","p":["十载仰高明，一见心相许。","来日孤舟西水门。","风饱征帆腹。","后夜起相思，明月清江曲。","若见秋风寒雁来，能寄音书否。"],"s":"simp","f":"trad"},{"i":"c-7aad322aa2fe","t":"眼儿媚","a":"赵长卿","d":"宋","g":"词","p":["先来客路足伤悲。","那更话别离。","玉骢也解，知人欲去，骧首频嘶。","马蹄动是三千里，后会莫相违。","切须更把，丁香珍重，待我重期。"],"s":"simp","f":"trad"},{"i":"c-83deed56acc1","t":"南乡子","a":"赵长卿","d":"宋","g":"词","p":["楚楚窄衣裳。","腰身占却，多少风光。","共说春来春去事，凄凉。","懒对菱花晕晓妆。","闲立近红芳。","游峰戏蝶，误采真香。","何事不归巫峡去，思量。","故来尘世断人肠。"],"s":"simp","f":"trad"},{"i":"c-aeed19882ab1","t":"南乡子","a":"赵长卿","d":"宋","g":"词","p":["月转水晶盘。","楼上初闻一鼓残。","又是去年天气好，栏干。","风动梅梢玉斗寒。","无奈壮情阑。","对酒如何欲强欢。","谁道破愁须仗酒，君看。","酒到愁多破亦难。"],"s":"simp","f":"trad"},{"i":"c-dfdfcb0ff15e","t":"谒金门","a":"赵长卿","d":"宋","g":"词","p":["灯乍灭。","忽见一天明月。","恰舞霓裳歌未歇。","露寒回绛阙。","羽服明晖玉雪。","笑语轻参环玦。","香泽恼人情不彻。","夜长窗自白。"],"s":"simp","f":"trad"},{"i":"c-78473a709504","t":"点绛唇","a":"赵长卿","d":"宋","g":"词","p":["云亸宫鬟，淡黄衫子轻香透。","晚凉时候。","睡起新妆就。","冰枕生寒，玉浸纤纤手。","沈吟久。","眉山敛秀。","爱道奴家瘦。"],"s":"mixed","f":"trad"}]