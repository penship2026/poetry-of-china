[{"i":"c-dbd91cd29502","t":"桃源忆故人","a":"朱敦儒","d":"宋","g":"词","p":["谁能留得朱颜住。","枉了百般辛苦。","争似萧然无虑。","任运随缘去。","人人放著逍遥路。","只怕君心不悟。","弹指百年今古。","有甚成亏处。"]},{"i":"c-2a7b0a506d72","t":"桃源忆故人","a":"朱敦儒","d":"宋","g":"词","p":["玉笙吹彻清商后。","寂寞弓弯舞袖。","巧画远山不就。","只为眉长皱。","灵犀望断星难透。","立到凄凉时候。","今夜月明如昼。","人共梅花瘦。"]},{"i":"c-cd644b079ca3","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["春雨细如尘，楼外柳丝黄湿。","风约绣帘斜去，透窗纱寒碧。","美人慵翦上元灯，弹泪倚瑶瑟。","却上紫姑香火，问辽东消息。"]},{"i":"c-755a3685d0e3","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["春雨挠元宵，花绽柳眠无力。","风峭画堂帘幕，卷金泥红湿。","王孙开宴聚娇饶，越山洗愁碧。","休说凤凰城里，少年时踪迹。"]},{"i":"c-2c3233327918","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["惊见老仙来，触目琳琅奇绝。","打酒道人林下，奏醉翁三叠。","接䍦倾倒海云飞，物色又催别。","回棹晚江春雨，胜剡溪风雪。"]},{"i":"c-854665bc5a24","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["春去尚堪寻，莫恨老来难却。","且趁禁烟百七，醉残英馀萼。","坐间玉润赋妍辞，情语见真乐。","引满瘿杯竹盏，胜黄金凿落。"]},{"i":"c-25e1f8753760","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["摇首出红尘，醒醉更无时节。","活计绿蓑青笠，惯披霜冲雪。","晚来风定钓丝闲，上下是新月。","千里水天一色，看孤鸿明灭。"]},{"i":"c-a8b6dd67a11f","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["眼里数闲人，只有钓翁潇洒。","已佩水仙宫印，恶风波不怕。","此心那许世人知，名姓是虚假。","一棹五湖三岛，任船儿尖耍。"]},{"i":"c-170d045944e0","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["渔父长身来，只共钓竿相识。","随意转船回棹，似飞空无迹。","芦花开落任浮生，长醉是良策。","昨夜一江风雨，都不曾听得。"]},{"i":"c-c39921b64d3b","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["拨转钓鱼船，江海尽为吾宅。","恰向洞庭沽酒，却钱塘横笛。","醉颜禁冷更添红，潮落下前碛。","经过子陵滩畔，得梅花消息。"]},{"i":"c-2efa614568f2","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["短棹钓船轻，江上晚烟笼碧。","塞雁海鸥分路，占江天秋色。","锦鳞拨刺满蓝鱼，取酒价相敌。","风顺片帆归去，有何人留得。"]},{"i":"c-ebe1647c84f4","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["猛向这边来，得个信音端的。","天与一轮钓线，领烟波千亿。","红尘今古转船头，鸥鹭已陈迹。","不受世间拘束，任东西南北。"]},{"i":"c-e7cb859626aa","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["绿泛一瓯云，留住欲飞胡蝶。","相对夜深花下，洗萧萧风月。","从容言笑醉还醒，争忍便轻别。","只愿主人留客，更重斟金叶。"]},{"i":"c-68ce351583d1","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["失却故山云，索手指空为客。","莼菜鲈鱼留我，住鸳鸯湖侧。","偶然添酒旧壶卢，小醉度朝夕。","吹笛月波楼下，有何人相识。"]},{"i":"c-b0279ec99e46","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["深住小溪春，好在柳枝桃叶。","风澹水轩人静，数双飞胡蝶。","日长时有一莺啼，兰佩为谁结。","销散旧愁新恨，泛琴心三叠。"]},{"i":"c-503f430d2bf6","t":"好事近","a":"朱敦儒","d":"宋","g":"词","p":["我不是神仙，不会炼丹烧药。","只是爱闲耽酒，畏浮名拘缚。","种成桃李一园花，真处怕人觉。","受用现前活计，且行歌行乐。"]},{"i":"c-6a52f56df4c1","t":"长相思","a":"朱敦儒","d":"宋","g":"词","p":["昨日晴。","今日阴。","楼下飞花楼上云。","阑干双泪痕。","江南人。","江北人。","一样春风两样情。","晚寒潮未平。"]},{"i":"c-73d55f0e024e","t":"长相思","a":"朱敦儒","d":"宋","g":"词","p":["海云黄。","橘洲霜。","如箭滩流石似羊。","溪船十丈长。","人难量。","水难量。","过险方知著甚忙。","归休老醉乡。"]},{"i":"c-84d6b97bcf80","t":"乌夜啼","a":"朱敦儒","d":"宋","g":"词","p":["翦胜迎春后，和风入律频催。","前回下叶飞霜处，红绽一枝梅。","正遇时调玉烛，须添酒满金杯。","寻芳伴侣休闲过，排日有花开。"]},{"i":"c-0a31840a2234","t":"沙塞子","a":"朱敦儒","d":"宋","g":"词","p":["万里飘零南越，山引泪、酒添愁。","不见凤楼龙阙、又惊秋。","九日江亭闲望，蛮树绕，瘴云浮。","肠断红蕉花晚、水西流。"]},{"i":"c-d31aa245bdb8","t":"沙塞子","a":"朱敦儒","d":"宋","g":"词","p":["蛮径寻春春早，千点雪，已飞梅。","席地插花传酒、日西催。","莫作楚囚相泣，倾银汉，洗瑶池。","看尽人间桃李、拂衣归。"]},{"i":"c-195a286d5d73","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["澹澹薰风庭院，青青过雨园林。","铜驼陌上旧莺声。","今日江边重听。","落帽酒中有趣，题桥琴里无心。","香残沈水缕烟轻。","花影阑干人静。"]},{"i":"c-eb41206ae4e5","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["琴上金星正照，砚中鸖眼相青。","闲来自觉有精神。","心海风恬浪静。","且喜面前花好，更听林外莺新。","瓮头清辣洞庭春。","醉里徐行路稳。"]},{"i":"c-960f6a5fb2e3","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["元是西都散汉，江南今日衰翁。","从来颠怪更心风。","做尽百般无用。","屈指八旬将到，回头万事皆空。","云间鸿雁草间虫。","共我一般做梦。"]},{"i":"c-81be6d834d33","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["穷后常如囚系，老来半似心风。","饥蚊饿蚤不相容。","一夜何曾做梦。","被我不扇不捉，廓然总是虚空。","寺钟官角任西东。","别弄些儿骨董。"]},{"i":"c-a71825d5ccef","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["世事短如春梦，人情薄似秋云。","不须计较苦劳心。","万事原来有命。","幸遇三杯酒好，况逢一朵花新。","片时欢笑且相亲。","明日阴晴未定。"]},{"i":"c-e4824cd58ec9","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["日日深杯酒满，朝朝小圃花开。","自歌自舞自开怀。","且喜无拘无碍。","青史几番春梦，黄泉多少奇才。","不须计较与安排。","领取而今现在。"]},{"i":"c-a9aded1357a2","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["正月天饶阴雨，江南寒在晨朝。","娇莺声袅杏花梢。","暗澹绿窗春晓。","好梦空留被在，新愁不共香销。","小楼帘卷路迢迢。","望断天涯芳草。"]},{"i":"c-c90a3a9baca8","t":"西江月","a":"朱敦儒","d":"宋","g":"词","p":["织素休寻往恨，攀条幸有前缘。","隔河彼此事经年。","且说蓬莱清浅。","障面重新团扇，倾鬟再整花钿。","歌云舞雪画堂前。","长共阿郎相见。"]},{"i":"c-eb93a338ae23","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["挼花弄扇。","碧斗遥山眉黛晚。","白玉阑干。","倚遍春风翠袖寒。","难寻可见。","何似一双青翅燕。","人瘦春残。","芳草连云日下山。"]},{"i":"c-4b69c84f7de9","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["寻花携李。","红漾轻舟汀柳外。","小簇春山。","溪雨岩云不饱帆。","相逢心醉。","容易堆盘银烛泪。","痛饮何言。","犀箸敲残玉酒船。"]},{"i":"c-38b0ca7ca176","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["东风桃李。","春水绿波花影外。","载酒胥山。","祓禊相期落锦帆。","吾曹一醉。","却笑新亭人有泪。","相对清言。","不觉黄昏雨打船。"]},{"i":"c-a5e02967c9bd","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["闲人行李。","羽扇芒鞋尘世外。","一叠溪山。","也解分风送客帆。","时平易醉。","无复惊心并溅泪。","长揖忘言。","回棹桃花插满船。"]},{"i":"c-b8b25e44b4c4","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["刘郎已老。","不管桃花依旧笑。","要听琵琶。","重院莺啼觅谢家。","曲终人醉。","多似浔阳江上泪。","万里东风。","国破山河落照红。"]},{"i":"c-93871c766987","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["慵歌怕酒。","今日春衫惊著瘦。","双燕帘栊。","金鸭香沈客泪中。","琵琶重听。","谁信人间多少恨。","落日东风。","吹得桃花满院红。"]},{"i":"c-a00b107152a3","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["古人误我。","独舞西风双泪堕。","鹤去无踪。","木落西陵返照红。","人间难住。","掷下酒杯何处去。","楼锁钟残。","山北山南两点烟。"]},{"i":"c-87b230220d17","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["无知老子。","元住渔舟樵舍里。","暂借权监。","持节纡朱我甚惭。","不能者止。","免苦龟肠忧虎尾。","身退心闲。","剩向人间活几年。"]},{"i":"c-ffa4703a0432","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["斫鱼作鮓。","酒面打开香可醡。","相唤同来。","草草杯盘饮几杯。","人生虚假。","昨日梅花今日谢。","不醉何为。","从古英雄总是痴。"]},{"i":"c-b84ae3a37f75","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["今年梅晚。","懒趁寿阳钗上燕。","月唤霜催。","不肯人间取次开。","低鬟掩袂。","愁寄玉阑金井外。","粉瘦香寒。","独抱深心一点酸。"]},{"i":"c-440ecff42d97","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["无人惜我。","我自殷勤怜这个。","恧峭惺惺。","不肯随人独自行。","乾坤许大。","只在棘针尖上坐。","依旧多情。","搂著虚空睡到明。"]},{"i":"c-80236881c556","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["年衰人老。","矍铄支离君莫笑。","白日青天。","我自心情胜少年。","超凡入妙。","游戏神通随意到。","酒圣诗仙。","舞棹虚空驾铁船。"]},{"i":"c-69b737bc4a49","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["虚空无碍。","你自痴迷不自在。","撒手游行。","到处笙歌拥路迎。","天然美满。","不用些儿心计算。","莫听先生。","引入深山百丈坑。"]},{"i":"c-10b0649db271","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["无人请我。","我自铺毡松下坐。","酌酒栽诗。","调弄梅花作侍儿。","心欢易醉。","明月飞来花下睡。","醉舞谁知。","花满纱巾月满怀。"]},{"i":"c-41ca37001c69","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["花随人去。","今夜钱塘江上雨。","宿酒残更。","潮过西窗不肯明。","小罗金缕。","结尽同心留不住。","何处长亭。","绣被春寒掩翠屏。"]},{"i":"c-45d677a2a9ef","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["有何不可。","依旧一枚闲底我。","饭饱茶香。","瞌睡之时便上床。","百般经过。","且喜青鞋踏不破。","小院低窗。","桃李花开春昼长。"]},{"i":"c-68368bbac1f3","t":"减字木兰花","a":"朱敦儒","d":"宋","g":"词","p":["江南春水。","罗幕黄昏寒未退。","好个相知。","唱到姮娥敛黛眉。","夜阑人醉。","风露无情花有泪。","画角残时。","一片参旗红杏西。"]},{"i":"c-e2c939fa8aea","t":"点绛唇","a":"朱敦儒","d":"宋","g":"词","p":["淮海秋风，冶城飞下扬州叶。","画船催发。","倾酒留君别。","卧倒金壶，相对天涯客。","阳关彻。","大江横绝。","泪湿杯中月。"]},{"i":"c-35eb88ca1b10","t":"点绛唇","a":"朱敦儒","d":"宋","g":"词","p":["客梦初回，卧听吴语开帆索。","护霜云薄。","澹澹芙蓉落。","画舫无情，人去天涯角。","思量著。","翠蝉金雀。","别后新梳掠。"]},{"i":"c-329e5a3abbab","t":"点绛唇","a":"朱敦儒","d":"宋","g":"词","p":["至日春云，万般祥瑞朝来奏。","太平时候。","乐事家家有。","玉指呵寒，酥点梅花瘦。","金杯酒。","与君为寿。","只愿人长久。"]},{"i":"c-9d0e0460466d","t":"点绛唇","a":"朱敦儒","d":"宋","g":"词","p":["春雨春风，问谁染就江南草。","燕娇莺巧。","只是参军老。","今古红尘，愁了人多少。","尊前好。","缓歌低笑。","醉向花间倒。"]},{"i":"c-1cb3310a87b3","t":"点绛唇","a":"朱敦儒","d":"宋","g":"词","p":["缘径朱阑，暖烟晴日春来早。","自家亭沼。","不问人寻讨。","携酒提篮，儿女相随到。","风光好。","醉敧纱帽。","索共梅花笑。"]},{"i":"c-c4036148dacd","t":"柳梢青","a":"朱敦儒","d":"宋","g":"词","p":["狂踪怪迹。","谁料年老，天涯为客。","帆展霜风，船随江月，山寒波碧。","如今著处添愁，怎忍看、参西雁北。","洛浦莺花，伊川云水，何时归得。"]},{"i":"c-9656bc910c16","t":"柳梢青","a":"朱敦儒","d":"宋","g":"词","p":["松江胜集。","中秋载酒，幽人闲客。","云将迟疑，桂娥羞涩，一欢难得。","天怜我辈凄凉，借万里、晴空湛碧。","浩浩烟波，堂堂风月，今夕何夕。"]},{"i":"c-b9429026c62b","t":"柳梢青","a":"朱敦儒","d":"宋","g":"词","p":["红分翠别。","宿酒半醒，征鞍将发。","楼外残钟，帐前残烛，窗边残月。","想伊绣枕无眠，记行客、如今去也。","心下难拚，眼前难觅，口头难说。"]},{"i":"c-f13fc438745a","t":"柳梢青","a":"朱敦儒","d":"宋","g":"词","p":["梅蒸乍热。","无处散策，芳菲初歇。","席展凉莞，帐垂黄草，天然奇绝。","披襟永昼清风，更荐枕、良宵皓月。","一梦游仙，软云推倒，广寒宫阙。"]},{"i":"c-3b02f0335735","t":"柳梢青","a":"朱敦儒","d":"宋","g":"词","p":["秋光正洁。","仙家瑞草，黄花初发。","物外高情，天然雅致，清标偏别。","仙翁笑酌金杯，庆儿女、团圆喜悦。","嫁与萧郎，凤凰台上，长生风月。"]},{"i":"c-9da4b424fa91","t":"柳梢青","a":"朱敦儒","d":"宋","g":"词","p":["水云晚照。","浮生了了，霜风衰草。","日月金梭，江山春梦，天多人少。","赤松认得虚空，便一向、飞腾缥缈。","直上蓬瀛，回看沧海，凄然长啸。"]},{"i":"c-d4ca045994bd","t":"采桑子","a":"朱敦儒","d":"宋","g":"词","p":["扁舟去作江南客，旅雁孤云。","万里烟尘。","回首中原泪满巾。","碧山对晚汀洲冷，枫叶芦根。","日落波平。","愁损辞乡去国人。"]},{"i":"c-ac7f9d6b3fb9","t":"采桑子","a":"朱敦儒","d":"宋","g":"词","p":["天高风劲尘寰静，佳节重阳。","叶下潇湘。","碧海晴空一陈霜。","安排弦管倾芳酝，报答秋光。","昼短歌长。","红烛黄花夜未央。"]},{"i":"c-eb9f84dd47df","t":"采桑子","a":"朱敦儒","d":"宋","g":"词","p":["一番海角凄凉梦，却到长安。","翠帐犀帘。","依旧屏斜十二山。","玉人为我调琴瑟，颦黛低鬟。","云散香残。","风雨蛮溪半夜寒。"]},{"i":"c-690d03ddb23d","t":"忆秦娥","a":"朱敦儒","d":"宋","g":"词","p":["西江碧。","江亭夜燕天涯客。","天涯客。","一杯相属，此夕何夕。","烛残花冷歌声急。","秦关汉苑无消息。","无消息。","戍楼吹角，故人难得。"]},{"i":"c-110f772f2262","t":"忆秦娥","a":"朱敦儒","d":"宋","g":"词","p":["霜风急。","江南路上梅花白。","梅花白。","寒溪残月，冷村深雪。","洛阳醉里曾同摘。","水西竹外常相忆。","常相忆。","宝钗双凤，鬓边春色。"]},{"i":"c-0a20c8d50b72","t":"忆秦娥","a":"朱敦儒","d":"宋","g":"词","p":["吴船窄。","吴江岸下长安客。","长安客。","惊尘心绪，转蓬踪迹。","征鸿也是关河隔。","孤飞万里谁相识。","谁相识。","三更月落，斗横西北。"]},{"i":"c-967700639faa","t":"忆秦娥","a":"朱敦儒","d":"宋","g":"词","p":["歌锺列。","公堂盛会酬佳节。","酬佳节。","皇恩宣布，早梅争发。","舞场椎鼓催回雪。","金壶镟酒琼酥热。","琼酥热。","今朝不饮，几时欢悦。"]},{"i":"c-d53d223b0086","t":"卜算子","a":"朱敦儒","d":"宋","g":"词","p":["江上见新年，年夜听春雨。","有个人人领略春，粉澹红轻注。","深劝玉东西，低唱黄金缕。","拈底梅花总是愁，酒尽人归去。"]},{"i":"c-9906edeb75ef","t":"卜算子","a":"朱敦儒","d":"宋","g":"词","p":["陌上雪销初，才得江梅信。","翦彩盘金院落香，便觉烧灯近。","乐事眼前多，春酒今年胜。","好趁迎梅接柳时，满引金杯饮。"]},{"i":"c-3a45ccb37573","t":"卜算子","a":"朱敦儒","d":"宋","g":"词","p":["碧瓦小红楼，芳草江南岸。","雨后纱窗几阵寒，零落梨花晚。","看到水如云，送尽鸦成点。","南北东西处处愁，独倚阑干遍。"]},{"i":"c-8d8308b6deca","t":"卜算子","a":"朱敦儒","d":"宋","g":"词","p":["古涧一枝梅，免被园林锁。","路远山深不怕寒，似共春相趓。","幽思有谁知，托契都难可。","独自风流独自香，明月来寻我。"]},{"i":"c-a6a535b4b71a","t":"卜算子","a":"朱敦儒","d":"宋","g":"词","p":["灼灼一枝桃，粉艳天然好。","只被春风摆撼多，颜色凋零早。","结子未为迟，悔恨随芳草。","不下山来不出溪，待守刘郎老。"]},{"i":"c-0dfa0c8aa2df","t":"卜算子","a":"朱敦儒","d":"宋","g":"词","p":["旅雁向南飞，风雨群初失。","饥渴辛勤两翅垂，独下寒汀立。","鸥鹭苦难亲，矰缴忧相逼。","云海茫茫无处归，谁听哀鸣急。"]},{"i":"c-f44f4d7aa38c","t":"卜算子","a":"朱敦儒","d":"宋","g":"词","p":["山晓鹧鸪啼，云暗泷州路。","榕叶阴浓荔子青，百尺桄榔树。","尽日不逢人，猛地风吹雨。","惨黯蛮溪鬼峒寒，隐隐闻铜鼓。"]},{"i":"c-f6cba3c1782a","t":"清平乐","a":"朱敦儒","d":"宋","g":"词","p":["乱红深翠。","楼阁春风外。","胡蝶成团飞照水。","睡鸭无人惊起。","身闲更觉身轻。","酒壶歌扇随行。","芳草绿杨堤畔，一声初听啼莺。"]},{"i":"c-471fae3b08b0","t":"清平乐","a":"朱敦儒","d":"宋","g":"词","p":["人间花少。","菊小芙蓉老。","冷澹仙人偏得道。","买定西风一笑。","前身原是疏梅。","黄姑点碎冰肌。","惟有暗香长在，饱参清露霏微。"]},{"i":"c-820038ef5754","t":"清平乐","a":"朱敦儒","d":"宋","g":"词","p":["相留不住。","又趁东风去。","楼外夕阳芳草路。","今夜短亭何处。","杏花斜压阑干。","朱帘不卷春寒。","惆怅黄昏前后，离愁酒病厌厌。"]},{"i":"c-21cad6dea209","t":"清平乐","a":"朱敦儒","d":"宋","g":"词","p":["多寒易雨。","春事都相误。","愁过黄昏无著处。","宝篆烧残香缕。","低鬟暗摘明珰。","罗巾挹损残妆。","檐外几声风玉，丁东敲断人肠。"]},{"i":"c-e96f14c8f19f","t":"清平乐","a":"朱敦儒","d":"宋","g":"词","p":["春寒雨妥。","花萼红难破。","绣线金针慵不作。","要见秋千无那。","西邻姊妹丁宁。","寻芳更约清明。","画个丙丁帖子，前阶后院求晴。"]},{"i":"c-3a398a197b8e","t":"清平乐","a":"朱敦儒","d":"宋","g":"词","p":["当初相见。","君恨相逢晚。","一曲秦筝弹未遍。","无奈昭阳人怨。","便教恩浅情疏。","隔花空望金舆。","春晚不拈红粉，碧窗自录仙书。"]},{"i":"c-c9a80d4ea763","t":"昭君怨","a":"朱敦儒","d":"宋","g":"词","p":["胧月黄昏亭榭。","池上秋千初架。","燕子说春寒。","杏花残。","泪断愁肠难断。","往事总成幽怨。","幽怨几时休。","泪还流。"]},{"i":"c-a4de4c2df82a","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["折桂归来懒觅官。","十年风月醉家山。","有人挟瑟伴清闲。","楚畹飞香兰结佩，蓝田生暖玉连环。","拥书万卷看双鸾。"]},{"i":"c-bbf006f6d4e3","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["西塞山边白鹭飞。","吴兴江上绿杨低。","桃花流水鳜鱼肥。","青箬笠将风里戴，短蓑衣向雨中披。","斜风细雨不须归。"]},{"i":"c-fbdfff8ea81f","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["银海清泉洗玉杯。","恰篘白酒冷偏宜。","水林檎嫩折青枝。","争看使君长寿曲，旋教法部太平词。","快风凉雨火云摧。"]},{"i":"c-4df22812ac14","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["碧玉栏干白玉人。","倚花吹叶忍黄昏。","萧郎一去又经春。","眉澹翠峰愁易聚，脸残红雨泪难匀。","纤腰减半绿罗裙。"]},{"i":"c-001d690005ec","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["雨湿清明香火残。","碧溪桥外燕泥寒。","日长独自倚阑干。","脱箨修篁初散绿，褪花新杏未成酸。","江南春好与谁看。"]},{"i":"c-b8e0daa00c2a","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["风落芙蓉画扇闲。","凉随春色到人间。","乍垂罗幕乍飞鸾。","好把深杯添绿酒，休拈明镜照苍颜。","浮生难得是清欢。"]},{"i":"c-154130128ab4","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["才子佳人相见难。","舞收歌罢又更阑。","密将春恨系幽欢。","结子同心香佩带，帕儿双字玉连环。","酒醒灯暗忍重看。"]},{"i":"c-562a69d2ef4b","t":"浣溪沙","a":"朱敦儒","d":"宋","g":"词","p":["晚菊花前敛翠蛾。","采花传酒缓声歌。","柳枝团扇别离多。","拥髻凄凉论旧事，曾随织女度银梭。","当年今夕奈愁何。"]},{"i":"c-797077508cb7","t":"阮郎归","a":"朱敦儒","d":"宋","g":"词","p":["柳花陌上拈明珰。","娇红新样妆。","匆匆曾贮一襟香。","月痕金缕凉。","分泪扇，掩离觞。","春残人断肠。","锦书难寄雁飞忙。","池塘芳草长。"]},{"i":"c-17da230a8196","t":"生查子","a":"朱敦儒","d":"宋","g":"词","p":["卧病独眠人，无月中秋节。","澹照碧纱灯，冷看银屏雪。","风露转萧寒，砧杵添凄切。","伏枕漫书空，到晓愁难说。"]},{"i":"c-61e580b398c2","t":"眼儿媚","a":"朱敦儒","d":"宋","g":"词","p":["青锦成帏瑞香浓。","雅称小帘栊。","主人好事，金杯留客，共倚春风。","不知因甚来尘世，香似旧曾逢。","江梅退步，幽兰偷眼，回避芳丛。"]},{"i":"c-b599de2ca297","t":"眼儿媚","a":"朱敦儒","d":"宋","g":"词","p":["叠翠阑红斗纤浓。","云雨绮为栊。","只忧谢了，偏须著意，障雨遮风。","瑞云香雾虽难觅，蓦地有时逢。","不妨守定，从他人笑，老入花丛。"]},{"i":"c-75d10a750fb2","t":"眼儿媚","a":"朱敦儒","d":"宋","g":"词","p":["紫帔红襟艳争浓。","光彩烁疏栊。","香为小字，瑞为高姓，道骨仙风。","此花合向瑶池种，可惜未遭逢。","阿环见了，羞回眼尾，愁聚眉丛。"]},{"i":"c-581ce1599204","t":"诉衷情","a":"朱敦儒","d":"宋","g":"词","p":["青垂柳线水平池。","芳径燕初飞。","日长事少人静，山茧换单衣。","箫鼓远，篆香迟。","卷帘低。","半床花影，一枕松风，午醉醒时。"]},{"i":"c-183892974268","t":"诉衷情","a":"朱敦儒","d":"宋","g":"词","p":["老人无复少年欢。","嫌酒倦吹弹。","黄昏又是风雨，楼外角声残。","悲故国，念尘寰。","事难言。","下了纸帐，曳上青毡，一任霜寒。"]},{"i":"c-c170b2e1dd9a","t":"诉衷情","a":"朱敦儒","d":"宋","g":"词","p":["青旗彩胜又迎春。","暖律应祥云。","金盘内家生菜，宫院遍承恩。","时节好，管弦新。","度升平。","惠风迟日，柳眼梅心，任醉芳尊。"]},{"i":"c-1eeafbfe427e","t":"诉衷情","a":"朱敦儒","d":"宋","g":"词","p":["月中玉兔日中鸦。","随我度年华。","不管寒暄风雨，饱饭热煎茶。","居士竹，故侯瓜。","老生涯。","自然天地，本分云山，到处为家。"]},{"i":"c-b49d908e0cce","t":"菩萨蛮","a":"朱敦儒","d":"宋","g":"词","p":["老人谙尽人间苦。","近来恰似心头悟。","九九是重阳。","重阳菊散芳。","出门何处去。","对面谁相语。","枕臂卧南窗。","铜炉柏子香。"]},{"i":"c-49d3f09cec5d","t":"菩萨蛮","a":"朱敦儒","d":"宋","g":"词","p":["芭蕉叶上秋风碧。","晚来小雨流苏湿。","新窨木樨沈。","香迟斗帐深。","无人同向夕。","还是愁成忆。","忆昔结同心。","鸳鸯何处寻。"]},{"i":"c-753fb38d366f","t":"菩萨蛮","a":"朱敦儒","d":"宋","g":"词","p":["风流才子倾城色。","红缨翠幰长安陌。","夜饮小平康。","暖生银字簧。","持杯留上客。","私语眉峰侧。","半冷水沈香。","罗帷宫漏长。"]},{"i":"c-daacbb0613d3","t":"菩萨蛮","a":"朱敦儒","d":"宋","g":"词","p":["乡关散尽当年客。","春风寂寞花无色。","长日掩重门。","江山眼外昏。","画图高挂壁。","嵩少参差碧。","想见卧云人。","松黄落洞门。"]},{"i":"c-7d7f08e44f0d","t":"菩萨蛮","a":"朱敦儒","d":"宋","g":"词","p":["芙蓉红落秋风急。","夜寒纸帐霜华湿。","枕畔木瓜香。","晓来清兴长。","轻舟青箬笠。","短棹溪光碧。","去觅谢三郎。","芦花何处藏。"]}]