[{"i":"c-547b522deb60","t":"燕归梁","a":"张先","d":"宋","g":"词","p":["夜月啼乌促乱弦。","江树远无烟。","缺多圆少奈何天。","愁只恐、下关山。","粉香生润，衣珠弄彩，人月两蝉娟。","留连残夜惜馀欢。","人月在、又明年。"],"s":"simp","f":"trad"},{"i":"c-962ceb9e8c52","t":"定西番","a":"张先","d":"宋","g":"词","p":["年少登瀛词客，飘逸气，拂晴霓。","尽带江南春色、过长淮。","一曲艳歌留别，翠蝉摇宝钗。","此后吴姬难见、且徘徊。"],"s":"simp","f":"trad"},{"i":"c-d42dbc73648c","t":"河传","a":"张先","d":"宋","g":"词","p":["花暮。","春去。","都门东路。","嘶马将行。","江南江北，十里五里邮亭。","几程程。","高城望远看回睇。","烟细。","晚碧空无际。","今夜何处，冷落衾帏。","欲眠时。"],"s":"simp","f":"trad"},{"i":"c-4acd37be2cd1","t":"偷声木兰花","a":"张先","d":"宋","g":"词","p":["雪笼琼苑梅花瘦。","外院重扉联宝兽。","海月新生。","上得高楼无奈情。","帘波不动凝釭小。","今夜夜长争得晓。","欲梦高唐。","只恐觉来添断肠。"],"s":"simp","f":"trad"},{"i":"c-dbc76a8d125b","t":"偷声木兰花","a":"张先","d":"宋","g":"词","p":["画桥浅映横塘路。","流水滔滔春共去。","目送残晖。","燕子双高蝶对飞。","风花将尽持杯送。","往事只成清夜梦。","莫更登楼。","坐想行思已是愁。"],"s":"simp","f":"trad"},{"i":"c-930bc4e2ede2","t":"醉桃源・阮郎归","a":"张先","d":"宋","g":"词","p":["双花连袂近香猊。","歌随镂板齐。","分明珠索漱烟溪。","凝云定不飞。","唇破点，齿编犀。","春莺莫乱啼。","阳关更在碧峰西。","相看翠黛低。"],"s":"simp","f":"trad"},{"i":"c-b34a4009f16e","t":"天仙子","a":"张先","d":"宋","g":"词","p":["醉笑相逢能几度。","为报江头春且住。","主人今日是行人，红袖舞。","清歌女。","凭仗东风教点取。","三月柳枝柔似缕。","落絮尽飞还恋树。","有情宁不忆西园，莺解语。","花无数。","应讶使君何处去。"],"s":"simp","f":"trad"},{"i":"c-066fc8b495eb","t":"渔家傲","a":"张先","d":"宋","g":"词","p":["巴子城头青草暮。","巴山重叠相逢处。","燕子占巢花脱树。","杯且举。","瞿塘水阔舟难渡。","天外吴门清霅路。","君家正在吴门住。","赠我柳枝情几许。","春满缕。","为君将入江南去。"],"s":"simp","f":"trad"},{"i":"c-882a04573779","t":"天仙子","a":"张先","d":"宋","g":"词","p":["十岁手如芽子笋。","固爱弄妆偷傅粉。","金蕉并为舞时空，红脸嫩。","轻衣褪。","春重日浓花觉困。","斜雁轧弦随步趁。","小凤累珠光绕鬓。","密教持履恐仙飞，催拍紧。","惊鸿奔。","风袂飘摇无定准。"],"s":"simp","f":"trad"},{"i":"c-cb18be04b590","t":"天仙子","a":"张先","d":"宋","g":"词","p":["坐治吴州成乐土。","诏卷风飞来圣语。","亲舆乞得便藩归，瑶席主。","杯休数。","清夜为君歌白苎。","花接旧枝新蕊吐。","造化不知人有助。","看花岁岁比甘棠，嘉月暮。","东门路。","只恐带将春色去。"],"s":"simp","f":"trad"},{"i":"c-54fbb615ff73","t":"南乡子","a":"张先","d":"宋","g":"词","p":["相并细腰身。","时样宫妆一样新。","曲项胡琴鱼尾拨，离人。","入塞弦声水上闻。","天碧染衣巾。","血色轻罗碎摺裙。","百卉已随霜女妒，东君。","暗折双花借小春。"],"s":"mixed","f":"trad"},{"i":"c-0a96ecfae56f","t":"少年游","a":"张先","d":"宋","g":"词","p":["听歌持酒且休行。","云树几程程。","眼看檐牙，手搓花蕊，未必两无情。","拓夫滩上闻新雁，离袖掩盈盈。","此恨无穷，远如江水，东去几时平。"],"s":"simp","f":"trad"},{"i":"c-0e2145f0a61e","t":"定风波令・定风波","a":"张先","d":"宋","g":"词","p":["碧玉篦扶坠髻云。","莺黄衫子退红裙。","妆样巧将花草竞。","相并。","要教人意胜於春。","酒眼茸茸香拂面。","□见。","丹青宁似镜中真。","自是有情偏小小。","向道。","江东谁信更无人。"],"s":"mixed","f":"trad"},{"i":"c-46b607840481","t":"定风波令・定风波","a":"张先","d":"宋","g":"词","p":["浴殿词臣亦议兵。","禁中颇牧党羌平。","诏卷促归难自缓。","溪馆。","彩花千数酒泉清。","春草未青秋叶暮。","□去。","一家行色万家情。","可恨黄莺相识晚。","望断。","湖边亭上不闻声。"],"s":"simp","f":"trad"},{"i":"c-636b73214435","t":"定风波令・定风波","a":"张先","d":"宋","g":"词","p":["谈辨才疏堂上兵。","画船齐岸暗潮平。","万乘靴袍曾好问。","须信。","文章传口齿牙清。","三百寺应游未遍。","□算。","湖山风物岂无情。","不独渠丘歌叔度。","行路。","吴谣终日有馀声。"],"s":"simp","f":"trad"},{"i":"c-6b12a0d9fa02","t":"定风波令・定风波","a":"张先","d":"宋","g":"词","p":["西阁明呈奉诏行。","南床吏部锦衣荣。","中有瀛仙宾与主。","相遇。","平津选首更神清。","溪上玉楼同宴喜。","欢醉。","对堤杯叶惜秋英。","尽道贤人聚吴分。","试问。","也应旁有老人星。"],"s":"simp","f":"trad"},{"i":"c-6dc3fc8cd0ce","t":"木兰花・玉楼春","a":"张先","d":"宋","g":"词","p":["人意共怜花月满。","花好月圆人又散。","欢情去逐远云空，往事过如幽梦断。","草树争春红影乱。","一唱鸡声千万怨。","任教迟日更添长，能得几时抬眼看。"],"s":"simp","f":"trad"},{"i":"c-9dccedb66908","t":"木兰花・玉楼春","a":"张先","d":"宋","g":"词","p":["相离徒有相逢梦。","门外马蹄尘已动。","怨歌留待醉时听，远目不堪空际送。","今宵风月知谁共。","声咽琵琶槽上凤。","人生无物比多情，江水不深山不重。"],"s":"simp","f":"trad"},{"i":"c-3dff5436b914","t":"木兰花・玉楼春","a":"张先","d":"宋","g":"词","p":["檀槽碎响金丝拨。","露湿浔阳江上月。","不知商妇为谁愁，一曲行人留晚发。","画堂花入新声别。","红蕊调高弹未彻。","暗将深意语胶弦，长愿弦丝无断绝。"],"s":"simp","f":"trad"},{"i":"c-710be2b6ed9e","t":"木兰花・玉楼春","a":"张先","d":"宋","g":"词","p":["插花劝酒盐桥馆。","召节促行龙阙远。","吴船渐起晚潮生，蛮榼未空寒日短。","庆门奕世隆宸眷。","归到月陂梅已绽。","有情愿寄向南枝，图得洛阳春色看。"],"s":"simp","f":"trad"},{"i":"c-984e26e63686","t":"木兰花・玉楼春","a":"张先","d":"宋","g":"词","p":["去年春入芳菲国。","青蕊如梅终忍摘。","阑边徒欲说相思，绿蜡密缄朱粉饰。","归来故苑重寻觅。","花满旧枝心更惜。","鸳鸯从小自相双，若不多情头不白。"],"s":"simp","f":"trad"},{"i":"c-5e9220c1ff53","t":"木兰花・玉楼春","a":"张先","d":"宋","g":"词","p":["龙头舴艋吴儿竞。","笋柱秋千游女并。","芳洲拾翠暮忘归，秀野踏青来不定。","行云去后遥山暝。","已放笙歌池院静。","中庭月色正清明，无数杨花过无影。"],"s":"simp","f":"trad"},{"i":"c-ece42ec6c5e7","t":"木兰花・玉楼春","a":"张先","d":"宋","g":"词","p":["轻牙低掌随声听。","合调破空云自凝。","姝娘翠黛有人描，琼女分鬟待谁并。","弄妆俱学闲心性。","固向鸾台同照影。","双头莲子一时花，天碧秋池水如镜。"],"s":"simp","f":"trad"},{"i":"c-819c1356cf50","t":"倾杯・倾杯乐","a":"张先","d":"宋","g":"词","p":["横塘水静，花窥影、孤城转。","浮玉无尘，五亭争景，画桥对起，垂虹不断。","爱溪上琼楼，凭雕栏、久□飞云远。","人在虚空，月生溟海，寒渔夜泛，游鳞可辨。","正是草长苹老，江南地暖。","汀洲日晚。","更茶山、已过清明，风雨暴千岩、啼鸟怨。","芳菲故苑。","深红尽、绿叶阴浓，青子枝头满。","史君莫放寻春缓。"],"s":"simp","f":"trad"},{"i":"c-714f0681ba85","t":"倾杯・倾杯乐","a":"张先","d":"宋","g":"词","p":["飞云过尽，明河浅、天无畔。","草色栖萤，霜华清暑，轻飔弄袂，澄澜拍岸。","宴玉麈谈宾，倚琼枝、秀挹雕觞满。","午夜中秋，十分圆月，香槽拨凤，朱弦轧雁。","正是欲醒还醉，临空怅远。","壶更叠换。","对东西、数里回塘，恨零落芙蓉、春不管。","笼灯待散。","谁知道、座有离人，目断双歌伴。","烟江艇子归来晚。"],"s":"simp","f":"trad"},{"i":"c-50eb0462dad1","t":"离亭宴","a":"张先","d":"宋","g":"词","p":["捧黄封诏卷。","随处是、离亭别宴。","红翠成轮歌未遍。","已恨野桥风便。","此去济南非久，惟有凤池鸾殿。","三月花飞几片。","又减却、芳菲过半。","千里恩深云海浅。","民爱比、春流不断。","更上玉楼西，归雁与、征帆共远。"],"s":"simp","f":"trad"},{"i":"c-67fdd1da339b","t":"沁园春","a":"张先","d":"宋","g":"词","p":["心膂良臣，帷幄元勋，左右万几。","暂武林分阃，东南外翰，锦衣乡社，未满瓜时。","易镇梧台，宣条期岁，又西指夷桥千骑移。","珠滩上，喜甘棠翠荫，依旧春晖。","须知。","系国安危。","料节召、还趋浴凤池。","且代工施化，持钧播泽，置盂天下，此外何思。","素卷书名，赤松游道，飙驭云軿仙可期。","湖山美，有啼猿唳鹤，相望东归。"],"s":"simp","f":"trad"},{"i":"c-bdae6a03a9a6","t":"感皇恩","a":"张先","d":"宋","g":"词","p":["延寿芸香七世孙。","华轩承大对，见经纶。","溟鱼一息化天津。","袍如草，三百骑，从清尘。","玉树莹风神。","同时棠棣萼，一家春。","十年身是凤池人。","蓬莱阁，黄合主，迟谈宾。"],"s":"simp","f":"trad"},{"i":"c-0e455b6e80af","t":"忆秦娥","a":"张先","d":"宋","g":"词","p":["参差竹。","吹断相思曲。","情不足。","西北有楼穷远目。","忆苕溪、寒影透清玉。","秋雁南飞速。","菰草绿。","应下溪头沙上宿。"],"s":"simp","f":"trad"},{"i":"c-4a1b262089d7","t":"系裙腰","a":"张先","d":"宋","g":"词","p":["惜霜蟾照夜云天。","朦胧影、画勾阑。","人情纵是长情月，算一年年。","又能得、几番圆。","欲寄西江题叶字，流不到、五亭前。","东池始有荷新绿，尚小如钱。","问何日藕、几时莲。"],"s":"simp","f":"trad"},{"i":"c-572586f96da9","t":"清平乐","a":"张先","d":"宋","g":"词","p":["青袍如草。","得意还年少。","马跃绿螭金络脑。","寒食乍临新晓。","曲池斜度鸾桥。","西园一片笙箫。","自欲剩留春住，风花无奈飘飘。"],"s":"simp","f":"trad"},{"i":"c-edecb9418e8e","t":"偷声木兰花","a":"张先","d":"宋","g":"词","p":["曾居别乘康吴俗。","民到於今歌不足。","骊驭征鞭。","一去东风十二年。","重来却拥诸侯骑。","宝带垂鱼金照地。","和气融人。","清霅千家日日春。"],"s":"mixed","f":"trad"},{"i":"c-f3b4970e71a2","t":"菩萨蛮","a":"张先","d":"宋","g":"词","p":["佳人学得平阳曲。","纤纤玉笋横孤竹。","一弄入云声。","海门江月清。","髻摇金钿落。","惜恐樱唇薄。","听罢已依依。","莫吹杨柳枝。"],"s":"simp","f":"trad"},{"i":"c-014d99398263","t":"菩萨蛮","a":"张先","d":"宋","g":"词","p":["藕丝衫翦猩红窄。","衫轻不碍琼肤白。","缦鬓小横波。","花楼东是家。","上湖闲荡桨。","粉艳芙蓉样。","湖水亦多情。","照妆天底清。"],"s":"simp","f":"trad"},{"i":"c-baab97761b4f","t":"菩萨蛮","a":"张先","d":"宋","g":"词","p":["牛星织女年年别。","分明不及人间物。","匹鸟少孤飞。","断沙犹并栖。","洗车昏雨过。","缺月云中堕。","斜汉晓依依。","暗蛩还促机。"],"s":"simp","f":"trad"},{"i":"c-dbc39955a1f6","t":"菩萨蛮","a":"张先","d":"宋","g":"词","p":["双针竞引双丝缕。","家家尽道迎牛女。","不见渡河时。","空闻乌鹊飞。","西南低片月。","应恐云梳发。","寄语问星津。","谁为得巧人。"],"s":"simp","f":"trad"},{"i":"c-b31d2c42d5e4","t":"庆春泽","a":"张先","d":"宋","g":"词","p":["飞阁危桥相倚。","人独立东风，满衣轻絮。","还记忆江南，如今天气。","正白苹花，绕堤涨流水。","寒梅落尽谁寄。","方春意无穷，青空千里。","愁草树依依，关城初闭。","对月黄昏，角声傍烟起。"],"s":"simp","f":"trad"},{"i":"c-1c759873c562","t":"庆春泽","a":"张先","d":"宋","g":"词","p":["艳色不须妆样。","风韵好天真，画毫难上。","花影滟金尊，酒泉生浪。","镇欲留春，傍花为春唱。","银塘玉宇空旷。","冰齿映轻唇，蕊红新放。","声宛转，疑随烟香悠扬。","对暮林静，寥寥振清响。"],"s":"simp","f":"trad"},{"i":"c-3c11a45c71af","t":"玉联环・解连环","a":"张先","d":"宋","g":"词","p":["南园已恨归来晚。","芳菲满眼。","春工偏上好花多，疑不向、空枝暖。","惜恐红云易散。","丛丛看遍。","当时犹有蕊如梅，问几日上、东风绽。"],"s":"simp","f":"trad"},{"i":"c-d10608075450","t":"玉树后庭花・后庭花","a":"张先","d":"宋","g":"词","p":["华灯火树红相斗。","往来如昼。","桥河水白天青，讶别生星斗。","落梅秾李还依旧。","宝钗沽酒。","晓蟾残漏心情，恨雕鞍归后。"],"s":"simp","f":"trad"},{"i":"c-a81a93444f67","t":"玉树后庭花・后庭花","a":"张先","d":"宋","g":"词","p":["宝床香重春眠觉。","魫窗难晓。","新声丽色千人，歌后庭清妙。","青骢一骑来飞鸟。","靓妆难好。","至今落日寒蟾，照台城秋草。"],"s":"simp","f":"trad"},{"i":"c-0a72ebfe4877","t":"卜算子","a":"张先","d":"宋","g":"词","p":["梦断寒夜长，坐待清霜晓。","临镜无人为整妆，但自学、孤鸾照。","楼台红树杪。","风月依前好。","江水东流郎在西，问尺素、何由到。"],"s":"simp","f":"trad"},{"i":"c-86bdd5d6e30a","t":"双韵子","a":"张先","d":"宋","g":"词","p":["鸣鞘电过晓闱静。","敛龙旗风定。","凤楼远出霏烟，闻笑语、中天迥。","清光近。","欢声竟。","鸳鸯集、仙花斗影。","更闻度曲瑶山，升瑞日、春宫永。"],"s":"simp","f":"trad"},{"i":"c-dffb60dbf827","t":"鹊桥仙","a":"张先","d":"宋","g":"词","p":["星桥火树，长安一夜，开遍红莲万蕊。","绮罗能借月中春，风露细、天清似水。","重城闭月，青楼夸乐，人在银潢影里。","画屏期约近收灯，归步急、双鸳欲起。"],"s":"simp","f":"trad"},{"i":"c-3e8ee8dc777d","t":"醉垂鞭","a":"张先","d":"宋","g":"词","p":["酒面滟金鱼。","吴娃唱。","吴潮上。","玉殿白麻书。","待君归后除。","勾留风月好。","平湖晓。","翠峰孤。","此景出关无。","西州空画图。"],"s":"simp","f":"trad"},{"i":"c-5fd7ccea54b7","t":"定西番","a":"张先","d":"宋","g":"词","p":["秀眼谩生千媚，钗玉重，髻云低。","寂寂挹妆羞泪，怨分携。","鸳帐愿从今夜，梦长连晓鸡。","小逐画船风月，渡江西。"],"s":"simp","f":"trad"},{"i":"c-97fff05378f5","t":"定西番","a":"张先","d":"宋","g":"词","p":["焊拨紫槽金衬，双秀萼，两回鸾。","齐学汉宫妆样，竞蝉娟。","三十六弦蝉闹，小弦蜂作团。","听尽昭君幽怨，莫重弹。"],"s":"simp","f":"trad"},{"i":"c-69b235628ed5","t":"望江南・忆江南","a":"张先","d":"宋","g":"词","p":["青楼宴，靓女荐瑶杯。","一曲白云江月满，际天拖练夜潮来。","人物误瑶台。","醺醺酒，拂拂上双腮。","媚脸已非朱淡粉，香红全胜雪笼梅。","标格外尘埃。"],"s":"simp","f":"trad"},{"i":"c-242f5012154e","t":"少年游慢","a":"张先","d":"宋","g":"词","p":["春城三二月。","禁柳飘绵未歇。","仙篽生香，轻云凝紫，临层阙。","歌掌明珠滑。","酒脸红霞发。","华省名高，少年得意时节。","画刻三题彻。","梯汉同登蟾窟。","玉殿初宣，银袍齐脱，生仙骨。","花探都门晓，马跃芳衢阔。","宴罢东风，鞭梢一行飞雪。"],"s":"simp","f":"trad"},{"i":"c-4fbf29dec654","t":"翦牡丹","a":"张先","d":"宋","g":"词","p":["野绿连空，天青垂水，素色溶漾都净。","柔柳摇摇，坠轻絮无影。","汀洲日落人归，修巾薄袂，撷香拾翠相竞。","如解凌波，泊烟渚春暝。","采绦朱索新整。","宿绣屏、画船风定。","金凤响双槽，弹出今古幽思谁省。","玉盘大小乱珠迸。","酒上妆面，花艳媚相并。","重听。","尽汉妃一曲，江空月静。"],"s":"simp","f":"trad"},{"i":"c-dbfe08973e17","t":"画堂春","a":"张先","d":"宋","g":"词","p":["外潮莲子长参差。","霁山青处鸥飞。","水天溶漾画桡迟。","人影鉴中移。","桃叶浅声双唱，杏红深色轻衣。","小荷障面避斜晖。","分得翠阴归。"],"s":"simp","f":"trad"},{"i":"c-f4b2cef7956c","t":"芳草渡・系裙腰","a":"张先","d":"宋","g":"词","p":["双门晓锁响朱扉。","千骑拥、万人随。","风乌弄影画船移。","歌时泪，和别怨，作秋悲。","寒潮小，渡淮迟。","吴越路、渐天涯。","宋王台上为相思。","江云下，日西尽，雁南飞。"],"s":"simp","f":"trad"},{"i":"c-0eec2ca6a0d5","t":"芳草渡・系裙腰","a":"张先","d":"宋","g":"词","p":["主人宴客玉楼西。","风飘雪、忽氛霏。","唐昌花蕊渐平枝。","浮光里，寒声聚，队禽栖。","惊晓日，喜春迟。","野桥时伴梅飞。","山明日远霁云披。","溪上月，堂下水，并春晖。"],"s":"simp","f":"trad"},{"i":"c-4524a95678e2","t":"御街行","a":"张先","d":"宋","g":"词","p":["夭非花艳轻非雾。","来夜半、天明去。","来如春梦不多时，去似朝云何处。","远鸡栖燕，落星沈月，紞紞城头鼓。","参差渐辨西池树。","珠阁斜开户。","绿苔深径少人行，苔上屐痕无数。","馀香遗粉，剩衾闲枕，天把多情付。"],"s":"mixed","f":"trad"},{"i":"c-f5f95b411450","t":"苏幕遮","a":"张先","d":"宋","g":"词","p":["柳飞绵，花实少。","镂板音清，浅发江南调。","斜日两竿留碧□。","马足重重，又近青门道。","去尘浓，人散了。","回首旗亭，渐渐红裳小。","莫讶安仁头白早。","天若有情，天也终须老。"],"s":"simp","f":"trad"},{"i":"c-02765e438e88","t":"武陵春","a":"张先","d":"宋","g":"词","p":["每见韶娘梳鬓好，钗燕傍云飞。","谁掬彤霞露染衣。","□玉透柔肌。","梅花瘦雪梨花雨，心眼未芳菲。","看著娇妆听柳枝。","人意觉春归。"],"s":"simp","f":"trad"},{"i":"c-9d87ac43391e","t":"醉落魄・一斛珠","a":"张先","d":"宋","g":"词","p":["山围画障。","风溪弄月清溶漾。","玉楼苕馆人相望。","下若醲醅，竞欲金钗当。","使君劝醉青娥唱。","分明仙曲云中响。","南园百卉千家赏。","和气兼春，不独花枝上。"],"s":"mixed","f":"trad"},{"i":"c-2dd6a78ad5b7","t":"长相思","a":"张先","d":"宋","g":"词","p":["粉艳明。","秋水盈。","柳样纤柔花样轻。","笑前双靥生。","寒江平。","江橹鸣。","谁道潮沟非远行。","回头千里情。"],"s":"simp","f":"trad"},{"i":"c-2a5cf192b9d4","t":"更漏子","a":"张先","d":"宋","g":"词","p":["杜陵春，秦树晚。","伤别更堪临远。","南去信，欲凭谁。","归鸿多北归。","小桃枝，红蓓发。","今夜昔时风月。","休苦意，说相思。","少情人不知。"],"s":"simp","f":"trad"},{"i":"c-96b24fa76b31","t":"浣溪沙","a":"张先","d":"宋","g":"词","p":["楼倚春江百尺高。","烟中还未见归桡。","几时期信似江潮。","花片片飞风弄蝶，柳阴阴下水平桥。","日长才过又今宵。"],"s":"simp","f":"trad"},{"i":"c-4e59b39c87a4","t":"醉桃源・阮郎归","a":"张先","d":"宋","g":"词","p":["仙郎何日是来期。","无心云胜伊。","行云犹解傍山飞。","郎行去不归。","强匀画，又芳菲。","春深轻薄衣。","桃花无语伴相思。","阴阴月上时。"],"s":"simp","f":"trad"},{"i":"c-11b857aa32a1","t":"行香子","a":"张先","d":"宋","g":"词","p":["舞雪歌云。","闲淡妆匀。","蓝溪水、深染轻裙。","酒香醺脸，粉色生春。","更巧谈话，美情性，好精神。","江空无畔，凌波何处，月桥边、青柳朱门。","断钟残角，又送黄昏。","奈心中事，眼中泪，意中人。"],"s":"simp","f":"trad"},{"i":"c-3464cfd12c43","t":"熙州慢","a":"张先","d":"宋","g":"词","p":["武林乡，占第一湖山，咏画争巧。","鹫石飞来，倚翠楼烟霭，清猿啼晓。","况值禁垣师帅，惠政流入欢谣。","朝暮万景，寒潮弄月，乱峰回照。","天使寻春不早。","并行乐，免有花愁花笑。","持酒更听，红儿肉声长调。","潇湘故人未归，但目送游云孤鸟。","际天杪。","离情尽寄芳草。"],"s":"simp","f":"trad"},{"i":"c-e1e390723934","t":"虞美人","a":"张先","d":"宋","g":"词","p":["恩如明月家家到。","无处无清照。","一帆秋色共云遥。","眼力不知人远、上江桥。","愿君书札来双鲤。","古汴东流水。","宋王台畔楚宫西。","正是节趣归路、近沙堤。"],"s":"simp","f":"trad"},{"i":"c-071ca9be290c","t":"泛清苕","a":"张先","d":"宋","g":"词","p":["绿净无痕，过晓霁清苕，镜里游人。","红柱巧，彩船稳，当筵主、秘馆词臣。","吴娃劝饮韩娥唱，竞艳容、左右皆春。","学为行雨，傍画桨，从教水溅罗裙。","溪烟混月黄昏。","渐楼台上下，火影星分。","飞槛倚，斗牛近，响箫鼓、远破重云。","归轩未至千家待，掩半妆、翠箔朱门。","衣香拂面，扶醉卸簪花，满袖馀煴。"],"s":"simp","f":"trad"},{"i":"c-7c77debe49ab","t":"惜琼花","a":"张先","d":"宋","g":"词","p":["汀苹白。","苕水碧。","每逢花驻乐，随处欢席。","别时携手看春色。","萤火而今，飞破秋夕。","旱河流，如带窄。","任身轻似叶，何计归得。","断云孤鹜青山极。","楼上徘徊，无尽相忆。"],"s":"simp","f":"trad"},{"i":"c-405bbbff0bec","t":"河满子","a":"张先","d":"宋","g":"词","p":["溪女送花随处，沙鸥避乐分行。","游舸已如图障里，小屏犹画潇湘。","人面新生酒艳，日痕更欲春长。","衣上交枝斗色，钗头比翼相双。","片段落霞明水底，风纹时动妆光。","宾从夜归无月，千灯万火河塘。"],"s":"simp","f":"trad"},{"i":"c-909355036248","t":"劝金船","a":"张先","d":"宋","g":"词","p":["流泉宛转双开窦。","带染轻纱皱。","何人暗得金船酒。","拥罗绮前后。","绿定见花影，并照与、艳妆争秀。","行尽曲名，休更再歌杨柳。","光生飞动摇琼甃。","隔障笙箫奏。","须知短景欢无足，又还过清昼。","翰阁迟归来，传骑恨、留住难久。","异日凤凰池上，为谁思旧。"],"s":"simp","f":"trad"},{"i":"c-6e2a04296041","t":"庆同天・河传","a":"张先","d":"宋","g":"词","p":["海宇，称庆。","复生元圣。","风入南薰。","拜恩遥阙，衣上晓色犹春。","望尧云。","游钧广乐人疑梦。","仙声共。","日转旗光动。","无疆帝算，何独待祝华封。","与天同。"],"s":"simp","f":"trad"},{"i":"c-771f9594e924","t":"江城子","a":"张先","d":"宋","g":"词","p":["小圆珠串静慵拈。","夜厌厌。","下重帘。","曲屏斜烛，心事入眉尖。","金字半开香穗小，愁不寐，恨西蟾。"],"s":"simp","f":"trad"},{"i":"c-43b0d90966e0","t":"雨中花令","a":"张先","d":"宋","g":"词","p":["近鬓彩钿云雁细。","好客艳、花枝争媚。","学双燕、同栖还并翅。","我合著、你难分离。","这佛面、前生应布施。","你更看、蛾眉下秋水。","似赛九底、见他三五二。","正闷里、也须欢喜。"],"s":"simp","f":"trad"},{"i":"c-5ae79a001975","t":"汉宫春","a":"张先","d":"宋","g":"词","p":["红粉苔墙。","透新春消息，梅粉先芳。","奇葩异卉，汉家宫额涂黄。","何人斗巧，运紫檀、翦出蜂房。","应为是、中央正色，东君别与清香。","仙姿自称霓裳。","更孤标俊格，非雪凌霜。","黄昏院落，为谁密解罗囊。","银瓶注水，浸数枝、小阁幽窗。","春睡起，纤条在手，厌厌宿酒残妆。"],"s":"simp","f":"trad"},{"i":"c-8b7cc4f7d949","t":"满江红","a":"张先","d":"宋","g":"词","p":["飘尽寒梅，笑粉蝶游蜂未觉。","渐迤逦、水明山秀，暖生帘幕。","过雨小桃红未透，舞烟新柳青犹弱。","记画桥深处水边亭，曾偷约。","多少恨，今犹昨。","愁和闷，都忘却。","拼从前烂醉，被花迷著。","晴鸽试铃风力软，雏莺弄舌春寒薄。","但只愁、锦绣闹妆时，东风恶。"],"s":"simp","f":"trad"},{"i":"c-ff13b26720f7","t":"西江月","a":"张先","d":"宋","g":"词","p":["肃肃秺侯清慎，温温契苾知诗。","能推恻隐救民饥。","况乃义方教子。","宪府两飞鹗荐，士林竞赋怀辞。","天门正美可前知。","入侍钧天从此。"],"s":"simp","f":"trad"},{"i":"c-8f709c206d72","t":"塞垣春","a":"张先","d":"宋","g":"词","p":["野树秋声满。","对雨壁、风灯乱。","云低翠帐，烟销素被，签动重幔。","甚客怀、先自无消遣。","更篱落、秋虫叹。","叹樊川、风流减。","旧欢难得重见。","停酒说扬州，平山月、应照棋观。","绿绮为谁弹，空传广陵散。","但光纱短帽，窄袖轻衫，犹记竹西庭院。","老鹤何时去，认琼花一面。"],"s":"simp","f":"trad"},{"i":"c-e754aaa91d80","t":"浪淘沙","a":"张先","d":"宋","g":"词","p":["肠断送韶华。","为惜杨花。","雪球摇曳逐风斜。","容易著人容易去，飞过谁家。","聚散苦咨嗟。","无计留他。","行人洒泪滴流霞。","今日画堂歌舞地，明日天涯。"],"s":"simp","f":"trad"},{"i":"c-bb40477bcb7d","t":"望江南・忆江南","a":"张先","d":"宋","g":"词","p":["香闺内、空自想佳期。","独步花阴情绪乱，谩将珠泪两行垂。","胜会在何时。","厌厌病，此夕最难持。","一点芳心无托处，荼縻架上月迟迟。","惆怅有谁知。"],"s":"simp","f":"trad"},{"i":"c-d6e94368967b","t":"碧牡丹","a":"张先","d":"宋","g":"词","p":["步帐摇红绮。","晓月堕，沈烟砌。","缓板香檀，唱彻伊家新制。","怨入眉头，敛黛峰横翠。","芭蕉寒，雨声碎。","镜华翳。","闲照孤鸾戏。","思量去时容易。","钿盒瑶钗，至今冷落轻弃。","望极蓝桥，但暮云千里。","几重山，几重水。"],"s":"simp","f":"trad"},{"i":"c-2706e21147da","t":"山亭宴","a":"张先","d":"宋","g":"词","p":["碧波落日寒烟聚，望遥山、迷离红树。","小艇载人来，约尊酒、商量歧路。","衰柳断桥西，共携手、攀条无语。","水际见鷖凫，一对对、眠沙溆。","西陵松柏青如故。","翦烟花、幽兰啼露。","油壁间花骢，那禁得、风吹细雨。","饶他此后更思量，总莫似、当筵情绪。","镜面绿波平，照几度、人来去。"],"s":"mixed","f":"trad"},{"i":"c-42bf8d1439da","t":"谒金门","a":"晏殊","d":"宋","g":"词","p":["秋露坠。","滴尽楚兰红泪。","往事旧欢何限意。","思量如梦寐。","人貌老于前岁。","风月宛然无异。","座有嘉宾尊有桂。","莫辞终夕醉。"],"s":"simp","f":"trad"},{"i":"c-0292607d5cb9","t":"破阵子","a":"晏殊","d":"宋","g":"词","p":["海上蟠桃易熟，人间好月长圆。","惟有掰钗分钿侣，离别常多会面难。","此情须问天。","蜡烛到明垂泪，熏炉尽日生烟。","一点凄凉愁绝意，谩道秦筝有剩弦。","何曾为细传。"],"s":"simp","f":"trad"},{"i":"c-16c165b413cf","t":"破阵子","a":"晏殊","d":"宋","g":"词","p":["燕子欲归时节，高楼昨夜西风。","求得人间成小会，试把金尊傍菊丛。","歌长粉面红。","斜日更穿帘幕，微凉渐入梧桐。","多少襟怀言不尽，写向蛮笺曲调中。","此情千万重。"],"s":"simp","f":"trad"},{"i":"c-ca053bb6b82f","t":"破阵子","a":"晏殊","d":"宋","g":"词","p":["忆得去年今日，黄花已满东篱。","曾与玉人临小槛，共折香英泛酒卮。","长条插鬓垂。","人貌不应迁换，珍丛又睹芳菲。","重把一尊寻旧径，所惜光阴去似飞。","风飘露冷时。"],"s":"simp","f":"trad"},{"i":"c-5070070a98a9","t":"破阵子","a":"晏殊","d":"宋","g":"词","p":["湖上西风斜日，荷花落尽红英。","金菊满丛珠颗细，海燕辞巢翅羽轻。","年年岁岁情。","美酒一杯新熟，高歌数阕堪听。","不向尊前同一醉，可奈光阴似水声。","迢迢去未停。"],"s":"simp","f":"trad"},{"i":"c-f3967c0b1513","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["阆苑瑶台风露秋。","整鬟凝思捧觥筹。","欲归临别强迟留。","月好谩成孤枕梦，酒阑空得两眉愁。","此时情绪悔风流。"],"s":"simp","f":"trad"},{"i":"c-b567fe11b8eb","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["三月和风满上林。","牡丹妖艳直千金。","恼人天气又春阴。","为我转回红脸面，向谁分付紫檀心。","有情须殢酒杯深。"],"s":"simp","f":"trad"},{"i":"c-9128f99ba3a0","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["青杏园林著酒香。","佳人初试薄罗裳。","柳丝无力燕飞忙。","乍雨乍晴花自落，闲愁闲闷日偏长。","为谁消瘦减容光。"],"s":"simp","f":"trad"},{"i":"c-dad67ba88034","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["红蓼花香夹岸稠。","绿波春水向东流。","小船轻舫好追游。","渔父酒醒重拨棹，鸳鸯飞去却回头。","一杯销尽两眉愁。"],"s":"simp","f":"trad"},{"i":"c-88ac17b2ca39","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["淡淡梳妆薄薄衣。","天仙模样好容仪。","旧欢前事入颦眉。","闲役梦魂孤烛暗，恨无消息画帘垂。","且留双泪说相思。"],"s":"simp","f":"trad"},{"i":"c-d238a5c30dd3","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["小阁重帘有燕过。","晚花红片落庭莎。","曲阑干影入凉波。","一霎好风生翠幕，几回疏雨滴圆荷。","酒醒人散得愁多。"],"s":"simp","f":"trad"},{"i":"c-5e6f95284bce","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["宿酒才醒厌玉卮。","水沈香冷懒熏衣。","早梅先绽日边枝。","寒雪寂寥初散后，春风悠扬欲来时。","小屏闲放画帘垂。"],"s":"mixed","f":"trad"},{"i":"c-192597d31feb","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["绿叶红花媚晓烟。","黄蜂金蕊欲披莲。","水风深处懒回船。","可惜异香珠箔外，不辞清唱玉尊前。","使星归觐九重天。"],"s":"simp","f":"trad"},{"i":"c-83c3828a1781","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["湖上西风急暮蝉。","夜来清露湿红莲。","少留归骑促歌筵。","为别莫辞金盏酒，入朝须近玉炉烟。","不知重会是何年。"],"s":"simp","f":"trad"},{"i":"c-5e3d32bd715d","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["杨柳阴中驻彩旌。","芰荷香里劝金觥。","小词流入管弦声。","只有醉饮宽别恨，不须朝暮促归程。","雨条烟叶系人情。"],"s":"simp","f":"trad"},{"i":"c-67a176991cec","t":"浣溪沙","a":"晏殊","d":"宋","g":"词","p":["玉碗冰寒滴露华。","粉融香雪透轻纱。","晚来妆面胜荷花。","鬓亸欲迎眉际月，酒红初上脸边霞。","一场春梦日西斜。"],"s":"simp","f":"trad"},{"i":"c-d7f6fdca1990","t":"更漏子","a":"晏殊","d":"宋","g":"词","p":["蕣华浓，山翠浅。","一寸秋波如剪。","红日永，绮筵开。","暗随仙驭来。","遏云声，回雪袖。","占断晓莺春柳。","才送目，又颦眉。","此情谁得知。"],"s":"simp","f":"trad"},{"i":"c-7f912645b4c8","t":"更漏子","a":"晏殊","d":"宋","g":"词","p":["塞鸿高，仙露满。","秋入银河清浅。","逢好客，且开眉。","盛年能几时。","宝筝调，罗袖软。","拍碎画堂檀板。","须尽醉，莫推辞。","人生多别离。"],"s":"simp","f":"trad"},{"i":"c-c920bd9fc77e","t":"更漏子","a":"晏殊","d":"宋","g":"词","p":["雪藏梅，烟著柳。","依约上春时候。","初送雁，欲问莺。","绿池波浪生。","探花开，留客醉。","忆得去年情味。","金盏酒，玉炉香。","任他红日长。"],"s":"simp","f":"trad"},{"i":"c-a55e841e1868","t":"更漏子","a":"晏殊","d":"宋","g":"词","p":["菊花残，梨叶堕。","可惜良辰虚过。","新酒熟，绮筵开。","不辞红玉杯。","蜀弦高，羌管脆。","慢飐舞娥香袂。","君莫笑，醉乡人。","熙熙长似春。"],"s":"simp","f":"trad"},{"i":"c-54bf550e974f","t":"鹊踏枝・蝶恋花","a":"晏殊","d":"宋","g":"词","p":["槛菊愁烟兰泣露。","罗幕轻寒，燕子双飞去。","明月不谙离恨苦。","斜光到晓穿朱户。","昨夜西风凋碧树。","独上高楼，望尽天涯路。","欲寄彩笺兼尺素。","山长水阔知何处。"],"s":"simp","f":"trad"}]