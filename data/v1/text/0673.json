[{"i":"c-f516a7227eb0","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["滟滟湖光绿一围。","修林断处白鸥飞。","天机云锦蘸空飞。","乞我百弓真可老，为公一饮醉忘归。","扁舟日日弄晴晖。"]},{"i":"c-9328d5c2eca8","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["晚雨潇潇急做秋。","西风凉鬓已飕飕。","烛花明夜酒花浮。","醉眼定知非妙赏，□词端为□□留。","想君泾渭不同流。"]},{"i":"c-2a6be1121f42","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["稳泛仙舟上锦帆。","桃花清浪舞清湾。","寿星相伴到人间。","黄石公传三百字，西王母授九霞丹。","银潢有路接三山。"]},{"i":"c-202abf8781f8","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["北苑春风小凤团。","炎州沈水胜龙涎。","殷勤送与绣衣仙。","玉食乡来思苦口，芳名久合上凌烟。","天教富贵出长年。"]},{"i":"c-a466676b54ab","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["霜日明宵水蘸空。","鸣鞘声里绣旗红。","澹烟衰草有无中。","万里中原烽火北，一尊浊酒戍楼东。","酒阑挥泪向悲风。"]},{"i":"c-af3634066323","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["宫柳垂垂碧照空。","九门深处五云红。","朱衣只在殿当中。","细拈丝梢龙尾北，缓携纶旨凤池东。","阿婆三五笑春风。"]},{"i":"c-6b26bc596a43","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["日暖帘帏春画长。","纤纤玉指动抨床。","低头佯不顾檀郎。","豆蔻枝头双蛱蝶，芙蓉花下两鸳鸯。","壁间闻得唾茸香。"]},{"i":"c-9605d3befa37","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["射策金门记昔年。","又交藩翰入陶甄。","不妨衣钵再三传。","粉泪但能添楚竹，罗巾谁解系吴船。","捧杯犹愿小留连。"]},{"i":"c-f1f626942330","t":"浪淘沙","a":"张孝祥","d":"宋","g":"词","p":["琪树间瑶林。","春意深深。","梅花还被晓寒禁。","竹里一枝斜向我，欲诉芳心。","楼外卷重阴。","玉界沈沈。","何人低唱醉泥金。","掠水飞来双翠碧，应寄归音。"]},{"i":"c-b7583a8b72e1","t":"浪淘沙","a":"张孝祥","d":"宋","g":"词","p":["溪练写寒林。","云重烟深。","楼高风恶酒难禁。","徙倚阑干谁共语，江上愁心。","清兴满山阴。","鸿断鱼沈。","一书何啻值千金。","独扶瑶微弦欲断，凭寄知音。"]},{"i":"c-e0f5d6d06364","t":"定风波","a":"张孝祥","d":"宋","g":"词","p":["铃索声乾夜未央。","曲栏花影步凄凉。","莫道岭南冬更暖。","君看。","梅花如雪月如霜。","见说墙西歌吹好，玉人扶坐劝飞觞。","老子婆婆成独冷。","谁省。","自挑寒灺自添香。"]},{"i":"c-1a5a3a5068f8","t":"望江南・忆江南","a":"张孝祥","d":"宋","g":"词","p":["谈子醉，独立睨东风。","未试玉堂挥翰手，只今楚泽钓鱼翁。","万事举杯空。","谋一笑，一笑与君同。","身老南山看射虎，眼高四海送飞鸿。","赤岸晚潮通。"]},{"i":"c-0f0b2aa07be7","t":"望江南・忆江南","a":"张孝祥","d":"宋","g":"词","p":["朝元去，深殿扣瑶钟。","天近月明黄道冷，参回斗转碧宵空。","身在九光中。","风露下，环佩响丁东。","玉案烧香萦翠凤，松坛移影动苍龙。","归路海霞红。"]},{"i":"c-c968dadd94b9","t":"醉落魄・一斛珠","a":"张孝祥","d":"宋","g":"词","p":["轻黄澹绿。","可人风韵闲装束。","多情早是眉峰蹙。","一点秋波，闲里观人毒。","桃花庭院光阴速。","铜鞮谁唱大堤曲。","归时想是樱桃熟。","不道秋千，谁伴那人蹴。"]},{"i":"c-8af9ba6d4af2","t":"桃源忆故人","a":"张孝祥","d":"宋","g":"词","p":["朔风弄月吹银霰。","帘幕低垂三面。","酒入玉肌香软。","压得寒威敛。","檀槽乍拈么丝慢。","弹得相思一半。","不道有人肠断。","犹作声声颤。"]},{"i":"c-ec2b8d5f8992","t":"临江仙","a":"张孝祥","d":"宋","g":"词","p":["试问梅花何处好，与君藉草携壶。","西园清夜片尘无。","一天云破碎，两树玉扶疏。","谁擫昭华吹古怨，散花便满衣裾。","只疑幽梦在清都。","星稀河影转，霜重月华孤。"]},{"i":"c-51972b65e427","t":"临江仙","a":"张孝祥","d":"宋","g":"词","p":["试问宜楼楼下竹，年来应长新篁。","使君五岭又三湘。","旧游知好在，熟处更难忘。","尚念论心舒歗否，只今湖海相望。","遥怜阴过酒尊凉。","举觞须酹我，门外是清江。"]},{"i":"c-d28c1f7f6f61","t":"如梦令","a":"张孝祥","d":"宋","g":"词","p":["花叶相遮相映。","雨过翠明金润。","折得一枝归，满路清香成阵。","风韵。","风韵。","寄赠绮窗云鬓。"]},{"i":"c-22b7bd9b33f9","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["丝金缕翠幡儿小。","裁罗拈线花枝袅。","明日是新春。","春风生鬓云。","吴霜看点点。","愁里春来浅。","只愿此花枝。","年年长带伊。"]},{"i":"c-01031a83da3d","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["庭叶翻翻秋向晚。","凉砧敲月催金剪。","楼上已清寒。","不堪频倚栏。","邻翁开社瓮。","唤客情意重。","不醉且无归。","醉时归路迷。"]},{"i":"c-63878527f98a","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["恰则春来春又去。","凭谁说与春教住。","与问坐中人。","几回迎送春。","明年春更好。","只怕人先老。","春去有来时。","愿春长见伊。"]},{"i":"c-be15e81c3d63","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["东风约略吹罗幕。","一檐细雨春阴薄。","试把杏花看。","湿红娇暮寒。","佳人双玉枕。","烘醉鸳鸯锦。","折得最繁枝。","暖香生翠帏。"]},{"i":"c-6b6529907c43","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["琢成红玉纤纤指。","十三弦上调新水。","一弄入云声。","月明天更青。","匆匆莺语啭。","待寓昭君怨。","寄语莫重弹。","有人愁倚栏。"]},{"i":"c-19ec8df74f9f","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["玉龙细点三更月。","庭花影下馀残雪。","寒色到书帏。","有人清梦迷。","墙西歌吹好。","烛暖香闺小。","多病怯杯觞。","不禁冬夜长。"]},{"i":"c-3eeed2873d9f","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["江山佳处留行客。","醉馀老眼迷空碧。","独倚最高楼。","乾坤日夜浮。","微风吹笑语。","白日鱼龙舞。","此意忽翩翩。","凭虚吾欲仙。"]},{"i":"c-44b4084af849","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["雪消墙角收灯后。","野梅官柳春全透。","池阁又东风。","烛花烧夜红。","一尊留好客。","敧尽阑干月。","已醉不须归。","试听乌夜啼。"]},{"i":"c-4d91e769eea3","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["溶溶花月天如水。","阑干小倚东风里。","夜久寂无人。","露浓花气清。","悠然心独喜。","此意如何意。","不似隐墙东。","烛花围坐红。"]},{"i":"c-cdbb9d7407ac","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["暗潮清涨蒲塘晚。","断云不隔东归眼。","堂上晚风凉。","藕花开处香。","夜航人不渡。","白鹭双飞去。","待得月华生。","携筇独自行。"]},{"i":"c-7ed385e41f7f","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["缥缈飞来双彩凤。","雨疏云淡撩清梦。","兰薄未禁秋。","月华如水流。","采香溪上路。","愁满参差树。","独倚晚楼风。","断霞萦素空。"]},{"i":"c-9c044242f439","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["蘼芜白芷愁烟渚。","曲琼细卷江南雨。","心事怯衣单。","楼高生晚寒。","云鬓香雾湿。","翠袖凄馀泣。","春去有来时，春从沙际归。"]},{"i":"c-f5ee953f65ff","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["十年长作江头客。","樯竿又挂西风席。","白鸟去边明。","楚山无数青。","倒冠仍落佩。","我醉君须醉。","试问识君不。","青山与白鸥。"]},{"i":"c-cac5b4935ee4","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["乳羝属国归来早。","知君胆大身犹小。","一节不须论。","功名看致君。","镇西楼上酒。","父老为公寿。","更祝太夫人。","年年封诏新。"]},{"i":"c-5efdf5660c13","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["胭脂浅染双珠树。","东风到处娇无数。","不语恨厌厌。","何人思故园。","故园花烂熳。","笑我归来晚。","我老只思归。","故园花雨时。"]},{"i":"c-ff338250ef4d","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["吴波细卷东风急。","斜阳半落苍烟湿。","一棹采菱歌。","倚栏人奈何。","天公怜好客。","酒面风吹白。","更引十玻璃。","月明骑鹤归。"]},{"i":"c-2912804f59ce","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["冥濛秋夕溥清露。","玉绳耿耿银潢注。","永夜滴铜壶。","月华楼影孤。","佳人纡绝唱。","翠幕丛宵上。","休劝玉东西。","乌鸦枝上啼。"]},{"i":"c-ee4fa1985121","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["问讯湖边春色，重来又是三年。","东风吹我过湖船。","杨柳丝丝拂面。","世路如今已惯，此心到处悠然。","寒光庭下水如天。","飞起沙鸥一片。"]},{"i":"c-b2aad29b9783","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["风定滩声未已，雨来篷底先知。","岸边杨柳最怜伊。","忆得船儿曾系。","湖雾平吞白塔，茅檐自有青旗。","三杯村酒醉如泥。","天色寒呵且睡。"]},{"i":"c-0c99de32ad30","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["冉冉寒生碧树，盈盈露湿黄花。","故人玉节有光华。","高会仍逢戏马。","万事只今如梦，此身到处为家。","与君相逢更天涯。","拼了茱萸醉把。"]},{"i":"c-90240c7674f6","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["诸老何烦荐口，先生自简渊衷。","千年圣学有深功。","妙处无非日用。","已授一编圯下，却须三顾隆中。","鸿钧早晚转春风。","我亦从君贾勇。"]},{"i":"c-9806582bbe6f","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["慈母行封大国，老仙早上蓬山。","天怜阴德遍人间。","赐与还丹七返。","莫问清都紫府，长教绿鬓朱颜。","年年今日采衣斑。","兄弟同扶酒盏。"]},{"i":"c-e11835eea7d0","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["不识平源太守，向来水北山人。","世间功业谩亏成。","华发萧萧满镜。","幸有田园故里，聊分风月江城。","西湖西畔晚波平。","袖手时来照影。"]},{"i":"c-1e7735453e88","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["楼外疏星印水，楼头画烛烘帘。","凭高举酒恨厌厌。","征路虚无指点。","酒兴因君开阔，山容向我增添。","一钩新月弄纤纤。","浓雾花房办敛。"]},{"i":"c-38e9448e65fd","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["满载一船秋色，平铺十里湖光。","波神留我看斜阳。","放起鳞鳞细浪。","明日风回更好，今宵露宿何妨。","水晶宫里奏《霓裳》。","准拟岳阳楼上。"]},{"i":"c-5ba4c6f1d205","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["窗户青红尚湿，主人已作归期。","坐中宾客尽邹枚。","盛事它年应记。","别酒深深但劝，离歌缓缓休催。","扁舟明日转清溪。","好月相望千里。"]},{"i":"c-0ebf682552d5","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["汗铸九金神鼎，隋书小字莲经。","刚风劫火转清冥。","护守应烦仙圣。","昨梦归来帝所，今朝寿我亲庭。","只将此宝伴长生。","谈笑中原底定。"]},{"i":"c-9dee90ab2c9e","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["落日熔金万顷，晴岚洗剑双锋。","紫枢元是黑头公。","佳处因君愈重。","分得湖光一曲，唤回庐岳千峰。","清尊今夜偶然同。","早晚商岩有梦。"]},{"i":"c-a054711ecdb3","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["畴昔通家事契，只今两镇交承。","起居枢密太夫人。","绿鬓斑衣相映。","乞得神仙九酝，祝教福禄千春。","台星直上寿星明。","长见门阑鼎盛。"]},{"i":"c-98641f5f05d5","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["佳人绝妙。","不惜千金频买笑。","燕姹莺娇。","始遣清歌透碧宵。","主人好事。","更倒一尊留客醉。","我醉思家。","月满南池欲漾花。"]},{"i":"c-f5c6e965c67a","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["一尊留夜。","宾蜡烘帘光激射。","冻合铜壶。","细听冰檐夜剪酥。","清愁冉冉。","酒唤红潮登玉脸。","明日重看。","玉界琼楼特地寒。"]},{"i":"c-8f29537ccf93","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["爱而不见。","立马章台空便面。","想像娉婷。","只恐丹青画不成。","诗人老去。","恰要莺莺相伴住。","试与平章。","岁晚教人枉断肠。"]},{"i":"c-ca61f2bab8d1","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["阿谁曾见。","马上墙阴通半面。","玉立娉婷。","一点灵犀寄目成。","明朝重去。","人在横溪溪畔住。","乔木千章。","摇落霜风只断肠。"]},{"i":"c-b65581fdf8fd","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["江头送客。","枫叶荻花秋索索。","弦索休弹。","清泪无多怕湿衫。","故人相遇。","不醉如何归得去。","我醉望归。","烟满空江月满堤。"]},{"i":"c-38ad31025cfd","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["春如有意。","未接年华春已至。","春事还新。","多得年时五日春。","春郊便绿。","只向腊前春已足。","屈指元宵。","正是新春二十朝。"]},{"i":"c-77fd935e91c7","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["慈闱生日。","见说今年年九十。","戏彩盈门。","大底孩儿七个孙。","人间喜事。","只这一般难得似。","愿我双亲。","都似君家太淑人。"]},{"i":"c-25cee3e1c698","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["吹箫泛月。","往事悠悠休更说。","拍碎琉璃。","始觉从前万事非。","清齐净戒。","休作断肠垂泪债。","识破嚣尘。","作个逍遥物外人。"]},{"i":"c-4ec639fed026","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["人间奇绝。","只有梅花枝上雪。","有个人人。","梅样风标雪样新。","芳心不展。","嫩绿阴阴愁冉冉。","一笑相看。","试荐冰磐一点酸。"]},{"i":"c-49b38682cac6","t":"减字木兰花","a":"张孝祥","d":"宋","g":"词","p":["枷花搦柳。","知道东君留意久。","惨绿愁红。","憔悴都因一夜风。","轻狂蝴蝶。","拟欲扶持心又怯。","要免离披。","不告东君更告谁。"]},{"i":"c-3f73cf0978dc","t":"清平乐","a":"张孝祥","d":"宋","g":"词","p":["光尘扑扑。","宫柳低迷绿。","斗鸭阑干春诘曲。","帘额微风绣蹙。","碧云轻翼无凭。","困来小倚银屏。","楚梦未禁春晚，黄鹂犹自声声。"]},{"i":"c-0b5b8a9bc35e","t":"清平乐","a":"张孝祥","d":"宋","g":"词","p":["油幢画戟。","玉铉调春色。","勋阀诸郎俱第一。","风流前辈敌。","玉人双鞚华□。","翠云深处消摇。","有客留君东阁，时闻风下笙箫。"]},{"i":"c-bb0a3d404c6d","t":"清平乐","a":"张孝祥","d":"宋","g":"词","p":["吹香嚼蕊。","独立东风里。","玉冻云娇天似水。","羞杀夭桃秾李。","如今见说阑干。","不禁月冷霜寒。","垅上驿程人远，楼头戍角声乾。"]},{"i":"c-a396ab21ef3d","t":"清平乐","a":"张孝祥","d":"宋","g":"词","p":["英姿慷慨。","独立风尘外。","湖海平生豪气在。","行矣云龙际会。","充庭兰玉森森。","一觞共祝修铃。","此地去天尺五，明年持櫜西清。"]},{"i":"c-c54049baa8d8","t":"清平乐","a":"张孝祥","d":"宋","g":"词","p":["向来省户。","谋国参伊吕。","暂借良筹非再举。","谈笑肃清三楚。","良辰上客徜佯。","奏篇犹记传香。","此日一尊相属，它时同在岩廊。"]},{"i":"c-4695c52c1595","t":"点绛唇","a":"张孝祥","d":"宋","g":"词","p":["四到蕲州，今年更是逢重九。","应时纳祐。","随分开尊酒。","屡舞婆娑，醉我平生友。","休回首。","世间何有。","明月疏疏柳。"]},{"i":"c-17f8995f1a65","t":"点绛唇","a":"张孝祥","d":"宋","g":"词","p":["绮燕高张，玉潭月丽玻璃满。","旆霞行卷。","无复长安远。","夏木阴阴，路袅薰风转。","空留恋。","细吹银管。","别意随声缓。"]},{"i":"c-b98c06313d84","t":"点绛唇","a":"张孝祥","d":"宋","g":"词","p":["萱草榴花，画堂永昼风清暑。","麝团菰黍。","助泛菖蒲醑。","兵辟神符，命续同心缕。","宜欢聚。","绮筵歌舞。","岁岁酬端午。"]},{"i":"c-b5375b0316d3","t":"卜算子","a":"张孝祥","d":"宋","g":"词","p":["雪月最相宜，梅雪都清绝。","去岁江南见雪时，月底梅花发。","今岁早梅开，依旧年时月。","冷艳孤光照眼明，只欠些儿雪。"]},{"i":"c-2fc131df03a0","t":"诉衷情","a":"张孝祥","d":"宋","g":"词","p":["晚烟斜日思悠悠。","西北有高楼。","十分准拟明月，还似去年游。","飞玉斝，卷琼钩。","唤新愁。","姮娥贪共，暮雨朝云，忘了中秋。"]},{"i":"c-9c4de44ae617","t":"诉衷情","a":"张孝祥","d":"宋","g":"词","p":["乱红深紫过群芳。","初欲灭春光。","花王自有标格，尘外锁韶阳。","留国艳，问仙乡。","自天香。","翠帏遮日，红烛通宵，与醉千场。"]},{"i":"c-6972cff730e2","t":"好事近","a":"张孝祥","d":"宋","g":"词","p":["一朵木犀花，珍重玉纤新摘。","插向远山深处，占十分秋色。","满园桃李闹春风，漫红红白白。","争似淡妆娇面，伴蓬莱仙客。"]},{"i":"c-b0e6e5a05009","t":"好事近","a":"张孝祥","d":"宋","g":"词","p":["万瓦雪花浮，应是化工融结。","仍看牡丹初绽，有层层千叶。","镂冰剪水更鲜明，说道真奇绝。","来报主人佳兆，庆我公还阕。"]},{"i":"c-53550dfab1c3","t":"南歌子","a":"张孝祥","d":"宋","g":"词","p":["曾到蕲州不，人人说使君。","使君才具合经纶。","小试边城、早晚上星辰。","佳节重阳近，清歌午夜新。","举杯相属莫辞频。","后日相思、我已是行人。"]},{"i":"c-dab1c45c7ac7","t":"水调歌头","a":"李处全","d":"宋","g":"词","p":["明月浸瑶碧，河汉水交流。","偏来照我，知我白发不胜愁。","客里山中三载，枕上人间一梦，曾忆到瀛洲。","矫首蓬壶路，两腋已飕飕。","记扁舟，浮震泽，趁中秋。","垂虹亭上，与客千里快凝眸。","看剑引杯狂醉，饮水曲肱高卧，鹏鷃已同游。","起舞三人耳，横笛唤沙鸥。"]},{"i":"c-facb7cf83469","t":"水调歌头","a":"李处全","d":"宋","g":"词","p":["落日暝云合，客子意如何。","定知今日，封六巽二弄干戈。","四望际天空阔，一叶凌涛掀舞，壮志未消磨。","为向吴儿道，听我扣舷歌。","我常欲，利剑戟，斩蛟鼍。","胡尘未扫，指挥壮士挽天河。","谁料半生忧患，成就如今老态，白发逐年多。","对此貌无恐，心亦畏风波。"]},{"i":"c-b572500d82cc","t":"水调歌头","a":"李处全","d":"宋","g":"词","p":["春事已如许，柳眼早依依。","故园桃李何似，芳蕊想团枝。","此地嵩高名里，信美元非吾土。","清梦绕瀍洢。","扶杖欲行乐，还使我心悲。","对琴书，歌一阕，引千卮。","昔曾击楫，今日投老叹吾衰。","睡起推窗凝睇，失喜柔桑微绿，便拟作春衣。","搔首长吟处，此意有谁知。"]},{"i":"c-e9caaa1a3eb7","t":"水调歌头","a":"李处全","d":"宋","g":"词","p":["微雨眼明处，春信著南枝。","百花头上消息，为我赴襟期。","松下凌霜古干，竹外横窗疏影，同是翠寒姿。","唤取我曹赏，莫使俗流知。","对风前，看雪后，总相宜。","碧天如洗，何许羌笛月边吹。","一段出群标格，合得水仙兄事，千古豫章诗。","鼎鼐付佳实，终待梦秋时。"]},{"i":"c-81cdcc009509","t":"水调歌头","a":"李处全","d":"宋","g":"词","p":["飞雪已传信，端叶未分枝。","莫嫌开晚，前月曾付小春期。","谁道梳风洗雨，不许调脂弄粉，容易涴天姿。","眼界未多见，鼻观已先知。","昔西湖，今北客，各从宜。","要渠烂熳，趣得暖律为渠吹。","犹记石亭攀折，浑似扬州观赏，清兴欲寻诗。","三嗅不离手，如得和篇时。"]},{"i":"c-d5c8f4515065","t":"水调歌头","a":"李处全","d":"宋","g":"词","p":["今夕定何夕，今夕岁还除。","团栾儿女，尽情灯火照围炉。","但惜年从节换，便觉身随日老，踪迹尚沈浮。","万事古如此，聊作旧桃符。","任东风，吹缟鬓，戏臞儒。","韶颜壮齿，背人去似隙中驹。","杯酌犹倾腊酒，漏箭已传春夜，何处不歌呼。","惟愿长穷健，命酹且欢娱。"]},{"i":"c-af96e95bff0c","t":"水调歌头","a":"李处全","d":"宋","g":"词","p":["楼观数南国，烟雨压东州。","溪山雄胜，天开图画肖瀛洲。","我破瀛洲客梦，来剖仙洲符竹，乐岁又云秋。","聊作幻师戏，肯遗后人愁。","趁佳时，招我辈，共凝眸。","君侯胸次邱壑，意匠付冥搜。","刻日落成华栋，对月难并清景，千丈素光流。","老子兴何极，小子趣觥筹。"]},{"i":"c-5664c15f6a62","t":"满江红","a":"李处全","d":"宋","g":"词","p":["清晓高堂，春晚处、旧红新绿。","耸曩昔、蟠桃初种，更并潭菊。","强健老人松下鹤，森荣孙子霜中竹。","看共持、寿斝祝期颐，倾醽醁。","烘晴昼，炉烟馥。","连永夜，笙歌簇。","喜一时欢意，何人兼足。","早愿诸甥成宅相，便从明岁开汤沐。","向年年、今日度新腔，调仙曲。"]},{"i":"c-00e360d2a45e","t":"临江仙","a":"李处全","d":"宋","g":"词","p":["畴昔方壶游戏地，群仙步履相从。","明黄衫子御西风。","佩环金错落，羽葆翠璁珑。","骑鹄翩然归去路，吹箫横度青峰。","夜深河汉冷秋容。","前驱香十里，飘坠月轮东。"]},{"i":"c-7183b5ba5abf","t":"念奴娇","a":"李处全","d":"宋","g":"词","p":["一天春意，趁东皇幽赏，重飞端叶。","造物有心成伟观，来伴红蕖开彻。","桂魄初圆，梅腮全放，节物俱奇绝。","冷官门巷，望中北固楼堞。","遐想蓬底高人，拥衾无寐，九曲长增结。","我亦低窗翻蠹纸，失喜瑶花盈尺。","拥鼻孤吟，搔头危坐，所欠惟佳客。","须君来此，脸纹相对生缬。"]},{"i":"c-8d1e13bf77b3","t":"满庭芳","a":"李处全","d":"宋","g":"词","p":["乳燕将雏，啼莺求友，江南梅子黄时。","欲晴还雨，烟外看成丝。","迎袂风来梦陇，吹饼饵、香入书帷。","行吟处，溪翁说我，不似去年衰。","方池。","荷出水，朱榴倚槛，粉箨穿篱。","有吾曹我辈，把酒寻诗。","醉去黑甜一枕，炉烟袅、花影斜晖。","家山乐，南窗寄傲，唯有晦庵知。"]},{"i":"c-bba7fb96bc23","t":"鹧鸪天","a":"李处全","d":"宋","g":"词","p":["烟雨溟溟趁落成。","只应天欲称佳名。","万丝明灭青山映，匹素浓纤渌水萦。","民亦乐，美能并。","酒杯莫惜十分倾。","要知社下平生志，觞政聊须为主盟。"]},{"i":"c-349dbdff3a69","t":"鹧鸪天","a":"李处全","d":"宋","g":"词","p":["缥缈危楼百尺雄。","淡烟疏雨暗帘栊。","偶妨清赏中秋夕，为忆名言玉局翁。","贤达意，古今同。","凉天佳月会相逢。","老蟾一跃三千丈，却唤姮娥驾阆风。"]},{"i":"c-fe42fd7829f2","t":"柳梢青","a":"李处全","d":"宋","g":"词","p":["九天圆月。","香尘碎玉，素涛翻雪。","石乳香甘，松风汤嫩，一时三绝。","清宵好尽欢娱，奈明日、扶头怎说。","整顿颓山，殷勤春露，馀甘齿颊。"]},{"i":"c-a8f2cdc30ab7","t":"柳梢青","a":"李处全","d":"宋","g":"词","p":["馀甘齿颊。","酒□半酣，漏声频促。","月下传呼，风前掺别，无因留客。","丁宁玉笋磨香，为料理、十分醒著。","后会何时，前欢未尽，明朝重约。"]},{"i":"c-d11978879ef1","t":"朝中措","a":"李处全","d":"宋","g":"词","p":["晦庵四至似天宽。","生计有心田。","闲弄炉薰茗碗，困寻纸帐蒲团。","商山橘隐，须弥芥纳，容与湖天。","谁笑先生贫窭，东篱无数金钱。"]},{"i":"c-ab84f2a32953","t":"朝中措","a":"李处全","d":"宋","g":"词","p":["薰风庭院燕双飞。","园柳啭黄鹂。","是处蜂狂蝶乱，元来绿暗红稀。","衫笼白苎，琴推绿绮，满眼新诗。","好个江南风景，杜鹃犹自催归。"]},{"i":"c-951f796edcc4","t":"菩萨蛮","a":"李处全","d":"宋","g":"词","p":["杜鹃只管催归去。","知渠教我归何处。","故国泪生痕。","那堪枕上闻。","严装吾已具。","泛宅吴中路。","弭棹唤东邻。","江东日暮云。"]},{"i":"c-787b71136240","t":"菩萨蛮","a":"李处全","d":"宋","g":"词","p":["晦庵老子修行久。","问禅金粟曾回首。","截竹是禅机。","吹破粟玉枝。","西湖秋好处。","承得昭阳露。","香透月轮低。","来薰打坐时。"]},{"i":"c-07c0dace451e","t":"菩萨蛮","a":"李处全","d":"宋","g":"词","p":["四时皆有司花女。","杪秋犹见花如许。","想得紫金丹。","工夫造化间。","春莺留弱羽。","更渍蔷薇露。","莫取落英餐。","留供醉眼看。"]},{"i":"c-8594189c2f47","t":"浣溪沙","a":"李处全","d":"宋","g":"词","p":["宋玉应当久断肠。","满城风雨尽重阳。","年年戏马忆吾乡。","催促东篱金蕊放，佳人更绣紫萸囊。","白衣才到共飞觞。"]},{"i":"c-cfb94bca9cd3","t":"西江月","a":"李处全","d":"宋","g":"词","p":["窗户风薰端午，楼台月满中秋。","阴晴寒暑总无忧。","几事不如重九。","落帽何羞种种，看山都付悠悠。","黄花已作醉乡游。","梦觉黄花在手。"]},{"i":"c-c121b49e5029","t":"西江月","a":"李处全","d":"宋","g":"词","p":["婥婥妆楼红袖，亭亭将阃青油。","东皇天巧世无俦。","定有司花妙手。","十里香风晓霁，千家绮陌春游。","竹西路转古扬州。","歌吹只应如旧。"]},{"i":"c-d6748d85f051","t":"西江月","a":"李处全","d":"宋","g":"词","p":["南国一分春色，东窗八面光风。","女兄欢笑酒尊同。","满眼儿孙群从。","但愿年逾百岁，何妨时醉千锺。","朱颜绿发照青铜。","要看如龙如凤。"]},{"i":"c-3a74730ea741","t":"生查子","a":"李处全","d":"宋","g":"词","p":["庭户小光中，帘幕秋光里。","曲沼绮疏横，几处新妆洗。","红脸露轻匀，翠袖风频倚。","鸾鉴不须开，自有窗前水。"]},{"i":"c-260c630c5276","t":"生查子","a":"李处全","d":"宋","g":"词","p":["温柔属东西，和冷经三五。","几夜德星明，果应荀陈聚。","分虎屈雄姿，展骥淹遐步。","除诏已涂芝，便看朝天去。"]},{"i":"c-d5a415d4bcc8","t":"减字木兰花","a":"李处全","d":"宋","g":"词","p":["今年菊早。","想到重阳花正好。","玉冷金寒。","全似东篱挹露看。","色庄香重。","直与梅花堪伯仲。","待唤渊明。","三友相从盖为倾。"]},{"i":"c-238fa6591220","t":"减字木兰花","a":"李处全","d":"宋","g":"词","p":["谁将翡翠。","闲屑黄金摅巧思。","缀就花钿。","飞上秋云入鬓蝉。","一枝斜倚。","披拂香风多少意。","午镜重匀。","娇额妆成宫样新。"]},{"i":"c-e6a35d3238d2","t":"减字木兰花","a":"李处全","d":"宋","g":"词","p":["更生观尽。","双璧蒹葭那敢并。","四海无人。","笑语从容许我亲。","平生此客。","复与太丘登醉白。","病里颦眉。","贪看惺惺骑马归。"]}]