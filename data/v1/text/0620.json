[{"i":"c-647c05946e36","t":"青玉案","a":"惠洪","d":"宋","g":"词","p":["凝祥宴罢闻歌吹。","画毂走，香尘起。","冠压花枝驰万骑。","马行灯闹，凤楼帘卷，陆海龙鳌山对。","当年曾看天颜醉。","御杯举，欢声沸。","时节虽同悲乐异。","海风吹梦，岭猿啼月，一枕思归泪。"],"s":"simp","f":"trad"},{"i":"c-56acd26d8054","t":"西江月","a":"惠洪","d":"宋","g":"词","p":["入骨风流国色，透尘种性真香。","为谁风鬓涴新妆。","半树入村春暗。","雪压枝低篱落，月高影动池塘。","高情数笔寄微茫。","小寝初开雾帐。"],"s":"simp","f":"trad"},{"i":"c-72771cd05339","t":"浪淘沙","a":"惠洪","d":"宋","g":"词","p":["城里久偷闲。","尘浣云衫。","此身已是再眠蚕。","隔岸有山归去好，万壑千岩。","霜晓更凭阑。","减尽晴岚。","微云生处是茅庵。","试问此生谁作伴，弥勒同龛。"],"s":"simp","f":"trad"},{"i":"c-153fc7b2f0d3","t":"浪淘沙","a":"惠洪","d":"宋","g":"词","p":["山径晚樵远。","深壑孱颜。","孙山背后泊船看。","手把遗编披白帔，剩却清闲。","篱落竹丛寒。","渔业凋残。","水痕无底照秋宽。","好在夕阳凝睇处，数笔秋山。"],"s":"simp","f":"trad"},{"i":"c-365ce22c1312","t":"水调歌头","a":"吕颐浩","d":"宋","g":"词","p":["一片苍崖璞，孕秀自天锺。","浑如暖烟堆里，乍放力犹慵。","疑是犀眠海畔，贪玩烂银光彩，精魄入蟾宫。","泼墨阴云妒，蟾影淡朦胧。","沩山颂，戴生笔，写难穷。","些儿造化，凭谁细与问元工。","那用牧童鞭索，不入千群万队，扣角起雷同。","莫怪作诗手，偷入锦囊中。"],"s":"simp","f":"trad"},{"i":"c-038a4443420a","t":"点绛唇","a":"苏过","d":"宋","g":"词","p":["新月娟娟，夜寒江静山衔斗。","起来搔首。","梅影横窗瘦。","好个霜天，闲却传杯手。","君知否。","乱鸦啼后。","归兴浓如酒。"],"s":"simp","f":"trad"},{"i":"c-fb501122b977","t":"感皇恩","a":"陆蕴","d":"宋","g":"词","p":["残角两三声，催登古道。","远水长山又重到。","水声山色，看尽轮蹄昏晓。","风头日脚下，人空老。","匹马旧时，西征谈笑。","绿鬓朱颜正年少。","旗亭斗酒，任是十千倾倒。","面今酒兴减，诗情少。"],"s":"simp","f":"trad"},{"i":"c-703faaf770e2","t":"忆君王・忆王孙","a":"谢克家","d":"宋","g":"词","p":["依依宫柳拂宫墙。","楼殿无人春昼长。","燕子归来依旧忙。","忆君王。","月破黄昏人断肠。"],"s":"simp","f":"trad"},{"i":"c-6ecb3d893e8a","t":"江神子・江城子","a":"葛胜仲","d":"宋","g":"词","p":["昏昏雪意惨云容。","猎霜风。","岁将穷。","流落天涯，憔悴一衰翁。","清夜小窗围兽火，倾酒绿，借颜红。","官梅疏艳小壶中。","暗香浓。","玉玲珑。","对景忽惊，身在大江东。","上国故人谁念我，晴嶂远，暮云重。"],"s":"simp","f":"trad"},{"i":"c-c9ad3203d6dc","t":"蝶恋花","a":"葛胜仲","d":"宋","g":"词","p":["雨后春光浓似醉。","著柳催花，节物侵龙忌。","绣褓香阁当日佩。","紫兰宫堕人间世。","歌管停云香吐穗。","碧酒红裳，共祝鱼轩贵。","天上阿环金箓秘。","龟龄鹤寿三千岁。"],"s":"simp","f":"trad"},{"i":"c-3d03aae8613e","t":"蝶恋花","a":"葛胜仲","d":"宋","g":"词","p":["共乐堂深帘不卷。","恻恻寒轻，二月春犹浅。","续寿竞来歌舞院。","龙涎香衬鲛绡段。","画栋朝飞双语燕。","端似知人，著意窥金盏。","柳外花前同祝愿。","朱颜长在年龄远。"],"s":"simp","f":"trad"},{"i":"c-f90ae134ee45","t":"临江仙","a":"葛胜仲","d":"宋","g":"词","p":["郊外黄垓端可厌，归来移病香闺。","象床珍簟共委蛇。","耆婆寻草尽，天女散花迟。","小雨作寒秋意晚。","檐声与梦相宜。","冷侵罗幌酒烟微。","试评书五朵，何似画双眉。"],"s":"simp","f":"trad"},{"i":"c-2246f7de803a","t":"渔家傲","a":"葛胜仲","d":"宋","g":"词","p":["岩壑萦回云水窟。","林深路断迷烟客。","茅屋数椽携杖舄。","人寂寂。","侵檐万个琅玕碧。","倦客羁怀清似涤。","更无一点飞埃迹。","溪涨慢流过几席。","寒湜湜。","凫鷖点破琉璃色。"],"s":"mixed","f":"trad"},{"i":"c-aef5e3315438","t":"渔家傲","a":"葛胜仲","d":"宋","g":"词","p":["叠叠云山供四顾。","簿书忙里偷闲去。","心远地偏陶令趣。","登览处。","清幽疑是斜川路。","野蔌溪毛供饮具。","此身甘被烟霞痼。","兴尽碧云催日暮。","招晚渡。","遥遥一叶随鸥鹭。"],"s":"simp","f":"trad"},{"i":"c-f6be150334a0","t":"鹧鸪天","a":"葛胜仲","d":"宋","g":"词","p":["小榭幽园翠箔垂。","云轻日薄淡秋晖。","菊英露浥渊明径，藕叶风吹叔宝池。","酬素景，泥芳卮。","老人痴钝强伸眉。","欢华莫遣笙歌散，归路从教灯影稀。"],"s":"simp","f":"trad"},{"i":"c-633c966157ed","t":"鹧鸪天","a":"葛胜仲","d":"宋","g":"词","p":["婆律香深气味佳。","玻璃仙碗进流霞。","凝膏清涤高阳醉，灵液甘和正焙芽。","香染指，浪浮花。","加笾礼尽客还家。","贯珠声断红裳散，踏影人归素月斜。"],"s":"simp","f":"trad"},{"i":"c-7525d2f8d632","t":"点绛唇","a":"葛胜仲","d":"宋","g":"词","p":["秋晚寒斋，藜床香篆横轻雾。","闲愁几许。","梦逐芭蕉雨。","云外哀鸿，似替幽人语。","归不去。","乱山无数。","斜日荒城鼓。"],"s":"simp","f":"trad"},{"i":"c-bc4487966365","t":"行香子","a":"葛胜仲","d":"宋","g":"词","p":["风物飕飕。","木落沧洲。","渐老人、不奈悲秋。","羁怀都在，鬓上眉头。","似休文瘦，文通恨，子山愁。","庭梧影薄，篱菊香浮。","强招寻、聊命朋俦。","穷通皆梦，今古如流。","且渊明径，子猷舫，仲宣楼。"],"s":"simp","f":"trad"},{"i":"c-5a9da329b48c","t":"诉衷情","a":"葛胜仲","d":"宋","g":"词","p":["清明寒食景暄妍。","花映碧罗天。","参差捍拨齐奏，丰颊拥芳筵。","逢诞日，揖真仙。","托炉烟。","朱颜长似，头上花枝，岁岁年年。"],"s":"simp","f":"trad"},{"i":"c-4fd0bf2d1f92","t":"水调歌头","a":"葛胜仲","d":"宋","g":"词","p":["夜泛南溪月，光影冷涵空。","棹飞穿碎金电，翻动水精宫。","横管何妨三弄，重醑仍须一斗，知费几青铜。","坐久桂花落，襟袖觉香浓。","庾公阁，子猷舫，兴应同。","从来好景良夜，我辈敢情锺。","但恐仙娥川后，嫌我尘容俗状，清境不相容。","击汰同情赏，赖有紫溪翁。"],"s":"simp","f":"trad"},{"i":"c-a611ddb01935","t":"水调歌头","a":"葛胜仲","d":"宋","g":"词","p":["下濑惊船驶，挥麈恐尊空。","谁吹尺八寥亮，嚼徵更含宫。","坐爱金波潋滟，影落蒲萄涨绿，夜漏尽移铜。","回棹携红袖，一水带香浓。","坐中客，驰隽辩，语无同。","青鞋黄帽，此乐谁肯换千锺。","岩壑从来无主，风月故应长在，赏不待先容。","羽化寻烟客，家有左仙翁。"],"s":"mixed","f":"trad"},{"i":"c-c4323d3d06f7","t":"水调歌头","a":"葛胜仲","d":"宋","g":"词","p":["胜友欣倾盖，羁宦懒书空。","爱君笔力清壮，名已在蟾宫。","萧散英姿直上，自有练裙葛帔，岂待半通铜。","长短作新语，墨纸似鸦浓。","山吐月，溪泛艇，率君同。","吾侪轰饮文字，乐不在歌锺。","今夜长风万里，且倩泓澄浩荡，一为洗尘容。","世上闲荣辱，都付寒边翁。"],"s":"simp","f":"trad"},{"i":"c-0e825fbda006","t":"木兰花・玉楼春","a":"葛胜仲","d":"宋","g":"词","p":["木阑干外池光阔。","午夜乔林迷岸樾。","掠船凉吹起青苹，萦水歌声欺白雪。","檀郎响趁红牙节。","胡语嘈嘈仍切切。","人生何乐似同襟，莫待骊驹声惨咽。"],"s":"simp","f":"trad"},{"i":"c-0ced385496d8","t":"满庭霜・满庭芳","a":"葛胜仲","d":"宋","g":"词","p":["百不为多，一不为少，阿谁昔仕吾邦。","共推任笔，洪鼎力能扛。","不为桃花禄米，雠书倦、一苇横江。","招寻处，徒行曳杖，曾不拥麾幢。","山川，真大好，鱼矶无恙，密岭难双。","听讼诉多就，樵坞僧窗。","岁月音容远矣，风流在、遐想心降。","云烟路，搜奇吊古，时为酹空缸。"],"s":"simp","f":"trad"},{"i":"c-737ff7cbb141","t":"醉蓬莱","a":"葛胜仲","d":"宋","g":"词","p":["望葱葱佳气，虹渚祥开，斗枢光绕。","析木天津，正灵晖腾照。","鹭缀分班，象胥交贡，奉御觞清晓。","玉殿寒轻，金徒漏永，瑞炉烟袅。","万宇均欢，示慈颁燕，寿祝南山，庆均凫藻。","缥缈红云，望九重天表。","舞兽锵洋，抃鳌欣戴，度管弦声杳。","历草长新，蟠桃永秀，与天难老。"],"s":"simp","f":"trad"},{"i":"c-805e15789ada","t":"西江月","a":"葛胜仲","d":"宋","g":"词","p":["羁宦新来作恶，穷途谁肯相从。","追攀十日水云中。","情谊知君独重。","寂寂回廊小院，冥冥细雨尖风。","凤山香雪定应空。","昨夜疏枝入梦。"],"s":"simp","f":"trad"},{"i":"c-c8993cb52fe3","t":"西江月","a":"葛胜仲","d":"宋","g":"词","p":["山镇红桃阡陌，烟迷绿水人家。","尘容误到只惊嗟。","骨冷玉堂今夜。","莫对佳人锦瑟，休辞洞府流霞。","峰回路转乱云遮。","归去空传图画。"],"s":"simp","f":"trad"},{"i":"c-06896fbea71d","t":"南乡子","a":"葛胜仲","d":"宋","g":"词","p":["柳岸正飞绵。","选胜斋轻漾碧涟。","笑语忘怀机事尽，鸥边。","万顷溪光上下天。","菰苇久延缘。","不觉遥峰霭暮烟。","对酒莫嫌红粉陋，婵娟。","自有孤高月妇仙。"],"s":"simp","f":"trad"},{"i":"c-2219d0dc5139","t":"浣溪沙","a":"葛胜仲","d":"宋","g":"词","p":["可惜随风面旋飘。","直须烧烛看娇娆。","人间花月更无妖。","浓丽独将春色殿，繁华端合众芳朝。","南床应为醉陶陶。"],"s":"simp","f":"trad"},{"i":"c-f77d992dc22d","t":"浣溪沙","a":"葛胜仲","d":"宋","g":"词","p":["通白轻红溢万枝。","浓香百和透丰肌。","丹山威凤势将飞。","玉镜台前呈国艳，沈香亭北映朝曦。","如花惟有上皇妃。"],"s":"mixed","f":"trad"},{"i":"c-22012ff44b52","t":"浣溪沙","a":"葛胜仲","d":"宋","g":"词","p":["斗鸭栏边晓路沾。","华堂醉赏轴珠帘。","插花人好手纤纤。","遮护轻寒施翠幄，标题仙品露牙签。","词人遗恨独江淹。"],"s":"simp","f":"trad"},{"i":"c-25ceede7aa4c","t":"西江月","a":"葛胜仲","d":"宋","g":"词","p":["山外半规残日，云边一缕馀霞。","满城飞雪散苕花。","万顷溪连罨画。","柳恽风流旧国，鹤龄潇洒人家。","肯嗟流落在天涯。","云水从今起价。"],"s":"simp","f":"trad"},{"i":"c-91714aef9f8c","t":"西江月","a":"葛胜仲","d":"宋","g":"词","p":["晚路交游绿酒，平生志趣青霞。","霜风时节近黄花。","泛宅舟将鹢画。","不分两溪明月，夜深只属渔家。","今朝清赏寄情涯。","肯向萦涂索价。"],"s":"simp","f":"trad"},{"i":"c-b6f690f5b290","t":"蝶恋花","a":"葛胜仲","d":"宋","g":"词","p":["风过涟漪纹縠细。","十指香檀，惊破交禽睡。","野蔌溪毛真易致。","风流未减兰亭会。","击汰千艘供洛禊。","映水垂杨，万缕拖浓翠。","小海一声波上戏。","殷勤留客千金意。"],"s":"simp","f":"trad"},{"i":"c-9e894cca6206","t":"临江仙","a":"葛胜仲","d":"宋","g":"词","p":["自古吴兴称冷僻，菰城水浸粼粼。","回星难望使车尘。","如何三日饮，并有五行人。","文似枚皋加敏速，记书易若张巡。","幕中无用郄嘉宾。","他年浮枣会，莫忘两溪春。"],"s":"simp","f":"trad"},{"i":"c-380429dc0c5d","t":"临江仙","a":"葛胜仲","d":"宋","g":"词","p":["千古乌程新酿美，玉觞风过粼粼。","歌声未办起梁尘。","九天持斧客，来作绣衣人。","夙有辞华惊乙览，传闻献颂东巡。","未应握节久宾宾。","一封驰诏旨，却醉上林春。"],"s":"simp","f":"trad"},{"i":"c-05cf0fe8ba37","t":"临江仙","a":"葛胜仲","d":"宋","g":"词","p":["小样洪河分九曲，飞泉环绕粼粼。","青莲往事已成尘。","羽觞浮玉甃，宝剑捧金人。","绿绮且依流水调，蓬蓬釂鼓催巡。","玉堂词客是佳宾。","茂林修竹地，大胜永和春。"],"s":"simp","f":"trad"},{"i":"c-147b4bbc3a2b","t":"定风波","a":"葛胜仲","d":"宋","g":"词","p":["千叠云山万里流。","坐中碧落与鳌头。","真意见嬉吾已领。","烟景。","不辞捧诏久汀洲。","老去一官真是漫。","溪岸。","独馀此兴未能收。","留与吴儿传胜事。","长记。","赤栏桥上揽清秋。"],"s":"simp","f":"trad"},{"i":"c-a2bc6b631b5a","t":"定风波","a":"葛胜仲","d":"宋","g":"词","p":["共喜新凉大火流。","一声水调听歌头。","况有修蛾兼粉领。","佳景。","谢公无不碍沦洲。","平昔短檠真大漫。","气岸。","老来都向酒杯收。","云水光中修禊事。","犹记。","转头不觉已三秋。"],"s":"simp","f":"trad"},{"i":"c-091e209b17f4","t":"浣溪沙","a":"葛胜仲","d":"宋","g":"词","p":["今夜风光恋渚苹。","欲教四角出车轮。","金钗离立座生春。","神女恍惊巫峡梦，飞琼原是阆风人。","诏封后院宠儒臣。"],"s":"simp","f":"trad"},{"i":"c-3055eb01b8b0","t":"浣溪沙","a":"葛胜仲","d":"宋","g":"词","p":["溪岸沈深属泛苹。","倾城容貌此推轮。","可怜虚度二年春。","暮暮来时骚客赋，朝朝新处后庭人。","天留花月伴羁臣。"],"s":"simp","f":"trad"},{"i":"c-e51a3c250fe5","t":"浣溪沙","a":"葛胜仲","d":"宋","g":"词","p":["东道殷勤玉斝飞。","华灯倾国拥珠玑。","玉奴嫌瘦玉环肥。","缥缈幸闻缑岭曲。","参差犹隔夏侯衣。","放开云月出清辉。"],"s":"simp","f":"trad"},{"i":"c-0b3a6fd16d92","t":"瑞鹧鸪","a":"葛胜仲","d":"宋","g":"词","p":["两年人住岂无情。","别乘辞华四水清。","何事千锺勤饮饯，故知一别未能轻。","解龟虽幸樊笼出，挂席还愁海汐平。","江草江花都是泪，骊驹休作断肠声。"],"s":"simp","f":"trad"},{"i":"c-1bed72182163","t":"浪淘沙","a":"葛胜仲","d":"宋","g":"词","p":["步屧对东风。","细探春工。","百花堂下牡丹丛。","莫恨使君来便去，不见鞓红。","雾眼一衰翁。","无意芳秾。","年来结习已成空。","寄语国香雕槛里，好为人容。"],"s":"simp","f":"trad"},{"i":"c-f67023433b06","t":"蓦山溪","a":"葛胜仲","d":"宋","g":"词","p":["望云门外。","油壁如流水。","空巷逐朱幡，步春风、香河七里。","冶容炫服，摸石道宜男，穿翠霭，度飞桥，影在清漪里。","秦头楚尾。","千古风流地。","试问汉江边，有解佩、行云旧事。","主人是客，一笑强颁春，烧灯后，赏花前，遥忆年年醉。"],"s":"simp","f":"trad"},{"i":"c-668e101dd8a5","t":"蓦山溪","a":"葛胜仲","d":"宋","g":"词","p":["春风野外。","卵色天如水。","鱼戏舞绡纹，似出听、新声北里。","追风骏足，千骑卷高冈，一箭过，万人呼，雁落寒空里。","天穿过了，此日名穿地。","横石俯清波。","竞追随、新年乐事。","谁怜老子，使得暂遨游，争捧手，乍凭肩，夹道游人醉。"],"s":"simp","f":"trad"},{"i":"c-a98743e5a24b","t":"减字木兰花","a":"吴则礼","d":"宋","g":"词","p":["团团璧月。","今夜广寒真秀发。","何处吹笙。","催得清霜满凤城。","淮南好梦。","镜里星星还种种。","犹记银床。","曾为凉洲唤玉觞。"],"s":"simp","f":"trad"},{"i":"c-f5341c5a8b2a","t":"减字木兰花","a":"吴则礼","d":"宋","g":"词","p":["淮天不断。","点缀南云秋几雁。","白露沾衣。","始是银屏梦觉时。","别离怀抱。","消得镜中青鬓老。","小字无能。","烦寄平安一纸书。"],"s":"simp","f":"trad"},{"i":"c-518f2615465d","t":"减字木兰花","a":"吴则礼","d":"宋","g":"词","p":["斑斑小雨。","初入高梧黄叶暮。","又是重阳。","昨夜西风作许凉。","鲜鲜丛菊。","只解凋人双鬓绿。","试傍清尊。","分付幽香与断魂。"],"s":"simp","f":"trad"},{"i":"c-b67d870ee959","t":"减字木兰花","a":"吴则礼","d":"宋","g":"词","p":["九年离别。","梦里相逢端怕说。","携手河梁。","雁噭淮天如许长。","鲈鱼正美。","白发季鹰聊启齿。","后夜江干。","与把梅花子细看。"],"s":"simp","f":"trad"},{"i":"c-8804c34ee855","t":"减字木兰花","a":"吴则礼","d":"宋","g":"词","p":["淮山清夜。","镜面平铺纤月挂。","端是生还。","同倚西风十二栏。","休论往事。","投老相逢真梦寐。","两鬓疏疏。","好在松江一尺鲈。"],"s":"simp","f":"trad"},{"i":"c-833a2e8ec65c","t":"满庭芳","a":"吴则礼","d":"宋","g":"词","p":["声促铜壶，灰飞玉琯，梦惊偷换年华。","江南芳信，疏影月横斜。","又喜椒觞到手，宝胜里、仍翦金花。","钗头燕，妆台弄粉，梅额故相夸。","隼旟，人未老，东风袅袅，已傍高牙。","渐园林月永，叠鼓凝笳。","小字新传秀句，歌扇底、深把流霞。","聊行乐，他时画省，归近紫皇家。"],"s":"simp","f":"trad"},{"i":"c-9c9957e41079","t":"满庭芳","a":"吴则礼","d":"宋","g":"词","p":["玉垒尊罍，清秋关塞，正宜催唤香醪。","凉风吹帽，横槊试登高。","相见征西旧事，龙山会、宾主俱豪。","来群雁，凉生画角，红叶聚亭皋。","南洲、应好在，长关梦眼，天际云涛。","有一簪黄菊，两鬓霜毛。","快把金荷共倒，凝望久、只遣魂消。","君须听，新翻燕乐，馀韵响檀槽。"],"s":"simp","f":"trad"},{"i":"c-c7d3b08a43d7","t":"木兰花慢","a":"吴则礼","d":"宋","g":"词","p":["尽晴春自老，乍翠巘、出清流。","望杳杳飞旌，翩翩戍骑，初过边头。","幽花尚猗短岸，渐鸣禽、唤友绕行輈。","端有雕戈锦领，竟驰騕袅骅骝。","凝眸。","雁入长天，羌管罢、陇云愁。","共解鞍临水，雷惊电散，雪溅霜浮。","玉觞正风味好，对幽香、堕蕊且消忧。","莫以纶巾羽扇，便忘绿浦沧洲。"],"s":"mixed","f":"trad"},{"i":"c-55c48a0dc97e","t":"醉落魄・一斛珠","a":"吴则礼","d":"宋","g":"词","p":["梅花褪雪。","赏心莫使慵欢悦。","大家且恁同攀折。","馀蕊残英，偏称淡笼月。","当初相见花初发。","如今花谢人离缺。","一年又比一年别。","惟有花枝，只似旧时节。"],"s":"simp","f":"trad"},{"i":"c-263f5e8033b4","t":"踏莎行","a":"吴则礼","d":"宋","g":"词","p":["一片花飞，青春已减。","可堪南陌红千点。","生憎杨柳要藏鸦，东风只遣横笳怨。","看定新巢，初怜语燕。","游丝正把残英罥。","酒尊也会不相违，风光本自同流转。"],"s":"simp","f":"trad"},{"i":"c-99c11b83f5ab","t":"鹧鸪天","a":"吴则礼","d":"宋","g":"词","p":["永遇英雄际会时。","垂天鹏翼逐云飞。","退朝日上青花道，催直霜零赤雁池。","鸣汉履，侍唐眉。","渭川莘野晚追随。","归来仍对金銮老，三峡词源气未衰。"],"s":"simp","f":"trad"},{"i":"c-df01d9296a52","t":"鹧鸪天","a":"吴则礼","d":"宋","g":"词","p":["作赋丁年厌兔园。","紫微深锁九重关。","花墩屡赐清闲燕，文石难忘咫尺颜。","烟外屐，水边山。","纶巾羽扇五湖间。","自怜季子貂裘敝，来与机云相对闲。"],"s":"simp","f":"trad"},{"i":"c-6cebc6eb1a76","t":"鹧鸪天","a":"吴则礼","d":"宋","g":"词","p":["衮绣三朝社稷臣。","旧调元鼎斡洪钧。","垂绅屡转龙墀日，接膝潜回黼座春。","金凿落，玉麒麟。","凤鸣良月庆佳辰。","巨鳌行听扃华禁，又起商周梦卜人。"],"s":"simp","f":"trad"},{"i":"c-82116fcd7e60","t":"红楼慢","a":"吴则礼","d":"宋","g":"词","p":["声慑燕然，势压横山，镇西名重榆塞。","干霄百雉朱阑下，极目长河如带。","玉垒凉生过雨，帘卷晴岚凝黛。","有城头、钟鼓连云，殷春雷天外。","长啸，畴昔驰边骑。","听陇底鸣笳，风搴双旆。","霜髯飞将曾百战，欲掳名王朝帝。","锦带吴钩未解，谁识凭栏深意。","空沙场，牧马萧萧晚无际。"],"s":"simp","f":"trad"},{"i":"c-cd3f602573a7","t":"声声慢","a":"吴则礼","d":"宋","g":"词","p":["林塘朱夏，雨过斑斑，绿苔绕地初遍。","叶底雏莺，犹记日斜春晚。","芙蕖靓妆红粉，傍高荷、闲倚歌扇。","轻风起，縠纹滟滟，翠生波面。","可是追凉月下，清坐久，微云屡遮星汉。","露湿纶巾，遥望玉清台殿。","白头共论胜事，须偿五湖深愿。","南枝好，有南飞乌鹊，绕枝低转。"],"s":"simp","f":"trad"},{"i":"c-6b3be43bb5cf","t":"水龙吟","a":"吴则礼","d":"宋","g":"词","p":["秋生泽国，无边落木，又作萧萧下。","澄江过雨，凉飙吹面，黄花初把。","苍鬓羁孤，粗营鸡黍，浊醪催贳。","对斜斜露脚，寒香正好，幽人去、空惊咤。","头上纶巾醉堕，要猗眠、水云萦舍。","牵衣儿女，归来欢笑，仍邀同社。","月底蓬门，一株江树，悲虫鸣夜。","把茱萸细看，牛山底事，强成沾洒。"],"s":"simp","f":"trad"},{"i":"c-d720b20f0118","t":"眼儿媚","a":"李德载","d":"宋","g":"词","p":["雪儿魂在水云乡。","犹忆学梅妆。","玻璃枝上，体薰山麝，色带飞霜。","水边竹外愁多少，不断俗人肠。","如何伴我，黄昏携手，步月斜廊。"],"s":"simp","f":"trad"},{"i":"c-52c00cb48570","t":"早梅芳近・早梅芳","a":"李德载","d":"宋","g":"词","p":["深院静，小阑傍。","标致不寻常。","尽他桃杏占风光。","谁敢斗新妆。","玉堂中，梁苑里。","休把雪来轻比。","莫吹长笛巧催残。","留取月中看。"],"s":"simp","f":"trad"},{"i":"c-60c89f78bb9c","t":"早梅芳近・早梅芳","a":"李德载","d":"宋","g":"词","p":["残腊里，早梅芳。","春信报新阳。","晓来枝上斗寒光。","轻点寿阳妆。","雪难欺，霜莫妒。","别是一般风措。","望林人意正夭饶。","又看长新条。"],"s":"simp","f":"trad"},{"i":"c-dd6f608a23ed","t":"鹧鸪天","a":"赵子发","d":"宋","g":"词","p":["约略应飞白玉盘。","明楼渐放满轮寒。","天垂万丈清光外，人在三秋爽气间。","闻叶吹，想风鬟。","浮空仿佛女乘鸾。","此时不合人间有，尽入嵩山静夜看。"],"s":"simp","f":"trad"},{"i":"c-7450d450b356","t":"洞仙歌","a":"赵子发","d":"宋","g":"词","p":["荒山明月，下有云来去。","深夜纤毫静可数。","问古今底事，留此空光，修月户、犹是当年玉斧。","思君持羽扇，来伴微吟，水佩风环饮松露。","待勾漏丹成，约与轻飞，人间世、不知归处。","更长啸、馀声振林溪，见乱红惊飞，半岩花雨。"],"s":"simp","f":"trad"},{"i":"c-27ef62da29f5","t":"桃源忆故人","a":"赵子发","d":"宋","g":"词","p":["芳菲已有东风露。","寒著轻罗未去。","午夜鸾车鹤驭。","散入千莲步。","粉香度曲嬉游女。","草草相逢无据。","肠断泪零无数。","洒作花梢雨。"],"s":"simp","f":"trad"},{"i":"c-4132e94a7fb3","t":"浣溪沙","a":"赵子发","d":"宋","g":"词","p":["疏荫摇摇趁岸移。","惊鸥点点过帆飞。","船分水打嫩沙回。","断梦不知人去处，卷帘还有燕来时。","日斜风紧转湾西。"],"s":"simp","f":"trad"},{"i":"c-587301a77f97","t":"南歌子","a":"赵子发","d":"宋","g":"词","p":["天末疑无路，波翻欲御风。","此身忽在玉壶中。","醉倒不知、南北与西东。","猎猎遥鸣草，飕飕静打篷。","与君回棹碧云浓。","不是思归、只为酒船空。"],"s":"simp","f":"trad"},{"i":"c-57fcf9cfe757","t":"南歌子","a":"赵子发","d":"宋","g":"词","p":["人有纫兰佩，云无出岫心。","扁舟来入碧涛深。","坐见楚咻、儿女变齐音。","但醉双瓶玉，从渠六印金。","此时何处可幽寻。","风定津头、白日照平林。"],"s":"simp","f":"trad"},{"i":"c-be9747d5fe4c","t":"点绛唇","a":"赵子发","d":"宋","g":"词","p":["野岸孤舟，断桥明月穿流水。","雁声嘹呖。","双落行人泪。","去岁吾家，曾插黄花醉。","今那是。","杖藜西指。","看即成千里。"],"s":"simp","f":"trad"},{"i":"c-fd810d79ebc2","t":"虞美人","a":"赵子发","d":"宋","g":"词","p":["飞云流水来无信。","花发年年恨。","小桃如脸柳如眉。","记得那人模样、旧家时。","楼高映步拖金缕。","香湿黄昏雨。","如今不见欲凭书。","门外水平波暖、一双鱼。"],"s":"simp","f":"trad"},{"i":"c-0e1148948a4d","t":"惜分飞","a":"赵子发","d":"宋","g":"词","p":["数点雨声惊残暑。","帘外秋光容与。","重换熏炉炷。","渐低罗幕香成雾。","今夜夜凉情几许。","莫向屏山取取。","却笑阳台女。","楚人空□高唐赋。"],"s":"simp","f":"trad"},{"i":"c-04550e4c809a","t":"阮郎归","a":"赵子发","d":"宋","g":"词","p":["马蹄踏月响空山。","梅生烟壑寒。","水妃去后泪痕乾。","天风吹佩兰。","纫香久，怕花残。","与君聊据鞍。","一枝欲寄北人看。","如今行路难。"],"s":"mixed","f":"trad"},{"i":"c-1891a085ff8f","t":"忆王孙","a":"赵子发","d":"宋","g":"词","p":["日长高柳一蝉声。","翡翠帘深宝簟清。","梦远春云不散情。","晓风轻。","玉楝花飞宿雨晴。"],"s":"simp","f":"trad"},{"i":"c-f4ff9c6e7127","t":"杨柳枝","a":"赵子发","d":"宋","g":"词","p":["淅淅西风生暮寒。","绣衣单。","碧梧叶落藕花残。","恨前欢。","月镂虚棂烟逗竹，梦千山。","玉箫清夜忆孤鸾。","镇长闲。"],"s":"simp","f":"trad"},{"i":"c-5bb4847a4125","t":"望江南・忆江南","a":"赵子发","d":"宋","g":"词","p":["新梦断，久立暗伤春。","柳下月如花下月，今年人忆去年人。","往事梦中身。"],"s":"simp","f":"trad"},{"i":"c-a3ee4a649e36","t":"菩萨蛮","a":"赵子发","d":"宋","g":"词","p":["闲庭草色侵阶绿。","琐窗午梦人如玉。","抛枕出罗帏。","风吹金缕衣。","怨春风雨恶。","二月桃花落。","雨后纵多晴。","花休春不成。"],"s":"simp","f":"trad"},{"i":"c-c41fd468f2ef","t":"少年游","a":"赵子发","d":"宋","g":"词","p":["晓山日薄半春阴。","烟暖柳拖金。","满眼新晴，歌声妆影，悠荡碧云心。","闲庭客散人归去，疏雨湿罗襟。","楼阁濛濛，断虹明处，十里暮云深。"],"s":"mixed","f":"trad"},{"i":"c-b12afd5eb411","t":"采桑子","a":"赵子发","d":"宋","g":"词","p":["春蚕昨夜眠方起，闲了罗机。","共采柔枝。","桑柘阴阴三月时。","背人佯笑移金钏，惆怅花期。","故故留迟。","独自归来雨满衣。"],"s":"simp","f":"trad"},{"i":"c-767a0d9a42f0","t":"浪淘沙","a":"赵子发","d":"宋","g":"词","p":["约素小腰身。","不奈伤春。","疏梅影下晚妆新。","袅袅娉娉何样似，一缕轻云。","歌巧动朱唇。","字字娇嗔。","桃花深处一通津。","怅望瑶台清夜月，还送归轮。"],"s":"simp","f":"trad"},{"i":"c-f8e2d41719a2","t":"念奴娇","a":"徐俯","d":"宋","g":"词","p":["素光练静，照青山隐隐，修眉横绿。","鳷鹊楼高天似水，碧瓦寒生银粟。","万丈辉光，奔云涌雾，飞过卢鸿屋。","更无尘翳，皓然冷浸梧竹。","因念鹤发仙翁，当时曾共赏，紫岩飞瀑。","对影三人聊痛饮，一洗闲愁千斛。","斗转参移，翻然归去，万里骑黄鹄。","一川霜晓，叫云吹断横玉。"],"s":"simp","f":"trad"},{"i":"c-2cea02e70631","t":"浣溪沙","a":"徐俯","d":"宋","g":"词","p":["章水何如颍水清。","江山明秀发诗情。","七言还我是长城。","小小钿花开宝靥，纤纤玉笋见云英。","十千名酒十分倾。"],"s":"simp","f":"trad"},{"i":"c-00c678751198","t":"虞美人","a":"徐俯","d":"宋","g":"词","p":["梅花元自江南得。","还醉江南客。","雪中雨里为谁香。","闻道数枝清笑、出东墙。","多情宋玉还知否。","梁苑无寻处。","胭脂为萼玉为肌。","却恨恼人桃杏、不同时。"],"s":"simp","f":"trad"},{"i":"c-d5b69090de6d","t":"卜算子","a":"徐俯","d":"宋","g":"词","p":["心空道亦空，风静林还静。","卷尽浮云月自明，中有山河影。","供养及修行。","旧话成重省。","豆爆生莲火里时，痛拨寒灰冷。"],"s":"simp","f":"trad"},{"i":"c-8045de601294","t":"卜算子","a":"徐俯","d":"宋","g":"词","p":["天生百种愁，挂在斜阳树。","绿叶阴阴占得春，草满莺啼处。","不见生尘步。","空忆如簧语。","柳外重重叠叠山，遮不断、愁来路。"],"s":"simp","f":"trad"},{"i":"c-284ea8aa152b","t":"卜算子","a":"徐俯","d":"宋","g":"词","p":["清池过雨凉，暗有清香度。","缥缈娉婷绝代歌，翠袖风中举。","忽敛双眉去。","总是关情处。","一段江山一片云，又下阳台雨。"],"s":"simp","f":"trad"},{"i":"c-1c8a2df328af","t":"鹧鸪天","a":"徐俯","d":"宋","g":"词","p":["绿水名园不是村。","淡妆浓笑两生春。","笛中已自多愁怨，雨里因谁有泪痕。","香旖旎，酒氤氲。","多情生怕落纷纷。","旧来好事浑如梦，年少风流付与君。"],"s":"simp","f":"trad"},{"i":"c-f531676d3a2a","t":"鹧鸪天","a":"徐俯","d":"宋","g":"词","p":["满眼纷纷恰似花。","飘飘泊泊自天涯。","雨中添得无穷湿，风里吹成一道斜。","银作屋，玉为车。","姮娥青女过人家。","应嫌素面微微露，故着轻云薄薄遮。"],"s":"simp","f":"trad"},{"i":"c-b9d928f51c23","t":"踏莎行","a":"徐俯","d":"宋","g":"词","p":["素景将阑，黄花初笑。","登高一望秋天杳。","邀宾携妓数能来，醉中赢得闲多少。","佳气氤氲，飞云缥缈。","竹林更着清江绕。","高歌屡舞莫催人，华筵直待华灯照。"],"s":"simp","f":"trad"},{"i":"c-0ba30d381aab","t":"踏莎行","a":"徐俯","d":"宋","g":"词","p":["画栋风生，绣筵花绕。","层台胜日频高眺。","清辉爽气自娱人，何妨称意开颜笑。","水碧无穷，山青未了。","斜阳浦口归帆少。","云鬟烟鬓只供愁，琵琶更作相思调。"],"s":"simp","f":"trad"},{"i":"c-5073dffb39ca","t":"踏莎行","a":"徐俯","d":"宋","g":"词","p":["玉露团花，金风破雾。","高台与上晴空去。","举杯相属看前山，烟中乱叠青无数。","皓齿明眸，肌香体素。","恼人正在秋波注。","因何欲雨又还晴，歌声遏得行云住。"],"s":"simp","f":"trad"},{"i":"c-882a1ec0f8a8","t":"南歌子","a":"徐俯","d":"宋","g":"词","p":["细蕊黄金嫩，繁花白雪香。","共谁连璧向河阳。","自是不须汤饼、试何郎。","婀娜拢松髻，轻盈淡薄妆。","莫令韩寿在伊傍。","便逐游蜂惊蝶、过东墙。"],"s":"simp","f":"trad"},{"i":"c-8f4e4f5936c3","t":"鹧鸪天","a":"徐俯","d":"宋","g":"词","p":["宜笑宜颦掌上身。","能歌能舞恶精神。","脸边红入桃花嫩，眉上青归柳叶新。","娇不语，易生嗔。","尊前还是一番春。","深杯百罚重拚却，只为妖饶醉得人。"],"s":"mixed","f":"trad"},{"i":"c-2f3f75797445","t":"浣溪沙","a":"徐俯","d":"宋","g":"词","p":["西塞山前白鹭飞。","桃花流水鳜鱼肥。","一波才动万波随。","黄帽岂如青箬笠，羊裘何似绿蓑衣。","斜风细雨不须归。"],"s":"simp","f":"trad"},{"i":"c-74b01ffbc60d","t":"浣溪沙","a":"徐俯","d":"宋","g":"词","p":["新妇矶边秋月明。","女儿浦口晚潮平。","沙头鹭宿戏鱼惊。","青箬笠前明此事，绿蓑衣底度平生。","斜风细雨小舟轻。"],"s":"simp","f":"trad"},{"i":"c-7c25a558cc0d","t":"鹧鸪天","a":"徐俯","d":"宋","g":"词","p":["西塞山前白鹭飞。","桃花柳水鳜鱼肥。","朝廷若觅元真子，晴在长江理钓丝。","青箬笠，绿蓑衣。","斜风细雨不须归。","浮云万里烟波客，惟有沧浪孺子知。"],"s":"simp","f":"trad"},{"i":"c-d11d01df832e","t":"鹧鸪天","a":"徐俯","d":"宋","g":"词","p":["七泽三湘碧草连。","洞庭江汉水如天。","朝廷若觅元真子，不在云边则酒边。","明月棹，夕阳船。","鲈鱼恰似镜中悬。","丝纶钓饵都收却，八字山前听雨眠。"],"s":"simp","f":"trad"},{"i":"c-3b78c06d18f8","t":"虞美人","a":"王安中","d":"宋","g":"词","p":["千山青比妆眉浅。","却奈眉峰远。","玉人元自不禁秋。","更算恼伊深处、月当楼。","分携不见凭阑际。","只料无红泪。","万千应在锦回纹。","嘱付断鸿西去、问行云。"],"s":"simp","f":"trad"}]