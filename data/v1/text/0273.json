[{"i":"0bf0531a-3cb5-4466-a9cc-f6c4f17ff105","t":"塞上曲","a":"張祜","d":"唐","g":"短诗","p":["邊風捲地時，日暮帳初移。","磧逈三通角，山寒一點旗。","連收榻索馬，引滿射雕兒。","莫道功勳細，將軍昔戍師。"],"s":"mixed","f":"simp"},{"i":"32bc27d8-4816-4861-8d31-7f16bfee4a7b","t":"折楊柳","a":"張祜","d":"唐","g":"短诗","p":["紅粉青樓曙，垂楊仲月春。","懷君重攀折，非妾妬腰身。","舞帶縈絲斷，嬌娥向葉嚬。","橫吹凡幾曲，獨自最愁人。"],"s":"trad","f":"simp"},{"i":"457215d8-5b31-4dd1-a740-44782cc8d86e","t":"採桑","a":"張祜","d":"唐","g":"短诗","p":["自古多征戰，由來尚甲兵。","長驅千里去，一舉兩番平。","按劒從沙漠，歌謠滿帝京。","寄言天下將，須立武功名。"],"s":"mixed","f":"simp"},{"i":"611b2dc6-4b63-43d0-abd9-756e35877aa1","t":"禪智寺","a":"張祜","d":"唐","g":"短诗","p":["寶殿依山嶮，臨虛勢若吞。","畫簷齊木末，香砌壓雲根。","遠景窗中岫，孤煙竹裏村。","憑高聊一望，鄉思隔吳門。"],"s":"mixed","f":"simp"},{"i":"65a085c2-ae00-48e8-bd5b-e90e75ac846b","t":"寄題商洛王隱居","a":"張祜","d":"唐","g":"短诗","p":["近逢商洛口，知爾坐南塘。","草閣平春水，柴門掩夕陽。","隨蜂收野蜜，尋麝採生香。","更憶前年醉，松花滿石牀。"],"s":"mixed","f":"simp"},{"i":"c262e600-c86e-4305-a903-07c6c0095a5d","t":"送客歸湘楚","a":"張祜","d":"唐","g":"短诗","p":["無辭一杯酒，昔日與君深。","秋色換歸鬢，曙光生別心。","桂花山廟冷，楓樹水樓陰。","此路千餘里，應勞楚客吟。"],"s":"mixed","f":"simp"},{"i":"fe9a5351-1a97-4423-b912-224a05f6f7ac","t":"登金山寺","a":"張祜","d":"唐","g":"短诗","p":["古今斯島絕，南北大江分。","水闊吞滄海，亭高宿斷雲。","返潮千澗落，啼鳥半空聞。","皆是登臨處，歸航酒半醺。"],"s":"trad","f":"simp"},{"i":"432793dc-50bb-4dfc-8cad-af3bc0cc759f","t":"洛陽感寓","a":"張祜","d":"唐","g":"短诗","p":["擾擾都城曉四開，不關名利也塵埃。","千門甲第身遙入，萬里銘旌死後來。","洛水暮煙橫莽蒼，邙山秋日露崔嵬。","須知此事堪爲鏡，莫遣黃金漫作堆。"],"s":"mixed","f":"simp"},{"i":"81852780-9711-4914-9ec8-02518757ca1f","t":"從軍行","a":"張祜","d":"唐","g":"短诗","p":["少年金紫就光輝，直指邊城虎翼飛。","一卷旌收千騎虜，萬全身出百重圍。","黃雲斷塞尋鷹去，白草連天射鴈歸。","白首漢廷刀筆吏，丈夫功業本相依。"],"s":"trad","f":"simp"},{"i":"53de701e-8484-436d-96c1-baa1a45a3c05","t":"愛妾換馬 一","a":"張祜","d":"唐","g":"短诗","p":["一面妖桃千里蹄，嬌姿駿骨價應齊。","乍牽玉勒辭金棧，催整花鈿出繡閨。","去日豈無沾袂泣，歸時還有頓銜嘶。","嬋娟躞蹀春風裏，揮手搖鞭楊柳隄。"],"s":"mixed","f":"simp"},{"i":"2fb21aab-5fbe-48c0-a2cd-115f3f176a36","t":"愛妾換馬 二","a":"張祜","d":"唐","g":"短诗","p":["綺閣香銷華廐空，忍將行雨換追風。","休憐柳葉雙眉翠，卻愛桃花兩耳紅。","侍宴永辭春色裏，趁朝休立漏聲中。","恩勞未盡情先盡，暗泣嘶風兩意同。"],"s":"mixed","f":"simp"},{"i":"b680d1fe-bf1e-4466-974a-de893bbf9b2a","t":"病宮人","a":"張祜","d":"唐","g":"短诗","p":["佳人臥病動經秋，簾幕繿縿不挂鉤。","四體強扶藤夾膝，雙鬟慵插玉搔頭。","花顏有幸君王問，藥餌無徵待詔愁。","惆悵近來消瘦盡，淚珠時傍枕函流。"],"s":"mixed","f":"simp"},{"i":"f11908ea-5957-4516-9d5b-469e17951926","t":"觀杭州柘枝","a":"張祜","d":"唐","g":"短诗","p":["舞停歌罷鼓連摧，軟骨仙蛾暫起來。","紅罨畫衫纏腕出，碧排方胯背腰來。","旁收拍拍金鈴擺，却踏聲聲錦袎摧。","看著遍頭香袖褶，粉屏香帕又重隈。"],"s":"mixed","f":"simp"},{"i":"3aa73b90-73e9-4c75-a9aa-1674237b18af","t":"周員外席上觀柘枝","a":"張祜","d":"唐","g":"短诗","p":["畫鼓拖環錦臂攘，小娥雙換舞衣裳。","金絲蹙霧紅衫薄，銀蔓垂花紫帶長。","鸞影乍迴頭並舉，鳳聲初歇翅齊張。","一時欻腕招殘拍，斜斂輕身拜玉郎。"],"s":"trad","f":"simp"},{"i":"e1b77311-782a-4896-ae57-eba253485995","t":"觀楊瑗柘枝","a":"張祜","d":"唐","g":"短诗","p":["促疊蠻鼉引柘枝，卷簷虛帽帶交垂。","紫羅衫宛蹲身處，紅錦靴柔踏節時。","微動翠蛾拋舊態，緩遮檀口唱新詞。","看看舞罷輕雲起，却赴襄王夢裏期。"],"s":"mixed","f":"simp"},{"i":"a11bdd12-03f3-452b-bede-bf2285567cf7","t":"感王將軍柘枝妓歿","a":"張祜","d":"唐","g":"短诗","p":["寂寞春風舊柘枝，舞人休唱曲休吹。","鴛鴦鈿帶拋何處，孔雀羅衫付阿誰。","畫鼓不聞招節拍，錦靴空想挫腰肢。","今來座上偏惆悵，曾是堂前教徹時。"],"s":"trad","f":"simp"},{"i":"961ac853-eb63-4444-8981-1b7cadbf7b0a","t":"揚州法雲寺雙檜","a":"張祜","d":"唐","g":"短诗","p":["謝家雙植本圖榮，樹老人因地變更。","朱頂鶴知深蓋偃，白眉僧見小枝生。","高臨月殿秋雲影，靜入風簷夜雨聲。","縱使百年爲上壽，綠陰終借暫時行。"],"s":"mixed","f":"simp"},{"i":"2779692f-7f70-4a58-b21d-3bdc8901aed4","t":"憶游天台寄道流","a":"張祜","d":"唐","g":"短诗","p":["憶昨天台到赤城，幾朝仙籟耳中生。","雲龍出水風聲過，海鶴鳴臯日色清。","石筍半山移步險，桂花當洞拂衣輕。"],"s":"mixed","f":"simp"},{"i":"3372ccf7-d860-40e8-997f-cf7c6b84e045","t":"寄王尊師","a":"張祜","d":"唐","g":"短诗","p":["天台南洞一靈仙，骨聳冰稜貌瑩然。","曾對浦雲長昧齒，重來華表不知年。","溪橋晚下玄龜出，草露朝行白鹿眠。","猶憶夜深華蓋上，更無人處話丹田。"],"s":"trad","f":"simp"},{"i":"10bddc06-23bd-46ad-8693-0baacfde429a","t":"公子行","a":"張祜","d":"唐","g":"短诗","p":["錦堂晝永繡簾垂，立却花驄待出時。","紅粉美人擎酒勸，青衣年少臂鷹隨。","輕將玉杖敲花片，旋把金鞭約柳枝。","近地獨遊三五騎，等閑行傍曲江池。"],"s":"mixed","f":"simp"},{"i":"58555a27-99b1-4882-871a-ad83bf29e326","t":"寓懷寄蘇州劉郎中","a":"張祜","d":"唐","g":"短诗","p":["一聞周召佐明時，西望都門強策羸。","天子好文才自薄，諸侯力薦命猶奇。","賀知章口徒勞說，孟浩然身更不疑。","唯是勝遊行未遍，欲離京國尚遲遲。"],"s":"trad","f":"simp"},{"i":"50ccdb84-ebf0-4305-82ed-1fb40aa437f7","t":"和杜牧之齊山登高","a":"張祜","d":"唐","g":"短诗","p":["秋溪南岸菊霏霏，急管煩弦對落暉。","紅葉樹深山徑斷，碧雲江靜浦帆稀。","不堪孫盛嘲時笑，願送王弘醉夜歸。","流落正憐芳意在，砧聲徒促授寒衣。"],"s":"trad","f":"simp"},{"i":"00fd873f-2d0c-4a25-9293-993e9b6c5c83","t":"題于越亭","a":"張祜","d":"唐","g":"短诗","p":["扁舟亭下駐煙波，十五年遊重此過。","洲觜露沙人渡淺，樹稍藏竹鳥啼多。","山銜落照欹紅蓋，水蹙斜文捲綠羅。","腸斷中秋正圓月，夜來誰唱異鄉歌。"],"s":"trad","f":"simp"},{"i":"157a64a0-b1f1-438e-9084-f57426ddd787","t":"秋夜登潤州慈和寺上方","a":"張祜","d":"唐","g":"短诗","p":["清夜浮埃暫歇鄽，塔輪金照露華鮮。","人行中路月生海，鶴語上方星滿天。","樓影半連深岸水，鐘聲寒徹遠林煙。","僧房閉盡下樓去，一半夢魂離世緣。"],"s":"trad","f":"simp"},{"i":"c0de8d08-bafb-4837-a151-54eada922d85","t":"寄獻蕭相公","a":"張祜","d":"唐","g":"短诗","p":["東去江干是勝遊，鼎湖興望不堪愁。","謝安近日違朝旨，傅說當時允帝求。","暫向聊城飛一箭，長爲滄海繫扁舟。","分明此事無人見，白首相看未肯休。"],"s":"mixed","f":"simp"},{"i":"0ba7afd7-757e-4c18-8219-c58cc11fb9f6","t":"哭京兆龐尹","a":"張祜","d":"唐","g":"短诗","p":["楊子江頭昔共迷，一爲京兆隔雲泥。","故人昨日同時弔，舊馬今朝別處嘶。","向壁愁眉無復畫，扶牀稚齒已能啼。","也知世路名堪貴，誰信莊周論物齊。"],"s":"mixed","f":"simp"},{"i":"3e66d9b7-7d38-48ef-8ab5-2f4f2c4de829","t":"送周尚書赴滑臺","a":"張祜","d":"唐","g":"短诗","p":["楚謠襦袴整三年，喉舌新恩下九天。","鼓角雄都分節鉞，蛇龍舊國罷樓船。","崑河已在兵鈐內，堂柳空留鶴嶺前。","多病無由酬一顧，鄢陵千騎去翩翩。"],"s":"trad","f":"simp"},{"i":"22d6a17d-b08b-4ed5-89a7-147753166d24","t":"和杜使君九華樓見寄","a":"張祜","d":"唐","g":"短诗","p":["孤城高柳曉鳴鴉，風簾半鉤清露華。","九峰聚翠宿危檻，一夜孤光懸冷沙。","出岸遠暉帆欲落，入谿寒影鴈差斜。","杜陵歸去春應早，莫厭青山謝朓家。"],"s":"trad","f":"simp"},{"i":"75df160d-ca74-43bc-91e8-cf4ca83929d1","t":"送人歸蜀","a":"張祜","d":"唐","g":"短诗","p":["錦城春色泝江源，三峽經過幾夜猨。","紅樹兩厓開霽色，碧巖千仞漲波痕。","蕭蕭暮雨荆王夢，漠漠春煙蜀帝魂。","長怨相如留滯處，富家還憶卓王孫。"],"s":"mixed","f":"simp"},{"i":"0bda5e94-938b-4bdf-95ec-3d820a8c9e24","t":"酬答柳宗言秀才見贈","a":"張祜","d":"唐","g":"短诗","p":["南下天台厭絕冥，五湖波上汎如萍。","江鷗自戲爲蹤跡，野鹿閑驚是性靈。","任子偶垂滄海釣，戴逵虛認少微星。","金門後俊徒相唁，且爲人間寄茯苓。"],"s":"mixed","f":"simp"},{"i":"74184ddc-8468-479e-aa57-fbf1b33c4cf1","t":"題杭州天竺寺","a":"張祜","d":"唐","g":"古体","p":["西南山最勝，一界是諸天。","上路穿巖竹，分流入寺泉。","躡雲丹井畔，望月石橋邊。","洞壑江聲遠，樓臺海氣連。","塔明春嶺雪，鐘散暮松煙。","何處去猶恨，更看峰頂蓮。"],"s":"trad","f":"simp"},{"i":"9f664fc6-608d-42f2-b58c-ef3c705ebf84","t":"題杭州靈隱寺","a":"張祜","d":"唐","g":"古体","p":["峰巒開一掌，朱檻幾環延。","佛地花分界，僧房竹引泉。","五更樓下月，十里郭中煙。","後塔聳亭後，前山橫閣前。","溪沙涵水靜，澗石點苔鮮。","好是呼猨久，西巖深響連。"],"s":"trad","f":"simp"},{"i":"a52e078a-29ee-4bf2-ab6b-c52ee818fd23","t":"中秋夜杭州翫月","a":"張祜","d":"唐","g":"古体","p":["萬古太陰精，中秋海上生。","鬼愁緣辟照，人愛爲高明。","歷歷華星遠，霏霏薄暈縈。","影流江不盡，輪曳谷無聲。","似鏡當樓曉，如珠出浦盈。","岸沙全借白，山木半含清。","小檻循環看，長堤蹋陣行。","殷勤未歸客，煙水夜來情。"],"s":"mixed","f":"simp"},{"i":"4580450e-054a-41ee-ac7c-d573941e213f","t":"高閑上人","a":"張祜","d":"唐","g":"古体","p":["座上辭安國，禪房戀沃州。","道心黃葉老，詩思碧雲秋。","卷軸朝廷餞，書函內庫收。","陶欣入社叟，生怯論經儔。","日色屏初揭，風聲筆未休。","長波溢海岸，大點出嵩丘。","不絕羲之法，難窮智永流。","殷勤一牋在，留著看銀鉤。"],"s":"trad","f":"simp"},{"i":"679f1a3f-383d-4647-b6d2-8988e4267c73","t":"題靈隱寺師一上人十韻","a":"張祜","d":"唐","g":"古体","p":["八十空門子，深山土木骸。","片衣閑自衲，單食老長齋。","道性終能遣，人情少不乖。","樔枸居上院，薜荔俯層階。","洗鉢前臨水，窺門外有柴。","朗吟揮竹拂，高楫曳芒鞋。","迸笋斜穿塢，飛泉下噴崖。","種花忻土潤，撥石慮沙埋。","舊往師招隱，初臨我詠懷。","何當緣興翫，更爲表新牌。"],"s":"mixed","f":"simp"},{"i":"a2fc68e1-b766-4d04-b8f0-26d923b4e5b0","t":"投常州從兄中丞","a":"張祜","d":"唐","g":"古体","p":["扁舟何所往，言入善人邦。","舊愛鵬摶海，今聞虎渡江。","士因爲政樂，儒爲說詩降。","素履冰容靜，新詞玉潤樅。","金魚聊解帶，畫鷁稍移樁。","邀妓思逃席，留賓命倒缸。","史材誰是伍，經術世無雙。","廣廈當宏構，洪鐘併待撞。","成龍須講邴，展驥莫先龐。","應念宗中末，秋螢照一牕。"],"s":"mixed","f":"simp"},{"i":"738ea38e-7926-44cc-9ace-b644f3b4deac","t":"送王昌涉侍御","a":"張祜","d":"唐","g":"古体","p":["十里指東平，軍前首出征。","諸侯青服舊，御史紫衣榮。","入陳梟心死，分圍虎力生。","畫時安楚塞，刻日下齊城。","號令朝移幕，偷蹤夜斫營。","雲梯曾險上，地道慣深行。","舉斾招降將，投戈趁敗兵。","自慙居虜者，當此立功名。"],"s":"trad","f":"simp"},{"i":"5040a6b9-8575-4978-ae5f-eddedd82026f","t":"少年樂","a":"張祜","d":"唐","g":"古体","p":["二十便封侯，名居第一流。","綠鬟深小院，清管下高樓。","醉把金船擲，閑敲玉鐙遊。","帶盤紅鼴鼠，袍砑紫犀牛。","錦袋歸調箭，羅鞋起撥毬。","眼前長貴盛，那信世間愁。"],"s":"trad","f":"simp"},{"i":"3880dd89-5719-4fa5-82e2-86bf6329a9d3","t":"華清宮和杜舍人","a":"張祜","d":"唐","g":"古体","p":["五十年天子，離宮舊粉牆。","登封時正泰，御宇日初長。","上位先名實，中興事憲章。","舉戎輕甲胄，餘地取河湟。","道帝玄元祖，儒封孔子王。","因緣百司署，藂會一人湯。","渭水波搖綠，秦山草半黃。","馬頭開夜照，鷹眼利星芒。","下箭朱弓滿，鳴鞭皓腕攘。","畋思獲呂望，諫祇避周昌。","兔迹貪前逐，梟心不早防。","幾添鸚鵡勸，頻賜荔支嘗。","月鎖千門靜，天高一笛涼。","細音搖翠佩，輕步宛霓裳。","禍亂根潛結，昇平意遽忘。","衣冠逃犬虜，鼙鼓動漁陽。","外戚心殊迫，中途事可量。","雪埋妃子貌，刃斷祿兒腸。","近侍煙塵隔，前蹤輦路荒。","益知迷寵佞，惟恨喪忠良。","北闕尊明主，南宮遜上皇。","禁清餘鳳吹，池冷映龍光。","祝壽山猶在，流年水共傷。","杜鵑魂厭蜀，蝴蝶夢悲莊。","雀卵遺雕栱，蟲絲罥畫梁。","紫苔侵壁潤，紅樹閉門芳。","守吏齊鴛瓦，耕民得翠璫。","歡康昔時樂，講武舊兵場。","莫草深巖靄，幽花墜徑香。","不堪垂白叟，行折御溝楊。"],"s":"mixed","f":"simp"},{"i":"f14db484-e8c2-4bfc-8a42-95ac02f41574","t":"穆護砂","a":"張祜","d":"唐","g":"短诗","p":["玉管朝朝弄，清歌日日新。","折花當驛路，寄與隴頭人。"],"s":"trad","f":"simp"},{"i":"cafbc059-b035-4aed-9592-01c51be8eb59","t":"思歸樂二首 一","a":"張祜","d":"唐","g":"短诗","p":["晚日催弦管，春風入綺羅。","杏花如有意，偏落舞衫多。"],"s":"trad","f":"simp"},{"i":"5b81dffc-686b-453e-895a-cbec3df004d5","t":"思歸樂二首 二","a":"張祜","d":"唐","g":"短诗","p":["萬里春應盡，三江鴈亦稀。","連天漢水廣，孤客未言歸。"],"s":"mixed","f":"simp"},{"i":"14b2dedc-2a6f-4550-8d59-d2a7cf0da41b","t":"金殿樂","a":"張祜","d":"唐","g":"短诗","p":["入夜秋砧動，千聲起四鄰。","不緣樓上月，應爲隴頭人。"],"s":"mixed","f":"simp"},{"i":"bed546b2-19e6-4940-be52-b2483557522d","t":"牆頭花二首 一","a":"張祜","d":"唐","g":"短诗","p":["蟋蟋鳴洞房，梧桐落金井。","爲君裁舞衣，天寒剪刀冷。"],"s":"mixed","f":"simp"},{"i":"254ad381-0c3f-4dcf-8c6a-cdf389ceeccf","t":"牆頭花二首 二","a":"張祜","d":"唐","g":"短诗","p":["妾有羅衣裳，秦王在時作。","爲舞春風多，秋來不堪著。"],"s":"mixed","f":"simp"},{"i":"18ccdbf3-09ed-4893-9cdd-786e3d946378","t":"胡渭州","a":"張祜","d":"唐","g":"短诗","p":["楊柳千尋色，桃花一苑芳。","風吹入簾裏，唯有惹衣香。"],"s":"mixed","f":"simp"},{"i":"cf86c97f-7502-4ead-9ece-02ff58f90ff5","t":"白鼻騧","a":"張祜","d":"唐","g":"短诗","p":["爲底胡姬酒，長來白鼻騧。","摘蓮拋水上，郎意在浮花。"],"s":"mixed","f":"simp"},{"i":"25d0c5c9-6f0f-4f35-be76-3938c71e5f26","t":"戎渾","a":"張祜","d":"唐","g":"短诗","p":["風勁角弓鳴，將軍獵渭城。","草枯鷹眼疾，雪盡馬蹄輕。"],"s":"trad","f":"simp"},{"i":"cdec343a-78b2-49a6-ad70-4d7e307cd7e0","t":"楊下採桑","a":"張祜","d":"唐","g":"短诗","p":["飛絲惹綠塵，軟葉對孤輪。","今朝入園去，物色強著人。"],"s":"trad","f":"simp"},{"i":"cfed3ed9-5a99-4a60-8196-2d07cf5eedb4","t":"宮詞二首 二","a":"張祜","d":"唐","g":"短诗","p":["自倚能歌日，先皇掌上憐。","新聲何處唱，腸斷李延年。"],"s":"trad","f":"simp"},{"i":"fb90dac8-fded-40fd-a0fe-2e53f35e657c","t":"昭君怨二首 一","a":"張祜","d":"唐","g":"短诗","p":["萬里邊城遠，千山行路難。","舉頭唯見日，何處是長安。"],"s":"mixed","f":"simp"},{"i":"b5ef8e80-5b17-448b-8980-8897ab63bfeb","t":"昭君怨二首 二","a":"張祜","d":"唐","g":"短诗","p":["漢庭無大議，戎虜幾先和。","莫羨傾城色，昭君恨最多。"],"s":"trad","f":"simp"},{"i":"2589dabc-0548-4129-a2fb-3a630ecd2c41","t":"夕次竟陵","a":"張祜","d":"唐","g":"短诗","p":["南風吹五兩，日暮竟陵城。","腸斷巴江月，夜蟬何處聲。"],"s":"trad","f":"simp"},{"i":"21178453-89ce-4dde-a734-b46f01f8d635","t":"信州水亭","a":"張祜","d":"唐","g":"短诗","p":["南簷架短廊，沙路白茫茫。","盡日不歸處，一庭梔子香。"],"s":"trad","f":"simp"},{"i":"6f1d38c0-9ea8-44e5-9631-28d30f7f5921","t":"蘇小小歌三首 一","a":"張祜","d":"唐","g":"短诗","p":["車輪不可遮，馬足不可絆。","長怨十字街，使郎心四散。"],"s":"trad","f":"simp"},{"i":"1f85d7a3-0e69-4c42-aeab-a45ac1d7e745","t":"蘇小小歌三首 二","a":"張祜","d":"唐","g":"短诗","p":["新人千里去，故人千里來。","剪刀橫眼底，方覺淚難裁。"],"s":"trad","f":"simp"},{"i":"143208bf-8507-4b6e-b072-601f52da008f","t":"蘇小小歌三首 三","a":"張祜","d":"唐","g":"短诗","p":["登山不愁峻，涉海不愁深。","中擘庭前棗，教郎見赤心。"],"s":"trad","f":"simp"},{"i":"c5cab02f-8419-4ab3-be95-9cfb618ad68e","t":"樹中草","a":"張祜","d":"唐","g":"短诗","p":["青青樹中草，託根非不危。","草生樹却死，榮枯君可知。"],"s":"mixed","f":"simp"},{"i":"99724de4-3c17-4e6f-bca9-7578e566cbce","t":"七里瀨漁家","a":"張祜","d":"唐","g":"短诗","p":["七里垂釣叟，還傍釣臺居。","莫恨無姓名，嚴陵不賣魚。"],"s":"trad","f":"simp"},{"i":"956838fa-7485-4042-acc3-6bfec3e17c6b","t":"讀曲歌五首 一","a":"張祜","d":"唐","g":"短诗","p":["窗中獨自起，簾外獨自行。","愁見蜘蛛織，尋思直到明。"],"s":"trad","f":"simp"},{"i":"8c36f2d8-80fe-480c-8d0d-0ea1637f4c6b","t":"讀曲歌五首 二","a":"張祜","d":"唐","g":"短诗","p":["碓上米不舂，窗中絲罷絡。","看渠駕去車，定是無四角。"],"s":"trad","f":"simp"},{"i":"cc5c492e-33e8-485b-938a-5258a13ddd19","t":"讀曲歌五首 三","a":"張祜","d":"唐","g":"短诗","p":["不見心相許，徒云脚漫勤。","摘荷空摘葉，是底採蓮人。"],"s":"mixed","f":"simp"},{"i":"693de188-bf8e-4eb1-9979-1c2e14013239","t":"讀曲歌五首 四","a":"張祜","d":"唐","g":"短诗","p":["窗外山魈立，知渠脚不多。","三更機底下，摸著是誰梭。"],"s":"mixed","f":"simp"},{"i":"828a27b1-96b1-4699-b256-9452cd3e37f3","t":"讀曲歌五首 五","a":"張祜","d":"唐","g":"短诗","p":["郎去摘黃瓜，郎來收赤棗。","郎耕種麻地，今作西舍道。"],"s":"trad","f":"simp"},{"i":"e849eca7-308f-4be0-b5a8-6e406f7e3124","t":"玉樹後庭花","a":"張祜","d":"唐","g":"短诗","p":["輕車何草草，獨唱後庭花。","玉座誰爲主，徒悲張麗華。"],"s":"mixed","f":"simp"},{"i":"bd265781-69d8-4e8a-acf3-16af19549269","t":"莫愁樂","a":"張祜","d":"唐","g":"短诗","p":["儂居石城下，郎到石城遊。","自郎石城出，長在石城頭。"],"s":"trad","f":"simp"},{"i":"5e17579c-fb53-4876-b996-a7d597f7a64d","t":"襄陽樂","a":"張祜","d":"唐","g":"短诗","p":["大堤花月夜，長江春水流。","東風正上信，春夜特來遊。"],"s":"trad","f":"simp"},{"i":"03b6a39e-d8b4-4f62-bc00-852dbb20f44f","t":"自君之出矣","a":"張祜","d":"唐","g":"短诗","p":["自君之出矣，萬物看成古。","千尋葶藶枝，爭奈長長苦。"],"s":"trad","f":"simp"},{"i":"4f36c078-ceba-492d-981d-27ecf8205220","t":"夢江南","a":"張祜","d":"唐","g":"短诗","p":["行吟洞庭句，不見洞庭人。","盡日碧江夢，江南紅樹春。"],"s":"trad","f":"simp"},{"i":"2e77c4ba-ca19-4723-9aa2-a655953ccaed","t":"將離岳州留獻徐員外","a":"張祜","d":"唐","g":"短诗","p":["高齋長對酒，下客亦霑魚。","不爲江南去，還來郡北居。"],"s":"mixed","f":"simp"},{"i":"27c49262-73aa-4c9d-bc0a-33f2f303aa31","t":"題彭澤盧明府新樓","a":"張祜","d":"唐","g":"短诗","p":["碧落新樓迥，清池古樹閑。","先賢盡爲宰，空看縣南山。"],"s":"mixed","f":"simp"},{"i":"2033d33d-e69f-4012-8a8d-956217d6b190","t":"贈禪師","a":"張祜","d":"唐","g":"短诗","p":["坐見三生事，宗傳一衲來。","已知無法說，心向定中灰。"],"s":"trad","f":"simp"},{"i":"fc34398f-5765-49ad-be73-9f056ae5f642","t":"江南逢故人","a":"張祜","d":"唐","g":"短诗","p":["河洛多塵事，江山半舊遊。","春風故人夜，又醉白蘋洲。"],"s":"trad","f":"simp"},{"i":"bb2966a6-9139-40b7-95d3-2230a36ea9d8","t":"松江懷古","a":"張祜","d":"唐","g":"短诗","p":["碧樹吳洲遠，青山震澤深。","無人蹤范蠡，煙水暮沈沈。"],"s":"trad","f":"simp"},{"i":"7930ba58-b22b-4ee2-915a-0af65987caf2","t":"書憤","a":"張祜","d":"唐","g":"短诗","p":["三十未封侯，顛狂遍九州。","平生鏌鎁劍，不報小人讎。"],"s":"trad","f":"simp"},{"i":"1e2c719f-a70a-4460-9c5c-18515e331941","t":"題孟處士宅","a":"張祜","d":"唐","g":"短诗","p":["高才何必貴，下位不妨賢。","孟簡雖持節，襄陽屬浩然。"],"s":"trad","f":"simp"},{"i":"c20ceca0-313e-4e57-9662-5783a1302cd1","t":"首陽行","a":"張祜","d":"唐","g":"短诗","p":["首陽山下路，孤竹節長存。","爲問無心草，如何庇本根。"],"s":"mixed","f":"simp"},{"i":"a6e59fd0-2744-4a71-ae57-f6d0ceb7f0eb","t":"題僧影堂","a":"張祜","d":"唐","g":"短诗","p":["寒葉墜清霜，空簾著燼香。","生前既無事，何事更悲傷。"],"s":"trad","f":"simp"},{"i":"e5310de9-9593-48f2-98f0-1d692191d721","t":"邊思","a":"張祜","d":"唐","g":"短诗","p":["蘇武節旌盡，李陵音信稀。","花當隴上發，人向隴頭歸。"],"s":"trad","f":"simp"},{"i":"72d0e603-51b8-4407-bb3b-247da5e3dec6","t":"題弋陽館","a":"張祜","d":"唐","g":"短诗","p":["一葉飄然下弋陽，殘霞昏日樹蒼蒼。","吳溪漫淬干將劍，却是猨聲斷客腸。"],"s":"mixed","f":"simp"},{"i":"dc614f21-94d1-4d02-bb5b-57b06d925530","t":"題秀師影堂","a":"張祜","d":"唐","g":"短诗","p":["陰陰古寺杉松下，記得長明一焰燈。","盡日看山人不會，影堂中是別來僧。"],"s":"trad","f":"simp"},{"i":"90057e78-1459-405c-ad30-a6ce1fc7a62a","t":"贈李修源","a":"張祜","d":"唐","g":"短诗","p":["岳陽新尉曉衙參，却是傍人意未甘。","昨夜與君思賈誼，長沙猶在洞庭南。"],"s":"mixed","f":"simp"},{"i":"4b2c97b3-aee0-4fe7-92ae-757e927375fe","t":"瓜洲聞曉角","a":"張祜","d":"唐","g":"短诗","p":["寒耿稀星照碧霄，月樓吹角夜江遙。","五更人起煙霜靜，一曲殘聲遍落潮。"],"s":"trad","f":"simp"},{"i":"3fa903bb-4ed5-416c-9dc3-135737cf492e","t":"元日仗","a":"張祜","d":"唐","g":"短诗","p":["文武千官歲仗兵，萬方同軌奏昇平。","上皇一御含元殿，丹鳳門開白日明。"],"s":"trad","f":"simp"},{"i":"77c338c2-cce1-4d31-8be4-e1965d50e355","t":"連昌宮","a":"張祜","d":"唐","g":"短诗","p":["龍虎旌旗雨露飄，玉樓歌斷碧山遙。","玄宗上馬太真去，紅樹滿園香自銷。"],"s":"trad","f":"simp"},{"i":"4d9ab24a-3717-4627-8dce-23f953d6e82d","t":"正月十五夜燈","a":"張祜","d":"唐","g":"短诗","p":["千門開鎖萬燈名，正月中旬動帝京。","三百內人連袖舞，一時天上著詞聲。"],"s":"trad","f":"simp"},{"i":"3603a354-0dce-4c53-a47e-a4fce5ce12e9","t":"上巳樂","a":"張祜","d":"唐","g":"短诗","p":["猩猩血綵繫頭標，天上齊聲舉畫橈。","却是內人爭意切，六宮紅袖一時招。"],"s":"mixed","f":"simp"},{"i":"b27fbdec-68f4-4a46-996a-45f9316dc25f","t":"千秋樂","a":"張祜","d":"唐","g":"短诗","p":["八月平時花蕚樓，萬方同樂奏千秋。","傾城人看長竿出，一伎初成趙解愁。"],"s":"trad","f":"simp"},{"i":"5b486e7e-d873-4d31-97fc-acbd8a52319d","t":"春鶯囀","a":"張祜","d":"唐","g":"短诗","p":["興慶池南柳未開，太真先把一枝梅。","內人已唱春鶯囀，花下傞傞軟舞來。"],"s":"trad","f":"simp"},{"i":"ad1af30b-d275-4d2f-8d3b-c1eeea8cc6da","t":"大酺樂二首 一","a":"張祜","d":"唐","g":"短诗","p":["車架東來值太平，大酺三日洛陽城。","小兒一伎竿頭絕，天下傳呼萬歲聲。"],"s":"trad","f":"simp"},{"i":"891617e6-6946-48ec-9200-6bcb45a67213","t":"大酺樂二首 二","a":"張祜","d":"唐","g":"短诗","p":["紫陌酺歸日欲斜，紅塵開路薛王家。","雙鬟笑說樓前鼓，兩仗爭輪好落花。"],"s":"trad","f":"simp"},{"i":"b55e2773-4a7a-435f-87d6-a255796f66a8","t":"邠王小管","a":"張祜","d":"唐","g":"短诗","p":["虢國潛行韓國隨，宜春深院映花枝。","金輿遠幸無人見，偷把邠王小管吹。"],"s":"trad","f":"simp"},{"i":"198f9af8-7194-4615-8580-d0cbc9bc2e8b","t":"李謨笛","a":"張祜","d":"唐","g":"短诗","p":["平時東幸洛陽城，天樂宮中夜徹明。","無奈李謨偷曲譜，酒樓吹笛是新聲。"],"s":"trad","f":"simp"},{"i":"6fc4334a-9a36-4aef-86bf-3e5be674c6cc","t":"寧哥來","a":"張祜","d":"唐","g":"短诗","p":["日映宮城霧半開，太真簾下畏人猜。","黃翻綽指向西樹，不信寧哥回馬來。"],"s":"trad","f":"simp"},{"i":"91bc6aa8-c76d-463a-a9fe-339e340116e7","t":"丁巳年仲冬月江上作","a":"張祜","d":"唐","g":"短诗","p":["南來驅馬渡江濆，消息前年此月聞。","唯是賈先生慟哭，不堪天意重陰雲。"],"s":"trad","f":"simp"},{"i":"8a47c97b-e000-4c42-8f21-e5c31b5fe7d2","t":"鄴中懷古","a":"張祜","d":"唐","g":"短诗","p":["鄴中城下漳河水，日夜東流莫記春。","腸斷宮中望陵處，不堪臺上也無人。"],"s":"trad","f":"simp"},{"i":"ab22ebc0-9fe5-40c9-a204-6141a57ce058","t":"讀池州杜員外杜秋娘詩","a":"張祜","d":"唐","g":"短诗","p":["年少多情杜牧之，風流仍作杜秋詩。","可知不是長門閉，也得相如第一詞。"],"s":"trad","f":"simp"},{"i":"3ad79538-faa2-41f2-9351-5d4b1a1c7a95","t":"杭州開元寺牡丹","a":"張祜","d":"唐","g":"短诗","p":["濃豔初開小藥欄，人人惆悵出長安。","風流却是錢塘寺，不踏紅塵見牡丹。"],"s":"mixed","f":"simp"},{"i":"3a32ec90-6da8-409c-8a7c-d56b8cf0f377","t":"招徐宗偃畫松石","a":"張祜","d":"唐","g":"短诗","p":["咫尺雲山便出塵，我生長日自因循。","憑君畫取江南勝，留向東齋伴老身。"],"s":"trad","f":"simp"},{"i":"cf054eae-2804-486f-b914-a3f4756b1cfb","t":"平陰夏日作","a":"張祜","d":"唐","g":"短诗","p":["西來漸覺細塵紅，擾擾舟車路向東。","可惜夏天明月夜，土山前面障南風。"],"s":"trad","f":"simp"}]