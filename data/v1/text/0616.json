[{"i":"c-99d0c795bfc8","t":"虞美人","a":"谢逸","d":"宋","g":"词","p":["碧梧翠竹交加影。","角簟纱厨冷。","疏云淡月媚横塘。","一阵荷花风起、隔帘香。","雁横天末无消息。","水阔吴山碧。","刺桐花上蝶翩翩。","唯有夜深清梦、到郎边。"],"s":"simp","f":"trad"},{"i":"c-cdcc2911755e","t":"虞美人","a":"谢逸","d":"宋","g":"词","p":["角声吹散梅梢雪。","疏影黄昏月。","落英点点拂阑干。","风送清香满院、作轻寒。","花瓷羯鼓催行酒。","红袖掺掺手。","曲声未彻宝杯空。","饮罢香薰翠被、锦屏中。"],"s":"simp","f":"trad"},{"i":"c-68c6bfdc5b43","t":"虞美人","a":"谢逸","d":"宋","g":"词","p":["风前玉树瑲金韵。","碧落佳期近。","疏云影里鹊桥低。","檐外一弯新月、印修眉。","星河渐晓铜壶噎。","又是经年别。","此情莫与玉人知。","引起旧家离恨、泪珠垂。"],"s":"mixed","f":"trad"},{"i":"c-61387539cc80","t":"谒金门","a":"谢逸","d":"宋","g":"词","p":["帘外雨。","洗尽楚乡残暑。","白露影边霞一缕。","绀碧江天暮。","沈水烟横香雾。","茗碗浅浮琼乳。","卧听鹧鸪啼竹坞。","竹风清院宇。"],"s":"simp","f":"trad"},{"i":"c-2dd54f193818","t":"如梦令","a":"谢逸","d":"宋","g":"词","p":["花落莺啼春暮。","陌上绿杨飞絮。","金鸭晚香寒，人在洞房深处。","无语。","无语。","叶上数声疏雨。"],"s":"simp","f":"trad"},{"i":"c-df2e8dba76db","t":"如梦令","a":"谢逸","d":"宋","g":"词","p":["门外落花流水。","日暖杜鹃声碎。","蕃马小屏风，一枕画堂春睡。","如醉。","如醉。","正是困人天气。"],"s":"simp","f":"trad"},{"i":"c-d4533817023b","t":"青玉案","a":"谢逸","d":"宋","g":"词","p":["芦花飘雪迷洲渚。","送秋水、连天去。","一叶小舟横别浦。","数声鸿雁，两行鸥鹭。","天淡潇湘暮。","蓬窗醉梦惊箫鼓。","回首青楼在何处。","柳岸风轻吹残暑。","菊开青蕊，叶飞红树。","江上潇潇雨。"],"s":"simp","f":"trad"},{"i":"c-8c4c39ef1870","t":"好事近","a":"谢逸","d":"宋","g":"词","p":["疏雨洗烟波，雨过满江秋色。","风起白鸥零乱，破岚光深碧。","荻花枫叶只供愁，清吟写岑寂。","吟罢倚阑无语，听一声羌笛。"],"s":"simp","f":"trad"},{"i":"c-df542984b9a7","t":"临江仙","a":"谢逸","d":"宋","g":"词","p":["木落江寒秋色晚，飕飕吹帽风轻。","丹枫楼外捣衣声。","登高怀远，山影雁边横。","露染宫黄庭菊浅，茱萸烟拂红轻。","尊前谁整醉冠倾。","酒香薰脸，落日断霞明。"],"s":"simp","f":"trad"},{"i":"c-46c34bc16205","t":"临江仙","a":"谢逸","d":"宋","g":"词","p":["玉树临风宾欲散，黄昏约马嘶庭。","幽欢未尽有馀清。","琼糜方一啜，银烛已双擎。","坐久香津生齿颊，何须五斗消酲。","艳歌声里醉魂醒。","明年思此会，旌旆想登瀛。"],"s":"simp","f":"trad"},{"i":"c-ded42a568137","t":"减字木兰花","a":"谢逸","d":"宋","g":"词","p":["荷花风细。","乞巧楼中凉似水。","天幕低垂。","新月弯环浅晕眉。","桥横乌鹊。","不负年年云外约。","残漏疏钟。","肠断朝霞一缕红。"],"s":"simp","f":"trad"},{"i":"c-06c29a97d1b6","t":"减字木兰花","a":"谢逸","d":"宋","g":"词","p":["疏疏密密。","薝卜林中飞玉出。","妒舞欺梅。","悠扬随风去却回。","遥岑玉刻。","不见云中浮寸碧。","夜色清妍。","庭下交光月午天。"],"s":"simp","f":"trad"},{"i":"c-d33249b26144","t":"渔家傲","a":"谢逸","d":"宋","g":"词","p":["秋水无痕清见底。","蓼花汀上西风起。","一叶小舟烟雾里。","兰棹舣。","柳条带雨穿双鲤。","自叹直钩无处使。","笛声吹彻云山翠。","脍落霜刀红缕细。","新酒美。","醉来独枕莎衣睡。"],"s":"simp","f":"trad"},{"i":"c-b0829c929412","t":"清平乐","a":"谢逸","d":"宋","g":"词","p":["晓风残角。","月里梅花落。","宿酒醒时滋味恶。","翠被轻寒漠漠。","梦回一点相思。","远山暗蹙双眉。","不觉肌肤瘦玉，但知带减腰围。"],"s":"simp","f":"trad"},{"i":"c-aae294577d29","t":"清平乐","a":"谢逸","d":"宋","g":"词","p":["花边柳际。","已渐知春意。","归信不知何日是。","旧恨欲拚无计。","故人零落西东。","题诗待倩归鸿。","惟有多情芳草，年年处处相逢。"],"s":"mixed","f":"trad"},{"i":"c-12ed167607b8","t":"蓦山溪","a":"谢逸","d":"宋","g":"词","p":["霜清木落，深院帘栊静。","池面卷烟波，莹香水、一奁明镜。","修筠拂槛，疏翠挽婵娟，山雾敛，水云收，野阔江天迥。","红消醉玉，酒面风前醒。","罗幕护轻寒，锦屏空、金炉烬冷。","星横参昴，梅径月黄昏，清梦觉，浅眉颦，窗外横斜影。"],"s":"simp","f":"trad"},{"i":"c-f8eea7a0e1db","t":"玉楼春","a":"谢逸","d":"宋","g":"词","p":["弄晴数点梨梢雨。","门外画桥寒食路。","杜鹃飞破草间烟，蛱蝶惹残花底露。","东君著意怜樊素。","一段韶华都付与。","妆成不管露桃嗔，舞罢从教风柳妒。"],"s":"simp","f":"trad"},{"i":"c-35992ccdc177","t":"玉楼春","a":"谢逸","d":"宋","g":"词","p":["横塘晕浅琉璃莹。","绿叶阴浓庭院静。","樱桃熟后麦秋凉，芍药开时槐夏永。","蓬莱阁下红尘境。","青羽扇低摇凤影。","庭前玉树一枝春，香雾和烟新月冷。"],"s":"simp","f":"trad"},{"i":"c-873b7422d9c9","t":"玉楼春","a":"谢逸","d":"宋","g":"词","p":["个中怀抱谁排遣。","恻恻轻寒风剪剪。","细丝梅蕊晚香浓，争似柳梢春色浅。","娇叱道字歌声软。","醉后微涡回笑魇。","更无卓氏白头吟，只有卢郎年少恨。"],"s":"simp","f":"trad"},{"i":"c-d7f86cdc552c","t":"玉楼春","a":"谢逸","d":"宋","g":"词","p":["青钱点水圆荷绿。","解箨新篁森嫩玉。","轻风冉冉楝花香，小雨丝丝梅子熟。","华堂烛烬零金粟。","人在洞天三十六。","昭华吹彻管声寒，声入寿觞红浪蹙。"],"s":"simp","f":"trad"},{"i":"c-8c2371affa3d","t":"武陵春","a":"谢逸","d":"宋","g":"词","p":["画烛笼纱红影乱，门外紫骝嘶。","分破云团月影亏。","雪浪皱清漪。","捧碗纤纤春笋瘦，乳雾泛冰瓷。","两袖清风拂袖飞。","归去酒醒时。"],"s":"simp","f":"trad"},{"i":"c-9c7bebb7221c","t":"武陵春","a":"谢逸","d":"宋","g":"词","p":["拍岸蒲萄江水碧，柳带挽归艎。","破闷琴风绕袖凉。","蔌蔌楝花香。","淡烟疏雨随宜好，何处不潇湘。","愿作双飞老凤皇。","莫学野鸳鸯。"],"s":"simp","f":"trad"},{"i":"c-d7445acecccb","t":"浪淘沙","a":"谢逸","d":"宋","g":"词","p":["料峭小桃风。","凝淡春容。","宝灯山列半天中。","丽服靓妆携手处，笑语匆匆。","酒滴小槽红。","一饮千锺。","铜荷擎烛绛纱笼。","归去笙歌暄院落，月照帘栊。"],"s":"simp","f":"trad"},{"i":"c-4d91c047112b","t":"鹧鸪天","a":"谢逸","d":"宋","g":"词","p":["桐叶成阴拂画檐。","清风凉处卷疏帘。","红绡舞袖萦腰柳，碧玉眉心媚脸莲。","愁满眼，水连天。","香笺小字倩谁传。","梅黄楚岸垂垂雨，草碧吴江淡淡烟。"],"s":"simp","f":"trad"},{"i":"c-2ea4ddf354b2","t":"鹧鸪天","a":"谢逸","d":"宋","g":"词","p":["金节平分院落凉。","黄昏帘幕卷西厢。","冰轮碾碎粼粼碧，玉斧修成练练光。","低照户，巧侵床。","锦袍起舞谪仙狂。","鹊飞影里觥筹乱，桂子风前笑语香。"],"s":"simp","f":"trad"},{"i":"c-4f4c240e370d","t":"鹧鸪天","a":"谢逸","d":"宋","g":"词","p":["红晕香腮粉末匀。","梳妆闲淡稳精神。","谁知碧嶂清溪畔，也有姚家一朵春。","眉黛浅，谁为颦。","莫将心事付朝云。","坐中有客肠应断，忘了酴醿架下人。"],"s":"simp","f":"trad"},{"i":"c-113666420126","t":"鹧鸪天","a":"谢逸","d":"宋","g":"词","p":["水阔天低雁字横。","小春时节晚寒清。","梅梢月上纷纷白，竹坞风来冉冉轻。","人似玉，酒如渑。","入关意气喜风生。","坐中有客联镳去，谁唱阳关第四声。"],"s":"simp","f":"trad"},{"i":"c-b26ff0590932","t":"浣溪沙","a":"谢逸","d":"宋","g":"词","p":["楼阁帘垂乳燕飞。","圆荷细细点清溪。","薰风破闷晚凉时。","玉轸琴边兰思远，霜纨扇里翠眉低。","揉蓝衫子闹蜂儿。"],"s":"simp","f":"trad"},{"i":"c-9834dcff0416","t":"燕归梁","a":"谢逸","d":"宋","g":"词","p":["六曲阑干翠幕垂。","香烬冷金猊。","日高花外啭黄鹂。","春睡觉、酒醒时。","草青南浦，云横西塞，锦字杳无期。","东风只送柳绵飞。","全不管、寄相思。"],"s":"simp","f":"trad"},{"i":"c-749a03f7b57a","t":"千秋岁","a":"谢逸","d":"宋","g":"词","p":["楝花飘砌。","蔌蔌清香细。","梅雨过，苹风起。","情随湘水远，梦绕吴峰翠。","琴书倦，鹧鸪唤起南窗睡。","密意无人寄。","幽恨凭谁洗。","修竹畔，疏帘里。","歌馀尘拂扇，舞罢风掀袂。","人散后，一钩淡月天如水。"],"s":"simp","f":"trad"},{"i":"c-070f6842cbaf","t":"南乡子","a":"谢逸","d":"宋","g":"词","p":["浅色染春衣。","衣上双双小雁飞。","袖卷藕丝寒玉瘦，弹棋。","赢得尊前酒一卮。","冰雪拂胭脂。","绛蜡香融落日西。","唱彻阳关人欲去，依依。","醉眼横波翠黛低。"],"s":"simp","f":"trad"},{"i":"c-b2864aeb950e","t":"醉落魄・一斛珠","a":"谢逸","d":"宋","g":"词","p":["霜砧声急。","潇潇疏雨梧桐湿。","无言独倚阑干立。","帘卷黄昏，一阵西风入。","年时画阁佳宾集。","玉人檀板当筵执。","银瓶已断丝绳汲。","莫话前欢，忍对屏山泣。"],"s":"simp","f":"trad"},{"i":"c-80dc7c2958f4","t":"鹊桥仙","a":"谢逸","d":"宋","g":"词","p":["蝶飞烟草，莺啼云树，满院垂杨阴绿。","轻风飘散杏梢红，更吹皱、池波如縠。","珠帘日晚，银屏人散，楼上醉横霜竹。","一春若道不相思，缘底事、红绡褪玉。"],"s":"simp","f":"trad"},{"i":"c-1c6484dbb16c","t":"江神子・江城子","a":"谢逸","d":"宋","g":"词","p":["一江秋水碧湾湾。","绕青山。","玉连环。","帘幕低垂，人在画图间。","闲抱琵琶寻旧曲，弹未了，意阑珊。","飞鸿数点拂云端。","倚阑看。","楚天寒。","拟倩东风，吹梦到长安。","恰似梨花春带雨，愁满眼，泪阑干。"],"s":"simp","f":"trad"},{"i":"c-68eeb8f5b5df","t":"江神子・江城子","a":"谢逸","d":"宋","g":"词","p":["杏花村馆酒旗风。","水溶溶。","扬残红。","野渡舟横，杨柳绿阴浓。","望断江南山色远。","人不见，草连空。","夕阳楼外晚烟笼。","粉香融。","淡眉峰。","记得年时，相见画屏中。","只有关山今夜月，千里外，素光同。"],"s":"simp","f":"trad"},{"i":"c-ad269189cdc8","t":"点绛唇","a":"谢逸","d":"宋","g":"词","p":["九日登高，倚楼人在秋空半。","汝江如练。","碧影涵云巘。","醉看茱萸，定是明年健。","清尊满。","菊花黄浅。","偏入陶潜眼。"],"s":"mixed","f":"trad"},{"i":"c-9d555ff57813","t":"点绛唇","a":"谢逸","d":"宋","g":"词","p":["金气秋分，风清露冷秋期半。","凉蟾光满。","桂子飘香远。","素练宽衣，仙仗明飞观。","霓裳乱。","银桥人散。","吹彻昭华管。"],"s":"simp","f":"trad"},{"i":"c-5180e591c774","t":"七娘子","a":"谢逸","d":"宋","g":"词","p":["风剪冰花飞零乱。","映梅梢、素影摇清浅。","绣幄寒轻，兰薰烟暖。","艳歌催得金荷卷。","游梁已觉相如倦。","忆去年、舟渡淮南岸。","别后销魂，冷猿寒雁。","角声只送黄昏怨。"],"s":"simp","f":"trad"},{"i":"c-d7a04f17dec2","t":"卜算子","a":"谢逸","d":"宋","g":"词","p":["烟雨幂横塘，绀色涵清浅。","谁把并州快剪刀，剪取吴江半。","隐几岸乌巾，细葛含风软。","不见柴桑避俗翁，心共孤云远。"],"s":"simp","f":"trad"},{"i":"c-037cd15d1a08","t":"醉桃源・阮郎归","a":"谢逸","d":"宋","g":"词","p":["花枝破蕾柳梢青。","春寒拂面轻。","一眉新月影三星。","铜荷烛烬零。","低凤扇，袅霓旌。","珊珊环佩声。","坐间谁识许飞琼。","对郎仙骨清。"],"s":"simp","f":"trad"},{"i":"c-ad758b32fc1e","t":"醉桃源・阮郎归","a":"谢逸","d":"宋","g":"词","p":["风飘万点落花飞。","残红枝上稀。","平芜叶上淡烟迷。","那堪春鸟啼。","风细细，日迟迟。","轻纱叠雪衣。","多情多病懒追随。","玉人应恨伊。"],"s":"simp","f":"trad"},{"i":"c-2e859c53773b","t":"醉桃源・阮郎归","a":"谢逸","d":"宋","g":"词","p":["晨光晓色扫檐晶。","寒斋蝶梦惊。","乱飘鸳瓦细无声。","游扬柳丝轻。","书幌冷，竹窗明。","柴门只独扃。","一尊浊酒为谁倾。","梅花相对清。"],"s":"simp","f":"trad"},{"i":"c-ca007bcb331b","t":"望江南・忆江南","a":"谢逸","d":"宋","g":"词","p":["临川好，柳岸转平沙。","门外澄江丞相宅，坛前乔木列仙家。","春到满城花。","行乐处，舞袖卷轻纱。","谩摘青梅尝煮酒，旋煎白雪试新茶。","明月上檐牙。"],"s":"simp","f":"trad"},{"i":"c-7225c9b4f9da","t":"望江南・忆江南","a":"谢逸","d":"宋","g":"词","p":["临川好，山影碧波摇。","鱼跃冰池飞玉尺，云横石廪拂鲛绡。","高树竹萧萧。","寒食近，湖水绿平桥。","繁杏梢头张锦旆，垂杨阴里系兰桡。","游客解金貂。"],"s":"simp","f":"trad"},{"i":"c-2149a36b30b1","t":"柳梢青","a":"谢逸","d":"宋","g":"词","p":["香肩轻拍。","尊前忍听，一声将息。","昨夜浓欢，今朝别酒，明日行客。","后回来则须来，便去也、如何去得。","无限离情，无穷江水，无边山色。"],"s":"simp","f":"trad"},{"i":"c-b9126ff7b4ca","t":"减字木兰花","a":"夏倪","d":"宋","g":"词","p":["江涵晓日。","荡漾波光摇桨入。","笑指浯溪。","漫叟雄文锁翠微。","休嗟不偶。","归到中州何处有。","独立风烟。","湘水浯台总接天。"],"s":"simp","f":"trad"},{"i":"c-84366ce99b64","t":"汉宫春","a":"晁冲之","d":"宋","g":"词","p":["黯黯离怀，向东门系马，南浦移舟。","薰风乱飞燕子，时下轻鸥。","无情渭水，问谁教、日日东流。","常是送、行人去后，烟波一向离愁。","回首旧游如梦，记踏青殢饮，拾翠狂游。","无端彩云易散，覆水难收。","风流未老，拚千金，重入扬州。","应又是、当年载酒，依前名占青楼。"],"s":"mixed","f":"trad"},{"i":"c-0b1e6b1370db","t":"玉蝴蝶","a":"晁冲之","d":"宋","g":"词","p":["目断江南千里，灞桥一望，烟水微茫。","尽锁重门，人去暗度流光。","雨轻轻，梨花院落，风淡淡、杨柳池塘。","恨偏长。","佩沈湘浦，云散高唐。","清狂。","重来一梦，手搓梅子，煮酒初尝。","寂寞经春，小桥依旧燕飞忙。","玉钩栏、凭多渐暖，金缕枕、别久犹香。","最难忘。","看花南陌，待月西厢。"],"s":"simp","f":"trad"},{"i":"c-2a08664d3873","t":"感皇恩","a":"晁冲之","d":"宋","g":"词","p":["小阁倚晴空，数声钟定。","斗柄寒垂暮天净。","向来残酒，尽被晓风吹醒。","眼前还认得，当时景。","旧恨与新愁，不堪重省。","自叹多情更多病。","绮窗犹在，敲遍阑干谁应。","断肠明月下，梅摇影。"],"s":"simp","f":"trad"},{"i":"c-296b176e0a08","t":"感皇恩","a":"晁冲之","d":"宋","g":"词","p":["蝴蝶满西园，啼莺无数。","水阁桥南路。","凝伫。","两行烟柳，吹落一池飞絮。","秋千斜挂起，人何处。","把酒劝君，闲愁莫诉。","留取笙歌住。","休去。","几多春色，禁得许多风雨。","海棠花谢也，君知否。"],"s":"simp","f":"trad"},{"i":"c-d2ea5c8429cc","t":"感皇恩","a":"晁冲之","d":"宋","g":"词","p":["寒食不多时，牡丹初卖。","小院重帘燕飞碍。","昨宵风雨，只有一分春在，今朝犹自得，阴晴快。","熟睡起来，宿酲微带。","不惜罗襟搵眉黛，日高梳洗，看著花阴移改。","笑摘双杏子，连枝戴。"],"s":"mixed","f":"trad"},{"i":"c-fce3adcbafd0","t":"临江仙","a":"晁冲之","d":"宋","g":"词","p":["双舸亭亭横晚渚，城中飞观嵯峨。","画桥灯火照清波。","玉钩平浸水，金锁半沈河。","试问无情堤上柳，也应厌听离歌。","人生无奈别离何。","夜长嫌梦短，泪少怕愁多。"],"s":"simp","f":"trad"},{"i":"c-72f1b3d80c5f","t":"临江仙","a":"晁冲之","d":"宋","g":"词","p":["忆昔西池池上饮，年年多少欢娱。","别来不寄一行书。","寻常相见了，犹道不如初。","安稳锦屏今夜梦，月明好度江湖。","相思休问定何如。","情知春去后，管得落花无。"],"s":"simp","f":"trad"},{"i":"c-6d5436858d2f","t":"临江仙","a":"晁冲之","d":"宋","g":"词","p":["谩道追欢惟九日，年年此恨偏浓。","今朝吹帽与谁同。","黄花都未拆，和泪泣西风。","应恐登临肠更断，故交烟雨迷空。","为君一曲送飞鸿。","谁能推毂我，深入醉乡中。"],"s":"simp","f":"trad"},{"i":"c-6f8de64181ce","t":"渔家傲","a":"晁冲之","d":"宋","g":"词","p":["浦口潮来沙尾涨。","危樯半落帆游漾，水调不知何处唱。","风淡荡。","鳜鱼吹起桃花浪。","雪尽小桥梅总放。","层楼一任愁人上。","万里长安回首望。","山四向。","澄江日色如春酿。"],"s":"simp","f":"trad"},{"i":"c-212e590cf64b","t":"传言玉女","a":"晁冲之","d":"宋","g":"词","p":["一夜东风，吹散柳梢残雪。","御楼烟暖，正鳌山对结。","箫鼓向晚，凤辇初归宫阙。","千门灯火，九街风月。","绣阁人人，乍喜游、困又歇。","笑匀妆面，把朱帘半揭。","娇波向人，手拈玉梅低说。","相逢常是，上元时节。"],"s":"simp","f":"trad"},{"i":"c-4b987da2fae4","t":"如梦令","a":"晁冲之","d":"宋","g":"词","p":["帘外新来双燕。","珠阁琼楼穿遍。","香径得泥归，飞蹙池塘波面。","谁见。","谁见。","春晚昭阳宫殿。"],"s":"simp","f":"trad"},{"i":"c-90931a5f950e","t":"如梦令","a":"晁冲之","d":"宋","g":"词","p":["墙外辘轳金并。","惊梦瞢腾初省。","深院闭斜阳，燕入阴阴帘影。","人静。","人静。","花落鸟啼风定。"],"s":"simp","f":"trad"},{"i":"c-b7cf43b72459","t":"如梦令","a":"晁冲之","d":"宋","g":"词","p":["门在垂杨阴里。","楼枕曲江春水。","一阵牡丹风，香压满园花气。","沈醉。","沈醉。","不记绿窗先睡。"],"s":"mixed","f":"trad"},{"i":"c-ccca6c99badb","t":"上林春慢","a":"晁冲之","d":"宋","g":"词","p":["帽落宫花，衣惹御香，凤辇晚来初过。","鹤降诏飞，龙擎烛戏，端门万枝灯火。","满城车马，对明月、有谁闲坐。","任狂游，更许傍禁街，不局金锁。","玉楼人、暗中掷果。","珍帘下、笑著春衫袅娜。","素蛾绕钗，轻蝉扑鬓，垂垂柳丝梅朵。","夜阑饮散，但赢得、翠翘双亸。","醉归来，又重向、晓窗梳裹。"],"s":"simp","f":"trad"},{"i":"c-0a01518724f7","t":"汉宫春","a":"晁冲之","d":"宋","g":"词","p":["潇洒江梅，向竹梢稀处，横两三枝。","东君也不爱惜，雪压风欺。","无情燕子，怕春寒、轻失佳期。","惟是有、南来归雁，年年长见开时。","清浅小溪如练，问玉堂何似，茅舍疏篱。","伤心故人去后，冷落新诗。","微云淡月，对孤芳、分付他谁。","空自倚，清香未减，风流不在人知。"],"s":"simp","f":"trad"},{"i":"c-5483bf1f4885","t":"小重山","a":"晁冲之","d":"宋","g":"词","p":["碧水浮瓜纹簟前。","只知闲枕手，不成眠。","晚云如火雨晴天。","轻云远，亭外一声蝉。","池馆几年年。","倚阑催小艇，采新莲。","多情还到芰荷边。","应相忆，折藕看丝牵。"],"s":"simp","f":"trad"},{"i":"c-104a0eeb116f","t":"临江仙","a":"苏庠","d":"宋","g":"词","p":["本是白苹洲畔客，虎符卧镇江城。","归来犹得趁鸥盟。","柳丝摇晓市，杜若遍芳汀。","莫惜飞觞仍堕帻，柳边依约莺声。","水秋鲈熟正关情。","只愁宣室召，未许钓船轻。"],"s":"simp","f":"trad"},{"i":"c-de36a52531e1","t":"临江仙","a":"苏庠","d":"宋","g":"词","p":["猎猎风蒲初暑过，萧然庭户秋清。","野航渡口带烟横。","晚山千万叠，别鹤两三声。","秋水芙蓉聊荡桨，一樽同破愁城。","蓼花滩上白鸥明。","暮云连极浦，急雨暗长汀。"],"s":"simp","f":"trad"},{"i":"c-73c90ffcd301","t":"如梦令","a":"苏庠","d":"宋","g":"词","p":["叠嶂晓埋烟雨。","忽作飞花无数。","整整复斜斜，来伴南枝清苦。","日暮。","日暮。","何许云林烟树。"],"s":"simp","f":"trad"},{"i":"c-14d16416e138","t":"虞美人","a":"苏庠","d":"宋","g":"词","p":["军书未息梅仍破。","穿市溪流过。","病来无处不关情。","一夜鸣榔急雨、杂滩声。","飘零无复还山梦。","云屋春寒重。","山连积水水连空。","溪上青蒲短短、柳重重。"],"s":"simp","f":"trad"},{"i":"c-c5e70fc512e6","t":"浣溪沙","a":"苏庠","d":"宋","g":"词","p":["水榭风微玉枕凉。","牙床角簟藕花香。","野塘烟雨罩鸳鸯。","红蓼渡头青嶂远，绿苹波上白鸥双。","淋浪淡墨水云乡。"],"s":"simp","f":"trad"},{"i":"c-2faa61c409ef","t":"谒金门","a":"苏庠","d":"宋","g":"词","p":["何处所。","门外冷云堆浦。","竹里江梅寒未吐。","茅屋疏疏雨。","谁遣愁来如许。","小立野塘官渡。","手种凌霄今在否。","柳浪迷烟渚。"],"s":"simp","f":"trad"},{"i":"c-1faaa63f0a27","t":"谒金门","a":"苏庠","d":"宋","g":"词","p":["杨柳渡。","醉著青鞋归去。","点点沙鸥何处所。","十里菰蒲雨。","抖擞向来尘土。","卧看碧山云度。","寄语故时猿鹤侣。","未见心先许。"],"s":"simp","f":"trad"},{"i":"c-26e4b5a27ab0","t":"鹧鸪天","a":"苏庠","d":"宋","g":"词","p":["枫落河梁野水秋。","澹烟衰草接郊丘。","醉眠小坞黄茅店，梦倚高城赤叶楼。","天杳杳，路悠悠。","钿筝歌扇等闲休。","灞桥杨柳年年恨，鸳浦芙蓉叶叶愁。"],"s":"simp","f":"trad"},{"i":"c-7712fd381f49","t":"鹧鸪天","a":"苏庠","d":"宋","g":"词","p":["梅妒晨妆雪妒轻。","远山依约学眉青。","樽前无复歌金缕，梦觉空馀月满林。","鱼与雁，两浮沈。","浅颦微笑总关心。","相思恰似江南柳，一夜春风一夜深。"],"s":"mixed","f":"trad"},{"i":"c-fc71eb22c44e","t":"鹧鸪天","a":"苏庠","d":"宋","g":"词","p":["秋入蒹葭小雁行。","参差飞堕水云乡。","直须银甲供春笋，且滴糟床覆羽觞。","风压幕，月侵廊。","江南江北夜茫茫。","悬知上马啼鹃梦，一夜惊飞宝鸭香。"],"s":"simp","f":"trad"},{"i":"c-06fdabea6748","t":"诉衷情","a":"苏庠","d":"宋","g":"词","p":["杖头挑得布囊行。","活计有谁争。","不肯侯家五鼎，碧涧一杯羹。","溪上月，岭头云。","不劳耕。","瓮中春色，枕上华胥，便是长生。"],"s":"simp","f":"trad"},{"i":"c-9e9769ee0437","t":"诉衷情","a":"苏庠","d":"宋","g":"词","p":["倦投林樾当诛茅。","鸿雁响寒郊。","溪上晚来杨柳，月露洗烟梢。","霜后渚，水分槽。","尚平桥。","客床归梦，何必江南，门接云涛。"],"s":"simp","f":"trad"},{"i":"c-ba1829ab2e99","t":"阮郎归","a":"苏庠","d":"宋","g":"词","p":["西园风暖落花时。","绿阴莺乱啼。","倚阑无语惜芳菲。","絮飞蝴蝶飞。","缘底事，减腰围。","遣愁愁著眉。","波连春渚暮天垂。","燕归人未归。"],"s":"simp","f":"trad"},{"i":"c-84f1cbe8b8c4","t":"点绛唇","a":"苏庠","d":"宋","g":"词","p":["冰勒轻飔，绿痕初涨回塘水。","柳洲烟际。","白鹭翘沙嘴。","箬笠青蓑，未减貂蝉贵。","云涛里。","醉眠篷底。","不属人间世。"],"s":"simp","f":"trad"},{"i":"c-8197468986f6","t":"菩萨蛮","a":"苏庠","d":"宋","g":"词","p":["北风振野云平屋。","寒溪淅淅流冰谷。","落日送归鸿。","夕岚千万重。","荒坡垂斗柄。","直北乡山近。","何必苦言归。","石亭春满枝。"],"s":"simp","f":"trad"},{"i":"c-7fca2ff6ac2d","t":"菩萨蛮","a":"苏庠","d":"宋","g":"词","p":["园林寂寂春归去。","濛濛柳下飞香絮。","野水接云横。","绿烟啼晓莺。","江南鶗鴂梦。","山色朝来重。","小艇小湾头。","苹花苹叶洲。"],"s":"mixed","f":"trad"},{"i":"c-92b2bc9fa14a","t":"菩萨蛮","a":"苏庠","d":"宋","g":"词","p":["短船谁泊蒹葭渚。","夜深远火明渔浦。","却忆槿花篱。","春声穿竹溪。","云山如昨好。","人自垂垂老。","心事有谁知。","月明霜满枝。"],"s":"simp","f":"trad"},{"i":"c-a7cac17eabd2","t":"菩萨蛮","a":"苏庠","d":"宋","g":"词","p":["眼中叠叠烟中树。","晚云点点翻荷雨。","鸥泛渚边烟。","绿蒲秋满川。","未成江海去。","聊作林塘主。","客恨阔无津。","风斜白氎巾。"],"s":"simp","f":"trad"},{"i":"c-689cc02f6466","t":"菩萨蛮","a":"苏庠","d":"宋","g":"词","p":["年时忆著花前醉。","而今花落人憔悴。","麦浪卷晴川。","杜鹃声可怜。","有书无雁寄。","初夏槐风细。","家在落霞边。","愁逢江月圆。"],"s":"simp","f":"trad"},{"i":"c-6e15e65d0bdc","t":"菩萨蛮","a":"苏庠","d":"宋","g":"词","p":["照溪梅雪和烟堕。","寒林漠漠愁烟锁。","客恨渺无涯。","雁来人忆家。","远山疑带雨。","一线云间语。","霜月又婵娟。","江南若个边。"],"s":"simp","f":"trad"},{"i":"c-dfc48152c7e0","t":"菩萨蛮","a":"苏庠","d":"宋","g":"词","p":["春波滟滟浮春渚。","绿阴一径风兼雨。","又作去年时。","绿深垂蔓篱。","故山归兴动。","江北江南梦。","白发故相欺。","星星如有期。"],"s":"simp","f":"trad"},{"i":"c-52e606f754a4","t":"木兰花・玉楼春","a":"苏庠","d":"宋","g":"词","p":["江云叠叠遮鸳浦。","江水无情留薄暮。","归帆初张苇边风，客梦不禁篷背雨。","渚花不解留人住。","只作深愁无尽处。","白沙烟树有无中，雁落沧洲何处所。"],"s":"simp","f":"trad"},{"i":"c-975ed4161a58","t":"清平乐","a":"苏庠","d":"宋","g":"词","p":["断崖流水。","香度青林底。","元配骚人兰与芷。","不数春风桃李。","淮南丛桂小山。","诗翁合得攀翻。","身到十洲三岛，心游万壑千岩。"],"s":"simp","f":"trad"},{"i":"c-9eb18762415f","t":"小重山","a":"祖可","d":"宋","g":"词","p":["谁向江头遣恨浓。","碧波流不断，楚山重。","柳烟和雨隔疏钟。","黄昏后，罗幕更朦胧。","桃李小园空。","阿谁犹笑语，拾残红。","珠帘卷尽落花风。","人不见，春在绿芜中。"],"s":"simp","f":"trad"},{"i":"c-d7cf447bf3c1","t":"菩萨蛮","a":"祖可","d":"宋","g":"词","p":["西风簌簌低红叶。","梧桐影里银河匝。","梦破画帘垂。","月明乌鹊飞。","新愁知几许。","欲似丝千缕。","雁已不堪闻。","砧声何处村。"],"s":"simp","f":"trad"},{"i":"c-9c16e89c9ac0","t":"菩萨蛮","a":"祖可","d":"宋","g":"词","p":["谁能画取沙边雨。","和烟澹扫蒹葭渚。","别岸却斜晖。","采莲人未归。","鸳鸯如解语。","对浴红衣去。","去了更回头。","教侬特地愁。"],"s":"simp","f":"trad"},{"i":"c-ca03c2ce0c73","t":"失调名","a":"蔡","d":"宋","g":"词","p":["扇开仙掌。"],"s":"simp","f":"trad"},{"i":"c-8a82364181bb","t":"声声慢","a":"张阁","d":"宋","g":"词","p":["长天霞散，远浦潮平，危阑注目江皋。","长记年年荣遇，同是今朝。","金銮两回命相，对清光、频许挥毫。","雍容久，正茶杯初赐，香袖时飘。","归去玉堂深夜，泥封罢，金莲一寸才烧。","帝语丁宁，曾被华衮亲褒。","如今谩劳梦想，叹尘踪、杳隔仙鳌。","无聊意，强当歌对酒怎消。"],"s":"simp","f":"trad"},{"i":"c-a60d0a294089","t":"水调歌头","a":"毛滂","d":"宋","g":"词","p":["九金增宋重，八玉变秦馀。","千年清浸，洗净河洛出图书。","一段升平光景，不但五星循轨，万点共连珠。","垂衣本神圣，补衮妙工夫。","朝元去，锵环佩，冷云衢。","芝房雅奏，仪凤矫首听笙竽。","天近黄麾仗晓，春早红鸾扇暖，迟日上金铺。","万岁南山色，不老对唐虞。"],"s":"simp","f":"trad"},{"i":"c-6a559978ec81","t":"绛都春","a":"毛滂","d":"宋","g":"词","p":["馀寒尚峭。","早凤沼冻开，芝田春到。","茂对诞期，天与公春向廊庙。","元工开物争春妙。","付与秾华多少。","召还和气，拂开霁色，未妨谈笑。","缥缈。","五云乱处，种雕菰向熟，碧桃犹小。","雨露在门，光采充闾乌亦好。","宝熏郁雾城南道。","天自锡公难老。","看公身任安危，二十四考。"],"s":"simp","f":"trad"},{"i":"c-20081860f741","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["九重寒少。","烟暖丰瑶草。","金井碧梧雏凤矫。","南极人来最老。","衣冠远换裘毡。","德随和气蝉连。","万里同开寿域，一年三秀芝田。"],"s":"simp","f":"trad"},{"i":"c-ec557a0a4d15","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["重芳叠秀。","风约仙云皱。","椿不争年松与寿。","共出皇家忠孝。","仁深枯冷皆蒙。","托根不倚东风。","日照恩光万里，暖生塞草丛中。"],"s":"simp","f":"trad"},{"i":"c-aaa342a4500d","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["镂烟翦雾。","𩉾鞢无层数。","苜蓿青深烦雪兔。","引到祥华开处。","仙人手翳朝阳。","清都绛阙相将。","来覆东封翠辇，好遮化日舒长。"],"s":"simp","f":"trad"},{"i":"c-25b899c0473c","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["九茎为寿。","千叶前无有。","叶叶年年看不朽。","天与君主意厚。","君恩雨露无边。","玉筵暖接非烟。","马向华山烽冷，人安草亦千年。"],"s":"simp","f":"trad"},{"i":"c-93f3b6446791","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["绛河千岁。","一照升平事。","万里青铜开碧霁。","俯见南山晚翠。","绀寒不翅湘酃。","清於练静江澄。","流向万年觞里，玉波可但如渑。"],"s":"mixed","f":"trad"},{"i":"c-80c15025fd95","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["银河秋浪。","遥出昆仑上。","忽变澄澜添碧涨。","可道升平无象。","黄云浊雾初开。","荣光休气徘徊。","试觅当时五老，金泥玉检将来。"],"s":"simp","f":"trad"},{"i":"c-281cfd7ebd8f","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["天连翠潋。","九折玻璃软。","回抱金堤清宛转。","疑共蓬莱清浅。","吾君欲济如何。","唐虞风顺无多。","自有松舟桧楫，一帆三代同波。"],"s":"simp","f":"trad"},{"i":"c-fbf664703fbf","t":"清平乐","a":"毛滂","d":"宋","g":"词","p":["娟娟月满。","冉冉梅花暖。","春意初长寒力浅。","渐拟芳菲满眼。","当时吉梦重重。","间生天子三公。","付与人间桃李，年年管领春风。"],"s":"simp","f":"trad"}]