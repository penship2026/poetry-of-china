[{"i":"c-36ae36a7fbd5","t":"厅前柳","a":"赵师侠","d":"宋","g":"词","p":["晚秋天。","过暮雨，云容敛，月澄鲜。","正风露凄清处，砌蛩喧。","更黄蝶。","舞翩翩。","念故里、千山云水隔，被名缰利锁萦牵。","莫作悲秋意，对尊前。","且同乐。","太平年。"],"s":"simp","f":"trad"},{"i":"c-1b9ceed0f844","t":"厅前柳","a":"赵师侠","d":"宋","g":"词","p":["景清佳。","正倦客，凝秋思。","浩无涯。","递十里香芬馥，桂初华。","向碧叶。","露芳葩。","为粟粒、鹅儿情淡薄，倩西风染就丹砂。","不比黄金雨，灿馀霞。","送幽梦，到仙家。"],"s":"simp","f":"trad"},{"i":"c-6ed88bc5890c","t":"诉衷情","a":"赵师侠","d":"宋","g":"词","p":["清和时候雨初晴。","密树翠阴成。","新篁嫩摇碧玉，芳径绿苔深。","雏燕语，乳莺声。","暑风轻。","帘旌微动，沈篆烟消，午枕馀清。"],"s":"simp","f":"trad"},{"i":"c-f2956e572eb1","t":"诉衷情","a":"赵师侠","d":"宋","g":"词","p":["神功圣德妙难量。","灵应著莆阳。","湄洲自昔仙境，宛在水中央。","孚惠爱，备祈禳。","降嘉祥。","云车风马，肸蚃来歆，桂酒椒浆。"],"s":"simp","f":"trad"},{"i":"c-54dae5579b18","t":"诉衷情","a":"赵师侠","d":"宋","g":"词","p":["茫茫云海浩无边。","天与谁相连。","舳舻万里来往，有祷必安全。","专掌握，雨晹权。","属丰年。","琼卮玉醴，飨此精诚，福庆绵绵。"],"s":"simp","f":"trad"},{"i":"c-445878b88f52","t":"诉衷情","a":"赵师侠","d":"宋","g":"词","p":["威灵千里护封圻。","十万户归依。","白湖宫殿云耸，香火尽虔祈。","倾寿酒，诵声诗。","谅遥知。","民康俗阜，雨润风滋，功与天齐。"],"s":"simp","f":"trad"},{"i":"c-b3869d808016","t":"一翦梅","a":"赵师侠","d":"宋","g":"词","p":["雪里盈盈玉破花。","遐想风流，压尽京华。","点酥团粉任敧斜。","独露春妍谁似他。","有酒何须稚子赊。","访戴归来，倚棹溪涯。","人生得意定谈夸。","除却西湖，不计谁家。"],"s":"simp","f":"trad"},{"i":"c-e7818501d310","t":"一翦梅","a":"赵师侠","d":"宋","g":"词","p":["暖日烘梅冷未苏。","脱叶随风，独见枯株。","先春占早又何如。","玉点枝头，犹自萧疏。","江北江南景不殊。","雪里花清，月下香浮。","他年调鼎费工夫。","且与藏春，处士西湖。"],"s":"simp","f":"trad"},{"i":"c-82c6dee040fc","t":"朝中措","a":"赵师侠","d":"宋","g":"词","p":["斜阳留照有馀红。","烟霭淡冥濛。","麦陇青摇一望，前山翠失双峰。","高台徙倚，松飘逸韵，梅减冰容。","俯视尘寰如掌，翩然我欲乘风。"],"s":"mixed","f":"trad"},{"i":"c-47e2d0565bd7","t":"朝中措","a":"赵师侠","d":"宋","g":"词","p":["疏疏帘幕映娉婷。","初试晓妆新。","玉腕云边缓转，修蛾波上微颦。","铅华淡薄，轻匀桃脸，深注樱唇。","还似舞鸾窥沼，无情空恼行人。"],"s":"simp","f":"trad"},{"i":"c-52ef45a7377b","t":"朝中措","a":"赵师侠","d":"宋","g":"词","p":["西风著意送归船。","家近总欣然。","去日梅开烂漫，归时秋满山川。","京华倦客，难堪羁思，历尽秋边。","寄语姮娥休笑，月圆人亦团圆。"],"s":"simp","f":"trad"},{"i":"c-d3dd42278b97","t":"朝中措","a":"赵师侠","d":"宋","g":"词","p":["乱山春过雪成堆。","七里递香回。","蕊簇玲珑金粟，花装碎屑玫瑰。","兰衰梅谢，桃粗李俗，谁与追随。","清绝殿春仙侣，清风吹破荼䕷。"],"s":"simp","f":"trad"},{"i":"c-29ac65f09d00","t":"朝中措","a":"赵师侠","d":"宋","g":"词","p":["开随律琯度芳辰。","鲜艳见天真。","不比浮花浪蕊，天教月月常新。","蔷薇颜色，玫瑰态度，宝相精神。","休数岁时月季，仙家栏槛长春。"],"s":"simp","f":"trad"},{"i":"c-5eb1b752e1c3","t":"朝中措","a":"赵师侠","d":"宋","g":"词","p":["眉间黄色喜何如。","花县拜恩初。","五品荣颁命服，十行祗奉天书。","萱堂绣阁，均封大邑，盛事同居。","此日银章朱绂，行看玉带金鱼。"],"s":"simp","f":"trad"},{"i":"c-0435dd6cda5f","t":"点绛唇","a":"赵师侠","d":"宋","g":"词","p":["日暖风喧，殿春琼蕊依台榭。","雪堆花架。","不用丹青写。","莹彻精神，映月唯宜夜。","幪香帕。","倩风扶下。","碎玉残妆卸。"],"s":"simp","f":"trad"},{"i":"c-6e38451b47a9","t":"点绛唇","a":"赵师侠","d":"宋","g":"词","p":["漠漠春阴，褪花时候馀寒峭。","数声啼鸟。","唤起帘栊晓。","云鬓慵梳，淡拂春山小。","情多少。","乱萦愁抱。","风里垂杨袅。"],"s":"simp","f":"trad"},{"i":"c-ad9e8284942e","t":"点绛唇","a":"赵师侠","d":"宋","g":"词","p":["袅袅娉娉，可人尤赛娘风韵。","花娇玉润。","一捻春期近。","占路藏机，已向棋中进。","俱休问。","酒旗花阵。","早晚争先胜。"],"s":"simp","f":"trad"},{"i":"c-e97631444440","t":"扑蝴蝶","a":"赵师侠","d":"宋","g":"词","p":["清和时候，薰风来小院。","琅玕脱箨，方塘荷翠飐。","柳丝轻度流莺，画栋低飞乳燕。","园林绿阴初遍。","景何限。","轻纱细葛，纶巾和羽扇。","披襟散发，心清尘不染。","一杯洗涤无馀，万事消磨去远。","浮名薄利休羡。"],"s":"simp","f":"trad"},{"i":"c-94ec79945d9a","t":"醉桃源・阮郎归","a":"赵师侠","d":"宋","g":"词","p":["微云扫尽碧虚宽。","月华光影寒。","山河表里鉴中看。","沈沈清夜阑。","风细细，露漙漙。","神游八极间。","九宵回首望尘寰。","悠然醉梦还。"],"s":"simp","f":"trad"},{"i":"c-2c17bcb0a953","t":"醉桃源・阮郎归","a":"赵师侠","d":"宋","g":"词","p":["纤枝延蔓走青虬。","风清体更柔。","故绕檀蕊著花稠。","疏疏如缀旒。","琼作靥，玉成裘。","玫瑰应辈流。","惜香愁怕罥搔头。","宁随□事休。"],"s":"simp","f":"trad"},{"i":"c-f5fcf756a217","t":"醉桃源・阮郎归","a":"赵师侠","d":"宋","g":"词","p":["杜鹃花发映山红。","韶光觉正浓。","水流红紫各西东。","绿肥春已空。","闲戏蝶，懒游蜂。","破除花影重。","问春何事不从容。","忧愁风雨中。"],"s":"simp","f":"trad"},{"i":"c-407416cf0de9","t":"贺圣朝","a":"赵师侠","d":"宋","g":"词","p":["千林脱落群芳息。","有一枝先白。","孤标疏影压花丛，更清香堪惜。","吟情无尽，赏音未已，早纷纷藉藉。","想贪结子去调羹，任叫云横笛。"],"s":"simp","f":"trad"},{"i":"c-bec6664e997d","t":"踏莎行","a":"赵师侠","d":"宋","g":"词","p":["白云开残，红云吹尽。","园林新绿迷芳径。","榆钱不解青春，随风乱点苍苔晕。","紫燕飞忙，黄鹂声嫩。","日长烟暖游蜂困。","凭高念远思无穷，那堪宿酒厌厌病。"],"s":"simp","f":"trad"},{"i":"c-228d774fa8c1","t":"踏莎行","a":"赵师侠","d":"宋","g":"词","p":["万事随缘，一身须正。","功名富贵皆前定。","多图广计要争强，如何人力将天胜。","枉费机谋，徒劳奔竞。","到头毕竟由他命。","安时处顺得心闲，饥餐困寝亏贤甚。"],"s":"simp","f":"trad"},{"i":"c-4bf093e99a21","t":"忆秦娥","a":"赵师侠","d":"宋","g":"词","p":["伤离索。","不堪凉月穿珠箔。","穿珠箔。","料应别后，粉销琼削。","无聊倚遍西楼角。","枝头几误惊飞鹊。","惊飞鹊。","先来憔悴，更逢摇落。"],"s":"simp","f":"trad"},{"i":"c-bea62ee1078d","t":"武陵春","a":"赵师侠","d":"宋","g":"词","p":["一阵晓风花信早，先到小桃枝。","冉冉红云映翠微。","开宴忆瑶池。","零乱分飞贪结子，芳径自成蹊。","消得刘郎去路迷。","肠断武陵溪。"],"s":"simp","f":"trad"},{"i":"c-3fa72ed6fefd","t":"武陵春","a":"赵师侠","d":"宋","g":"词","p":["乍雨笼晴云不定，芳草绿纤柔。","燕语莺啼小院幽。","春色二分休。","试凭危栏凝远目，山与水光浮。","滚滚闲愁逐水流。","流不尽、许多愁。"],"s":"simp","f":"trad"},{"i":"c-86ccd60f90a6","t":"清平乐","a":"赵师侠","d":"宋","g":"词","p":["无风轻燕。","缭绕深深院。","昼永人闲帘不卷。","时听莺簧巧啭。","清和天气阴阴。","南风初奏薰琴。","唤起午窗新梦，愁添一掬归心。"],"s":"simp","f":"trad"},{"i":"c-f27faa86693b","t":"清平乐","a":"赵师侠","d":"宋","g":"词","p":["一宵风雨。","春与人俱去。","春解再来花作主。","只有行人无据。","殷勤满酌离觞。","阳关唱起愁肠。","苦恨无情杜宇，声声叫断斜阳。"],"s":"simp","f":"trad"},{"i":"c-16c1b9f7920d","t":"清平乐","a":"赵师侠","d":"宋","g":"词","p":["纤秾娇小。","也解争春早。","占得中央颜色好。","装点枝枝新巧。","东皇初到江城。","殷勤先去迎春。","乞与黄金腰带，压持红紫纷纷。"],"s":"simp","f":"trad"},{"i":"c-f89359c713b4","t":"鹊桥仙","a":"赵师侠","d":"宋","g":"词","p":["风波平地，尘埃扑面，总是争名竞利。","悟时不必苦贪图，但言任、流行坎止。","忽来忽去，何荣何辱，天也知人深意。","一帆风送过桐江，喜跳出、琉璃井里。"],"s":"simp","f":"trad"},{"i":"c-0aab43cd8de5","t":"鹊桥仙","a":"赵师侠","d":"宋","g":"词","p":["同云幕幕，狂风浩浩，激就六花飞下。","山川满目白模糊，更茅舍、溪桥潇洒。","玉田银界，瑶林琼树，光映乾坤不夜。","行人不为旅人忙，怎解识、天然图画。"],"s":"simp","f":"trad"},{"i":"c-62467b60186d","t":"鹊桥仙","a":"赵师侠","d":"宋","g":"词","p":["春光已暮，花残叶密，更值无情风雨。","斜阳芳树翠烟中，又听得、声声杜宇。","血流无用，离魂空断，只挠凄凉为旅。","在家谁道不如归，你何似、随风归去。"],"s":"simp","f":"trad"},{"i":"c-bb43d2010172","t":"鹊桥仙","a":"赵师侠","d":"宋","g":"词","p":["明河风细，鹊桥云淡，秋入庭梧先坠。","摩孩罗荷叶伞儿轻，总排列、双双对对。","花瓜应节、蛛丝卜巧，望月穿针楼外。","不知谁见女牛忙，谩多少、人间欢会。"],"s":"simp","f":"trad"},{"i":"c-818058da197a","t":"谒金门","a":"赵师侠","d":"宋","g":"词","p":["风和雨。","又送一番春去。","春去不知何处住。","惜春无觅处。","柳老空抟香絮。","莺娇乍迁芳树。","回念故园如旧否。","不堪闻杜宇。"],"s":"simp","f":"trad"},{"i":"c-ab0ab150d0f0","t":"谒金门","a":"赵师侠","d":"宋","g":"词","p":["江水绿。","江山数峰如簇。","唤渡小舟来岸北。","笋舆行太速。","素艳窗纱笼玉。","埠负看花心目。","今夜知他何处宿。","断魂沙路曲。"],"s":"simp","f":"trad"},{"i":"c-412b15448917","t":"谒金门","a":"赵师侠","d":"宋","g":"词","p":["沙畔路。","记得旧时行处。","蔼蔼疏烟迷远树。","野航横不渡。","竹里疏花梅吐。","照眼一川鸥鹭。","家在清江江上住。","水流愁不去。"],"s":"simp","f":"trad"},{"i":"c-fc3227ed6bfd","t":"谒金门","a":"赵师侠","d":"宋","g":"词","p":["风雨急。","红紫又还狼藉。","嫩绿团枝苔径湿。","帘开双燕入。","院静昼闲人寂。","一缕水沈烟直。","心事有谁能会得。","阶前芳草碧。"],"s":"simp","f":"trad"},{"i":"c-a760eeaf2717","t":"谒金门","a":"赵师侠","d":"宋","g":"词","p":["风策策。","山迥暮烟横白。","淅沥穿林翻败叶。","羁怀愁倦客。","问宿荒村山驿。","谁识离情脉脉。","雁足无书孤夜色。","音尘千里隔。"],"s":"simp","f":"trad"},{"i":"c-75cfdfac10e7","t":"谒金门","a":"赵师侠","d":"宋","g":"词","p":["花夜雨。","渺渺绿波南浦。","擘絮晴云山外吐。","凝情谁共语。","十二玉梯空伫。","闲却琐窗朱户。","久客念归归未许。","寸心愁万缕。"],"s":"simp","f":"trad"},{"i":"c-8b8cfb8d4f53","t":"谒金门","a":"赵师侠","d":"宋","g":"词","p":["风雨半。","春锁绿杨深院。","幕浪不翻香穗卷。","轻寒闲便面。","归兴新来不浅。","勾引闲愁撩乱。","一枕春酲谁与管。","晓莺惊梦断。"],"s":"simp","f":"trad"},{"i":"c-82be99ac6a83","t":"东坡引","a":"赵师侠","d":"宋","g":"词","p":["相看情未足。","离觞已催促。","停歌欲语眉先蹙。","何期归太速。","如今去也，无计追逐。","怎忍听、阳关曲。","扁舟后夜滩头宿。","愁随烟树簇。","愁随烟树簇。"],"s":"simp","f":"trad"},{"i":"c-6a6c14e14ea9","t":"东坡引","a":"赵师侠","d":"宋","g":"词","p":["飞花红不聚。","都因夜来雨。","枝头冷落情如许。","东风谁是主。","看看满地，堆却香絮。","但目断、章台路。","残英剩蕊留春住。","春归何处去。","春归何处去。"],"s":"simp","f":"trad"},{"i":"c-868f25daa3de","t":"东坡引","a":"赵师侠","d":"宋","g":"词","p":["杯行情意密。","今宵是何夕。","行人此别真堪惜。","愁肠空闷郁。","明朝去也，回首相忆。","要留恋、如何得。","无端骤雨飘何急。","人来心上滴。","人来心上滴。"],"s":"simp","f":"trad"},{"i":"c-c17552e706f4","t":"生查子","a":"赵师侠","d":"宋","g":"词","p":["梅从陇首传，柳向邮亭折。","鸳瓦晓霜浓，掠面凝寒色。","相逢意便亲，欲去如何说。","我亦是行人，更与行人别。"],"s":"simp","f":"trad"},{"i":"c-faab01389294","t":"生查子","a":"赵师侠","d":"宋","g":"词","p":["千山拥翠屏，一水萦罗带。","雨过水痕添，云散山容在。","亭高景最幽，天回风尤快。","啼鸟一声闲，唤起情无奈。"],"s":"simp","f":"trad"},{"i":"c-74316163afe1","t":"生查子","a":"赵师侠","d":"宋","g":"词","p":["迟迟春昼长，冉冉东风软。","寒食乍晴天，红紫芳菲遍。","前峰积翠横，新涨挼蓝远。","向晚淡烟迷，一段屏山展。"],"s":"simp","f":"trad"},{"i":"c-f4dc3ed47e25","t":"生查子","a":"赵师侠","d":"宋","g":"词","p":["春光不肯留，风雨催将去。","红逐故园尘，绿满江南树。","阴晴寒食天，寂寞西郊路。","芳草织新愁，怅望人何处。"],"s":"simp","f":"trad"},{"i":"c-ce0bafd69dae","t":"生查子","a":"赵师侠","d":"宋","g":"词","p":["庭虚任雀喧，院静无人到。","回首十年非，赖得知几早。","心随香篆销，意与梅花好。","万事转头空，一笑吾身老。"],"s":"simp","f":"trad"},{"i":"c-136153af3d02","t":"少年游","a":"赵师侠","d":"宋","g":"词","p":["玉壶冰结暮天寒。","朔吹绕阑干。","雪破梢头，香传花外，春信入江南。","巡檐索笑情无限，一点已微酸。","待得黄垂，冥冥烟雨，绿树袅金丸。"],"s":"simp","f":"trad"},{"i":"c-067e5cba146c","t":"少年游","a":"赵师侠","d":"宋","g":"词","p":["冰霜凝冻腊残时。","暖律渐推移。","彩胜罗幡，土牛春杖，和气与春回。","花心柳眼知时节，微露向阳枝。","喜入新春，称心百事，如意想都宜。"],"s":"simp","f":"trad"},{"i":"c-5751cf0dfd18","t":"小重山","a":"赵师侠","d":"宋","g":"词","p":["乐岁农家喜夜春。","朝来收宿雾，快新晴。","云移日转午风轻。","香罗薄，喧暖困游人。","积水满春塍。","绿波翻郁郁，露秧针。","幸无离绪苦牵情。","烟林外，时听杜鹃声。"],"s":"simp","f":"trad"},{"i":"c-2b4b37ae9a27","t":"霜天晓角","a":"赵师侠","d":"宋","g":"词","p":["雨馀风劲。","雾重千山暝。","茅舍寒林相映。","分明是、图画景。","去程何日定。","天远长安近。","唤起新愁无尽。","全没个、故园信。"],"s":"simp","f":"trad"},{"i":"c-da38e2aebf07","t":"霜天晓角","a":"赵师侠","d":"宋","g":"词","p":["舣舟砂碛。","秋净波澄碧。","极目青山横远，悬崖断、拥苍壁。","傍岩渔艇集。","渡头人物立。","八景潇湘真画，云笼日、晚风急。"],"s":"simp","f":"trad"},{"i":"c-2cf4c58d98eb","t":"江南好・忆江南","a":"赵师侠","d":"宋","g":"词","p":["天共水，水远与天连。","天净水平寒月漾，水光月色两相兼。","月映水中天。","人与景，人景古难全。","景若佳时心自快，心远乐处景应妍。","休与俗人言。"],"s":"simp","f":"trad"},{"i":"c-c4a44a699aeb","t":"关河令・清商怨","a":"赵师侠","d":"宋","g":"词","p":["亭皋霜重飞叶满。","听西风断雁。","闲凭危阑，斜阳红欲敛。","行人归期太晚。","误仿佛、征帆几点。","水远连天，愁云遮望眼。"],"s":"simp","f":"trad"},{"i":"c-daefa83af53d","t":"关河令・清商怨","a":"赵师侠","d":"宋","g":"词","p":["江头伊轧动柔橹。","渐楚天欲暮。","浩荡轻鸥，波间自容与。","岸蓼汀苹无绪。","更满目、潇疏江树。","此意何穷，凭谁图画取。"],"s":"simp","f":"trad"},{"i":"c-3327c02fcb5d","t":"采桑子","a":"赵师侠","d":"宋","g":"词","p":["连朝雨骤驱春去，瓦注盆倾。","不记初春。","润柳催花忒有情。","春光解有重来日，宁耐休争。","待得秋深。","听你无聊点滴声。"],"s":"simp","f":"trad"},{"i":"c-bed34218100a","t":"采桑子","a":"赵师侠","d":"宋","g":"词","p":["梅花谢后樱花绽，浅浅匀红。","试手天工。","百卉千葩一信通。","馀寒未许开舒妥，怨雨愁风。","结子筠笼。","万颗匀圆讶许同。"],"s":"simp","f":"trad"},{"i":"c-72b562930ed4","t":"浪淘沙","a":"赵师侠","d":"宋","g":"词","p":["绛萼衬轻红。","缀簇玲珑。","夭桃繁李一时同。","独向枝头春意闹，娇倚东风。","飞片入帘栊。","粉淡香浓。","凤箫声断月明中。","只恐明朝风雨恶，燕嘴泥融。"],"s":"simp","f":"trad"},{"i":"c-6800215abb94","t":"浪淘沙","a":"赵师侠","d":"宋","g":"词","p":["桃萼正芳菲。","初占春时。","蒸霞灿锦望中迷。","斜出繁枝临曲沼，鸾鉴妆迟。","蜂蝶镇相依。","天气融怡。","空教追忆武陵溪。","片片漫随流水去，风暖烟霏。"],"s":"simp","f":"trad"},{"i":"c-1f13d1761fea","t":"浪淘沙","a":"赵师侠","d":"宋","g":"词","p":["摇曳万丝风。","轻染烟浓。","鹅黄初褪绿茸茸。","雨洗云娇春向晚，雪絮空濛。","车马灞桥中。","别绪匆匆。","只知攀折怨西东。","不道晓风残月岸，离恨无穷。"],"s":"mixed","f":"trad"},{"i":"c-8a5264fdadf8","t":"双头莲令","a":"赵师侠","d":"宋","g":"词","p":["太平和气兆嘉祥。","草木总成双。","红苞翠盖出横塘。","两两斗芬芳。","干摇碧玉并青房。","仙髻拥新妆。","连枝不解引鸾皇。","留取映鸳鸯。"],"s":"simp","f":"trad"},{"i":"c-8bb4eeb5a5d2","t":"画堂春","a":"赵师侠","d":"宋","g":"词","p":["西真仙子宴瑶池。","素裳琼艳冰肌。","瑞笼香雾扑铢衣。","凤翥鸾飞。","玉骨解凌风露，铅华不涴凝脂。","戍楼羌管正孤吹。","月淡烟低。"],"s":"simp","f":"trad"},{"i":"c-af3ca972a49c","t":"南柯子・南歌子","a":"赵师侠","d":"宋","g":"词","p":["木落千山瘦，风微一水澄。","清霜暖日快归程。","唤渡沙头、款款话离情。","傍岸渔舟集，横空雁字轻。","凭阑凝望眼增明。","一片潇湘、真个画难成。"],"s":"simp","f":"trad"},{"i":"c-462e44f8973f","t":"西江月","a":"赵师侠","d":"宋","g":"词","p":["笳鼓旌旗改色，弓刀铠甲增明。","攒花簇队马蹄轻。","禀听元戎号令。","羊祐轻裘临阵，亚夫细柳屯营。","观瞻已耸定王城。","飞虎威名日振。"],"s":"simp","f":"trad"},{"i":"c-c8306e56a656","t":"西江月","a":"赵师侠","d":"宋","g":"词","p":["淼淼澄清波面，依依紫翠山光。","危栏徙倚对斜阳。","山影波流荡漾。","世事一番醒醉，人生几度炎凉。","高情收拾付觥觞。","何止羲皇人上。"],"s":"simp","f":"trad"},{"i":"c-d99e58efb0a8","t":"洞仙歌","a":"赵师侠","d":"宋","g":"词","p":["元宵三五。","正好嬉游去。","梅柳蛾蝉斗济楚。","换鞋儿、添头面，只等黄昏，恰恨有、些子无情风雨。","心忙腹热，没顿浑身处。","急把灯台炙艾炷。","做匙婆、许葱油，麦灰画葫芦，更漏转，越㬠不停不住。","待归去、尤自意迟疑，但无语空将，眼儿厮觑。"],"s":"simp","f":"trad"},{"i":"c-166f666884af","t":"南乡子","a":"赵师侠","d":"宋","g":"词","p":["元夜景尤殊。","万斛金莲照九衢。","锤拍豉汤都卖得，争如。","甘露杯中万颗珠。","应是著功夫。","脑麝浓薰费小厨。","不比七夕黄蜡做，知无。","要底圆儿糖上浮。"],"s":"simp","f":"trad"},{"i":"c-f40ceb5b22ac","t":"行香子","a":"赵师侠","d":"宋","g":"词","p":["春日迟迟。","春景熙熙。","渐郊原、芳草萋萋。","夭桃灼灼，杨柳依依。","见燕喃喃，蜂簇簇，蝶飞飞。","闲庭寂寂，曲沼漪漪。","更秋千、红索垂垂。","游人队队，乐意嬉嬉。","尽醉醺醺，歌缓缓，语低低。"],"s":"simp","f":"trad"},{"i":"c-7198ca6c5502","t":"卜算子","a":"赵师侠","d":"宋","g":"词","p":["晴日敛春泥，陌上东风软。","料峭寒禁花柳闲，枉恨春工浅。","绿涨一江深，黛泼千山远。","目断平芜无际愁，数尽征鸿点。"],"s":"simp","f":"trad"},{"i":"c-3e636315ce2d","t":"卜算子","a":"赵师侠","d":"宋","g":"词","p":["杨柳褪金丝，艳杏摇红影。","欲雨还晴二月天，春色浑无定。","晓梦不堪惊，午昼新来永。","一掬归心万叠愁，空惹长亭恨。"],"s":"simp","f":"trad"},{"i":"c-b2198182e0c5","t":"卜算子","a":"赵师侠","d":"宋","g":"词","p":["娇艳醉杨妃，轻袅怜飞燕。","人在昭阳睡足时，初试妆深浅。","一段锦新裁，万里来何远。","高烛休教照夜寒，媚脸融春艳。"],"s":"simp","f":"trad"},{"i":"c-abe191fda337","t":"卜算子","a":"赵师侠","d":"宋","g":"词","p":["绿暗柳藏烟，红淡花经雨。","更著如花似玉人，艳态娇波注。","纤手捧瑶卮，缓遏歌云缕。","只恐莺花不解留，还逐东风去。"],"s":"simp","f":"trad"},{"i":"c-ffee60c76e7b","t":"卜算子","a":"赵师侠","d":"宋","g":"词","p":["云敛料寒轻，雨涨春波渺。","旅枕无堪梦易惊，啼鴂声催晓。","尚忆故园花，红紫为容好。","世路崎岖长短亭，来往何时了。"],"s":"simp","f":"trad"},{"i":"c-c2a4dce8e026","t":"伊州三台","a":"赵师侠","d":"宋","g":"词","p":["桂华移自云岩。","更被灵砂染丹。","清露湿酡颜。","醉乘风、下临世间。","素娥襟韵萧闲。","不与群芳并看。","蔌蔌绛绡单。","觉身轻、梦回广寒。"],"s":"simp","f":"trad"},{"i":"c-cea74cf4a9a2","t":"水调歌头","a":"陈亮","d":"宋","g":"词","p":["不见南师久，谩说北群空。","当场只手，毕竟还我万夫雄。","自笑堂堂汉使，得似洋洋河水，依旧只流东。","且复穹庐拜，会向藁街逢。","尧之都，舜之壤，禹之封。","於中应有，一个半个耻臣戎。","万里腥膻如许，千古英灵安在，磅礴几时通。","胡运何须问，赫日自当中。"],"s":"mixed","f":"trad"},{"i":"c-a30475ed70ae","t":"念奴娇","a":"陈亮","d":"宋","g":"词","p":["江南春色，算来是、多少胜游清赏。","妖冶廉纤，只做得，飞鸟向人偎傍。","地辟天开，精神朗慧，到底还京样。","人家小语，一声声近清唱。","因念旧日山城，个人如画，已作州中想。","邓禹笑人无限也，冷落不堪惆怅。","秋水双明，高山一弄，著我些悲壮。","南徐好住，片帆有分来往。"],"s":"simp","f":"trad"},{"i":"c-eb05f63b4e1e","t":"贺新郎","a":"陈亮","d":"宋","g":"词","p":["修竹更深处。","映帘栊、清阴障日，坐来无暑。","水激泠泠如何许。","跳碎危栏玉树。","都不系、人间朝暮。","东阁少年今老矣，况樽中有酒嫌推去。","犹著我，明流语。","大家绿野陪容与。","算等闲、过了薰风，又还商素。","手弄柔条人健否，尤忆当时雅趣。","恩未报、恐成辜负。","举目江河休感涕，念有君如此何愁虏。","歌未罢，谁来舞。"],"s":"simp","f":"trad"},{"i":"c-7e06ef8f8d9a","t":"满江红","a":"陈亮","d":"宋","g":"词","p":["曾洗乾坤，问何事、雄图顿屈。","试著眼、阶除当下，又添英物。","北向争衡幽愤在，南来遗恨狂酋失。","算凄凉部曲几人存，三之一。","诸老尽，郎君出。","恩未报，家何恤。","念横飞直上，有时还戢。","笑我只知存饱暖，感君元不论阶级。","休更上百尺旧家楼，尘侵帙。"],"s":"simp","f":"trad"},{"i":"c-102c0201e4c5","t":"桂枝香","a":"陈亮","d":"宋","g":"词","p":["天高气肃。","正月色分明，秋容新沐。","桂子初收，三十六宫都足。","不辞散落人间去，怕群花、自嫌凡俗。","向他秋晚，唤回春意，几曾幽独。","是天上、馀香剩馥。","怪一树香风，十里相续。","坐对花旁，但见色浮金粟。","芙蓉只解添秋思，况东篱、凄凉黄菊。","入时太浅，背时太远，爱寻高躅。"],"s":"simp","f":"trad"},{"i":"c-e6ccd19f2e2e","t":"三部乐","a":"陈亮","d":"宋","g":"词","p":["小屈穹庐，但二满三平，共劳均佚。","人中龙虎，本为明时而出。","只合是、端坐王朝，看指挥整办，扫荡飘忽。","也持汉节，聊过旧家宫室。","西风又还带暑，把征衫著上，有时披拂。","休将看花泪眼，闻弦□骨。","对遗民、有如皎日。","行万里、依然故物。","入奏几策，天下里、终定于一。"],"s":"simp","f":"trad"},{"i":"c-361b576a22e8","t":"水调歌头","a":"陈亮","d":"宋","g":"词","p":["人物从来少，篱菊为谁黄。","去年今日，倚楼还是听行藏。","未觉霜风无赖，好在月华如水，心事楚天长。","讲论参洙泗，杯酒到虞唐。","人未醉，歌宛转，兴悠扬。","太平胸次，笑他磊磈欲成狂。","且向武夷深处，坐对云烟开敛，逸思如微茫。","我欲为君寿，何许得新腔。"],"s":"simp","f":"trad"},{"i":"c-6d56b7a1a592","t":"念奴娇","a":"陈亮","d":"宋","g":"词","p":["危楼远望，叹此意、今古几人曾会。","鬼设神施，浑认作、天限南疆北界。","一水横陈，莲岗三面，做出争雄势。","六朝何事，只成门户私计。","因笑王谢诸人，登高怀远，也学英雄涕。","凭却长江管不到，河洛腥膻无际。","正好长驱，不须反顾，寻取中流誓。","小儿破贼，势成宁问疆场。"],"s":"simp","f":"trad"},{"i":"c-66e0c5b4af79","t":"贺新郎","a":"陈亮","d":"宋","g":"词","p":["老去凭谁说。","看几番、神奇臭腐，夏裘冬葛。","父老长安今馀几，后死无仇可雪。","犹未燥、当时生发。","二十五弦多少恨，算世间、那有平分月。","胡妇弄，汉宫瑟。","树犹如此堪重别。","只使君、从来与我，话头多合。","行矣置之无足问，谁唤妍皮痴骨。","但莫使、伯牙弦绝。","九转丹砂牢拾取，管精金、只是寻常铁。","龙共虎，应声裂。"],"s":"simp","f":"trad"},{"i":"c-e4d7a0c2e730","t":"瑞云浓慢","a":"陈亮","d":"宋","g":"词","p":["蔗浆酪粉，玉壶冰醑，朝罢更闻宣赐。","去天咫尺，下拜再三，幸今有母可遗。","年年此日，共道月入怀中最贵。","向暑天，正风云会遇，有恁嘉瑞。","鹤冲霄，鱼得水。","一超便、直入神仙地。","植根江表。","开拓两河，做得黑头公未。","骑鲸赤手，问如何、长鞭尺箠。","向来王谢风流，只今管是。"],"s":"simp","f":"trad"},{"i":"c-807a2ddfe2b9","t":"阮郎归","a":"陈亮","d":"宋","g":"词","p":["波光渺渺浸晴陂。","有亭湖岸西。","芰荷香拂柳丝垂。","升堂献寿卮。","红约腕，绿侵衣。","愿祝届期颐。","花间妙语欲无诗。","一年歌一词。"],"s":"simp","f":"trad"},{"i":"c-cc07dff841b6","t":"祝英台近","a":"陈亮","d":"宋","g":"词","p":["驾扁舟，冲剧暑。","千里江上去。","夜宿晨兴，一一旧时路。","百年望了旬头，被人馋破，故纸里、是争雄处。","怎生诉。","欲待细与分疏，其如有凭据。","包裹生鱼，活底怎遭遇。","相逢樽酒何时，征衫容易，君去也、自家须住。"],"s":"simp","f":"trad"},{"i":"c-899dcd38d155","t":"蝶恋花","a":"陈亮","d":"宋","g":"词","p":["手拈黄花还自笑。","笑比渊明，莫也归来早。","随世功名浑草草。","五湖却共繁华老。","冷淡家生冤得道。","旖旎妖娆，春梦如今觉。","管个岁华须到了。","此花之后花应少。"],"s":"simp","f":"trad"},{"i":"c-b598b31b9cd3","t":"水调歌头","a":"陈亮","d":"宋","g":"词","p":["人爱新来景，龙认旧时湫。","不论三伏，小住便觉凛生秋。","我自醉眠其上，任是水流其下，湍激若为收。","世事如斯去，不去为谁留。","本无心，随所寓，触虚舟。","东山始末，且向灵洞与沈浮。","料得神仙窟穴，争似提封万里，大小几琉球。","但有君才具，何用问时流。"],"s":"mixed","f":"trad"},{"i":"c-ad50a68c80f9","t":"念奴娇","a":"陈亮","d":"宋","g":"词","p":["西风带暑，又还是、长途利牵名役。","我已无心，君因甚，更把青衫为客。","邂逅卑飞，几时高举，不露真消息。","大家行处，到头须管行得。","何处寻取狂徒，可能著意，更问渠侬骨。","天上人间，最好是、闹里一般岑寂。","瀛海无波，玉堂有路，稳著青霄翼。","归来何事，眼光依旧生碧。"],"s":"simp","f":"trad"},{"i":"c-a4bb0a606515","t":"卜算子","a":"陈亮","d":"宋","g":"词","p":["悄静菊花天，洗尽梧桐雨。","倍九周遭烂熳开，祝寿当头取。","顶戴玉袍黄，叠秀金棱吐。","仙种花容晚节香，人愿争先睹。"],"s":"simp","f":"trad"},{"i":"c-f9d3bfa2ad66","t":"贺新郎","a":"陈亮","d":"宋","g":"词","p":["离乱从头说。","爱吾民，金缯不爱，蔓藤累葛。","壮气尽消人脆好，冠盖阴山观雪。","亏杀我，一星星发。","涕出女吴成倒转，问鲁为齐弱何年月。","丘也幸，由之瑟。","斩新换出旗麾别。","把当时、一椿大义，拆开收合。","据地一呼吾往矣，万里摇肢动骨。","这话霸、又成痴绝。","天地洪炉谁扇韛，算於中、安得长坚铁。","淝水破，关东裂。"],"s":"mixed","f":"trad"},{"i":"c-61ec8d67a06a","t":"垂丝钓","a":"陈亮","d":"宋","g":"词","p":["菊花细雨。","萧萧红蓼汀渚。","景物渐幽，风致如许。","秋未暮。","又值吾初度。","看天宇。","正澄清欲往，登高未也，红尘当面飞舞。","几人吊古。","乌帽牢收取。","短发还羞觑。","遐寿身、近五云深处。"],"s":"simp","f":"trad"},{"i":"c-043ef5cb3125","t":"彩凤飞","a":"陈亮","d":"宋","g":"词","p":["人立玉，天如水，特地如何撰。","海南沈烧著，欲寒犹暖。","算从头，有多少、厚德阴功，人家上，一一旧时香案。","□煞经惯。","小驻吾舟才尔，依然欢声满。","莫也教、公子王孙眼见。","这些儿、颖脱处，高出书卷。","经纶自入手，不了判断。"],"s":"simp","f":"trad"},{"i":"c-babe9285b8fa","t":"鹧鸪天","a":"陈亮","d":"宋","g":"词","p":["落魄行歌记昔游。","头颅如许尚何求。","心肝吐尽无馀事，口腹安然岂远谋。","才怕暑，又伤秋。","天涯梦断有书不。","大都眼孔新来浅，羡尔微官作计周。"],"s":"simp","f":"trad"},{"i":"c-709ede8527c6","t":"谒金门","a":"陈亮","d":"宋","g":"词","p":["新雨足。","洗尽山城袢褥。","见说好峰三十六。","峰峰如立玉。","四海英游追逐。","事业相时伸缩。","入境德星须做福。","只愁金诏趣。"],"s":"simp","f":"trad"},{"i":"c-f1f47b3082ff","t":"天仙子","a":"陈亮","d":"宋","g":"词","p":["一夜秋光先著柳。","暑力平明羞失守。","西风不放入帘帏，饶永昼。","沈烟透。","半月十朝秋定否。","指点芙蕖凝伫久。","高处成莲深处藕。","百年长共月团圆，女进男，酒称寿。","一点浮云人似旧。"],"s":"simp","f":"trad"},{"i":"c-3fbea9e5c1a5","t":"水调歌头","a":"陈亮","d":"宋","g":"词","p":["事业随人品，今古几麾旌。","向来谋国，万事尽出汝书生。","安识鲲鹏变化，九万里风在下，如许上南溟。","斥鷃旁边笑，河汉一头倾。","叹世间，多少恨，几时平。","霸图消歇，大家创见又成惊。","邂逅汉家龙种，正尔乌纱白纻，驰骛觉身轻。","樽酒从渠说，双眼为谁明。"],"s":"simp","f":"trad"},{"i":"c-01d6951c986b","t":"洞仙歌","a":"陈亮","d":"宋","g":"词","p":["秋容一洗，不受凡尘涴。","许大乾坤这回大。","向上头，些子是雕鹗抟空，篱底下，只有黄花几朵。","骑鲸汗慢，那得人同坐。","赤手丹心扑不破。","问唐虞、禹汤文武，多少功名，犹自是、一点浮云铲过。","且烧却、一瓣海南沈，任拈取、千年陆沈奇货。"],"s":"simp","f":"trad"}]