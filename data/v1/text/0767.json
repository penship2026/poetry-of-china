[{"i":"c-5cb42779712f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["离情愁思，尽分付、眉头眼底。"]},{"i":"c-d4d028003c3e","t":"于飞乐","a":"无名氏","d":"宋","g":"词","p":["教我莫思量，争不思量。"]},{"i":"c-9da09bad11d4","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["兽炉烟断，残烛照庭帏。"]},{"i":"c-e2e856bf70b8","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["鸳鸯鸥鹭，浴乱一池春碧。"]},{"i":"c-dc368a1557d2","t":"真珠帘","a":"无名氏","d":"宋","g":"词","p":["把酒祝东君，愿与花枝长为主。"]},{"i":"c-6ca957a6a985","t":"武陵春","a":"无名氏","d":"宋","g":"词","p":["柳绿花红春烂熳。"]},{"i":"c-d951d3246625","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["断肠屈曲屏山。"]},{"i":"c-0a6492bc98b2","t":"洞仙歌","a":"无名氏","d":"宋","g":"词","p":["独拥香衾一半。"]},{"i":"c-764fa66eafd3","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["蹙损两眉峰。"]},{"i":"c-09c068f85f59","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["添憔悴、看肌瘦损。"]},{"i":"c-dfeba2e0a004","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["细雨乱如毛。"]},{"i":"c-11a3e20e784e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["恨江南塞北，鱼沈雁杳，空肠断、书难寄。"]},{"i":"c-edcf2043d4dd","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["去不远，路无多。"]},{"i":"c-dd4a8b33a3c6","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["尽啜情一饱，泪珠弹子重搵，背人睡也。"]},{"i":"c-b964b33fd3d2","t":"卜算子","a":"无名氏","d":"宋","g":"词","p":["你为情多泪亦多。"]},{"i":"c-e1cb9cd707e1","t":"阮郎归","a":"无名氏","d":"宋","g":"词","p":["无心傍照台。"]},{"i":"c-77e5ec4fb032","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["巧画远山眉。"]},{"i":"c-78d3cbec5245","t":"于飞乐","a":"无名氏","d":"宋","g":"词","p":["天然体段殊常。"]},{"i":"c-c845aa7e3c39","t":"声声令・胜胜令","a":"无名氏","d":"宋","g":"词","p":["未怕飞燕似轻盈。"]},{"i":"c-6dd9e9fa2eda","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["须教相并檐前望，被飞絮、扑簌香腮。"]},{"i":"c-7f3e53723763","t":"定风波","a":"无名氏","d":"宋","g":"词","p":["古鼎龙涎香犹喷。"]},{"i":"c-ec2be37319fa","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["烛暗时酒醒，原来又是梦里。"]},{"i":"c-f36f72df788f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["为谁瘦、为谁癯。"]},{"i":"c-dcbd82c98884","t":"喜迁莺","a":"无名氏","d":"宋","g":"词","p":["芳春天晓。","听绿树、数声如簧莺巧。"]},{"i":"c-3c66d6d32c79","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["花外风传漏永，鸯鸳暖、金鸭香浓。"]},{"i":"c-27b5289ac2d3","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["香阁寂寥。"]},{"i":"c-c2bf9415dcc2","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["清明将近春时节。"]},{"i":"c-054965fa6c7d","t":"一落索","a":"无名氏","d":"宋","g":"词","p":["倚楼一霎酒旗风。"]},{"i":"c-ff333182d5ea","t":"如梦令","a":"无名氏","d":"宋","g":"词","p":["不暖不寒天，春色恰倚人意。"]},{"i":"c-066347a2c573","t":"庆青春","a":"无名氏","d":"宋","g":"词","p":["平明一阵催花雨"]},{"i":"c-585effa0d7ad","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["悄无人语重帘卷。"]},{"i":"c-03a0e9ad80c8","t":"夏云峰","a":"无名氏","d":"宋","g":"词","p":["昨日看花花正好，枝枝香嫩红殷。"]},{"i":"c-ce63e26cb0b6","t":"粉蝶儿","a":"无名氏","d":"宋","g":"词","p":["共双双飞入，乱红深处。"]},{"i":"c-aed563891139","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["往事旧游浑似梦。"]},{"i":"c-4b22db234188","t":"拜星月・拜星月慢","a":"无名氏","d":"宋","g":"词","p":["贺新春，尽带春花、春旛春胜，是处春光明媚。"]},{"i":"c-4f6c048b9af7","t":"诉衷情","a":"无名氏","d":"宋","g":"词","p":["悠悠万里云水。"]},{"i":"c-363ace5c302d","t":"洞仙歌","a":"无名氏","d":"宋","g":"词","p":["今夜谁添一种愁。"]},{"i":"c-2a6ace13ec6e","t":"御街行","a":"无名氏","d":"宋","g":"词","p":["夜深无语楼空倚。"]},{"i":"c-cd46558ef5f9","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["淡红衫，缕金裙。"]},{"i":"c-d19fd44d273c","t":"浣溪沙","a":"无名氏","d":"宋","g":"词","p":["水阁池亭自有凉。"]},{"i":"c-b62ee7edaa05","t":"小重山","a":"无名氏","d":"宋","g":"词","p":["水风生处小亭临。"]},{"i":"c-455b9efba784","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["西风渐冷，园林万木凋黄。"]},{"i":"c-14268cf3f6cb","t":"念奴娇","a":"无名氏","d":"宋","g":"词","p":["玲珑枝枝，斗妆金粟。"]},{"i":"c-fff317dfb521","t":"念奴娇","a":"无名氏","d":"宋","g":"词","p":["万里秋容浩荡。"]},{"i":"c-8255f0043566","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["枕上偷垂泪眼流。"]},{"i":"c-7d8e73f5db0b","t":"惜黄花","a":"无名氏","d":"宋","g":"词","p":["庭梧叶坠。"]},{"i":"c-9345f3d0afc8","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["等得秋风满院吹。","又争如、毒热时。","被唧唧啾啾，不教人来梦里，望前程也、促织儿。"]},{"i":"c-3c8dfbe57627","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["只为情多病也多，省可思量我。"]},{"i":"c-54a176306468","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["蟾辉兔影十分满。"]},{"i":"c-36e767b4c962","t":"念奴娇","a":"无名氏","d":"宋","g":"词","p":["对景真奇绝。"]},{"i":"c-93ec05e154be","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["砌畔蛩吟喧不住。"]},{"i":"c-aa7b112b5ecd","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["梧桐叶落雨潇潇。"]},{"i":"c-d0ce407047cc","t":"眼儿媚","a":"无名氏","d":"宋","g":"词","p":["厌厌愁闷无情绪。"]},{"i":"c-98ada5ce595e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["好容仪、取次梳妆。"]},{"i":"c-3283c11b274c","t":"青玉案","a":"无名氏","d":"宋","g":"词","p":["彤云黯黯寒云绕。"]},{"i":"c-1f7ec253517e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["小窗幽幌，独坐都无侣。"]},{"i":"c-004220b9e6e8","t":"祝英台近","a":"无名氏","d":"宋","g":"词","p":["每爱霜月风前。"]},{"i":"c-b6b429575595","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["泪珠弹了。"]},{"i":"c-e2b1adee3ade","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["飞花剪、六出工夫。"]},{"i":"c-ed81226c462e","t":"永遇乐","a":"无名氏","d":"宋","g":"词","p":["有限光阴。"]},{"i":"c-912006dbc2f4","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["倾城颜色。"]},{"i":"c-f7814b2eb111","t":"念奴娇","a":"无名氏","d":"宋","g":"词","p":["绝艳仍清淑。"]},{"i":"c-d30b197a562b","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["满池荷叶动秋风。"]},{"i":"c-866d3ea70964","t":"玉抱肚","a":"无名氏","d":"宋","g":"词","p":["园林草木，迤逦凋残。"]},{"i":"c-190a2c152bd3","t":"卜算子","a":"无名氏","d":"宋","g":"词","p":["借问陇头梅，春信还知否。"]},{"i":"c-c6a834952b32","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["光景如梭。"]},{"i":"c-9c95b55ae922","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["酒入柔肠似泪流。"]},{"i":"c-1d481102501d","t":"导引","a":"无名氏","d":"宋","g":"词","p":["民康俗阜，万国乐升平。","庆海晏河清。","唐尧禹舜垂衣化，讵比我皇明。","九天宝命垂丕贶，云物效祥英。","星罗羽卫登乔岳，亲告禅云亭。","我皇垂拱，惠化洽文明。","盛礼庆重行。","登封降禅燔柴毕，天仗入神京。","云雷布泽遍寰瀛。","遐迩振欢声。","巍巍圣寿南山固，千载贺承平。"]},{"i":"c-87e88ad52543","t":"六州","a":"无名氏","d":"宋","g":"词","p":["良夜永，玉漏正迟迟。","丹禁肃，周庐列，羽卫绕皇闱。","严鼓动，画角声齐。","金管飘雅韵，远逐轻飔。","荐嘉玉、躬祀神祗。","祈福为黔黎。","升中盛礼，增高益厚，登封检玉，时迈合周诗。","玄文锡，庆云五色相随。","甘露降，醴泉涌，三秀发灵芝。","皇犹播、史册光辉。","受鸿禧。","万年永固丕基。","吾君德、荡荡巍巍。","迈尧舜文思。","从今寰宇，休牛归马，耕田凿井，鼓腹乐昌期。"]},{"i":"c-1ebf4c58f66e","t":"十二时・忆少年","a":"无名氏","d":"宋","g":"词","p":["圣明代，海县澄清。","惠化洽寰瀛。","时康岁足，治定功成。","遐迩贺升平。","嘉坛上，昭事神灵。","荐明诚。","报本禅云亭。","俎豆列牺牲。","宸心蠲洁，明德荐惟馨。","纪鸿名。","千载播天声。","燔柴毕，云罕回仙仗，庆鸾辂还京。","八神扈跸，四隩来庭。","嘉气覆重城。","殊常礼，旷古难行。","遇文明。","仁恩苏品汇，沛泽被簪缨。","祥符锡祚，武库永销兵。","育群生。","景运保千龄。"]},{"i":"c-34a0f1ecd5b3","t":"导引","a":"无名氏","d":"宋","g":"词","p":["明明我后，至德合高穹。","祗翼励精衷。","上真紫殿回飚驭，示圣胄延鸿。","躬承宝训表钦崇。","庆泽布寰中。","告虔备物朝清庙，荷景福来同。"]},{"i":"c-f8c57cc3d0e6","t":"导引","a":"无名氏","d":"宋","g":"词","p":["穹旻锡祐，盛德日章明。","见地平天成。","垂衣恭己干戈偃，亿载祐黎甿。","羽旄饰驾当春候，款谒届殊庭。","精衷昭感膺多福，夷夏保咸宁。","圣君御宇，祗翼奉三灵。","已偃革休兵。","区中海外鸿禧浃，恭馆励虔诚。","九斿七萃著声明。","徯后徇舆情。","丕图宝绪承繁祉，率土仰隆平。"]},{"i":"c-2f56300ced92","t":"六州","a":"无名氏","d":"宋","g":"词","p":["千载运，宝业正遐昌。","钦至道，崇明祀，盛礼迈前王。","銮辂动，万骑腾骧。","驰道纷彩仗，瑞日煌煌。","奉秘检、玉羽群翔。","非雾满康庄。","躬朝真馆，齐心绎思，顺风俯拜，奠酒爇萧芗。","精衷达，飚轮降格昭彰。","回羽旆，驻雕辇，旧地访睢阳。","亭清庙、孝德辉光。","届灵场。","星罗万国珪璋。","陈牲币、金石锵洋。","景福降穰穰。","垂衣法坐，恩覃群品，庆均海宇，圣寿保无疆。"]},{"i":"c-ddb0fa032d07","t":"十二时・忆少年","a":"无名氏","d":"宋","g":"词","p":["乾坤泰，帝祚遐昌。","宇县乐平康。","真游降格，宝诲昭彰。","宸跸造仙乡。","崇妙道、精意齐庄。","款灵场。","洁豆荐芬芳。","备乐奏铿锵。","犹龙垂裕，千古播休光。","极褒阳。","明号洽徽章。","朝修展，春豫谐民望。","睹文物煌煌。","言旋羽卫，肃设坛场。","报本达萧芗。","申严祀、礼备烝尝。","答穹苍。","纯禧沾品汇，庆赉浃穷荒。","封人献寿，德化掩陶唐。","保绵长。","锡祐永无疆。"]},{"i":"c-442cb3f3048e","t":"导引","a":"无名氏","d":"宋","g":"词","p":["秘文镂玉，金阁奉安时。","旌盖俨仙仪。","珠旒俯拜陈章奏，精意达希夷。","卿云郁郁曜晨曦。","玉羽拂华枝。","灵心报贶垂繁祉，宝祚永隆熙。"]},{"i":"c-4d008241c3fa","t":"导引","a":"无名氏","d":"宋","g":"词","p":["躬朝太室，列圣大功宣。","彩仗耀甘泉。","秘文升辂空歌发，一路覆祥烟。","珠旒荐献极精虔。","列侍俨貂蝉。","穰穰降福均寰宇，垂拱万斯年。"]},{"i":"c-aa2b01f1d8e0","t":"导引","a":"无名氏","d":"宋","g":"词","p":["重熙累盛，睿化畅真风。","尊祖奉高穹。","林棼彩仗明初日，瑞气满晴空。","玉銮徐动出环宫。","虔巩罄宸衷。","礼成均庆人神悦，圣寿保无穷。"]},{"i":"c-7d7746037fa2","t":"六州","a":"无名氏","d":"宋","g":"词","p":["承天统，圣主应昌辰。","宝箓降，飚游至，瑞命庆惟新。","崇大号，仰奉高真。","献岁当初吉，天下皆春。","谒秘宇、藻卫星陈。","芗霭极纷纶。","琼编焜耀，仙衣綷□，垂旒俯拜，荐献礼惟寅。","芬芳备，精衷上达穹旻。","尊道祖，享清庙，助祭万方臻。","升泰畤、缛典弥文。","侍群臣。","汉庭儒雅彬彬。","烟飞火举毕严禋。","天地降氤氲。","高临华阙，恩覃动植，庆延宗社，圣寿比灵椿。"]},{"i":"c-63127f3a69d9","t":"十二时・忆少年","a":"无名氏","d":"宋","g":"词","p":["享嘉会，万宇欢康。","圣化迈陶唐。","元符锡命，天鉴昭彰。","徽号奉琳房。","陈缛礼、献岁惟良。","耀旗章。","翠辇驻仙乡。","睿意极齐庄。","仙衣渥采，玉册共荧煌。","荐芬芳。","飚驭降灵场。","回云罕，尊祖趋仙宇，金石韵锵洋。","聿朝清庙，躬奠瑶觞。","报本国之阳。","执笾豆、列侍貂珰。","对穹苍。","洪恩霈夷夏，大庆浃家邦。","垂衣紫极，圣寿保遐昌。","集祺祥。","地久与天长。"]},{"i":"c-ca0fd5dbbaed","t":"导引","a":"无名氏","d":"宋","g":"词","p":["我皇缵位，覆焘合穹旻。","秘箓示灵文。","齐居紫殿膺玄贶，降宝命氤氲。","奉符让德事严禋。","检玉陟天孙。","垂鸿纪号光前古，迈八九为君。","灵台偃武，书轨庆同文。","奄六合居尊。","圆穹锡命垂真箓，清晓降金门。","升中报本禅云云。","严祀事惟寅。","无为致治臻清净，见反朴还淳。"]},{"i":"c-d11161318c8b","t":"导引","a":"无名氏","d":"宋","g":"词","p":["宝图熙盛，登格圣功全。","瑞命集灵篇。","钦修祀典成明察，道祖降云軿。","赖乡真馆宅真仙。","朝谒帝心虔。","尊崇教父膺鸿福，绵互万斯年。","犹龙胜境，真宇俨灵姿。","肃谒展皇仪。","宝符先路嘉祥应，云物焕金枝。","纷纭紫节间黄麾。","藻卫极葳蕤。","高穹报贶延休祉，仁寿协昌期。"]},{"i":"c-ab0126e5319b","t":"导引","a":"无名氏","d":"宋","g":"词","p":["紫霄金阙，重叠降元符。","亿兆祚皇图。","云章焜耀傅温玉，宝阁起清都。","奉迎彩仗溢天衢。","观者竟欢呼。","明君钦翼承鸿阴，亿载御中区。","宝符锡祚，庆寿命维新。","俄降格飚轮。","巍巍帝德增虔奉，懿号蔫穹旻。","精齐秘馆奉严禋。","文物耀昌辰。","升烟太一修郊报，鸿祉介烝民。"]},{"i":"c-08ec10add8b2","t":"导引","a":"无名氏","d":"宋","g":"词","p":["圣神缵绪，赫奕帝图昌。","宝录降穹苍。","宸心励翼修郊报，彩仗列康庄。","祥烟瑞霭杂天香。","管磬发声长。","升坛礼毕膺繁祉，睿算保无疆。"]},{"i":"c-6967ece798f1","t":"导引","a":"无名氏","d":"宋","g":"词","p":["太霄玉帝，总御冠灵真。","威德耸天人。","宝文瑞命符皇运，绵远庆维新。","洞开霞馆法虚晨。","八景降飚轮。","含生普洽□鸿福，圣寿比仙椿。"]},{"i":"c-c0ee58514247","t":"导引","a":"无名氏","d":"宋","g":"词","p":["至真降鉴，飚驭下皇闱。","清漏正依依。","范金肖像申严奉，仙馆壮翬飞。","万灵拱卫瑞烟披。","岸柳映黄麾。","九清祚圣鸿基永，尧德更巍巍。"]},{"i":"c-35c6178f25ab","t":"导引","a":"无名氏","d":"宋","g":"词","p":["元符锡命，祗受庆诚明。","恭馆法三清。","开基盛烈垂无极，金像俨天成。","奉迎霞布甘泉仗，箫瑟振和声。","灵辰协吉鸿仪毕，万国保隆平。"]},{"i":"c-be16c413285b","t":"导引","a":"无名氏","d":"宋","g":"词","p":["膺乾抚运，垂庆洽重熙。","元圣嗣鸿基。","发挥宝绪灵仙降，感吉梦先期。","良金璀璨范真仪。","精意答蕃厘。","閟宫神馆崇严配，万祀播葳蕤。"]},{"i":"c-05e009fc224c","t":"导引","a":"无名氏","d":"宋","g":"词","p":["先天气祖，魄宝御中宸。","列位冠高真。","绿符锡瑞昭元圣，宝历互千春。","琳宫壮丽俯严闉。","璇碧照龙津。","珍金铸像灵仪睟，集福庇蒸民。"]},{"i":"c-d9f9e06dc1ac","t":"导引","a":"无名氏","d":"宋","g":"词","p":["仙宗灵祖，仪气降中宸。","孚宥庆维新。","国工熔范成金像，仪炳动威神。","玉虚圣境绝纤尘。","欢忭洽群伦。","导迎云驾归琳馆，恭肃奉高真。"]},{"i":"c-ecacf2a5b756","t":"导引","a":"无名氏","d":"宋","g":"词","p":["石文应瑞，真主御寰瀛。","慈俭抚群生。","巍巍威德超千古，大业保盈成。","神皋福地开恭馆，灵贶日昭明。","铸金九牧天仪睟，绀殿矗千楹。"]},{"i":"c-7fc6d8da95f0","t":"导引","a":"无名氏","d":"宋","g":"词","p":["乘云英圣，千载仰皇灵。","垂法蔼朝经。","禹金熔范肖仪刑。","日角焕珠庭。","琳宫翠殿凤文屏。","迎奉庆安宁。","孝思瞻谒荐惟馨。","诚悫贯青冥。"]},{"i":"c-fcbd9f6888c4","t":"导引","a":"无名氏","d":"宋","g":"词","p":["太霄垂佑，绵宇洽祺祥。","秘检焕云章。","宸心虔奉崇徽号，茂典迈前王。","霞明藻卫列通庄。","宝册奉琳房。","都人震抃腾谣颂，亿载保欢康。"]},{"i":"c-843edeb43589","t":"导引","a":"无名氏","d":"宋","g":"词","p":["明明道祖，金阙冠仙真。","清禁降飙轮。","遥源始悟垂鸿庆，亿兆耸群伦。","虔崇徽号盛仪陈。","宝册奉良辰。","邦家亿载蒙繁祉，圣寿保无垠。"]},{"i":"c-6170489d783b","t":"导引","a":"无名氏","d":"宋","g":"词","p":["祖宗垂佑，亨会协重熙。","德泽被烝黎。","虔崇尊谥陈徽册，藻卫列葳蕤。","宸心致孝极孜孜。","展礼诏台司。","祥烟瑞霭浮清庙，绵宇被纯禧。"]},{"i":"c-01a9d16ae4fa","t":"导引","a":"无名氏","d":"宋","g":"词","p":["皇穹锡瑞，帝业愈蕃昌。","会万玉来王。","名山珍馆神游接，实信降云房。","卜兹显位严坛墠，奕奕睹辉光。","精衷昭格灵心答，天历保无疆。","皇家立极，炎德赫中区。","执契应萝图。","文章焕烂垂星斗，威略定方隅。","丹扉翠巘锡灵符。","瑞物纪神输。","紫坛大报陈昭配，福庆降清都。"]},{"i":"c-ca571f42e338","t":"六州","a":"无名氏","d":"宋","g":"词","p":["齐天宇，四海洽淳风。","接宝胄，垂真检，景祚无穷。","成玉牒、日观归功。","冀野升方鼎，脽上由崇。","钦桧井、云跸巡东。","国本震为宫。","乾文焕炳，真祠曲密，重祥叠瑞，琼蕴降高穹。","膺丕烈，虔心建垂鸿。","询吉士，郊兆执玉荐衷。","锺律应、云物迎空。","乐和轮囷。","嘉气葱葱。","天神来降发冲融。","玉烛四时通。","星回金辂雷作解，昆蚑被惠，亿载帝基隆。"]},{"i":"c-65ffd24ddebf","t":"十二时・忆少年","a":"无名氏","d":"宋","g":"词","p":["雕戈偃玉塞清明。","道德洽和平。","龟畴凤柙，腾实飞英。","岱畎让功成。","汾水上、寅辂銮声。","荐精诚。","仙宇玉为京。","圭洁奉高明。","瑶山银榜，固国本丕闳。","诏公卿。","绵蕝殉舆情。","稽阳位，报本郊坛畤，助祭俨簪缨。","祖宗配侑，朱燎晶荧。","百礼备丰盈。","答天地、用厚怀生。","泰黎氓。","千畿先润泽，万宝尽开荣。","龙沙日窟，文轨永来并。","保嘉享，史册焕鸿名。"]},{"i":"c-a9e7b9414cc6","t":"导引","a":"无名氏","d":"宋","g":"词","p":["真人临御，实瑞集丰融。","万国仰天聪。","嘉礼盛礼文章焕，齐洁致清衷。","笙镛六变三神格，喜备盛仪容。","乾穹上达昭灵飨，庆绪蔼丕隆。","阳郊报本，礼意弥勤礼。","太一下威神。","天临两观推三赦，庆祉被臣民。","徽名荐册缛仪陈。","盛节焕书筠。","涂歌邑诵扬徽懿，鼎命协惟新。"]},{"i":"c-0230989f7b22","t":"六州","a":"无名氏","d":"宋","g":"词","p":["承皇统，天地洽清宁。","熙帝载，建民极，百度推明。","崇让肄、博考儒经。","游豫腾谣诵，星跸天行。","留绀宇、顺拜金庭。","兆庶动欢声。","灵心上达，卿云成盖，祥风袭物，瑞日耀园清。","列圣孝德被寰瀛。","就阳位协吉，周正俨簪缨。","交对越群灵。","皇威赫奕盛仪成。","徽册受鸿名。","鸡竿肆赦，鸳行均庆，翾飞浸泽，期万保升平。"]},{"i":"c-0890b87561db","t":"十二时・忆少年","a":"无名氏","d":"宋","g":"词","p":["嘉亨运，璇历均调。","光烈遇唐尧。","珍图缘错，垂锡乾霄。","封岱顺车杓。","修合答、万玉来朝。","瑞丕昭。","构宇结瑛瑶。","虚气下仙飚。","钦崇道祖，舆驾动临谯。","整銮镳。","郊报厚黎苗。","均纯贶，渗漉咸滋液，能事播欢谣。","继明缵绪，缓赋轻徭。","京庾比丰饶。","勤中昃、采善询荛。","五风飘。","授人时吏正，休马橐兵销。","良肱隆栋，助化率皇僚。","德声遥。","懿铄简书标。"]}]