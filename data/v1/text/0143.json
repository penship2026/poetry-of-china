[{"i":"2666a3f9-aa59-4476-bb0b-0af3357d8d87","t":"聽霜鐘","a":"戴叔倫","d":"唐","g":"古体","p":["渺渺飛霜夜，寥寥遠岫鐘。","出雲疑斷續，入戶乍舂容。","度枕頻驚夢，隨風幾韻松。","悠揚來不已，杳靄去何從。","髣髴煙嵐隔，依稀巖嶠重。","此時聊一聽，餘響繞千峰。"]},{"i":"0f145a5d-ead7-40dc-88a8-217f5bf05e38","t":"聽霜鐘","a":"戴叔倫","d":"唐","g":"古体","p":["寥亮來豐嶺，分明辨古鐘。","應霜如自擊，中節每相從。","靜聽非閑扣，潛應蘊聖蹤。","風間時斷續，雲外更舂容。","虛警和清籟，雄鳴隔亂峰。","因知諭知己，感激更難逢。"]},{"i":"39ee422a-e77c-494c-b5c7-75b5a7fa9833","t":"酬崔法曹遺劒","a":"戴叔倫","d":"唐","g":"短诗","p":["臨風脫佩劒，相勸靜胡塵。","自料無筋力，何由荅故人。"]},{"i":"e3f3e233-70e4-49fd-bb09-c6a0a54f7d4e","t":"敬報孫常州二首 一","a":"戴叔倫","d":"唐","g":"短诗","p":["衰病苦奔走，未嘗追舊遊。","何言問憔悴，此日駐方舟。"]},{"i":"c9449155-5986-4467-8e84-30e5205e3f1e","t":"敬報孫常州二首 二","a":"戴叔倫","d":"唐","g":"短诗","p":["遠道曳故屐，餘春會高齋。","因言別離久，得盡平生懷。"]},{"i":"99ade326-5aeb-4d54-b7f3-cb1351a5e23e","t":"將赴東陽留上包諫議","a":"戴叔倫","d":"唐","g":"短诗","p":["敝邑連山遠，仙舟數刻同。","多慚屢回首，前路在泥中。"]},{"i":"a0a91b39-3990-4eba-b4ef-86f3eca64ce8","t":"荅崔法曹","a":"戴叔倫","d":"唐","g":"短诗","p":["後會知不遠，今歡亦願留。","江天梅雨散，況在月中樓。"]},{"i":"a13ca9e2-3f3d-4065-b001-6b5ff7e36dcc","t":"問嚴居士易","a":"戴叔倫","d":"唐","g":"短诗","p":["自公來問易，不復待加年。","更有垂簾會，遙知續草玄。"]},{"i":"b750e80a-f2d3-4197-b1cb-45c9e7251ddd","t":"新年第二夜荅處上人宿玉芝觀見寄","a":"戴叔倫","d":"唐","g":"短诗","p":["陽春已三日，會友聞昨夜。","可愛剡溪僧，獨尋陶景舍。"]},{"i":"3335bee1-90a8-4998-9731-c11a8fce0597","t":"赴撫州對酬崔法曹夜雨滴空堦五首 一","a":"戴叔倫","d":"唐","g":"短诗","p":["雨落濕孤客，心驚比棲鳥。","空階夜滴繁，相亂應到曉。"]},{"i":"1c189006-aefd-4e4f-bdcc-3393aa34f56a","t":"赴撫州對酬崔法曹夜雨滴空堦五首 二","a":"戴叔倫","d":"唐","g":"短诗","p":["高會棗樹宅，清言蓮社僧。","兩鄉同夜雨，旅館又無燈。"]},{"i":"c9e83d27-9a83-4eb6-b348-333bc281c2b9","t":"赴撫州對酬崔法曹夜雨滴空堦五首 三","a":"戴叔倫","d":"唐","g":"短诗","p":["謗議不自辨，親朋那得知。","雨中驅馬去，非是獨傷離。"]},{"i":"2e91df9f-dc79-4657-a431-44a6378b0ecd","t":"赴撫州對酬崔法曹夜雨滴空堦五首 四","a":"戴叔倫","d":"唐","g":"短诗","p":["離室雨初晦，客程雲陡暗。","方爲對吏人，敢望郵童探。"]},{"i":"a9fa19f8-6e21-460a-a1ad-ad0272328262","t":"赴撫州對酬崔法曹夜雨滴空堦五首 五","a":"戴叔倫","d":"唐","g":"短诗","p":["縱酒常擲盞，狂歌時入室。","離羣怨雨聲，幽抑方成疾。"]},{"i":"a6d7f53c-9631-4849-9975-4887c7e0fb61","t":"又酬曉燈[離暗]室五首 一","a":"戴叔倫","d":"唐","g":"短诗","p":["知疑姦叟謗，閑與情人話。","猶是別時燈，不眠同此夜。"]},{"i":"9715a2f1-2b9f-459e-9d0d-36e9c5b78544","t":"又酬曉燈[離暗]室五首 二","a":"戴叔倫","d":"唐","g":"短诗","p":["寒燈揚曉焰，重屋驚春雨。","應想遠行人，路逢泥濘阻。"]},{"i":"fcf8623a-3c01-4bea-94cd-663e6b2a2f76","t":"又酬曉燈[離暗]室五首 三","a":"戴叔倫","d":"唐","g":"短诗","p":["燈光照虛屋，雨影懸空壁。","一向簷下聲，遠來愁處滴。"]},{"i":"e3f71946-f5ac-4789-a750-6af2337a11b8","t":"又酬曉燈[離暗]室五首 四","a":"戴叔倫","d":"唐","g":"短诗","p":["楚僧話寂滅，俗慮比虛空。","賴有殘燈喻，相傳昏暗中。"]},{"i":"fb3ddaff-b685-4259-b956-5cf875608319","t":"又酬曉燈[離暗]室五首 五","a":"戴叔倫","d":"唐","g":"短诗","p":["雨聲亂燈影，明滅在空堦。","併枉五言贈，知同萬里懷。"]},{"i":"7614ca20-733c-4ff3-a655-3c8ea0d498ef","t":"同賦龍沙墅","a":"戴叔倫","d":"唐","g":"短诗","p":["回轉沙岸近，欹斜林嶺重。","因君訪遺跡，此日見真龍。"]},{"i":"ccd8b7c0-3d74-4cb0-8980-3dcd5a265a30","t":"昭君詞","a":"戴叔倫","d":"唐","g":"短诗","p":["漢宮若遠近，路在寒沙上。","到死不得歸，何人共南望。"]},{"i":"9017db43-e553-41c6-8e41-faec2e570bc5","t":"勸陸三飲酒","a":"戴叔倫","d":"唐","g":"短诗","p":["寒郊好天氣，勸酒莫辭頻。","擾擾鍾陵市，無窮不醉人。"]},{"i":"16616009-65cd-4aca-9fa7-d811bc47da08","t":"關山月二首 一","a":"戴叔倫","d":"唐","g":"短诗","p":["月出照關山，秋風人未還。","清光無遠近，鄉淚半書間。"]},{"i":"01898455-f8ad-437f-b6b7-e85557bcdc22","t":"關山月二首 二","a":"戴叔倫","d":"唐","g":"短诗","p":["一鴈過連營，繁霜覆古城。","胡笳在何處，半夜起邊聲。"]},{"i":"46c5d728-c508-4eb6-ab70-b3bda8705e74","t":"送王司直","a":"戴叔倫","d":"唐","g":"短诗","p":["西塞雲山遠，東風道路長。","人心勝潮水，相送過潯陽。"]},{"i":"a0f43418-33bc-4f98-899b-0685366eea5e","t":"宿無可上人房","a":"戴叔倫","d":"唐","g":"短诗","p":["偶來人境外，何處染囂塵。","倘許棲林下，僧中老此身。"]},{"i":"c1a46701-7f8e-4fda-af01-a547f34e1961","t":"山居","a":"戴叔倫","d":"唐","g":"短诗","p":["麋鹿自成羣，何人到白雲。","山中無外事，終日醉醺醺。"]},{"i":"151e3f4f-cb2b-4bf1-bd53-800f2185e4d1","t":"口號","a":"戴叔倫","d":"唐","g":"短诗","p":["白髮千莖雪，寒窗嬾著書。","最憐吟苜蓿，不及向桑榆。"]},{"i":"c4a4c891-c602-4085-86e2-78b7678059e1","t":"夜坐","a":"戴叔倫","d":"唐","g":"短诗","p":["夜靜河漢高，獨坐庭前月。","忽起故園思，動作經年別。"]},{"i":"2e0dfd8f-821c-40ce-b802-251e56eb1ed3","t":"隄上柳","a":"戴叔倫","d":"唐","g":"短诗","p":["垂柳萬條絲，春來織別離。","行人攀折處，閨妾斷腸時。"]},{"i":"1ec2a7d3-28e5-4dc8-b9e9-7c4e160ac871","t":"遣興","a":"戴叔倫","d":"唐","g":"短诗","p":["明月臨滄海，閑雲戀故山。","詩名滿天下，終日掩柴關。"]},{"i":"e341327a-fb05-44d4-b771-6d22bd4cc7e5","t":"贈張揮使","a":"戴叔倫","d":"唐","g":"短诗","p":["謫戍孤城小，思家萬里遙。","漢廷求衞霍，劒佩上青霄。"]},{"i":"ec7585c2-b556-44ce-9536-4ab29f138ed1","t":"偶成","a":"戴叔倫","d":"唐","g":"短诗","p":["野水連天碧，峯巒入海青。","滄浪者誰子，一曲醉中聽。"]},{"i":"e4166f66-36ab-4fe1-ab8b-87bae3cf862c","t":"畫蟬","a":"戴叔倫","d":"唐","g":"短诗","p":["飲露身何潔，吟風韻更長。","斜陽千萬樹，無處避螳螂。"]},{"i":"095b716b-89b6-4ecc-a3f9-7ffa0bd688d4","t":"題天柱山圖","a":"戴叔倫","d":"唐","g":"短诗","p":["拔翠五雲中，擎天不計功。","誰能凌絕頂，看取日升東。"]},{"i":"a012f579-47b8-4b62-a91b-6792bb94ae53","t":"松鶴","a":"戴叔倫","d":"唐","g":"短诗","p":["雨濕松陰涼，風落松花細。","獨鶴愛清幽，飛來不飛去。"]},{"i":"181e032c-d33f-449e-a589-92402eb757c9","t":"草堂一上人","a":"戴叔倫","d":"唐","g":"短诗","p":["一公持一鉢，相復度遙岑。","地瘦無黃獨，春來草更深。"]},{"i":"1dbe219f-270f-4ad6-aec7-6f15ae73ad70","t":"題黃司直園","a":"戴叔倫","d":"唐","g":"短诗","p":["爲憶去年梅，凌寒特地來。","門前空臘盡，渾未有花開。"]},{"i":"1464676a-cfac-4c42-8e13-c578e0a54d43","t":"北山游亭","a":"戴叔倫","d":"唐","g":"短诗","p":["西崦水泠泠，沿岡有游亭。","自從春草長，遙見祗青青。"]},{"i":"1feb3681-6f79-4a9d-ae12-5b826046cac1","t":"贈李唐山人","a":"戴叔倫","d":"唐","g":"短诗","p":["此意無所欲，閉門風景遲。","柳條將白髮，相對共垂絲。"]},{"i":"cc44f781-f0bb-4947-bf2b-92e0e1275f32","t":"題秦隱君麗句亭","a":"戴叔倫","d":"唐","g":"短诗","p":["北人歸欲盡，猶自住蕭山。","閉戶不曾出，詩名滿世間。"]},{"i":"c48cb12c-8c93-46f0-ae68-fed69e1fefbe","t":"荅孫常州見憶","a":"戴叔倫","d":"唐","g":"短诗","p":["畫鷁春風裏，迢遙去若飛。","那能寄相憶，不並子猷歸。"]},{"i":"ba16449e-a278-49cf-9605-e772c7b68422","t":"送裴明州效南朝體","a":"戴叔倫","d":"唐","g":"短诗","p":["沅水連湘水，千波萬浪中。","知郎未得去，慚愧石尤風。"]},{"i":"e3265b08-784b-400b-8fe7-d1654c0d22b8","t":"戲留顧十一明府","a":"戴叔倫","d":"唐","g":"短诗","p":["江明雨初歇，山暗雲猶濕。","未可動歸橈，前程風浪急。"]},{"i":"ffbd4e81-ebc5-4248-97f3-e94a33ac9515","t":"荅崔載華","a":"戴叔倫","d":"唐","g":"短诗","p":["文案日成堆，愁眉拽不開。","偷歸甕間臥，逢箇楚狂來。"]},{"i":"10cef41f-2e8b-43fc-a431-038760d73e2c","t":"將赴行營勸客同醉","a":"戴叔倫","d":"唐","g":"短诗","p":["絲管霜天夜，煙塵淮水西。","明朝上征去，相伴醉如泥。"]},{"i":"0503020d-c7e8-4119-9a83-4ef5d033c95c","t":"夏夜江樓會別","a":"戴叔倫","d":"唐","g":"短诗","p":["不作十日別，煩君此相留。","雨餘江上月，好醉竹間樓。"]},{"i":"6e8b1a9f-037f-4f95-94e3-4287c2a9787a","t":"歲除日奉推事使牒追赴撫州辨對留別崔法曹陸大祝處士上人同賦人字口號","a":"戴叔倫","d":"唐","g":"短诗","p":["上國杳未到，流年忽復新。","回車不自識，君定送何人。"]},{"i":"342ebc9b-77af-46b5-83c7-efb01c730cd5","t":"江館會別","a":"戴叔倫","d":"唐","g":"短诗","p":["離亭一會宿，能有幾人同。","莫以回車泣，前途不盡窮。"]},{"i":"9f6619ba-ece3-45e4-b611-6b0286c4c757","t":"容州回逢陸三別","a":"戴叔倫","d":"唐","g":"短诗","p":["西南積水遠，老病喜生歸。","此地故人別，空餘淚滿衣。"]},{"i":"0cb56b65-a89a-4545-81d5-9e17c4ec5eb1","t":"古意寄呈王侍郎","a":"戴叔倫","d":"唐","g":"短诗","p":["夜光貯懷袖，待報一顧恩。","日向江湖老，此心誰爲論。"]},{"i":"9d87de2c-bb6e-4f15-8c07-939d2702df0a","t":"送李大夫渡口阻風","a":"戴叔倫","d":"唐","g":"短诗","p":["浪息定何時，龍門到恐遲。","輕舟不敢渡，空立望旌旗。"]},{"i":"a29e2e73-54f2-418a-9500-f80a9c2469f4","t":"過三閭廟","a":"戴叔倫","d":"唐","g":"短诗","p":["沅湘流不盡，屈宋怨何深。","日暮秋煙起，蕭蕭楓樹林。"]},{"i":"fcc5e46e-0187-4441-9d65-d5cad1963221","t":"泊湘口","a":"戴叔倫","d":"唐","g":"短诗","p":["湘山千嶺樹，桂水九秋波。","露重猨聲絕，風清月色多。"]},{"i":"9456a92c-9b5c-4f9b-a337-06e8430002e2","t":"遊道林寺","a":"戴叔倫","d":"唐","g":"短诗","p":["佳山路不遠，俗侶到常稀。","及此煙霞暮，相看復欲歸。"]},{"i":"3d81a50e-1fbc-4d98-a353-342eea5beb08","t":"後宮曲","a":"戴叔倫","d":"唐","g":"短诗","p":["初入長門宮，謂言君戲妾。","寧知秋風至，吹盡庭前葉。"]},{"i":"d02f1f30-2f7d-4cf4-984d-949d076945b9","t":"新別離","a":"戴叔倫","d":"唐","g":"短诗","p":["手把杏花枝，未曾經別離。","黃昏掩閨後，寂寞心自知。"]},{"i":"51193855-3efa-4dbd-a880-c2fd13710fb2","t":"夏日登鶴巖偶成","a":"戴叔倫","d":"唐","g":"短诗","p":["天風吹我上層岡，露灑長松六月涼。","願借老僧雙白鶴，碧雲深處共翺翔。"]},{"i":"879f798d-fdd9-40f4-beec-e538bb5c323c","t":"題淨居寺","a":"戴叔倫","d":"唐","g":"短诗","p":["玉壺山下雲居寺，六百年來選佛場。","滿地白雲關不住，石泉流出落花香。"]},{"i":"410b1ce2-d6b3-4791-8b76-dba1a74bd8a2","t":"昭君詞","a":"戴叔倫","d":"唐","g":"短诗","p":["漢家宮闕夢中歸，幾度氈房淚濕衣。","惆悵不如邊鴈影，秋風猶得向南飛。"]},{"i":"b301d20a-9934-4e51-bada-c92bd451baaf","t":"織女詞","a":"戴叔倫","d":"唐","g":"短诗","p":["鳳梭停織鵲無音，夢憶仙郎夜夜心。","難得相逢容易別，銀河爭似妾愁深。"]},{"i":"ebcc0053-11c4-438e-bbc6-28f2e4b9d747","t":"塞上曲二首 一","a":"戴叔倫","d":"唐","g":"短诗","p":["軍門頻納受降書，一劒橫行萬里餘。","漢祖謾夸婁敬策，卻將公主嫁單于。"]},{"i":"66ebcb4d-63b0-485b-8ba3-bb6f6963454c","t":"塞上曲二首 二","a":"戴叔倫","d":"唐","g":"短诗","p":["漢家旌幟滿陰山，不遣胡兒匹馬還。","願得此身長報國，何須生入玉門關。"]},{"i":"336e74f9-e5ed-4fa4-a931-999115318f0f","t":"閨怨","a":"戴叔倫","d":"唐","g":"短诗","p":["看花無語淚如傾，多少春風怨別情。","不識玉門關外路，夢中昨夜到邊城。"]},{"i":"0e8c917b-58b6-457a-93ed-321716012ea3","t":"春怨","a":"戴叔倫","d":"唐","g":"短诗","p":["金鴨香消欲斷魂，棃花春雨掩重門。","欲知別後相思意，回看羅衣積淚痕。"]},{"i":"1810673f-87d3-40de-85d7-a69cc48c984c","t":"旅次寄湖南張郎中","a":"戴叔倫","d":"唐","g":"短诗","p":["閉門茅底偶爲鄰，北阮那憐南阮貧。","却是梅花無世態，隔牆分送一枝春。"]},{"i":"45c4f5a9-2d33-416e-aa32-9a614bb534f1","t":"題友人山居","a":"戴叔倫","d":"唐","g":"短诗","p":["四郭青山處處同，客懷無計荅秋風。","數家茅屋清溪上，千樹蟬聲落日中。"]},{"i":"72caa839-845e-4846-bf12-d9b9c21330c0","t":"別鄭谷","a":"戴叔倫","d":"唐","g":"短诗","p":["朝陽齋前桃李樹，手栽清蔭接比鄰。","明年此地看花發，愁向東風憶故人。"]},{"i":"d74ff7e4-fc01-4353-a1b6-59ce8cd98458","t":"贈鶴林上人","a":"戴叔倫","d":"唐","g":"短诗","p":["日日澗邊尋茯苓，巖扉常掩鳳山青。","歸來挂衲高林下，自翦芭蕉寫佛經。"]},{"i":"2d569368-a596-40d9-bb8d-994f5c3cfe5c","t":"題稚川山水","a":"戴叔倫","d":"唐","g":"短诗","p":["松下茅亭五月涼，汀沙雲樹晚蒼蒼。","行人無限秋風思，隔水青山似故鄉。"]},{"i":"3979821a-6f07-41ad-9625-f9a4b76d9108","t":"過柳溪道院","a":"戴叔倫","d":"唐","g":"短诗","p":["溪上誰家掩竹扉，鳥啼渾似惜春暉。","日斜深巷無人跡，時見棃花片片飛。"]},{"i":"d2e80e40-6e8c-4f7c-8d6f-7e7d58cccb98","t":"荔枝","a":"戴叔倫","d":"唐","g":"短诗","p":["紅顆真珠誠可愛，白鬚太守亦何癡。","十年結子知誰在，自向中庭種荔枝。"]},{"i":"e139b304-059d-4eb4-9312-56e13d45aa39","t":"憶原上人","a":"戴叔倫","d":"唐","g":"短诗","p":["一兩棕鞋八尺藤，廣陵行遍又金陵。","不知竹雨竹風夜，吟對秋山那寺燈。"]},{"i":"40967ba9-1b4c-4999-8b47-fe33249523fd","t":"閑思","a":"戴叔倫","d":"唐","g":"短诗","p":["伯勞東去鶴西還，雲總無心亦度山。","何似嚴陵灘上客，一竿長伴白鷗閑。"]},{"i":"d505c716-3ba6-4a6d-aa72-805acad7b350","t":"蘭溪棹歌","a":"戴叔倫","d":"唐","g":"短诗","p":["涼月如眉挂柳灣，越中山色鏡中看。","蘭溪三日桃花雨，半夜鯉魚來上灘。"]},{"i":"e5d34018-cfa7-4547-b70f-dba7b6b0a51b","t":"蘇溪亭","a":"戴叔倫","d":"唐","g":"短诗","p":["蘇溪亭上草漫漫，誰倚東風十二闌。","燕子不歸春事晚，一汀煙雨杏花寒。"]},{"i":"722c97e2-8499-433f-a18b-67402dcce9c6","t":"敬酬陸山人二首 一","a":"戴叔倫","d":"唐","g":"短诗","p":["黨議連誅不可聞，直臣高士去紛紛。","當時漏奪無人問，出宰東陽笑殺君。"]},{"i":"4b51d4f3-15c4-4722-b936-9467d467cdaa","t":"敬酬陸山人二首 二","a":"戴叔倫","d":"唐","g":"短诗","p":["由來海畔逐樵漁，奉詔因乘使者車。","却掌山中子男印，自看猶是舊潛夫。"]},{"i":"2dd187bd-b264-4cc4-877a-9791f9d8e302","t":"荅崔法曹賦四雪","a":"戴叔倫","d":"唐","g":"短诗","p":["楚僧躡雪來招隱，先訪高人積雪中。","已別剡溪逢雪去，雪山修道與師同。"]},{"i":"7ed0c3d5-5117-4167-865f-2ed676f178ed","t":"撫州被推昭雪荅陸太祝三首 一","a":"戴叔倫","d":"唐","g":"短诗","p":["求理由來許便宜，漢朝龔遂不爲疵。","如今謗起翻成累，唯有新人子細知。"]},{"i":"22d76ba9-dcd8-4fe8-9f56-c9546472b3a6","t":"撫州被推昭雪荅陸太祝三首 二","a":"戴叔倫","d":"唐","g":"短诗","p":["貧交相愛果無疑，共向人間聽直詞。","從古以來何限枉，慚知暗室不曾欺。"]},{"i":"2bd56b00-f9a0-490c-b3ae-262f704ba596","t":"撫州被推昭雪荅陸太祝三首 三","a":"戴叔倫","d":"唐","g":"短诗","p":["春風旅館長庭蕪，俯首低眉一老夫。","已對鐵冠窮事本，不知廷尉念冤無。"]},{"i":"6a1da34c-2be0-485b-bead-81a1911e840e","t":"送獨孤𢘽還京","a":"戴叔倫","d":"唐","g":"短诗","p":["舉家相逐還鄉去，不向秋風怨別時。","湖水兩重山萬里，定知行盡到京師。"]},{"i":"770a0170-ad29-4655-ab97-d06e71cb76ea","t":"臨流送顧東陽","a":"戴叔倫","d":"唐","g":"短诗","p":["海上獨歸慚不及，邑中遺愛定無雙。","蘭橈起唱逐流去，却恨山溪通外江。"]},{"i":"fa637bf1-eb04-411f-8171-c5bfadb32805","t":"行營送馬侍御","a":"戴叔倫","d":"唐","g":"短诗","p":["萬里羽書來未絕，五關烽火晝仍傳。","故人多病盡歸去，唯有劉楨不得眠。"]},{"i":"5c5a2ba4-4609-4c96-8022-23ca17b0e46f","t":"送秦系","a":"戴叔倫","d":"唐","g":"短诗","p":["五都來往無舊業，一代公卿盡故人。","不肯低頭受羈束，遠師溪上拂纓塵。"]},{"i":"99e2e5ca-c2d3-4a74-889c-5187d67fb5e4","t":"送裴判官回湖南","a":"戴叔倫","d":"唐","g":"短诗","p":["莫怕南風且盡歡，湘山多雨夏中寒。","送君萬里不覺遠，此地曾爲心鐵官。"]},{"i":"b2b17513-9627-4dae-9779-c2df11a7007e","t":"再巡道永留別","a":"戴叔倫","d":"唐","g":"短诗","p":["鬢下初驚白髮時，更逢離別助秋悲。","從今不學四方事，已共家人海上期。"]},{"i":"bbd2ad8c-e1cd-4b4e-afb2-8464e20188d2","t":"別崔法曹","a":"戴叔倫","d":"唐","g":"短诗","p":["欲作別離西入秦，芝田棗逕往來頻。","東湖此夕更留醉，逢著廬山學道人。"]},{"i":"5ff11599-0092-414d-a759-a18078140df7","t":"送蕭二","a":"戴叔倫","d":"唐","g":"短诗","p":["擬向田間老此身，寒郊怨別甚於春。","又聞故里朋遊盡，到日知逢何處人。"]},{"i":"7cd7fe9c-61e1-4421-a500-4f22ebd7e494","t":"湘川野望","a":"戴叔倫","d":"唐","g":"短诗","p":["懷王獨與佞人謀，聞道忠臣入亂流。","今日登高望不見，楚雲湘水各悠悠。"]},{"i":"ed8693c8-135b-43a0-ac7d-5dadfd9980d8","t":"將至道州寄李使君","a":"戴叔倫","d":"唐","g":"短诗","p":["九疑深路遶山回，木落天清猨晝哀。","猶隔簫韶一峯在，遙傳五馬向東來。"]},{"i":"9a4b12f1-b33b-4b6a-91b4-41d96a59dbf3","t":"與虞沔州謁藏真上人","a":"戴叔倫","d":"唐","g":"短诗","p":["故侯將我到山中，更上西峯見遠公。","共問置心何處好，主人揮手指虛空。"]},{"i":"b5f7a070-808f-45b7-ab66-4bdcd7a562e0","t":"題招隱寺","a":"戴叔倫","d":"唐","g":"短诗","p":["昨日臨川謝病還，求田問舍獨相關。","宋時有井如今在，却種胡麻不買山。"]},{"i":"0271a9ee-1faa-4b35-b9d4-c6c3b47127b6","t":"過珥瀆單老","a":"戴叔倫","d":"唐","g":"短诗","p":["毫末成圍海變田，單家依舊住溪邊。","比來已向人間老，今日相過却少年。"]},{"i":"9038c3e7-8bce-44ce-a133-a63b7335e5bb","t":"族兄各年八十餘見招游洞","a":"戴叔倫","d":"唐","g":"短诗","p":["鶴髮婆娑鄉里親，相邀共看往年春。","擬將兒女歸來住，且是茅山見老人。"]},{"i":"5707de8e-3b74-44f2-a67d-4743b9c1597f","t":"登高回乘月尋僧","a":"戴叔倫","d":"唐","g":"短诗","p":["插鬢茱萸來未盡，共隨明月下沙堆。","高緇寂寂不相問，醉客無端入定來。"]},{"i":"a82d0171-3f18-4888-b953-0bbb51a1023f","t":"贈殷亮","a":"戴叔倫","d":"唐","g":"短诗","p":["日日河邊見水流，傷春未已復悲秋。","山中舊宅無人住，來往風塵共白頭。"]},{"i":"4f1531af-037e-4ca4-8d56-834b2167eed9","t":"夜發袁江寄李潁川劉侍御","a":"戴叔倫","d":"唐","g":"短诗","p":["半夜回舟入楚鄉，月明山水共蒼蒼。","孤猨更叫秋風裏，不是愁人亦斷腸。"]},{"i":"7f0c60b4-819f-4141-b19f-b3e34a02ee97","t":"對酒示申屠學士","a":"戴叔倫","d":"唐","g":"短诗","p":["三重江水萬重山，山裏春風度日閑。","且向白雲求一醉，莫教愁夢到鄉關。"]}]