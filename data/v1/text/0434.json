[{"i":"0cddbb9e-766e-4e82-b2ef-004211eea6a3","t":"宮詞 六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["夾城門與內門通，朝罷巡遊到苑中。","每日日高祗候處，滿堤紅豔立春風。"]},{"i":"8923a856-4edb-4529-8be2-492e398640cf","t":"宮詞 七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["廚船進食簇時新，侍宴無非列近臣。","日午殿頭宣索鱠，隔花催喚打魚人。"]},{"i":"df9ffa54-6b61-4ae1-89f6-616c8b15da28","t":"宮詞 八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["立春日進內園花，紅蕊輕輕嫩淺霞。","跪到玉階猶帶露，一時宣賜與宮娃。"]},{"i":"84659c6c-c707-4f17-9df2-aa892fb5b57e","t":"宮詞 九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["三面宮城盡夾牆，苑中池水白茫茫。","直從獅子門前入，旋見亭臺遶岸傍。"]},{"i":"a76cfded-dd13-4e10-9879-b9986bfa6479","t":"宮詞 十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["離宮別院遶宮城，金版輕敲合鳳笙。","夜夜月明花樹底，傍池長有按歌聲。"]},{"i":"49c4ade2-3c03-43b7-a436-c68a466222e7","t":"宮詞 十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["御製新翻曲子成，六宮纔唱未知名。","盡將觱篥來抄譜，先按君王玉笛聲。"]},{"i":"fb749e60-9a7b-47ab-89d3-417862aa13c5","t":"宮詞 十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["旋移紅樹斲新苔，宣使龍池更鑿開。","展得綠波寬似海，水心樓殿勝蓬萊。"]},{"i":"55935bb7-f84b-42f2-8830-b523fff9e21d","t":"宮詞 十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["太虛高閣凌虛殿，背倚城牆面枕池。","諸院各分娘子位，羊車到處不教知。"]},{"i":"1bf754a5-ebf0-4ef3-874a-df35b53f255b","t":"宮詞 十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["修儀承寵住龍池，掃地焚香日午時。","等候大家來院裏，看教鸚鵡念新詩。"]},{"i":"ee6b11ed-3b5b-421e-83bd-cb093aaf78c5","t":"宮詞 十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["才人出入每參隨，筆硯將行遶曲池。","能向彩箋書大字，忽防御製寫新詩。"]},{"i":"a0ce5d58-e64e-4569-b749-a30cfc26a057","t":"宮詞 十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["六宮官職總新除，宮女安排入畫圖。","二十四司分六局，御前頻見錯相呼。"]},{"i":"32120a22-ff49-4fb9-8518-9c5f11fcaeca","t":"宮詞 十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["春風一面曉妝成，偷折花枝傍水行。","却被內監遙覷見，故將紅豆打黃鶯。"]},{"i":"654404eb-2ef9-494b-aeba-e142d003a53f","t":"宮詞 十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["殿前排宴賞花開，宮女侵晨探幾回。","斜望花開遙舉袖，傳聲宣喚近臣來。"]},{"i":"1d0a6499-4d0b-4de2-96ef-783ccc74bbd3","t":"宮詞 十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["小毬場近曲池頭，宣喚勳臣試打毬。","先向畫樓排御幄，管絃聲動立浮油。"]},{"i":"d1d2f5d3-9e7a-46f4-b89d-0867d8ed1797","t":"宮詞 二十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["供奉頭籌不敢爭，上棚等喚近臣名。","內人酌酒纔宣賜，馬上齊呼萬歲聲。"]},{"i":"822d14a4-1c98-47d7-8913-857af3d27b28","t":"宮詞 二十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["殿前宮女總纖腰，初學乘騎怯又嬌。","上得馬來纔欲走，幾回拋鞚抱鞍橋。"]},{"i":"17e00c36-8e47-48a1-8126-f271ea47eea8","t":"宮詞 二十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["自教宮娥學打毬，玉鞍初跨柳腰柔。","上棚知是官家認，遍遍長贏第一籌。"]},{"i":"a851e76d-9982-41f1-a67a-19f36de8f98f","t":"宮詞 二十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["翔鸞閣外夕陽天，樹影花光遠接連。","望見內家來往處，水門斜過罨樓船。"]},{"i":"0c619599-1e16-455f-a361-a3b3448b50ec","t":"宮詞 二十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["內家追逐採蓮時，驚起沙歐兩岸飛。","蘭棹把來齊拍水，並船相鬬溼羅衣。"]},{"i":"8691e473-cdce-47ca-aee2-a81b29942d4b","t":"宮詞 二十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["新秋女伴各相逢，罨畫船飛別浦中。","旋折荷花伴歌舞，夕陽斜照滿衣紅。"]},{"i":"dca209ec-eaa3-453c-b63d-c8647d55f7d3","t":"宮詞 二十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["少年相逐採蓮回，羅帽羅衫巧製裁。","每到岸頭長拍水，競提纖手出船來。"]},{"i":"27071504-abb7-427a-8c4a-7bb8429d61ae","t":"宮詞 二十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["早春楊柳引長條，倚岸沿堤一面高。","稱與畫船牽錦纜，暖風搓出綵絲縧。"]},{"i":"2a5dc356-e6d4-4976-a8ed-a60c3d9e6889","t":"宮詞 二十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["內家宣錫生辰宴，隔夜諸宮進御花。","後殿未聞宮主入，東門先報下金車。"]},{"i":"b19ec03b-62ed-426b-b6be-968df5d02471","t":"宮詞 二十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["端午生衣進御牀，赭黃羅帕覆金箱。","美人捧入南薰殿，玉腕斜封綵縷長。"]},{"i":"686e20d4-8258-47a6-abed-f720923c9fe9","t":"宮詞 三十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["選進仙韶第一人，纔勝羅綺不勝春。","重教按舞桃花下，只踏殘紅作地裀。"]},{"i":"5a002bc8-2f7b-4fd5-9974-fa6dd71582ca","t":"宮詞 三十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["侍女爭揮玉彈弓，金丸飛入亂花中。","一時驚起流鶯散，踏落殘花滿地紅。"]},{"i":"20be117b-444e-4425-b557-fd296e2fc114","t":"宮詞 三十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["七寶闌干白玉除，新開涼殿幸金輿。","一溝泛碧流春水，四面瓊鉤搭綺疏。"]},{"i":"a51f775e-d0f3-4cc9-a845-36e8ef3a044d","t":"宮詞 三十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["山樓彩鳳棲寒月，宴殿金麟吐御香。","蜀錦地衣呈隊舞，教頭先出拜君王。"]},{"i":"4c332515-ac37-4e62-b1ca-cf10a28af0df","t":"宮詞 三十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["天外明河翻玉浪，樓西涼月湧金盆。","香銷甲乙牀前帳，宮鎖玲瓏閉殿門。"]},{"i":"8f36cac6-90ff-4eae-b57d-d06bbf7adfd7","t":"宮詞 三十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["細風攲葉撼宮梧，早怯秋寒著繡繻。","玉宇無人雙燕去，一彎新月上金樞。"]},{"i":"4c61825f-b097-46fe-bef3-9cadadb05cc8","t":"宮詞 三十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["夜寒金屋篆煙飛，燈燭分明在紫微。","漏永禁宮三十六，燕回爭踏月輪歸。"]},{"i":"32c22368-8cb0-47fb-b2ef-412af37905cc","t":"宮詞 三十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["曉吹翩翩動翠旗，爐煙千疊瑞雲飛。","何人奏對偏移刻，御史天香隔繡衣。"]},{"i":"62464f07-5224-4e92-8da9-9d7ee8e1c587","t":"宮詞 三十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["金井秋啼絡緯聲，出花宮漏報嚴更。","不知誰是金鑾直，玉宇沈沈夜氣清。"]},{"i":"1c260ae0-aead-45e5-aad6-ffc41f9852e3","t":"宮詞 三十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["內庭秋燕玉池東，香散荷花水殿風。","阿監采菱牽錦纜，月明猶在畫船中。"]},{"i":"930ac842-fb1d-4cd7-8b9a-b150c2c1646c","t":"宮詞 四十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["東宮花燭彩樓新，天上仙橋上鎖春。","偏出六宮歌舞奏，嫦娥初到月虛輪。"]},{"i":"760f9913-820b-4a5b-b160-2ffef80f60ec","t":"宮詞 四十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["紗幔薄垂金麥穗，簾鉤纖挂玉蔥條。","樓西別起長春殿，香碧紅泥透蜀椒。"]},{"i":"a54290de-ac37-45cf-8155-ab5626f4ccf4","t":"宮詞 四十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["翠華香重玉爐添，雙鳳樓頭曉日暹。","扇掩紅鸞金殿悄，一聲清蹕捲珠簾。"]},{"i":"b768f3f6-8c5d-4dff-b8ed-2f74f6b8e111","t":"宮詞 四十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["金作蟠龍繡作麟，壺中樓閣禁中春。","君王避暑來遊幸，風月橫秋氣象新。"]},{"i":"22532b11-0610-4580-af9c-e45c4fd2c8c5","t":"宮詞 四十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["清曉自傾花上露，冷侵宮殿玉蟾蜍。","擘開五色銷金紙，碧鎖窗前學草書。"]},{"i":"40e37425-9898-4fc2-bf19-4117de819f67","t":"宮詞 四十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["翠鈿貼靨輕如笑，玉鳳雕釵褭欲飛。","拂曉賀春皇帝閣，綵衣金勝近龍衣。"]},{"i":"b3855892-1e64-402b-babc-7d2ba992dd31","t":"宮詞 四十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["璅聲金徹閤門環，簾捲珍珠十二間。","別殿春風呼萬歲，中丞新押散朝班。"]},{"i":"58b98851-ed3b-4d1b-8d51-f02bfe16342d","t":"宮詞 四十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["雞人報曉傳三唱，玉井金牀轉轆轤。","煙引御爐香繞殿，漏籤初刻上銅壺。"]},{"i":"d950c838-25fa-4810-975a-3f69f1f6e0cb","t":"宮詞 四十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["御按橫金殿幄紅，扇開雲表露天容。","太常奏備三千曲，樂府新調十二鐘。"]},{"i":"aa46826d-e216-4d76-a20b-b1f7cdf2984d","t":"宮詞 四十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["宮女熏香進御衣，殿門開鎖請金匙。","朝陽初上黃金屋，禁夜春深晝漏遲。"]},{"i":"ad55651a-4fa0-4526-8509-e2f8726a0edd","t":"宮詞 五十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["三月金明柳絮飛，岸花堤草弄春時。","樓船百戲催宣賜，御輦今年不上池。"]},{"i":"66760aad-62a5-476f-ab8d-005602464714","t":"宮詞 五十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["內人稀見水鞦韆，爭擘珠簾帳殿前。","第一錦標誰奪得，右軍輸却小龍船。"]},{"i":"9bf35f68-19e7-4a48-abb7-e58a7d83bfb8","t":"宮詞 五十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["夜色樓臺月數層，金猊煙穗繞觚稜。","重廊屈折連三殿，密上真珠百寶燈。"]},{"i":"1eb1a042-39d3-4883-b789-9baa091f5ead","t":"宮詞 五十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["天門晏閉九重關，樓倚銀河氣象間。","一點星毬垂絳闕，五雲仙仗下蓬山。"]},{"i":"e9d48a39-5dc8-4db4-85c7-23ab573734cb","t":"宮詞 五十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["禁裏春濃蝶自飛，御蠶眠處弄新絲。","碧窗盡日教鸚鵡，念得君王數首詩。"]},{"i":"4f0c40ad-ae87-4332-83e5-d54315aca05e","t":"宮詞 五十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["鬬草深宮玉檻前，春蒲如箭荇如錢。","不如紅藥闌干曲，日暮何人落翠鈿。"]},{"i":"f95a8af4-3cb6-4675-a33a-97ed80181fd7","t":"宮詞 五十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["太液波清水殿涼，畫船驚起宿鴛鴦。","翠眉不及池邊柳，取次飛花入建章。"]},{"i":"b6ad82c9-cfd8-4814-9ef6-6cab2146039e","t":"宮詞 五十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["御座垂簾繡額單，冰山重疊貯金盤。","玉清迢遰無塵到，殿角東西五月寒。"]},{"i":"1bb56dda-cce9-4974-b2bf-cf0e180c9ade","t":"宮詞 五十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["春心滴破花邊漏，曉夢敲回禁裏鐘。","十二楚山何處是，御樓曾見兩三峰。"]},{"i":"14960b91-dfec-4807-b84d-fa0392b2521a","t":"宮詞 五十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["博山夜宿沈香火，帳外時聞暖鳳笙。","理遍從頭新上曲，殿前龍直未交更。"]},{"i":"2672119b-3f05-4e46-ae0a-6c5283416d64","t":"宮詞 六十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["春殿千官宴却歸，上林鶯舌報花時。","宣徽旋進新裁曲，學士爭吟應詔詩。"]},{"i":"16c3c5cc-21fc-4098-a344-e9d845a50658","t":"宮詞 六十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["釣線沈波漾彩舟，魚爭芳餌上龍鉤。","內人急捧金盤接，撥刺紅鱗躍未休。"]},{"i":"62e593a8-bd0a-434a-aa65-b319c8a04705","t":"宮詞 六十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["蕙炷香銷燭影殘，御衣熏盡輙更闌。","歸來困頓眠紅帳，一枕西風夢裏寒。"]},{"i":"4e2cd49e-ab13-47fb-a928-e8f6a89a6d9e","t":"宮詞 六十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["東宮降誕挺佳辰，少海星邊擁瑞雲。","中尉傳聞三日宴，翰林當撰洗兒文。"]},{"i":"91c907ab-9263-45ef-99fc-5580882b87c0","t":"宮詞 六十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["酒庫新修近水傍，潑醅初熟五雲漿。","殿前供御頻宣索，追入花間一陣香。"]},{"i":"4f6c1e0b-78f9-4c4d-aaff-d006dfa025d6","t":"宮詞 六十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["白藤花限白銀花，閤子門當寢殿斜。","近被宮中知了事，每來隨駕使煎茶。"]},{"i":"10299208-dcd5-4a68-af1d-0dad93da0224","t":"宮詞 六十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["西毬場裏打毬回，御宴先於苑內開。","宣索教坊諸伎樂，傍池催喚入船來。"]},{"i":"a2372ef2-44be-44d2-a946-2c18ea1fd709","t":"宮詞 六十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["昭儀侍宴足精神，玉燭抽看記飲巡。","倚賴識書爲錄事，燈前時復錯瞞人。"]},{"i":"8fcd57bf-a707-4183-b1bb-dcb15cb467f7","t":"宮詞 六十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["後宮阿監裹羅巾，出入經過苑囿頻。","承奉聖顏憂悞失，就中長怕內夫人。"]},{"i":"bdf3eb32-ca13-4f2c-a06c-d2d05df08af3","t":"宮詞 六十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["管弦聲急滿龍池，宮女藏鉤夜宴時。","好是聖人親捉得，便將濃墨掃雙眉。"]},{"i":"9289db62-f7c8-442a-9482-cc6482244148","t":"宮詞 七十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["密室紅泥地火爐，內人冬日晚傳呼。","今宵駕幸池頭宿，排比椒房得煖無。"]},{"i":"720c96c8-244d-466b-ab17-bd10c67349f7","t":"宮詞 七十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["畫船花舫總新妝，進入池心近島傍。","松柏樓窗楠木板，暖風吹過一團香。"]},{"i":"e575f23f-4dcf-47ce-90e8-7bd405a1be70","t":"宮詞 七十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["三清臺近苑牆東，樓檻層層映水紅。","盡日綺羅人度曲，管弦聲在半天中。"]},{"i":"c37cf787-b4f5-4b6d-b9f7-b3b33f697522","t":"宮詞 七十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["安排諸院接行廊，外檻周迴十里強。","青錦地衣紅繡毯，盡鋪龍腦鬱金香。"]},{"i":"6ed45983-cc09-489d-a45f-108556421912","t":"宮詞 七十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["安排竹柵與笆籬，養得新生鵓鴿兒。","宣受內家專餵飼，花毛間看總皆知。"]},{"i":"9ce1949d-9b22-4572-8e4d-2db7bd6126c5","t":"宮詞 七十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["年初十五最風流，新賜雲鬟便上頭。","按罷霓裳歸院裏，畫樓雲閣總重修。"]},{"i":"b5af7083-b223-4ef5-a1bc-7ad01e589481","t":"宮詞 七十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["金畫香臺出露盤，黃龍雕刻遶朱闌。","焚修每遇三元節，天子親簪白玉冠。"]},{"i":"d95e45df-8def-4647-949e-396c857b31cc","t":"宮詞 七十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["六宮一例雞冠子，新樣交鐫白玉花。","欲試澹妝兼道服，面前宣與唾盂家。"]},{"i":"4ad62f99-207e-4ebd-99d7-6591290da3b3","t":"宮詞 七十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["三月櫻桃乍熟時，內人相引看紅枝。","回頭索取黃金彈，遶樹藏身打雀兒。"]},{"i":"1a2da73a-925d-4138-bc51-fd66d1c50e72","t":"宮詞 七十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["小小宮娥到內園，未梳雲鬢臉如蓮。","自從配與夫人後，不使尋花亂入船。"]},{"i":"808fb0e5-7f18-40e0-9d1b-5145e5a7570a","t":"宮詞 八十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["錦城上起凝煙閣，擁殿遮樓一向高。","認得聖顏遙望見，碧闌干映赭黃袍。"]},{"i":"01d953c6-8d1a-4408-92df-8cca8d5d6e68","t":"宮詞 八十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["水車踏水上宮城，寢殿簷頭滴滴鳴。","助得聖人高枕興，夜涼長作遠灘聲。"]},{"i":"a5d38ddb-4839-4841-b036-be9d1d54c9d9","t":"宮詞 八十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["平頭船子小龍床，多少神仙立御旁。","旋刺篙竿令過岸，滿池春水蘸紅妝。"]},{"i":"d850f153-f860-4c6a-9688-bcd366456aa1","t":"宮詞 八十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["苑東天子愛巡游，御岸花堤枕碧流。","新教內人供射鴨，長將弓箭繞池頭。"]},{"i":"1580733d-d8ce-4c48-a468-bb389be08a98","t":"宮詞 八十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["羅衫玉帶最風流，斜插銀箆慢裹頭。","閑向殿前騎御馬，揮鞭橫過小紅樓。"]},{"i":"abde7444-574f-4427-ac3e-e4c1c07fd094","t":"宮詞 八十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["沈香亭子傍池斜，夏日巡游歇翠華。","簾畔玉盆盛淨水，內人手裏剖銀瓜。"]},{"i":"c25bbd21-7c49-4b50-aa6e-a58f94c58601","t":"宮詞 八十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["薄羅衫子透肌膚，夏日初長板閣虛。","獨自凭闌無一事，水風涼處讀文書。"]},{"i":"38da881f-c8f2-4d76-ad73-8adee172897c","t":"宮詞 八十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["婕妤生長帝王家，常近龍顏逐翠華。","楊柳岸長春日暮，傍池行困倚桃花。"]},{"i":"7b7d6c79-d685-4a27-8d1c-074fd24e0815","t":"宮詞 八十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["月頭支給買花錢，滿殿宮人近數千。","遇著唱名多不語，含羞走過御牀前。"]},{"i":"1dbe3a5f-0e06-4b01-b0ed-7e5f82d0f4fc","t":"宮詞 八十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["小雨霏微潤綠苔，石楠紅杏傍池開。","一枝插向金瓶裏，捧進君王玉殿來。"]},{"i":"15438298-f849-44f0-a62c-bbe77e93a62c","t":"宮詞 九十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["錦鱗躍水出浮萍，荇草牽風翠帶橫。","恰似金梭攛碧沼，好題幽恨寫閨情。"]},{"i":"b43783b4-fc4f-44ec-ba83-97e788519aef","t":"宮詞 九十一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["春天睡起曉妝成，隨侍君王觸處行。","畫得自家梳洗樣，相憑女伴把來呈。"]},{"i":"2ad1bfb7-5972-4379-b1e2-6ba61b366649","t":"宮詞 九十二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["舞頭皆著畫羅衣，唱得新翻御製詞。","每日內庭聞教隊，樂聲飛上到龍墀。"]},{"i":"6a8251dc-ac2c-42ff-89a3-088f4441c547","t":"宮詞 九十三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["春早尋花入內園，競傳宣旨欲黃昏。","明朝駕幸遊蠶市，暗使氊車就苑門。"]},{"i":"be517c51-7751-4f15-a4cc-efc8f1e5d209","t":"宮詞 九十四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["半夜搖船載內家，水門紅蠟一行斜。","聖人正在宮中飲，宣使池頭旋折花。"]},{"i":"e8d1bb61-2e01-469e-9342-95a1a1faf0ce","t":"宮詞 九十五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["春日龍池小宴開，岸邊亭子號流杯。","沈檀刻作神仙女，對捧金尊水上來。"]},{"i":"274dbb18-7b49-4888-b15f-ea841384f60d","t":"宮詞 九十六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["梨園子弟簇池頭，小樂攜來候宴游。","旋炙銀笙先按拍，海棠花下合梁州。"]},{"i":"08bbac5c-6b1d-42db-8a52-8487c8b524cc","t":"宮詞 九十七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["慢梳鬟髻著輕紅，春早爭求芍藥叢。","近日承恩移住處，夾城裏面占新宮。"]},{"i":"ab96880b-a6c0-4d1f-bea2-cc26e9bbdef1","t":"宮詞 九十八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["別色官司御輦家，黃衫束帶臉如花。","深宮內院參承慣，常從金輿到日斜。"]},{"i":"d71f1566-df13-42ca-918e-8b7180bc24d1","t":"宮詞 九十九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["日高房裏學圍碁，等候官家未出時。","爲賭金錢爭路數，專憂女伴怪來遲。"]},{"i":"876235f6-32da-4210-94bd-8c90f7bc8432","t":"宮詞 一百","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["摴蒱冷澹學投壺，箭倚腰身約畫圖。","盡對君王稱妙手，一人來射一人輸。"]},{"i":"26763dc2-ddf7-46e1-8e5b-20c909d6bd32","t":"宮詞 一百一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["慢揎紅袖指纖纖，學釣池魚傍水邊。","忍冷不禁還自去，釣竿常被別人牽。"]},{"i":"5a2a77b9-6e16-4949-91d9-67814d443f8e","t":"宮詞 一百二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["宣城院約池南岸，粉壁紅窗畫不成。","總是一人行幸處，徹宵聞奏管弦聲。"]},{"i":"fafb557c-7139-49a1-a4ff-3f3b6373951c","t":"宮詞 一百三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["丹霞亭浸池心冷，曲沼門含水脚清。","傍岸鴛鴦皆著對，時時出向淺沙行。"]},{"i":"d194ea8a-8a30-4441-86b5-3354bf226b8e","t":"宮詞 一百四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["楊柳陰中引御溝，碧梧桐樹擁朱樓。","金陵城共滕王閣，畫向丹青也合羞。"]},{"i":"659d6ea7-4744-499b-a49b-aaaaf7bc080e","t":"宮詞 一百五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["晚來隨駕上城游，行到東西百子樓。","回望苑中花柳色，綠陰紅豔滿池頭。"]}]