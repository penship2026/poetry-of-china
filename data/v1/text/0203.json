[{"i":"0ea9fab0-d3c4-4ed6-8234-f78a1ae68cbb","t":"和韋開州盛山十二首 盤石磴","a":"張籍","d":"唐","g":"短诗","p":["壘石盤空遠，層層勢不危。","不知行幾匝，得到上頭時。"]},{"i":"70580fb2-022f-4fea-9944-776f5637d835","t":"和韋開州盛山十二首 桃塢","a":"張籍","d":"唐","g":"短诗","p":["春塢桃花發，多將野客遊。","日西殊未散，看望酒缸頭。"]},{"i":"389039e4-0124-42c5-84cf-cf29ebcb31e4","t":"和韋開州盛山十二首 竹巖","a":"張籍","d":"唐","g":"短诗","p":["獨入千竿裏，緣巖踏石層。","笋頭齊欲出，更不許人登。"]},{"i":"e28b4e3b-2cd8-4915-9c8f-f9d4a50636ab","t":"和韋開州盛山十二首 琵琶臺","a":"張籍","d":"唐","g":"短诗","p":["臺上綠蘿春，閑登不待人。","每當休暇日，著履戴紗巾。"]},{"i":"1e9c0991-3551-4acf-8948-8115251f0c66","t":"和韋開州盛山十二首 胡蘆沼","a":"張籍","d":"唐","g":"短诗","p":["曲沼春流滿，新蒲映野鵝。","閑齋朝飯後，拄杖遶行多。"]},{"i":"fb5ee0ca-ad31-409d-bcc7-b95b08ba2165","t":"和韋開州盛山十二首 隱月岫","a":"張籍","d":"唐","g":"短诗","p":["月出深峰裏，清涼夜亦寒。","每嫌西落疾，不得到明看。"]},{"i":"ae8591be-54b1-484d-8bde-2ccec2ae987f","t":"和韋開州盛山十二首 繡衣石榻","a":"張籍","d":"唐","g":"短诗","p":["山城無別味，藥草兼魚果。","時到繡衣人，同來石上坐。"]},{"i":"5209fed5-6f9b-4e12-9fd9-f2d91d154d90","t":"和韋開州盛山十二首 上士泉缾","a":"張籍","d":"唐","g":"短诗","p":["堦上一眼泉，四邊青石甃。","唯有護淨僧，添缾將盥漱。"]},{"i":"49ce4f86-6999-48a4-8d85-59851b6f62fd","t":"送遠客","a":"張籍","d":"唐","g":"短诗","p":["憔悴遠歸客，殷勤欲別杯。","九星壇下路，幾日見重來。"]},{"i":"4c937660-3aa1-4f1a-b39d-c41c717162ef","t":"寄西峰僧","a":"張籍","d":"唐","g":"短诗","p":["松暗水涓涓，夜涼人未眠。","西峰月猶在，遙憶草堂前。"]},{"i":"9f27bad0-5a8e-45c1-ae8d-54652a436648","t":"禪師","a":"張籍","d":"唐","g":"短诗","p":["獨在西峰頂，年年閉石房。","定中無弟子，人到爲焚香。"]},{"i":"1aee5e51-52a5-4f6d-9271-a95b47d1db12","t":"惜花","a":"張籍","d":"唐","g":"短诗","p":["山中春已晚，處處見花稀。","明日來應盡，林間宿不歸。"]},{"i":"afe54c56-6577-4031-9610-361371e02256","t":"題暉師影堂","a":"張籍","d":"唐","g":"短诗","p":["日早欲參禪，竟無相識緣。","道場今獨到，惆悵影堂前。"]},{"i":"12ba6512-5989-4b29-929f-5e1e218eaddd","t":"涇州塞","a":"張籍","d":"唐","g":"短诗","p":["行到涇州塞，唯聞羌戍鼙。","道邊古雙堠，猶記向安西。"]},{"i":"d25708ee-f6bb-4c12-a41d-5ff44f3d21bc","t":"野田","a":"張籍","d":"唐","g":"短诗","p":["漠漠野田草，草中牛羊道。","古墓無子孫，白楊不得老。"]},{"i":"c914d5f4-9d87-4a75-b774-0c01187b4a97","t":"岸花","a":"張籍","d":"唐","g":"短诗","p":["可憐岸邊樹，紅蘂發青條。","東風吹渡水，衝着木蘭橈。"]},{"i":"9c703f78-d424-4982-b5d0-fcc5c5b219f5","t":"別于鵠","a":"張籍","d":"唐","g":"短诗","p":["離燈及晨輝，行人起復思。","出門兩相顧，青山路逶迤。"]},{"i":"b84243ce-8627-4860-9065-f36af42441e8","t":"送蜀客","a":"張籍","d":"唐","g":"短诗","p":["蜀客南行祭碧雞，木棉花發錦江西。","山橋日晚行人少，時見猩猩樹上啼。"]},{"i":"0d280af5-5168-4daf-9c35-ff414a1c79ad","t":"送元結","a":"張籍","d":"唐","g":"短诗","p":["昔日同遊漳水邊，如今重說恨綿綿。","天涯相見還離別，客路秋風又幾年。"]},{"i":"ec4bc92d-bd98-4edd-9a32-223db867aebc","t":"宿山祠","a":"張籍","d":"唐","g":"短诗","p":["秋草宮人斜裏墓，宮人誰送葬來時。","千千萬萬皆如此，家在邊城亦不知。"]},{"i":"12ee9d91-c4af-467a-90cd-ad6857e7f96f","t":"美人宮棊","a":"張籍","d":"唐","g":"短诗","p":["紅燭臺前出翠娥，海沙鋪局巧相和。","趂行移手巡收盡，數數看誰得最多。"]},{"i":"53151f8d-1ea9-4c74-8681-a93760003b9c","t":"蠻州","a":"張籍","d":"唐","g":"短诗","p":["瘴水蠻中入洞流，人家多住竹棚頭。","一山海上無城郭，唯見松牌記象州。"]},{"i":"a149d59f-edb5-4ce1-9ace-cfe23be399f8","t":"送元宗簡","a":"張籍","d":"唐","g":"短诗","p":["貂帽垂肩窄皂裘，雪深騎馬向西州。","暫時相見還相送，却閉閑門依舊愁。"]},{"i":"c4ff8d39-cbac-431a-aaac-f12a80f1f99c","t":"寄徐晦","a":"張籍","d":"唐","g":"短诗","p":["鄠陂魚美酒偏濃，不出琴齋見雪峰。","應勝昨來趨府日，簿書牀上亂重重。"]},{"i":"5951cc09-83ca-4e54-83dd-97bedbce2d78","t":"寄白學士","a":"張籍","d":"唐","g":"短诗","p":["自掌天書見客稀，縱因休沐鎖雙扉。","幾回扶病欲相訪，知向禁中歸未歸。"]},{"i":"58a7e4bd-15de-4126-a91c-de9562694ce8","t":"喜王六同宿","a":"張籍","d":"唐","g":"短诗","p":["十八年來恨別離，唯同一宿詠新詩。","更相借問詩中語，共說如今勝舊時。"]},{"i":"53f67bc3-4e10-4e03-8bb7-903cfa77c55e","t":"題玉像堂","a":"張籍","d":"唐","g":"短诗","p":["玉毫不着世間塵，輝相分明十八身。","入夜無煙燈更好，堂中唯有轉經人。"]},{"i":"9ac10c96-2565-49a8-8d9c-c7a8e00a6bfd","t":"與賈島閑遊","a":"張籍","d":"唐","g":"短诗","p":["水北原南草色新，雪消風暖不生塵。","城中車馬應無數，能解閑行有幾人。"]},{"i":"1708826e-98b4-46c1-b549-e7fef08b274a","t":"哭丘長史","a":"張籍","d":"唐","g":"短诗","p":["丘公已歿故人稀，欲過街西更訪誰。","每到子城東路上，憶君相逐入朝時。"]},{"i":"001fb373-42bc-4183-b801-4bd6fbd0ced2","t":"哭孟寂","a":"張籍","d":"唐","g":"短诗","p":["曲江院裏題名處，十九人中最少年。","今日春光君不見，杏花零落寺門前。"]},{"i":"37b86718-b55e-4d15-a925-35fd808661f5","t":"患眼","a":"張籍","d":"唐","g":"短诗","p":["三年患眼今年[校]，[免]與風光便隔生。","昨日韓家後園裏，看花猶似未分明。"]},{"i":"21f79e41-e677-4b23-851f-3d0ef6bd5c23","t":"答劉競","a":"張籍","d":"唐","g":"短诗","p":["劉君久被時拋擲，老向城中作選人。","昨日街西相近住，每來存問老夫身。"]},{"i":"2b28f476-519a-4f0f-bd77-5ebc5c080eb0","t":"贈華嚴院僧","a":"張籍","d":"唐","g":"短诗","p":["一身依止荒閑院，燭耀窗中有宿煙。","徧禮華嚴經裏字，不曾行到寺門前。"]},{"i":"dbd2b5f0-bdcd-4cf6-a824-32cdc7ed6eaf","t":"逢故人","a":"張籍","d":"唐","g":"短诗","p":["山東一十餘年別，今日相逢在上都。","說盡向來無限事，相看摩捋白髭鬚。"]},{"i":"d3df800a-ab93-4401-be88-6de07067e8d5","t":"送蕭遠弟","a":"張籍","d":"唐","g":"短诗","p":["街北槐花傍馬垂，病身相送出門遲。","與君別後秋風夜，作得新詩說向誰。"]},{"i":"c7043fe9-514d-4931-9dc0-66be822cdc76","t":"送辛少府任樂安","a":"張籍","d":"唐","g":"短诗","p":["才多不肯浪容身，老大詩章轉更新。","選得天台山下住，一家全作學仙人。"]},{"i":"41a57e93-7560-4156-8e99-d34e36ef8ade","t":"贈任道人","a":"張籍","d":"唐","g":"短诗","p":["長安多病無生計，藥鋪醫人亂索錢。","欲得定知身上事，憑君爲算小行年。"]},{"i":"47ee7083-94cd-4830-be32-c2288e68642e","t":"招周居士","a":"張籍","d":"唐","g":"短诗","p":["閉門秋雨濕墙莎，俗客來稀野思多。","已掃書齋安藥竈，山人作意早經過。"]},{"i":"8be94615-01f2-4bec-a310-10374fa3b6d0","t":"送許處士","a":"張籍","d":"唐","g":"短诗","p":["高情自與俗人疎，獨向藍溪選僻居。","會到白雲長取醉，不能窗下讀閑書。"]},{"i":"dce86802-daf7-44d1-9f88-35ae33c96877","t":"送律師歸婺州","a":"張籍","d":"唐","g":"短诗","p":["京中開講已多時，曾作壇頭證戒師。","歸到雙溪橋北寺，鄉僧爭就學威儀。"]},{"i":"72f904c4-5ff2-419a-b3a4-b96dcc2b89cc","t":"題楊秘書新居","a":"張籍","d":"唐","g":"短诗","p":["愛閑不向爭名地，宅在街西最靜坊。","卷裏詩過一千首，白頭新受秘書郎。"]},{"i":"55839370-dff8-405f-a7fa-38486feffa91","t":"送晊師","a":"張籍","d":"唐","g":"短诗","p":["九星臺下煎茶別，五老峰頭覓寺居。","作得新詩旋相寄，人來請莫達空書。"]},{"i":"2ee3ee4d-af63-4945-9560-930b01e3a510","t":"送僧往金州","a":"張籍","d":"唐","g":"短诗","p":["聞道谿陰山水好，師行一一徧經過。","事須覓取堪居處，若箇溪頭藥最多。"]},{"i":"cfc14bee-9fa0-4706-b0fc-380d3562d90b","t":"尋徐道士","a":"張籍","d":"唐","g":"短诗","p":["尋師遠到暉天觀，竹院森森閉藥房。","聞入靜來經七日，仙童簷下獨焚香。"]},{"i":"f5224101-9e0a-4bc9-8945-5c4779ca04d2","t":"答開州韋使君寄車前子","a":"張籍","d":"唐","g":"短诗","p":["開州午日車前子，作藥人皆道有神。","慙愧使君憐病眼，三千餘里寄閑人。"]},{"i":"a3bfb43c-eae3-43dc-9864-195d236b1cfe","t":"憶故州","a":"張籍","d":"唐","g":"短诗","p":["壘石爲山伴野夫，自收靈藥讀仙書。","如今身是他州客，每見青山憶舊居。"]},{"i":"c8649844-a2b5-4db0-8cd9-3bacebecb233","t":"送客遊蜀","a":"張籍","d":"唐","g":"短诗","p":["行盡青山到益州，錦城樓下二江流。","杜家曾向此中住，爲到浣花溪水頭。"]},{"i":"aebe5864-0507-4a19-b7f2-e40929e7c98c","t":"送陸暢","a":"張籍","d":"唐","g":"短诗","p":["共踏長安街裏塵，吳州獨作未歸身。","昔年舊宅今誰住，君過西塘與問人。"]},{"i":"ae0b6631-6a2b-478c-9f05-a8c1f2899e81","t":"感春","a":"張籍","d":"唐","g":"短诗","p":["遠客悠悠任病身，謝家池上又逢春。","明年各自東西去，此地看花是別人。"]},{"i":"c0b1d427-649a-4860-aa54-589b206d13aa","t":"贈李司議","a":"張籍","d":"唐","g":"短诗","p":["漢庭誰問投荒客，十載天南着白衣。","秋草茫茫惡谿路，嶺頭遙送北人稀。"]},{"i":"29dcc03b-5647-471d-893c-0a9cbc225dcd","t":"別客","a":"張籍","d":"唐","g":"短诗","p":["青山歷歷水悠悠，今日相逢明日秋。","繫馬城邊楊柳樹，爲君沽酒暫淹留。"]},{"i":"5fd2d72d-8fde-4406-8ed9-b8eeb91995e5","t":"登樓寄胡家兄弟","a":"張籍","d":"唐","g":"短诗","p":["獨上西樓盡日閑，林煙演漾鳥蠻蠻。","謝家兄弟重城裏，不得同看雨後山。"]},{"i":"3ab2c0eb-e8e5-4b84-bf00-60a49887ac0c","t":"答劉明府","a":"張籍","d":"唐","g":"短诗","p":["身病多時又客居，滿城親舊盡相疎。","可憐絳縣劉明府，猶解頻頻寄遠書。"]},{"i":"ecd41f12-a61f-4c5e-8cce-5289695e52d3","t":"酬藤杖","a":"張籍","d":"唐","g":"短诗","p":["病裏出門行步遲，喜君相贈古藤枝。","倚來自覺身生力，每向傍人說得時。"]},{"i":"42a7ef88-90f5-4f79-abbf-bf05bd87bc9e","t":"法雄寺東樓","a":"張籍","d":"唐","g":"短诗","p":["汾陽舊宅今爲寺，猶有當時歌舞樓。","四十年來車馬絕，古槐深巷暮蟬愁。"]},{"i":"0ec7646c-d08e-40af-8557-f9530dfacd43","t":"寄故人","a":"張籍","d":"唐","g":"短诗","p":["靜曲閑房病客居，蟬聲滿樹槿花疎。","故人祗在藍田縣，強半年來未得書。"]},{"i":"31bbcbd6-e531-470f-92ec-915fa97ce639","t":"鄰婦哭征夫","a":"張籍","d":"唐","g":"短诗","p":["雙鬟初合便分離，萬里征夫不得隨。","今日軍回身獨歿，去時鞍馬別人騎。"]},{"i":"e5388a4b-7457-4f76-826c-ffed2a8ec779","t":"和崔駙馬聞蟬","a":"張籍","d":"唐","g":"短诗","p":["鳳凰樓下多歡樂，不覺秋風暮雨天。","應爲昨來身暫病，蟬聲得到耳傍邊。"]},{"i":"badab31e-682c-4658-9a2e-cb2b13e317f0","t":"和裴僕射看櫻桃花","a":"張籍","d":"唐","g":"短诗","p":["昨日南園新雨後，櫻桃花發舊枝柯。","天明不待人同看，遶樹重重履跡多。"]},{"i":"0c499a93-bbd0-406b-a428-7bfe13f77626","t":"和長安郭明府與友人縣中會飲","a":"張籍","d":"唐","g":"短诗","p":["一尊清酒兩人同，好在街西水縣中。","自恨病身相去遠，此時閑坐對秋風。"]},{"i":"833f4a39-0f62-420f-8033-870d5e243d7e","t":"唐昌觀看花","a":"張籍","d":"唐","g":"短诗","p":["新紅舊紫不相宜，看覺從前兩月遲。","更向同來詩客道，明年到此莫過時。"]},{"i":"8ccf17af-4e7a-46c0-826b-657b84f20989","t":"九華觀看花","a":"張籍","d":"唐","g":"短诗","p":["街西無數閑遊處，不似九華仙觀中。","花裏可憐池上景，幾重墻壁貯春風。"]},{"i":"fa49873e-d6a9-4a2b-87f0-b9b3fb310b20","t":"贈姚合","a":"張籍","d":"唐","g":"短诗","p":["丹鳳城門向曉開，千官相次入朝來。","唯君獨走衝塵土，下馬橋邊報直迴。"]},{"i":"163ddb38-3261-4fbd-acd1-71705cb54341","t":"同韋員外開元觀尋時道士","a":"張籍","d":"唐","g":"短诗","p":["觀裏初晴竹樹涼，閑行共到最高房。","昨來官罷無生計，欲就師求斷穀方。"]},{"i":"fe71226b-16c1-4d10-9241-ef9b61690cc5","t":"同韓侍御南溪夜賞","a":"張籍","d":"唐","g":"短诗","p":["喜作閑人得出城，南溪兩月逐君行。","忽聞新命須歸去，一夜船中語到明。"]},{"i":"ad2e7334-362c-4ba1-bc63-941fff9c1ddf","t":"使行望悟真寺","a":"張籍","d":"唐","g":"短诗","p":["採玉峰連佛寺幽，高高斜對驛門樓。","無端來去騎官馬，寸步教身不得遊。"]},{"i":"1da2720d-861f-482d-9931-e61480f4498c","t":"重陽日至峽道","a":"張籍","d":"唐","g":"短诗","p":["無限青山行已盡，迴看忽覺遠離家。","逢高欲飲重陽酒，山菊今朝未有花。"]},{"i":"bdca1529-ac5a-4830-a908-e5b1789174c3","t":"贈主客劉郎中","a":"張籍","d":"唐","g":"短诗","p":["憶昔君登南省日，老夫猶是褐衣身。","誰知二十餘年後，來作客曹相替人。"]},{"i":"2d7646fe-985e-4673-a554-61497dd86c8c","t":"同嚴給事聞唐昌觀玉蘂近有仙過因成絕句二首 一","a":"張籍","d":"唐","g":"短诗","p":["千枝花裏玉塵飛，阿母宮中見亦稀。","應共諸仙鬬百草，獨來偷得一枝歸。"]},{"i":"65e884d8-cf9f-4275-ae15-f6063d2eaf63","t":"同嚴給事聞唐昌觀玉蘂近有仙過因成絕句二首 二","a":"張籍","d":"唐","g":"短诗","p":["九色雲中紫鳳車，尋仙來到洞仙家。","飛輪迴處無踪跡，唯有斑斑滿地花。"]},{"i":"7191c0c6-7b3a-47cb-9fe6-1ef51857319a","t":"秋思","a":"張籍","d":"唐","g":"短诗","p":["洛陽城裏見秋風，欲作歸書意萬重。","忽恐匆匆說不盡，行人臨發又開封。"]},{"i":"4488fc89-5956-4d50-8312-544f7126e8b4","t":"憶遠","a":"張籍","d":"唐","g":"短诗","p":["行人猶未有歸期，萬里初程日暮時。","唯愛門前雙柳樹，枝枝葉葉不相離。"]},{"i":"1454d2df-ace5-4fce-8b72-1a5cb201b937","t":"玉仙館","a":"張籍","d":"唐","g":"短诗","p":["長溪新雨色如泥，野水陰雲盡向西。","楚客天南行漸遠，山山樹裏鷓鴣啼。"]},{"i":"230fbb94-0120-432a-a422-117f5b69dfbc","t":"寄府吏","a":"張籍","d":"唐","g":"短诗","p":["野外尋花共作期，今朝出郭不相隨。","待君公事有閑日，此地春風應過時。"]},{"i":"0d7026ad-92ab-4b60-98bb-4543b8253ca0","t":"弟蕭遠雪夜同宿","a":"張籍","d":"唐","g":"短诗","p":["數卷新遊蜀客詩，長安僻巷得相隨。","草堂雪夜攜琴宿，說是青城館裏時。"]},{"i":"0d5cfc9c-9522-44de-9c4b-17c73394212a","t":"涼州詞三首 一","a":"張籍","d":"唐","g":"短诗","p":["邊城暮雨雁飛低，蘆笋初生漸欲齊。","無數鈴聲遙過磧，應馱白練到安西。"]},{"i":"5743da4b-cc5b-4855-b622-30cd00c34f50","t":"涼州詞三首 二","a":"張籍","d":"唐","g":"短诗","p":["古鎮城門白磧開，胡兵往往傍沙堆。","巡邊使客行應早，欲問平安無使來。"]},{"i":"41b2a7ad-b60f-46aa-b9a0-42535c232763","t":"涼州詞三首 三","a":"張籍","d":"唐","g":"短诗","p":["鳳林關裏水東流，白草黃榆六十秋。","邊將皆承主恩澤，無人解道取涼州。"]},{"i":"95afc3cc-485b-4b1d-b502-d283840537d2","t":"宮詞 一","a":"張籍","d":"唐","g":"短诗","p":["新鷹初放兔猶肥，白日君王在內稀。","薄暮千門臨欲鎖，紅妝飛騎向前歸。"]},{"i":"ac0ef485-8298-4910-92e3-45c941babf93","t":"宮詞 二","a":"張籍","d":"唐","g":"短诗","p":["黃金捍撥紫檀槽，弦索初張調更高。","盡理昨來新上曲，內官簾外送櫻桃。"]},{"i":"40de74da-142d-4202-8d42-6538736cd361","t":"華清宮","a":"張籍","d":"唐","g":"短诗","p":["溫泉流入漢離宮，宮樹行行浴殿空。","武帝時人今欲盡，青山空閉御墻中。"]},{"i":"d60258ad-0f56-472e-b6f1-eae37b98766d","t":"崔駙馬養鶴","a":"張籍","d":"唐","g":"短诗","p":["身閑無事稱高情，已有人間章句名。","求得鶴來教翦翅，望仙臺下亦將行。"]},{"i":"e7818efd-615f-4df7-bd23-3cfefcba3cdc","t":"閑遊","a":"張籍","d":"唐","g":"短诗","p":["老身不計人間事，野寺秋晴每獨過。","病眼校來猶斷酒，却嫌行處菊花多。"]},{"i":"36f49c2a-a1fd-4807-8073-506b7e1e75c9","t":"劉兵曹贈酒","a":"張籍","d":"唐","g":"短诗","p":["一缾顏色似甘泉，閑向新栽小竹前。","飲罷身中更無事，移牀獨就夕陽眠。"]},{"i":"4c4cde49-4616-4258-b780-f8ac5f8a8627","t":"送梧州王使君","a":"張籍","d":"唐","g":"短诗","p":["楚江亭上秋風起，看發蒼梧太守船。","千里同行從此別，相逢又隔幾多年。"]},{"i":"ce70861d-2ec3-4224-a989-c20b98b7c2c9","t":"春日早朝","a":"張籍","d":"唐","g":"短诗","p":["曉陌春寒朝騎來，瑞雲深處見樓臺。","夜來新雨沙堤濕，東上閤門應未開。"]},{"i":"037c9bcb-a457-4c3d-b359-048dda1f23bc","t":"寄朱闞二山人","a":"張籍","d":"唐","g":"短诗","p":["爲箇朝章束此身，眼看東路去無因。","歷陽舊客今應少，轉憶鄰家二老人。"]},{"i":"6e074a5f-78d4-4d05-a248-c872831c493e","t":"寄李渤","a":"張籍","d":"唐","g":"短诗","p":["五度溪頭躑躅紅，嵩陽寺裏講時鐘。","春山處處行應好，一月看花到幾峰。"]},{"i":"2f0e76c3-fa01-4082-b01c-3a1193ff7e06","t":"尋仙","a":"張籍","d":"唐","g":"短诗","p":["溪頭一徑入青崖，處處仙居隔杏花。","更見峰西幽客說，雲中猶有兩三家。"]},{"i":"2742f3ef-4b79-44df-878f-bd61b8ff829c","t":"同白侍郎杏園贈劉郎中","a":"張籍","d":"唐","g":"短诗","p":["一去瀟湘頭欲白，今朝始見杏花春。","從來遷客應無數，重到花前有幾人。"]},{"i":"c0cbb0bd-9129-48c9-aef6-c116139328cc","t":"答鄱陽客藥名詩","a":"張籍","d":"唐","g":"短诗","p":["江臯歲暮相逢地，黃葉霜前半夏枝。","子夜吟詩向松桂，心中萬事喜君知。"]},{"i":"9c5a58a3-f22f-47e5-b9e5-02d48242cbf9","t":"寄宋景","a":"張籍","d":"唐","g":"短诗","p":["詔發官兵取亂臣，將軍弓箭不離身。","今君獨在征東府，莫遣功名屬別人。"]},{"i":"afb264e3-d77f-4320-8a74-99504f66893a","t":"寄王侍御","a":"張籍","d":"唐","g":"短诗","p":["愛君紫閣峰前好，新作書堂藥竈成。","見欲移居相近住，有田多與種黃精。"]},{"i":"ec0d936d-5d2c-4923-92df-40f89286341c","t":"題渭北寺上方","a":"張籍","d":"唐","g":"短诗","p":["昔祭郊壇今謁陵，寺中高處最來登。","十餘年後人多別，喜見當時轉讀僧。"]},{"i":"555ea1b6-606e-4ff9-80f2-d1d1daf76166","t":"閑遊","a":"張籍","d":"唐","g":"短诗","p":["終日不離塵土間，若爲能見此身閑。","今朝暫共遊僧語，更恨趨時別舊山。"]},{"i":"6e79f014-6170-4b01-b3cb-c6044a6a989a","t":"倡女詞","a":"張籍","d":"唐","g":"短诗","p":["輕鬢叢梳闊掃眉，爲嫌風日下樓稀。","畫羅金縷難相稱，故著尋常淡薄衣。"]},{"i":"2a15c396-5516-4577-958b-53df6a5b5bd2","t":"答元八遺紗帽","a":"張籍","d":"唐","g":"短诗","p":["黑紗方帽君邊得，稱對山前坐竹牀。","唯恐被人偷剪樣，不曾閑戴出書堂。"]},{"i":"69245aca-a305-47b1-9fb5-79c1302ce84e","t":"題僧院","a":"張籍","d":"唐","g":"短诗","p":["聞師行講青龍疏，本寺住來多少年。","靜掃空房唯獨坐，千莖秋竹在簷前。"]},{"i":"65d0527b-5364-47a7-976b-dd87c9997d71","t":"送元八","a":"張籍","d":"唐","g":"短诗","p":["百神齋祭相隨徧，尋竹看山亦共行。","明日城西送君去，舊遊重到獨題名。"]},{"i":"4ddfd5e0-60cd-4227-b9fe-fc44ebf1bbde","t":"吳楚歌詞","a":"張籍","d":"唐","g":"短诗","p":["庭前春鳥啄林聲，紅夾羅襦縫未成。","今朝社日停針線，起向朱櫻樹下行。"]}]