[{"i":"ecec07dc-9a38-48ac-8454-7124346a047c","t":"江行無題一百首 七十九","a":"錢起","d":"唐","g":"短诗","p":["身世比行舟，無風亦暫休。","敢言終破浪，唯願穩乘流。"],"s":"trad","f":"simp"},{"i":"5087b097-5cff-459b-9c86-70b6f858425a","t":"江行無題一百首 八十","a":"錢起","d":"唐","g":"短诗","p":["數畝蒼苔石，煙濛鶴卵洲。","定因詞客遇，名字始風流。"],"s":"trad","f":"simp"},{"i":"d044a64a-26c5-4bec-9c1f-79570e41a0d9","t":"江行無題一百首 八十一","a":"錢起","d":"唐","g":"短诗","p":["興閑停桂楫，路好過松門。","不負佳山水，還開酒一尊。"],"s":"trad","f":"simp"},{"i":"a20d7657-10ef-4fa2-ad3d-50987eea10a9","t":"江行無題一百首 八十二","a":"錢起","d":"唐","g":"短诗","p":["幽懷念煙水，長恨隔龍沙。","今日膝王閣，分明見落霞。"],"s":"trad","f":"simp"},{"i":"31c7fc3b-d002-40a1-aad0-c39183066fe5","t":"江行無題一百首 八十三","a":"錢起","d":"唐","g":"短诗","p":["短楫休敲桂，孤根自駐萍。","自憐非劒氣，空向斗牛星。"],"s":"mixed","f":"simp"},{"i":"6af7442b-0e6f-44d9-883c-dd5b3c5e126c","t":"江行無題一百首 八十四","a":"錢起","d":"唐","g":"短诗","p":["江流何渺渺，懷古獨依依。","漁父非賢者，蘆中但有磯。"],"s":"trad","f":"simp"},{"i":"a641d29c-670e-4ecb-9c68-703f7159bb79","t":"江行無題一百首 八十五","a":"錢起","d":"唐","g":"短诗","p":["高浪如銀屋，江風一發時。","筆端降太白，才大語終奇。"],"s":"trad","f":"simp"},{"i":"bd692bf4-7d92-4c73-a316-89fd80100c66","t":"江行無題一百首 八十六","a":"錢起","d":"唐","g":"短诗","p":["細竹漁家路，晴陽看結繒。","喜來邀客坐，分與折腰菱。"],"s":"trad","f":"simp"},{"i":"339d2c0a-8297-464b-b37c-4755924c0a56","t":"江行無題一百首 八十七","a":"錢起","d":"唐","g":"短诗","p":["幸有煙波興，寧辭筆硯勞。","緣情無怨刺，却似反離騷。"],"s":"mixed","f":"simp"},{"i":"85ae906f-5c82-4dd0-989d-233257f5ae6a","t":"江行無題一百首 八十八","a":"錢起","d":"唐","g":"短诗","p":["平湖五百里，江水想通波。","不奈扁舟去，其如決計何。"],"s":"trad","f":"simp"},{"i":"c5123ca9-2423-4dba-a90a-dfcd3c2b6da5","t":"江行無題一百首 八十九","a":"錢起","d":"唐","g":"短诗","p":["數峯雲斷處，去岸暎高山。","身到韋江日，猶應未得閑。"],"s":"mixed","f":"simp"},{"i":"2f9e107a-aced-4b09-927b-bf1493e64921","t":"江行無題一百首 九十","a":"錢起","d":"唐","g":"短诗","p":["一灣斜照水，三版順風船。","未敢相邀約，勞生秖自憐。"],"s":"trad","f":"simp"},{"i":"2046e3de-19c0-4737-9f42-e24c6c114991","t":"江行無題一百首 九十一","a":"錢起","d":"唐","g":"短诗","p":["江雨正霏微，江村晚渡稀。","何曾妨釣艇，更待得魚歸。"],"s":"trad","f":"simp"},{"i":"52804721-9e5c-4cd5-a58a-c47a491dcc85","t":"江行無題一百首 九十二","a":"錢起","d":"唐","g":"短诗","p":["沙上獨行時，高吟到楚詞。","難將垂岸蓼，盈把當江蘺。"],"s":"trad","f":"simp"},{"i":"9d3c4f0d-bf0c-491d-9a12-aa58789ffcf3","t":"江行無題一百首 九十三","a":"錢起","d":"唐","g":"短诗","p":["新野舊樓名，潯陽勝賞情。","照人長一色，江月共淒清。"],"s":"trad","f":"simp"},{"i":"8a081071-eb67-404c-84a6-9f48a44520eb","t":"江行無題一百首 九十四","a":"錢起","d":"唐","g":"短诗","p":["願飲西江水，那吟北渚愁。","莫敎留滯跡，遠比蔡昭侯。"],"s":"trad","f":"simp"},{"i":"e9c591e2-fb02-4826-b151-9f41ff835970","t":"江行無題一百首 九十五","a":"錢起","d":"唐","g":"短诗","p":["湖口分江水，東流獨有情。","當時好風物，誰伴謝宣城。"],"s":"trad","f":"simp"},{"i":"0c080f84-6840-4b71-a73c-f22d4b02c153","t":"江行無題一百首 九十六","a":"錢起","d":"唐","g":"短诗","p":["潯陽江畔菊，應似古來秋。","爲問幽棲客，吟時得酒不。"],"s":"mixed","f":"simp"},{"i":"79757dc2-3afd-45bf-9998-465bd4aea1cb","t":"江行無題一百首 九十七","a":"錢起","d":"唐","g":"短诗","p":["高峯有佳號，千尺倚寒松。","若使鑪煙在，猶應爲上公。"],"s":"mixed","f":"simp"},{"i":"28edc830-20a8-42d9-bfbf-d1480e3d8b7b","t":"江行無題一百首 九十八","a":"錢起","d":"唐","g":"短诗","p":["萬木已清霜，江邊村事忙。","故溪黃稻熟，一夜夢中香。"],"s":"trad","f":"simp"},{"i":"65baec29-200b-4e33-9fde-aa80e3828fba","t":"江行無題一百首 九十九","a":"錢起","d":"唐","g":"短诗","p":["楚水苦縈迴，征帆落又開。","可緣非直路，却有好風來。"],"s":"mixed","f":"simp"},{"i":"580221e9-8b31-406a-b280-dcd513ac7362","t":"江行無題一百首 一百","a":"錢起","d":"唐","g":"短诗","p":["遠謫歲時晏，暮江風雨寒。","仍愁繫舟處，驚夢近長灘。"],"s":"trad","f":"simp"},{"i":"10c7bd29-22f7-407c-bd5e-0253598689d5","t":"言懷","a":"錢起","d":"唐","g":"短诗","p":["夜月霽未好，雲泉堪夢歸。","如何建章漏，催著早朝衣。"],"s":"trad","f":"simp"},{"i":"8697e254-8a73-4e3e-b485-caf95c32e466","t":"送李明府去官","a":"錢起","d":"唐","g":"短诗","p":["謗言三至後，直道歎何如。","今日藍溪水，無人不夜魚。"],"s":"trad","f":"simp"},{"i":"bc239060-b916-4be2-8c12-84635b56b26b","t":"赴章陵詶李卿贈別","a":"錢起","d":"唐","g":"短诗","p":["一官叨下秩，九棘謝知音。","芳草文園路，春愁滿別心。"],"s":"trad","f":"simp"},{"i":"6fcfa6f8-6cd9-49fd-b727-d1652b676310","t":"郎員外見尋不遇","a":"錢起","d":"唐","g":"短诗","p":["軒騎來相訪，漁樵悔晚歸。","更憐垂露跡，花裏點牆衣。"],"s":"mixed","f":"simp"},{"i":"b52a9754-58e2-4148-a1c0-9b750317ea0d","t":"過李侍御宅","a":"錢起","d":"唐","g":"短诗","p":["不見承明客，愁聞長樂鐘。","馬卿何早世，漢主欲登封。"],"s":"trad","f":"simp"},{"i":"98082caf-de2a-4836-8990-24273b55de1c","t":"宿洞口館","a":"錢起","d":"唐","g":"短诗","p":["野竹通溪冷，秋泉入戶鳴。","亂來人不到，芳草上堦生。"],"s":"trad","f":"simp"},{"i":"f3e8284c-313e-4635-8519-4f2f929d163c","t":"九日寄姪箊箕等","a":"錢起","d":"唐","g":"短诗","p":["采菊偏相憶，傳香寄便風。","今朝竹林下，莫使桂尊空。"],"s":"mixed","f":"simp"},{"i":"e00cf508-6def-4daf-8e9b-71fce922a6f9","t":"梨花","a":"錢起","d":"唐","g":"短诗","p":["豔靜如籠月，香寒未逐風。","桃花徒照地，終被笑妖紅。"],"s":"trad","f":"simp"},{"i":"07307446-f121-4be3-a68f-2146773a1091","t":"題崔逸人山亭","a":"錢起","d":"唐","g":"短诗","p":["藥徑深紅蘚，山窗滿翠微。","羨君花下酒，蝴蝶夢中飛。"],"s":"trad","f":"simp"},{"i":"b24f6be9-2176-458b-8870-ee6ec54d1397","t":"藍田溪雜詠二十二首 登臺","a":"錢起","d":"唐","g":"短诗","p":["望山登春臺，目盡趣難極。","晚景下平阡，花際霞峯色。"],"s":"mixed","f":"simp"},{"i":"7c088869-d8a1-448d-a880-b2c7a92977fc","t":"藍田溪雜詠二十二首 板橋","a":"錢起","d":"唐","g":"短诗","p":["靜宜樵隱度，遠與車馬隔。","有時行藥來，喜遇歸山客。"],"s":"trad","f":"simp"},{"i":"3aad932f-b802-42ec-831c-c2734e20a1f0","t":"藍田溪雜詠二十二首 石井","a":"錢起","d":"唐","g":"短诗","p":["片霞照仙井，泉底桃花紅。","那知幽石下，不與武陵通。"],"s":"trad","f":"simp"},{"i":"dd47ef5a-fcb2-4e2a-9e85-f910de2fd173","t":"藍田溪雜詠二十二首 古藤","a":"錢起","d":"唐","g":"短诗","p":["引蔓出雲樹，垂綸覆巢鶴。","幽人對酒時，苔上閑花落。"],"s":"trad","f":"simp"},{"i":"15ef0190-f37a-4dd2-b2f2-efbd06e5c252","t":"藍田溪雜詠二十二首 晚歸鷺","a":"錢起","d":"唐","g":"短诗","p":["池上靜難厭，雲間欲去晚。","忽背夕陽飛，乘興清風遠。"],"s":"trad","f":"simp"},{"i":"17fb29eb-2dde-4301-85fb-ec22ca57c6cb","t":"藍田溪雜詠二十二首 洞仙謠","a":"錢起","d":"唐","g":"短诗","p":["幾轉到青山，數重度流水。","秦人入雲去，知向桃源裏。"],"s":"mixed","f":"simp"},{"i":"7c4e26bd-7682-40db-ac9a-7748a093ab71","t":"藍田溪雜詠二十二首 藥圃","a":"錢起","d":"唐","g":"短诗","p":["春畦生百藥，花葉香初霽。","好容似風光，偏來入叢蕙。"],"s":"trad","f":"simp"},{"i":"546f15ef-b30b-43cd-b97d-0b2591abe2b9","t":"藍田溪雜詠二十二首 石上苔","a":"錢起","d":"唐","g":"短诗","p":["淨與溪色連，幽宜松雨滴。","誰知古石上，不染世人跡。"],"s":"trad","f":"simp"},{"i":"98b3a815-e691-4539-99dc-b8bcf13391e2","t":"藍田溪雜詠二十二首 窗裏山","a":"錢起","d":"唐","g":"短诗","p":["遠岫見如近，千里一窗裏。","坐來石上雲，乍謂壺中起。"],"s":"mixed","f":"simp"},{"i":"006adf6f-0796-40ae-9143-224e5036cba0","t":"藍田溪雜詠二十二首 竹間路","a":"錢起","d":"唐","g":"短诗","p":["暗歸草堂靜，半入花園去。","有時載酒來，不與清風遇。"],"s":"trad","f":"simp"},{"i":"4639b839-235b-4c5e-8355-29c2b797fd3c","t":"藍田溪雜詠二十二首 竹嶼","a":"錢起","d":"唐","g":"短诗","p":["幽鳥清漣上，興來看不足。","新篁壓水低，昨夜鴛鴦宿。"],"s":"trad","f":"simp"},{"i":"f954ad6f-bac4-417a-96ae-0489e9fbf9f4","t":"藍田溪雜詠二十二首 砌下泉","a":"錢起","d":"唐","g":"短诗","p":["穿雲來自遠，激砌流偏駛。","能資庭戶幽，更引海禽至。"],"s":"trad","f":"simp"},{"i":"7f5eb3c6-2a14-4f80-a59d-a19296ae310e","t":"藍田溪雜詠二十二首 戲鷗","a":"錢起","d":"唐","g":"短诗","p":["乍依菱蔓聚，盡向蘆花滅。","更喜好風來，數片翻晴雪。"],"s":"trad","f":"simp"},{"i":"702741c8-6f14-4f92-9e2c-195ede060535","t":"藍田溪雜詠二十二首 遠山鐘","a":"錢起","d":"唐","g":"短诗","p":["風送出山鐘，雲霞度水淺。","欲知聲盡處，鳥滅寥天遠。"],"s":"trad","f":"simp"},{"i":"684bb5ef-edb0-45c7-b3fe-0e3fdadfc958","t":"藍田溪雜詠二十二首 東陂","a":"錢起","d":"唐","g":"短诗","p":["永日興難忘，掇芳春陂曲。","新晴花枝下，愛此苔水綠。"],"s":"trad","f":"simp"},{"i":"45cab612-ae5c-4262-891d-2a1f0a2a28e6","t":"藍田溪雜詠二十二首 池上亭","a":"錢起","d":"唐","g":"短诗","p":["臨池構杏梁，待客歸煙塘。","水上褰簾好，蓮開杜若香。"],"s":"trad","f":"simp"},{"i":"16b9f041-fd22-452c-a23e-137ee4703aee","t":"藍田溪雜詠二十二首 銜魚翠鳥","a":"錢起","d":"唐","g":"短诗","p":["有意蓮葉間，瞥然下高樹。","擘波得潛魚，一點翠光去。"],"s":"trad","f":"simp"},{"i":"3018b75e-666f-4dcb-9baa-cc5050fd2165","t":"藍田溪雜詠二十二首 石蓮花","a":"錢起","d":"唐","g":"短诗","p":["幽石生芙蓉，百花慚美色。","遠笑越溪女，聞芳不可識。"],"s":"trad","f":"simp"},{"i":"d2634eec-d22c-4240-bf42-6c8aa9fe364e","t":"藍田溪雜詠二十二首 潺湲聲","a":"錢起","d":"唐","g":"短诗","p":["亂石跳素波，寒聲聞幾處。","颼颼暝風引，散出空林去。"],"s":"trad","f":"simp"},{"i":"1ea81bc9-8f2c-45ed-9eec-04156a93b9fa","t":"藍田溪雜詠二十二首 松下雪","a":"錢起","d":"唐","g":"短诗","p":["雖因朔風至，不向瑤臺側。","唯助苦寒松，偏明後彫色。"],"s":"trad","f":"simp"},{"i":"8f65b5ec-4058-4515-bc68-719d1e163a0d","t":"藍田溪雜詠二十二首 田鶴","a":"錢起","d":"唐","g":"短诗","p":["田鶴望碧霄，無風亦自舉。","單飛後片雲，早晚及前侶。"],"s":"trad","f":"simp"},{"i":"41d92717-d215-40e4-b0bc-ae82ad0a2f32","t":"藍田溪雜詠二十二首 題南陂","a":"錢起","d":"唐","g":"短诗","p":["家住鳳城南，門臨古陂曲。","時憐上林雁，半入池塘宿。"],"s":"trad","f":"simp"},{"i":"a1d20fd6-5e74-4643-a77e-956d949927c9","t":"傷秋","a":"錢起","d":"唐","g":"短诗","p":["歲去人頭白，秋來樹葉黃。","搔頭向黃葉，與爾共悲傷。"],"s":"trad","f":"simp"},{"i":"c627c9cb-f2e3-49ad-bfb9-3639b5ffdbf3","t":"送崔山人歸山","a":"錢起","d":"唐","g":"短诗","p":["東山殘雨挂斜暉，野客巢由指翠微。","別酒稍酣乘興去，知君不羨白雲歸。"],"s":"mixed","f":"simp"},{"i":"473f9647-7a46-44ef-a302-ec4795d11019","t":"題禮上人壁畫山水","a":"錢起","d":"唐","g":"短诗","p":["連山畫出暎禪扉，粉壁香筵滿翠微。","坐來鑪氣縈空散，共指晴雲向嶺歸。"],"s":"trad","f":"simp"},{"i":"a9197f16-9922-4614-8b04-4a7ed7330780","t":"送歐陽子還江華郡","a":"錢起","d":"唐","g":"短诗","p":["江華勝事接湘濱，千里湖山入興新。","才子思歸催去櫂，汀花且爲駐殘春。"],"s":"mixed","f":"simp"},{"i":"5f1dcbca-e2c9-4a43-be80-9d51f23a6dab","t":"暮春歸故山草堂","a":"錢起","d":"唐","g":"短诗","p":["谷口春殘黃鳥稀，辛夷花盡杏花飛。","始憐幽竹山窗下，不改清陰待我歸。"],"s":"trad","f":"simp"},{"i":"f3eb2a78-af4b-4fae-b92b-d7f637c40f7d","t":"訪李卿不遇","a":"錢起","d":"唐","g":"短诗","p":["畫戟朱樓暎晚霞，高梧寒柳度飛鴉。","門前不見歸軒至，城上愁看落日斜。"],"s":"trad","f":"simp"},{"i":"b1c83a00-7713-4cbf-85c6-970cde2b6170","t":"與趙莒茶讌","a":"錢起","d":"唐","g":"短诗","p":["竹下忘言對紫茶，全勝羽客醉流霞。","塵心洗盡興難盡，一樹蟬聲片影斜。"],"s":"trad","f":"simp"},{"i":"4f5f758b-ba23-44d3-b26e-e7b0f9e728e7","t":"故王維右丞堂前芍藥花開悽然感懷","a":"錢起","d":"唐","g":"短诗","p":["芍藥花開出舊欄，春衫掩淚再來看。","主人不在花長在，更勝青松守歲寒。"],"s":"trad","f":"simp"},{"i":"46aa871a-fb98-4e33-94a7-3d250c069b34","t":"送張參及第還家","a":"錢起","d":"唐","g":"短诗","p":["大學三年聞琢玉，東堂一舉早成名。","借問還家何處好，玉人含笑下機迎。"],"s":"trad","f":"simp"},{"i":"1caa9b60-cd4d-4439-aeb7-b213034c7860","t":"夜泊鸚鵡洲","a":"錢起","d":"唐","g":"短诗","p":["月照溪邊一罩蓬，夜聞清唱有微風。","小樓深巷敲方響，水國人家在處同。"],"s":"trad","f":"simp"},{"i":"c0408a74-2d10-4fd2-a7b3-1206d341be96","t":"歸雁","a":"錢起","d":"唐","g":"短诗","p":["瀟湘何事等閑回，水碧沙明兩岸苔。","二十五弦彈夜月，不勝清怨却飛來。"],"s":"mixed","f":"simp"},{"i":"8ba31a1d-ab47-46fd-927d-342561972d35","t":"春郊","a":"錢起","d":"唐","g":"短诗","p":["水遶冰渠漸有聲，氣融煙塢晚來明。","東風好作陽和使，逢草逢花報發生。"],"s":"trad","f":"simp"},{"i":"23f178cd-1724-4283-acba-9ca26452bde2","t":"晚歸嚴明府題門","a":"錢起","d":"唐","g":"短诗","p":["降士林霑蕙草寒，弦驚翰苑失鴛鸞。","秋中回首君門阻，馬上應歌行路難。"],"s":"trad","f":"simp"},{"i":"e5980c45-6386-4d47-a777-3855fe8c70a7","t":"秋夜送趙冽歸襄陽","a":"錢起","d":"唐","g":"短诗","p":["斗酒忘言良夜深，紅萱露滴鵲驚林。","欲知別後思今夕，漢水東流是寸心。"],"s":"trad","f":"simp"},{"i":"cb877f52-1ffe-4c77-83c4-ecf32a854dca","t":"送符別駕還郡","a":"錢起","d":"唐","g":"短诗","p":["驥足駸駸吳越關，屏星復與紫書還。","已知從事元無事，城上愁看海上山。"],"s":"trad","f":"simp"},{"i":"f34518c9-3f0d-4d26-ac73-8906b9555189","t":"同王員外隴城絕句","a":"錢起","d":"唐","g":"短诗","p":["三軍版築脫金刀，黎庶翻慚將士勞。","不憶新城連嶂起，唯驚畫角入雲高。"],"s":"trad","f":"simp"},{"i":"165bf110-88b1-49a4-90c2-ef16d75281be","t":"過故洛城","a":"錢起","d":"唐","g":"短诗","p":["故城門外春日斜，故城門裏無人家。","市朝欲認不知處，漠漠野田空草花。"],"s":"mixed","f":"simp"},{"i":"ce5bf0e4-244b-47f2-88fe-9d9a0ab89aa2","t":"校獵曲","a":"錢起","d":"唐","g":"短诗","p":["長楊殺氣連雲飛，漢主秋畋正掩圍。","重門日晏紅塵出，數騎胡人獵獸歸。"],"s":"trad","f":"simp"},{"i":"2fabfce9-658e-432b-bd5e-a289140e78d7","t":"晚過橫灞寄張藍田","a":"錢起","d":"唐","g":"短诗","p":["亂水東流落照時，黃花滿徑客行遲。","林端忽見南山色，馬上還吟陶令詩。"],"s":"trad","f":"simp"},{"i":"f4e43f9b-d3b8-498f-9807-0d741f09ebf5","t":"九日田舍","a":"錢起","d":"唐","g":"短诗","p":["今日陶家野興偏，東籬黃菊映秋田。","浮雲暝鳥飛將盡，始達青山新月前。"],"s":"trad","f":"simp"},{"i":"5cc12f04-d1df-4531-a479-3d566e41e35c","t":"長安落第","a":"錢起","d":"唐","g":"短诗","p":["花繁柳暗九門深，對飲悲歌淚滿襟。","數日鶯花皆落羽，一回春至一傷心。"],"s":"trad","f":"simp"},{"i":"31012621-1bac-4c06-9d83-39e1dd2bf304","t":"二風詩   一","a":"元結","d":"唐","g":"短诗","p":["猗皇至聖兮，至惠至仁。","德施蘊蘊，蘊蘊如何。","不全不缺，莫知所貺。"],"s":"trad","f":"simp"},{"i":"e17941fc-e05a-4c23-9f3b-7ca461c66d78","t":"二風詩   二","a":"元結","d":"唐","g":"短诗","p":["猗皇至聖兮，至儉至明。","化流瀛瀛，瀛瀛如何。","不虢不赩，莫知其極。"],"s":"trad","f":"simp"},{"i":"633d9d0c-bc4e-4042-b97d-d23bdbdc2f9a","t":"二風詩   一","a":"元結","d":"唐","g":"短诗","p":["至化之深兮，猗猗娭娭。","如煦如吹，如負如持。","而不知其慈，故莫周莫止，靜和而止。"],"s":"trad","f":"simp"},{"i":"ae9fe376-c4b4-4483-a9d6-0aacd8c46635","t":"二風詩   二","a":"元結","d":"唐","g":"短诗","p":["至化之極兮，瀛瀛溶溶。","如涵如封，如隨如從。","而不知其功，故莫由莫己，順時而理。"],"s":"trad","f":"simp"},{"i":"afa55dab-a4d9-4b0e-a50b-3d005af8225a","t":"二風詩   一","a":"元結","d":"唐","g":"短诗","p":["至哉勤績，不盈不延。","誰能頌之，我請頌焉。","於戲勞王，勤亦何極。","濟爾九土，山川溝洫。"],"s":"trad","f":"simp"},{"i":"627f459c-0528-4528-af44-653bf07b8401","t":"二風詩   二","a":"元結","d":"唐","g":"短诗","p":["至哉儉德，不豐不敷。","誰能頌之，我請頌夫。","於戲勞王，儉亦何深。","戒爾萬代，奢侈荒淫。"],"s":"trad","f":"simp"},{"i":"8dfcdc1d-0ef3-4d04-8264-e45c2a2a1291","t":"二風詩   三","a":"元結","d":"唐","g":"短诗","p":["至哉茂功，不升不圯。","誰能頌之，我請頌矣。","於戲勞王，功亦何大。","去爾兆庶，洪湮災害。"],"s":"trad","f":"simp"},{"i":"ef4ef79e-b0f0-49b8-9e84-e48091c47b20","t":"二風詩","a":"元結","d":"唐","g":"短诗","p":["爲君之道，何以爲明。","功不濫賞，罪不濫刑。","讜言則聽，諂言不聽。","王至是然，可爲明焉。"],"s":"mixed","f":"simp"},{"i":"8c927eca-8188-4df5-b23f-1c08d336101c","t":"二風詩","a":"元結","d":"唐","g":"古体","p":["理何爲兮，系修文德。","加之清一，莫不順則。","意彼刑法，設以化人。","致使無之，而化益純。","所謂代刑，以道去殺。","嗚呼嗚呼，人不斯察。"],"s":"mixed","f":"simp"},{"i":"4c8844aa-297a-4b71-945d-be7b76e9b861","t":"二風詩","a":"元結","d":"唐","g":"古体","p":["國有世謨，仁信勤歟。","王實惛荒，終亡此乎。","焉有力恣諂惑，而不亡其國。","嗚呼亡王，忍爲此心。","敢正亡王，永爲世箴。"],"s":"mixed","f":"simp"},{"i":"fd7aed72-22c2-4bc0-b14d-9cd6f81a61ee","t":"二風詩   一","a":"元結","d":"唐","g":"短诗","p":["嘻乎王家，曾有凶王。","中世失國，豈非驕荒。","復復之難，令則可忘。"],"s":"mixed","f":"simp"},{"i":"e0b6700d-4b71-4ec7-ad56-f36d19217aff","t":"二風詩   二","a":"元結","d":"唐","g":"短诗","p":["嘻乎亂王，王心何思。","暴淫虐惑，無思不爲。","生人冤怨，言何極之。"],"s":"mixed","f":"simp"},{"i":"34c8fe9f-2b12-4a0d-946e-3521d1963454","t":"二風詩   一","a":"元結","d":"唐","g":"短诗","p":["夫爲君上兮，慈順明恕。","可以化人，忍行昏恣。","獨樂其身，一徇所欲。"],"s":"mixed","f":"simp"},{"i":"fb2aa59e-c19b-4dfc-a7b2-b8950927b2ad","t":"二風詩   二","a":"元結","d":"唐","g":"短诗","p":["夫爲君上兮，兢慎儉約。","可以保身，忍行荒惑。","虐暴於人，前世失國。"],"s":"mixed","f":"simp"},{"i":"5d5430c2-ffe3-4e11-8052-d3c76e65c984","t":"二風詩   一","a":"元結","d":"唐","g":"古体","p":["賢聖爲上兮，必儉約戒身。","鑒察化人，所以保福也。","如何不思，荒恣是爲。","上下隔塞，人神怨奰。","敖惡無厭，不畏顛墜。"],"s":"mixed","f":"simp"},{"i":"0092551d-9fee-4aba-a7b0-cf7d4d88a9a8","t":"二風詩   二","a":"元結","d":"唐","g":"古体","p":["聖賢爲上兮，必用賢正。","黜姦佞之臣，所以長久也。","如何反是，以爲亂矣。","寵邪信惑，近佞好諛。","廢嫡立庶，忍爲禍謨。"],"s":"mixed","f":"simp"},{"i":"6eab1b5c-be2b-448c-bf89-ccc3538b1f48","t":"二風詩","a":"元結","d":"唐","g":"古体","p":["夫何傷兮，傷王乎。","欲何爲乎，將蠹枯矣。","無人救乎，蠹枯及矣。","不可救乎，嗟傷王。","自爲人君，變爲人奴。","爲人君者，忘戒乎。"],"s":"mixed","f":"simp"},{"i":"bc9049ec-2403-4e98-ae90-0a5d1a43e0af","t":"補樂歌十首  一","a":"元結","d":"唐","g":"短诗","p":["吾人苦兮，水深深。","網罟設兮，水不深。"],"s":"trad","f":"simp"},{"i":"98a88ab8-d2ee-4d0f-bfb8-9b8da55fbf87","t":"補樂歌十首  二","a":"元結","d":"唐","g":"短诗","p":["吾人苦兮，山幽幽。","網罟設兮，山不幽。"],"s":"trad","f":"simp"},{"i":"91ee9dce-e5b4-4475-8931-a7fa153c2517","t":"補樂歌十首  一","a":"元結","d":"唐","g":"短诗","p":["猗太帝兮，其智如神。","分草實兮，濟我生人。"],"s":"trad","f":"simp"},{"i":"48a397ac-99aa-473d-97be-242f8cbfd656","t":"補樂歌十首  二","a":"元結","d":"唐","g":"短诗","p":["猗太帝兮，其功如天。","均四時兮，成我豐年。"],"s":"trad","f":"simp"},{"i":"3c7c3863-d174-4288-91b5-51fb9bfc0049","t":"補樂歌十首  一","a":"元結","d":"唐","g":"短诗","p":["玄雲溶溶兮，垂雨蒙蒙。","類我聖澤兮，涵濡不窮。"],"s":"mixed","f":"simp"},{"i":"c55496ff-61fd-426c-bdbe-44f34dbc91ac","t":"補樂歌十首  二","a":"元結","d":"唐","g":"短诗","p":["玄雲漠漠兮，含暎逾光。","類我聖德兮，溥被無方。"],"s":"trad","f":"simp"},{"i":"52b57a1a-491a-4bfd-b8fa-5beeb8258252","t":"補樂歌十首","a":"元結","d":"唐","g":"短诗","p":["聖德至深兮，奫奫如淵。","生類娭娭兮，孰知其然。"],"s":"trad","f":"simp"},{"i":"674e1155-eeba-4ff7-8a56-1a76b8909918","t":"補樂歌十首","a":"元結","d":"唐","g":"短诗","p":["植植萬物兮，滔滔根莖。","五德涵柔兮，渢渢而生。","其生如何兮秞秞，天下皆自我君兮化成。"],"s":"trad","f":"simp"},{"i":"d9fcd9a1-0683-42df-81a9-daeb1dd16e00","t":"補樂歌十首  一","a":"元結","d":"唐","g":"短诗","p":["我有金石兮，擊考崇崇。","與汝歌舞兮，上帝之風。","由六合兮，英華渢渢。"],"s":"trad","f":"simp"}]