[{"i":"3c9bcebb-a1b8-4d1f-b9f2-cbfcc7381246","t":"宮詞百首 三十四","a":"和凝","d":"唐","g":"短诗","p":["進食門前水陸陳，大官齋潔貢時新。","明君宵旰分甘處，便索金盤賜重臣。"],"s":"trad","f":"simp"},{"i":"6b92ceb0-5d1b-48d3-ad24-ef19494e7b61","t":"宮詞百首 三十五","a":"和凝","d":"唐","g":"短诗","p":["層臺金碧惹紅霞，仙掌亭亭對月華。","昨夜盤中甘露滿，婕妤爭去奏官家。"],"s":"trad","f":"simp"},{"i":"363f0def-382a-489e-b0f5-bcbc5eae07b9","t":"宮詞百首 三十六","a":"和凝","d":"唐","g":"短诗","p":["水殿垂簾冷色凝，一牀珍簟展春冰。","才人侍立持團扇，金縷雙龍貼碧藤。"],"s":"mixed","f":"simp"},{"i":"229f5468-6e5e-4001-b3fe-1b073f4764c0","t":"宮詞百首 三十七","a":"和凝","d":"唐","g":"短诗","p":["香鴨烟輕爇水沈，雲鬟閑墜鳳犀簪。","珠簾半捲開花雨，又見芭蕉展半心。"],"s":"mixed","f":"simp"},{"i":"d55f62f2-1ad1-4e6a-8aeb-55cb0c081955","t":"宮詞百首 三十八","a":"和凝","d":"唐","g":"短诗","p":["鶯錦蟬羅撒麝臍，狻猊輕噴瑞烟迷。","紅酥點得香山小，卷上珠簾日未西。"],"s":"mixed","f":"simp"},{"i":"0597fcbc-9109-408b-b5e7-c39cbe2d185c","t":"宮詞百首 三十九","a":"和凝","d":"唐","g":"短诗","p":["錦褥花明滿殿鋪，宮娥分坐學樗蒲。","欲教官馬衝關過，呪願纖纖早擲盧。"],"s":"trad","f":"simp"},{"i":"de3d7761-5202-457f-9572-5b5d69cb8d27","t":"宮詞百首 四十","a":"和凝","d":"唐","g":"短诗","p":["小樓花簇鈿山低，金雉雙來蹋馬齊。","誇向傍人能彩戲，朝來贏得鷺鷥犀。"],"s":"trad","f":"simp"},{"i":"520c8b4a-cada-4ca2-9292-7bb137e13049","t":"宮詞百首 四十一","a":"和凝","d":"唐","g":"短诗","p":["紅鬃白馬嫩龍飛，天廐供來入紫微。","遙見玉階嘶不已，應緣識得赭黃衣。"],"s":"trad","f":"simp"},{"i":"e6fe10b0-b27b-4eeb-87de-656cca3d85f7","t":"宮詞百首 四十二","a":"和凝","d":"唐","g":"短诗","p":["班定千牛立受宣，佩刀搢笏鳳墀前。","一聲不坐祥雲合，鴛鷺依行拜兩邊。"],"s":"trad","f":"simp"},{"i":"ad08479d-e6cb-4e89-b145-dde38b9f396d","t":"宮詞百首 四十三","a":"和凝","d":"唐","g":"短诗","p":["三殿香濃曉色來，祥鸞威鳳待門開。","鏘金佩玉趨丹陛，總是和羹作礪才。"],"s":"trad","f":"simp"},{"i":"dd030a3b-1cd4-4031-a2c0-cbd983438060","t":"宮詞百首 四十四","a":"和凝","d":"唐","g":"短诗","p":["兩番供奉打毬時，鸞鳳分廂錦繡衣。","虎驟龍騰宮殿響，驊騮爭趂一星飛。"],"s":"trad","f":"simp"},{"i":"3ce1747d-d625-4433-a356-b6337a26b75e","t":"宮詞百首 四十五","a":"和凝","d":"唐","g":"短诗","p":["鳳池冰泮岸莎勻，柳眼花心雪裏新。","都是九重和暖地，東風先報禁園春。"],"s":"mixed","f":"simp"},{"i":"d7640ae7-cead-4d2c-be81-156bc2d9a696","t":"宮詞百首 四十六","a":"和凝","d":"唐","g":"短诗","p":["紫氣氤氳滿帝都，映樓明月鎖金鋪。","銀泥殿裏嫌紅燭，教近龍牀著火珠。"],"s":"mixed","f":"simp"},{"i":"f4101b89-17e4-4c2d-a084-a1966120427e","t":"宮詞百首 四十七","a":"和凝","d":"唐","g":"短诗","p":["地衣初展瑞霞融，繡帽金鈴舞舜風。","吹竹彈絲珠殿響，墜仙雙降五雲中。"],"s":"trad","f":"simp"},{"i":"4ea3582c-eead-4a30-8e33-84dfdf944556","t":"宮詞百首 四十八","a":"和凝","d":"唐","g":"短诗","p":["錦策勻鋪寒玉齊，星鎚高運日通犀。","鏗金曲罷春冰碎，跪拜君王粉面低。"],"s":"trad","f":"simp"},{"i":"96876501-ed4a-48d5-be12-3882f5b75321","t":"宮詞百首 四十九","a":"和凝","d":"唐","g":"短诗","p":["珠簾靜卷水亭涼，玉蘂風飄小檻香。","幾處按歌齊入破，雙雙雛燕出宮墻。"],"s":"trad","f":"simp"},{"i":"b2912095-825f-4442-92e6-8b040845545b","t":"宮詞百首 五十","a":"和凝","d":"唐","g":"短诗","p":["宮娥解禊豔陽時，鷁舸蘭橈滿鳳池。","春水如藍垂柳醉，和風無力褭金絲。"],"s":"trad","f":"simp"},{"i":"2117ca2b-c495-4f58-bc71-3a906f4527dd","t":"宮詞百首 五十一","a":"和凝","d":"唐","g":"短诗","p":["白玉階前菊蘂香，金盃仙醞賞重陽。","層臺雲集梨園樂，獻壽聲聲祝萬康。"],"s":"trad","f":"simp"},{"i":"9694c0fd-cb05-4feb-a493-c4804da7d0ce","t":"宮詞百首 五十二","a":"和凝","d":"唐","g":"短诗","p":["天籟吟風社燕歸，渚蓮香老碧苔肥。","夜來霜墜梧桐葉，諸殿平明進御衣。"],"s":"trad","f":"simp"},{"i":"b5df674a-f665-4c17-a00f-3cad423dfd48","t":"宮詞百首 五十三","a":"和凝","d":"唐","g":"短诗","p":["鑪爇香檀獸炭癡，真珠簾外雪花飛。","六宮進酒堯眉壽，舞鳳盤龍滿御衣。"],"s":"mixed","f":"simp"},{"i":"f277909c-f523-44f6-a8e6-395226aedce5","t":"宮詞百首 五十四","a":"和凝","d":"唐","g":"短诗","p":["雲行風靜早秋天，競遶盆池蹋采蓮。","罨畫披袍從窣地，更尋宮柳看鳴蟬。"],"s":"mixed","f":"simp"},{"i":"d78941c4-cfd9-45f5-8e59-5ae1fe0ae8e8","t":"宮詞百首 五十五","a":"和凝","d":"唐","g":"短诗","p":["闌珊星斗綴珠光，七夕宮嬪乞巧忙。","總上穿針樓上去，競看銀漢灑瓊槳。"],"s":"trad","f":"simp"},{"i":"e612ccbf-4e9c-4f9a-bcc5-4329659b4eac","t":"宮詞百首 五十六","a":"和凝","d":"唐","g":"短诗","p":["寶瑟淒鏘夜漏餘，玉階閑作對蟾蜍。","秋光寂歷銀河轉，已見宮花露滴疎。"],"s":"trad","f":"simp"},{"i":"5cd10ff7-abc8-477e-b65f-04dd708aceb0","t":"宮詞百首 五十七","a":"和凝","d":"唐","g":"短诗","p":["春風金褭萬年枝，簇白團紅爛熳時。","宮女競思遊御苑，大家齊奏聖人知。"],"s":"trad","f":"simp"},{"i":"4218179e-9be3-4cd3-9085-b001298c8499","t":"宮詞百首 五十八","a":"和凝","d":"唐","g":"短诗","p":["乾文初見泰階平，日月常遵閣道行。","昨夜仰觀垂象正，拱辰星宿轉分明。"],"s":"trad","f":"simp"},{"i":"a7faa6fd-fa3d-442c-9e65-0079bd2864d5","t":"宮詞百首 五十九","a":"和凝","d":"唐","g":"短诗","p":["鏘鏘濟濟赴延英，漸近重瞳目轉明。","君聖臣賢魚水契，鴻基須賀永清平。"],"s":"trad","f":"simp"},{"i":"059eede5-38c7-4705-ad6a-e5e6b682dc43","t":"宮詞百首 六十","a":"和凝","d":"唐","g":"短诗","p":["天廐驂騑集嫩龍，雪光相照曉嘶風。","昂頭步步金鞍穩，掌扇花前御路中。"],"s":"trad","f":"simp"},{"i":"5f6a9b12-faa7-4346-b3a0-5b556be28e36","t":"宮詞百首 六十一","a":"和凝","d":"唐","g":"短诗","p":["金吾細仗儼威儀，聖旨凝旒對遠夷。","曉日曈曨瞻玉案，丁冬環珮滿彤墀。"],"s":"trad","f":"simp"},{"i":"c2a82481-1ace-4bd2-a0bf-dfe0fb0c69c9","t":"宮詞百首 六十二","a":"和凝","d":"唐","g":"短诗","p":["正旦垂旒御八方，蠻夷無不奉梯航。","羣臣舞蹈稱觴處，雷動山呼萬歲長。"],"s":"mixed","f":"simp"},{"i":"7b559b4d-d1e2-4635-9a47-89c40d1b6f0e","t":"宮詞百首 六十三","a":"和凝","d":"唐","g":"短诗","p":["聖主躬耕在籍田，公卿環衛待豐年。","五風十雨餘糧在，金殿惟聞奏舜弦。"],"s":"trad","f":"simp"},{"i":"b29622a2-4a36-40e2-9491-b8642ad54485","t":"宮詞百首 六十四","a":"和凝","d":"唐","g":"短诗","p":["聖日垂科委所司，英才咸喜遇明時。","春宮進榜鶯離谷，月殿香殘桂魄枝。"],"s":"mixed","f":"simp"},{"i":"94c81275-e60e-4584-ad91-230f21a4d006","t":"宮詞百首 六十五","a":"和凝","d":"唐","g":"短诗","p":["天街香滿瑞雲生，紅繖凝空景日明。","先遣五坊排獵騎，爲民除害出神京。"],"s":"mixed","f":"simp"},{"i":"1043224c-4175-4cc2-b79e-793b0c1a3a8b","t":"宮詞百首 六十六","a":"和凝","d":"唐","g":"短诗","p":["內宴初開錦繡攢，教坊齊奏萬年歡。","簫韶響亮春雲合，日照堯階舞瑞鸞。"],"s":"trad","f":"simp"},{"i":"26aa95a2-0ce1-46d9-9c1f-b456ece3da76","t":"宮詞百首 六十七","a":"和凝","d":"唐","g":"短诗","p":["視草詞臣直玉堂，對來新賜錦袍香。","班資最在雲霄上，長是先迎日月光。"],"s":"trad","f":"simp"},{"i":"6b45df08-0e60-4432-af84-75c44e52adec","t":"宮詞百首 六十八","a":"和凝","d":"唐","g":"短诗","p":["玉殿朦朧散曉光，金龍高噴九天香。","摵鞭聲定初開扇，百辟齊呼萬歲長。"],"s":"trad","f":"simp"},{"i":"3e859019-c295-47cd-8d60-e3db82d7af27","t":"宮詞百首 六十九","a":"和凝","d":"唐","g":"短诗","p":["五色卿雲復九重，香烟高舞御鑪中。","含元殿裏行仁德，四海車書已混同。"],"s":"mixed","f":"simp"},{"i":"b0d5e701-0c4f-4d70-a1e6-805b40fac44a","t":"宮詞百首 七十","a":"和凝","d":"唐","g":"短诗","p":["欲封丹詔紫泥香，朱篆龍文御印光。","汗渙絲綸出丹禁，便從天上鳳銜將。"],"s":"trad","f":"simp"},{"i":"c3149101-2c23-4a1a-82fd-6c0b8cfaa2ed","t":"宮詞百首 七十一","a":"和凝","d":"唐","g":"短诗","p":["越溪姝麗入深宮，儉素皆持馬后風。","盡道君王修聖德，不勞辭輦與當熊。"],"s":"mixed","f":"simp"},{"i":"fe9539a6-3ca2-4640-8310-c8a692b2774c","t":"宮詞百首 七十二","a":"和凝","d":"唐","g":"短诗","p":["早梅初向雪中明，風惹奇香粉蘂輕。","誰道落花堪靧面，競來枝上采繁英。"],"s":"mixed","f":"simp"},{"i":"2d4499d2-74b2-4c70-ad9f-f59e545c1485","t":"宮詞百首 七十三","a":"和凝","d":"唐","g":"短诗","p":["暖殿奇香馥綺羅，窗間初學繡金鵝。","纔經冬至陽生後，今日工夫一綫多。"],"s":"mixed","f":"simp"},{"i":"028fd9cb-aae9-467b-9ec9-a874049d7cfd","t":"宮詞百首 七十四","a":"和凝","d":"唐","g":"短诗","p":["金井澄泉玉液香，瑠璃深殿自清涼。","溫湯頭進瓜初熟，後至宮嬪未得嘗。"],"s":"trad","f":"simp"},{"i":"85e18ef0-e374-4aa5-8d66-1283eb4a21d2","t":"宮詞百首 七十五","a":"和凝","d":"唐","g":"短诗","p":["繡闥雕甍列錦閨，珍奇惟待鳳凰棲。","杏梁烜赫晴霞展，時見空虛墜燕泥。"],"s":"trad","f":"simp"},{"i":"09bfb573-c6f8-4735-8f2b-2692bd6428b2","t":"宮詞百首 七十六","a":"和凝","d":"唐","g":"短诗","p":["龍鳳金鞍軟玉緶，雪花光照錦連乾。","駕頭直指西郊去，曉日寒生講武天。"],"s":"trad","f":"simp"},{"i":"e903f796-2526-4e5a-b457-14b8809e9a72","t":"宮詞百首 七十七","a":"和凝","d":"唐","g":"短诗","p":["戛雲樓上定風盤，雀躍猨跳總不難。","要對君王逞輕捷，御樓時擬上雞竿。"],"s":"trad","f":"simp"},{"i":"5535fedb-4dea-49bc-a28d-9f5d04b259c6","t":"宮詞百首 七十八","a":"和凝","d":"唐","g":"短诗","p":["停穩春衫窣地長，通天犀帶綴金章。","近臣銜命離丹禁，高捧恩波灑萬方。"],"s":"trad","f":"simp"},{"i":"b64f4cd3-b066-41aa-a7be-3e636ab2a855","t":"宮詞百首 七十九","a":"和凝","d":"唐","g":"短诗","p":["垂黎玉押春簾卷，不夜珠樓曉鑑開。","袍袴宮人走迎駕，東風吹送御香來。"],"s":"trad","f":"simp"},{"i":"88f70686-fed1-4970-8b0a-3439826865df","t":"宮詞百首 八十","a":"和凝","d":"唐","g":"短诗","p":["金吾勘契自通宮，樓上初聞唱刻閑。","金殿香高初喚仗，數行鴛鷺各趨班。"],"s":"trad","f":"simp"},{"i":"86bfef90-3d8a-4b6e-93ab-e3d512d8b2ed","t":"宮詞百首 八十一","a":"和凝","d":"唐","g":"短诗","p":["螺髻凝香曉黛濃，水精鸂鶒颭輕風。","金釵斜戴宜春勝，萬歲千秋遶鬢紅。"],"s":"trad","f":"simp"},{"i":"5a66b1a8-17b5-4e0f-b63f-f0967375beb7","t":"宮詞百首 八十二","a":"和凝","d":"唐","g":"短诗","p":["縷金團扇對纖絺，正是深宮捧日時。","要對君王說幽意，低頭佯念婕妤詩。"],"s":"trad","f":"simp"},{"i":"8aa46013-017c-4655-a3cf-416e36a27947","t":"宮詞百首 八十三","a":"和凝","d":"唐","g":"短诗","p":["結金冠子學梳蟬，碾玉蜻蜓綴鬢偏。","寢殿垂簾悄無事，試香閑立御爐前。"],"s":"trad","f":"simp"},{"i":"0719c042-94f4-4154-be48-f54a75958260","t":"宮詞百首 八十四","a":"和凝","d":"唐","g":"短诗","p":["金馬詞臣夜受宣，授毫交直八花磚。","白麻草了初呈進，稱旨絲綸下九天。"],"s":"trad","f":"simp"},{"i":"657183f1-cea5-4745-a251-31bb5024b22b","t":"宮詞百首 八十五","a":"和凝","d":"唐","g":"短诗","p":["平明光政便門開，已見忠臣早入來。","自是樞機符造化，大羅天上曜三台。"],"s":"mixed","f":"simp"},{"i":"cb4d7727-0ead-43ce-b640-e9fd3a9f4925","t":"宮詞百首 八十六","a":"和凝","d":"唐","g":"短诗","p":["紅羅窗裏繡偏慵，嚲袖閑隈碧玉籠。","蘭殿春晴鸚鵡睡，結條釵颭落花風。"],"s":"mixed","f":"simp"},{"i":"6985155d-71c3-4dc2-aa77-c3cd0e5233d0","t":"宮詞百首 八十七","a":"和凝","d":"唐","g":"短诗","p":["曉光初入右銀臺，鴛鷺分班啓沃來。","如水如魚何際會，盡言金鼎得鹽梅。"],"s":"mixed","f":"simp"},{"i":"88c63c2e-7743-4a99-8382-547a3aca7ea5","t":"宮詞百首 八十八","a":"和凝","d":"唐","g":"短诗","p":["立名金馬近堯階，盡是家傳八斗才。","麻尾尚猶龍字濕，便從天上鳳銜來。"],"s":"trad","f":"simp"},{"i":"88ad98ae-09a1-46c6-a310-812929321678","t":"宮詞百首 八十九","a":"和凝","d":"唐","g":"短诗","p":["狻猊鎮角舞筵張，鸞鳳花分十六行。","輕動玉纖歌遍慢，時時偷眼看君王。"],"s":"trad","f":"simp"},{"i":"9768b94c-defb-46dc-835b-8e1742c09487","t":"宮詞百首 九十","a":"和凝","d":"唐","g":"短诗","p":["邊藩□宴賀休征，細仗初排舜日明。","坐定兩軍呈百戲，樂臣低折賀昇平。"],"s":"mixed","f":"simp"},{"i":"4c1c79a0-506f-40d8-be6d-6c202147d13a","t":"宮詞百首 九十一","a":"和凝","d":"唐","g":"短诗","p":["碧羅冠子簇香蓮，結勝雙銜利市錢。","花下貪忙尋百草，不知遺却蹙金蟬。"],"s":"mixed","f":"simp"},{"i":"4202f1c5-bd01-4969-9bc8-2184bb1aec4f","t":"宮詞百首 九十二","a":"和凝","d":"唐","g":"短诗","p":["蘭省初除傅粉郎，靜端霜簡入鴛行。","明庭轉制渾無事，朝下空餘雞舌香。"],"s":"trad","f":"simp"},{"i":"8c76c529-a6a0-4456-9627-f5fec91a7785","t":"宮詞百首 九十三","a":"和凝","d":"唐","g":"短诗","p":["采訪寧遺草澤人，詔搜無不降蒲輪。","集賢殿裏開爐冶，待把黃金鑄重臣。"],"s":"mixed","f":"simp"},{"i":"daef5f15-9e75-4232-b8a0-5393102e3586","t":"宮詞百首 九十四","a":"和凝","d":"唐","g":"短诗","p":["紅玉纖纖捧暖笙，絳唇呼吸引春鶯。","霓裳曲罷君王笑，宜近前來與改名。"],"s":"trad","f":"simp"},{"i":"4ea6c080-b1a6-4684-bf23-e3bafa73e732","t":"宮詞百首 九十五","a":"和凝","d":"唐","g":"短诗","p":["繡額朱門插艾人，羞將角黍近香唇。","平明朝下誇宣賜，五色香絲繫臂新。"],"s":"trad","f":"simp"},{"i":"d7112dbd-9e83-45c5-ac23-bf534a0939ff","t":"宮詞百首 九十六","a":"和凝","d":"唐","g":"短诗","p":["芙蓉冠子水精簪，閑對君王理玉琴。","鷺頸鶯脣勝仙子，步虛聲細象窗深。"],"s":"mixed","f":"simp"},{"i":"20d84435-a921-4dba-879d-5ec136ad2aeb","t":"宮詞百首 九十七","a":"和凝","d":"唐","g":"短诗","p":["金馬門開侍從歸，御香猶惹賜來衣。","曉光滿院金魚冷，紅藥花擎宿露飛。"],"s":"trad","f":"simp"},{"i":"0aa35cdf-cfb3-40fe-83c9-ee0b142e7f21","t":"宮詞百首 九十八","a":"和凝","d":"唐","g":"短诗","p":["便殿朝回卸玉簪，競來芳檻摘花心。","風和難捉花中蝶，却向窗間弄繡針。"],"s":"mixed","f":"simp"},{"i":"df2fdfdd-5d47-4ff3-8e3b-e4f37256693e","t":"宮詞百首 九十九","a":"和凝","d":"唐","g":"短诗","p":["君王朝下未梳頭，長暈殘眉侍鑑樓。","扼臂交光紅玉軟，起來重擬理箜篌。"],"s":"trad","f":"simp"},{"i":"b7c620e5-fb8c-45d8-ac8b-8b7da59b8bd4","t":"宮詞百首 一百","a":"和凝","d":"唐","g":"短诗","p":["九重天上實難知，空遣微臣役夢思。","葵藿一心期捧日，強搜狂斐擬宮詞。"],"s":"trad","f":"simp"},{"i":"d616544a-58e5-4e84-9bb6-e60549e48ce8","t":"漁父歌","a":"和凝","d":"唐","g":"短诗","p":["白芷汀寒立鷺鷥，蘋風輕翦浪花時。","煙羃羃，日遲遲，香引芙蓉惹釣絲。"],"s":"trad","f":"simp"},{"i":"54b7ac35-fd28-4b79-8064-2fa92d69a8f7","t":"楊柳枝 一","a":"和凝","d":"唐","g":"短诗","p":["軟碧搖烟似送人，映花時把翠眉嚬。","青青自是風流主，慢颭金絲待洛神。"],"s":"mixed","f":"simp"},{"i":"7f901b1c-e4d4-48ef-9221-fb88a2e61aef","t":"楊柳枝 二","a":"和凝","d":"唐","g":"短诗","p":["瑟瑟羅裙金縷腰，黛眉隈破未重描。","醉來齩損新花子，拽住仙郎盡放嬌。"],"s":"trad","f":"simp"},{"i":"ac980cbc-d0f9-473c-b4b3-33589ac78b55","t":"楊柳枝 三","a":"和凝","d":"唐","g":"短诗","p":["鵲橋初就咽銀河，今夜仙郎自姓和。","不是昔年攀桂樹，豈能月裏索姮娥。"],"s":"mixed","f":"simp"},{"i":"4aa80578-413a-4eee-8bc3-43b03b0d002a","t":"解紅歌","a":"和凝","d":"唐","g":"短诗","p":["百戲罷，五音清，解紅一曲新教成。","兩個瑤池小仙子，此時奪却柘枝名。"],"s":"mixed","f":"simp"},{"i":"81402442-de07-4c52-9dd1-be8da36819ad","t":"題鷹獵兔畫","a":"和凝","d":"唐","g":"短诗","p":["雖是丹青物，沈吟亦可傷。","君誇鷹眼疾，我憫兔心忙。","豈動騷人興，惟增獵客狂。","鮫綃百餘尺，爭及製衣裳。"],"s":"trad","f":"simp"},{"i":"9e1efc81-76ee-4de1-9790-903686d5e018","t":"醴泉院","a":"和凝","d":"唐","g":"短诗","p":["萬山嵐靄簇洋城，數處禪齋盡有名。","古柏八株堆翠色，靈泉一派逗寒聲。","暫遊頗愛閑滋味，久住翻嫌俗性情。","珍重支公每相勉，我于儒行也修行。"],"s":"mixed","f":"simp"},{"i":"c01be0d9-71cf-4733-90bb-97fca42039fd","t":"興勢觀","a":"和凝","d":"唐","g":"短诗","p":["山名興勢鎮梁洋，儼有真風福此方。","瘦柏握盤籠殿紫，靈泉澄潔浸花香。","暫遊頗愛閑人少，久住翻嫌白日忙。","只向五千文字內，願成金骨住仙鄉。"],"s":"trad","f":"simp"},{"i":"961503a7-cf65-4ae9-a873-03f9dee1f343","t":"洋川","a":"和凝","d":"唐","g":"短诗","p":["華夷圖上見洋川，知在青山綠水邊。","官閑最好遊僧舍，江近應須買釣船。"],"s":"trad","f":"simp"},{"i":"b8d02e2d-8b03-4e1a-aaba-a1b6fe33b429","t":"句","a":"和凝","d":"唐","g":"短诗","p":["先生自舞琴。","波上人如潘玉兒，掌中花似趙飛燕。"],"s":"trad","f":"simp"},{"i":"fd11f8f2-028a-4479-ba65-f988e7ddef7b","t":"從蜀後主幸秦川上梓潼山","a":"王仁裕","d":"唐","g":"短诗","p":["綵仗拂寒煙，鳴騶在半天。","黃雲生馬足，白日下松巔。","盛德安疲俗，仁風扇極邊。","前程問成紀，此去尚三千。"],"s":"trad","f":"simp"},{"i":"a0d401a3-d85b-45f5-9b51-9245a0b29340","t":"和蜀後主題劒門","a":"王仁裕","d":"唐","g":"短诗","p":["孟陽曾有語，刊在白雲稜。","李杜常挨托，孫劉亦恃憑。","庸才安可守，上德始堪矜。","暗指長天路，濃巒蔽幾層。"],"s":"trad","f":"simp"},{"i":"37c93c13-19ca-49ce-890e-b2a1073c7694","t":"荆南席上詠胡琴妓二首 一","a":"王仁裕","d":"唐","g":"短诗","p":["紅妝齊抱紫檀槽，一抹朱弦四十條。","湘水淩波慚鼓瑟，秦樓明月罷吹簫。","寒敲白玉聲偏婉，暖逼黃鶯語自嬌。","丹禁舊臣來側耳，骨清神爽似聞韶。"],"s":"mixed","f":"simp"},{"i":"72b8a953-409b-40a5-a8ad-883b4d0e3d4e","t":"荆南席上詠胡琴妓二首 二","a":"王仁裕","d":"唐","g":"短诗","p":["玉纖挑落折冰聲，散入秋空韻轉清。","二五指中句塞雁，十三弦上囀春鶯。","譜從陶室偷將妙，曲向秦樓寫得成。","無限細腰宮裏女，就中偏愜楚王情。"],"s":"mixed","f":"simp"},{"i":"e6247b20-a2c9-4850-93ce-f0d11aedb09e","t":"題麥積山天堂","a":"王仁裕","d":"唐","g":"短诗","p":["躡盡懸空萬仞梯，等閑身共白雲齊。","簷前下視羣山小，堂上平分落日低。","絕頂路危人少到，古巖松健鶴頻棲。","天邊爲要留名姓，拂石殷勤身自題。"],"s":"mixed","f":"simp"},{"i":"e06d0ab0-a6aa-4523-acc7-e5e6f05c37a7","t":"題斗山觀","a":"王仁裕","d":"唐","g":"短诗","p":["霞衣欲舉醉陶陶，不覺全家住絳霄。","拔宅只知雞犬在，上天誰信路岐遙。","三清遼廊拋塵夢，八景雲煙事早朝。","爲有故林蒼柏健，露華涼葉鎖金飆。"],"s":"mixed","f":"simp"},{"i":"5e081164-bdc3-4f92-93b1-9fe47045ebf7","t":"題孤雲絶頂淮陰祠","a":"王仁裕","d":"唐","g":"短诗","p":["一握寒天古木深，路人猶說漢淮陰。","孤雲不掩興亡策，兩角曾懸去住心。","不是冕旒輕布素，豈勞丞相遠追尋。","當時若放還西楚，尺寸中華未可侵。"],"s":"trad","f":"simp"},{"i":"7ecc63b6-9fda-4e5a-8e4f-be38e38150b2","t":"和韓昭從駕過白衛嶺","a":"王仁裕","d":"唐","g":"短诗","p":["龍斾飄颻指極邊，到時猶更二三千。","登高曉蹋巉巖石，冒冷朝衝斷續煙。","自學漢皇開土宇，不同周穆好神仙。","秦民莫遣無恩及，大散關東別有天。"],"s":"trad","f":"simp"},{"i":"6804fe1d-98d6-45de-8cb7-69acdd2a38d4","t":"賀王溥入相","a":"王仁裕","d":"唐","g":"短诗","p":["一戰文場拔趙旗，便調金鼎佐無爲。","白麻驟降恩何極，黃髮初聞喜可知。","跋勅案前人到少，築沙堤上馬歸遲。","立班始得遙相見，親洽爭如未貴時。"],"s":"mixed","f":"simp"},{"i":"36f0ca4a-62f6-4c68-8a81-96a1561ca05c","t":"與諸門生春日會飲繁臺賦","a":"王仁裕","d":"唐","g":"短诗","p":["柳陰如霧絮成堆，又引門生飲古臺。","淑景即隨風雨去，芳樽宜命管弦開。","謾誇列鼎鳴鐘貴，寧免朝烏夜兔催。","爛醉也須詩一首，不能空放馬頭回。"],"s":"mixed","f":"simp"},{"i":"ce95e775-7127-4a40-acab-439564dd1d8e","t":"示諸門生","a":"王仁裕","d":"唐","g":"短诗","p":["二百一十四門生，春風初長羽毛成。","擲金換得天邊桂，鑿壁偷將榜上名。","何辛不才逢聖世，偶將疎網罩羣英。","衰翁漸老兒孫小，異日知誰略有情。"],"s":"mixed","f":"simp"},{"i":"948b988f-b7b3-428a-b6a4-d5f9bac17dc5","t":"過平戎谷弔胡翽","a":"王仁裕","d":"唐","g":"短诗","p":["立馬荒郊滿目愁，伊人何罪死林丘。","風號古木悲長在，雨濕寒莎淚暗流。","莫道文章爲衆嫉，只應輕薄是身讐。","不緣魂寄孤山下，此地堪名鸚鵡洲。"],"s":"mixed","f":"simp"},{"i":"593d8f0a-774f-45c2-a38c-1593144c1d5a","t":"奉詔賦劒州途中鷙獸","a":"王仁裕","d":"唐","g":"短诗","p":["劒牙釘舌血毛腥，窺算勞心豈暫停。","不與大朝除患難，惟餘當路食生靈。","從將戶口資嚵口，未委三丁稅幾丁。","今日帝王親出狩，白雲巖下好藏形。"],"s":"trad","f":"simp"},{"i":"85683f0a-98d9-472c-9988-7fbd46cd61ed","t":"放猿","a":"王仁裕","d":"唐","g":"短诗","p":["放爾丁寧復故林，舊來行處好追尋。","月明巫峽堪憐靜，路隔巴山莫厭深。","棲宿免勞青嶂夢，躋攀應愜白雲心。","三秋果熟松梢健，任抱高枝徹曉吟。"],"s":"trad","f":"simp"},{"i":"43d1a72b-348f-4231-b98a-c9b03ffdeba8","t":"遇放猿再作","a":"王仁裕","d":"唐","g":"短诗","p":["嶓冢祠前漢水濱，飲猿連臂下嶙峋。","漸來子細窺行客，認得依稀是野賓。","月宿從勞羈絏夢，松餐非復稻粱身。","數聲腸斷和雲呌，識是前時舊主人。"],"s":"trad","f":"simp"},{"i":"d6cb87a3-68af-48b3-921a-dca670fd2d9a","t":"句","a":"王仁裕","d":"唐","g":"短诗","p":["鐵鎖寨門扃白日，大張旗幟插青天。"],"s":"trad","f":"simp"},{"i":"0fd804ba-2f5d-4176-a481-1f63620452f3","t":"天道","a":"馮道","d":"唐","g":"短诗","p":["窮達皆由命，何勞發歎聲。","但知行好事，莫要問前程。","冬去冰須泮，春來草自生。","請君觀此理，天道甚分明。"],"s":"trad","f":"simp"},{"i":"505ac72c-43b4-4a40-a307-3e26980c6789","t":"偶作","a":"馮道","d":"唐","g":"短诗","p":["莫爲危時便愴神，前程往往有期因。","須知海嶽歸明主，未必乾坤陷吉人。","道德幾時曾去世，舟車何處不通津？","但教方寸無諸惡，狼虎叢中也立身。"],"s":"mixed","f":"simp"},{"i":"3f02b511-c2d6-492c-87bb-d5e3d44170c0","t":"北使還京作","a":"馮道","d":"唐","g":"短诗","p":["去年今日奉皇華，只爲朝廷不爲家。","殿上一杯天子泣，門前雙節國人嗟。","龍荒冬往時時雪，兔苑春歸處處花。","上下一行如骨肉，幾人身死掩風沙。"],"s":"mixed","f":"simp"},{"i":"a43fae35-3168-4909-aa05-9c7342e1169c","t":"贈竇十","a":"馮道","d":"唐","g":"短诗","p":["燕山竇十郎，教子有義方。","靈椿一株老，丹桂五枝芳。"],"s":"trad","f":"simp"},{"i":"635822c3-e7b0-4ef8-95bf-b0aa2bb092f4","t":"放魚書所鑰戶","a":"馮道","d":"唐","g":"短诗","p":["高卻垣牆鑰却門，監丞從此罷垂綸。","池中魚鱉應相賀，從此方知有主人。"],"s":"mixed","f":"simp"},{"i":"6231bb7f-5249-4221-b07c-7ee2639bb836","t":"句","a":"馮道","d":"唐","g":"短诗","p":["朝披四襖專藏手，夜覆三衾怕露頭。","牛頭偏得賜，象笏更容持。","已落地花方遣埽，未經霜草莫教鋤。","視草北來唐學士，擁旄西去漢將軍。"],"s":"trad","f":"simp"},{"i":"e3db7e75-942e-4c0b-825e-2e2e5b8d7228","t":"後唐宗廟樂舞辭","a":"盧文紀","d":"唐","g":"短诗","p":["仁君御宇，環海謐清。","運符武德，道協文明。","九成式敍，百度惟成。","金門積慶，玉葉傳榮。"],"s":"trad","f":"simp"}]