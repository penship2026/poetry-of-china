[{"i":"c-190c68b65e7a","t":"南歌子","a":"吕本中","d":"宋","g":"词","p":["驿路侵斜月，溪桥度晓霜。","短篱残菊一枝黄。","正是乱山深处、过重阳。","旅枕元无梦，寒更每自长。","只言江左好风光。","不道中原归思、转凄凉。"]},{"i":"c-600ac3adddd5","t":"虞美人","a":"吕本中","d":"宋","g":"词","p":["梅花自是于春懒。","不是春来晚。","看伊开在众花前。","便道与春无分、结因缘。","风前月下频相就。","笑我如伊瘦。","几回冲雨过疏篱。","已见一番青子、缀残枝。"]},{"i":"c-4fb8062cdee1","t":"虞美人","a":"吕本中","d":"宋","g":"词","p":["平生臭味如君少。","自是君难老。","似侬憔悴更谁知。","只道心情、不似少年时。","春风也到江南路。","小槛花深处。","对人不是忆姚黄。","实是旧时风味、老难忘。"]},{"i":"c-544573c6368c","t":"浣溪沙","a":"吕本中","d":"宋","g":"词","p":["暖日温风破浅寒。","短青无数簇幽栏。","三年春在病中看。","中酒心情浑似梦，探花时候不曾闲。","几年芳信隔秦关。"]},{"i":"c-fde3ebb44f07","t":"浣溪沙","a":"吕本中","d":"宋","g":"词","p":["共饮昏昏到暮鸦。","不须春日念京华。","迩来沈醉是生涯。","不是对君犹惜醉，只嫌春病却怜他。","愿为蜂采落残花。"]},{"i":"c-54ddfbdedfe1","t":"长相思","a":"吕本中","d":"宋","g":"词","p":["要相忘。","不相忘。","玉树郎君月艳娘。","几回曾断肠。","欲下床。","却上床。","上得床来思旧乡。","北风吹梦长。"]},{"i":"c-be4f2f042a82","t":"减字木兰花","a":"吕本中","d":"宋","g":"词","p":["去年今夜。","同醉月明花树下。","此夜江边。","月暗长堤柳暗船。","故人何处。","带我离愁江外去。","来岁花前。","又是今年忆去年。"]},{"i":"c-3d08eb490de6","t":"菩萨蛮","a":"吕本中","d":"宋","g":"词","p":["客愁不到西池路。","残春又逐花飞去。","今日傍池行。","新荷昨夜生。","故人千虑绕。","不道书来少。","去住隔关河。","长亭风雨多。"]},{"i":"c-dac0d023c2d5","t":"菩萨蛮","a":"吕本中","d":"宋","g":"词","p":["高楼只在斜阳里。","春风淡荡人声喜。","携客不嫌频。","使君如酒醇。","花光人不会。","月色须君醉。","月色与花光。","共成今夜长。"]},{"i":"c-46650ac959d6","t":"菩萨蛮","a":"吕本中","d":"宋","g":"词","p":["登楼一望南山雪。","使君风味如新月。","月向雪前明。","主人今夜情。","平生相与意。","老病犹堪记。","对酒为君欢。","酒杯嫌未宽。"]},{"i":"c-fd76861df0c9","t":"踏莎行","a":"吕本中","d":"宋","g":"词","p":["雪似梅花，梅花似雪。","似和不似都奇绝。","恼人风味阿谁知，请君问取南楼月。","记得旧时，探梅时节。","老来旧事无人说。","为谁醉倒为谁醒，到今犹恨轻离别。"]},{"i":"c-b5524adba8c6","t":"清平乐","a":"吕本中","d":"宋","g":"词","p":["故人何处。","同在江南路。","百种旧愁分不去。","枉被落花留住。","旧愁百种谁知。","除非是见伊时。","最是一春多病，等闲过了酴醿。"]},{"i":"c-401e8f16afce","t":"渔家傲","a":"吕本中","d":"宋","g":"词","p":["小院悠悠春未远。","牡丹昨夜开犹浅。","珍重使君帘尽卷。","风欲转。","绿阴掩映栏干晚。","记得旧时清夜短。","洛阳芳讯时相伴。","一朵姚黄䯳髻满。","情未展。","新来衰病无人管。"]},{"i":"c-c625059f38f4","t":"生查子","a":"吕本中","d":"宋","g":"词","p":["残春雾雨馀，小院黄昏后。","说道觅新词，把酒来相就。","酴醿插髻云，岁岁长如旧。","不是做词迟，却怕添伊瘦。"]},{"i":"c-34b14cf6a1ef","t":"满江红","a":"吕本中","d":"宋","g":"词","p":["东里先生，家何在、山阴溪曲。","对一川平野，数间茅屋。","昨夜冈头新雨过，门前流水清如玉。","抱小桥、回合柳参天，摇新绿。","疏篱下，丛丛菊。","虚檐外，萧萧竹。","叹古今得失，是非荣辱。","须信人生归去好，世间万事何时足。","问此春、春酝酒何如，今朝熟。"]},{"i":"c-95881d789c2b","t":"浪淘沙","a":"吕本中","d":"宋","g":"词","p":["柳色过疏篱。","花又离披。","旧时心绪没人知。","记得一年寒食下，独自归时。","归后却寻伊。","月上嫌迟。","十分斟酒不推辞。","将为老来浑忘却，因甚沾衣。"]},{"i":"c-8ba10503e1a1","t":"浪淘沙","a":"吕本中","d":"宋","g":"词","p":["柳塘新涨。","艇子操双浆。","闲倚曲楼成怅望。","是处春愁一样。","傍人几点飞花。","夕阳又送栖鸦。","试问画楼西畔，暮云恐近天涯。"]},{"i":"c-f99b916cbefb","t":"生查子","a":"吕本中","d":"宋","g":"词","p":["双双小凤斜，淡淡鸦儿稳。","一曲渭城歌，柳色饶春恨。","离觞洗别愁，酒尽愁难尽。","宝瑟雁纵横，谁寄天涯信。"]},{"i":"c-2830685000fc","t":"生查子","a":"吕本中","d":"宋","g":"词","p":["人分南浦春，酒把阳关盏。","衣带自无情，顿为离人缓。","愁随苦海深，恨逐前峰远。","更听断肠猿，一似闻弦雁。"]},{"i":"c-6eb9f50a0564","t":"蝶恋花","a":"吕本中","d":"宋","g":"词","p":["巧语娇莺春未暮。","杨柳风流，恰过池塘雨。","芳草满庭花满树。","无情胡蝶飞来去。","睡起小奁香一缕。","玉篆回纹，等个人分付。","桃叶不言人不语。","眉尖一点君知否。"]},{"i":"c-178bd36bc882","t":"鹧鸪天","a":"向子諲","d":"宋","g":"词","p":["说著分飞百种猜。","泥人细数几时回。","风流可惯曾孤冷，怀抱如何得好开。","垂玉箸，下香阶。","凭肩小语更兜鞋。","再三莫遣归期误，第一频教入梦来。"]},{"i":"c-24fd64aaf716","t":"鹧鸪天","a":"向子諲","d":"宋","g":"词","p":["浅浅妆成淡淡梅。","见梅忆着傍妆台。","书无鸿雁如何寄，肠断催归作麽回。","千种恨，百般猜。","为伊怀抱几时开。","可堪江上风头恶，不放朝云入梦来。"]},{"i":"c-d9f1e8f3c8c8","t":"鹧鸪天","a":"向子諲","d":"宋","g":"词","p":["几处秋千懒未收。","花梢柳外出纤柔。","霞衣轻举疑奔月，宝髻敧倾若坠楼。","争缥缈，斗风流。","蜂儿蛱蝶共嬉游。","朝朝暮暮春风里，落尽梨花未肯休。"]},{"i":"c-8f7d67ecebc8","t":"踏莎行","a":"向子諲","d":"宋","g":"词","p":["霭霭朝云，矜春态度。","楚宫梦断寻无路。","欲将尊酒遣新愁，谁知引到愁深处。","不尽长江，无边细雨。","只疑都把愁来做。","西山总不解遮栏，随春直过东湖去。"]},{"i":"c-e97dd5bdb384","t":"鹊桥仙","a":"向子諲","d":"宋","g":"词","p":["合巹风流，擘钗情态，压倒痴牛呆女。","今年云外果深期，想却笑、人间离苦。","萦愁叠恨，青山绿水，杳杳重重无数。","寻常犹有梦能来，到此夜、无寻梦处。"]},{"i":"c-9179ebf2eb98","t":"虞美人","a":"向子諲","d":"宋","g":"词","p":["濛濛烟树无重数。","不碍相思路。","晚云分外欲增愁。","更那堪疏雨、送归舟。","雨来还被风吹去。","陨泪多如雨。","拟题双叶问离忧。","怎得水随人意、肯西流。"]},{"i":"c-c4ff0862fa01","t":"虞美人","a":"向子諲","d":"宋","g":"词","p":["去年不到琼花底。","蝶梦空相倚。","今年特地趁花来。","却甚不教同醉、过花开。","花知此恨年年有。","也伴人春瘦。","一枝和泪寄春风。","应把旧愁新怨、入眉峰。"]},{"i":"c-c2e6b06535ed","t":"虞美人","a":"向子諲","d":"宋","g":"词","p":["去年雪满长安树。","望断扬州路。","今年看雪在扬州。","人在蓬莱深处、若为愁。","而今不恨伊相误。","自恨来何暮。","平山堂下旧嬉游。","只有舞春杨柳、似风流。"]},{"i":"c-13706006fa61","t":"虞美人","a":"向子諲","d":"宋","g":"词","p":["倚窗人似莺藏柳。","巧语春心透。","声声清切入人深。","一夜不知两鬓、雪霜侵。","何时月下歌金缕。","醉看行云住。","懒将幽恨寄瑶琴。","却倩金笼鹦鹉、递芳音。"]},{"i":"c-1a902c8db65b","t":"更漏子","a":"向子諲","d":"宋","g":"词","p":["竹孤青，梅酽白。","更着使君清绝。","梅似竹，竹如君。","须知德有邻。","月同高，风同调。","月底风前一笑。","翻碎影，度微香。","与人风味长。"]},{"i":"c-7d79fde0cf15","t":"更漏子","a":"向子諲","d":"宋","g":"词","p":["鹊桥边，牛渚上。","翠节红旌相向。","承玉露，御金风。","年年岁岁同。","懒飞梭，停弄杼。","遥想彩云深处。","人咫尺，事关山。","无聊独倚栏。"]},{"i":"c-16ce14bc5ea5","t":"鹊桥仙","a":"向子諲","d":"宋","g":"词","p":["澄江如练，远山横翠，一段风烟如画。","层楼杰阁倚晴空，疑便是、支矶石下。","宝奁琼鉴，淡匀轻扫，纤手弄妆初罢。","拟将心事问天公，与牛女、平分今夜。"]},{"i":"c-d3ae09a70efd","t":"南歌子","a":"向子諲","d":"宋","g":"词","p":["碧落飞明镜，晴烟幂远山。","扁舟夜下广陵滩。","照我白苹红蓼、一杯残。","初望同盘饮，如何两处看。","遥知香雾湿云鬟。","凭暖琼楼十二、玉栏干。"]},{"i":"c-b36b4c7b55ea","t":"鹊桥仙","a":"向子諲","d":"宋","g":"词","p":["飞云多态，凉飕微度，都到酒边歌处。","冰肌玉骨照人寒，更做弄、一帘风雨。","同盘风味，合欢情思，不管星娥猜妒。","桃花溪水接银河，与占断、鹊桥归路。"]},{"i":"c-7b841b23bfb5","t":"南歌子","a":"向子諲","d":"宋","g":"词","p":["缥缈云间质，轻盈波上身。","瑶林玉树出风尘。","不是野花凡草、等闲春。","翠羽双垂珥，乌纱巧制巾。","经珠不动两眉颦。","须信铅华销尽、见天真。"]},{"i":"c-884f394c9b97","t":"南歌子","a":"向子諲","d":"宋","g":"词","p":["梁苑千花乱，隋堤一水长。","眼前风物总悲凉。","何况眉头心上、不相忘。","因梦聊携手，凭书续断肠。","已惊蝴蝶过东墙。","更被风吹鸿雁、不成行。"]},{"i":"c-95c9e5e17839","t":"卜算子","a":"向子諲","d":"宋","g":"词","p":["竹里一枝梅，雨洗娟娟静。","疑是佳人日暮来，绰约风前影。","新恨有谁知，往事何堪省。","梦绕阳台寂寞回，沾袖馀香冷。"]},{"i":"c-23cecb265af0","t":"菩萨蛮","a":"向子諲","d":"宋","g":"词","p":["鸳鸯翡翠同心侣。","惊风不得双飞去。","春水绿西池。","重期相见时。","长怜心共语。","梦里池边路。","相见不如新。","花应解笑人。"]},{"i":"c-f80d4798da54","t":"菩萨蛮","a":"向子諲","d":"宋","g":"词","p":["娟娟明月如霜白。","鳌山可是蓬山隔。","恨不及春风。","行云处处同。","暖香红雾里。","一笑谁新喜。","知得远愁无。","春衫有泪珠。"]},{"i":"c-1efd24e25960","t":"菩萨蛮","a":"向子諲","d":"宋","g":"词","p":["袜儿窄剪鞋儿小。","纹鸳并影双双好。","微步巧藏人。","轻飞洛浦尘。","前回深处见。","欲近还相远。","心事不能知。","教人直是疑。"]},{"i":"c-58765f500717","t":"南歌子","a":"向子諲","d":"宋","g":"词","p":["雨过林峦静，风回池阁凉。","窥人双燕语雕梁。","笑看小荷翻处、戏鸳鸯。","共饮菖蒲细，同分彩线长。","今朝真不负风光。","绝胜几年飞梦、绕高唐。"]},{"i":"c-65d1f7355311","t":"减字木兰花","a":"向子諲","d":"宋","g":"词","p":["几年不见。","胡蝶枕中魂梦远。","一日相逢。","鹦鹉杯深笑靥浓。","欢心未已。","流水落花愁又起。","离恨如何。","细雨斜风晚更多。"]},{"i":"c-a639cfd21a61","t":"秦楼月・忆秦娥","a":"向子諲","d":"宋","g":"词","p":["虫声切。","柔肠欲断伤离别。","伤离别。","几行清泪，界残红颊。","玉阶白露侵罗袜。","下帘却望玲珑月。","玲珑月。","寒光凌乱，照人愁绝。"]},{"i":"c-59b31ed7c3d6","t":"生查子","a":"向子諲","d":"宋","g":"词","p":["月在两山间，人在空明里。","山色碧於天，月色光於水。","心闲物物幽，心动尘尘起。","莫向动中来，长愿闲如此。"]},{"i":"c-a4ec85326688","t":"生查子","a":"向子諲","d":"宋","g":"词","p":["春心如杜鹃，日夜思归切。","啼尽一川花，愁落千山月。","遥怜白玉人，翠被馀香歇。","可惯独眠寒，减动丰肌雪。"]},{"i":"c-ad46816c6c19","t":"生查子","a":"向子諲","d":"宋","g":"词","p":["近似月当怀，远似花藏雾。","好是月明时，同醉花深处。","看花不自持，对月空相顾。","愿学月频圆，莫作花飞去。"]},{"i":"c-d313d566ce3b","t":"生查子","a":"向子諲","d":"宋","g":"词","p":["春山和恨长，秋水无言度。","脉脉复盈盈，几点梨花雨。","深深一段愁，寂寂无行路。","推去又还来，没个遮栏处。"]},{"i":"c-96605b954e7d","t":"生查子","a":"向子諲","d":"宋","g":"词","p":["娟娟月入眉，整整云归鬓。","镜里弄妆迟，帘外花移影。","斜窥秋水长，软语春莺近。","无计奈情何，只有相思分。"]},{"i":"c-239ca33ee05b","t":"生查子","a":"向子諲","d":"宋","g":"词","p":["相思懒下床，春梦迷蝴蝶。","入柳又穿花，去去轻如叶。","可堪歧路长，不道关山隔。","无赖是黄鹂，唤起空愁绝。"]},{"i":"c-35fee306080f","t":"望江南・忆江南","a":"向子諲","d":"宋","g":"词","p":["微雨过，庭院净无尘。","天上秋期明日是，人间月影十分清，真不负佳辰。","称寿处，香雾绕花身。","玉兔已成千岁药，桂华更与一枝新。","喜气满重闉。"]},{"i":"c-bd0163473cbf","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["冰雪肌肤不受尘。","脸桃眉柳暖生春。","手搓梅子笑迎人。","欲语又休无限思，暂来还去不胜颦。","梦随蝴蝶过东邻。"]},{"i":"c-97564edf067f","t":"西江月","a":"向子諲","d":"宋","g":"词","p":["微步凌波尘起，弄妆满镜花开。","春心掷处眼频来。","秀色著人无耐。","旧事如风无迹，新愁似水难裁。","相思日夜梦阳台。","减尽沈郎衣带。"]},{"i":"c-2ad1a4ee85fa","t":"点绛唇","a":"向子諲","d":"宋","g":"词","p":["丹凤飞来，细传日下丝纶语。","使君归去。","已近沙堤路。","风叶露花，秋意浓如许。","江天暮。","离歌轻举。","愁满西山雨。"]},{"i":"c-b4794f82a4ed","t":"丑奴儿・采桑子","a":"向子諲","d":"宋","g":"词","p":["无双亭下琼花树，玉骨云腴。","倾国称姝。","除却扬州是无处。","天教红药来参乘，桃李先驱。","总作花奴。","翠拥红遮到玉都。"]},{"i":"c-febdb6456c35","t":"如梦令","a":"向子諲","d":"宋","g":"词","p":["午夜凉生翠幔。","帘外行云撩乱。","可恨白苹风，欲雨又还吹散。","肠断。","肠断。","楚梦惊残一半。"]},{"i":"c-e2f410161fde","t":"好事近","a":"向子諲","d":"宋","g":"词","p":["小雨度微云，快染一天新碧。","恰到中秋佳处，是芳年华日。","冰轮莫做九分看，天意在今夕。","先占广寒风露，怕姮娥偏得。"]},{"i":"c-a7372c5fc8e2","t":"好事近","a":"向子諲","d":"宋","g":"词","p":["初上舞茵时，争看袜罗弓窄。","恰似晚霞零乱，衬一钩新月。","折旋多态小腰身，分明是回雪。","生怕因风飞去，放真珠帘隔。"]},{"i":"c-6849bdbbcca4","t":"采桑子","a":"向子諲","d":"宋","g":"词","p":["人如濯濯春杨柳，彻骨风流。","脱体温柔。","牵系多情尽未休。","最怜恰恰新眠起，云雨初收。","斜倚琼楼。","叶叶眉心一样愁。"]},{"i":"c-c6f621c3dc5f","t":"清平乐","a":"向子諲","d":"宋","g":"词","p":["云无天净。","明月端如镜。","乌鹊绕枝栖未稳。","零露垂垂珠陨。","扁舟共绝潮河。","秋风别去如梭。","今夜凄然对影，与谁斟酌姮娥。"]},{"i":"c-de069b957d42","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["花想仪容柳想腰。","融融曳曳一团娇。","绮罗丛里最妖娆。","歌罢碧天零影乱，舞时红袖雪花飘。","几回相见为魂销。"]},{"i":"c-5f508d8e41b6","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["艳赵倾燕花里仙。","乌丝阑写永和年。","有时闲弄醒心弦。","茗碗分云微醉后，纹楸斜倚髻鬟偏。","风流模样总堪怜。"]},{"i":"c-e7232722ab57","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["曾是襄王梦里仙。","娇痴恰恰破瓜年。","芳心已解品朱弦。","浅浅笑时双靥媚，盈盈立处绿云偏。","称人心是尽人怜。"]},{"i":"c-b8c374a1ccfb","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["一夜凉飔动碧厨。","晓庭飞雨溅真珠。","玉人睡起倚金铺。","云髻作堆初未整，柳腰如醉不胜扶。","天仙风调世间无。"]},{"i":"c-83b4424ec47e","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["璧月光中玉漏清。","小梅疏影水边明。","似梅人醉月西倾。","梅欲黄时朝暮雨，月重圆处短长亭。","旧愁新恨若为情。"]},{"i":"c-7bb4a81f548b","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["人意天公则甚知。","故教小雨作深悲。","桃花浑似泪胭脂。","理棹又从今日去，断肠还似去年时。","经行处处是相思。"]},{"i":"c-83af55abbe9a","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["花样风流柳样娇。","雪中微步过溪桥。","心期春色到梅梢。","折得一枝归绿鬓，冰容玉艳不相饶。","索人同去醉金蕉。"]},{"i":"c-5806a258fdb7","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["守得梅开著意看。","春风几醉玉栏干。","去时犹自惜馀欢。","雨后重来花扫地，叶间青子已团团。","凭谁寄与蹙眉山。"]},{"i":"c-2e20656b8f76","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["翡翠衣裳白玉人。","不将朱粉污天真。","清风为伴月为邻。","枕上解随良夜梦，壶中别是一家春。","同心小绾更尖新。"]},{"i":"c-e45b66ab5a17","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["雨点春山入翠眉。","一ь杨柳作腰肢。","语音娇软带儿痴。","犹省当来求识面，隔帘清唱倒琼彝。","真成相见说当时。"]},{"i":"c-6d3c9b177826","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["姑射肌肤雪一团。","掺掺玉手弄冰纨。","著人情思几多般。","水上月如天样远，眼前花似镜中看。","见时容易近时难。"]},{"i":"c-41e8feed8b1b","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["云外遥山是翠眉。","风前杨柳入腰肢。","凌波微步袜尘飞。","倚醉传歌留客处，佯嗔不语殢人时。","风流态度百般宜。"]},{"i":"c-442dfd904bda","t":"浣溪沙","a":"向子諲","d":"宋","g":"词","p":["百斛明珠得翠娥。","风流彻骨更能歌。","碧云留住劝金荷。","取醉归来因一笑，恼人深处是横波。","酒醒情味却知麽。"]},{"i":"c-d11ae918ff05","t":"相见欢","a":"向子諲","d":"宋","g":"词","p":["亭亭秋水芙蓉。","翠围中。","又是一年风露、笑相逢。","天机畔。","云锦乱。","思无穷。","路隔银河犹解、嫁西风。"]},{"i":"c-a269bb571ba4","t":"相见欢","a":"向子諲","d":"宋","g":"词","p":["桃源深闭春风。","信难通。","流水落花馀恨、几时穷。","水无定。","花有尽。","会相逢。","可是人生长在、别离中。"]},{"i":"c-f9394a6c35a3","t":"相见欢","a":"向子諲","d":"宋","g":"词","p":["腰肢一缕纤长。","是垂杨。","泥泥风中衣袖、冷沈香。","花如颊。","眉如叶。","语如簧。","微笑微颦相恼、过回廊。"]},{"i":"c-9ea40b3c4934","t":"最高楼","a":"向子諲","d":"宋","g":"词","p":["无双亭下，琼树正花敷。","玉骨莹云腴。","已知倾国无能比，除非天上有仙姝。","到扬州才见，是处俱无。","比碧桃、也无二朵，算丹桂、止是一株。","千万卉，尽花奴。","天教芍药来骖乘，一春桃李作先驱。","尽红遮绿拥驻江都。"]},{"i":"c-9a7549fb3ea3","t":"醉蓬莱","a":"吴穆仲","d":"宋","g":"词","p":["见处即已，无心即了。"]},{"i":"c-17859e7a324f","t":"南柯子・南歌子","a":"杨适2","d":"宋","g":"词","p":["怨草迷南浦，愁花傍短亭。","有情歌酒莫催行。","看取无情花草、也关情。","旧日临岐曲，而今忍泪听。","淮山何在暮云凝。","待倩春风吹梦、过江城。"]},{"i":"c-8ffaf05a782c","t":"江城子","a":"莫蒙","d":"宋","g":"词","p":["长庚入梦夜何其。","月波迟。","露华滋。","珠褓犀帷，生此宁馨儿。","天上麒麟人不识，森□砢，骏权奇。","文章锦绣识新机。","国风诗。","楚人词。","銮殿蓬莱，早晚奉论思。","百岁归来如魏武，从老大，好威仪。"]},{"i":"c-53c5d36504d1","t":"满庭霜・满庭芳","a":"李璆","d":"宋","g":"词","p":["白玉肌肤，清冰神彩，仙妃何事烟村。","自然标韵，羞入百花群。","不易盈盈瘦质，犯寒腊、独作春温。","溪桥外，斜枝半吐，行客一销魂。","清香无处著，雪中暗认，月下空闻。","算谁许幽人，相伴芳尊。","莫放高楼弄笛，忍教看、雪落纷纷。","堪调鼎，濛濛烟雨，滋养待和羹。"]},{"i":"c-ffed2da02515","t":"念奴娇","a":"韩驹","d":"宋","g":"词","p":["海天向晚，渐霞收馀绮，波澄微绿。","木落山高真个是，一雨秋容新沐。","唤起嫦娥，撩云拨雾，驾此一轮玉。","桂华疏淡，广寒谁伴幽独。","不见弄玉吹箫，尊前空对此，清光堪掬。","雾鬓风鬟何处问，云雨巫山六六。","珠斗斓斒，银河清浅，影转西楼曲。","此情谁会，倚风三弄横竹。"]},{"i":"c-2ba5788d4450","t":"失调名","a":"韩驹","d":"宋","g":"词","p":["孤舟晚扬湖光里。","衰草斜阳无限意。"]},{"i":"c-7a2135be0f83","t":"西江月","a":"颜博文","d":"宋","g":"词","p":["草草书传锦字，厌厌梦绕梅花。","海山无计驻星槎。","肠断芭蕉影下。","缺月旧时庭院，飞云到处人家。","而今赢得鬓先华。","说著多情已怕。"]},{"i":"c-7ed4ba627b15","t":"品令","a":"颜博文","d":"宋","g":"词","p":["夜萧索。","侧耳听、清海楼头吹角。","停归棹、不觉重门闭，恨只恨、暮潮落。","偷想红啼绿怨，道我真个情薄。","纱窗外、厌厌新月上，也应则、睡不著。"]},{"i":"c-a85f88243713","t":"浣溪沙","a":"沈与求","d":"宋","g":"词","p":["云幕垂垂不掩关，落鸿孤没有无间。","雪花欺鬓一年残。","欲把小梅还斗雪，冷香嫌怕乱沈檀。","恼人归梦绕江干。"]},{"i":"c-96ccb0c0424c","t":"浣溪沙","a":"沈与求","d":"宋","g":"词","p":["花信催春入帝关。","玉霙争腊去留间。","不禁风力又吹残。","客舍不眠清夜冷，萦愁一缕袅旃檀。","空庭月落斗栏干。"]},{"i":"c-9af1687747d0","t":"江城子","a":"沈与求","d":"宋","g":"词","p":["华灯高宴水精宫。","浪花中。","意无穷。","十载江湖，重绾汉符铜。","应有青藜存往事，人缥缈，佩丁东。","卧听萧寺响疏钟。","渡溪风。","转空濛。","月上孤窗，邻唱有渔翁。","追念使君清坐久，歌一发，恨千重。"]},{"i":"c-ea7761147c15","t":"江城子","a":"沈与求","d":"宋","g":"词","p":["鱼龙戏舞近幽宫。","乱山中。","似途穷。","绿野堂深，门敞兽铺铜。","无限青瑶攒峭壁，花木老，映西东。","消磨万事酒千锺。","一襟风。","鬓霜濛。","忧国平生，堪笑已成翁。","惟有经纶心事在，承密诏，看重重。"]},{"i":"c-d9c3c7b098fc","t":"秦刷子","a":"陈东","d":"宋","g":"词","p":["谁斫碧琅玕，影撼半庭风月。","尚有岁寒心在，留得数根华发。","龙孙受戏碧波涛，喜动清风发。","到得浪花深处，□一瓯香雪。"]},{"i":"c-923c5d5154e8","t":"西江月","a":"陈东","d":"宋","g":"词","p":["风动一轩花竹，琅玕青锦薰笼。","怜才自是宋墙东。","更识琴心挑弄。","暮雨乍收寒浅，朝云又起春浓。","冰肌玉骨信俱融。","不比巫山闲梦。"]},{"i":"c-f50f615cec96","t":"蓦山溪","a":"陈东","d":"宋","g":"词","p":["半生羁旅，几度经元夜。","长是竞虚名，把良宵、等闲弃舍。","去年元夜，道得□身闲，依旧是，客长安，寂寞孤眠者。","今年元夜。","也则非乡社。","却有人□约，携手□、灯前月下。","那知风雨，此事又参差，成怨恨，独凄惶，清泪淆然洒。"]},{"i":"c-90fd5730d73f","t":"西江月","a":"陈东","d":"宋","g":"词","p":["我笑牛郎织女，一年一度相逢。","欢情尽逐晓云空。","愁损舞莺歌凤。","牛女而今笑我，七年独卧西风。","西风还解过江东。","为报佳期入梦。"]},{"i":"c-03e0df50a216","t":"念奴娇","a":"姚孝宁","d":"宋","g":"词","p":["素娥睡起，驾冰轮碾破，一天秋绿。","醉倚高楼风露下，凛凛寒生肌粟。","横管孤吹，龙吟风劲，雪浪翻银屋。","壮游回首，会稽何限修竹。","今夜对月依然，尊前须快泻，山头鸣瀑。","吸此清光倾肺腑，洗我明珠千斛。","只恐蝉娟，明年依旧，衰鬓先成鹄。","举杯相劝，为予且挂团玉。"]},{"i":"c-eee146d46e01","t":"石州词・石州慢","a":"胡松年","d":"宋","g":"词","p":["月上疏帘，风射小窗，孤馆岑寂。","一杯强洗愁怀，万里堪嗟行客。","乱山无数，晚秋云物苍然，何如轻抹淮山碧。","喜气拂征衣，作眉间黄色。","役役。","马头尘暗斜阳，陇首路回飞翼。","梦里姑苏城外，钱塘江北。","故人应念我，负吹帽佳时，同把金英摘。","归路且加鞭，看梅花消息。"]},{"i":"c-3e6fe5e70e21","t":"石州词・石州慢","a":"胡松年","d":"宋","g":"词","p":["歌阕阳关，肠断短亭，惟有离别。","画船送我薰风，瘦马迎人飞雪。","平生幽梦，岂知塞北江南，而今真叹河山阔。","屈指数分携，早许多时节。","愁绝。","雁行点点云垂，木叶霏霏霜滑。","正是荒城落日，空山残月。","一尊谁念我，苦憔悴天涯，陡觉生华发。","赖有紫枢人，共扬鞭丹阙。"]},{"i":"c-b1019086ecd2","t":"明月逐人来","a":"李持正","d":"宋","g":"词","p":["星河明淡。","春来深浅。","红莲正、满城开遍。","禁街行乐，暗尘香拂面。","皓月随人近远。","天半鳌山，光动凤楼两观。","东风静、珠帘不卷。","玉辇待归，云外闻弦管。","认得宫花影转。"]},{"i":"c-475c1283ef61","t":"人月圆令・人月园","a":"李持正","d":"宋","g":"词","p":["小桃枝上春风早，初试薄罗衣。","年年乐事，华灯竞处，人月圆时。","禁街箫鼓，寒轻夜永，纤手重携。","更阑人散，千门笑语，声在帘帏。"]},{"i":"c-86f4704b1333","t":"桃源忆故人","a":"王道亨","d":"宋","g":"词","p":["刘郎自是桃花主。","不许春风闲度。","春色易随风去。","片片伤春暮。","返魂不用清香炷。","却有梅花淡伫。","从此镇长相顾。","不怨飘残雨。"]},{"i":"c-3354ab16f415","t":"五福降中天","a":"江致和","d":"宋","g":"词","p":["喜元宵三五，纵马御柳沟东。","斜日映珠帘，瞥见芳容。","秋水娇横俊眼，腻雪轻铺素胸。","爱把菱花，笑匀粉面露春葱。","徘徊步懒，奈一点、灵犀未通。","怅望七香车去，慢辗春风。","云情雨态，愿暂入阳台梦中。","路隔烟霞，甚时还许到蓬宫。"]},{"i":"c-873cf54d7bdb","t":"清平乐","a":"韩璜","d":"宋","g":"词","p":["秋光如水。","酿作鹅黄蚁。","散入千岩佳树里。","惟许修门人醉。","轻钿重上风鬟。","不禁月冷霜寒。","步障深沈归去，依然愁满江山。"]}]