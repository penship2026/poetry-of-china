[{"i":"c-0b18cfe6b643","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["风约微云不放阴。","满天星点缀明金。","烛龙衔耀烘残雪，羯鼓催花发上林。","河影转，漏声沈。","缕衣罗薄暮云深。","更期明夜相逢处，还尽今宵未足心。"],"s":"simp","f":"trad"},{"i":"c-25cc0376455c","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["五日都无一日阴。","住来车马闹如林。","葆真行到烛初上，丰乐游归夜已深。","人未散，月将沈。","更期明夜到而今。","归来尚向灯前说，犹恨追游不称心。"],"s":"simp","f":"trad"},{"i":"c-b52e624104a6","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["彻晓华灯照凤城。","犹嗔宫漏促天明。","九重天上闻花气，五色云中应笑声。","频报道，奏河清。","万民和乐见人情。","年丰米贱无边事，万国称觞贺太平。"],"s":"simp","f":"trad"},{"i":"c-ee62bc29a82c","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["忆得当年全盛时。","人情物态自熙熙。","家家帘幕人归晚，处处楼台月上迟。","花市里，使人迷。","州东无暇看州西。","都人只到收灯夜，已向樽前约上池。"],"s":"simp","f":"trad"},{"i":"c-3d5a2b3c0909","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["步障移春锦绣丛。","珠帘翠幕护春风。","沈香甲煎薰炉暖，玉树明金蜜炬融。","车流水，马游龙。","欢声浮动建章宫。","谁怜此夜春江上，魂断黄梁一梦中。"],"s":"mixed","f":"trad"},{"i":"c-b825dd55f693","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["真个亲曾见太平。","元宵且说景龙灯。","四方同奏升平曲，天下都无叹息声。","长月好，定天晴。","人人五夜到天明。","如今一把伤心泪，犹恨江南过此生。"],"s":"simp","f":"trad"},{"i":"c-44db6c94acc3","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["有个秀才姓汪。","骑个驴儿过江。","江又过不得，做尽万千趋锵。"],"s":"simp","f":"trad"},{"i":"c-c6af60de7654","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["有个秀才姓汪。","住在祁门下乡。","行第排来四八，做尽万千趋锵。"],"s":"simp","f":"trad"},{"i":"c-39a31eb9b30c","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["何时一尊酒，重与细论文。"],"s":"simp","f":"trad"},{"i":"c-7b8a32d10d35","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["六论不知出处。","写得乌梅几字。","圣恩广大如天，也赐束帛归去。"],"s":"simp","f":"trad"},{"i":"c-16a39332e05e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["高文虎，称伶俐。","万苦千辛，作个放生亭记。","后头没一句说著朝廷，尽把师　归美。","这老子忒无廉耻。","不知润笔能几。","夏王说不是商王，只怕伏生是你。"],"s":"simp","f":"trad"},{"i":"c-fed57eacb64f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["十年前事，浑似梦初惊。"],"s":"simp","f":"trad"},{"i":"c-67f7f41a67ce","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["千里有个好相识，望青山一色。"],"s":"simp","f":"trad"},{"i":"c-dd8c9e462e09","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["五马游春，彩佩照人，光生南陌。"],"s":"simp","f":"trad"},{"i":"c-3f1dd7aba8c4","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["炉香如雾斗帐深。"],"s":"simp","f":"trad"},{"i":"c-6821b85853ca","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["香野锦林谁是主。"],"s":"simp","f":"trad"},{"i":"c-eac8d2bc7cb7","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["一庭影浸梧竹。"],"s":"simp","f":"trad"},{"i":"c-c79df604f3c9","t":"金钱子","a":"无名氏","d":"宋","g":"词","p":["昨夜金风，黄叶乱飘阶下。","听窗前、芭蕉雨打。","触处池塘，睹风荷凋谢。","景色凄凉，总闲却、舞台歌榭。","独倚阑干，惟有木犀幽雅。","吐清香、胜如兰麝。","似金垒妆成，想丹青难画。","纤手折来，胆瓶中、一枝潇洒。"],"s":"simp","f":"trad"},{"i":"c-9a591b176002","t":"念奴娇","a":"无名氏","d":"宋","g":"词","p":["沁园秋早。","对亭台冷落，荒凉池沼。","西帝晨游无异胜，都把仙花开了。","金粟玲珑，鹅黄娇嫩，不管霜风悄。","清香入梦，梦魂惟怕天晓。","乘兴折取一枝，满身兰麝，不减蟾宫好。","赠与佳人，因笑道、休学姮娥空老。","待约明朝，金英满地，莫遣儿童扫。","相将花上，醉眠尤胜芳草。"],"s":"simp","f":"trad"},{"i":"c-ec616136d9bc","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["芳草绿如茵，与蓝袍、草争翠色。"],"s":"simp","f":"trad"},{"i":"c-229f2b7ac578","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["五百人中第一仙。","等闲平步上青天。","绿袍乍著君恩重，黄榜初开御墨鲜。","龙作马，玉为鞭。","花如罗绮柳如绵。","时人莫讶登科早，自是嫦娥爱少年。"],"s":"simp","f":"trad"},{"i":"c-167cc7c42200","t":"鹊桥仙","a":"无名氏","d":"宋","g":"词","p":["我嗏今夜为情忙，又那得、工夫送巧。"],"s":"simp","f":"trad"},{"i":"c-4821ce182842","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["瑞霞成绮。","映舴艋棹轻，鲤鱼狂风起。"],"s":"simp","f":"trad"},{"i":"c-db62e3d954fa","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["□□□□□金缕。","探听春来处。"],"s":"simp","f":"trad"},{"i":"c-c93492f92d8b","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["晓日楼头残雪尽。","乍破腊、风传春信。","彩燕丝鸡，珠幡玉胜，并归钗鬓。"],"s":"simp","f":"trad"},{"i":"c-58f70e30fb74","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["南楼人未起。","爆竹声闻，应在笙歌里。"],"s":"simp","f":"trad"},{"i":"c-21bd33e3722a","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["竹爆当门庭，震门陛也。"],"s":"simp","f":"trad"},{"i":"c-f2a79dc1aa56","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["待醉里小王，书写副、神荼郁垒。"],"s":"simp","f":"trad"},{"i":"c-ead0d522b8fc","t":"木兰花・玉楼春","a":"无名氏","d":"宋","g":"词","p":["东风昨夜吹春昼。","陡觉去年梅蕊旧。","谁人能解把长绳，系得乌飞并兔走。","清香潋滟杯中酒。","新眼苗条江上柳。","尊前莫惜玉颜酡。","且喜一年年入手。"],"s":"simp","f":"trad"},{"i":"c-52c44c32ac4a","t":"木兰花・玉楼春","a":"无名氏","d":"宋","g":"词","p":["东风昨夜归来后。","景物便为春意候。","金丝齐奏喜新春，愿介香醪千岁寿。","寻花插破桃枝臭。","造化工夫先到柳。","熔酥剪彩恨无香，且放真香先入酒。"],"s":"simp","f":"trad"},{"i":"c-f5cbe560524c","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["捏个牛儿体态。","按年令，旋拖五彩。","鼓乐相迎，红裙捧拥，表一个、胜春节届。"],"s":"simp","f":"trad"},{"i":"c-839d039932d6","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["彩缕旛儿花枝小。","凤钗上、轻轻斜袅。"],"s":"simp","f":"trad"},{"i":"c-657dffd8bd1f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["金吾不禁元宵，漏声更莫催晓。"],"s":"simp","f":"trad"},{"i":"c-a98b8cc09ef0","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["况今宵好景，金吾不禁，玉漏休催。"],"s":"simp","f":"trad"},{"i":"c-027fbb3c099f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["金铺翠、蛾毛巧。","是工夫不少。","闹蛾儿拣了蜂儿卖，卖雪柳、宫梅好。"],"s":"simp","f":"trad"},{"i":"c-b40ea36bf0d5","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["灯球儿小，闹蛾儿颤。","又何须头面。"],"s":"simp","f":"trad"},{"i":"c-2f6165151718","t":"新水令","a":"无名氏","d":"宋","g":"词","p":["冒风连骑出金城，闻孤猿韵切，怀念亲眷。","为笑徐都尉，徒夸彩绘，写出盈盈娇面。","振旅阗阗。","讶睹阆苑神仙。","越公深骤万马，侵凌转盼。","感先锋，容放镜，收鸾鉴一半。","归前阵，惨怛切，同陪元帅恣欢恋。","二岁偶尔，将军沈醉连绵，私令婢捧菱花，都市寻遍。","新官听说邀郎宴。","因令赋悲欢。","孰敢。","做人甚难。","梅妆复照，傅粉重见。"],"s":"mixed","f":"trad"},{"i":"c-c7bab7f19bbe","t":"驻马听","a":"无名氏","d":"宋","g":"词","p":["雕鞍成谩驻。","望断也不归，院深天暮。","倚遍旧日，曾共凭肩门户。","踏青何处所，想醉拍、春衫歌舞。","征旆举。","一步红尘，一步回顾。","行行愁独语。","想媚容、今宵怨郎不住。","来为相思苦。","又空将愁去。","人生无定据。","叹后会、不知何处。","愁万缕。","仗东风、和泪吹与。"],"s":"simp","f":"trad"},{"i":"c-f757500b0b41","t":"南歌子","a":"无名氏","d":"宋","g":"词","p":["禁苑沈沈静，春波漾漾行。","仙姿才韵两相并。","叶上题诗、千古得佳名。","墙外分明见，花间隐约声。","银钩掷处眼双明。","应讶昔时、不得见情人。"],"s":"simp","f":"trad"},{"i":"c-70b9e5e30588","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["角黍厅前，祭天神、妆成异果。"],"s":"simp","f":"trad"},{"i":"c-3aa56805e479","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["旋酌菖蒲酒，灵气满芳尊。"],"s":"simp","f":"trad"},{"i":"c-ea03e422544b","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["自结成同心百索。","祝愿子、更亲自系著。"],"s":"simp","f":"trad"},{"i":"c-e31fa4cff3d5","t":"阮郎归","a":"无名氏","d":"宋","g":"词","p":["及妆时结薄衫儿。","蒙金艾虎儿。","画罗领抹缬裙儿。","盆莲小景儿。","香袋子，搐钱儿。","胸前一对儿。","绣帘妆罢出来时。","问人宜不宜。"],"s":"simp","f":"trad"},{"i":"c-08e8c4106766","t":"阮郎归","a":"无名氏","d":"宋","g":"词","p":["门儿高挂艾人儿。","鹅儿粉扑儿。","结儿缀着小符儿。","蛇儿百索儿。","纱帕子，玉环儿。","孩儿画扇儿。","奴儿自是豆娘儿。","今朝正及时。"],"s":"simp","f":"trad"},{"i":"c-923372bc2cfb","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["双凤钗头，争带御书符。"],"s":"simp","f":"trad"},{"i":"c-6929df88f0b5","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["才向兰汤浴罢，娇羞簪云髻，正雅称鸳鸯会。"],"s":"simp","f":"trad"},{"i":"c-fd04d235b0e0","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["才向兰汤浴罢，娇羞困、殢人未忺梳掠。","艾虎衫儿，轻衬素肌香薄。"],"s":"simp","f":"trad"},{"i":"c-f5b246716f12","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["御符争带。","斜插交枝艾。"],"s":"simp","f":"trad"},{"i":"c-28b8eb357e0e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["从前浪荡休整理。","钉赤口、防猜忌。","而今魔难管全无，一似粽儿黏腻。"],"s":"simp","f":"trad"},{"i":"c-d50b10f862bb","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["天上佳期。","九衢灯月交辉。","摩□孩儿，斗巧争奇。","戴短檐珠子帽，披小缕金衣。","嗔眉笑眼，百般地、敛手相宜。","转晴底、工夫不少，引得人爱后如痴。","快输钱，须要扑，不问归迟。","归来猛醒，争如我、活底孩儿。"],"s":"simp","f":"trad"},{"i":"c-dd8d4bff9c99","t":"伊州曲","a":"无名氏","d":"宋","g":"词","p":["金鸡障下胡雏戏。","乐极祸来，渔阳兵起。","鸾舆幸蜀，玉环缢死。","马嵬坡下尘滓。","夜对行宫皓月，恨最恨、春风桃李。","洪都方士。","念君萦系。","妃子。","蓬莱殿里。","觅寻太真，宫中睡起。","遥谢君意。","泪流琼脸，梨花带雨，仿佛霓裳初试。","寄钿合、共金钗，私言徒尔。","在天愿为、比翼同飞。","居地应为、连理双枝。","天长与地久，唯此恨无已。"],"s":"simp","f":"trad"},{"i":"c-810d0025855e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["月到中秋偏莹。","乍团圆、早欺我孤影。","穿帘共透幕，来寻趁。","钩起窗儿，里面故把、灯儿扑烬。","看尽古今歌咏。","状玉盘、又拟金饼。","谁花言巧语、胡厮胫。","我只道、尔是照人孤眠，恼杀人，旧都名业镜。"],"s":"simp","f":"trad"},{"i":"c-1194cac199d4","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["手拈茱萸簪髻，一枝聊记重阳。"],"s":"simp","f":"trad"},{"i":"c-cfe677b2de26","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["插黄花、对尊前，且看茱萸好。"],"s":"simp","f":"trad"},{"i":"c-d52f5c20158b","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["明年此□，□知谁健，且尽黄花酒。"],"s":"simp","f":"trad"},{"i":"c-a68833766eb0","t":"倾杯序・倾杯乐","a":"无名氏","d":"宋","g":"词","p":["昔有王生，冠世文章，尝随旧游江渚。","偶尔停舟寓目，遥望江祠，依依陌上闲步。","恭诣殿砌，稽首瞻仰，返回归路。","遇老叟，坐于矶石，貌纯古。","因语□，子非王勃是致，生惊询之，片饷方悟。","子有清才，幸对滕王高阁，可作当年词赋。","汝但上舟，休虑。","迢迢仗清风去。","到筵中、下笔华丽，如神助。","会俊侣。","面如玉。","大夫久坐觉生怒。","报云落霞并飞孤鹜。","秋水长天，一色澄素。","阎公竦然，复坐华筵，次诗引序。","道鸣鸾佩玉，锵锵罢歌舞。","栋云飞过南浦。","暮帘卷向西山雨。","闲云潭影，淡淡悠悠，物换星移，几度寒暑。","阁中帝子，悄悄垂名，在於何处。","算长江、俨然自东去。"],"s":"mixed","f":"trad"},{"i":"c-0c5bcb334385","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["奈愁又、愁无避处，愁随一线□长。"],"s":"simp","f":"trad"},{"i":"c-e953b5baf0bf","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["万户与千门，驱傩鼎沸。"],"s":"simp","f":"trad"},{"i":"c-b99a93e31334","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["兽炭共围，通宵不寐，守尽残更待春至。"],"s":"simp","f":"trad"},{"i":"c-956da50b5521","t":"蝶恋花","a":"无名氏","d":"宋","g":"词","p":["花为年年春易改。","待放柔条，系取春常在。","宫样妆成还可爱。","鬓边斜作拖枝戴。","每到无情风雨大。","点检群芳，却是深丛耐。","摇曳绿罗金缕带。","丹青传得妖娆态。"],"s":"simp","f":"trad"},{"i":"c-f797dd457a0e","t":"如梦令","a":"无名氏","d":"宋","g":"词","p":["今夜荼䕷风起。","应是玉消琼碎。","淡荡满城春，恼破愁人春睡。","须醉。","须醉。","莫待梅黄雨细。"],"s":"simp","f":"trad"},{"i":"c-35f3842637bf","t":"最高楼","a":"无名氏","d":"宋","g":"词","p":["司春有序，排次到荼䕷。","远预报，在庭知。","蕊珠宫里晨妆罢，披香殿下晓班齐。","探花正、驱使问，菊花期。","元不逊、梅花浮月影，也知妒、梨花带雨枝。","偏恨柳、绿条垂。","与其向晚包团絮，不如对酒折芳蕤。","谢东君，收拾在，牡丹时。"],"s":"simp","f":"trad"},{"i":"c-536d5b119495","t":"南柯子・南歌子","a":"无名氏","d":"宋","g":"词","p":["翠袖熏龙脑，乌云映玉台。","春葱一簇荐金杯。","曾记西楼同醉、角声催。","袅袅凌波浅，深深步月来。","隔纱微笑恐郎猜。","素艳浓香依旧、去年开。"],"s":"simp","f":"trad"},{"i":"c-1d13f206724e","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["青幄高张，琼枝巧缀，万颗香染红殷。","绛罗衣润，疑是火然山。","白玉钗头试篸，黄金带、奇巧工钻。","题评处，仙家异种，分付在人间。","年年。","输帝里，欢呼内监，妆点金盘。","况曾得真妃，笑脸频看。","炎岭当时奏曲，风流命、乐府名传。","凭谁道、移归禁苑，长使近天颜。"],"s":"mixed","f":"trad"},{"i":"c-31ed0506cd93","t":"浣溪沙","a":"无名氏","d":"宋","g":"词","p":["酒拍胭脂颗颗新。","丹砂然火弃精神。","暑天秋杪锦生春。","香味已惊樱实淡，绛皮还笑荔枝皴。","美人偏喜破朱唇。"],"s":"simp","f":"trad"},{"i":"c-c30ea3f91b9c","t":"南柯子・南歌子","a":"无名氏","d":"宋","g":"词","p":["积雪迷松迳，围炉掩竹扉。","床头一味有蹲鸱。","软火深开香熟、已多时。","自得陶朱法，休教懒瓒知。","浪传黄独正甘肥。","紫玉婴儿盈尺、更新奇。"],"s":"simp","f":"trad"},{"i":"c-48efbaec66e6","t":"贺新郎","a":"无名氏","d":"宋","g":"词","p":["天意扶炎宋。","为吾皇、维衡狱孕，长沙星梦。","社稷勋庸天地窄，不数智名功勇。","要自有、胸中妙用。","擎着东南一柱，看边民、买犊归耕种。","官职易，此身重。","黄封已见传宣送。","却春来、洪钧初转，紫枢归拱。","岁岁玉楼春噀处，慧质明妆环拥。","正弟劝、兄酬欢纵。","一寸丹心坚似铁，待磨崖、勒就浯溪颂。","龙尾道，接天踵。"],"s":"simp","f":"trad"},{"i":"c-a9891c7144e0","t":"贺圣朝","a":"无名氏","d":"宋","g":"词","p":["太平无事，四边宁静狼烟眇。","国泰民安，谩说尧舜禹汤好。","万民翘望彩都门，龙灯凤烛相照。","只听得教坊杂剧欢笑。","美人巧。","宝箓宫前，咒水书符断妖。","更梦近、竹林深处胜蓬岛。","笙歌闹。","奈吾皇，不待元宵景色来到。","只恐后月，阴晴未保。"],"s":"simp","f":"trad"},{"i":"c-f8c951894df2","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["宴罢琼林，醉游花市，此时方显男儿志。"],"s":"simp","f":"trad"},{"i":"c-98dbf82687db","t":"祝英台近","a":"无名氏","d":"宋","g":"词","p":["客毡寒，兰房悄，金炉爇红兽。","好个霜天，消遣正宜酒。","嫩橙初截鹅肪，肌肤香透。","又还记、吴姬纤手。","事难偶。","墨冻空染梨笺，新词谩题就。","酒薄愁浓，敧枕听寒漏。","可堪霜月亭亭，照人无寐，映窗外、一枝梅瘦。"],"s":"simp","f":"trad"},{"i":"c-9d8458ccc6ab","t":"花心动","a":"无名氏","d":"宋","g":"词","p":["碧瓦朱甍，销千门沈沈，丽日初旭。","画栋暗尘，锦瑟空弦，窈窕故窗红绿。","御柳宫花依然好，春不管、为谁妆束。","翠华远，风光尽属，野樵夷牧。","指似行人恸哭。","尚能道、先朝圣游不足。","凤辇路荒，龙沼波乾，犹有弃珠遗玉。","禁廊人静风琴响，只疑是、霓裳遗曲。","断魂晚，寒鸦又啼古木。"],"s":"mixed","f":"trad"},{"i":"c-75a1f194bca5","t":"西江月","a":"无名氏","d":"宋","g":"词","p":["梁上喃喃燕语，纸间戢戢蚕生。","满城风雨近清明。","不道有人新病。","春事一溪流水，杨花千点浮萍。","好风一霎为吹晴。","独步小园清影。"],"s":"simp","f":"trad"},{"i":"c-8858a3c27d7b","t":"梅花引","a":"无名氏","d":"宋","g":"词","p":["清阴陌。","狂踪迹。","朱门团扇香迎客。","牡丹风。","数苞红。","水香扑蕊，新妆谁为容。","蜡灯春酒风光夕。","锦浪龙须花六尺。","月波寒。","玉琅玕。","无情又是，华星送宝鞍。"],"s":"simp","f":"trad"},{"i":"c-b7794a6e0a4e","t":"恋绣衾","a":"无名氏","d":"宋","g":"词","p":["元宵三五酒半醺。","马蹄前、步步是春。","闹市里、看灯去，喜金吾、不禁夜深。","如今老大都休也，未黄昏、先闭上门。","待月到、窗儿上，对梅花、如对故人。"],"s":"simp","f":"trad"},{"i":"c-98cf02b437b3","t":"捣练子","a":"无名氏","d":"宋","g":"词","p":["偏□戏，最风流。","斗帐金猊暖不收。","一阵蜜蜂狂絮里，酒酣眠折玉搔头。"],"s":"simp","f":"trad"},{"i":"c-a0b24db8682b","t":"捣练子","a":"无名氏","d":"宋","g":"词","p":["初酒醒，乍衣单。","褪著裙儿侧著冠。","门外小桥寒食夜，月明人去杏花残。"],"s":"simp","f":"trad"},{"i":"c-2a2d367b7409","t":"楼心月","a":"无名氏","d":"宋","g":"词","p":["柳下争拿画浆摇。","水痕不觉透红绡。","月明相顾羞归去，都坐池头合凤箫。"],"s":"simp","f":"trad"},{"i":"c-c8aaf660ca0c","t":"楼心月","a":"无名氏","d":"宋","g":"词","p":["手把新荷叶一枝。","唤来池上只愁归。","流萤裹在红纱袖，忽到持杯个个飞。"],"s":"simp","f":"trad"},{"i":"c-92b4449002ae","t":"楼心月","a":"无名氏","d":"宋","g":"词","p":["新著生红小舞衣。","案前磨墨误淋漓。","含嗔逗晚不梳洗，背面牙床吃荔支。"],"s":"simp","f":"trad"},{"i":"c-59d6c55d7be7","t":"花心动","a":"无名氏","d":"宋","g":"词","p":["粉堞云齐，度清笳、愁入暮烟林杪。","素艳透春，玉骨凄凉，勾带月痕生早。","江天苍莽黄昏后，依然是、粉寒香瘦。","动追感、西园嫩约，夜深人悄。","记得东风窈窕。","曾夜踏横斜，醉携娇小。","惆怅旧欢，回首俱非，忍看绿笺红豆。","香销纸帐人孤寝，相思恨、花还知否。","梦回处，霜飞翠楼已晓。"],"s":"simp","f":"trad"},{"i":"c-8041ee4f8f4d","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["殢酒情怀，恨春时节。","柳丝巷陌黄昏月。","把君团扇卜君来，近墙扑得双蝴蝶。","笑不成言，喜还生怯。","颠狂绝似前春雪。","夜寒无处著相思，梨花一树人如削。"],"s":"simp","f":"trad"},{"i":"c-e67de7edef6b","t":"鹧鸪天","a":"无名氏","d":"宋","g":"词","p":["题得相思字数行。","起来桐叶满纱窗。","秋光欲雨棋声泻，粉帐不容花露香。","新寂寞，旧疏狂。","玉炉消息记钱塘。","小阑立遍红蕉树，一带残云趁月黄。"],"s":"simp","f":"trad"},{"i":"c-83f4222e06ae","t":"阮郎归","a":"无名氏","d":"宋","g":"词","p":["薄罗生色画酴醿。","酴醿满架时。","隔池贪看燕争泥。","坠双红荔支。","销金字，晚唐诗。","夹纱团扇儿。","自遮微雨傍花归。","个情天得知。"],"s":"simp","f":"trad"},{"i":"c-c548a658ef08","t":"青门怨","a":"无名氏","d":"宋","g":"词","p":["月痮烟景。","远思孤影。","旧梦云飞，离魂冰冷。","脉脉恨满东风。","对孤鸿。","翠珠尘冷香如雾。","人何许。","心逐章台絮。","夜深酒醒烛暗，独倚危楼。","为谁愁。"],"s":"simp","f":"trad"},{"i":"c-6de99614a518","t":"水调歌头","a":"无名氏","d":"宋","g":"词","p":["不能烦恼得，掉臂便归休。","前度风樯，这回潦辙几悠悠。","幸得有云一谷，更自有书万卷，著甚麽来由。","月采混鱼目，霜口涴蝇头。","相山中，侯醉境，将诗流。","情知薄命，天样勋业也须收。","辟逻世间万事，推放那边一壁，百尺卧高楼。","日月草头露，天地水中沤。"],"s":"mixed","f":"trad"},{"i":"c-ee6997a98947","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["东南妩媚，雌了男儿。"],"s":"simp","f":"trad"},{"i":"c-9f7a1e5d6f76","t":"霜天晓角","a":"无名氏","d":"宋","g":"词","p":["一声阿鹊。","人在云西角。","信有黄昏风雨，孤灯酒、不禁酌。","错错。","谁误著。","明知明做却。","颇寄香笺归去，教看了、细揉嚼。"],"s":"simp","f":"trad"},{"i":"c-5761b9076dcc","t":"满庭芳","a":"无名氏","d":"宋","g":"词","p":["凤阁祥烟，龙城佳气，明禋恭谢时丰。","绮罗争看，帘幕卷南风。","十里仙仪宝仗，暖红翠、玉碾玲珑。","銮回也，箫韶缓奏，声在五云中。","千官，迎万乘，丝纶叠叠，锦绣重重。","听鸣矟辇路，宴罢鳌宫。","瞻仰天颜有喜，君恩霈、寰宇雍容。","生平愿，洪基巩固，圣寿永无穷。"],"s":"simp","f":"trad"},{"i":"c-a438bfe68c9c","t":"庆清朝","a":"无名氏","d":"宋","g":"词","p":["银漏花残，红消烛泪。","九重鱼钥欢声沸。","奏万乘、祥曦门外。","盖圣君、恭谢灵休，谨访景明嘉礼。","天意好，祥风瑞月，时正当、小春天气。","禁街十里香中，御辇万红影里。","千官花底，控绣勒、宝鞭摇曳。","看万年，永庆吾皇，拈指又瞻三载。"],"s":"simp","f":"trad"},{"i":"c-b7a837b44113","t":"御街行","a":"无名氏","d":"宋","g":"词","p":["时康三载升平世。","恭谢三朝礼。","群臣禁卫带花回，龊巷儿郎精锐。","战袍新样团雕拥，重隘围子队。","绣衣花帽挨排砌。","锦仗天街里。","有如仙队玉京来，妙乐钧天盈耳。","都民观望时，果是消灾灭罪。"],"s":"simp","f":"trad"},{"i":"c-ea412961f4a1","t":"瑞鹤仙","a":"无名氏","d":"宋","g":"词","p":["是欢声盈万户。","庆景陵礼毕，銮舆游步。","西郊暖风布。","喜湖山深锁，非烟非雾。","传收绣羽。","骅骝驰骤绒缕。","望彤芳、稳稳金銮，衮鸾翔舞。","云驭。","近回天厩，锡宴琼津，洪恩均顾。","霞天向暮。","翠华动，舞韶举。","绛纱笼千点，星飞清禁，银烛交辉辇路。","瑞光中、渺祝无疆，太平圣主。"],"s":"simp","f":"trad"},{"i":"c-4c455f8b43aa","t":"真珠帘","a":"无名氏","d":"宋","g":"词","p":["病酒情怀犹困懒。"],"s":"simp","f":"trad"},{"i":"c-939752109f43","t":"沁园春","a":"无名氏","d":"宋","g":"词","p":["国步多艰，民心靡定，诚吾隐忧。","叹浙民转徙，怨寒嗟暑，荆襄死守，阅岁经秋。","虏未易支，人将相食，识者深为社稷羞。","当今亟，出陈大谏，箸借留候。","□□迂阔为谋。","天下士如何可籍收。","况君能尧舜，臣皆稷契，世逢汤武，业比伊周。","政不必新，贯仍宜旧，莫与秀才做尽休。","吾元老，广四门贤路，一柱中流。"],"s":"simp","f":"trad"},{"i":"c-cf7af42a9ac1","t":"小重山","a":"无名氏","d":"宋","g":"词","p":["鼓报黄昏禽影歇。","单衣犹未试，觉寒怯。","尘生锦瑟可曾阅。","人去也，闲过好时节。","对景复愁绝。","东风吹不散，鬓边雪。","些儿心事对谁说。","眠不得，一枕杏花月。"],"s":"simp","f":"trad"},{"i":"c-94cdcc2bdee9","t":"谒金门","a":"无名氏","d":"宋","g":"词","p":["休只坐。","也去看花则个。","明日满庭红欲堕。","花还愁似我。","索性痴眠一和。","凭个梦儿好做。","杜宇不知春已过。","枝头声越大。"],"s":"simp","f":"trad"},{"i":"c-e8ebd0e86f63","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["惜花心性。"],"s":"simp","f":"trad"},{"i":"c-5063fc8921aa","t":"行香子","a":"无名氏","d":"宋","g":"词","p":["浙右华亭。","物价廉平。","一道会、卖个三升。","打开瓶后，滑辣光馨。","教君霎时饮，霎时醉，霎时醒。","听得渊明。","说与刘伶。","这一瓶、约迭三斤。","君还不信，把秤来秤。","有一斤酒，一斤水，一斤瓶。"],"s":"simp","f":"trad"},{"i":"c-67f1ac012a07","t":"长相思","a":"无名氏","d":"宋","g":"词","p":["晴也行。","雨也行。","雨也行时不似晴。","天晴终快人。","名也成。","利也成。","利也成时不似名。","名成天下惊。"],"s":"simp","f":"trad"},{"i":"c-433c22dcbeb9","t":"摸鱼儿","a":"无名氏","d":"宋","g":"词","p":["过湘皋、碧龙惊起，冰涎犹护髯影。","春洲未有菱歌伴，独占暮烟千顷。","呼短艇。","试翦取纤条，玉溜青丝莹。","尊前细认。","试水面新荷，波心半掩，点点翠钿净。","凄凉味，酪乳那堪比并。","吴盐一箸秋冷。","当时不为鲈鱼去，聊尔动渠归兴。","还记省。","是几度西风，几度吹愁醒。","鸥昏鹭瞑。","谩换得霜痕，萧萧两鬓，羞与共秋镜。"],"s":"simp","f":"trad"},{"i":"c-50a5fbe1f203","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["东君去后花无主。"],"s":"simp","f":"trad"}]