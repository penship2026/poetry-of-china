[{"i":"c-362847c03b74","t":"采桑子","a":"陆游","d":"宋","g":"词","p":["宝钗楼上妆梳晚，懒上秋千。","闲拨沈烟。","金缕衣宽睡髻偏。","鳞鸿不寄辽东信，又是经年。","弹泪花前。","愁入春风十四弦。"],"s":"simp","f":"trad"},{"i":"c-0d2327543f24","t":"沁园春","a":"陆游","d":"宋","g":"词","p":["粉破梅梢，绿动萱丛，春意已深。","渐珠帘低卷，筇枝微步，冰开跃鲤，林暖鸣禽。","荔子扶疏，竹枝哀怨，浊酒一尊和泪斟。","凭栏久，叹山川冉冉，岁月骎骎。","当时岂料如今。","漫一事无成霜鬓侵。","看故人强半，沙堤黄阁，鱼悬带玉，貂映蝉金。","许国虽坚，朝天无路，万里凄凉谁寄音。","东风里，有灞桥烟柳，知我归心。"],"s":"simp","f":"trad"},{"i":"c-375a173dc71d","t":"沁园春","a":"陆游","d":"宋","g":"词","p":["一别秦楼，转眼新春，又近放灯。","忆盈盈倩笑，纤纤柔握，玉香花语，雪暖酥凝。","念远愁肠，伤春病思，自怪平生殊未曾。","君知否，渐香消蜀锦，泪渍吴绫。","难求系日长绳。","况倦客飘零少旧朋。","但江郊雁起，渔村笛怨，寒釭委烬，孤砚生冰。","水绕山围，烟昏云惨，纵有高台常怯登。","消魂处，是鱼笺不到，兰梦无凭。"],"s":"simp","f":"trad"},{"i":"c-1b3aa4c3a60d","t":"沁园春","a":"陆游","d":"宋","g":"词","p":["孤鹤归飞，再过辽天，换尽旧人。","念累累枯冢，茫茫梦境，王侯蝼蚁，毕竟成尘。","载酒园林，寻花巷陌，当日何曾轻负春。","流年改，叹围腰带剩，点鬓霜新。","交亲。","散落如云。","又岂料如今馀此身。","幸眼明身健，茶甘饭软，非惟我老，更有人贫。","躲尽危机，消残壮志，短艇湖中闲采莼。","吾何恨，有渔翁共醉，溪友为邻。"],"s":"simp","f":"trad"},{"i":"c-9b029916bee2","t":"忆秦娥","a":"陆游","d":"宋","g":"词","p":["玉花骢。","晚街金辔声璁珑。","声璁珑。","闲敧乌帽，又过城东。","富春巷陌花重重。","千金沽酒酬春风。","酬春风。","笙歌围里，锦绣丛中。"],"s":"simp","f":"trad"},{"i":"c-d582950792cd","t":"汉宫春","a":"陆游","d":"宋","g":"词","p":["浪迹人间。","喜闻猿楚峡，学剑秦川。","虚舟泛然不系，万里江天。","朱颜绿鬓，作红尘、无事神仙。","何妨在，莺花海里，行歌闲送流年。","休笑放慵狂眼，看闲坊深院，多少婵娟。","燕宫海棠夜宴，花覆金船。","如椽画烛，酒阑时、百炬吹烟。","凭寄语，京华旧侣，幅巾莫换貂蝉。"],"s":"simp","f":"trad"},{"i":"c-3ce904cd2058","t":"汉宫春","a":"陆游","d":"宋","g":"词","p":["羽箭雕弓，忆呼鹰古垒，截虎平川。","吹笳暮归，野帐雪压青毡。","淋漓醉墨，看龙蛇、飞落蛮笺。","人误许，诗情将略，一时才气超然。","何事又作南来，看重阳药市，元夕灯山。","花时万人乐处，敧帽垂鞭。","闻歌感旧，尚时时、流涕尊前。","君记取，封侯事在，功名不信由天。"],"s":"simp","f":"trad"},{"i":"c-5c0c19c201bf","t":"月上海棠","a":"陆游","d":"宋","g":"词","p":["斜阳废苑朱门闭。","吊兴亡、遗恨泪痕里。","淡淡宫梅，也依然、点酥剪水。","凝愁处，似忆宣华旧事。","行人别有凄凉意。","折幽香、谁与寄千里。","伫立江皋，杳难逢、陇头归骑。","音尘远，楚天危楼独倚。"],"s":"simp","f":"trad"},{"i":"c-2e71a44cefee","t":"月上海棠","a":"陆游","d":"宋","g":"词","p":["兰房绣户厌厌病。","叹春酲、和闷甚时醒。","燕子空归，几曾传、玉关边信。","伤心处，独展团窠瑞锦。","熏笼消歇沈烟冷。","泪痕深、展转看花影。","漫拥馀香，怎禁他、峭寒孤枕。","西窗晓，几声银瓶玉井。"],"s":"simp","f":"trad"},{"i":"c-d3ca2e3dad50","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["金鸭馀香尚暖，绿窗斜日偏明。","兰膏香染云鬟腻，钗坠滑无声。","冷落秋千伴侣，阑珊打马心情。","绣屏惊断潇湘梦，花外一声莺。"],"s":"simp","f":"trad"},{"i":"c-92f5cc2e318e","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["檐角楠阴转日，楼前荔子吹花。","鹧鸪声里霜天晚，叠鼓已催衙。","乡梦时来枕上，京书不到天涯。","邦人讼少文移省，闲院自煎茶。"],"s":"simp","f":"trad"},{"i":"c-4e8e32cce7c8","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["我校丹台玉字，君书蕊殿云篇。","锦官城里重相遇，心事两依然。","携酒何妨处处，寻梅共约年年。","细思上界多官府，且作地行仙。"],"s":"simp","f":"trad"},{"i":"c-541ff7d30748","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["世事从来惯见，吾生更欲何之。","镜湖西畔秋千顷，鸥鹭共忘机。","一枕苹风午醉，二升菰米晨炊。","故人莫讶音书绝，钓侣是新知。"],"s":"simp","f":"trad"},{"i":"c-6113bb84ae47","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["素意幽栖物外，尘缘浪走天涯。","归来犹幸身强健，随分作山家。","已趁馀寒泥酒，还乘小雨移花。","柴门尽日无人到，一径傍溪斜。"],"s":"simp","f":"trad"},{"i":"c-889488b55974","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["园馆青林翠樾，衣巾细葛轻纨。","好风吹散霏微雨，沙路喜新乾。","小燕双飞水际，流莺百啭林端。","投壶声断弹棋罢，闲展道书看。"],"s":"mixed","f":"trad"},{"i":"c-9eed1c548347","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["从宦元知漫浪，还家更觉清真。","兰亭道上多修竹，随处岸纶巾。","泉冽偏宜雪茗，粳香雅称丝莼。","け然一饱西窗下，天地有闲人。"],"s":"simp","f":"trad"},{"i":"c-c81f442e85d9","t":"乌夜啼","a":"陆游","d":"宋","g":"词","p":["纨扇婵娟素月，纱巾缥渺轻烟。","高槐叶长阴初合，清润雨馀天。","弄笔斜行小草，钩帘浅醉闲眠。","更无一点尘埃到，枕上听新蝉。"],"s":"simp","f":"trad"},{"i":"c-af74129ad882","t":"真珠帘","a":"陆游","d":"宋","g":"词","p":["山村水馆参差路。","感羁游、正似残春风絮。","掠地穿帘，知是竟归何处。","镜里新霜空自悯，问几时、鸾台鳌署。","迟暮。","谩凭高怀远，书空独语。","自古。","儒冠多误。","悔当年、早不扁舟归去。","醉下白苹洲，看夕阳鸥鹭。","菰菜鲈鱼都弃了，只换得、青衫尘土。","休顾。","早收身江上，一蓑烟雨。"],"s":"simp","f":"trad"},{"i":"c-b23c975b4e7e","t":"好事近","a":"陆游","d":"宋","g":"词","p":["混迹寄人间，夜夜画楼银烛。","谁见五云丹灶，养黄芽初熟。","春风归从紫皇游，东海宴晹谷。","进罢碧桃花赋，赐玉尘千斛。"],"s":"simp","f":"trad"},{"i":"c-014714ee0dd7","t":"柳梢青","a":"陆游","d":"宋","g":"词","p":["锦里繁华。","环宫故邸，叠萼奇花。","俊客妖姬，争飞金勒，齐驻香车。","何须幕障帏遮。","宝杯浸、红云瑞霞。","银烛光中，清歌声里，休恨天涯。"],"s":"simp","f":"trad"},{"i":"c-394e002adbfc","t":"柳梢青","a":"陆游","d":"宋","g":"词","p":["十载江湖，行歌沽酒，不到京华。","底事翩然，长亭烟草，衰鬓风沙。","凭高目断天涯。","细雨外、楼台万家。","只恐明朝，一时不见，人共梅花。"],"s":"simp","f":"trad"},{"i":"c-d276ab99a932","t":"夜游宫","a":"陆游","d":"宋","g":"词","p":["雪晓清笳乱起。","梦游处、不知何地。","铁骑无声望似水。","想关河，雁门西，青海际。","睡觉寒灯里。","漏声断、月斜窗纸。","自许封侯在万里。","有谁知，鬓虽残，心未死。"],"s":"simp","f":"trad"},{"i":"c-8d719ce118cf","t":"夜游宫","a":"陆游","d":"宋","g":"词","p":["独夜寒侵翠被。","奈幽梦、不成还起。","欲写新愁泪溅纸。","忆承恩，叹馀生，今至此。","蔌蔌灯花坠。","问此际、报人何事。","咫尺长门过万里。","恨君心，似危栏，难久倚。"],"s":"simp","f":"trad"},{"i":"c-4e8a25b9b0d4","t":"安公子","a":"陆游","d":"宋","g":"词","p":["风雨初经社。","子规声里春光谢。","最是无情，零落尽、蔷薇一架。","况我今年，憔悴幽窗下。","人尽怪、诗酒消声价。","向药炉经卷，忘却莺窗柳榭。","万事收心也。","粉痕犹在香罗帕。","恨月愁花，争信道、如今都罢。","空忆前身，便面章台马。","因自来、禁得心肠怕。","纵遇歌逢酒，但说京都旧话。"],"s":"simp","f":"trad"},{"i":"c-0fdd2110dfc0","t":"玉胡蝶・玉蝴蝶","a":"陆游","d":"宋","g":"词","p":["倦客平生行处，坠鞭京洛，解佩潇湘。","此夕何年，来赋宋玉高唐。","绣帘开、香尘乍起，莲步稳、银烛分行。","暗端相。","燕羞莺妒，蝶绕蜂忙。","难忘。","芳樽频劝，峭寒新退，玉漏犹长。","几许幽情，只愁歌罢月侵廊。","欲归时、司空笑问，微近处，丞相嗔狂。","断人肠。","假饶相送，上马何妨。"],"s":"simp","f":"trad"},{"i":"c-6d0feb255920","t":"木兰花慢","a":"陆游","d":"宋","g":"词","p":["阅邯郸梦境，叹绿鬓、早霜侵。","奈华岳烧丹，青溪看鹤，尚负初心。","年来向浊世里，悟真诠秘诀绝幽深。","养就金芝九畹，种成琪树千林。","星坛夜学步虚吟。","露冷透瑶簪。","对翠凤披云，青鸾溯月，宫阙萧森。","琅函一封奏罢，自钧天帝所有知音。","却过蓬壶啸傲，世间岁月骎骎。"],"s":"simp","f":"trad"},{"i":"c-17098bb76e36","t":"苏武慢","a":"陆游","d":"宋","g":"词","p":["澹霭空濛，轻阴清润，绮陌细尘初静。","平桥系马，画阁移舟，湖水倒空如镜。","掠岸飞花，傍檐新燕，都似学人无定。","叹连年戎帐，经春边垒，暗凋颜鬓。","空记忆、杜曲池台，新丰歌管，怎得故人音信。","羁怀易感，老伴无多，谈麈久闲犀柄。","惟有修然，笔床茶灶，自适笋舆烟艇。","待绿荷遮岸，红蕖浮水，更乘幽兴。"],"s":"mixed","f":"trad"},{"i":"c-c604d53c67eb","t":"齐天乐","a":"陆游","d":"宋","g":"词","p":["角残锺晚关山路，行人乍依孤店。","塞月征尘，鞭丝帽影，常把流年虚占。","藏鸦柳暗。","叹轻负莺花，谩劳书剑。","事往关情，悄然频动壮游念。","孤怀谁与强遣。","市垆沽酒，酒薄怎当愁酽。","倚瑟妍词，调铅妙笔，那写柔情芳艳。","征途自厌。","况烟敛芜痕，雨稀萍点。","最是眠时，枕寒门半掩。"],"s":"simp","f":"trad"},{"i":"c-67f248b6568d","t":"齐天乐","a":"陆游","d":"宋","g":"词","p":["客中随处闲消闷，来寻啸台龙岫。","路敛春泥，山开翠雾，行乐年年依旧。","天工妙手。","放轻绿萱牙，淡黄杨柳。","笑问东君，为人能染鬓丝否。","西州催去近也，帽檐风软，且看市楼沽酒。","宛转巴歌，凄凉塞管，携客何妨频奏。","征尘暗袖。","漫禁得梅花，伴人疏瘦。","几日东归，画船平放溜。"],"s":"simp","f":"trad"},{"i":"c-ec0aa6623ec9","t":"望梅","a":"陆游","d":"宋","g":"词","p":["寿非金石。","恨天教老向，水程山驿。","似梦里、来到南柯，这些子光阴，更勘轻掷。","戍火边尘，又过了、一年春色。","叹名姬骏马，尽付杜陵，苑路豪客。","长绳漫劳系日。","看人间俯仰，俱是陈迹。","纵自倚、英气凌云，奈回尽鹏程，铩残鸾翮。","终日凭高，诮不见、江东消息。","算沙边、也有断鸿，倩谁问得。"],"s":"simp","f":"trad"},{"i":"c-ad2de37ba8cf","t":"洞庭春色・沁园春","a":"陆游","d":"宋","g":"词","p":["壮岁文章，暮年勋业，自昔误人。","算英雄成败，轩裳得失，难如人意，空丧天真。","请看邯郸当日梦，待炊罢黄粱徐欠伸。","方知道，许多时富贵，何处关身。","人间定无可意，怎换得、玉鲙丝莼。","且钓竿渔艇，笔床茶灶，闲听荷雨，一洗衣尘。","洛水秦关千古后，尚棘暗铜驼空怆神。","何须更，慕封侯定远，图像麒麟。"],"s":"simp","f":"trad"},{"i":"c-f7f8482cb7ca","t":"渔家傲","a":"陆游","d":"宋","g":"词","p":["东望山阴何处是。","往来一万三千里。","写得家书空满纸。","流清泪。","书回已是明年事。","寄语红桥桥下水。","扁舟何日寻兄弟。","行遍天涯真老矣。","愁无寐。","鬓丝几缕茶烟里。"],"s":"simp","f":"trad"},{"i":"c-468b82f93369","t":"绣停针","a":"陆游","d":"宋","g":"词","p":["叹半纪，跨万里秦吴，顿觉衰谢。","回首鹓行，英俊并游，咫尺玉堂金马。","气凌嵩华。","负壮略、纵横王霸。","梦经洛浦梁园，觉来泪流如泻。","山林定去也。","却自恐说著，少年时话。","静院焚香，闲倚素屏，今古总成虚假。","趁时婚嫁。","幸自有、湖边茅舍。","燕归应笑，客中又还过社。"],"s":"simp","f":"trad"},{"i":"c-d544b17a6e85","t":"桃源忆故人","a":"陆游","d":"宋","g":"词","p":["斜阳寂历柴门闭。","一点炊烟时起。","鸡犬往来林外。","俱有萧然意。","衰翁老去疏荣利。","绝爱山城无事。","临去画楼频倚。","何日重来此。"],"s":"simp","f":"trad"},{"i":"c-a9aef971d26e","t":"桃源忆故人","a":"陆游","d":"宋","g":"词","p":["栏干几曲高斋路。","正在重云深处。","丹碧未乾人去。","高栋空留句。","离离芳草长亭暮。","无奈征车不住。","惟有断鸿烟渚。","知我频回顾。"],"s":"mixed","f":"trad"},{"i":"c-fa7063ea89f8","t":"桃源忆故人","a":"陆游","d":"宋","g":"词","p":["一弹指顷浮生过。","堕甑元知当破。","去去醉吟高卧。","独唱何须和。","残年还我从来我。","万里江湖烟舸。","脱尽利名缰锁。","世界元来大。"],"s":"simp","f":"trad"},{"i":"c-428468ff216f","t":"桃源忆故人","a":"陆游","d":"宋","g":"词","p":["城南载酒行歌路。","冶叶倡条无数。","一朵鞓红凝露。","最是关心处。","莺声无赖催春去。","那更兼旬风雨。","试问岁华何许。","芳草连天暮。"],"s":"simp","f":"trad"},{"i":"c-dc8e06885c2f","t":"桃源忆故人","a":"陆游","d":"宋","g":"词","p":["中原当日三川震。","关辅回头煨烬。","泪尽两河征镇。","日望中兴运。","秋风霜满青青鬓。","老却新丰英俊。","云外华山千仞。","依旧无人问。"],"s":"simp","f":"trad"},{"i":"c-b9ef8f762738","t":"极相思","a":"陆游","d":"宋","g":"词","p":["江头疏雨轻烟。","寒食落花天。","翻红坠素，残霞暗锦，一段凄然。","惆怅东君堪恨处，也不念、冷落尊前。","那堪更看，漫空相趁，柳絮榆钱。"],"s":"simp","f":"trad"},{"i":"c-32ecf660f6e6","t":"一丛花","a":"陆游","d":"宋","g":"词","p":["尊前凝伫漫魂迷。","犹恨负幽期。","从来不惯伤春泪，为伊后、滴满罗衣。","那堪更是，吹箫池馆，青子绿阴时。","回廊帘影昼参差。","偏共睡相宜。","朝云梦断知何处，倩双燕、说与相思。","从今判了，十分憔悴，图要个人知。"],"s":"simp","f":"trad"},{"i":"c-e52ae8863b9d","t":"一丛花","a":"陆游","d":"宋","g":"词","p":["仙姝天上自无双。","玉面翠蛾长。","黄庭读罢心如水，闭朱户、愁近丝簧。","窗明几净，闲临唐帖，深炷宝奁香。","人间无药驻流光。","风雨又催凉。","相逢共话清都旧，叹尘劫、生死茫茫。","何如伴我，绿蓑青箬，秋晚钓潇湘。"],"s":"simp","f":"trad"},{"i":"c-524fe76e289a","t":"隔浦莲近拍","a":"陆游","d":"宋","g":"词","p":["飞花如趁燕子。","直度帘栊里。","帐掩香云暖，金笼鹦鹉惊起。","凝恨慵梳洗。","妆台畔，蘸粉纤纤指。","宝钗坠。","才醒又困，厌厌中酒滋味。","墙头柳暗，过尽一年春事。","罨画高楼怕独倚。","千里。","孤舟何处烟水。"],"s":"simp","f":"trad"},{"i":"c-9737ff865ecf","t":"隔浦莲近拍","a":"陆游","d":"宋","g":"词","p":["骑鲸云路倒景。","醉面风吹醒。","笑把浮丘袂，寥然非复尘境。","震泽秋万顷。","烟霏散，水面飞金镜。","露华冷。","湘妃睡起，鬟倾钗坠慵整。","临江舞处，零乱塞鸿清影。","河汉横斜夜漏永。","人静。","吹箫同过缑岭。"],"s":"simp","f":"trad"},{"i":"c-1b5e2c5b85b9","t":"昭君怨","a":"陆游","d":"宋","g":"词","p":["昼永蝉声庭院。","人倦懒摇团扇。","小景写潇湘。","自生凉。","帘外蹴花双燕。","帘下有人同见。","宝篆拆官黄。","炷熏香。"],"s":"simp","f":"trad"},{"i":"c-1bee2d687d81","t":"双头莲","a":"陆游","d":"宋","g":"词","p":["华鬓星星，惊壮志成虚，此身如寄。","萧条病骥。","向暗里。","消尽当年豪气。","梦断故国山川，隔重重烟水。","身万里。","旧社凋零，青门俊游谁记。","尽道锦里繁华，叹官闲昼永，柴荆添睡。","清愁自醉。","念此际。","付与何人心事。","纵有楚柂吴樯，知何时东逝。","空怅望，鲙美菰香，秋风又起。"],"s":"simp","f":"trad"},{"i":"c-7871bbe1d64d","t":"南歌子","a":"陆游","d":"宋","g":"词","p":["异县相逢晚，中年作别难。","暮秋风雨客衣寒。","又向朝天门外、话悲欢。","瘦马行霜栈，轻舟下雪滩。","乌奴山下一林丹。","为说三年常寄、梦魂间。"],"s":"simp","f":"trad"},{"i":"c-7c913e1b5cb3","t":"豆叶黄・忆王孙","a":"陆游","d":"宋","g":"词","p":["春风楼上柳腰肢。","初试花前金缕衣。","袅袅娉娉不自持。","晓妆迟。","画得蛾眉胜旧时。"],"s":"simp","f":"trad"},{"i":"c-0e1488012637","t":"豆叶黄・忆王孙","a":"陆游","d":"宋","g":"词","p":["一春常是雨和风。","风雨晴时春已空。","谁惜泥沙万点红。","恨难穷。","恰似衰翁一世中。"],"s":"simp","f":"trad"},{"i":"c-d0295b7292de","t":"醉落魄・一斛珠","a":"陆游","d":"宋","g":"词","p":["江湖醉客。","投杯起舞遗乌帻。","三更冷翠沾衣湿。","袅袅菱歌，催落半川月。","空花昨梦休寻觅。","云台麟阁俱陈迹。","元来只有闲难得。","青史功名，天却无心惜。"],"s":"simp","f":"trad"},{"i":"c-232cdcdd5443","t":"鹊桥仙","a":"陆游","d":"宋","g":"词","p":["华灯纵博，雕鞍驰射，谁记当年豪举。","酒徒一一取封侯，独去作、江边渔父。","轻舟八尺，低篷三扇，占断苹洲烟雨。","镜湖元自属闲人，又何必、君恩赐与。"],"s":"simp","f":"trad"},{"i":"c-8d5e12f383c1","t":"鹊桥仙","a":"陆游","d":"宋","g":"词","p":["一竿风月，一蓑烟雨，家在钓台西住。","卖鱼生怕近城门，况肯到、红尘深处。","潮生理棹，潮平系缆，潮落浩歌归去。","时人错把比严光，我自是、无名渔父。"],"s":"simp","f":"trad"},{"i":"c-2d679abcecb4","t":"鹊桥仙","a":"陆游","d":"宋","g":"词","p":["茅檐人静，蓬窗灯暗，春晚连江风雨。","林莺巢燕总无声，但月夜、常啼杜宇。","催成清泪，惊残孤梦，又拣深枝飞去。","故山犹自不堪听，况半世、飘然羁旅。"],"s":"simp","f":"trad"},{"i":"c-22105ef9e2eb","t":"长相思","a":"陆游","d":"宋","g":"词","p":["云千重。","水千重。","身在千重云水中。","月明收钓筒。","头未童。","耳未聋。","得酒犹能双脸红。","一尊谁与同。"],"s":"simp","f":"trad"},{"i":"c-9cc8487e3082","t":"长相思","a":"陆游","d":"宋","g":"词","p":["桥如虹。","水如空。","一叶飘然烟雨中。","天教称放翁。","侧船篷。","使江风。","蟹舍参差渔市东。","到时闻暮锺。"],"s":"simp","f":"trad"},{"i":"c-332501097f1e","t":"长相思","a":"陆游","d":"宋","g":"词","p":["面苍然。","鬓皤然。","满腹诗书不直钱。","官闲常昼眠。","画凌烟。","上甘泉。","自古功名属少年。","知心惟杜鹃。"],"s":"simp","f":"trad"},{"i":"c-e53161123866","t":"长相思","a":"陆游","d":"宋","g":"词","p":["暮山青。","暮霞明。","梦笔桥头艇子横。","苹风吹酒醒。","看潮生。","看潮平。","小住西陵莫较程。","莼丝初可烹。"],"s":"simp","f":"trad"},{"i":"c-b1dbb4caaec0","t":"长相思","a":"陆游","d":"宋","g":"词","p":["悟浮生。","厌浮名。","回视千锺一发轻。","从今心太平。","爱松声。","爱泉声。","写向孤桐谁解听。","空江秋月明。"],"s":"simp","f":"trad"},{"i":"c-1ee018b02adb","t":"菩萨蛮","a":"陆游","d":"宋","g":"词","p":["江天淡碧云如扫。","苹花零落莼丝老。","细细晚波平。","月从波面生。","渔家真个好。","悔不归来早。","经岁洛阳城。","鬓丝添几茎。"],"s":"simp","f":"trad"},{"i":"c-669d5f8b5a7b","t":"菩萨蛮","a":"陆游","d":"宋","g":"词","p":["小院蚕眠春欲老。","新巢燕乳花如扫。","幽梦锦城西。","海棠如旧时。","当年真草草。","一棹还吴早。","题罢惜春诗。","镜中添鬓丝。"],"s":"simp","f":"trad"},{"i":"c-6d15e1ff3f3f","t":"诉衷情","a":"陆游","d":"宋","g":"词","p":["当年万里觅封侯。","匹马戍梁州。","关河梦断何处，尘暗旧貂裘。","胡未灭，鬓先秋。","泪空流。","此生谁料，心在天山，身老沧洲。"],"s":"simp","f":"trad"},{"i":"c-5730ef76f802","t":"诉衷情","a":"陆游","d":"宋","g":"词","p":["青衫初入九重城。","结友尽豪英。","蜡封夜半传檄，驰骑谕幽并。","时易失，志难成。","鬓丝生。","平章风月，弹压江山，别是功名。"],"s":"simp","f":"trad"},{"i":"c-f82504b58277","t":"生查子","a":"陆游","d":"宋","g":"词","p":["还山荷主恩，聊试扶犁手。","新结小茅茨，恰占清江口。","风尘不化衣，邻曲常持酒。","那似宦游时，折尽长亭柳。"],"s":"simp","f":"trad"},{"i":"c-8f621d0d4e6c","t":"生查子","a":"陆游","d":"宋","g":"词","p":["梁空燕委巢，院静鸠催雨。","香润上朝衣，客少闲谈麈。","鬓边千缕丝，不是吴蚕吐。","孤梦泛潇湘，月落闻柔橹。"],"s":"simp","f":"trad"},{"i":"c-27903a570d98","t":"破阵子","a":"陆游","d":"宋","g":"词","p":["仕至千锺良易，年过七十常稀。","眼底荣华元是梦，身后声名不自知。","营营端为谁。","幸有旗亭沽酒，何妨茧纸题诗。","幽谷云萝朝采药，静院轩窗夕对棋。","不归真个痴。"],"s":"simp","f":"trad"},{"i":"c-a0fd60fa56e3","t":"破阵子","a":"陆游","d":"宋","g":"词","p":["看破空花尘世，放轻昨梦浮名。","蜡屐登山真率饮，筇杖穿林自在行。","身闲心太平。","料峭馀寒犹力，廉纤细雨初晴。","苔纸闲题溪上句，菱唱遥闻烟外声。","与君同醉醒。"],"s":"simp","f":"trad"},{"i":"c-2a5c932ef927","t":"上西楼・相见欢","a":"陆游","d":"宋","g":"词","p":["江头绿暗红稀。","燕交飞。","忽到当年行处、恨依依。","洒清泪。","叹人事。","与心违。","满酌玉壶花露、送春归。"],"s":"simp","f":"trad"},{"i":"c-7f564e8eb286","t":"点绛唇","a":"陆游","d":"宋","g":"词","p":["采药归来，独寻茅店沽新酿。","暮烟千嶂。","处处闻渔唱。","醉弄扁舟，不怕粘天浪。","江湖上。","遮回疏放。","作个闲人样。"],"s":"simp","f":"trad"},{"i":"c-4cc38f54916c","t":"谢池春","a":"陆游","d":"宋","g":"词","p":["壮岁从戎，曾是气吞残虏。","阵云高、狼烽夜举。","朱颜青鬓，拥雕戈西戍。","笑儒冠、自来多误。","功名梦断，却泛扁舟吴楚。","漫悲歌、伤怀吊古。","烟波无际，望秦关何处。","叹流年、又成虚度。"],"s":"simp","f":"trad"},{"i":"c-5cac49c0f463","t":"谢池春","a":"陆游","d":"宋","g":"词","p":["贺监湖边，初系放翁归棹。","小园林、时时醉倒。","春眠惊起，听啼莺催晓。","叹功名、误人勘笑。","朱桥翠径，不许京尘飞到。","挂朝衣、东归欠早。","连宵风雨，卷残红如扫。","恨樽前、送春人老。"],"s":"simp","f":"trad"},{"i":"c-591e73d321e1","t":"谢池春","a":"陆游","d":"宋","g":"词","p":["七十衰翁，不减少年豪气。","似天山、凄凉病骥。","铜驼荆棘，洒临风清泪。","甚情怀、伴人儿戏。","如今何幸，作个故溪归计。","鹤飞来、晴岚暖翠。","玉壶春酒，约群仙同醉。","洞天寒、露桃开未。"],"s":"simp","f":"trad"},{"i":"c-d18006c4a334","t":"一落索","a":"陆游","d":"宋","g":"词","p":["满路游丝飞絮。","韶光将暮。","此时谁与说新愁，有百啭、流莺语。","俯仰人间今古。","神仙何处。","花前须判醉扶归，酒不到、刘伶墓。"],"s":"simp","f":"trad"},{"i":"c-d5ae47a06721","t":"一落索","a":"陆游","d":"宋","g":"词","p":["识破浮生虚妄。","从人讥谤。","此身恰似弄潮儿，曾过了、千重浪。","且喜归来无恙。","一壶春酿。","雨蓑烟笠傍渔矶，应不是、封侯相。"],"s":"simp","f":"trad"},{"i":"c-a562f7d93bdb","t":"杏花天","a":"陆游","d":"宋","g":"词","p":["老来驹隙骎骎度。","筭只合、狂歌醉舞。","金杯到手君休诉。","看著春光又暮。","谁为倩、柳条系住。","且莫遣、城笳催去。","残红转眼无寻处。","尽属蜂房燕户。"],"s":"simp","f":"trad"},{"i":"c-9fe9af3b4a3b","t":"太平时・添声杨柳枝","a":"陆游","d":"宋","g":"词","p":["竹里房栊一径深。","静愔愔。","乱红飞尽绿成阴。","有鸣禽。","临罢兰亭无一事，自修琴。","铜炉袅袅海南沉。","洗尘襟。"],"s":"simp","f":"trad"},{"i":"c-a0a455830b78","t":"恋绣衾","a":"陆游","d":"宋","g":"词","p":["不惜貂裘换钓篷。","嗟时人、谁识放翁。","归棹借、樵风稳，数声闻、林外暮锺。","幽栖莫笑蜗庐小，有云山、烟水万重。","半世向、丹青看，喜如今、身在画中。"],"s":"simp","f":"trad"},{"i":"c-c72f2fb4caab","t":"恋绣衾","a":"陆游","d":"宋","g":"词","p":["无方能驻脸上红。","笑浮生、扰扰梦中。","平地是、冲霄路，又何劳、千日用功。","飘然再过莲峰下，乱云深、吹下暮锺。","访旧隐、依然在，但鹤巢、时有堕松。"],"s":"simp","f":"trad"},{"i":"c-519c25503be0","t":"风入松","a":"陆游","d":"宋","g":"词","p":["十年裘马锦江滨。","酒隐红尘。","万金选胜莺花海，倚疏狂、驱使青春。","吹笛鱼龙尽出，题诗风月俱新。","自怜华发满纱巾。","犹是官身。","凤楼常记当年语，问浮名、何似身亲。","欲寄吴笺说与，这回真个闲人。"],"s":"simp","f":"trad"},{"i":"c-ae57d225893e","t":"真珠帘","a":"陆游","d":"宋","g":"词","p":["灯前月下嬉游处。","向笙歌、锦绣丛中相遇。","彼此知名，才见便论心素。","浅黛娇蝉风调别，最动人、时时偷顾。","归去。","想闲窗深院，调弦促柱。","乐府初翻新谱。","漫裁红点翠，闲题金缕。","燕子入帘时，又一番春暮。","侧帽燕脂坡下过，料也记、前年崔护。","休诉。","待从今须与，好花为主。"],"s":"simp","f":"trad"},{"i":"c-ebc1746404eb","t":"风流子","a":"陆游","d":"宋","g":"词","p":["佳人多命薄，初心慕、德耀嫁梁鸿。","记绿窗睡起，静吟闲咏，句翻离合，格变玲珑。","更乘兴，素纨留戏墨，纤玉抚孤桐。","蟾滴夜寒，水浮微冻，凤笺春丽，花砑轻红。","人生谁能料，堪悲处、身落柳陌花丛。","空羡画堂鹦鹉，深闭金笼。","向宝镜鸾钗，临妆常晚，绣茵牙版，催舞还慵。","肠断市桥月笛，灯院霜锺。"],"s":"simp","f":"trad"},{"i":"c-3e26ad612e7c","t":"双头莲","a":"陆游","d":"宋","g":"词","p":["风卷征尘，堪叹处、青骢正摇金辔。","客襟贮泪。","漫万点如血，凭谁持寄。","伫想艳态幽情，压江南佳丽。","春正媚。","怎忍长亭，匆匆顿分连理。","目断淡日平芜，望烟浓树远，微茫如荠。","悲欢梦里。","奈倦客、又是关河千里。","最苦唱彻骊歌，重迟留无计。","何限事。","待与丁宁，行时已醉。"],"s":"simp","f":"trad"},{"i":"c-8c4445f88f00","t":"鹧鸪天","a":"陆游","d":"宋","g":"词","p":["杖屦寻春苦未迟。","洛城樱笋正当时。","三千界外归初到，五百年前事总知。","吹玉笛，渡清伊。","相逢休问姓名谁。","小车处士深衣叟，曾是天津共赋诗。"],"s":"simp","f":"trad"},{"i":"c-09df76f67d03","t":"蝶恋花","a":"陆游","d":"宋","g":"词","p":["禹庙兰亭今古路。","一夜清霜，染尽湖边树。","鹦鹉杯深君莫诉。","他时相遇知何处。","冉冉年华留不住。","镜里朱颜，毕竟消磨去。","一句丁宁君记取。","神仙须是闲人做。"],"s":"simp","f":"trad"},{"i":"c-6c1f431a8ab6","t":"渔父・渔歌子","a":"陆游","d":"宋","g":"词","p":["石帆山下雨空濛。","三扇香新翠箬篷。","苹叶绿，蓼花红。","回首功名一梦中。"],"s":"mixed","f":"trad"},{"i":"c-d3b67c7ccf79","t":"渔父・渔歌子","a":"陆游","d":"宋","g":"词","p":["晴山滴翠水挼蓝。","聚散渔舟两复三。","横埭北，断桥南。","侧起船篷便作帆。"],"s":"simp","f":"trad"},{"i":"c-29cb208e1a3a","t":"渔父・渔歌子","a":"陆游","d":"宋","g":"词","p":["镜湖俯仰两青天。","万顷玻璃一叶船。","拈棹舞，拥蓑眠。","不作天仙作水仙。"],"s":"simp","f":"trad"},{"i":"c-c2d527f47093","t":"渔父・渔歌子","a":"陆游","d":"宋","g":"词","p":["湘湖烟雨长莼丝。","菰米新炊滑上匙。","云散后，月斜时。","潮落舟横醉不知。"],"s":"simp","f":"trad"},{"i":"c-0b209865c64f","t":"渔父・渔歌子","a":"陆游","d":"宋","g":"词","p":["长安拜免几公卿。","渔父横眠醉未醒。","烟艇小，钓车腥。","遥指梅山一点青。"],"s":"simp","f":"trad"},{"i":"c-4987e05d9544","t":"恋绣衾","a":"陆游","d":"宋","g":"词","p":["雨断西山晚照明。","悄无人、幽梦自惊。","说道去、多时也，到如今、真个是行。","远山已是无心画，小楼空、斜掩绣屏。","你嚎早、收心呵，趁刘郎、双鬓未星。"],"s":"simp","f":"trad"},{"i":"c-c027dc10f4e3","t":"采桑子","a":"陆游","d":"宋","g":"词","p":["三山山下闲居士，巾履萧然。","小醉闲眠。","风引飞花落钓船。"],"s":"simp","f":"trad"},{"i":"c-9f3c0b31faf7","t":"水龙吟","a":"陆游","d":"宋","g":"词","p":["摩诃池上追游路，红绿参差春晚。","韶光妍媚，海棠如醉，桃花欲暖。","挑菜初闲，禁烟将近，一城丝管。","看金鞍争道，香车飞盖，争先占、新亭馆。","惆怅年华暗换。","黯销魂、雨收云散。","镜奁掩月，钗梁拆凤，秦筝斜雁。","身在天涯，乱山孤垒，危楼飞观。","叹春来只有，杨花和恨、向东风满。"],"s":"simp","f":"trad"},{"i":"c-3f3c07fb9c8c","t":"月照梨花・河传","a":"陆游","d":"宋","g":"词","p":["霁景风软，烟江春涨。","小阁无人，绣帘半上。","花外姊妹相呼。","约樗蒲。","修蛾忘了章台样。","细思一饷。","感事添惆怅。","胸酥臂玉消减，拟觅双鱼。","倩传书。"],"s":"simp","f":"trad"},{"i":"c-6508114101af","t":"月照梨花・河传","a":"陆游","d":"宋","g":"词","p":["闷已萦损。","那堪多病。","几曲屏山，伴人昼静。","梁燕催起犹慵。","换熏龙。","新愁旧恨何时尽。","渐凋绿鬓。","小雨知花信。","芳笺寄与何处，绣阁珠栊。","柳阴中。"],"s":"simp","f":"trad"},{"i":"c-7bec62290d10","t":"夜游宫","a":"陆游","d":"宋","g":"词","p":["宴罢珠帘半卷。","画檐外、蜡香人散。","翠雾霏霏漏声断。","倚香肩，看中庭，花影乱。","宛是高唐馆。","宝奁炷、麝烟初暖。","璧月何妨夜夜满。","拥芳柔，恨今年，寒尚浅。"],"s":"simp","f":"trad"},{"i":"c-cd84d3ee58f5","t":"如梦令","a":"陆游","d":"宋","g":"词","p":["独倚博山峰小。","翠雾满身飞绕。","只恐学行云，去作阳台春晓。","春晓。","春晓。","满院绿阳芳草。"],"s":"simp","f":"trad"},{"i":"c-34e32eb3bd40","t":"失调名","a":"陆游","d":"宋","g":"词","p":["飞上锦裀红皱。"],"s":"simp","f":"trad"},{"i":"c-41e4ead7d45c","t":"解连环","a":"陆游","d":"宋","g":"词","p":["泪淹妆薄。","背东风伫立，柳绵池阁。","漫细字、书满芳笺，恨钗燕筝鸿，总难凭托。","风雨无情，又颠倒、绿苔红萼。","仗香醪破闷，怎禁夜阑，酒酲萧索。","刘郎已望故约。","奈重门静院，光景如昨。","尽做它、别有留心，便不念当时，雨意初著。","京兆眉残，怎忍为、新人梳掠。","尽今生、拼了为伊，任人道错。"],"s":"simp","f":"trad"},{"i":"c-6eb0e66e23bf","t":"大圣乐","a":"陆游","d":"宋","g":"词","p":["电转雷惊，自叹浮生，四十二年。","试思量往事，虚无似梦，悲欢万状，合散如烟。","苦海无边，爱河无底，流浪看成百漏船。","何人解，问无常火里，铁打身坚。","须臾便是华颠。","好收拾形体归自然。","又何通，是非荣辱，此事由来都在天。","从今去，任东西南北，作个飞仙。"],"s":"simp","f":"trad"},{"i":"c-f3242eccff8e","t":"钗头凤・撷芳词","a":"唐婉","d":"宋","g":"词","p":["世情薄。","人情恶。","雨送黄昏花易落。","晓风乾。","泪痕残。","欲笺心事，独语斜阑。","难难难。","人成各。","今非昨。","病魂尝似秋千索。","角声寒。","夜阑珊。","怕人寻问，咽泪装欢。","瞒瞒瞒。"],"s":"mixed","f":"trad"},{"i":"c-798bb5d06f2b","t":"生查子","a":"陆游妾某氏","d":"宋","g":"词","p":["只知愁上眉，不识愁来路。","窗外有芭蕉，阵阵黄昏雨。","逗晓理残妆，整顿教愁去。","不合画春山，依旧留连住。"],"s":"simp","f":"trad"},{"i":"c-7b55bfae669f","t":"祝英台近","a":"王","d":"宋","g":"词","p":["柳烟浓，花露重，合是醉时候。","楼倚花梢，长记小垂手。","谁教钗燕轻分，镜鸾慵舞，是孤负、几番春昼。","自别后。","闻道花底花前，多是两眉皱。","又说新来，比似旧时瘦。","须知两意长存，相逢终有。","莫谩被、春光僝僽。"],"s":"simp","f":"trad"}]