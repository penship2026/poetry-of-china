[{"i":"c0040d15-939e-413c-bb1c-4f7414739294","t":"宿長慶寺","a":"杜牧","d":"唐","g":"短诗","p":["南行步步遠浮塵，更近青山昨夜隣。","高鐸數聲秋撼玉，霽河千里曉橫銀。","紅蕖影落前池淨，綠稻香來野逕頻。","終日官閑無一事，不妨長醉是遊人。"],"s":"trad","f":"simp"},{"i":"5ffb9229-778c-4658-a3f2-3647f2c78658","t":"望少華三首 一","a":"杜牧","d":"唐","g":"短诗","p":["身隨白日看將老，心與青雲自有期。","今對晴峰無十里，世緣多累暗生悲。"],"s":"trad","f":"simp"},{"i":"5167f16f-2433-4946-9838-33fe3aaa5737","t":"望少華三首 二","a":"杜牧","d":"唐","g":"短诗","p":["文字波中去不還，物情初雨是非閑。","時名竟是無端事，羞對靈山道愛山。"],"s":"trad","f":"simp"},{"i":"63f59cc5-72e0-49bf-b420-13d2bbfa6d0f","t":"望少華三首 三","a":"杜牧","d":"唐","g":"短诗","p":["眼看雲鶴不相隨，何況塵中事作爲。","好伴羽人深洞去，月前秋聽玉參差。"],"s":"mixed","f":"simp"},{"i":"ec610ff7-9b53-4b32-a1ba-3be555613e3d","t":"登澧州驛樓寄京兆韋尹","a":"杜牧","d":"唐","g":"短诗","p":["一話涔陽舊使君，郡人迴首望青雲。","政聲長與江聲在，自到津樓日夜聞。"],"s":"trad","f":"simp"},{"i":"e5597111-7112-45e8-8586-4faecb01f022","t":"長安晴望","a":"杜牧","d":"唐","g":"短诗","p":["翠屏山對鳳城開，碧落搖光霽後來。","廻識六龍巡幸處，飛煙閑遶望春臺。"],"s":"trad","f":"simp"},{"i":"40fdde29-bf45-4fa7-a789-92fd327974e0","t":"歲旦朝回口號","a":"杜牧","d":"唐","g":"短诗","p":["星河猶在整朝衣，遠望天門再拜歸。","笑向春風初五十，敢言知命且知非。"],"s":"trad","f":"simp"},{"i":"1dd45230-903a-405d-bb6a-4640a6c18040","t":"驌驦駿","a":"杜牧","d":"唐","g":"短诗","p":["瑤池罷遊宴，良樂委塵沙。","遭遇不遭遇，鹽車與鼓車。"],"s":"trad","f":"simp"},{"i":"aad6ca7c-09f5-4e83-9448-179f08519125","t":"龍丘途中二首 一","a":"杜牧","d":"唐","g":"短诗","p":["漢苑殘花別，吳江盛夏來。","唯看萬樹合，不見一枝開。"],"s":"trad","f":"simp"},{"i":"a8f958fb-19a3-4f73-a257-c2b3888fe227","t":"龍丘途中二首 二","a":"杜牧","d":"唐","g":"短诗","p":["水色饒湘浦，灘聲怯建溪。","淚流迴月上，可得更猿啼。"],"s":"trad","f":"simp"},{"i":"8a7af025-d3cc-48aa-a889-d4760fa64e76","t":"宮人塚","a":"杜牧","d":"唐","g":"短诗","p":["盡是離宮院中女，苑牆城外塚纍纍。","少年入內教歌舞，不識君王到老時。"],"s":"trad","f":"simp"},{"i":"bca25064-fdc9-4fb1-8dae-b888e246550b","t":"寄浙西李判官","a":"杜牧","d":"唐","g":"短诗","p":["燕臺上客意[何如]，四五年來漸漸疎。","直道莫拋男子業，遭時還與故人書。","青雲滿眼應驕我，白髮渾頭少恨渠。","唯念賢哉崔大讓，可憐無事不歌魚。"],"s":"trad","f":"simp"},{"i":"41f83dce-4881-4fcf-b272-d4e8e1384ee9","t":"寄杜子二首 一","a":"杜牧","d":"唐","g":"短诗","p":["不識長楊事北胡，且教紅袖醉來扶。","狂風烈燄雖千尺，豁得平生俊氣無。"],"s":"trad","f":"simp"},{"i":"1262cfeb-1081-4b6d-8996-fde8d1ef31d8","t":"寄杜子二首 二","a":"杜牧","d":"唐","g":"短诗","p":["武牢關吏應相笑，箇裏年年往復來。","若問使君何處去，爲言相憶首長迴。"],"s":"mixed","f":"simp"},{"i":"54ec5857-33f0-42fb-8b62-dfbf80a7d77a","t":"盧秀才將出王屋高步名場江南相逢贈別","a":"杜牧","d":"唐","g":"短诗","p":["王屋山人有古文，欲攀青桂弄氛氳。","將攜健筆干明主，莫向仙壇問白雲。","馳逐寧教爭處讓，是非偏忌衆人分。","交遊話我憑君道，除却鱸魚更不聞。"],"s":"mixed","f":"simp"},{"i":"1acab59d-a894-46c8-94e8-0a256c34df65","t":"送劉三復郎中赴闕","a":"杜牧","d":"唐","g":"短诗","p":["橫溪辭寂寞，金馬去追遊。","好是鴛鴦侶，正逢霄漢秋。","玉珂聲瑣瑣，錦帳夢悠悠。","微笑知今是，因風謝釣舟。"],"s":"trad","f":"simp"},{"i":"eb36dbd4-9bc4-4d36-8373-962f7b63451c","t":"羊欄浦夜陪宴會","a":"杜牧","d":"唐","g":"短诗","p":["戈檻營中夜未央，雨沾雲惹侍襄王。","毬來香袖依稀暖，酒凸斛心汎灩光。","紅弦高緊聲聲急，珠唱鋪圓褭褭長。"],"s":"trad","f":"simp"},{"i":"be6c51dd-d0bb-4030-b9ba-eb4d4a165f76","t":"送杜顗赴潤州幕","a":"杜牧","d":"唐","g":"短诗","p":["少年才俊赴知音，丞相門欄不覺深。","直道事人男子業，異鄉加飯弟兄心。","還須整理韋弦佩，莫獨矜誇玳瑁簪。","若去上元懷古去，謝安墳下與沈吟。"],"s":"trad","f":"simp"},{"i":"037f8e37-1da9-47b7-a350-126a07b33385","t":"有感","a":"杜牧","d":"唐","g":"短诗","p":["宛溪垂柳最長枝，曾被春風盡日吹。","不堪攀折猶堪看，陌上少年來自遲。"],"s":"trad","f":"simp"},{"i":"8f6fb2d1-46dd-4732-a5de-d542f35083f0","t":"書懷寄盧州","a":"杜牧","d":"唐","g":"短诗","p":["謝山南畔州，風物最宜秋。","太守懸金印，佳人敞畫樓。","凝缸暗醉夕，殘月上汀州。","可惜當年鬢，朱門不得遊。"],"s":"trad","f":"simp"},{"i":"2de5b7bd-c485-4b42-96bf-076a90b33e76","t":"賀崔大夫崔正字","a":"杜牧","d":"唐","g":"短诗","p":["內舉無慚古所難，燕臺遙想拂塵冠。","登龍有路水不峻，一鴈背飛天正寒。","別夜酒餘紅燭短，映山帆滿碧霞殘。","謝公樓下潺湲響，離恨詩情添幾般。"],"s":"trad","f":"simp"},{"i":"e5286e89-da5f-4544-8a12-e49f9bb2fbff","t":"江南送左師","a":"杜牧","d":"唐","g":"短诗","p":["江南爲客正悲秋，更送吾師古渡頭。","惆悵不同塵土別，水雲蹤跡去悠悠。"],"s":"mixed","f":"simp"},{"i":"85a19bca-cdc4-4b5b-872c-07ed61be29e5","t":"寢夜","a":"杜牧","d":"唐","g":"短诗","p":["蛩唱如波咽，更深似水寒。","露華驚弊褐，燈影挂塵冠。","故國初離夢，前溪更下灘。","紛紛毫髪事，多少宦遊難。"],"s":"mixed","f":"simp"},{"i":"aeafd492-7902-44b5-a3dc-a18dfc350df7","t":"十九兄郡樓有宴病不赴","a":"杜牧","d":"唐","g":"短诗","p":["十二層樓敞畫簷，連雲歌盡草纖纖。","空堂病怯階前月，燕子嗔垂一竹簾。"],"s":"trad","f":"simp"},{"i":"3fd7fae5-8491-429f-aef4-2ba1b9bcbabf","t":"愁","a":"杜牧","d":"唐","g":"短诗","p":["聚散竟無形，迴腸自結成。","古今留不得，離別又潛生。","降虜將軍思，窮秋遠客情。","何人更憔悴，落第泣秦京。"],"s":"trad","f":"simp"},{"i":"ae02ce20-de19-4c23-9c6c-f782859a773b","t":"隋苑","a":"杜牧","d":"唐","g":"短诗","p":["紅霞一抹廣陵春，定子當筵睡臉新。","却笑喫虧隋煬帝，破家亡國爲誰人。"],"s":"mixed","f":"simp"},{"i":"3135c2ee-00f2-4225-9eba-bbf494faad73","t":"芭蕉","a":"杜牧","d":"唐","g":"短诗","p":["芭蕉爲雨移，故向窓前種。","憐渠點滴聲，留得歸鄉夢。","夢遠莫歸鄉，覺來一翻動。"],"s":"mixed","f":"simp"},{"i":"68957cfc-69fd-4e1c-b185-84c78c02d4c3","t":"汴人舟行荅張祜","a":"杜牧","d":"唐","g":"短诗","p":["千萬長河共使船，聽君詩句倍愴然。","春風野岸名花發，一道帆檣畫柳煙。"],"s":"trad","f":"simp"},{"i":"6fe3bbaf-2f8b-4bf1-a2d1-79f5a6bef477","t":"牧陪昭應盧郎中在江西宣州佐今吏部沈公幕罷府周歲公宰昭應牧在淮南縻職敘舊成二十二韻用以投寄","a":"杜牧","d":"唐","g":"古体","p":["燕鴈下揚州，涼風柳陌愁。","可憐千里夢，還是一年秋。","宛水環朱檻，章江敞碧流。","謬陪吾益友，祗事我賢侯。","印組縈光馬，鋒鋩看解牛。","井閭安樂易，冠蓋愜依投。","政簡稀開閣，功成每運籌。","送春經野塢，遲日上高樓。","玉裂歌聲斷，霞飄舞帶收。","泥情斜拂印，別臉小低頭。","日晚花枝爛，釭凝粉彩稠。","未曾孤酩酊，剩肯隻淹留。","重德俄徵寵，諸生苦宦遊。","分途之絕國，灑淚拜行輈。","聚散真漂梗，光陰急轉郵。","銘心徒歷歷，屈指盡悠悠。","君作烹鮮用，誰膺仄席求。","卷懷能憤悱，卒歲且優遊。","去矣時難遇，沽哉價莫酬。","滿枝爲鼓吹，衷甲避戈矛。","隋帝宮荒草，秦王土一丘。","相逢好大笑，除此總雲浮。"],"s":"mixed","f":"simp"},{"i":"68167dff-23be-4876-a742-f75d80307d9c","t":"寓言","a":"杜牧","d":"唐","g":"短诗","p":["暖風遲日柳初含，顧影看身又自慙。","何事明朝獨惆悵，杏花時節在江南。"],"s":"trad","f":"simp"},{"i":"52a599ad-0b63-410e-b38f-2109e636673f","t":"猿","a":"杜牧","d":"唐","g":"短诗","p":["月白煙青水暗流，孤猿銜恨叫中秋。","三聲欲斷疑腸斷，饒是少年今白頭。"],"s":"trad","f":"simp"},{"i":"dc074254-7e82-4c23-b798-3609e747bec4","t":"懷歸","a":"杜牧","d":"唐","g":"短诗","p":["塵埃終日滿牕前，水態雲容思浩然。","爭得便歸湘浦去，却持竿上釣魚船。"],"s":"mixed","f":"simp"},{"i":"a20b27d3-d785-4d73-8dd9-12b65ffd2e00","t":"邊上晚秋","a":"杜牧","d":"唐","g":"短诗","p":["黑山南面更無州，馬放平沙夜不收。","風送孤城臨晚角，一聲聲入客心愁。"],"s":"trad","f":"simp"},{"i":"4e28d87d-576b-4af0-8a43-63d28c15f811","t":"傷友人悼吹簫妓","a":"杜牧","d":"唐","g":"短诗","p":["玉簫聲斷沒流年，滿目春愁隴樹煙。","豔質已隨雲雨散，鳳樓空鎖月明天。"],"s":"trad","f":"simp"},{"i":"308eb1a8-b305-4809-ae8b-4a13cb09bff8","t":"訪許顏","a":"杜牧","d":"唐","g":"短诗","p":["門近寒溪牕近山，枕山流水日潺潺。","長嫌世上浮雲客，老向塵中不解顏。"],"s":"trad","f":"simp"},{"i":"52fdb35a-5a08-41ba-b6be-996087bf2843","t":"春日古道傍作","a":"杜牧","d":"唐","g":"短诗","p":["萬古榮華旦暮齊，樓臺春盡草萋萋。","君看陌上何人墓，旋化紅塵送馬蹏。"],"s":"trad","f":"simp"},{"i":"304aa711-54e3-4550-b2ab-ec17b1e24a76","t":"青塚","a":"杜牧","d":"唐","g":"短诗","p":["青塚前頭隴水流，燕支山上暮雲秋。","蛾眉一墜窮泉路，夜夜孤魂月下愁。"],"s":"trad","f":"simp"},{"i":"bb217f10-edb0-45b7-8e49-47585cc6c8b9","t":"大夢上人自廬峰回","a":"杜牧","d":"唐","g":"短诗","p":["行脚尋常到寺稀，一枝藜杖一禪衣。","開門滿院空秋色，新向廬峰過夏歸。"],"s":"mixed","f":"simp"},{"i":"0b459de7-7741-4711-9302-d65394318cc5","t":"洛中二首 一","a":"杜牧","d":"唐","g":"短诗","p":["柳動晴風拂路塵，年年宮闕鎖濃春。","一從翠輦無巡幸，老却蛾眉幾許人。"],"s":"mixed","f":"simp"},{"i":"2a39a296-cc21-44b4-84c9-a660196a4e61","t":"洛中二首 二","a":"杜牧","d":"唐","g":"短诗","p":["風吹柳帶搖晴綠，蝶遶花枝戀暖香。","多把芳菲泛春酒，直教愁色對愁腸。"],"s":"trad","f":"simp"},{"i":"1f464abe-9a19-49a5-b026-450807a7661f","t":"邊上聞笳三首 一","a":"杜牧","d":"唐","g":"短诗","p":["何處吹笳薄暮天，塞垣高鳥沒狼煙。","遊人一聽頭堪白，蘇武爭禁十九年。"],"s":"trad","f":"simp"},{"i":"4350de2f-0914-4bdb-b9ce-713bcd97e2f4","t":"邊上聞笳三首 二","a":"杜牧","d":"唐","g":"短诗","p":["海路無塵邊草新，榮枯不見綠楊春。","白沙日暮愁雲起，獨感離鄉萬里人。"],"s":"trad","f":"simp"},{"i":"1927803a-61ed-4f62-a93c-5f498b286c5a","t":"邊上聞笳三首 三","a":"杜牧","d":"唐","g":"短诗","p":["胡雛吹笛上高臺，寒雁驚飛去不回。","盡日春風吹不散，只應分付客愁來。"],"s":"trad","f":"simp"},{"i":"9c0f6ffa-7149-40b9-a8e3-a7579d77259d","t":"春日寄許渾先輩","a":"杜牧","d":"唐","g":"短诗","p":["薊北雁初去，湘南春又歸。","水流滄海急，人到白頭稀。","塞路盡何處，我愁當落暉。","終須接鴛鷺，霄漢共高飛。"],"s":"trad","f":"simp"},{"i":"9b5a42d1-285e-4955-b55a-1917f61167b2","t":"經闔閭城","a":"杜牧","d":"唐","g":"短诗","p":["遺蹤委衰草，行客思悠悠。","昔日人何處，終年水自流。","孤煙邨戌遠，亂雨海門秋。","吟罷獨歸去，煙雲盡慘愁。"],"s":"trad","f":"simp"},{"i":"eb5120bb-738e-4b1f-b212-869ed20e2c48","t":"幷州道中","a":"杜牧","d":"唐","g":"短诗","p":["行役我方倦，苦吟誰復聞。","戌樓春帶雪，邊角暮吹雲。","極目無人迹，回頭送鴈羣。","如何遣公子，高臥醉醺醺。"],"s":"mixed","f":"simp"},{"i":"58912283-2b9a-42fe-be12-744cc183543f","t":"別懷","a":"杜牧","d":"唐","g":"短诗","p":["相別徒成泣，經過總是空。","勞生慣離別，夜夢苦西東。","去路三湘浪，歸程一片風。","他年寄消息，書在鯉魚中。"],"s":"trad","f":"simp"},{"i":"1dae0963-7101-4cf3-a045-1c0607adc419","t":"漁父","a":"杜牧","d":"唐","g":"短诗","p":["白髮滄浪上，全忘是與非。","秋潭垂釣去，夜月叩船歸。","煙影侵蘆岸，潮痕在竹扉。","終年狎鷗鳥，來去且無機。"],"s":"trad","f":"simp"},{"i":"f8aedfad-1722-4af7-8212-a5aec92fd87a","t":"秋夢","a":"杜牧","d":"唐","g":"短诗","p":["寒空動高吹，月色滿清砧。","殘夢夜魂斷，美人邊思深。","孤鴻秋出塞，一葉暗辭林。","又寄征衣去，迢迢天外心。"],"s":"trad","f":"simp"},{"i":"408b44e4-92fd-41f5-a073-6559f58e51e1","t":"早秋客舍","a":"杜牧","d":"唐","g":"短诗","p":["風吹一片葉，萬物已驚秋。","獨夜他鄉淚，年年爲客愁。","別離何處盡，搖落幾時休。","不及磻溪叟，身閑長自由。"],"s":"mixed","f":"simp"},{"i":"7e57dc35-56b8-4e3d-ab51-25d6c4bd1fab","t":"逢故人","a":"杜牧","d":"唐","g":"短诗","p":["故交相見稀，相見倍依依。","塵路事不盡，雲巖閑好歸。","投人銷壯志，徇俗變真機。","又落他鄉淚，風前一滿衣。"],"s":"trad","f":"simp"},{"i":"51ef42d5-7ee1-4f03-abd0-082156116f1c","t":"秋晚江上遣懷","a":"杜牧","d":"唐","g":"短诗","p":["孤舟天際外，去路望中賒。","貧病遠行客，夢魂多在家。","蟬吟秋色樹，鴉噪夕陽沙。","不擬徹雙鬢，他方擲歲華。"],"s":"trad","f":"simp"},{"i":"a8b805ad-170d-4d5b-a213-7fa8a9267ef3","t":"長安夜月","a":"杜牧","d":"唐","g":"短诗","p":["寒光垂靜夜，皓彩滿重城。","萬國盡分照，誰家無此明。","古槐疎影薄，仙桂動秋聲。","獨有長門裏，蛾眉對曉晴。"],"s":"mixed","f":"simp"},{"i":"28433d8d-5936-45da-ade8-19c96e9b7882","t":"雲","a":"杜牧","d":"唐","g":"短诗","p":["東西那有礙，出處豈虛心。","曉入洞庭闊，暮歸巫峽深。","渡江隨鳥影，擁樹隔猿吟。","莫隱高唐去，枯苗待作霖。"],"s":"trad","f":"simp"},{"i":"524e074f-6a93-407d-860f-6aedbcafb736","t":"春懷","a":"杜牧","d":"唐","g":"短诗","p":["年光何太急，倏忽又青春。","明月誰爲主，江山暗換人。","鶯花潛運老，榮樂漸成塵。","遙憶朱門柳，別離應更頻。"],"s":"mixed","f":"simp"},{"i":"916b8772-417b-4c41-8444-cc5cf7653df1","t":"逢故人","a":"杜牧","d":"唐","g":"短诗","p":["年年不相見，相見却成悲。","教我淚如霰，嗟君髪似絲。","正傷攜手處，況值落花時。","莫惜今宵醉，人間忽忽期。"],"s":"mixed","f":"simp"},{"i":"fa3e549f-176c-48b3-bf3e-c713f218bea3","t":"閑題","a":"杜牧","d":"唐","g":"短诗","p":["男兒所在即爲家，百鎰黃金一朵花。","借問春風何處好，綠楊深巷馬頭斜。"],"s":"mixed","f":"simp"},{"i":"2029f78f-5712-4d96-ac73-6400df8b6f61","t":"重登科","a":"杜牧","d":"唐","g":"短诗","p":["星漢離宮月出輪，滿街含笑綺羅春。","花前每被青蛾問，何事重來只一人。"],"s":"trad","f":"simp"},{"i":"28799a12-e0c3-48ef-a28a-5524333f8f4a","t":"遊邊","a":"杜牧","d":"唐","g":"短诗","p":["黃沙連海路無塵，邊草長枯不見春。","日暮拂雲堆下過，馬前逢著射鵰人。"],"s":"trad","f":"simp"},{"i":"092a87b0-7174-4349-aa8e-66e55664ce16","t":"將赴池州道中作","a":"杜牧","d":"唐","g":"短诗","p":["青陽雲水去年尋，黃絹歌詩出翰林。","投轄暫停留酒客，絳帷斜繫滿松陰。","妖人笑我不相問，道者應知歸路心。","南去南來盡鄉國，月明秋水只沈沈。"],"s":"trad","f":"simp"},{"i":"c96d8cbe-15b2-4741-8223-cdf24c7d0b3c","t":"隋宮春","a":"杜牧","d":"唐","g":"短诗","p":["龍舟東下事成空，蔓草萋萋滿故宮。","亡國亡家爲顏色，露桃猶自恨春風。"],"s":"mixed","f":"simp"},{"i":"18046e74-6340-4797-808e-aaf0a557caee","t":"蠻中醉","a":"杜牧","d":"唐","g":"短诗","p":["瘴塞蠻江入洞流，人家多在竹棚頭。","青山海上無城郭，唯見松牌出象州。"],"s":"trad","f":"simp"},{"i":"cc1f4baf-4d3d-4694-8e1e-2e6a3c06f737","t":"寓題","a":"杜牧","d":"唐","g":"短诗","p":["把酒直須判酩酊，逢花莫惜暫淹留。","假如三萬六千日，半是悲哀半是愁。"],"s":"trad","f":"simp"},{"i":"1fc932b9-69e4-4562-b3b9-bf4bfeae9e54","t":"送趙十二赴舉","a":"杜牧","d":"唐","g":"短诗","p":["省事却因多事力，無心翻似有心來。","秋風郡閣殘花在，別後何人更一杯。"],"s":"mixed","f":"simp"},{"i":"62506da7-05c5-4c55-878a-0b86b2ab50fe","t":"偶呈鄭先輩","a":"杜牧","d":"唐","g":"短诗","p":["不語亭亭儼薄粧，畫裙雙鳳鬱金香。","西京才子旁看取，何似喬家郍窈娘。"],"s":"trad","f":"simp"},{"i":"d93b8de9-bb98-4e94-ac57-56fb66930975","t":"子規","a":"杜牧","d":"唐","g":"短诗","p":["蜀地曾聞子規鳥，宣城又見杜鵑花。","一呌一回腸一斷，三春三月憶三巴。"],"s":"trad","f":"simp"},{"i":"9d95e279-c674-4b69-a5e9-1b8585ff0f21","t":"江樓","a":"杜牧","d":"唐","g":"短诗","p":["獨酌芳春酒，登樓已半醺。","誰驚一行雁，衝斷過江雲。"],"s":"trad","f":"simp"},{"i":"ee85588c-0534-4102-8f5c-e305f5f4eec0","t":"杜鵑","a":"杜牧","d":"唐","g":"短诗","p":["杜宇竟何冤，年年呌蜀門。","至今銜積恨，終古弔殘魂。","芳草迷腸結，紅花染血痕。","山川盡春色，嗚咽復誰論。"],"s":"trad","f":"simp"},{"i":"a4b1c163-b708-42d3-99af-a02f36eac49d","t":"聞蟬","a":"杜牧","d":"唐","g":"短诗","p":["火雲初似滅，曉角欲微清。","故國行千里，新蟬忽數聲。","時行仍髣髴，度日更分明。","不敢頻傾耳，唯憂白髮生。"],"s":"trad","f":"simp"},{"i":"cde49e9e-6a1b-4410-9be7-00f366a05d55","t":"送友人","a":"杜牧","d":"唐","g":"短诗","p":["十載名兼利，人皆與命爭。","青春留不住，白髮自然生。","夜雨滴鄉思，秋風從別情。","都門五十里，馳馬逐雞聲。"],"s":"trad","f":"simp"},{"i":"30040ee2-58a0-4ff6-be84-c8c55f440a88","t":"旅情","a":"杜牧","d":"唐","g":"短诗","p":["窗虛枕簟涼，寢倦憶瀟湘。","山色幾時老，人心終日忙。","松風半夜雨，簾月滿堂霜。","匹馬好歸去，江頭橘正香。"],"s":"trad","f":"simp"},{"i":"71cf556f-c9b9-48dc-b8db-cd0e71489eab","t":"曉望","a":"杜牧","d":"唐","g":"短诗","p":["獨起望山色，水雞鳴蓼洲。","房星隨月曉，楚木向雲秋。","曲渚疑江盡，平沙似浪浮。","秦原在何處，澤國碧悠悠。"],"s":"trad","f":"simp"},{"i":"58f6dd3b-adc6-4b9e-9ef0-64fbb119926d","t":"貽友人","a":"杜牧","d":"唐","g":"短诗","p":["自是東西客，逢人又送人。","不應相見老，秖是別離頻。","度日還知暮，平生未識春。","儻無遷谷分，歸去養天真。"],"s":"trad","f":"simp"},{"i":"97a85c63-017e-4e4f-afbb-7584f6d9f977","t":"書事","a":"杜牧","d":"唐","g":"短诗","p":["自笑走紅塵，流年舊復新。","東風半夜雨，南國萬家春。","失計拋魚艇，何門化涸鱗。","是誰添歲月，老却暗投人。"],"s":"mixed","f":"simp"},{"i":"7b531a90-ba92-4f64-97e5-e7a353f14f65","t":"別鶴","a":"杜牧","d":"唐","g":"短诗","p":["分飛共所從，六翮勢催風。","聲斷碧雲外，影孤明月中。","青田歸路遠，丹桂舊巢空。","矯翼知何處，天涯不可窮。"],"s":"trad","f":"simp"},{"i":"0aa8fae9-ffb6-4bce-82ce-6e07262b64dc","t":"晚泊","a":"杜牧","d":"唐","g":"短诗","p":["帆濕去悠悠，停橈宿渡頭。","亂煙迷野岸，獨鳥出中流。","[篷]雨延鄉夢，江風阻暮秋。","儻無身外事，甘老向扁舟。"],"s":"trad","f":"simp"},{"i":"caaca622-c956-41cc-8332-ed41f24818a7","t":"山寺","a":"杜牧","d":"唐","g":"短诗","p":["峭壁引行徑，截溪開石門。","泉飛濺虛檻，雲起漲河軒。","隔水看來路，疎籬見定猿。","未閑難久住，歸去復何言。"],"s":"trad","f":"simp"},{"i":"e8712c56-38dc-490d-81ce-03dbb8fac1a1","t":"早行","a":"杜牧","d":"唐","g":"短诗","p":["垂鞭信馬行，數里未雞鳴。","林下帶殘夢，葉飛時忽驚。","霜凝孤鶴逈，月曉遠山橫。","僮僕休辭險，時平路復平。"],"s":"mixed","f":"simp"},{"i":"6de81737-7d03-4b65-87cb-fc3a286825b8","t":"秋日偶題","a":"杜牧","d":"唐","g":"短诗","p":["荷花兼柳葉，彼此不勝秋。","玉露滴初泣，金風吹更愁。","綠眉甘棄墜，紅臉恨飄流。","歎息是遊子，少年還白頭。"],"s":"trad","f":"simp"},{"i":"3f5d1c3a-0f7a-4acf-8a5b-0a90f5eda796","t":"憶歸","a":"杜牧","d":"唐","g":"短诗","p":["新城非故里，終日想柴扃。","興罷花還落，愁來酒欲醒。","何人初髪白，幾處亂山青。","遠憶湘江上，漁歌對月聽。"],"s":"trad","f":"simp"},{"i":"b15e15e7-93ac-4923-bf7b-d5e06a4104a2","t":"偶見","a":"杜牧","d":"唐","g":"短诗","p":["朔風高緊掠河樓，白鼻騧郎白罽裘。","有箇當壚明似月，馬鞭斜揖笑回頭。"],"s":"trad","f":"simp"},{"i":"09f484d9-6b45-4920-9497-7f9c1e94c4f1","t":"醉倒","a":"杜牧","d":"唐","g":"短诗","p":["日晴空樂下仙雲，俱在涼亭送使君。","莫辭一盞即相請，還是三年更不聞。"],"s":"trad","f":"simp"},{"i":"a6ea719c-de54-450a-a810-ec7e136445f7","t":"酬許十三秀才兼依來韻","a":"杜牧","d":"唐","g":"短诗","p":["多爲裁詩步竹軒，有時凝思過朝昏。","篇成敢道懷金璞，吟苦唯應似嶺猿。","迷興每慙花月夕，寄愁長在別離魂。","憑君把卷侵寒燭，麗句時傳畫戟門。"],"s":"mixed","f":"simp"},{"i":"9c486955-3227-4d91-a098-df46818ca5c8","t":"後池泛舟送王十秀才","a":"杜牧","d":"唐","g":"短诗","p":["城日晚悠悠，弦歌在碧流。","夕風飄度曲，煙嶼隱行舟。","問拍擬新令，憐香占彩毬。","當筵雖一醉，寧復緩離愁。"],"s":"mixed","f":"simp"},{"i":"41e6abd8-7f86-47c8-8864-80194d5f471e","t":"書情","a":"杜牧","d":"唐","g":"短诗","p":["誰家洛浦神，十四五來人。","媚髪輕垂額，香衫軟著身。","摘蓮紅袖濕，窺淥翠蛾頻。","飛鵲徒來往，平陽公主親。"],"s":"trad","f":"simp"},{"i":"8b9be387-45c4-434b-b095-169df99f2a87","t":"兵部尚書席上作","a":"杜牧","d":"唐","g":"短诗","p":["華堂今日綺筵開，誰喚分司御史來。","偶發狂言驚滿坐，三重粉面一時回。"],"s":"trad","f":"simp"},{"i":"91cb2639-7f72-4881-98fc-ab984c5e1dec","t":"驌驦坂","a":"杜牧","d":"唐","g":"短诗","p":["荆州一萬里，不如蒯易度。","仰首望飛鳴，伊人何異趣。"],"s":"mixed","f":"simp"},{"i":"8310ffab-fa9e-473b-b587-7f192954d94d","t":"冬日五湖館水亭懷別","a":"杜牧","d":"唐","g":"短诗","p":["蘆荻花多觸處飛，獨凭虛檻雨微微。","寒林葉落鳥巢出，古渡風高漁艇稀。","雲抱四山終日在，草荒三徑幾時歸。","江城向晚西流急，無限鄉心聞擣衣。"],"s":"mixed","f":"simp"},{"i":"79cbc5bd-e582-45c9-81dc-41faae227083","t":"不寢","a":"杜牧","d":"唐","g":"短诗","p":["到曉不成夢，思量堪白頭。","多無百年命，長有萬般愁。","世路應難盡，營生卒未休。","莫言名與利，名利是身讐。"],"s":"trad","f":"simp"},{"i":"8c798165-fe62-41c4-aaff-9d53cca79408","t":"泊松江","a":"杜牧","d":"唐","g":"短诗","p":["清露白雲明月天，與君齊櫂木蘭船。","南湖風雨一相失，夜泊橫塘心渺然。"],"s":"trad","f":"simp"},{"i":"28f10c86-ee73-4720-8e9c-0b39561a8578","t":"題水西寺","a":"杜牧","d":"唐","g":"短诗","p":["三日去還住，一生焉再遊。","含情碧溪水，重上粲公樓。"],"s":"trad","f":"simp"},{"i":"487f4f4a-f3ef-46fb-98cf-4454f7135e85","t":"贈別宣州崔羣相公","a":"杜牧","d":"唐","g":"短诗","p":["衰散相逢洛水邊，却思同在紫薇天。","盡將舟楫板橋去，早晚歸來更濟川。"],"s":"mixed","f":"simp"},{"i":"b4155273-6b2c-477f-9ddc-08722def1c6a","t":"聞開江相國宋下世二首 一","a":"杜牧","d":"唐","g":"短诗","p":["權門陰進奪移才，驛騎如星墮峽來。","晁氏有恩忠作禍，賈生無罪直爲災。","貞魂誤向崇山沒，冤氣疑從湘水回。","畢竟成功何處是，五湖雲月一帆開。"],"s":"mixed","f":"simp"},{"i":"bfc79005-7c71-4365-bbe6-6ff9b4a7f44a","t":"聞開江相國宋下世二首 二","a":"杜牧","d":"唐","g":"短诗","p":["月落清湘棹不喧，玉杯瑤瑟奠蘋蘩。","誰令力制乘軒鶴，自取機沈在檻猿。","位極乾坤三事貴，謗興華夏一夫冤。","宵衣旰食明天子，日伏青蒲不爲言。"],"s":"mixed","f":"simp"},{"i":"7efa218b-1573-4c81-91fa-24b9c998caea","t":"出關","a":"杜牧","d":"唐","g":"短诗","p":["朝纓初解佐江濆，麋鹿心知自有羣。","漢囿獵稀慵獻賦，楚山耕早任移文。","臥歸漁浦月連海，行望鳳城花隔雲。","關吏不須迎馬笑，去時無意學終軍。"],"s":"mixed","f":"simp"},{"i":"8bc003c1-d2d3-4708-b014-7048cda8846b","t":"暝投雲智寺渡溪不得却取沿江路往","a":"杜牧","d":"唐","g":"短诗","p":["雙嵓瀉一川，回馬斷橋前。","古廟陰風地，寒鐘暮雨天。","沙虛留虎跡，水滑帶龍涎。","却下臨江路，潮深無渡船。"],"s":"mixed","f":"simp"},{"i":"3af260ca-3d83-46a3-b1d3-7f8edac1789e","t":"宣城贈蕭兵曹","a":"杜牧","d":"唐","g":"古体","p":["桂檝謫湘渚，三年波上春。","舟寒句溪雪，衣故洛城塵。","客道恥搖尾，皇恩寬犯鱗。","花時去國遠，月夕上樓頻。","賒酒不辭病，傭書非爲貧。","行吟值漁父，坐隱對樵人。","紫陌罷雙轍，碧潭窮一綸。","高秋更南去，煙水是通津。"],"s":"mixed","f":"simp"},{"i":"988f49d0-3ae0-4a41-a673-0817a1ea97e0","t":"過鮑溶宅有感","a":"杜牧","d":"唐","g":"短诗","p":["寥落故人宅，重來身已亡。","古苔殘墨沼，深竹舊書堂。","秋色池館靜，雨聲雲木涼。","無因展交道，日暮倍心傷。"],"s":"trad","f":"simp"},{"i":"584fe075-d3b6-47c4-a182-0c169ca14b5a","t":"寄兄弟","a":"杜牧","d":"唐","g":"短诗","p":["江城紅葉盡，旅思倍淒涼。","孤夢家山遠，獨眠秋夜長。","道存空倚命，身賤未歸鄉。","南望仍垂淚，天邊鴈一行。"],"s":"trad","f":"simp"},{"i":"e982c7d4-77e3-47d1-9005-8916b7347c70","t":"秋日","a":"杜牧","d":"唐","g":"短诗","p":["有計自安業，秋風罷遠吟。","買山惟種竹，對客更彈琴。","煙起藥厨晚，杵聲松院深。","閑眠得真性，惆悵舊時心。"],"s":"mixed","f":"simp"}]