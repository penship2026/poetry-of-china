[{"i":"a02fcd79-41d9-446d-a035-f2c571c2184b","t":"宮詞 一百六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["牡丹移向苑中栽，盡是藩方進入來。","未到末春緣地暖，數般顏色一時開。"],"s":"trad","f":"simp"},{"i":"fb5d880e-5c1a-4365-a53b-010eab3a2764","t":"宮詞 一百七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["明朝臘日官家出，隨駕先須點內人。","回鶻衣裝回鶻馬，就中偏稱小腰身。"],"s":"trad","f":"simp"},{"i":"2a700d86-d868-42ea-803e-b16957ac963d","t":"宮詞 一百八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["盤鳳鞍韉閃色妝，黃金壓胯紫游韁。","自從揀得真龍種，別置東頭小馬坊。"],"s":"mixed","f":"simp"},{"i":"10f1478c-6822-4230-b9b4-5eb4dc4f011b","t":"宮詞 一百九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["翠輦每從城畔出，內人相次簇池隈。","嫩荷花裏搖船去，一陣香風逐水來。"],"s":"mixed","f":"simp"},{"i":"729f146d-ce0f-4590-b8d4-ffeb07621ee6","t":"宮詞 一百一十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["高燒紅燭點銀燈，秋晚花池景色澄。","今夜聖人新殿宿，後宮相競覓祇承。"],"s":"trad","f":"simp"},{"i":"1cc630e3-1160-4b19-8fd0-1c590f75ea94","t":"宮詞 一一一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["苑中排比宴秋宵，弦管掙摐各自調。","日晚閣門傳聖旨，明朝盡放紫宸朝。"],"s":"trad","f":"simp"},{"i":"c4e2a8db-f500-4c9b-9b8f-72cfdf9ba025","t":"宮詞 一一二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["夜深飲散月初斜，無限宮嬪亂插花。","近侍婕妤先過水，遙聞隔岸喚船家。"],"s":"trad","f":"simp"},{"i":"9376904b-c934-4c8e-a149-87fdcaaf9207","t":"宮詞 一一三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["宮娥小小豔紅妝，唱得歌聲遶畫梁。","緣是太妃新進入，座前頒賜小羅箱。"],"s":"trad","f":"simp"},{"i":"06422b27-23a9-4077-85d1-8715e27fb1c1","t":"宮詞 一一四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["池心小樣釣魚船，入玩偏宜向晚天。","挂得綵帆教便放，急風吹過水門前。"],"s":"mixed","f":"simp"},{"i":"c5d93023-ef82-4a65-9991-d5c0abefadf8","t":"宮詞 一一五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["傍池居住有漁家，收網搖船到淺沙。","預進活魚供日料，滿筐跳躍白銀花。"],"s":"trad","f":"simp"},{"i":"1b90a7a8-09d8-41d7-b531-9d21f4273d82","t":"宮詞 一一六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["秋晚紅妝傍水行，競將衣袖撲蜻蜓。","回頭瞥見宮中喚，幾度藏身入畫屏。"],"s":"trad","f":"simp"},{"i":"f58ddcb8-b5af-4881-a61d-44dccdfe3b79","t":"宮詞 一一七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["御溝春水碧于天，宮女尋花入內園。","汗溼紅妝行漸困，岸頭相喚洗花鈿。"],"s":"mixed","f":"simp"},{"i":"65b328c0-cfc8-4aa7-b874-86eb8363b1fe","t":"宮詞 一一八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["亭高百尺立春風，引得君王到此中。","牀上翠屏開六扇，折枝花綻牡丹紅。"],"s":"mixed","f":"simp"},{"i":"35bfc82c-285a-40b4-9401-cb9691d7d3b7","t":"宮詞 一一九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["內人承寵賜新房，紅紙泥窗遶畫廊。","種得海柑纔結子，乞求自送與君王。"],"s":"mixed","f":"simp"},{"i":"1b98f1cc-efbb-436e-9593-a5a330f08479","t":"宮詞 一百二十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["翡翠簾前日影斜，御溝春水浸成霞。","侍臣向晚隨天步，共看池頭滿樹花。"],"s":"trad","f":"simp"},{"i":"2c9a1be0-9ea7-49a5-92e0-86b3858f4264","t":"宮詞 一二一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["金碧闌干倚岸邊，捲簾初聽一聲蟬。","殿頭日午搖紈扇，宮女爭來玉座前。"],"s":"mixed","f":"simp"},{"i":"3109bfef-690e-4902-88a6-99bc6c93e08e","t":"宮詞 一二二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["嫩荷香撲釣魚亭，水面文魚作隊行。","宮女齊來池畔看，傍簾呼喚勿高聲。"],"s":"trad","f":"simp"},{"i":"53f05781-62fd-43e0-876f-9a9f8c93f0dc","t":"宮詞 一二三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["新翻酒令著詞章，侍宴初聞憶却忙。","宣使近臣傳賜本，書家院裏徧抄將。"],"s":"mixed","f":"simp"},{"i":"7c8a19cf-d1ef-47d7-be4d-5006649d796b","t":"宮詞 一二四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["寒食清明小殿旁，綵樓雙夾鬬雞場。","內人對御分明看，先賭紅羅被十牀。"],"s":"mixed","f":"simp"},{"i":"22128616-b1ba-46aa-b17b-02249ecef9d4","t":"宮詞 一二五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["寢殿門前曉色開，紅泥藥樹間花栽。","君王未起翠簾捲，又發宮人上直來。"],"s":"trad","f":"simp"},{"i":"85bbac29-be58-405d-97e4-dae0fddfa79c","t":"宮詞 一二六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["海棠花發盛春天，游賞無時引御筵。","遶岸結成紅錦帳，暖枝猶拂畫樓船。"],"s":"mixed","f":"simp"},{"i":"5fa82f1c-7ac9-454d-a863-5c73633a3fd5","t":"宮詞 一二七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["日晚宮人外按回，自牽驄馬出林隈。","御前接得高叉手，射得山雞喜進來。"],"s":"trad","f":"simp"},{"i":"4a6a9cb8-9800-432d-8a37-97b19767d698","t":"宮詞 一二八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["朱雀門高花外開，毬場空闊淨塵埃。","預排白兔兼蒼狗，等候君王按鶻來。"],"s":"trad","f":"simp"},{"i":"c0f3ca8a-4f9f-430f-b15d-82146517e73d","t":"宮詞 一二九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["會仙觀內玉清壇，新點宮人作女冠。","每度駕來羞不出，羽衣初著怕人看。"],"s":"trad","f":"simp"},{"i":"722aa853-4e6e-4304-af2b-7f628cbbf497","t":"宮詞 一百三十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["老大初教學道人，鹿皮冠子澹黃裙。","後宮歌舞今拋擲，每日焚香事老君。"],"s":"trad","f":"simp"},{"i":"5c414799-51fc-49e5-a302-39a32ba2bd0a","t":"宮詞 一三一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["法雲寺裏中元節，又是官家誕降辰。","滿殿香花爭供養，內園先占得鋪陳。"],"s":"mixed","f":"simp"},{"i":"311ca331-59d1-4ee6-9910-510ccf51f561","t":"宮詞 一三二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["金章紫綬選高班，每每東頭近聖顏。","才藝足當恩寵別，只堪供奉一場閑。"],"s":"trad","f":"simp"},{"i":"febcde21-de13-4cec-a730-258cf808fe86","t":"宮詞 一三三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["內人深夜學迷藏，徧遶花叢水岸傍。","乘興忽來仙洞裏，大家尋覓一時忙。"],"s":"mixed","f":"simp"},{"i":"68ee7d18-e4d6-4c36-84c6-0fe2f91bc4a3","t":"宮詞 一三四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["小院珠簾著地垂，院中排比不相知。","羨他鸚鵡能言語，窗裏偷教鸜鵒兒。"],"s":"mixed","f":"simp"},{"i":"f3ffe66d-be07-491e-bdee-8b69424731ef","t":"宮詞 一三五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["島樹高低約浪痕，苑中斜日欲黃昏。","樹頭木刻雙飛鶴，蕩起晴空映水門。"],"s":"trad","f":"simp"},{"i":"4df74381-da45-46eb-aa2b-267e94853dae","t":"宮詞 一三六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["大臣承寵賜新莊，梔子園東柳岸傍。","今日聖恩親幸到，板橋頭是讀書堂。"],"s":"trad","f":"simp"},{"i":"c5d7f496-88ef-4e59-a9f8-d8324f7119a4","t":"宮詞 一三七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["樹葉初成鳥護窠，石榴花裏笑聲多。","衆中遺却金釵子，拾得從他要贖麽。"],"s":"mixed","f":"simp"},{"i":"db234dfa-ac76-4dc9-ac02-c86853b6f7b1","t":"宮詞 一三八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["小殿初成粉未乾，貴妃姊妹自來看。","爲逢好日先移入，續向街西索牡丹。"],"s":"mixed","f":"simp"},{"i":"3726a9ae-4a2e-4cd2-a43b-e65da5bbb72f","t":"宮詞 一三九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["內人相續報花開，准擬君王便看來。","逢著五弦琴繡袋，宜春院裏按歌回。"],"s":"mixed","f":"simp"},{"i":"1b7a9a39-8cc3-4652-b78a-6d92d7d6c4dd","t":"宮詞 一百四十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["巡吹慢遍不相和，暗數看誰曲校多。","明日梨花園裏見，先須逐得內家歌。"],"s":"mixed","f":"simp"},{"i":"75813571-6ac8-4cb9-8c66-48543f292c50","t":"宮詞 一四一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["黃金合裏盛紅雪，重結香羅四出花。","一一傍邊書勑字，中官送與大臣家。"],"s":"mixed","f":"simp"},{"i":"ac71ba13-9c78-4953-a1b5-d77f1a4c2e88","t":"宮詞 一四二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["宮人早起笑相呼，不識堦前掃地夫。","乞與金錢爭借問，外頭還似此間無。"],"s":"trad","f":"simp"},{"i":"d6176fee-0c5a-4df4-9eaa-f145a52e9a0d","t":"宮詞 一四三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["小隨阿姊學吹笙，見好君王賜與名。","夜拂玉牀朝把鏡，黃金殿外不教行。"],"s":"mixed","f":"simp"},{"i":"267aa9a6-35dd-4510-99cc-036d6c20bbf1","t":"宮詞 一四四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["日高殿裏有香煙，萬歲聲長動九天。","妃子院中初降誕，內人爭乞洗兒錢。"],"s":"mixed","f":"simp"},{"i":"a2c8c8ad-16fd-42ee-a1e7-2c0e91186a16","t":"宮詞 一四五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["宮花不共外花同，正月長生一半紅。","供御櫻桃看守別，直無鴉鵲到園中。"],"s":"trad","f":"simp"},{"i":"c98e6143-20c2-4d50-8b16-2ff1ddb68919","t":"宮詞 一四六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["殿前鋪設兩邊樓，寒食宮人步打毬。","一半走來爭跪拜，上棚先謝得頭籌。"],"s":"trad","f":"simp"},{"i":"655b60a7-1bae-4d81-854c-6b617b2be88b","t":"宮詞 一四七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["大儀前日暖房來，囑向朝陽乞藥栽。","勑賜一窠紅躑躅，謝恩未了奏花開。"],"s":"trad","f":"simp"},{"i":"5acbdb74-f9e2-4cca-a00f-9f5e8136e842","t":"宮詞 一四八","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["御前新賜紫羅襦，步步金堦上軟輿。","宮局總來爲喜樂，院中新拜內尚書。"],"s":"mixed","f":"simp"},{"i":"c87d4b0a-9376-4e6d-8a66-cae076759e8a","t":"宮詞 一四九","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["鸚鵡誰教轉舌關，內人手裏養來姦。","語多更覺承恩澤，數對君王憶隴山。"],"s":"mixed","f":"simp"},{"i":"0720cffd-74d1-4404-8398-627075c794bd","t":"宮詞 一百五十","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["分朋閑坐賭櫻桃，收却投壺玉腕勞。","各把沈香雙陸子，局中鬬累阿誰高。"],"s":"mixed","f":"simp"},{"i":"c3b675d5-e03f-499a-9151-546111b7c8be","t":"宮詞 一五一","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["禁寺紅樓內裏通，笙歌引駕夾城東。","裹頭宮監堂前立，手把牙鞘竹彈弓。"],"s":"mixed","f":"simp"},{"i":"06c487ac-e001-4c52-860c-56db60976ca5","t":"宮詞 一五二","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["舞來汗溼羅衣徹，樓上人扶下玉梯。","歸到院中重洗面，金花盆裏潑銀泥。"],"s":"mixed","f":"simp"},{"i":"15e47fc5-310f-4f20-8413-86a19cf62912","t":"宮詞 一五三","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["宿妝殘粉未明天，總立昭陽花樹邊。","寒食內人長白打，庫中先散與金錢。"],"s":"trad","f":"simp"},{"i":"d8327b84-ee0f-415e-8791-e581205d5938","t":"宮詞 一五四","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["衆中偏得君王笑，偷把金箱筆硯開。","書破紅蠻隔子上，旋推當直美人來。"],"s":"mixed","f":"simp"},{"i":"2c9b0abe-c435-401d-997c-841ae1bfefc2","t":"宮詞 一五五","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["水中芹葉土中花，拾得還將避衆家。","總待別人般數盡，袖中拈出鬱金芽。"],"s":"mixed","f":"simp"},{"i":"08bdaea3-57d1-4821-ab9f-1b2478897eb9","t":"宮詞 一五六","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["玉簫改調箏移柱，催換紅羅繡舞筵。","未戴柘枝花帽子，兩行宮監在簾前。"],"s":"trad","f":"simp"},{"i":"c8a78b67-36f3-4d4e-b52a-28013dfe7677","t":"宮詞 一五七","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["窗窗戶戶院相當，總有珠簾玳瑁牀。","雖道君王不來宿，帳中長是炷牙香。"],"s":"mixed","f":"simp"},{"i":"5923651a-6a7a-4f09-8b2b-b40ae5d0f5b2","t":"述國亡詩","a":"花蕊夫人徐氏","d":"唐","g":"短诗","p":["君王城上豎降旗，妾在深宮那得知。","十四萬人齊解甲，寧無一箇是男兒。"],"s":"trad","f":"simp"},{"i":"86b5a7dd-165a-44d3-b6f3-06b381ddf34e","t":"新妝詩","a":"楊容華","d":"唐","g":"短诗","p":["啼鳥驚眠罷，房櫳乘曉開。","鳳釵金作縷，鸞鏡玉爲臺。","妝似臨池出，人疑向月來。","自憐終不見，欲去復裴回。"],"s":"mixed","f":"simp"},{"i":"99a38e7c-68df-4432-938a-38925d44330c","t":"贈外","a":"魏氏","d":"唐","g":"古体","p":["浮萍依綠水，弱蔦寄青松。","與君結大義，移天得所從。","翰林無雙鳥，劒水不分龍。","諧和類琴瑟，堅固同膠漆。","義重恩欲深，夷險貴如一。","本自身不令，積多嬰痛疾。","朝夕倦牀枕，形體恥巾櫛。","遊子倦風塵，從官初解巾。","束裝赴南郢，脂駕出西秦。","比翼終難遂，銜雌苦未因。","徒悲楓岸遠，空對柳園春。","男兒不重舊，丈夫多好新。","新人喜新聘，朝朝臨粉鏡。","兩鴛固無比，雙蛾誰與競。","詎憐愁思人，銜啼嗟薄命。","蕣華不足恃，松枝有餘勁。","所願好九思，勿令虧百行。"],"s":"mixed","f":"simp"},{"i":"36de2690-e81e-47f5-8c68-89759bf3c62d","t":"詠破簾","a":"喬氏","d":"唐","g":"短诗","p":["已漏風聲罷，繩持也不禁。","一從經落後，無復有貞心。"],"s":"trad","f":"simp"},{"i":"febe0c8d-ba4a-4237-a6b2-60217f730bbb","t":"送兄","a":"七歲女子","d":"唐","g":"短诗","p":["別路雲初起，離亭葉正飛。","所嗟人異鴈，不作一行歸。"],"s":"trad","f":"simp"},{"i":"56b4df17-a710-403f-833e-bb07e31937cf","t":"送男左貶詩","a":"林氏","d":"唐","g":"古体","p":["他日初投杼，勤王在飲冰。","有辭期不罰，積毀竟相仍。","謫宦今何在，銜冤猶未勝。","天涯分越徼，驛騎速毘陵。","腸斷腹非苦，書傳寫豈能。","淚添江水遠，心劇海雲蒸。","明月珠難識，甘泉賦可稱。","但將忠報主，何懼點青蠅。"],"s":"trad","f":"simp"},{"i":"5165fe9c-eb8f-43b4-a41e-30fa96c19d2e","t":"古興 一","a":"趙氏","d":"唐","g":"古体","p":["鬱蒸夏將半，暑氣扇飛閣。","驟雨滿空來，當軒卷羅幕。","度雲開夕霽，宇宙何清廓。","明月流素光，輕風換炎鑠。","孤鸞傷對影，寶瑟悲別鶴。","君子去不還，遙心欲何託。"],"s":"trad","f":"simp"},{"i":"6e0cd288-b30f-484a-a024-45a61bc07930","t":"古興 二","a":"趙氏","d":"唐","g":"短诗","p":["金菊延清霜，玉壺多美酒。","良人猶不歸，芳菲豈常有。","不惜芳菲歇，但傷別離久。","含情罷斟酌，凝怨對窗牖。"],"s":"trad","f":"simp"},{"i":"139c0e4f-780a-4837-9244-fefe2f900967","t":"古興 三","a":"趙氏","d":"唐","g":"古体","p":["霽雪舒長野，寒雲半幽谷。","嚴風振枯條，猨啼抱冰木。","所嗟遊宦子，少小荷天祿。","前程未云至，悽愴對車僕。","歲寒成詠歌，日暮棲林樸。","不憚行險道，空悲年運促。"],"s":"mixed","f":"simp"},{"i":"9a598058-c6a3-46f7-a640-f9ae0f7d9d5c","t":"寄夫","a":"郭紹蘭","d":"唐","g":"短诗","p":["我壻去重湖，臨窗泣血書。","殷勤憑燕翼，寄與薄情夫。"],"s":"trad","f":"simp"},{"i":"46d3c974-cf0b-406f-9fa2-5e4bed0392c6","t":"同夫遊秦","a":"王韞秀","d":"唐","g":"短诗","p":["路掃飢寒跡，天哀志氣人。","休零離別淚，攜手入西秦。"],"s":"trad","f":"simp"},{"i":"1f0b25a6-6dd1-4adf-984d-a68fc2e99751","t":"夫入相寄姨妹","a":"王韞秀","d":"唐","g":"短诗","p":["相國已隨麟閣貴，家風第一右丞詩。","笄年解笑鳴機婦，恥見蘇秦富貴時。"],"s":"trad","f":"simp"},{"i":"30eb9d67-9d1d-41e5-835e-3e3e48a10c14","t":"喻夫阻客","a":"王韞秀","d":"唐","g":"短诗","p":["楚竹燕歌動畫梁，春蘭重換舞衣裳。","公孫開閣招嘉客，知道浮榮不久長。"],"s":"trad","f":"simp"},{"i":"3be0d6ff-3bc2-40c5-9ffe-e4c52a36364e","t":"古意","a":"張夫人","d":"唐","g":"短诗","p":["轆轤曉轉素絲綆，桐聲夜落蒼苔塼。","涓涓吹溜若時雨，濯濯佳蔬非用天。","丈夫不解此中意，抱甕當時徒自賢。"],"s":"trad","f":"simp"},{"i":"e786966d-f862-48a9-b4d4-c83986043b2b","t":"拜新月","a":"張夫人","d":"唐","g":"古体","p":["拜新月，拜月出堂前。","暗魄初籠桂，虛弓未引弦。","拜新月，拜月妝樓上。","鸞鏡始安臺，蛾眉已相向。","拜新月，拜月不勝情，庭花風露清。","月臨人自老，人望月長明。","東家阿母亦拜月，一拜一悲聲斷絕。","昔年拜月逞容輝，如今拜月雙淚垂。","回看衆女拜新月，却憶紅閨年少時。"],"s":"mixed","f":"simp"},{"i":"133ea4a3-3f55-4c7c-ad31-5cd91d95577e","t":"柳絮","a":"張夫人","d":"唐","g":"短诗","p":["靄靄芳春朝，雪絮起青條。","或值花同舞，不因風自飄。","過尊浮綠醑，拂幌綴紅綃。","那用持愁翫，春懷不自聊。"],"s":"trad","f":"simp"},{"i":"4c469973-b3dc-46ad-8b36-7c2f1a87875a","t":"拾得韋氏花鈿以詩寄贈","a":"張夫人","d":"唐","g":"短诗","p":["今朝妝閣前，拾得舊花鈿。","粉汚痕猶在，塵侵色尚鮮。","曾經纖手裏，拈向翠眉邊。","能助千金笑，如何忍棄捐。"],"s":"mixed","f":"simp"},{"i":"a139233c-3f0e-4c5d-8558-a04a325dfd5b","t":"誚喜鵲","a":"張夫人","d":"唐","g":"短诗","p":["疇昔鴛鴦侶，朱門賀客多。","如今無此事，好去莫相過。"],"s":"trad","f":"simp"},{"i":"ffd905fa-df58-43a5-acdf-d5bd8786add6","t":"句","a":"張夫人","d":"唐","g":"短诗","p":["遊蜂乍起驚落墀，黃鳥銜來却上枝。","臨風重回首，掩淚向庭花。","鏡中春色老，枕前秋夜長。"],"s":"mixed","f":"simp"},{"i":"c24d6aa4-8171-4821-b560-19d4889e5995","t":"書石壁","a":"王氏","d":"唐","g":"短诗","p":["何事潘郎戀別筵，歡情未斷妾心懸。","汰王灘下相思處，猨叫山山月滿船。"],"s":"trad","f":"simp"},{"i":"cd5d2bee-7b17-4b7f-af2b-f2e1840b3144","t":"荅微之","a":"裴淑","d":"唐","g":"短诗","p":["侯門初擁節，御苑柳絲新。","不是悲殊命，唯愁別近親。","黃鶯遷古木，朱履從清塵。","想到千山外，滄江正暮春。"],"s":"trad","f":"simp"},{"i":"aaf7bb38-5886-4d7a-8e0f-b569a2a91b36","t":"夫下第","a":"趙氏","d":"唐","g":"短诗","p":["良人的的有奇才，何事年年被放回。","如今妾面羞君面，君若來時近夜來。"],"s":"trad","f":"simp"},{"i":"d9edb62b-8ab0-468e-bcae-dee78ce204db","t":"雜言寄杜羔","a":"趙氏","d":"唐","g":"古体","p":["君從淮海遊，再過蘭杜秋。","歸來未須臾，又欲向梁州。","梁州秦嶺西，棧道與雲齊。","羌蠻萬餘落，矛戟自高低。","已念寡儔侶，復慮勞攀躋。","丈夫重志氣，兒女空悲啼。","臨邛滯遊地，肯顧濁水泥。","人生賦命有厚薄，君但遨遊我寂寞。"],"s":"trad","f":"simp"},{"i":"dd00995d-e299-4636-aaef-1e769b0e384b","t":"聞夫杜羔登第","a":"趙氏","d":"唐","g":"短诗","p":["長安此去無多地，鬱鬱蔥蔥佳氣浮。","良人得意正年少，今夜醉眠何處樓。"],"s":"trad","f":"simp"},{"i":"9967e41d-2fdc-4b5c-86f3-87909843bee6","t":"雜言","a":"趙氏","d":"唐","g":"短诗","p":["上林園中青青桂，折得一枝好夫壻。","杏花如雪柳垂絲，春風蕩颺不同枝。"],"s":"trad","f":"simp"},{"i":"23f88ea8-4327-4059-8981-cda65ecb2099","t":"寄夫 一","a":"張氏","d":"唐","g":"短诗","p":["久無音信到羅幃，路遠迢迢遣問誰。","聞君折得東堂桂，折罷那能不暫歸。"],"s":"trad","f":"simp"},{"i":"6c2792ef-c3af-4ebe-8b1f-e9134da8680b","t":"寄夫 二","a":"張氏","d":"唐","g":"短诗","p":["驛使今朝過五湖，殷勤爲我報狂夫。","從來誇有龍泉劒，試割相思得斷無。"],"s":"mixed","f":"simp"},{"i":"cc2bfccd-37f6-4a0b-8ded-da844d9ed7b6","t":"贈鄭女郎","a":"薛馧","d":"唐","g":"古体","p":["豔陽灼灼河洛神，珠簾繡戶青樓春。","能彈箜篌弄纖指，愁殺門前少年子。","笑開一面紅粉妝，東園幾樹桃花死。","朝理曲，暮理曲，獨坐窗前一片玉。","行也嬌，坐也嬌，見之令人魂魄銷。","堂前錦褥紅地鑪，綠沈香榼傾屠蘇。","解佩時時歇歌管，芙蓉帳裏蘭麝滿。","晚起羅衣香不斷，滅燭每嫌秋夜短。"],"s":"mixed","f":"simp"},{"i":"72c62b15-4e1c-44bd-bb61-e005b0ed0114","t":"古意","a":"薛馧","d":"唐","g":"短诗","p":["昨夜巫山中，失却陽臺女。","朝來香閣裏，獨伴楚王語。"],"s":"mixed","f":"simp"},{"i":"a403a234-449e-4e71-bc97-3e589db2feab","t":"贈故人","a":"薛馧","d":"唐","g":"短诗","p":["昔別容如玉，今來鬢若絲。","淚痕應共見，腸斷阿誰知。"],"s":"trad","f":"simp"},{"i":"6102ecfa-9b06-43e2-a6b0-d2061fae8521","t":"句","a":"薛馧","d":"唐","g":"短诗","p":["寂寞相思處，雕梁落燕泥。"],"s":"trad","f":"simp"},{"i":"28b4c653-7b79-44d0-9ee3-d51a6c1b12ca","t":"題奉慈寺","a":"楊德麟","d":"唐","g":"短诗","p":["日月金輪動，旃檀碧樹秋。","塔分鴻鴈翅，鐘挂鳳凰樓。"],"s":"mixed","f":"simp"},{"i":"3e48dd05-26ac-4058-a8e3-96f1814b880e","t":"述懷","a":"崔氏","d":"唐","g":"短诗","p":["不怨盧郎年紀大，不怨盧郎官職卑。","自恨妾身生較晚，不及盧郎年少時。"],"s":"trad","f":"simp"},{"i":"c84fc5e4-d883-4858-a2a9-0feac1154bab","t":"寄夫","a":"陳玉蘭","d":"唐","g":"短诗","p":["夫戍邊關妾在吳，西風吹妾妾憂夫。","一行書信千行淚，寒到君邊衣到無。"],"s":"trad","f":"simp"},{"i":"682d9a63-2f12-41dc-a146-257f67f17984","t":"寫真寄夫","a":"薛媛","d":"唐","g":"短诗","p":["欲下丹青筆，先拈寶鏡寒。","已經顏索寞，漸覺鬢凋殘。","淚眼描將易，愁腸寫出難。","恐君渾忘却，時展畫圖看。"],"s":"mixed","f":"simp"},{"i":"5a44ca13-827a-4b80-9192-6b0e6dcf3846","t":"聞琴","a":"孫氏","d":"唐","g":"短诗","p":["玉指朱弦軋復清，湘妃愁怨最難聽。","初疑颯颯涼風勁，又似蕭蕭暮雨零。","近比流泉來碧嶂，遠如玄鶴下青冥。","夜深彈罷堪惆悵，露溼叢蘭月滿庭。"],"s":"trad","f":"simp"},{"i":"b6dc6340-5ae0-4a87-a04c-cc0074982856","t":"白蠟燭詩","a":"孫氏","d":"唐","g":"短诗","p":["景勝銀釭香比蘭，一條白玉偪人寒。","他時紫禁春風夜，醉草天書仔細看。"],"s":"trad","f":"simp"},{"i":"58219b41-0a15-4288-a2e2-1ebf982ec88b","t":"謝人送酒","a":"孫氏","d":"唐","g":"短诗","p":["謝將清酒寄愁人，澄澈甘香氣味真。","好是綠窗風月夜，一杯搖蕩滿懷春。"],"s":"trad","f":"simp"},{"i":"363fd601-bcab-4f51-a099-a7ae9b4cd96c","t":"詩","a":"張立本女","d":"唐","g":"短诗","p":["危冠廣袖楚宮妝，獨步閑庭逐夜涼。","自把玉簪敲砌竹，清歌一曲月如霜。"],"s":"trad","f":"simp"},{"i":"bf21db2d-a170-4b69-87bd-1643742ed924","t":"繡龜形詩","a":"侯氏","d":"唐","g":"短诗","p":["暌離已是十秋強，對鏡那堪重理妝。","聞鴈幾迴修尺素，見霜先爲製衣裳。","開箱疊練先垂淚，拂杵調砧更斷腸。","繡作龜形獻天子，願教征客早還鄉。"],"s":"mixed","f":"simp"},{"i":"7d3fe8f4-5d2e-47c8-a3ab-5541f2824fe0","t":"感夫詩","a":"慎氏","d":"唐","g":"短诗","p":["當時心事已相關，雨散雲飛一餉間。","便是孤帆從此去，不堪重上望夫山。"],"s":"trad","f":"simp"},{"i":"52470403-70a0-4488-bf26-4ce55173e96a","t":"謠","a":"薛瑤","d":"唐","g":"短诗","p":["化雲心兮思淑貞，洞寂滅兮不見人。","瑤草芳兮思芬蒀，將奈何兮青春。"],"s":"mixed","f":"simp"},{"i":"65bc9a75-4cee-4066-8037-23cd7f988f6e","t":"題唐安寺閣壁","a":"王霞卿","d":"唐","g":"短诗","p":["春來引步暫尋遊，愁見風光倚寺樓。","正好開懷對煙月，雙眉不覺自如鉤。"],"s":"trad","f":"simp"},{"i":"42c45940-942a-4c90-a13e-32ed4430d218","t":"荅鄭殷彝","a":"王霞卿","d":"唐","g":"短诗","p":["君是煙霄折桂身，聖朝方切用儒珍。","正堪西上文場戰，空向途中泥婦人。"],"s":"trad","f":"simp"},{"i":"f3e0ac13-0145-43b5-b587-fa2a9e714f35","t":"喜盧郎及第","a":"竇梁賓","d":"唐","g":"短诗","p":["曉妝初罷眼初瞤，小玉驚人踏破帬。","手把紅箋書一紙，上頭名字有郎君。"],"s":"trad","f":"simp"},{"i":"6980f51a-151a-4502-a77b-93394915a5bd","t":"雨中看牡丹","a":"竇梁賓","d":"唐","g":"短诗","p":["東風未放曉泥乾，紅藥花開不奈寒。","待得天晴花已老，不如攜手雨中看。"],"s":"trad","f":"simp"},{"i":"aa3898fa-cc2a-4e9a-8535-911cf2be322e","t":"書桐葉","a":"任氏","d":"唐","g":"古体","p":["拭翠斂蛾眉，鬱鬱心中事。","搦管下庭除，書成相思字。","此字不書石，此字不書紙。","書在桐葉上，願逐秋風起。","天下有心人，盡解相思死。","天下負心人，不識相思字。","有心與負心，不知落何地。"],"s":"trad","f":"simp"},{"i":"59967f24-5e84-4ceb-8cf3-f57ea305919d","t":"下獄貢詩","a":"黃崇嘏","d":"唐","g":"短诗","p":["偶辭幽隱在臨邛，行止堅貞比澗松。","何事政清如水鏡，絆他野鶴在深籠。"],"s":"trad","f":"simp"}]