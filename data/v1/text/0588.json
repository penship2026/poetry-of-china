[{"i":"c-546093e40b24","t":"水龙吟","a":"苏轼","d":"宋","g":"词","p":["露寒烟冷蒹葭老，天外征鸿寥唳。","银河秋晚，长门灯悄，一声初至。","应念潇湘，岸遥人静，水多菰米。","□望极平田，徘徊欲下，依前被、风惊起。","须信衡阳万里。","有谁家、锦书遥寄。","万重云外，斜行横阵，才疏又缀。","仙掌月明，石头城下，影摇寒水。","念征衣未捣，佳人拂杵，有盈盈泪。"],"s":"simp","f":"trad"},{"i":"c-f6337caea9e0","t":"渔父・渔歌子","a":"苏轼","d":"宋","g":"词","p":["渔父饮，谁家去。","鱼蟹一时分付。","酒无多少醉为期，彼此不论钱数。"],"s":"simp","f":"trad"},{"i":"c-725cb52e6ab0","t":"渔父・渔歌子","a":"苏轼","d":"宋","g":"词","p":["渔父醉，蓑衣舞。","醉里却寻归路。","轻舟短棹任斜横，醒后不知何处。"],"s":"simp","f":"trad"},{"i":"c-0520200f595b","t":"渔父・渔歌子","a":"苏轼","d":"宋","g":"词","p":["渔父醒，春江午。","梦断落花飞絮。","酒醒还醉醉还醒，一笑人间今古。"],"s":"simp","f":"trad"},{"i":"c-ed7a699322f9","t":"渔父・渔歌子","a":"苏轼","d":"宋","g":"词","p":["渔父笑，轻鸥举。","漠漠一江风雨。","江边骑马是官人，借我孤舟南渡。"],"s":"simp","f":"trad"},{"i":"c-8e0911e63e25","t":"醉翁操","a":"苏轼","d":"宋","g":"词","p":["琅然。","清圜。","谁弹。","响空山。","无言。","惟翁醉中知其天。","月明风露娟娟。","人未眠。","荷蒉过山前。","曰有心也哉此贤。","醉翁啸咏，声和流泉。","醉翁去后，空有朝吟夜怨。","山有时而童巅。","水有时而回川。","思翁无岁年。","翁今为飞仙。","此意在人间。","拭听徽外三两弦。"],"s":"simp","f":"trad"},{"i":"c-8d91e7ae29f6","t":"导引","a":"苏轼","d":"宋","g":"词","p":["帝城父老，三岁望尧心。","天远玉楼深。","龙颜仿佛笙箫远，肠断属车音。","离宫春色琐瑶林。","云阙海沈沈。","遗民犹唱当时曲，秋雁起汾阴。"],"s":"simp","f":"trad"},{"i":"c-ad2ddcd2caf8","t":"导引","a":"苏轼","d":"宋","g":"词","p":["经文纬武，十有九年中。","遗烈震羌戎。","渭桥夹道千君长，犹是建元功。","西瞻温洛与神崧。","莲宇照琼宫。","人间俯仰成今古，流泽自无穷。"],"s":"simp","f":"trad"},{"i":"c-5d7452db16d0","t":"瑶池燕","a":"苏轼","d":"宋","g":"词","p":["飞花成阵。","春心困。","寸寸。","别肠多少愁闷。","无人问。","偷啼自搵。","残妆粉。","抱瑶琴、寻出新韵。","玉纤趁。","南风来解幽愠。","低云鬟、眉峰敛晕。","娇和恨。"],"s":"mixed","f":"trad"},{"i":"c-e3b0030adffa","t":"千秋岁","a":"苏轼","d":"宋","g":"词","p":["岛边天外。","未老身先退。","珠泪溅，丹衷碎。","声摇苍玉佩。","色重黄金带。","一万里。","斜阳正与长安对。","道远谁云会。","罪大天能盖。","君命重，臣节在。","新恩犹可觊。","旧学终难改。","吾已矣。","乘桴且恁浮於海。"],"s":"mixed","f":"trad"},{"i":"c-3a2a8986bac4","t":"减字木兰花","a":"苏轼","d":"宋","g":"词","p":["凭谁妙笔。","横扫素缣三百尺。","天下应无。","此是钱塘湖上图。","一般奇绝。","云淡天高秋夜月。","费尽丹青。","只这些儿画不成。"],"s":"simp","f":"trad"},{"i":"c-adb376b62f42","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["高安更过几重山。"],"s":"simp","f":"trad"},{"i":"c-13858539ee8e","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["过湖携手屡沾襟。"],"s":"simp","f":"trad"},{"i":"c-7ab1f2c86ded","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["谁教幽梦里，插他花。"],"s":"simp","f":"trad"},{"i":"c-b85ae19389fa","t":"菩萨蛮","a":"苏轼","d":"宋","g":"词","p":["湿云不动溪桥冷。","嫩寒初透东风影。","桥下水声长。","一枝和月香。","人怜花似旧。","花比人应瘦。","莫凭小栏干。","夜深花正寒。"],"s":"simp","f":"trad"},{"i":"c-c5d667fa954b","t":"踏青游","a":"苏轼","d":"宋","g":"词","p":["□火初晴，绿遍禁池芳草。","斗锦绣、火城驰道。","踏青游，拾翠惜，袜罗弓小。","莲步袅。","腰支佩兰轻妙。","行过上林春好。","今困天涯，何限旧情相恼。","念摇落、玉京寒早。","任刘郎、目断蓬山难到。","仙梦杳。","良宵又过了。","楼台万家清晓。"],"s":"simp","f":"trad"},{"i":"c-88434a958130","t":"阮郎归","a":"苏轼","d":"宋","g":"词","p":["歌停檀板舞停鸾。","高阳饮兴阑。","兽烟喷尽玉壶乾。","香分小凤团。","雪浪浅，露珠圆。","捧瓯春笋寒。","绛纱笼下跃金鞍。","归时人倚栏。"],"s":"mixed","f":"trad"},{"i":"c-c9169aeba090","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["马趁香微路远，沙笼月淡烟斜。","渡波清彻映妍华。","倒绿枝寒凤挂。","挂凤寒枝绿倒，华妍映彻清波。","渡斜烟淡月笼沙。","远路微香趁马。"],"s":"simp","f":"trad"},{"i":"c-e2f763b71e82","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["拼沈醉、金荷须满。","怕年年此际，催归禁篽，侍黄柑宴。"],"s":"mixed","f":"trad"},{"i":"c-caa28bba1a3a","t":"踏莎行","a":"苏轼","d":"宋","g":"词","p":["山秀芙蓉，溪明罨画。","真游洞穴沧波下。","临风慨想斩蛟灵，长桥千载犹横跨。","解佩投簪，求田问舍。","黄鸡白酒渔樵社。","元龙非复少时豪，耳根洗尽功名话。"],"s":"simp","f":"trad"},{"i":"c-e491622cb6b1","t":"踏莎行","a":"苏轼","d":"宋","g":"词","p":["这个秃奴，修行忒煞。","云山顶上空持戒。","一从迷恋玉楼人，鹑衣百结浑无奈。","毒手伤人，花容粉碎。","空空色色今何在。","臂间刺道苦相思，这回还了相思债。"],"s":"simp","f":"trad"},{"i":"c-e50bf26f0278","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["寂寂珠帘蛛网满。"],"s":"simp","f":"trad"},{"i":"c-7028c798c5c4","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["闲卧藤床观社柳。"],"s":"simp","f":"trad"},{"i":"c-b4dbef798306","t":"定风波","a":"苏轼","d":"宋","g":"词","p":["子瞻书困点新茶。"],"s":"simp","f":"trad"},{"i":"c-707946af56af","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["唤起离情，慵推孤枕。"],"s":"simp","f":"trad"},{"i":"c-7e78e9cbcfc2","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["山头望，波光泼眼。"],"s":"simp","f":"trad"},{"i":"c-f07be2edbe27","t":"水调歌・水调","a":"苏轼","d":"宋","g":"词","p":["我歌月徘徊，我舞影凌乱。"],"s":"simp","f":"trad"},{"i":"c-0d59dbdd1f74","t":"失调名","a":"苏轼","d":"宋","g":"词","p":["揭起裙儿，一阵油盐酱醋香。"],"s":"simp","f":"trad"},{"i":"c-7f08a1106b6f","t":"鹧鸪天","a":"苏轼","d":"宋","g":"词","p":["罗带双垂画不成。","殢人娇态最轻盈。","酥胸斜抱天边月，玉手轻弹水面冰。","无限事，许多情。","四弦丝竹苦丁宁。","饶君拨尽相思调，待听梧桐叶落声。"],"s":"simp","f":"trad"},{"i":"c-3f3d0e501c13","t":"西江月","a":"苏轼","d":"宋","g":"词","p":["碧雾轻笼两凤，寒烟淡拂双鸦。","为谁流睇不归家。","错认门前过马。","有意偷回笑眼，无言强整衣纱。","刘郎一见武陵花。","从此春心荡也。"],"s":"simp","f":"trad"},{"i":"c-030632017f86","t":"夜行船","a":"赵","d":"宋","g":"词","p":["今夜阴云初霁。","画帘外、月华如水。","露霭晴空，风吹高树，满院中秋意。","皎皎蟾光当此际。","怎奈何、不成况味。","莫近檐间，休来窗上，且放离人睡。"],"s":"simp","f":"trad"},{"i":"c-2a25e91ac375","t":"河传","a":"郭讵","d":"宋","g":"词","p":["大官无闷。","刚被傍人、竟来相问。","又难为□□敷臣。","且只将、甘草论。","朴消大戟并银粉。","疏风紧。","甘草闲相混。","及至下来，转杀他人。","尔甘草、有一分。"],"s":"simp","f":"trad"},{"i":"c-7593f8d97b76","t":"水龙吟","a":"李之仪","d":"宋","g":"词","p":["晚来轻拂，游云尽卷，霁色寒相射。","银潢半掩，秋毫欲数，分明不夜。","玉琯传声，羽衣催舞，此欢难借。","凛清辉，但觉圆光照影，冰壶莹、真无价。","闻道水晶宫殿，蕙炉薰、珠帘高挂。","琼枝半倚，瑶觞更劝，莺娇燕姹。","目断魂飞，翠萦红绕，空吟小砑。","想归来醉里，鸾篦凤朵，倩何人卸。"],"s":"simp","f":"trad"},{"i":"c-26ad0ca1834a","t":"蓦山溪","a":"李之仪","d":"宋","g":"词","p":["神仙院宇，记得春归后。","蜂蝶不胜闲，惹残香、萦纡深透。","玉徽指稳，别是一般情，方永昼。","因谁瘦。","都为天然秀。","桐阴未减，独自携芳酎。","再弄想前欢，拊金樽、何时似旧。","凭谁说与，潘鬓转添霜，飞陇首。","云将皱。","应念相思久。"],"s":"simp","f":"trad"},{"i":"c-201adfa4516d","t":"蓦山溪","a":"李之仪","d":"宋","g":"词","p":["金柔火老，欲避几无地。","谁借一檐风，锁幽香、愔愔清邃。","瑶阶珠砌，如膜遇金篦，流水外，落花前，岂是人能致。","擘鳞泛玉，笑语皆真类。","惆怅月边人，驾云軿、何方适意。","么弦咽处，空感旧时声，兰易歇，恨偏长，魂断成何事。"],"s":"simp","f":"trad"},{"i":"c-09070222a0ae","t":"蓦山溪","a":"李之仪","d":"宋","g":"词","p":["蛾眉亭上，今日交冬至。","已报一阳生，更佳雪、因时呈瑞。","匀飞密舞，都是散天花，山不见，水如山，浑在冰壶里。","平生选胜，到此非容易。","弄月与燃犀，漫劳神、徒能惊世。","争如此际，天意巧相符，须痛饮，庆难逢，莫诉厌厌醉。"],"s":"simp","f":"trad"},{"i":"c-a8806ffa5058","t":"蓦山溪","a":"李之仪","d":"宋","g":"词","p":["晚来寒甚，密雪穿庭户。","如在广寒宫，惊满目、瑶林琼树。","佳人乘兴，应是得欢多，泛新声，催金盏，别有留心处。","争知这里，没个人言语。","拨尽火边灰，搅愁肠、飞花舞絮。","凭谁子细，说与此时情，欢暂歇，酒微醺，还解相思否。"],"s":"simp","f":"trad"},{"i":"c-553fd7cb3e33","t":"满庭芳","a":"李之仪","d":"宋","g":"词","p":["一到江南，三逢此夜，举头羞见婵娟。","黯然怀抱，特地遣谁宽。","分外清光泼眼，迷滉漾、无计拘拦。","天如洗，星河尽掩，全胜异时看。","佳人，还忆否，年时此际，相见方难。","谩红绫偷寄，孤被添寒。","何事佳期再睹，翻怅望、重叠关山。","归来呵，休教独自，肠断对团圆。"],"s":"simp","f":"trad"},{"i":"c-d494b547cfc3","t":"满庭芳","a":"李之仪","d":"宋","g":"词","p":["花陌千条，珠帘十里，梦中还是扬州。","月斜河汉，曾记醉歌楼。","谁赋红绫小砑，因飞絮、天与风流。","春常在，仙源路隔，空自泛渔舟。","新秋。","初雨过，龙团细碾，雪乳浮瓯。","问殷勤何处，特地相留。","应念长门赋罢，消渴甚、无物堪酬。","情无尽，金扉玉榜，何日许重游。"],"s":"simp","f":"trad"},{"i":"c-10a4f6477bb4","t":"玉蝴蝶","a":"李之仪","d":"宋","g":"词","p":["坐久灯花开尽，暗惊风叶，初报霜寒。","冉冉年华催暮，颜色非丹。","搅回肠、蛩吟似织，留恨意、月彩如摊。","惨无欢。","篆烟萦素，空转雕盘。","何难。","别来几日，信沈鱼鸟，情满关山。","耳边依约，常记巧语绵蛮。","聚愁窠、蜂房未密，倾泪眼、海水犹悭。","奄更阑。","渐移银汉，低泛帘颜。"],"s":"simp","f":"trad"},{"i":"c-11d1582b3be8","t":"早梅芳・喜迁莺","a":"李之仪","d":"宋","g":"词","p":["雪初销，斗觉寒将变。","已报梅梢暖。","日边霜外，迤逦枝条自柔软。","嫩苞匀点缀，绿萼轻裁剪。","隐深心，未许清香散。","渐融和，开欲遍。","密处疑无间。","天然标韵，不与群花斗深浅。","夕阳波似动，曲水风犹懒。","最销魂，弄影无人见。"],"s":"simp","f":"trad"},{"i":"c-1aeed443edc7","t":"谢池春","a":"李之仪","d":"宋","g":"词","p":["残寒销尽，疏雨过、清明后。","花径敛馀红，风沼萦新皱。","乳燕穿庭户，飞絮沾襟袖。","正佳时，仍晚昼。","著人滋味，真个浓如酒。","频移带眼，空只恁、厌厌瘦。","不见又思量，见了还依旧。","为问频相见，何似长相守。","天不老，人未偶。","且将此恨，分付庭前柳。"],"s":"simp","f":"trad"},{"i":"c-a07788285a8a","t":"怨三三","a":"李之仪","d":"宋","g":"词","p":["清溪一派泻揉蓝。","岸草毵毵。","记得黄鹂语画檐。","唤狂里、醉重三。","春风不动垂帘。","似三五、初圆素蟾。","镇泪眼廉纤。","何时歌舞，再和池南。"],"s":"simp","f":"trad"},{"i":"c-2d26b285f652","t":"春光好","a":"李之仪","d":"宋","g":"词","p":["霜压晓，月收阴。","斗寒深。","看尽烛花金鸭冷，卷残衾。","卯酒从谁细酌，馀香无计重寻。","空把夜来相见梦，写文琴。"],"s":"simp","f":"trad"},{"i":"c-4c23c13c127e","t":"千秋岁","a":"李之仪","d":"宋","g":"词","p":["深帘静昼。","绰约闺房秀。","叩衣楚制飞文绣。","凝脂肤理腻，削玉腰围瘦。","闲舞袖。","回身昵语凭肩久。","眉压横波皱。","歌断青青柳。","钗遽擘，壶频叩。","鬓凄清镜雪，泪涨芳樽酒。","难再偶。","沈沈梦峡雪归后。"],"s":"simp","f":"trad"},{"i":"c-752a130c536b","t":"千秋岁","a":"李之仪","d":"宋","g":"词","p":["柔肠寸折。","解袂留清血。","蓝桥动是经年别。","掩门春絮乱，敧枕秋蛩咽。","檀篆灭。","鸳衾半拥空床月。","妆镜分来缺。","尘污菱花洁。","嘶骑远，鸣机歇。","密封书锦字，巧绾香囊结。","芳信绝。","东风半落梅梢雪。"],"s":"simp","f":"trad"},{"i":"c-e5256d2e287d","t":"千秋岁","a":"李之仪","d":"宋","g":"词","p":["万红暄昼。","占尽人间秀。","怎生图画如何绣。","宜推萧史伴，消得东阳瘦。","垂窄袖。","花前镇忆相携久。","泪裛回纹皱。","好在章台柳。","洞户隔，凭谁叩。","寄声虽有雁，会面难同酒。","无计偶。","萧萧暮雨黄昏后。"],"s":"simp","f":"trad"},{"i":"c-d6b5e1f84735","t":"千秋岁","a":"李之仪","d":"宋","g":"词","p":["休嗟磨折。","看取罗巾血。","殷勤且话经年别。","庭花番怅望，檐雨同呜咽。","明半灭。","灯光夜夜多如月。","无复伤离缺。","共保冰霜洁。","不断梦，从今歇。","收回书上絮，解尽眉头结。","犹未绝。","金徽泛处应能雪。"],"s":"simp","f":"trad"},{"i":"c-925c9c159f9a","t":"千秋岁","a":"李之仪","d":"宋","g":"词","p":["中秋才过，又是重阳到。","露乍冷，寒将报。","绿香摧渚芰，黄密攒庭草。","人未老。","蓝桥漫促霜砧捣。","照影兰缸晕，破户银蟾小。","樽在眼，从谁倒。","强铺同处被，愁却欢时帽。","须信道。","狂心未歇情难老。"],"s":"simp","f":"trad"},{"i":"c-89cb62318bb8","t":"千秋岁","a":"李之仪","d":"宋","g":"词","p":["深秋庭院，残暑全消退。","天幕迥，云容碎。","地偏人罕到，风惨寒微带。","初睡起，翩翩戏蝶飞成对。","叹息谁能会。","犹记逢倾盖。","情暂遣，心常在。","沈沈音信断，冉冉光阴改。","红日晚，仙山路隔空云海。"],"s":"simp","f":"trad"},{"i":"c-462f8441f59b","t":"临江仙","a":"李之仪","d":"宋","g":"词","p":["知有阆风花解语，从来只许传闻。","光明休咏汉宫新。","拥身疑有月，衬步恨无云。","莫把金樽容易劝，坐来几度销魂。","不知仙骨在何人。","好将千岁日，占断四时春。"],"s":"simp","f":"trad"},{"i":"c-e51c29f994d1","t":"临江仙","a":"李之仪","d":"宋","g":"词","p":["九十日春都过了，寻常偶到江皋。","水容山态两相饶。","草平天一色，风暖燕双高。","酒病厌厌何计那，飞红更送无聊。","莺声又似耳边娇。","难回巫峡梦，空恨武陵桃。"],"s":"simp","f":"trad"},{"i":"c-4e8bfb0c333c","t":"江神子・江城子","a":"李之仪","d":"宋","g":"词","p":["恼人天气雪消时。","落梅飞。","日初迟。","小阁幽窗，时节听黄鹂。","新洗头来娇困甚，才试著，夹罗衣。","木梨花拂淡燕脂。","翠云敧。","敛双眉。","月浅星深，天淡玉绳低。","不道有人肠断也，浑不语，醉如痴。"],"s":"simp","f":"trad"},{"i":"c-80a3fbe71706","t":"江神子・江城子","a":"李之仪","d":"宋","g":"词","p":["今宵莫惜醉颜红。","十分中。","且从容。","须信欢情，回首似旋风。","流落天涯头白也，难得是，再相逢。","十年南北感征鸿。","恨应同。","苦重重。","休把愁怀，容易便书空。","只有琴樽堪寄老，除此外，尽蒿蓬。"],"s":"simp","f":"trad"},{"i":"c-66b8483c978c","t":"江神子・江城子","a":"李之仪","d":"宋","g":"词","p":["阑干掐遍等新红。","酒频中。","恨匆匆。","投得花开，还报夜来风。","惆怅春光留不住，又何似，莫相逢。","月窗何处想归鸿。","与谁同。","意千重。","婉思柔情，一旦总成空。","仿佛么弦犹在耳，应为我，首如蓬。"],"s":"simp","f":"trad"},{"i":"c-d38e95f9eec7","t":"清平乐","a":"李之仪","d":"宋","g":"词","p":["西江霜后，万点暄晴昼。","璀璨寄来光欲溜。","正值文君病酒。","画屏斜倚窗纱。","睡痕犹带朝霞。","为问清香绝韵，何如解语梅花。"],"s":"simp","f":"trad"},{"i":"c-acf42ab0431b","t":"清平乐","a":"李之仪","d":"宋","g":"词","p":["萧萧风叶。","似与更声接。","欲寄明珰非为怯。","梦断兰舟桂楫。","学书只写鸳鸯。","却应无奈愁肠。","安得一双飞去，春风芳草池塘。"],"s":"simp","f":"trad"},{"i":"c-0a4c7e604175","t":"清平乐","a":"李之仪","d":"宋","g":"词","p":["殷勤仙友。","劝我千年酒。","一曲履霜谁与奏。","邂逅麻姑妙手。","坐来休叹尘劳。","相逢难似今朝。","不待亲移玉指，自然痒处都消。"],"s":"simp","f":"trad"},{"i":"c-1fd69796c05c","t":"清平乐","a":"李之仪","d":"宋","g":"词","p":["当时命友。","曾借邻家酒。","旧曲不知何处奏。","梦断空思纤手。","却应去路非遥。","今朝还有明朝。","谩道人能化石，须知石被人消。"],"s":"simp","f":"trad"},{"i":"c-d26e069c9ded","t":"清平乐","a":"李之仪","d":"宋","g":"词","p":["仙家庭院。","红日看看晚。","一朵梅花挨枕畔。","玉指几回拈看。","拥衾不比寻常。","天涯无限思量。","看了又还重嗅，分明不为清香。"],"s":"simp","f":"trad"},{"i":"c-bdc24ee51d13","t":"浪淘沙","a":"李之仪","d":"宋","g":"词","p":["霞卷与云舒。","月淡星疏。","摩徽转轸不曾虚。","弹到当时留意处，谁是相如。","魂断酒家垆。","路隔云衢。","舞鸾镜里早妆初。","拟学画眉张内史，略借功夫。"],"s":"simp","f":"trad"},{"i":"c-fb9188639f32","t":"忆秦娥","a":"李之仪","d":"宋","g":"词","p":["清溪咽。","霜风洗出山头月。","山头月。","迎得云归，还送云别。","不知今是何时节。","凌歊望断音尘绝。","音尘绝。","帆来帆去，天际双阙。"],"s":"simp","f":"trad"},{"i":"c-ca4c5e0a2efd","t":"蝶恋花","a":"李之仪","d":"宋","g":"词","p":["天淡云闲晴昼永。","庭户深沈，满地梧桐影。","骨冷魂清如梦醒。","梦回犹是前时景。","取次杯盘催酩酊。","醉帽频敧，又被风吹正。","踏月归来人已静。","恍疑身在蓬莱顶。"],"s":"mixed","f":"trad"},{"i":"c-18211f5ccfa6","t":"蝶恋花","a":"李之仪","d":"宋","g":"词","p":["玉骨冰肌天所赋。","似与神仙，来作烟霞侣。","枕畔拈来亲手付。","书窗终日常相顾。","几度离披留不住。","依旧清香，只欠能言语。","再送神仙须爱护。","他时却待亲来取。"],"s":"simp","f":"trad"},{"i":"c-3d7ce15740ae","t":"蝶恋花","a":"李之仪","d":"宋","g":"词","p":["万事都归一梦了。","曾向邯郸，枕上教知道。","百岁年光谁得到。","其间忧患知多少。","无事且频开口笑。","纵酒狂歌，销遣闲烦恼。","金谷繁华春正好。","玉山一任樽前倒。"],"s":"simp","f":"trad"},{"i":"c-a311965d93e3","t":"蝶恋花","a":"李之仪","d":"宋","g":"词","p":["为爱梅花如粉面。","天与功夫，不似人间见。","几度拈来亲比看。","功夫却是花枝浅。","觅得归来临几砚。","尽日相看，默默情无限。","更不嗅时须百遍。","分明销得人肠断。"],"s":"simp","f":"trad"},{"i":"c-e45046f53576","t":"浣溪沙","a":"李之仪","d":"宋","g":"词","p":["剪水开头碧玉条。","能令江汉客魂销。","只应香信是春潮。","戴了又羞缘我老，折来同嗅许谁招。","凭将此意问妖娆。"],"s":"simp","f":"trad"},{"i":"c-9e859db9a803","t":"浣溪沙","a":"李之仪","d":"宋","g":"词","p":["玉室金堂不动尘。","林梢绿遍已无春。","清和佳思一番新。","道骨仙风云外侣，烟鬟雾鬓月边人。","何妨沈醉到黄昏。"],"s":"mixed","f":"trad"},{"i":"c-21ca93188ae1","t":"浣溪沙","a":"李之仪","d":"宋","g":"词","p":["依旧琅玕不染尘。","霜风吹断笑时春。","一簪华发为谁新。","白雪幽兰犹有韵，鹊桥星渚可无人。","金莲移处任尘昏。"],"s":"simp","f":"trad"},{"i":"c-3c4ebfbce41e","t":"浣溪沙","a":"李之仪","d":"宋","g":"词","p":["昨日霜风入绛帷。","曲房深院绣帘垂。","屏风几曲画生枝。","酒韵渐浓欢渐密，罗衣初试漏初迟。","已凉天气未寒时。"],"s":"simp","f":"trad"},{"i":"c-92dcc9295094","t":"西江月","a":"李之仪","d":"宋","g":"词","p":["昨夜十分霜重，晓来千里书传。","吴山秀处洞庭边。","不夜星垂初遍。","好事寄来禅侣，多情将送琴仙。","为怜佳果称婵娟。","一笑聊回媚眼。"],"s":"simp","f":"trad"},{"i":"c-f94a7cfca25e","t":"西江月","a":"李之仪","d":"宋","g":"词","p":["醉透香浓斗帐，灯深月浅回廊。","当时背面两伥伥。","何况临风怀想。","舞柳经春祗瘦，游丝到地能长。","鸳鸯半调已无肠。","忍把么弦再上。"],"s":"simp","f":"trad"},{"i":"c-38a5cf302add","t":"西江月","a":"李之仪","d":"宋","g":"词","p":["念念欲归未得，迢迢此去何求。","都缘一点在心头。","忘了霜朝雪后。","要见有时有梦，相思无处无愁。","小窗若得再绸缪。","应记如今时候。"],"s":"simp","f":"trad"},{"i":"c-37c8c75a9bb8","t":"鹊桥仙","a":"李之仪","d":"宋","g":"词","p":["风清月莹，天然标韵，自是闺房之秀。","情多无那不能禁，常是为、而今时候。","绿云低拢，红潮微上，画幕梅寒初透。","一般偏更恼人深，时更把、眉儿轻皱。"],"s":"simp","f":"trad"},{"i":"c-c142351654c9","t":"西江月","a":"李之仪","d":"宋","g":"词","p":["宿云收尽，纤尘不警，万里银河低挂。","清冥风露不胜寒，无计学、双鸾并驾。","玉徽声断，宝钗香远，空赋红绫小砑。","庾郎知有几多愁，怎奈向、月明今夜。"],"s":"simp","f":"trad"},{"i":"c-f9b00f4aa925","t":"踏莎行","a":"李之仪","d":"宋","g":"词","p":["绿遍东山，寒归西渡。","分明认得春来处。","风轻雨细更愁人，高唐何在空朝暮。","离恨相寻，酒狂无素。","柳条又折年时数。","一番情味有谁知，断魂还送征帆去。"],"s":"simp","f":"trad"},{"i":"c-833b214f4f4a","t":"踏莎行","a":"李之仪","d":"宋","g":"词","p":["还是归来，依前问渡。","好风引到经行处。","几声啼鸟又催耕，草长柳暗春将暮。","潦倒无成，疏慵有素。","且陪野老酬天数。","多情惟有面前山，不随潮水来还去。"],"s":"simp","f":"trad"},{"i":"c-3b6540da4d1f","t":"鹧鸪天","a":"李之仪","d":"宋","g":"词","p":["节是重阳却斗寒。","可堪风雨累寻欢。","虽辜早菊同高柳，聊楫残蕉共小栏。","浮蚁嫩，炷烟盘。","恨无莺唱舞催鸾。","空惊绝韵天边落，不许韶颜梦里看。"],"s":"simp","f":"trad"},{"i":"c-aad739c6eb7a","t":"鹧鸪天","a":"李之仪","d":"宋","g":"词","p":["浓丽妖妍不是妆。","十分风艳夺韶光。","牡丹开就应难比，繁富犹疑过海棠。","须仔细，更端相。","烂霞梳晕带朝阳。","千金未足酬真赏，一度相看一断肠。"],"s":"simp","f":"trad"},{"i":"c-25a5346b492c","t":"鹧鸪天","a":"李之仪","d":"宋","g":"词","p":["避暑佳人不著妆。","水晶冠子薄罗裳。","摩绵扑粉飞琼屑，滤蜜调冰结绛霜。","随定我，小兰堂。","金盆盛水绕牙床。","时时浸手心头熨，受尽无人知处凉。"],"s":"simp","f":"trad"},{"i":"c-5085e3583158","t":"鹧鸪天","a":"李之仪","d":"宋","g":"词","p":["收尽微风不见江。","分明天水共澄光。","由来好处输闲地，堪叹人生有底忙。","心既远，味偏长。","须知粗布胜无裳。","从今认得归田乐，何必桃源是故乡。"],"s":"simp","f":"trad"},{"i":"c-7c4976908025","t":"朝中措","a":"李之仪","d":"宋","g":"词","p":["腊穷天际傍危栏。","密雪舞初残。","表里江山如画，分明不似人间。","功名何在，文章漫与，空叹流年。","独恨归来已晚，半生孤负渔竿。"],"s":"simp","f":"trad"},{"i":"c-b001f02fc37b","t":"朝中措","a":"李之仪","d":"宋","g":"词","p":["暮山环翠绕层栏。","时节岁将残。","远雁不传家信，空能嘹唳人间。","客程无尽，归心易感，谁与忘年。","早晚临流凝望，饥帆催卸风竿。"],"s":"simp","f":"trad"},{"i":"c-345f8a120e63","t":"朝中措","a":"李之仪","d":"宋","g":"词","p":["翰林豪放绝勾栏。","风月敢雕残。","一旦荆溪仙子，笔头唤聚时间。","锦袍如在，云山顿改，宛似当年。","应笑溧阳衰尉，鲇鱼依旧悬竿。"],"s":"simp","f":"trad"},{"i":"c-3a31e0381aed","t":"阮郎归","a":"李之仪","d":"宋","g":"词","p":["朱唇玉羽下蓬莱。","佳时近早梅。","惜花情味久安排。","枝头开未开。","魂欲断，恨难裁。","香心休见猜。","果知何逊是仙才。","何妨入梦来。"],"s":"simp","f":"trad"},{"i":"c-0500d8746124","t":"采桑子","a":"李之仪","d":"宋","g":"词","p":["相逢未几还相别，此恨难同。","细雨濛濛。","一片离愁醉眼中。","明朝去路云宵外，欲见无从。","满袂仙风。","空托双凫作信鸿。"],"s":"mixed","f":"trad"},{"i":"c-75746dde3ca1","t":"如梦令","a":"李之仪","d":"宋","g":"词","p":["回首芜城旧苑。","还是翠深红浅。","春意已无多，斜日满帘飞燕。","不见。","不见。","门掩落花庭院。"],"s":"simp","f":"trad"},{"i":"c-98da2a9e0acf","t":"临江仙","a":"李之仪","d":"宋","g":"词","p":["偶向凌歊台上望，春光已过三分。","江山重叠倍销魂。","风花飞有态，烟絮醉无痕。","已是年来伤感甚，那堪旧恨仍存。","清愁满眼共谁论。","却应台下草，不解忆王孙。"],"s":"simp","f":"trad"},{"i":"c-8ff6b7ea588e","t":"临江仙","a":"李之仪","d":"宋","g":"词","p":["难得今朝风日好，春光佳思平分。","虽然公子暗招魂。","其如抬眼看，都是旧时痕。","酒到强寻欢日路，坐来谁为温存。","落花流水不堪论。","何时弦上意，重为拂桐孙。"],"s":"simp","f":"trad"},{"i":"c-a8c4d704111c","t":"丑奴儿・采桑子","a":"李之仪","d":"宋","g":"词","p":["春风似有灯前约，先报佳期。","点缀相宜。","天气犹寒蝶未知。","嫩黄染就蜂鬓巧，香压团枝。","淡注仙衣。","方士临门未起时。"],"s":"simp","f":"trad"},{"i":"c-31950e84ae07","t":"青玉案","a":"李之仪","d":"宋","g":"词","p":["小篷又泛曾行路。","这身世、如何去。","去了还来知几度。","多情山色，有情江水，笑我归无处。","夕阳杳杳还催暮。","练净空吟谢郎句。","拭祷波神应见许。","帆开风转，事谐心遂，直到明年雨。"],"s":"simp","f":"trad"},{"i":"c-224ac180fd20","t":"更漏子","a":"李之仪","d":"宋","g":"词","p":["暑方烦，人似愠。","怅望林泉幽峻。","情会处，景偏长。","心清闻妙香。","宝幢低，金锁碎。","竹影桐印窗外。","新事旧，旧愁新。","空嗟不见人。"],"s":"simp","f":"trad"},{"i":"c-aefbb18f0e8b","t":"渔家傲","a":"李之仪","d":"宋","g":"词","p":["洗尽秋容天似莹。","星稀月淡人初静。","策杖萦纡寻远径。","披昏暝。","堤边犊母闲相并。","遥想去舟魂欲凝。","一番佳思从谁咏。","憔悴归来如独醒。","知何境。","沈沈但觉烟村迥。"],"s":"simp","f":"trad"},{"i":"c-495ae5f6ef1f","t":"南乡子","a":"李之仪","d":"宋","g":"词","p":["春后雨馀天。","娅姹黄鹂胜品弦。","榴叶千灯初报暑，阶前。","只有茶瓯味最便。","身世几蹁跹。","自觉年来更可怜。","欲问此情何所似，缘延。","看取窗间坠柳绵。"],"s":"simp","f":"trad"},{"i":"c-4079b88d3c9f","t":"南乡子","a":"李之仪","d":"宋","g":"词","p":["绿水满池塘。","点水蜻蜓避燕忙。","杏子压枝黄半熟，邻墙。","风送荷花几阵香。","角簟衬牙床。","汗透鲛绡昼影长。","点滴芭蕉疏雨过，微凉。","画角悠悠送夕阳。"],"s":"simp","f":"trad"},{"i":"c-5d0049e2706f","t":"南乡子","a":"李之仪","d":"宋","g":"词","p":["睡起绕回塘。","不见衔泥燕子忙。","前日花梢都绿遍，西墙。","犹有轻风递暗香。","步懒恰寻床。","卧看游丝到地长。","自恨无聊常病酒，凄凉。","岂有才情似沈阳。"],"s":"simp","f":"trad"},{"i":"c-4092b606d6e8","t":"南乡子","a":"李之仪","d":"宋","g":"词","p":["小雨湿黄昏。","重午佳辰独掩门。","巢燕引雏浑去尽，销魂。","空向梁间觅宿痕。","客舍宛如村。","好事无人载一樽。","唯有莺声知此恨，殷勤。","恰似当时枕上闻。"],"s":"simp","f":"trad"},{"i":"c-50f97d62e1db","t":"南乡子","a":"李之仪","d":"宋","g":"词","p":["泪眼转天昏。","去路迢迢隔九门。","角黍满盘无意举，凝魂。","不为当时泽畔痕。","肠断武陵村。","骨冷难同月下樽。","强泛菖蒲酬令节，空勤。","风叶萧萧不忍闻。"],"s":"simp","f":"trad"},{"i":"c-f72898ead1ec","t":"蓦山溪","a":"李之仪","d":"宋","g":"词","p":["青楼薄幸，已分终难偶。","寻遍绮罗间，悄无个、眼中翘秀。","江南春晓，花发乱莺飞，情渐透。","休辞瘦。","果有人相候。","醉乡路稳，常是身偏后。","谁谓正欢时，把相思、番成红豆。","千言万语，毕竟总成虚，章台柳。","青青否。","魂梦空搔首。"],"s":"simp","f":"trad"},{"i":"c-7420f4160551","t":"减字木兰花","a":"李之仪","d":"宋","g":"词","p":["乱魂无据。","黯黯只寻来处路。","灯尽花残。","不觉长更又向阑。","几回枕上。","那件不曾留梦想。","变尽星星。","一滴秋霖是一茎。"],"s":"simp","f":"trad"}]