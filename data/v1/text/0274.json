[{"i":"09fd1d22-6549-4282-bd04-1b3f21aae6a3","t":"贈處士","a":"張祜","d":"唐","g":"短诗","p":["小徑上山山甚小，每憐僧院笑僧禪。","人間莫道無難事，二十年來已是玄。"]},{"i":"5cd1cc22-9a09-406e-8999-cb4db60e8744","t":"邠娘羯鼓","a":"張祜","d":"唐","g":"短诗","p":["新教邠娘羯鼓成，大酺初日最先呈。","冬兒指向貞貞說，一曲乾鳴兩杖輕。"]},{"i":"bc463631-e58e-4f81-829b-ca4f338f3bdc","t":"退宮人二首 一","a":"張祜","d":"唐","g":"短诗","p":["開元皇帝掌中憐，流落人間二十年。","長說承天門上宴，百官樓下拾金錢。"]},{"i":"a0c8b4eb-dc38-45bd-a9bb-2394f8b2eb1b","t":"退宮人二首 二","a":"張祜","d":"唐","g":"短诗","p":["歌喉漸退出宮闈，泣話伶官上許歸。","猶說入時歡聖壽，內人初著五方衣。"]},{"i":"597c6a5a-9bbf-4b04-befd-3de5ba85f1b6","t":"耍娘歌","a":"張祜","d":"唐","g":"短诗","p":["宜春花夜雪千枝，妃子偷行上密隨。","便喚耍娘歌一曲，六宮生老是蛾眉。"]},{"i":"41da4e51-6e2a-49cb-af6a-1192a47d7914","t":"悖拏兒舞","a":"張祜","d":"唐","g":"短诗","p":["春風南內百花時，道唱梁州急遍吹。","揭手便拈金椀舞，上皇驚笑悖拏兒。"]},{"i":"f4c98d52-feea-45f8-a801-c3336165e561","t":"題靈徹上人舊房","a":"張祜","d":"唐","g":"短诗","p":["寂寞空門支道林，滿堂詩板舊知音。","秋風吹葉古廊下，一半繩牀燈影深。"]},{"i":"03c2e3f3-b1c3-498f-9a4d-6c6877ec73e6","t":"晚秋潼關西門作","a":"張祜","d":"唐","g":"短诗","p":["日落寒郊煙物清，古槐陰黑少人行。","關門西去華山色，秦地東來河水聲。"]},{"i":"59666ede-f247-486f-bbda-98efe92a5acb","t":"洛中作","a":"張祜","d":"唐","g":"短诗","p":["元和天子昔平戎，惆悵金輿尚未通。","盡日洛橋閑處看，秋風時節上陽宮。"]},{"i":"561524b4-f9d0-4f9e-ba79-a8423f3e97cb","t":"折楊柳枝二首 一","a":"張祜","d":"唐","g":"短诗","p":["莫折宮前楊柳枝，玄宗曾向笛中吹。","傷心日暮煙霞起，無限春愁生翠眉。"]},{"i":"24a9647b-3da2-4fef-b2ad-71a7cd645f55","t":"折楊柳枝二首 二","a":"張祜","d":"唐","g":"短诗","p":["凝碧池邊斂翠眉，景陽樓下綰青絲。","那勝妃子朝元閣，玉手和煙弄一枝。"]},{"i":"f5139807-ad11-47be-ba92-1461bc229e8f","t":"華清宮四首 一","a":"張祜","d":"唐","g":"短诗","p":["風樹離離月稍明，九天龍氣在華清。","宮門深鎖無人覺，半夜雲中羯鼓聲。"]},{"i":"25a1ccd0-99fb-45e1-b6f2-79106ae1cf3a","t":"華清宮四首 二","a":"張祜","d":"唐","g":"短诗","p":["天闕沈沈夜未央，碧雲仙曲舞霓裳。","一聲玉笛向空盡，月滿驪山宮漏長。"]},{"i":"14dec0ab-44a1-44f5-b43e-40199c18b443","t":"華清宮四首 三","a":"張祜","d":"唐","g":"短诗","p":["紅樹蕭蕭閣半開，上皇曾幸此宮來。","至今風俗驪山下，村笛猶吹阿濫堆。"]},{"i":"1bb582e4-d604-4eb5-9cbd-773a7942403e","t":"華清宮四首 四","a":"張祜","d":"唐","g":"短诗","p":["水遶宮牆處處聲，殘紅長綠露華清。","武皇一夕夢不覺，十二玉樓空月明。"]},{"i":"87ca92e8-b148-4b68-a9bc-386243f043b0","t":"贈竇家小兒","a":"張祜","d":"唐","g":"短诗","p":["深綠衣裳小小人，每來聽裏解相親。","天生合去雲霄上，一尺松栽已出塵。"]},{"i":"7e808dee-54f9-428c-a303-71ea2ee91df5","t":"聽崔莒侍御葉家歌","a":"張祜","d":"唐","g":"短诗","p":["宛羅重縠起歌筵，活鳳生花動碧煙。","一聲唱斷無人和，觸破秋雲直上天。"]},{"i":"9be5e1b5-2ab1-40f5-8478-34304b42605b","t":"長門怨","a":"張祜","d":"唐","g":"短诗","p":["日映宮牆柳色寒，笙歌遙指碧雲端。","珠鉛滴盡無心語，強把花枝冷笑看。"]},{"i":"9f2782a0-50ef-4c68-a5a7-700072bd18db","t":"讀老莊","a":"張祜","d":"唐","g":"短诗","p":["等閑緝綴閑言語，誇向詩人喚作詩。","昨日偶拈莊老讀，萬尋山上一毫釐。"]},{"i":"8336ca09-bc03-4fca-a089-158f0a4188c4","t":"偶題","a":"張祜","d":"唐","g":"短诗","p":["古來名下豈虛爲，李白顛狂自稱時。","唯恨世間無賀老，謫仙長在沒人知。"]},{"i":"4502a4b6-020a-47d3-bb7c-6d2f259233ed","t":"別玉華僊侶","a":"張祜","d":"唐","g":"短诗","p":["遶舍煙霞爲四鄰，寒泉白石日相親。","塵機不盡住不得，珍重玉山山上人。"]},{"i":"70852388-0a18-4ef0-85cb-e073eb2bf0b8","t":"汴上送客","a":"張祜","d":"唐","g":"短诗","p":["河流西下鴈南飛，楚客相逢淚濕衣。","張翰思歸何太切，扁舟不住又東歸。"]},{"i":"75f42aef-c901-42c9-baec-9fdc1e3c56dc","t":"郵亭殘花","a":"張祜","d":"唐","g":"短诗","p":["雲暗山橫日欲斜，郵亭下馬對殘花。","自從身逐征西府，每到花時不在家。"]},{"i":"a38ea53c-814d-4ec5-a5cd-74038b475524","t":"秋時送鄭侍御","a":"張祜","d":"唐","g":"短诗","p":["離鴻聲怨碧雲淨，楚瑟調高清曉天。","盡日相看俱不語，西風搖落數枝蓮。"]},{"i":"79d4c672-c1f8-466a-bb8a-97a22e2566e7","t":"宿武牢關","a":"張祜","d":"唐","g":"短诗","p":["行人候曉久裴徊，不待雞鳴未得開。","堪羨寒溪自無事，潺潺一夜宿關來。"]},{"i":"4568742a-6daa-4a29-ae37-faa48ac70301","t":"夜宿湓浦逢崔昇","a":"張祜","d":"唐","g":"短诗","p":["江流不動月西沈，南北行人萬里心。","況是相逢鴈天夕，星河寥落水雲深。"]},{"i":"b1f83088-16fe-43a8-bf2d-7a118b7eb796","t":"京城寓懷","a":"張祜","d":"唐","g":"短诗","p":["三十年持一釣竿，偶隨書薦入長安。","由來不是求名者，唯待春風看牡丹。"]},{"i":"bc066eb7-91af-499d-a691-8f9452b21011","t":"感歸","a":"張祜","d":"唐","g":"短诗","p":["行却江南路幾千，歸來不把一文錢。","鄉人笑我窮寒鬼，還似襄陽孟浩然。"]},{"i":"d23945a1-9439-4bf5-9cf5-ce3d9f7291e6","t":"偶作","a":"張祜","d":"唐","g":"短诗","p":["徧識青霄路上人，相逢秖是語逡巡。","可勝飲盡江南酒，歲月猶殘李白身。"]},{"i":"ddb0a7ca-2de3-4720-9a8f-f6ce1c85d379","t":"勸飲酒","a":"張祜","d":"唐","g":"短诗","p":["燒得硫黃漫學仙，未勝長付酒家錢。","竇常不喫齊推樂，却在人間八十年。"]},{"i":"43518b8e-1d67-479d-8224-7fc6660d642a","t":"阿䳰湯","a":"張祜","d":"唐","g":"短诗","p":["月照宮城紅樹芳，綠窗燈影在雕梁。","金輿未到長生殿，妃子偷尋阿䳰湯。"]},{"i":"3a4f178b-0009-40ce-9c8d-2c76c6d58279","t":"馬嵬坡","a":"張祜","d":"唐","g":"短诗","p":["旌旗不整奈君何，南去人稀北去多。","塵土已殘香粉豔，荔枝猶到馬嵬坡。"]},{"i":"ad203d7d-aab8-4cc1-907d-e8976e174ff8","t":"太真香囊子","a":"張祜","d":"唐","g":"短诗","p":["蹙金妃子小花囊，銷耗胸前結舊香。","誰爲君王重解得，一生遺恨繫心腸。"]},{"i":"d8e11414-a73c-4788-ba77-714875ed7bc0","t":"雨霖鈴","a":"張祜","d":"唐","g":"短诗","p":["雨霖鈴夜却歸秦，猶見張徽一曲新。","長說上皇和淚教，月明南內更無人。"]},{"i":"83edf60f-b9dc-432f-a4cb-abb2db37ef5b","t":"聽歌二首 一","a":"張祜","d":"唐","g":"短诗","p":["兒郎漫說轉喉輕，須待情來意自生。","只是眼前絲竹和，大家聲裏唱新聲。"]},{"i":"9f6ff2be-a9bf-4696-aa27-d634e2dc42f1","t":"聽歌二首 二","a":"張祜","d":"唐","g":"短诗","p":["十二年前邊塞行，坐中無語歎歌情。","不堪昨夜先垂淚，西去陽關第一聲。"]},{"i":"f1fe451a-98dd-4fd3-86f2-5fd663d80cb7","t":"聽箏","a":"張祜","d":"唐","g":"短诗","p":["十指纖纖玉筍紅，鴈行輕遏翠弦中。","分明似說長城苦，水咽雲寒一夜風。"]},{"i":"5be9e8f8-8d23-4d21-8ae4-39de58fd0174","t":"王家琵琶","a":"張祜","d":"唐","g":"短诗","p":["金屑檀槽玉腕明，子弦輕撚爲多情。","只愁拍盡涼州破，畫出風雷是撥聲。"]},{"i":"67d38511-f8ce-4978-8159-bc6b08b9d731","t":"李家柘枝","a":"張祜","d":"唐","g":"短诗","p":["紅鉛拂臉細腰人，金繡羅衫軟著身。","長恐舞時殘拍盡，却思雲雨更無因。"]},{"i":"88294ec1-a0b5-4d52-9395-71ee7919ab45","t":"楚州韋中丞箜篌","a":"張祜","d":"唐","g":"短诗","p":["千重鉤鎖撼金鈴，萬顆真珠瀉玉瓶。","恰值滿堂人欲醉，甲光纔觸一時醒。"]},{"i":"34a3f637-b340-4583-9248-c5a11ec0f693","t":"邊上逢歌者","a":"張祜","d":"唐","g":"短诗","p":["垂老秋歌出塞庭，遏雲相付舊秦青。","少年翻擲新聲盡，却向人前側耳聽。"]},{"i":"74e7b635-8591-454e-882e-63e4bba14d6b","t":"馬嵬歸","a":"張祜","d":"唐","g":"短诗","p":["雲愁鳥恨驛坡前，孑孑龍旗指望賢。","無復一生重語事，柘黃衫袖掩潸然。"]},{"i":"ea796d03-30c2-43bf-afd3-cf5bb386c571","t":"塞上聞笛","a":"張祜","d":"唐","g":"短诗","p":["一夜梅花笛裏飛，冷沙晴檻月光輝。","北風吹盡向何處，高入塞雲燕鴈稀。"]},{"i":"c06b64c0-d919-489a-b080-a4714f6b994c","t":"經舊遊","a":"張祜","d":"唐","g":"短诗","p":["去年來送行人處，依舊蟲聲古岸南。","斜日照溪雲影斷，水葓花穗倒空潭。"]},{"i":"758a9e19-1703-4928-9a29-401fbeae7c85","t":"東山寺","a":"張祜","d":"唐","g":"短诗","p":["寒色蒼蒼老栢風，石苔清滑露光融。","半夜四山鐘磬盡，水精宮殿月玲瓏。"]},{"i":"5af71cc2-17df-4d25-b7bd-5002c18e1661","t":"峰頂寺","a":"張祜","d":"唐","g":"短诗","p":["月明如水山頭寺，仰面看天石上行。","夜半深廊人語定，一枝松動鶴來聲。"]},{"i":"f7d4285c-6ff4-4232-96de-273eda9bcbc9","t":"題潤州鶴林寺","a":"張祜","d":"唐","g":"短诗","p":["古寺名僧多異時，道情虛遣俗情悲。","千年鶴在市朝變，來去舊山人不知。"]},{"i":"5fb80edc-7241-4419-b700-a8ecf6b95631","t":"題勝上人山房","a":"張祜","d":"唐","g":"短诗","p":["清晝房廊山半開，一瓶新汲灑莓苔。","古松百尺始生葉，颯颯風聲天上來。"]},{"i":"2ab4c4c9-1503-4e44-a1f9-34e93173105c","t":"李夫人詞","a":"張祜","d":"唐","g":"短诗","p":["延年不語望三星，莫說夫人上涕零。","爭奈世間惆悵在，甘泉宮夜看圖形。"]},{"i":"72dea9b1-4650-4109-8621-8716b6b59cb2","t":"過陰陵","a":"張祜","d":"唐","g":"短诗","p":["壯士悽惶到山下，行人惆悵上山頭。","生前此路已迷失，寂寞孤魂何處遊。"]},{"i":"4dd58129-5865-4990-9c13-23dea0823ac7","t":"縱遊淮南","a":"張祜","d":"唐","g":"短诗","p":["十里長街市井連，月明橋上看神仙。","人生只合揚州死，禪智山光好墓田。"]},{"i":"13ac090d-48ac-4c2e-b60f-67b87bd453bb","t":"登樂遊原","a":"張祜","d":"唐","g":"短诗","p":["幾年詩酒滯江干，水積雲重思萬端。","今日南方惆悵盡，樂遊原上見長安。"]},{"i":"07fb7700-b53a-4838-b1ac-8b76a5ca1d41","t":"過石頭城","a":"張祜","d":"唐","g":"短诗","p":["纍纍墟墓葬西原，六代同歸蔓草根。","唯是歲華流盡處，石頭城下水千痕。"]},{"i":"91b79fd5-9abb-47cc-bbf7-1fa04a6b82d9","t":"黃蜀葵花","a":"張祜","d":"唐","g":"短诗","p":["名花八葉嫩黃金，色照書窗透竹林。","無奈美人閑把嗅，直疑檀口印中心。"]},{"i":"5258ac82-b83a-410b-b8f4-dabb2ec4cc82","t":"楊花","a":"張祜","d":"唐","g":"短诗","p":["散亂隨風處處勻，庭前幾日雪花新。","無端惹著潘郎鬢，驚殺綠窗紅粉人。"]},{"i":"b69e2293-b675-44e4-9a21-410999606711","t":"薔薇花","a":"張祜","d":"唐","g":"短诗","p":["曉風抹盡燕支顆，夜雨催成蜀錦機。","當晝開時正明媚，故鄉疑是買臣歸。"]},{"i":"943cf843-d212-49e2-a12f-a8a4017d2e3d","t":"戲顏郎中獵","a":"張祜","d":"唐","g":"短诗","p":["忽聞射獵出軍城，人著戎衣馬帶纓。","倒把角弓呈一箭，滿川狐兔當頭行。"]},{"i":"1587e65b-dc89-4473-a93e-d70be7f51a72","t":"江上旅泊呈杜員外","a":"張祜","d":"唐","g":"短诗","p":["牛渚南來沙岸長，遠吟佳句望池陽。","野人未必非毛遂，太守還須是孟嘗。"]},{"i":"6a421cd8-5cc3-4700-aea8-7ced152d6642","t":"容兒鉢頭","a":"張祜","d":"唐","g":"短诗","p":["爭走金車叱鞅牛，笑聲唯是說千秋。","兩邊角子羊門裏，猶學容兒弄鉢頭。"]},{"i":"ee8c7825-a0c7-42ec-af0a-4df5b3eea3b9","t":"熱戲樂","a":"張祜","d":"唐","g":"短诗","p":["熱戲爭心劇火燒，銅槌暗熱不相饒。","上皇失喜寧王笑，百尺幢竿果動搖。"]},{"i":"0b72bb70-cd92-4576-9276-d04bcf825a4d","t":"玉環琵琶","a":"張祜","d":"唐","g":"短诗","p":["宮樓一曲琵琶聲，滿眼雲山是去程。","回顧段師非汝意，玉環休把恨分明。"]},{"i":"c24a4eed-3ab3-4bff-9252-27bfa2969661","t":"題酸棗驛前碑","a":"張祜","d":"唐","g":"短诗","p":["蒼苔古澀自雕疎，誰道中郎筆力餘。","長愛當時遇王粲，每來碑下不關書。"]},{"i":"06a74e5e-8124-49ec-9141-c9e51b37dd56","t":"題朱兵曹山居","a":"張祜","d":"唐","g":"短诗","p":["朱氏西齋萬卷書，水門山闊自高疎。","我來穿穴非無意，願向君家作壁魚。"]},{"i":"ddd714c0-2794-4771-baf4-3b49f8ba29aa","t":"題畫僧二首 一","a":"張祜","d":"唐","g":"短诗","p":["骨峭情高彼岸人，一杯長泛海爲津。","僧儀又入清流品，却恐前生是許詢。"]},{"i":"77074d06-3f8b-4bb9-ae9e-8b7dab0ec38c","t":"題畫僧二首 二","a":"張祜","d":"唐","g":"短诗","p":["瘦頸隆肩碧眼生，翰林親讚虎頭能。","終年不語看如意，似證禪心入大乘。"]},{"i":"a0bb3ee8-1aa5-44f9-b8be-2683c7156e42","t":"送走馬使","a":"張祜","d":"唐","g":"短诗","p":["新樣花文配蜀羅，同心雙帶蹙金蛾。","慣將喉舌傳軍好，馬跡鈴聲遍兩河。"]},{"i":"e3570eb6-8824-4208-b631-42b081ac495a","t":"題御溝","a":"張祜","d":"唐","g":"短诗","p":["萬樹垂楊拂御溝，溶溶漾漾遶神州。","都緣濟物心無阻，從此恩波處處流。"]},{"i":"9fa301e8-a913-411e-a6a3-0177c64861fc","t":"題青龍寺","a":"張祜","d":"唐","g":"短诗","p":["二十年沈滄海間，一遊京國也應閑。","人人盡到求名處，獨向青龍寺看山。"]},{"i":"d1bdffac-a26f-46c0-adf9-0e6f2c413379","t":"硫黃","a":"張祜","d":"唐","g":"短诗","p":["一粒硫黃入貴門，寢堂深處問玄言。","時人盡說韋山甫，昨日餘干弔子孫。"]},{"i":"d0514299-96b8-4e28-92d2-5035b318f2be","t":"散花樓","a":"張祜","d":"唐","g":"短诗","p":["錦江城外錦城頭，回望秦川上軫憂。","正值血魂來夢裏，杜鵑聲在散花樓。"]},{"i":"732acd2b-7a11-4e7f-92e3-eaecba012b2e","t":"王家五弦","a":"張祜","d":"唐","g":"短诗","p":["五條弦出萬端情，撚撥間關漫態生。","唯羨風流田太守，小金鈴子耳邊鳴。"]},{"i":"b1814cae-ec73-4fc2-bb09-03dd658eba2d","t":"聽薛陽陶吹蘆管","a":"張祜","d":"唐","g":"短诗","p":["紫清人下薛陽陶，末曲新笳調更高。","無奈一聲天外絕，百年已死斷腸刀。"]},{"i":"eaaed3e5-9243-4aaa-812a-29e8aee24c82","t":"過汾水關","a":"張祜","d":"唐","g":"短诗","p":["千里南來背日行，關門無事一侯嬴。","山根百尺路前去，十夜耳中汾水聲。"]},{"i":"a9cfc2ae-3000-40f3-90d7-e094807a03d2","t":"櫻桃","a":"張祜","d":"唐","g":"短诗","p":["石榴未拆梅猶小，愛此山花四五株。","斜日庭前風嬝嬝，碧油千片漏紅珠。"]},{"i":"546b43ee-754f-4c16-9276-c4cb3f932c3d","t":"酬凌秀才惠枕","a":"張祜","d":"唐","g":"短诗","p":["八寸黃楊惠不輕，虎頭光照簟文清。","空心想此緣成夢，拔劍燈前一夜行。"]},{"i":"9286550d-0d86-407f-b043-f0672b292058","t":"感春申君","a":"張祜","d":"唐","g":"短诗","p":["薄俗何心議感恩，諂容卑迹賴君門。","春申還道三千客，寂寞無人殺李園。"]},{"i":"e8f3ea6d-cf39-424c-b483-3f557f56b0bf","t":"孟才人歎","a":"張祜","d":"唐","g":"短诗","p":["偶因歌態詠嬌嚬，傳唱宮中十二春。","却爲一聲河滿子，下泉須弔舊才人。"]},{"i":"27903dde-9692-4fc3-b9d2-c03a176e26be","t":"聽簡上人吹蘆管三首 一","a":"張祜","d":"唐","g":"短诗","p":["蜀國僧吹蘆一枝，隴西游客淚先垂。","至今留得新聲在，却爲中原人不知。"]},{"i":"ea91be6d-fb29-44e1-aee5-53875699344e","t":"聽簡上人吹蘆管三首 二","a":"張祜","d":"唐","g":"短诗","p":["細蘆僧管夜沈沈，越鳥巴猨寄恨吟。","吹到耳邊聲盡處，一條絲斷碧雲心。"]},{"i":"6790eaa6-d1c9-4868-a78d-08a0c7b6417b","t":"聽簡上人吹蘆管三首 三","a":"張祜","d":"唐","g":"短诗","p":["月落江城樹繞鴉，一聲蘆管是天涯。","分明西國人來說，赤佛堂西是漢家。"]},{"i":"9439f354-b5fd-49d2-8142-99828b73eab3","t":"聽岳州徐員外彈琴","a":"張祜","d":"唐","g":"短诗","p":["玉律潛符一古琴，哲人心見聖人心。","盡日南風似遺意，九疑猨鳥滿山吟。"]},{"i":"5f564bda-46fc-4dfd-b27e-d08725343e3e","t":"鉤弋夫人詞","a":"張祜","d":"唐","g":"短诗","p":["惆悵雲陵事不迴，萬金重更築仙臺。","莫言天上無消息，猶是夫人作鳥來。"]},{"i":"ac6cdfa4-14f4-401a-a4b7-b1d3354d623b","t":"鴻溝","a":"張祜","d":"唐","g":"短诗","p":["龍蛇百戰爭天下，各制雄心指此溝。","寧似九州分國土，地圖初割海中流。"]},{"i":"63dbfe11-242b-4a60-8c55-bfe5f7230cae","t":"悲納鐵","a":"張祜","d":"唐","g":"短诗","p":["長聞爲政古諸侯，使佩刀人盡佩牛。","誰謂今來正耕墾，却銷農器作戈矛。"]},{"i":"e8a64325-11a5-40b9-af4e-42f834e91395","t":"胡渭州","a":"張祜","d":"唐","g":"短诗","p":["亭亭孤月照行舟，寂寂長江萬里流。","鄉國不知何處是，雲山漫漫使人愁。"]},{"i":"bebccba0-7ac5-437e-a953-f91c86d7deda","t":"破陣樂","a":"張祜","d":"唐","g":"短诗","p":["秋風四面足風沙，塞外征人暫別家。","千里不辭行路遠，時光早晚到天涯。"]},{"i":"1f740d6e-dc77-436e-8743-64fd0cb8dc36","t":"楓橋","a":"張祜","d":"唐","g":"短诗","p":["長洲苑外草蕭蕭，卻算游城歲月遙。","唯有別時今不忘，暮煙疎雨過楓橋。"]},{"i":"3561d89c-77fe-4e95-9d57-b2d718949259","t":"句","a":"張祜","d":"唐","g":"古体","p":["萬國見清道，一身成白頭。","此地榮辱盛，豈宜山中人。","椿兒遶樹春園裏，桂子尋花夜月中。","一身扶杖二兒隨。","夏雨蓮苞破，秋風桂子彫。","杜鵑花發杜鵑叫，烏臼花生烏臼啼。","茶風無奈筆，酒禿不勝簪。"]},{"i":"3f9ded2c-701c-48c5-bb42-8148b98df9f0","t":"荅李昌期","a":"楊洵美","d":"唐","g":"古体","p":["三山載羣仙，峨峨鹹浪中。","雲衣剪不得，此路安可從。","我生亦何事，出門如飛蓬。","白日又黃昏，所悲瑤草空。","蟲聲故鄉夢，枕上禾黍風。"]},{"i":"5bcf3329-95e1-410f-b6fd-7f99bbdd191a","t":"宮詞","a":"長孫翱","d":"唐","g":"短诗","p":["一道甘泉接御溝，上皇行處不曾秋。","誰言水是無情物，也到宮前咽不流。"]},{"i":"c5bff5dc-b6bc-4694-8aa9-1be72babf78a","t":"和于中丞登越王樓見寄","a":"盧求","d":"唐","g":"短诗","p":["高情推謝守，善政屬綿州。","未落紫泥詔，閑登白雪樓。","晴江如送日，寒嶺鎮迎秋。","滿壁朝天士，唯予不繫舟。"]},{"i":"5b604f1b-8e67-4786-b813-e73fda0f33ea","t":"雨","a":"歐陽衮","d":"唐","g":"短诗","p":["細雨弄春陰，餘寒入晝深。","山姿輕薄霧，煙色澹幽林。","鹿踐莓苔滑，魚牽水荇沈。","懷情方未已，清酒漫須斟。"]},{"i":"10b5887d-00d2-4028-b30d-1554f6303e82","t":"田家","a":"歐陽衮","d":"唐","g":"短诗","p":["黯黯日將夕，牛羊村外來。","巖阿青氣發，籬落杏花開。","草木應初感，鶬鶊亦已催。","晚間春作好，行樂不須猜。"]},{"i":"518a8139-2a76-4240-a09c-c11cbbd7330f","t":"神光寺","a":"歐陽衮","d":"唐","g":"短诗","p":["香剎懸青磴，飛樓界碧空。","石門棲怖鴿，慈塔繞歸鴻。","有法將心鏡，無名屬性通。","從來樂幽寂，尋覓未能窮。"]},{"i":"2987bf38-3eb9-4921-997e-63f73ddb87c7","t":"和項斯遊頭陀寺上方","a":"歐陽衮","d":"唐","g":"短诗","p":["步入桃源裏，晴花更滿枝。","峰迴山意曠，林杳竹光遲。","遠寺尋龍藏，名香發雁池。","間能將遠語，況及上陽時。"]},{"i":"d627c5e2-ffbc-46e5-a7c3-93bfa7acf5c9","t":"秦原道中","a":"歐陽衮","d":"唐","g":"短诗","p":["分險架長瀾，斜梁控夕巒。","宿雲依嶺斷，初月入江寒。","緇化秦裘敝，塵驚漢策殘。","無言倦行旅，遙路屬時難。"]},{"i":"adf79114-7087-45d8-aabd-0785e3b87c57","t":"月峰寺憶理公","a":"歐陽衮","d":"唐","g":"短诗","p":["共來江海上，清論一宵同。","禪榻渾依舊，心期浩已空。","驚春花落樹，聞梵澗搖風。","二諦欣咨啓，還應夢寐通。"]},{"i":"eed70620-1d1b-4b42-979b-93d0c86a4b89","t":"寄陳去疾進士","a":"歐陽衮","d":"唐","g":"短诗","p":["放跡疑辭垢，棲心亦道門。","玄言蘿幌馥，詩思竹爐溫。","解帶搖花落，彈琴散鳥喧。","江山茲夕意，唯有素交存。"]},{"i":"cc996bf3-c19e-4646-9bf2-4a2985b40380","t":"聽郢客歌陽春白雪","a":"歐陽衮","d":"唐","g":"古体","p":["寂聽郢中人，高歌已絕倫。","臨風飄白雪，向日奏陽春。","調雅偏盈耳，聲長杳入神。","連連貫珠並，嬝嬝遏雲頻。","度曲知難和，凝情想任真。","周郎如賞羨，莫使滯芳晨。"]},{"i":"d794d28c-ae8b-4aed-95b5-ba69e8b876ec","t":"南澗寺","a":"歐陽衮","d":"唐","g":"短诗","p":["春寺無人亂鳥啼，藤蘿陰磴野僧迷。","雲藏古壁遺龍象，草沒香臺抱鹿麛。","松籟泠泠疑梵唄，柳煙歷歷見招提。","爲耽寂樂親禪侶，莫怪閑行費馬蹄。"]}]