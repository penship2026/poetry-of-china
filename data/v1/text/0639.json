[{"i":"c-d96e4f3d0ea9","t":"念奴娇","a":"蔡伸","d":"宋","g":"词","p":["凌空宝观，乍登临、多少伤离情味。","淼淼烟波吴会远，极目江淮无际。","槛外长江，楼中红袖，淡荡秋光里。","一声横吹，半滩鸥鹭起。","因念邃馆香闺，玉肌花貌，有盈盈仙子。","弄水题红传密意，宝墨银钩曾寄。","泪粉香销，碧云□杳，脉脉人千里。","一弯新月，断肠危栏独倚。"],"s":"simp","f":"trad"},{"i":"c-2c4b2160cec1","t":"念奴娇","a":"蔡伸","d":"宋","g":"词","p":["岁华晼晚，念羁怀多感，佳会难卜。","草草杯盘聊话旧，同剪西窗寒烛。","翠袖笼香，双蛾敛恨，低按新翻曲。","无情风雨，断肠更漏催促。","匆匆归骑难留，鸾屏鸳被，忍良宵孤宿。","回首幽欢成梦境，唯觉衣襟芬馥。","海约山盟，云情雨意，何日教心足。","不如不见，为君一味愁蹙。"],"s":"simp","f":"trad"},{"i":"c-f26899d68b0b","t":"念奴娇","a":"蔡伸","d":"宋","g":"词","p":["画堂宴阕，望重帘不卷，轻哑朱户。","悄悄回廊，惊渐闻、蟋蟀凌波微步。","酒力融春，香风暗度，携手偎金缕。","低低笑问，睡得真个稳否。","因念隔阔经年，除非魂梦里，有时相遇。","天意怜人心在了，岂信关山遐阻。","晓色朦胧，柔情倦恋，后约叮咛语。","休教肠断，楚台朝暮云雨。"],"s":"simp","f":"trad"},{"i":"c-0a987417f3b9","t":"念奴娇","a":"蔡伸","d":"宋","g":"词","p":["当年豪放，况朋侪俱是，一时英杰。","逸气凌云，佳丽地、独占春花秋月。","冶叶倡条，寻芳选胜，是处曾攀折。","昔游如梦，镜中空叹华发。","邂逅萍梗相逢，十年往事，忍尊前重说。","茂绿成阴春又晚，谁解丁香千结。","宝瑟弹愁，玉壶敲怨，触目堪愁绝。","酒阑人静，为君肠断时节。"],"s":"simp","f":"trad"},{"i":"c-08750b402d31","t":"念奴娇","a":"蔡伸","d":"宋","g":"词","p":["轻雷骤雨，洗千岩浓翠，层峦森列。","衣袂凉生，丛竹外、时有飞萤明灭。","云浪鳞鳞，兰舟泛泛，共载一轮月。","五湖当日，未应此段奇绝。","归路横玉惊鸾，叫云清似水，悠扬天末。","玉宇琼林凝望处，依约广寒宫阙。","老去情锺，此心仍在，未肯甘华发。","清欢留作，异时嘉话重说。"],"s":"simp","f":"trad"},{"i":"c-fa6ec057c43c","t":"雨中花慢","a":"蔡伸","d":"宋","g":"词","p":["寓目伤怀，逢欢感旧，年来事事疏慵。","叹身心业重，赋得情浓。","况是离多会少，难忘雨迹云踪。","断无锦字，双鳞杳杳，新雁雍雍。","良宵孤枕，人远天涯，除非梦里相逢。","相逢处，愁红敛黛，还又匆匆。","回首绿窗朱户，可怜明月清风。","断肠风月，关河有尽，此恨无穷。"],"s":"simp","f":"trad"},{"i":"c-1f91a7bf3409","t":"喜迁莺","a":"蔡伸","d":"宋","g":"词","p":["青娥呈瑞。","正惨惨暮寒，同云千里。","剪水飞花，渐渐瑶英，密洒翠筠声细。","邃馆静深，金铺半掩，重帘垂地。","明窗外。","伴疏梅潇洒，玉肌香腻。","幽人当此际。","醒魂照影，永漏愁无寐。","强拊清尊，慵添宝鸭，谁会黯然情味。","幸有赏心人，奈咫尺、重门深闭。","今夜里。","算忍教孤负，浓香鸳被。"],"s":"simp","f":"trad"},{"i":"c-085ea2081d8a","t":"忆瑶姬","a":"蔡伸","d":"宋","g":"词","p":["微雨初晴。","洗瑶空万里，月挂冰轮。","广寒宫阙近，望素娥缥缈，丹桂亭亭。","金盘露冷，玉树风轻。","倍觉秋思清。","念去年曾共吹箫侣，同赏蓬瀛。","奈此夜、旅泊江城。","谩花光眩目，绿酒如渑。","幽怀终有恨，恨绮窗清影，虚照娉婷。","蓝桥□杳，楚馆云深。","似凭归梦去，强就枕，无奈孤衾梦易惊。"],"s":"simp","f":"trad"},{"i":"c-0f9d33247d67","t":"丑奴儿慢・采桑子慢","a":"蔡伸","d":"宋","g":"词","p":["明眸秀色，别是天真潇洒。","更鬓发堆云，玉脸淡拂轻霞。","醉里精神，众中标格谁能画。","当时携手，花笼淡月，重门深亚。","巫峡梦回，已成陈事，岂堪重话。","谩赢得、罗襟清泪，鬓边霜华。","念□伤怀，凭阑烟水渺无涯。","秦源目断，碧云暮合，难认仙家。"],"s":"simp","f":"trad"},{"i":"c-9d0921192012","t":"满江红","a":"蔡伸","d":"宋","g":"词","p":["人倚金铺，颦翠黛、盈盈堕睫。","话别处、留连无计，语娇声咽。","十幅云帆风力满，一川烟暝波光阔。","但回首、极目望高城，弹清血。","并兰舟，停画楫。","曾共醉，津亭月。","销魂处，今夜月圆人缺。","楚岫云归空怅望，汉皋佩解成轻别。","最苦是、拍塞满怀愁，无人说。"],"s":"simp","f":"trad"},{"i":"c-0efa9f38beb9","t":"婆罗门引","a":"蔡伸","d":"宋","g":"词","p":["素秋向晚，岁华分付木芙蓉。","萧萧红蓼西风。","记得当时撷翠，拥手绕芳丛。","念吹箫人去，明月楼空。","遥山万重。","望寸碧、想眉峰。","翠钿琼珰谩好，谁适为容。","凄凉怀抱，算此际、唯我与君同。","凝泪际、目送征鸿。"],"s":"simp","f":"trad"},{"i":"c-58aa7fee0e54","t":"青玉案","a":"蔡伸","d":"宋","g":"词","p":["参差弱柳长堤路。","柳外征帆去。","皓齿明眸娇态度。","回头一梦，断肠千里，不到相逢地。","来时约略春将暮。","幽恨空馀锦中句。","小院重门深几许。","桃花依旧，出墙临水，乱落如红雨。"],"s":"simp","f":"trad"},{"i":"c-817813c032fc","t":"青玉案","a":"蔡伸","d":"宋","g":"词","p":["鸾凰本是和鸣友。","奈无计、长相守。","云雨匆匆分袂后。","彩舟东去，橹声呕轧，目断长堤柳。","涓涓清泪轻绡透。","残粉馀香尚依旧。","独上南楼空回首。","夜来明月，怎知今夜，少个人携手。"],"s":"simp","f":"trad"},{"i":"c-d5277f8e6c5f","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["双佩雷文拂手香。","青纱衫子淡梳妆。","冰姿绰约自生凉。","虚掉玉钗惊翡翠，缓移兰棹趁鸳鸯。","鬓鬟风乱绿云长。"],"s":"simp","f":"trad"},{"i":"c-4797d726fae5","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["玉趾弯弯一折弓。","秋波剪碧滟双瞳。","浅颦轻笑意无穷。","夜静拥炉熏督耨，月明飞棹采芙蓉。","别来欢事少人同。"],"s":"simp","f":"trad"},{"i":"c-21fd3e8eb540","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["苹末风轻入夜凉。","飞桥画阁跨方塘。","月移花影上回廊。","粲枕随钗云鬓乱，红绵扑粉玉肌香。","起来携手看鸳鸯。"],"s":"simp","f":"trad"},{"i":"c-9f1e97c4de7b","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["窗外疏篁对节金。","画桥新绿一篙深。","沈沈清夜对横参。","酒晕半消红玉脸，云鬟轻制小犀簪。","梦回陈迹杳难寻。"],"s":"simp","f":"trad"},{"i":"c-fad070c93a71","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["沙上寒鸥接翼飞。","潮生潮落水东西。","征船鸣橹趁潮归。","望断碧云无锦字，谩题红叶有新诗。","黄昏微雨倚阑时。"],"s":"simp","f":"trad"},{"i":"c-b7bd9852b635","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["漠漠新田绿未齐。","柳阴阴下水平堤。","竹间时有乳鸦啼。","云敛屏山横枕畔，夜阑璧月转林西。","玉芝香里彩鸳栖。"],"s":"simp","f":"trad"},{"i":"c-435963ee7547","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["紫燕双双掠水飞。","廉纤小雨未成泥。","篱边开尽野蔷薇。","会少离多终有恨，暂来还去益堪悲。","后期重约采莲时。"],"s":"simp","f":"trad"},{"i":"c-ac5c6674525d","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["窄窄霜绡稳称身。","强临歌酒惨离魂。","故人相遇益伤神。","断雨残云千里隔，琼枝璧月四时新。","为君留取镜中春。"],"s":"simp","f":"trad"},{"i":"c-79d58ea833c0","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["且斗尊前见在身。","昔游如梦可销魂。","玉容依约旧精神。","千里重来人事改，一杯相属意还新。","韶华不减洞中春。"],"s":"simp","f":"trad"},{"i":"c-d8b2e9f657c9","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["木似文犀感月华。","寸根移种自仙家。","春兰秋菊浪矜夸。","玉露初零秋夜永，幽香直入小窗纱。","此时风月独输他。"],"s":"simp","f":"trad"},{"i":"c-3efdd7836bef","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["叶剪玻璃芯糁金。","清香端不数琼沈。","独将高韵冠芗林。","千里江山新梦后，一天风露小庭深。","主人归兴已骎骎。"],"s":"simp","f":"trad"},{"i":"c-bbfefd9c2a5e","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["浅褐衫儿寿带藤。","碾花如意枕冠轻。","凤鞋弓小称娉婷。","约略梳妆随事好，出尘标韵出尘清。","一枝梅映玉壶冰。"],"s":"simp","f":"trad"},{"i":"c-bfcb34b3d3e2","t":"浣溪沙","a":"蔡伸","d":"宋","g":"词","p":["窗外桃花烂熳开。","年时曾伴玉人来。","一枝斜插凤皇钗。","今日重来人事改，花前无语独徘徊。","凄凉怀抱可怜哉。"],"s":"simp","f":"trad"},{"i":"c-5729be5104a0","t":"虞美人","a":"蔡伸","d":"宋","g":"词","p":["瑶琴一弄清商怨。","楼外桐阴转。","月华澄淡露华浓。","寂寞小池烟水、冷芙蓉。","攀花撷翠当时事。","绿叶同心字。","有情还解忆人无。","过尽寒沙新雁、甚无书。"],"s":"simp","f":"trad"},{"i":"c-2ab545edc080","t":"虞美人","a":"蔡伸","d":"宋","g":"词","p":["飞梁石径关山路。","惨淡秋容暮。","一行新雁破寒空。","肠断碧云千里、水溶溶。","鸾衾欲展谁堪共。","帘幕霜华重。","鸭炉香尽锦屏中。","幽梦今宵何许、与君同。"],"s":"simp","f":"trad"},{"i":"c-7c51d9188255","t":"虞美人","a":"蔡伸","d":"宋","g":"词","p":["红尘匹马长安道。","人与花俱老。","缓垂鞭袖过平康。","散尽高阳、零落少年场。","朱弦重理相思调。","无奈知音少。","十年如梦尽堪伤。","乐事如今、回首做凄凉。"],"s":"simp","f":"trad"},{"i":"c-9bd0270e2abd","t":"虞美人","a":"蔡伸","d":"宋","g":"词","p":["彩旗摇曳樯乌转。","鹢首征帆展。","高城楼观暮云平。","叠鼓凝笳都在、断肠声。","绿窗朱户空回首。","明月还依旧。","乱山无数水茫茫。","谁念塞垣风物、㬠凄惶。"],"s":"simp","f":"trad"},{"i":"c-9a1bd81a8e03","t":"虞美人","a":"蔡伸","d":"宋","g":"词","p":["堆琼滴露冰壶莹。","楼外天如镜。","水晶双枕衬云鬟。","卧看千山明月、听潺湲。","渡江桃叶分飞后。","马上犹回首。","邮亭今夜月空圆。","不似当时携手、对婵娟。"],"s":"simp","f":"trad"},{"i":"c-24ff292450cb","t":"虞美人","a":"蔡伸","d":"宋","g":"词","p":["碧溪曾寄流红字。","忍话当时事。","重来种种尽堪悲。","有酒盈杯、聊为故人持。","夜闲剪烛西窗语。","怀抱今如许。","尊前莫讶两依依。","绿鬓朱颜、不似少年时。"],"s":"simp","f":"trad"},{"i":"c-7fdc76adc57e","t":"虞美人","a":"蔡伸","d":"宋","g":"词","p":["鸾屏绣被香云拥。","平帖幽闺梦。","觉来重试古龙涎。","深炷玉炉、烧气不烧烟。","匆匆人去三更也。","月到回廊下。","出门无语送郎时。","泪共一天风露、湿罗衣。"],"s":"simp","f":"trad"},{"i":"c-720af4f3f50f","t":"生查子","a":"蔡伸","d":"宋","g":"词","p":["画堂初见伊，明月当满窗。","今夜月如眉，话别河桥畔。","重见约中秋，莫负于飞愿。","免使月圆时，两处空肠断。"],"s":"simp","f":"trad"},{"i":"c-6df2e9888d85","t":"生查子","a":"蔡伸","d":"宋","g":"词","p":["霜寒月满窗，夜永人无寐。","绛腊有馀情，偏照鸳鸯被。","看尽旧时书，洒尽今生泪。","衙鼓已三更，还是和衣睡。"],"s":"simp","f":"trad"},{"i":"c-034cb26472e4","t":"生查子","a":"蔡伸","d":"宋","g":"词","p":["金壶插玉芝，人面交相照。","花影满方床，翠叠屏山杳。","风月亦多情，特地今宵好。","尽道夜初长，弹指东窗晓。"],"s":"simp","f":"trad"},{"i":"c-ef600a022584","t":"生查子","a":"蔡伸","d":"宋","g":"词","p":["几番花信风，数点笼丝雨。","并辔踏香尘，选胜东郊路。","韶华转首空，谁解留春住。","幸到绿尊前，且作莺花主。"],"s":"simp","f":"trad"},{"i":"c-26830e0ad356","t":"生查子","a":"蔡伸","d":"宋","g":"词","p":["银缸委坠红，碧锁朦胧晓。","别泪洒金徽，一曲情多少。","邮亭今夜长，明月香帏悄。","纵使梦相逢，何处寻蓬岛。"],"s":"simp","f":"trad"},{"i":"c-3aef6becbb9c","t":"南歌子","a":"蔡伸","d":"宋","g":"词","p":["萧寺疏锺断，虚堂夜气清。","凉蟾偏向小明窗。","露井碧梧寒叶、颤秋声。","幽恨人谁问，孤衾泪独横。","此时风月此时情。","拟倩蓝桥归梦、见云英。"],"s":"simp","f":"trad"},{"i":"c-3ed0df517d70","t":"南歌子","a":"蔡伸","d":"宋","g":"词","p":["远水澄明绿，孤云暗淡愁。","白苹红蓼满汀洲。","肠断圆蟾空照、木兰舟。","节物伤羁旅，归程叹滞留。","佳期已误小红楼。","赖得今年犹有、闰中秋。"],"s":"simp","f":"trad"},{"i":"c-f265d0f61adf","t":"南歌子","a":"蔡伸","d":"宋","g":"词","p":["恨入眉峰翠，寒生酒晕红。","临期凝泪洒西风。","须信世间无物、似情浓。","玉蹬敲霜月，金钲伴晓锺。","凄凉古驿乱山重。","今夜拥衾无寐、与君同。"],"s":"simp","f":"trad"},{"i":"c-45c70e58f8e4","t":"南乡子","a":"蔡伸","d":"宋","g":"词","p":["天外雨初收。","风紧云轻已变秋。","邂逅故人同一笑，迟留。","聚散人生宜自谋。","去路指南州。","万顷云涛一叶舟。","莫话太湖波浪险，归休。","人在溪边正倚楼。"],"s":"simp","f":"trad"},{"i":"c-0e2a1e0d07a3","t":"南乡子","a":"蔡伸","d":"宋","g":"词","p":["木落雁南翔。","锦鲤殷勤为渡江。","泪墨银钩相忆字，成行。","滴损云笺小凤皇。","陈事费思量。","回首烟波卷夕阳。","尽道凭书聊破恨，难忘。","及至书来更断肠。"],"s":"simp","f":"trad"},{"i":"c-2edb81785271","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["鸳鸯枕上云堆绿。","兰膏微润知新沐。","开帐对华灯。","见郎双眼明。","锦衾香馥郁。","槛竹敲寒玉。","何物最无情。","晓鸡咿喔声。"],"s":"simp","f":"trad"},{"i":"c-001885be2072","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["杏花零落清明雨。","卷帘双燕来还去。","枕上玉芙蓉。","暖香堆锦红。","翠翘金钿雀。","蝉鬓慵疏掠。","心事一春闲。","黛眉颦远山。"],"s":"simp","f":"trad"},{"i":"c-3a5ccc2a6e24","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["飞英不向枝头住。","等闲又送春归去。","云幄翠阴浮。","长随日脚流。","玉箫吹凤怨。","惊起楼中燕。","飞去自双双。","恼人空断肠。"],"s":"simp","f":"trad"},{"i":"c-90a6cba16b4b","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["水光山影浮空碧。","柳丝摇曳春无力。","柳岸系行舟。","吹箫忆旧游。","旧游堪更忆。","望断迷南北。","千古恨悠悠。","长江空自流。"],"s":"simp","f":"trad"},{"i":"c-a2e8b059792a","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["当时携手今千里。","可堪重到相逢地。","触目尽关心。","流莺尚好音。","无人知我意。","只有涓涓泪。","寂寞到斜阳。","罗衣裛旧香。"],"s":"simp","f":"trad"},{"i":"c-6d08213f5405","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["鸣茄叠鼓催双桨。","扁舟稳泛桃花浪。","别泪洒东风。","前欢如梦中。","梦魂无定据。","不到相逢处。","纵使梦相逢。","香闺岂解同。"],"s":"simp","f":"trad"},{"i":"c-34c9b5217164","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["金铺半掩银瞻满。","个人应恨归来晚。","轧轧橹声迟。","那知心已飞。","迎门一笑粲。","娇困横波慢。","偎倚绿窗前。","今宵人月圆。"],"s":"simp","f":"trad"},{"i":"c-bd239110d97a","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["双双紫燕来华屋。","雨馀芳草池塘绿。","一夜摆花风。","莺花满树红。","杯深君莫诉。","醉袖歌金缕。","无奈惜花心。","老来情转深。"],"s":"simp","f":"trad"},{"i":"c-05c6113958b7","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["朝来一陈狂风雨。","春光已作堂堂去。","茂绿满繁枝。","青梅结子时。","攀枝惊晼晚。","乐事孤心眼。","正是惜春归。","那堪怨别离。"],"s":"simp","f":"trad"},{"i":"c-10456f22ccc3","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["凝羞隔水抛红豆。","嫩桃如脸腰如柳。","心事暗明期。","阳台云雨迷。","玉楼花似雪。","花上朦胧月。","挥泪执柔荑。","匆匆话别时。"],"s":"simp","f":"trad"},{"i":"c-8e3085c94e70","t":"菩萨蛮","a":"蔡伸","d":"宋","g":"词","p":["花冠鼓翼东方动。","兰闺惊破辽阳梦。","翠被小屏山。","晓窗灯影残。","并头双燕语。","似诉横塘雨。","风雨晓寒多。","征人可奈何。"],"s":"simp","f":"trad"},{"i":"c-7f5ddef6d49a","t":"忆秦娥","a":"蔡伸","d":"宋","g":"词","p":["湖光碧。","春花秋月无今昔。","无今昔。","十年往事，尽成陈迹。","玉箫声断云屏隔。","山遥水远长相忆。","长相忆。","一生怀抱，为君牵役。"],"s":"simp","f":"trad"},{"i":"c-f1a3954c01f9","t":"忆秦娥","a":"蔡伸","d":"宋","g":"词","p":["花阴月。","兰堂夜宴神仙客。","神仙客。","江梅标韵，海棠颜色。","良辰佳会诚难得。","花前一醉君休惜。","君休惜。","楚台云雨，今夕何夕。"],"s":"simp","f":"trad"},{"i":"c-c176f5cf425f","t":"清平乐","a":"蔡伸","d":"宋","g":"词","p":["彩舟双橹。","六月临平路。","小雨轻风消晚暑。","绕岸荷花无数。","玉人璨枕方床。","遥知待月西厢。","昨夜有情风月，今宵特地凄凉。"],"s":"simp","f":"trad"},{"i":"c-087e868107f0","t":"清平乐","a":"蔡伸","d":"宋","g":"词","p":["南窗月满。","绣被堆香暖。","苦恨春宵更漏短。","应讶郎归又晚。","征帆初落桥边。","迎门一笑嫣然。","今夜流霞共酌，何妨金盏垂莲。"],"s":"simp","f":"trad"},{"i":"c-247ddf98cae0","t":"清平乐","a":"蔡伸","d":"宋","g":"词","p":["明眸秀色。","肌理凝香雪。","罗绮丛中标韵别。","捧酒歌声清越。","不辞醉脸潮红。","却愁归骑匆匆。","回首绿窗朱户，断肠明月清风。"],"s":"simp","f":"trad"},{"i":"c-7a1638d405e5","t":"谒金门","a":"蔡伸","d":"宋","g":"词","p":["溪声咽。","溪上有人离别。","别语叮咛和泪说。","罗巾沾泪血。","尽做刚肠如铁。","到此也应愁绝。","回首断山帆影灭。","画船空载月。"],"s":"simp","f":"trad"},{"i":"c-4e5db78489e9","t":"谒金门","a":"蔡伸","d":"宋","g":"词","p":["相思切。","触目只供愁绝。","好梦惊回清漏咽。","烛残香穗结。","长恨南楼明月。","只解照人离缺。","同倚朱栏飞大白。","今宵风月别。"],"s":"simp","f":"trad"},{"i":"c-472db81f060a","t":"忆王孙","a":"蔡伸","d":"宋","g":"词","p":["凉生冰簟怯衣单。","明月楼高空画栏。","满院啼螀人未眠。","掩重关。","乌鹊南飞风露寒。"],"s":"simp","f":"trad"},{"i":"c-110413659934","t":"阮郎归","a":"蔡伸","d":"宋","g":"词","p":["烟笼寒水暝禽栖。","满庭红叶飞。","兰堂寂寂画帘垂。","霜浓更漏迟。","鸳被冷，麝香微。","强敧单枕时。","西窗看尽月痕移。","此情君怎知。"],"s":"simp","f":"trad"},{"i":"c-ace4ef131ecd","t":"柳梢青","a":"蔡伸","d":"宋","g":"词","p":["子规啼月。","幽衾梦断，销魂时节。","枕上斑斑，枝头点点，染成清血。","凄凉断雨残云，算此恨、文君更切。","老去情怀，春来况味，那禁离别。"],"s":"simp","f":"trad"},{"i":"c-54d5ac08ff97","t":"柳梢青","a":"蔡伸","d":"宋","g":"词","p":["联璧寻春，踏青尚意，年时携手。","此际重来，可怜还是，年时时候。","阴阴柳下人家，人面桃花似旧。","但原年年，春风有信，人心长久。"],"s":"simp","f":"trad"},{"i":"c-98e23e7c1519","t":"好事近","a":"蔡伸","d":"宋","g":"词","p":["花露滴香红，花低漏声初歇。","人似一枝梅瘦，照冰壶清彻。","翠娥云鬓为谁容，虫丝宝奁结。","可惜一春憔悴，负满怀风月。"],"s":"simp","f":"trad"},{"i":"c-3af8b0c4b9a8","t":"好事近","a":"蔡伸","d":"宋","g":"词","p":["十幅健帆风，天意巧催行客。","极目五湖云浪，泛满空秋色。","玉人应怪误佳期，凝恨正脉脉。","锦鳞为传尺素，报兰舟消息。"],"s":"simp","f":"trad"},{"i":"c-dd0db284888f","t":"卜算子","a":"蔡伸","d":"宋","g":"词","p":["风雨送春归，寂寞花空委。","枝上红稀地上多，万点随流水。","翠黛敛春愁，照影临清泚。","应念韶华惜蕣颜，洒遍胭脂泪。"],"s":"simp","f":"trad"},{"i":"c-ce45f1cb8887","t":"卜算子","a":"蔡伸","d":"宋","g":"词","p":["小阁枕清流，一霎莲塘雨。","风递幽香入槛来，枕簟全无暑。","遐想似花人，阅岁音尘阻。","物是人非空断肠，梦入芳洲路。"],"s":"simp","f":"trad"},{"i":"c-6743dbaaaaa2","t":"卜算子","a":"蔡伸","d":"宋","g":"词","p":["玉斧斫冰轮，中有乘鸾女。","鬓乱钗横襟袖凉，只恐轻飞举。","青冥缥缈间，自有吹箫侣。","不向巫山十二峰，朝暮为云雨。"],"s":"simp","f":"trad"},{"i":"c-1ad5a12435cd","t":"卜算子","a":"蔡伸","d":"宋","g":"词","p":["前度月圆时，月下相携手。","今夜天边月又圆，夜色如清昼。","风月浑依旧。","水馆空回首。","明夜归来试问伊，曾解思量否。"],"s":"simp","f":"trad"},{"i":"c-182189c81217","t":"卜算子","a":"蔡伸","d":"宋","g":"词","p":["重重雪外山，渺渺烟中路。","路转山横无尽愁，正是分携处。","望极锦中书，肠断鱼中素。","锦素沈沈两未期，鱼雁空相误。"],"s":"simp","f":"trad"},{"i":"c-21f86c3b8994","t":"卜算子","a":"蔡伸","d":"宋","g":"词","p":["春事付莺花，曾是莺花主。","醉拍春衫金缕衣，只向花间住。","密意君听取。","莫逐风来去。","若是真心待于飞，云里千条路。"],"s":"simp","f":"trad"},{"i":"c-c4383c7847a2","t":"小重山","a":"蔡伸","d":"宋","g":"词","p":["楼外江山展翠屏。","沈沈虹影畔，彩舟横。","一尊别酒为君倾。","留不住，风色太无情。","斜日半山明。","画栏重倚处，独销凝。","片帆回首在青冥。","人不见，千里暮云平。"],"s":"simp","f":"trad"},{"i":"c-10b0c2dcc5f8","t":"小重山","a":"蔡伸","d":"宋","g":"词","p":["澹澹秋容烟水寒。","楼高清夜永，倚阑干。","玉人不见坐长叹。","箫声远，明月满空山。","遐想绿云鬟。","青冥风露冷，独乘鸾。","别时容易见时难。","凭孤枕，聊复梦蝉娟。"],"s":"simp","f":"trad"},{"i":"c-b063f9af790e","t":"小重山","a":"蔡伸","d":"宋","g":"词","p":["流水桃花小洞天。","壶中春不老，胜尘寰。","霞衣鹤氅并桃冠。","新装好，风韵愈飘然。","功行满三千。","婴儿并姹女，炼成丹。","刘郎曾约共升仙。","十个月，养个小金坛。"],"s":"simp","f":"trad"},{"i":"c-80dc990ff66d","t":"小重山","a":"蔡伸","d":"宋","g":"词","p":["楼上风高翠袖寒。","碧云笼淡日，照阑干。","绿杨芳草恨绵绵。","长亭路，何处认征鞍。","晓镜懒重看。","鬓云堆凤髻，任阑珊。","鸾衾鸳枕小屏山。","人如玉，忍负一春闲。"],"s":"simp","f":"trad"},{"i":"c-a0671a85205d","t":"踏莎行","a":"蔡伸","d":"宋","g":"词","p":["佩解江皋，魂消南浦。","人生惟有别离苦。","别时容易见时难，算来却是无情语。","百计留君，留君不住。","留君不住君须去。","望君频问梦中来，免教肠断巫山雨。"],"s":"simp","f":"trad"},{"i":"c-7564da00db5d","t":"踏莎行","a":"蔡伸","d":"宋","g":"词","p":["如是我闻，金仙出世。","一超直入如来地。","慈悲方便济群生，端严妙相谁能比。","四众归依，悉皆欢喜。","有情同赴龙华会。","无忧帐里结良缘，麽诃修哩修修哩。"],"s":"mixed","f":"trad"},{"i":"c-c7178407fcd7","t":"踏莎行","a":"蔡伸","d":"宋","g":"词","p":["客里光阴，伤离情味。","玉觞未举心先醉。","临岐莫怪苦留连，樯乌转处人千里。","恨写新声，云笺密寄。","短封难尽心中事。","凭君看取纸痕斑，分明总是离人泪。"],"s":"simp","f":"trad"},{"i":"c-ccbc0ebd0e8f","t":"踏莎行","a":"蔡伸","d":"宋","g":"词","p":["落日归云，寒空断雁。","吴波浅淡山平远。","丹青写出在霜缣，佳人特地栽团扇。","渔艇孤烟，酒旗幽院。","些儿景趣君休羡。","五湖归去共扁舟，何如早早酬深愿。"],"s":"simp","f":"trad"},{"i":"c-2209a7186a68","t":"踏莎行","a":"蔡伸","d":"宋","g":"词","p":["水满青钱，烟滋翠葆。","残英满地无人扫。","先来羁思乱如云，无端更被春酲恼。","叠叠遥山，绵绵远道。","凭阑满目唯芳草。","莫惊青鬓点秋霜，卢郎已分愁中老。"],"s":"simp","f":"trad"},{"i":"c-5b552831dbb1","t":"踏莎行","a":"蔡伸","d":"宋","g":"词","p":["玉质孤高，天姿明慧。","了无一点尘凡气。","白莲空殿锁幽芳，亭亭独占秋光里。","一切见闻，不可思议。","我今有分亲瞻礼。","愿垂方便济众生，他时同赴龙华会。"],"s":"simp","f":"trad"},{"i":"c-9f8d4c01a26c","t":"定风波","a":"蔡伸","d":"宋","g":"词","p":["一曲骊歌酒一锺。","可怜分袂太匆匆。","百计留君留不住。","□去。","满川烟暝满帆风。","目断魂销人不见。","但见。","青山隐隐水浮空。","拟把一襟相忆泪。","试□。","云笺密洒付飞鸿。"],"s":"simp","f":"trad"},{"i":"c-e0154e087e01","t":"定风波","a":"蔡伸","d":"宋","g":"词","p":["老去情锺不自持。","篸花酌酒送春归。","玉貌冰姿人窈窕。","一笑。","清狂岂减少年时。","欲上香车俱脉脉，半帘花影月平西。","待得酒醒人已去。","凝伫。","断云残雨尽堪悲。"],"s":"mixed","f":"trad"},{"i":"c-d137bf46616a","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["水绕孤城，乱山深锁横江路。","帆归别浦。","苒苒兰皋暮。","人在天涯，雁背南云去。","空凝伫。","凤楼何处。","烟霭迷津渡。"],"s":"simp","f":"trad"},{"i":"c-45b41e543ff0","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["香雪飘零，暖风著柳笼丝雨。","恼人情绪。","春事还如许。","宝勒朱轮，共结寻芳侣。","东郊路。","乱红深处。","醉拍黄金缕。"],"s":"simp","f":"trad"},{"i":"c-5f3ab86d6e00","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["背壁灯残，卧听檐雨难成寐。","井梧飘坠。","历历蛩声细。","数尽更筹。","滴尽罗巾泪。","如何睡。","甫能得睡。","梦到相思地。"],"s":"simp","f":"trad"},{"i":"c-38709545661f","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["月缺花残，世间乐事难双美。","夜来相对。","把酒弹轻泪。","一点情锺，销尽英雄气。","樊笼外。","五湖烟水。","好作扁舟计。"],"s":"simp","f":"trad"},{"i":"c-1a62ca347829","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["玉笋持杯，敛红颦翠歌金缕。","彩鸳戢羽。","未免群鸡妒。","我为情多，愁听多情语。","君休诉。","两心坚固。","云里千条路。"],"s":"simp","f":"trad"},{"i":"c-ee504377f484","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["人面桃花，去年今日津亭见。","瑶琴锦荐。","一弄清商怨。","金日重来，不见如花面。","空肠断。","乱红千片。","流水天涯远。"],"s":"simp","f":"trad"},{"i":"c-188346170c70","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["梅雨初晴，画栏开遍忘忧草。","兰堂清窈。","高柳新蝉噪。","枕上芙蓉，如梦还惊觉。","匀妆了。","背人微笑。","风入玲珑罩。"],"s":"simp","f":"trad"},{"i":"c-63c4c8200b3a","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["帐外华灯，翠屏花影参差满。","锦衣香暖。","苦恨春宵短。","画角声中，云雨还轻散。","河桥畔。","月华如练。","回首成肠断。"],"s":"simp","f":"trad"},{"i":"c-881cc12d5cf6","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["绿萼冰花，数枝清影横疏牖。","玉肌清瘦。","夜久轻寒透。","忍使孤芳，攀折他人手。","人归后。","断肠回首。","只有香盈袖。"],"s":"simp","f":"trad"},{"i":"c-d2eea7eef910","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["解绂朝天，满城桃李繁阴市。","彩舟难驻。","忍听骊歌举。","协赞中兴，圣意方倾注。","从今去。","五云深处。","稳步沙堤路。"],"s":"simp","f":"trad"},{"i":"c-a838a625af56","t":"点绛唇","a":"蔡伸","d":"宋","g":"词","p":["云雨匆匆，洞房当日曾相遇。","暂来还去。","无计留春住。","宝瑟重调，静听莺弦语。","休轻负。","绮窗朱户。","好做风光主。"],"s":"simp","f":"trad"},{"i":"c-c678a1726d7a","t":"昭君怨","a":"蔡伸","d":"宋","g":"词","p":["一曲云和松响。","多少离愁心上。","寂寞掩屏帷。","泪沾衣。","最是销魂处。","夜夜绮窗风雨。","风雨伴愁眠。","夜如年。"],"s":"simp","f":"trad"},{"i":"c-1e2d11af2df7","t":"醉落魄・一斛珠","a":"蔡伸","d":"宋","g":"词","p":["波纹如縠。","池塘雨后添新绿。","海棠初绽红生肉。","双燕归来，还认旧巢宿。","凝情凭暖阑干曲。","新愁无限伤心目。","谁人月下吹横玉。","惊起鸳鸯，飞去自相逐。"],"s":"simp","f":"trad"},{"i":"c-2209a2cab539","t":"醉落魄・一斛珠","a":"蔡伸","d":"宋","g":"词","p":["霜华摇落。","亭亭皓月侵朱箔。","梦回敧枕听残角。","一片寒声，风送入寥廓。","眼前风月都如昨。","独眠无奈情怀恶。","凭肩携手于飞约。","料想人人，终是赋情薄。"],"s":"simp","f":"trad"},{"i":"c-f9b88413b017","t":"醉落魄・一斛珠","a":"蔡伸","d":"宋","g":"词","p":["明眸秀色。","双蛾巧画春山碧。","盈盈标韵倾瑶席。","一见尊前，宛是旧相识。","深期密语虽端的。","良宵无奈成轻掷。","忍教只恁空相忆。","得入手来，无限好则剧。"],"s":"simp","f":"trad"}]