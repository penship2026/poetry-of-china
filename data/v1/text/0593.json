[{"i":"c-e5938d26af15","t":"生查子","a":"赵老","d":"宋","g":"词","p":["金门一免时，离绪纷如缕。","想像切云高，晓日罗昏雾。","峨冠补衮人，不是无心处。","欲效贡公弹，衣钵知谁付。"],"s":"simp","f":"trad"},{"i":"c-ff7d2a5455c6","t":"生查子","a":"赵老","d":"宋","g":"词","p":["斜日下平川，楼角销霞缕。","摆尽浊尘缨，画栋萦非雾。","平生许子穷，今到知音处。","约伴玉簪游，好梦从天付。"],"s":"simp","f":"trad"},{"i":"c-d815d11a26d0","t":"南柯子・南歌子","a":"赵老","d":"宋","g":"词","p":["世上渊明酒，人间陆羽茶。","东山无妓有莲花。","隐隐仙家鸡犬、路非赊。","积霭犹张幕，轻雷似卷车。","要令长袖舞胡靴。","须是檐头新霁、鹊查查。"],"s":"simp","f":"trad"},{"i":"c-320cf31651f9","t":"南柯子・南歌子","a":"赵老","d":"宋","g":"词","p":["体质娟娟静，花纹细细装。","翠筠初得试新忙。","睡起鬓云撩乱、趣泉汤。","多病心常捧，新词字带香。","管教涂泽到云窗。","办下谢君言语、巧如簧。"],"s":"simp","f":"trad"},{"i":"c-e7c94c191996","t":"浣溪沙","a":"赵磻老","d":"宋","g":"词","p":["懒画娥眉倦整冠。","笋苞来点镜中鬟。","承恩容易报恩难。","鬒发未饶青箬笠，素鳞行簇水晶盘。","流觞元自不相干。"],"s":"simp","f":"trad"},{"i":"c-95625570baa8","t":"浣溪沙","a":"赵老","d":"宋","g":"词","p":["刘氏风流设此冠。","今谁将去伴珠鬟。","君家兄弟二俱难。","驰去请观流汗马，钓时休等烂银盘。","明朝吟咏有方干。"],"s":"simp","f":"trad"},{"i":"c-7fd9151bb5de","t":"瑞鹧鸪","a":"尤袤","d":"宋","g":"词","p":["梁溪西畔小桥东。","落叶纷纷水映空。","五夜客愁花片里，一年春事角声中。","歌残玉树人何在，舞破山香曲未终。","却忆孤山醉归路，马蹄香雪衬东风。"],"s":"simp","f":"trad"},{"i":"c-d4740dec8056","t":"瑞鹧鸪","a":"尤袤","d":"宋","g":"词","p":["两行芳蕊傍溪阴。","一笑嫣然抵万金。","火齐照林光灼灼，彤霞射水影沈沈。","晓妆无力胭脂重，春醉方酣酒晕深。","定自格高难著句，不应工部总无心。"],"s":"simp","f":"trad"},{"i":"c-3f5d7cbeb2f0","t":"阮郎归","a":"赵","d":"宋","g":"词","p":["留连春意晚花稠。","云疏雨未收。","新荷池面叶齐抽。","凉天醉碧楼。","能达理，有何愁。","心宽万事休。","人生还似水中沤。","金尊尽更酬。"],"s":"simp","f":"trad"},{"i":"c-5c65310b0a03","t":"忆少年","a":"谢懋","d":"宋","g":"词","p":["池塘绿遍，王孙芳草，依依斜日。","游丝卷晴昼，系东风无力。","蝶趁幽香蜂酿蜜。","秋千外、卧红堆碧。","心情费消遣，更梨花寒食。"],"s":"simp","f":"trad"},{"i":"c-08e601cc3fd9","t":"石州引・石州慢","a":"谢懋","d":"宋","g":"词","p":["日脚斜明，秋色半阴，人意凄楚。","飞雪特地凝愁，做弄晚来微雨。","谁家别院，舞困几叶霜红，西风送客闻砧杵。","鞭马出都门，正潮平洲渚。","无语。","匆匆短棹，满载离愁，片帆高举。","京洛红尘，因念几年羁旅。","浅颦轻笑，旧时风月逢迎，别来谁画双眉妩。","回首一销凝，望归鸿容与。"],"s":"simp","f":"trad"},{"i":"c-614920412f88","t":"洞仙歌","a":"谢懋","d":"宋","g":"词","p":["愁边雨细。","漠漠天如醉。","摇扬游丝晚风外。","酿轻寒、和暝色，花柳难胜，春自老，谁管啼红敛翠。","关情潜入夜，斜湿帘栊，几处挑灯耿无寐。","念阳台、当日事，好伴云来，因个甚、不入襄王梦里。","便添起、寒潮卷长江，又恐是离人，断肠清泪。"],"s":"simp","f":"trad"},{"i":"c-2e1a95ad0391","t":"杏花天","a":"谢懋","d":"宋","g":"词","p":["海棠枝上东风软。","荡霁色、烟光弄暖。","双双燕子归来晚。","零落红香过半。","琵琶泪搵青衫浅。","念事与、危肠易断。","馀酲未解扶头懒。","屏里潇湘梦远。"],"s":"mixed","f":"trad"},{"i":"c-4c21dbe50428","t":"画堂春","a":"谢懋","d":"宋","g":"词","p":["西风庭院雨垂垂。","黄花秋闰迟。","已凉天气未寒时。","才褪单衣。","睡起枕痕犹在，鬓松钗压云低。","玉奁重拂淡胭脂。","情入双眉。"],"s":"simp","f":"trad"},{"i":"c-eba41b7ce7c1","t":"武陵春","a":"谢懋","d":"宋","g":"词","p":["门掩东风人去后，愁损燕莺心。","一朵梅花淡有春。","粉黛不忺匀。","我亦青楼成倦客，风月强追寻。","莫把恩情做弄成。","容易学行云。"],"s":"simp","f":"trad"},{"i":"c-0f5930046725","t":"霜天晓角","a":"谢懋","d":"宋","g":"词","p":["绿云剪叶。","低护黄金屑。","占断花中声誉，香与韵、两清洁。","胜绝。","君听说。","是他来处别。","试看仙衣犹带，金庭露、玉阶月。"],"s":"simp","f":"trad"},{"i":"c-fa95cf34b111","t":"风流子","a":"谢懋","d":"宋","g":"词","p":["少年多行乐，方豪健、何处不嬉游。","记情逐艳波，暖香斜径，醉摇鞭影，扑絮青楼。","难忘是，笑歌偏婉娩，乡号得温柔。","娇雨娱云，旋宽衣带，剩风残月，都在眉头。","一成憔悴损，人惊怪，空自引镜堪羞。","谁念短封难托，征雁虚浮。","念夜寒灯火，懒寻前梦，满窗风雨，供断闲愁。","情到不堪言处，却悔风流。"],"s":"simp","f":"trad"},{"i":"c-12eaaccff327","t":"念奴娇","a":"谢懋","d":"宋","g":"词","p":["霁天湛碧。","正新凉风露，冰壶清彻。","河汉无声光练练，涌处银蟾孤绝。","岩桂香飘，井梧影转，冷浸官袍洁。","西厢往事，一帘清梦凄切。","肠断楚峡云归，尊前无绪，知有愁如发。","此夕常娥应也恨，冷落琼楼金阕。","禁漏迢迢，边鸿杳杳，幽意凭谁决。","阑干星斗，落梅三弄初阕。"],"s":"simp","f":"trad"},{"i":"c-bf7d3c5c3584","t":"鹊桥仙","a":"谢懋","d":"宋","g":"词","p":["钩帘借月，染云为幌，花面玉枝交映。","凉生河汉一天秋，问此会、今宵孰胜。","铜壶尚滴，烛龙已驾，泪浥西风不尽。","明朝乌鹊到人间，试说向、青楼薄幸。"],"s":"simp","f":"trad"},{"i":"c-68e57a6c117f","t":"解连环","a":"谢懋","d":"宋","g":"词","p":["雁空辽邈。","衬鱼鳞浪浅，护霜云薄。","念故人、千里音尘，正山月朦胧，水村依约。","见说瑶姬，拥十二、碧峰如削。","倚孤芳澹伫，冷笑岁华，可堪寂寞。","情多为谁瘦弱。","爱吹芗弄粉，斜搴珠箔。","自然林壑精神，想回首东风，万花羞落。","梦绕南楼，对皓月、忍思量著。","但销凝、夜阑酒醒，数声画角。"],"s":"simp","f":"trad"},{"i":"c-99519dc3f066","t":"蓦山溪","a":"谢懋","d":"宋","g":"词","p":["厌厌睡起，无限春情绪。","柳色借轻烟，尚瘦怯、东风倦舞。","海棠红皱，不奈晚来寒，帘半卷，日西沈，寂寞闲庭户。","飞雪无据。","化作冥濛雨。","愁里见春来，又只恐、愁催春去。","惜花人老，芳草梦凄迷，题欲遍，琐窗纱，总是伤春句。"],"s":"mixed","f":"trad"},{"i":"c-2e2944d49ff2","t":"风入松","a":"谢懋","d":"宋","g":"词","p":["老年长忆少年狂。","宿粉栖香。","自怜独得东君意，有三年、窥宋东墙。","笑无落花红影，醉眠芳草斜阳。","事随春梦去悠扬。","休去思量。","近来眼底无姚魏，有谁更、管领年芳。","换得河阳衰鬓，一帘烟雨梅黄。"],"s":"simp","f":"trad"},{"i":"c-7dddc1182e3a","t":"浪淘沙","a":"谢懋","d":"宋","g":"词","p":["黄道雨初乾。","霁霭空蟠。","东风杨柳碧毵毵。","燕子不归花有恨，小院春寒。","倦客亦何堪。","尘满征衫。","明朝野水几重山。","归梦已随芳草绿，先到江南。"],"s":"mixed","f":"trad"},{"i":"c-71b78b4d2d9f","t":"相见欢","a":"王质","d":"宋","g":"词","p":["霜花零落全稀。","不成飞。","寒水溶溶漾漾、软琉璃。","红未涌，青已露，白都晞。","□□□□沙暖、戏凫鷖。"],"s":"mixed","f":"trad"},{"i":"c-4fc70dfc191f","t":"长相思","a":"王质","d":"宋","g":"词","p":["红疏疏，紫疏疏。","可惜飘零著地铺。","春残心转孤。","莺相呼。","燕相呼。","楼下垂杨遮得乌。","倚阑人已无。"],"s":"simp","f":"trad"},{"i":"c-c55f78c2d56a","t":"长相思","a":"王质","d":"宋","g":"词","p":["山青青。","水青青。","两岸萧萧芦荻林。","水深村又深。","风泠泠。","露泠泠。","一叶扁舟深处横。","垂杨鸥不惊。"],"s":"simp","f":"trad"},{"i":"c-e785729d3dda","t":"生查子","a":"王质","d":"宋","g":"词","p":["见汝小溪湾，修竹连疏影。","林杪动风声，惊下毵毵粉。","见汝大江郊，高浪摇枯本。","飞雪密封枝，直到斜阳醒。"],"s":"simp","f":"trad"},{"i":"c-3a9c43392767","t":"杨柳枝","a":"王质","d":"宋","g":"词","p":["惯得娇云赶不开。","去还来。","淡光无可照楼台。","且停杯。","薄雨疏疏时几点，洒浮埃。","卖花未上担儿抬。","听他催。"],"s":"simp","f":"trad"},{"i":"c-e110f73465f1","t":"浣溪沙","a":"王质","d":"宋","g":"词","p":["何药能医肠九回。","榴莲不似蜀当归。","却簪征帽解戎衣。","泪下猿声巴峡里，眼荒鸥碛楚江涯。","梦魂只傍故人飞。"],"s":"simp","f":"trad"},{"i":"c-e43932e321c9","t":"浣溪沙","a":"王质","d":"宋","g":"词","p":["梦到江南梦却回。","梦归何处得身归。","故溪渌净看凫衣。","下到瞿唐春欲杪，桃花香浪渺无涯。","三台回望五云飞。"],"s":"simp","f":"trad"},{"i":"c-e1674311b8d7","t":"浣溪沙","a":"王质","d":"宋","g":"词","p":["征雁年来得几回。","春风无雁带书归。","故应春瘦减春衣。","花柳伤心经岁月，江湖无梦失津涯。","到家无树不红飞。"],"s":"simp","f":"trad"},{"i":"c-495a58b34ad3","t":"浣溪沙","a":"王质","d":"宋","g":"词","p":["细雨萧萧变作秋。","晚风杨柳冷飕飕。","无言有泪洒西楼。","眼共云山昏惨惨，心随烟水去悠悠。","一蓑一笠任孤舟。"],"s":"simp","f":"trad"},{"i":"c-294c41a94a75","t":"清平乐","a":"王质","d":"宋","g":"词","p":["江沙带湿。","莎露和烟泣。","落日欲低红未入。","悄悄暮峰凝立。","疏林秀色荒寒。","频频驻骑回看。","应是梧桐影下，秋风蹙碎眉山。"],"s":"simp","f":"trad"},{"i":"c-e2137ba0dfb6","t":"清平乐","a":"王质","d":"宋","g":"词","p":["断桥流水。","香满扶疏里。","忽见一枝明眼底。","人在山腰水尾。","梨花应梦纷纷。","征鸿叫断行云。","不见绿毛么凤，一方明月中庭。"],"s":"simp","f":"trad"},{"i":"c-c04ad88924ce","t":"清平乐","a":"王质","d":"宋","g":"词","p":["从来清瘦。","更被春僝僽。","瘦得花身无可有。","莫放隔帘风透。","一枝相映孤灯。","灯明不似花明。","细看横斜影下，如闻溪水泠泠。"],"s":"simp","f":"trad"},{"i":"c-deb9b0379d05","t":"眼儿媚","a":"王质","d":"宋","g":"词","p":["雨润梨花雪未乾。","犹自有春寒。","不如且住，清明寒食，数日之间。","想君行尽嘉陵水，我已下江南。","想看万里，时须片纸，各报平安。"],"s":"mixed","f":"trad"},{"i":"c-bf7d309987c0","t":"西江月","a":"王质","d":"宋","g":"词","p":["月斧修成腻玉，风斤琢碎轻冰。","主人无那寿杯深。","倩取花来唤醒。","舞罢绣裀凤蹙，饮阑画阁香凝。","试将花蕊数层层。","犹比长年不尽。"],"s":"simp","f":"trad"},{"i":"c-20c01817ed5c","t":"西江月","a":"王质","d":"宋","g":"词","p":["轻蜡细凝蜂蜜，薄罗深压鹅黄。","玉容纵不似何郎。","也在百花头上。","试看眉间一点，全如瓶里孤芳。","明年此日趁鹓行。","记取今朝胜赏。"],"s":"simp","f":"trad"},{"i":"c-c38c3a40ca90","t":"西江月","a":"王质","d":"宋","g":"词","p":["蹙蹙红中烟润，梢梢翠尾风斜。","闲轩幽树少啼鸦。","此处最宜君画。","望眼不知天阔，归心常恨山遮。","见君江浦到芦花。","意在琵琶亭下。"],"s":"simp","f":"trad"},{"i":"c-1f29e499e4df","t":"西江月","a":"王质","d":"宋","g":"词","p":["璧水桥边此客，金銮坡上何人。","沙场老马事无成。","泪湿青莹夹镜。","袖手烟霏小景，回头石岭空城。","乾坤遗恨渺难平。","目断塞鸿孤影。"],"s":"simp","f":"trad"},{"i":"c-db1dac5c66cf","t":"滴滴金","a":"王质","d":"宋","g":"词","p":["阴阴湿雾霜无汁。","江气逼、树声滴。","荒林只见夕阳入。","谁唤晚烟集。","渔翁犹把钓竿执。","蓑共笠、时时葺。","风刚浪猛早收拾。","天外暮云黑。"],"s":"simp","f":"trad"},{"i":"c-c036d43c4cf5","t":"燕归来・喜迁莺","a":"王质","d":"宋","g":"词","p":["拂拂春风入马啼。","□驻绿杨堤。","绿杨堤上乳莺啼。","声声怨、怨春归。","而今一似花流水，纵迹任东西。","利成名逐在何时。","早赢得、两分飞。"],"s":"simp","f":"trad"},{"i":"c-efa13f4c6721","t":"青门引・青门饮","a":"王质","d":"宋","g":"词","p":["寻遍江南麓。","只有斑斑野菊。","梅花不遇我心悲，一枝得见，便是一年足。","微香来自横冈竹。","飞度寒溪曲。","落路寻人借问，谢他指向深深谷。"],"s":"simp","f":"trad"},{"i":"c-1e248a604c9b","t":"鹧鸪天","a":"王质","d":"宋","g":"词","p":["空响萧萧似见呼。","溪昏树暗觉神孤。","微茫山路才通足，行到山深路亦无。","寻草浅，拣林疏。","虽疏无奈野藤粗。","春衫不管藤搊碎，可惜教花著地铺。"],"s":"simp","f":"trad"},{"i":"c-313af8df3082","t":"鹧鸪天","a":"王质","d":"宋","g":"词","p":["一只船儿任意飞。","眼前不管是和非。","鱼儿得了浑闲事，未得鱼儿未肯归。","全似懒，又如痴。","这些快活有谁知。","华堂只见灯花好，不见波平月上时。"],"s":"simp","f":"trad"},{"i":"c-9c9f45a7f065","t":"一斛珠","a":"王质","d":"宋","g":"词","p":["风流太守。","未春先试回春手。","天寒修竹斜阳后。","翠袖中间，忽有人红袖。","天香国色浓如酒。","且教青女休僝僽。","梅花元是群花首。","细细商量，只怕梅花瘦。"],"s":"simp","f":"trad"},{"i":"c-468e6db19f5c","t":"一斛珠","a":"王质","d":"宋","g":"词","p":["寒江凝碧。","是谁翦作梨花出。","花心犹带江痕湿。","轻注香腮，却是桃花色。","飞来飞去何曾密。","疏疏全似新相识。","横吹小弄梅花笛。","看你飘零，不似江南客。"],"s":"simp","f":"trad"},{"i":"c-04549d683ffb","t":"一斛珠","a":"王质","d":"宋","g":"词","p":["平塘玉立。","薄罗飞起层层碧。","人心不似花心密。","待要相逢，未必相逢得。","袜尘不动何曾湿。","芙蓉桥上曾相识。","橹声摇去江声急。","西北高楼，回首浮云隔。"],"s":"simp","f":"trad"},{"i":"c-4aa1506a2e21","t":"怨春郎","a":"王质","d":"宋","g":"词","p":["芦花已老。","蓼花已老。","江腹冲风，山头残照。","暮烟不辨栖鸥。","识归舟。","归舟照顾新洲阁。","惊波恶。","别拣深湾泊。","南津北泺，水村总没人家。","莽平沙。"],"s":"simp","f":"trad"},{"i":"c-53631ca28128","t":"虞美人","a":"王质","d":"宋","g":"词","p":["绿阴夹岸人家住。","桥上人来去。","行舟远远唤相应。","全似孤烟斜日、出阊门。","浪花拂拂侵沙觜。","直到垂杨底。","吴江虽有晚潮回。","未比合江亭下、水如飞。"],"s":"simp","f":"trad"},{"i":"c-bd019d9b1e81","t":"虞美人","a":"王质","d":"宋","g":"词","p":["翠阴融尽毵毵雪。","惨淡花明灭。","嫩沙拂拂涨痕添。","想见故溪、绿到草堂前。","夕阳红透樱桃粒。","掩映深沈碧。","成都事事似江南。","只是香衾、两处受春寒。"],"s":"mixed","f":"trad"},{"i":"c-82ae8aacc6ef","t":"临江仙","a":"王质","d":"宋","g":"词","p":["缥缈青宵云一握，太清群玉光中。","钧天声里拂香风。","紫皇低接手，稳步上层空。","雀扇徐开鸾影转，日高舞动蛟龙。","双瞻御座立昭容。","回班趋复道，环佩响丁东。"],"s":"simp","f":"trad"},{"i":"c-6f9c443aaf6c","t":"临江仙","a":"王质","d":"宋","g":"词","p":["千顷翠围遮绿净，菱花影落波中。","看看红锦漾清风。","此时催入觐，烟浪拍云空。","伫见觚棱栖宝爵，旌旗全仗飞龙。","赭黄一点现真容。","御麻宣未毕，云镜上天东。"],"s":"simp","f":"trad"},{"i":"c-1ebba03a7f93","t":"临江仙","a":"王质","d":"宋","g":"词","p":["曲水流觞修禊事，祓除洗净春愁。","举尊再拜寿君侯。","只今虚鼎足，好去作班头。","自古相门还出相，春旗小驻南州。","云孙将绍祖风流。","他时如见忆，江汉一渔舟。"],"s":"simp","f":"trad"},{"i":"c-47d51b87d7f4","t":"临江仙","a":"王质","d":"宋","g":"词","p":["八字山头来较晚，彩云未散南楼。","夕阳千丈映帘钩。","君侯如欲老，江水莫教流。","扇底清歌尘不动，胡床明月清秋。","天浆为浪玉为舟。","酒阑君便起。","归去立班头。"],"s":"simp","f":"trad"},{"i":"c-bcf2d073e874","t":"定风波","a":"王质","d":"宋","g":"词","p":["曲曲阑干曲曲池。","万红缭绕锦相围。","花到黄昏思欲睡。","休睡。","眼前都是好相知。","银烛转添花转好，人在，花深深处更相宜。","似此好花须爱惜。","休惜。","鬓边消得两三枝。"],"s":"simp","f":"trad"},{"i":"c-4c47df28b6b1","t":"定风波","a":"王质","d":"宋","g":"词","p":["问讯山东窦长卿。","苍苍云外且垂纶。","流水落花都莫问，等取，榆林沙月静边尘。","江面不如杯面阔，卷起，五湖烟浪入清尊。","醉倒投床君且睡，却怕，挑灯看剑忽伤神。"],"s":"simp","f":"trad"},{"i":"c-5a168def7cb6","t":"定风波","a":"王质","d":"宋","g":"词","p":["白璧黄金爵上卿。","紫宸殿下拜丝纶。","才出龙门开虎帐，但看，甲光如水夜如尘。","古古今今男子事，摇动，芙蓉旗影入金尊。","到得关河公事了，早去，白云堆里养精神。"],"s":"simp","f":"trad"},{"i":"c-52afdfafd34e","t":"苏幕遮","a":"王质","d":"宋","g":"词","p":["水风轻，吹不皱。","上下浮光，两镜光相就。","云锦摇香吹散酒。","细听清谈，玉屑津津嗽。","明月前，斜阳后。","竹露秋声，拂拂寒生袖。","掇取湖山聊入手。","紫阁黄扉，到了终须有。"],"s":"simp","f":"trad"},{"i":"c-773f02d6e97f","t":"苏幕遮","a":"王质","d":"宋","g":"词","p":["驿尘飞，天意紧。","香雪芝封，犹带吴泥润。","昨夜宝奁开玉镜。","一点西风，便觉寒秋近。","白苹洲，红蓼径。","风露凄清，快促黄金镫。","叠叠重重听好信。","掷了碧油幢，更掷双堂印。"],"s":"simp","f":"trad"},{"i":"c-d81f9534fe92","t":"南歌子","a":"张孝祥","d":"宋","g":"词","p":["人物羲皇上，诗名沈谢间。","漫郎元自谩为官。","醉眼瞢腾、只拟看湘山。","小隐今成趣，邻翁独往还。","野堂梅柳尚春寒。","且趁华灯、频泛酒船宽。"],"s":"simp","f":"trad"},{"i":"c-23fc49121306","t":"霜天晓角","a":"张孝祥","d":"宋","g":"词","p":["柳丝无力。","冉冉萦愁碧。","系我船儿不住，楚江上、晚风急。","棹歌休怨抑。","有人离恨极。","说与归期不远，刚不信、泪偷滴。"],"s":"simp","f":"trad"},{"i":"c-1de6efa06683","t":"生查子","a":"张孝祥","d":"宋","g":"词","p":["远山眉黛横，媚柳开青眼。","楼阁断霞明，帘幕春寒浅。","杯延玉漏迟，烛怕金刀剪。","明月忽飞来，花影和帘卷。"],"s":"simp","f":"trad"},{"i":"c-291e548b9d0f","t":"长相思","a":"张孝祥","d":"宋","g":"词","p":["小楼重。","下帘栊。","万点芳心绿间红。","秋千图画中。","草茸茸。","柳松松。","细卷玻璃水面风。","春寒依旧浓。"],"s":"simp","f":"trad"},{"i":"c-f5958a4892c6","t":"忆秦娥","a":"张孝祥","d":"宋","g":"词","p":["元宵节。","凤楼相对鳌山结。","鳌山结。","香尘随步，柳梢微月。","多情又把珠帘揭。","游人不放笙歌歇。","笙歌歇。","晓烟轻散，帝城宫阕。"],"s":"simp","f":"trad"},{"i":"c-c944de41baac","t":"苍梧谣・归字谣","a":"张孝祥","d":"宋","g":"词","p":["归。","十万人家儿样啼。","公归去，何日是来时。"],"s":"simp","f":"trad"},{"i":"c-44c04f81c77e","t":"苍梧谣・归字谣","a":"张孝祥","d":"宋","g":"词","p":["归。","猎猎薰风飐绣旗。","拦教住，重举送行杯。"],"s":"simp","f":"trad"},{"i":"c-e0209a0be8fd","t":"苍梧谣・归字谣","a":"张孝祥","d":"宋","g":"词","p":["归。","数得宣麻拜相时。","秋前后，公衮更莱衣。"],"s":"simp","f":"trad"},{"i":"c-e5a234d2f0ab","t":"水调歌头","a":"张孝祥","d":"宋","g":"词","p":["天上掌纶手，阃外折冲才。","发踪指示，平荡全楚息氛埃。","缓带轻裘多暇，燕寝森严兵卫，香篆几徘徊。","襦绔见歌咏，桃李藉栽培。","紫泥封，天笔润，日边来。","趣装入觐，行矣归去作盐梅。","祖帐不须遮道，看取眉间一点，喜气入尊罍。","此去沙堤路，平步上三台。"],"s":"simp","f":"trad"},{"i":"c-2d4fe9041547","t":"水调歌头","a":"张孝祥","d":"宋","g":"词","p":["客里送行客，常苦不胜情。","见公秣马东去，底事却欣欣。","不为青毡俯拾，自是公家旧物，何必更关心。","且喜谢安石，重起为苍生。","圣天子，方侧席，选豪英。","日边仍有知己，应剡荐章间。","好把文经武略，换取碧幢红旆，谈笑扫胡尘。","勋业在此举，莫厌短长亭。"],"s":"simp","f":"trad"},{"i":"c-511b1db2defc","t":"木兰花・玉楼春","a":"张孝祥","d":"宋","g":"词","p":["拥貔貅万骑，聚千里、铁衣寒。","正玉帐连云，油幢映日，飞箭天山。","锦城起方面重，对筹壶、尽日雅歌闲。","休遣沙场虏骑，尚馀匹马空还。","那看。","更值春残。","斟绿醑、对朱颜。","正宿雨催红，和风换翠，梅小香悭。","牙旗渐西去也，望梁州、故垒暮云间。","休使佳人敛黛，断肠低唱阳关。"],"s":"simp","f":"trad"},{"i":"c-bc6eca68c4b0","t":"雨中花・夜行船","a":"张孝祥","d":"宋","g":"词","p":["一舸凌风，斗酒酹江，翩然乘兴东游。","欲吐平生孤愤，壮气横秋。","浩荡锦囊诗卷，从容玉帐兵筹。","有当时桥下，取履仙翁，谈笑同舟。","先贤济世，偶耳功名，事成岂为封留。","何况我、君恩深重，欲报无由。","长望东南气王，从教西北云浮。","断鸿万里，不堪回首，赤县神州。"],"s":"simp","f":"trad"},{"i":"c-869902c73a2b","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["可意黄花人不知。","黄花标格世间稀。","园葵裛露迎朝日，槛菊迎霜媚夕霏。","芍药好，是金丝。","绿藤红刺引蔷薇。","姚家别有神仙品，似着天香染御衣。"],"s":"simp","f":"trad"},{"i":"c-4609bb653bf4","t":"眼儿媚","a":"张孝祥","d":"宋","g":"词","p":["晓来江上荻花秋。","做弄个离愁。","半竿残日，两行珠泪，一叶扁舟。","须知此去应难遇，直待醉方休。","如今眼底，明朝心上，后日眉头。"],"s":"simp","f":"trad"},{"i":"c-1e6b0b896c71","t":"虞美人","a":"张孝祥","d":"宋","g":"词","p":["清宫初入韶华管。","宫叶秋声满。","满庭芳草月婵娟。","想见明朝喜色、动天颜。","持杯满劝龙头客。","荣遇时难得。","词源三峡泻瞿塘。","便是醉中空去、也无妨。"],"s":"simp","f":"trad"},{"i":"c-6f267c3a0a9e","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["史君家枕吴波碧。","朱门铺手摇双戟。","也到岭边州。","真成汗漫游。","归期应不远。","趁得东江暖。","翁媪雪垂肩。","双双平地仙。"],"s":"simp","f":"trad"},{"i":"c-a00cf4e5ae7f","t":"临江仙","a":"张孝祥","d":"宋","g":"词","p":["罨画楼前初立马，隔帘笑语相亲。","铅华洗尽见天真。","衫儿轻罩雾，髻子直梳云。","翠叶银丝簪末利，樱桃澹住香唇。","见人不语解留人。","数杯愁里酒，两眼醉时春。"],"s":"simp","f":"trad"},{"i":"c-c015ea5595ec","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["我是临川旧史君。","而今欲作岭南人。","重来辽鹤事犹新。","去路政长仍酷暑，主公交契更情亲。","横秋阁上晚风匀。"],"s":"simp","f":"trad"},{"i":"c-7f38f622315e","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["康乐亭前种此君。","重来风月苦留人。","儿童竹马笑谈新。","今代孟士仍好客，政成归去眷方新。","十眉环坐晚妆匀。"],"s":"simp","f":"trad"},{"i":"c-2e653e79214a","t":"西江月","a":"张孝祥","d":"宋","g":"词","p":["十里轻红自笑，两山浓翠相呼。","意行着脚到精庐。","借我绳床小住。","解饮不妨文字，无心更狎鸥鱼。","一声长啸暮烟孤。","袖手西湖归去。"],"s":"simp","f":"trad"},{"i":"c-8b7f42e7e6cf","t":"忆秦娥","a":"张孝祥","d":"宋","g":"词","p":["天一角。","南枝向我情如昨。","情如昨。","水寒烟淡，雾轻云薄。","吹花嚼蕊愁无托。","年华冉冉惊离索。","惊离索。","倩春留住，莫教摇落。"],"s":"simp","f":"trad"},{"i":"c-9bb0c23f6851","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["湓浦从君已十年。","京江仍许借归船。","相逢此地有因缘。","十万貔貅环武帐，三千珠翠入歌筵。","功成去作地行仙。"],"s":"simp","f":"trad"},{"i":"c-aa8cd5a7d951","t":"柳梢青","a":"张孝祥","d":"宋","g":"词","p":["碧云风月无多。","莫被名缰利锁。","白玉为车，黄金作印，不恋休呵。","争如对酒当歌。","人是人非恁麽。","年少甘罗，老成吕望，必竟如何。"],"s":"mixed","f":"trad"},{"i":"c-850c0f186238","t":"卜算子","a":"张孝祥","d":"宋","g":"词","p":["万里去担簦，谁识新丰旅。","好事些儿说与郎，奴是姮娥侣。","若到广寒宫，但道奴传语。","待我仙郎折桂枝，拣个高枝与。"],"s":"simp","f":"trad"},{"i":"c-cbe680ad33b9","t":"柳梢青","a":"张孝祥","d":"宋","g":"词","p":["草底蛩吟。","烟横水际，月澹松阴。","荷动香浓，竹深凉早，销尽烦襟。","发稀浑不胜簪。","更客里、吴霜暗侵。","富贵功名，本来无意，何况如今。"],"s":"simp","f":"trad"},{"i":"c-f9f463a831a6","t":"瑞鹧鸪","a":"张孝祥","d":"宋","g":"词","p":["香佩潜分紫绣囊。","野塘波急折鸳鸯。","春风灞岸空回首，落日西陵更断肠。","雪下哦诗怜谢女，花间为令胜潘郎。","从今千里同明月，再约圜时拜夜香。"],"s":"simp","f":"trad"},{"i":"c-225c19e56ff3","t":"青玉案","a":"张孝祥","d":"宋","g":"词","p":["相春堂上闻莺语。","正花柳、芳菲处。","有底尊前欢且舞。","满堂宾客，紫泥丹诏，衮衮烟霄路。","君王天纵资仁武。","要尺箠、平骄虏。","思得英雄亲驾驭。","将军行矣，九重虚宁，谈笑清寰宇。"],"s":"simp","f":"trad"},{"i":"c-08bba982df6f","t":"念奴娇","a":"张孝祥","d":"宋","g":"词","p":["海云四敛，太清楼、极目一天秋色。","明月飞来云雾尽，城郭山川历历。","良夜悠悠，西风袅袅，银汉冰轮侧。","云霓三弄，广寒宫殿长笛。","偏照紫府瑶台，香笼玉座，翠霭迷南北。","天上人间凝望处，应有乘风归客。","露滴金盘，凉生玉宇，满地新霜白。","壶中清赏，画檐高挂虚碧。"],"s":"simp","f":"trad"},{"i":"c-1b9f54d476b2","t":"念奴娇","a":"张孝祥","d":"宋","g":"词","p":["风帆更起，望一天秋色，离愁无数。","明日重阳尊酒里，谁与黄花为主。","别岸风烟，孤舟灯火，今夕知何处。","不如江月，照伊清夜同去。","船过采石江边，望夫山下，酌水应怀古。","德耀归来虽富贵，忍弃平生荆布。","默想音容，遥怜儿女，独立衡皋暮。","桐乡君子，念予憔悴如许。"],"s":"simp","f":"trad"},{"i":"c-d7099606a4ea","t":"蓦山溪","a":"张孝祥","d":"宋","g":"词","p":["雄风豪雨，时节清明近。","帘幕起轻寒，暖红炉、笑翻灰烬。","阴藏迟日，欲验几多长，绣工慵，围棋倦，香篆频销印。","茂林芳径，绿变红添润。","桃杏意酣酣，占前头、一番花信。","华堂尊酒，但作艳阳歌，禽声喜，流云尽，明日春游俊。"],"s":"simp","f":"trad"},{"i":"c-d5d24416ad1a","t":"拾翠羽","a":"张孝祥","d":"宋","g":"词","p":["春入园林，花信总诸迟速。","听鸣禽、稍迁乔木。","夭桃弄色，海棠芬馥。","风雨霁，芳径草心频绿。","禊事才过，相次禁烟追逐。","想千岁、楚人遗俗。","青旗沽酒，各家炊熟。","良夜游，明月胜烧花烛。"],"s":"simp","f":"trad"},{"i":"c-b3b85cd6292e","t":"蝶恋花","a":"张孝祥","d":"宋","g":"词","p":["烂烂明霞红日暮。","艳艳轻云，皓月光初吐。","倾国倾城恨无语。","彩鸾祥凤来还去。","爱花常为花留住。","今岁风光，又是前春处。","醉倒扶归也休诉。","习池人笑山翁语。"],"s":"simp","f":"trad"},{"i":"c-8111d3338643","t":"渔家傲","a":"张孝祥","d":"宋","g":"词","p":["红白莲房生一处。","雪肌霞艳难为喻。","当是神仙来紫府。","双禀赋。","人间相见犹相妒。","清雨轻烟凝态度。","风标公子来幽鹭。","欲遣微波传尺素。","歌曲误。","醉中自有周郎顾。"],"s":"simp","f":"trad"},{"i":"c-206a6e1f6715","t":"夜游宫","a":"张孝祥","d":"宋","g":"词","p":["听话危亭句景。","芳郊迥、草长川永。","不待崇冈与峻岭。","倚栏杆，望无穷，心已领。","万事浮云影。","最旷阔、鹭闲鸥静。","好是炎天烟雨醒。","柳阴浓，芰荷香，风日冷。"],"s":"simp","f":"trad"},{"i":"c-69f9909065e6","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["桃换肌肤菊换妆。","只疑春色到重阳。","偷将天上千年艳，染却人间九日黄。","新艳冶，旧风光。","东篱分付武陵香。","尊前醉眼空相顾，错认陶潜是阮郎。"],"s":"simp","f":"trad"},{"i":"c-45a0ecaa66c7","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["人物风流册府仙。","谁教落魄到穷边。","独班未引甘泉伏，三峡先寻上水船。","斟楚酒，扣湘弦。","竹枝歌里意凄然。","明时合下清猿泪，闲日须题采凤笺。"],"s":"simp","f":"trad"},{"i":"c-50d5b62f5863","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["落霞残照横西阁。","阁西横照残霞落。","波浅戏鱼多。","多鱼戏浅波。","手携行客酒。","酒客行携手。","肠断九歌长。","长歌九断肠。"],"s":"simp","f":"trad"},{"i":"c-5cfe0fee35c4","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["渚莲红乱风翻雨。","雨翻风乱红莲渚。","深处宿幽禽。","禽幽宿处深。","澹妆秋水鉴。","鉴水秋妆澹。","明月思情人。","情人思月明。"],"s":"simp","f":"trad"},{"i":"c-60d23b98d866","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["晚花残雨风帘卷。","卷帘风雨残花晚。","双燕语虚窗。","窗虚语燕双。","睡醒风惬意。","意惬风醒睡。","谁与话情诗。","诗情话与谁。"],"s":"simp","f":"trad"},{"i":"c-51ef1853c8c2","t":"菩萨蛮","a":"张孝祥","d":"宋","g":"词","p":["白头人笑花间客。","客间花笑人头白。","年去似流川。","川流似去年。","老羞何事好。","好事何羞老。","红袖舞香风。","风香舞袖红。"],"s":"simp","f":"trad"}]