[{"i":"120d035d-c0b3-4ab5-bd40-62d9ed302149","t":"句 十一","a":"無名氏","d":"唐","g":"短诗","p":["青田未矯翰，丹穴欲乘風（一作「鳳」）。"],"s":"trad","f":"simp"},{"i":"50cd5366-e2ab-4f61-a73c-86d790602461","t":"句 十二","a":"無名氏","d":"唐","g":"短诗","p":["曲沼疏秋蓋，長林卷夏帷。"],"s":"trad","f":"simp"},{"i":"f2cbd220-6b72-448f-8f26-36ac394f7f8b","t":"句 十三","a":"無名氏","d":"唐","g":"短诗","p":["積翠徹（王利器疑當作「澈」）深潭，舒丹明淺瀨。","（以上三聯爲菁華體）（以上十三聯均見《文鏡秘府論》地卷《十體》引崔融《唐朝新定詩格》）（按：《十體》節共引詩二十一題，今可查知作者之作凡八題，分屬宋鮑照、齊王融、梁戴暠、陳江總、隋楊廣、孔德紹、虞世基、唐崔信明。","不知作者之作凡十三聯，當爲六朝至初唐人所作，惜已無從甄辨。","）。"],"s":"mixed","f":"simp"},{"i":"f650e7dd-ed7a-4754-9760-2d76fad50f3e","t":"繁說病詩","a":"無名氏","d":"唐","g":"短诗","p":["從風似飛絮，照日類繁英。","拂巖如寫鏡，封林若耀瓊。"],"s":"trad","f":"simp"},{"i":"27aaa47b-8c35-4d28-88d4-960dfc6729f3","t":"齟齬病詩 一","a":"無名氏","d":"唐","g":"短诗","p":["霧生極野碧，日下遠山紅。"],"s":"trad","f":"simp"},{"i":"4b8c59a5-ea78-4c2d-81cc-a223cfc34648","t":"齟齬病詩 二","a":"無名氏","d":"唐","g":"短诗","p":["晨風驚疊樹，曉月落危峰。"],"s":"trad","f":"simp"},{"i":"621e6d38-af51-4744-a046-1f50efb4db84","t":"叢木病詩","a":"無名氏","d":"唐","g":"短诗","p":["庭梢桂林樹，檐度蒼梧雲。","櫂唱喧難辨，樵歌近易聞。","（以上三題均見《文鏡秘府論》西卷《文二十八種病》引崔融《唐朝新定詩格》引）。"],"s":"mixed","f":"simp"},{"i":"94bf1153-a982-4c6f-a389-792a3b2aef46","t":"切側對詩","a":"無名氏","d":"唐","g":"短诗","p":["浮鐘宵響徹，飛鏡曉光斜。"],"s":"trad","f":"simp"},{"i":"346fd993-a1c5-4421-93b7-4e64d61be451","t":"雙聲側對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["花明金谷樹，葉映首山薇。"],"s":"trad","f":"simp"},{"i":"b54fec18-fbf3-4786-8526-41d9261e045c","t":"雙聲側對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["翠微分雉堞，丹氣隱簷楹。"],"s":"trad","f":"simp"},{"i":"1770c1b7-32cf-46bb-9e69-07bbc9692949","t":"疊韻側對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["平生披黼帳，窈窕步花庭。"],"s":"trad","f":"simp"},{"i":"9cc1b8bf-6127-42ae-bdd7-40d6ade57a61","t":"疊韻側對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["自得優遊趣，寧知聖政隆。","（以上三題均見《文鏡秘腐論》東卷《二十九種對》引崔融《唐朝新定詩格》）。"],"s":"trad","f":"simp"},{"i":"810f0b71-ecc2-43a4-a7ae-9f1c242c1372","t":"聲對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["彤騶初驚路，白簡未含霜。"],"s":"trad","f":"simp"},{"i":"ce6bfe31-1fe1-4bc0-94a2-58b8696f00f2","t":"聲對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["初禪韻高柳，密蔦掛深松。"],"s":"trad","f":"simp"},{"i":"54d1923c-3b9f-4388-a96d-043b68a51785","t":"字側對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["忘懷接英彥，申勸引桂酒。"],"s":"trad","f":"simp"},{"i":"bfdc2fdc-0219-452f-a411-28d228bd88bc","t":"字側對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["玉雞清五洛，瑞雉映三秦。"],"s":"trad","f":"simp"},{"i":"5d5e5be3-a65f-4447-b13a-a5a757bb1739","t":"字側對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["桓山分羽翼，荆樹折枝條。"],"s":"mixed","f":"simp"},{"i":"96f8ce59-1ad1-40b8-b06c-a4003f39687f","t":"字對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["山椒架寒霧，池篠韻涼飆。"],"s":"trad","f":"simp"},{"i":"812ba249-29ea-4bda-b7c8-7aa1127ed6ba","t":"字對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["何用金扉敞，終醉石崇家。"],"s":"trad","f":"simp"},{"i":"3373cecf-89a5-46db-825a-ccb5378a5651","t":"字對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["原風振平楚，野雪被長菅。","（均見《文鏡秘府論》東卷《二十九種對》，似出元兢《詩髓腦》）。"],"s":"trad","f":"simp"},{"i":"f6d290e3-a1c7-496a-90a7-111a46268782","t":"句 一","a":"無名氏","d":"唐","g":"短诗","p":["夜聞木葉落，疑是洞庭秋。"],"s":"trad","f":"simp"},{"i":"614c29a5-edde-427e-87b2-63e3edbf0ec6","t":"句 二","a":"無名氏","d":"唐","g":"短诗","p":["竹聲先知秋。"],"s":"trad","f":"simp"},{"i":"20d421b8-c1b1-442e-ba30-8d5baf4c5349","t":"句 三","a":"無名氏","d":"唐","g":"短诗","p":["綠（一作「流」）水溢金塘。"],"s":"trad","f":"simp"},{"i":"d1bfd98c-2bfc-42ce-8d48-1a7175f01045","t":"詩","a":"無名氏","d":"唐","g":"古体","p":["明月下山頭，天河橫戍樓。","白雲千萬里，滄江朝夕流。","浦沙望如雪，松風聽似秋。","不覺煙霞曙，花鳥亂芳洲。","（以上均見《文鏡秘府論》南卷《論文意》引王昌齡《詩格》）。"],"s":"mixed","f":"simp"},{"i":"749613d9-61a0-42bd-8bd1-38372b77d48d","t":"平頭詩 一","a":"無名氏","d":"唐","g":"短诗","p":["芳時淑氣清，提壺臺上傾。"],"s":"trad","f":"simp"},{"i":"afc990d6-76ef-4f35-95b2-05d83ea28b63","t":"平頭詩 二","a":"無名氏","d":"唐","g":"短诗","p":["山方翻類矩，波圓更若規。","樹表看猿掛，林側望熊馳。"],"s":"trad","f":"simp"},{"i":"71737b09-cd08-4ae3-8bfb-14b52349bcf4","t":"平頭詩 三","a":"無名氏","d":"唐","g":"短诗","p":["朝雲晦初景，丹池晚飛雪。","飄枝聚還散，吹楊凝且滅。"],"s":"trad","f":"simp"},{"i":"f7bbefbc-965e-43fd-8487-9920d79623ef","t":"上尾詩 一","a":"無名氏","d":"唐","g":"短诗","p":["可憐雙飛鳧，俱來下建章。","一個今依是，拂翮獨先翔。"],"s":"trad","f":"simp"},{"i":"cf07bc94-035c-450d-b690-d09e0bb2d0f6","t":"上尾詩 二","a":"無名氏","d":"唐","g":"短诗","p":["蕩子別倡樓，秋庭夜月華。","桂葉侵雲長，輕光逐漢斜。","。"],"s":"trad","f":"simp"},{"i":"0cdf1d37-9178-44ad-b196-5a0a651ec80e","t":"蜂腰詩","a":"無名氏","d":"唐","g":"短诗","p":["徐步金門出，言尋上苑春。"],"s":"trad","f":"simp"},{"i":"891f30a0-695f-4e65-b7d4-c934db04dcb6","t":"鶴膝詩 一","a":"無名氏","d":"唐","g":"短诗","p":["撥櫂金陵渚，遵流背城闕。","浪蹙飛船影，山掛垂輪月。"],"s":"trad","f":"simp"},{"i":"288df86b-aace-4ab5-bbc4-734b38a79861","t":"鶴膝詩 二","a":"無名氏","d":"唐","g":"短诗","p":["陟野看陽春，登樓望初節。","綠池始沾裳，弱蘭未央結。"],"s":"trad","f":"simp"},{"i":"9e7698e2-72e9-4d4a-bc79-a4a2277de9e3","t":"大韻詩","a":"無名氏","d":"唐","g":"短诗","p":["遊魚牽細藻，鳴琴哢好音。","誰知遲暮節，悲吟傷寸心。"],"s":"trad","f":"simp"},{"i":"56287b18-0829-4cfd-ba5d-5124ace1a910","t":"小韻詩 一","a":"無名氏","d":"唐","g":"短诗","p":["搴簾出戶望，霜花朝瀁日。","晨鶯傍杼飛，早燕挑（一作「排」）軒出。"],"s":"trad","f":"simp"},{"i":"5a7142b4-e78b-4a69-8488-4227d8ebc086","t":"小韻詩 二","a":"無名氏","d":"唐","g":"短诗","p":["夜中無與悟（一作「語」），獨寤撫躬歎。","唯慚一片月，流彩照南端。"],"s":"trad","f":"simp"},{"i":"a0242629-b2a0-45c0-a7a5-de81f9bee1b6","t":"傍紐詩 一","a":"無名氏","d":"唐","g":"短诗","p":["魚遊見風月，獸走畏傷蹄。"],"s":"trad","f":"simp"},{"i":"326fafae-5bd1-4820-bc84-4f37e478f321","t":"傍紐詩 二","a":"無名氏","d":"唐","g":"短诗","p":["元生愛皓月，阮氏願清風。","取樂情無已，賞玩未能同。"],"s":"trad","f":"simp"},{"i":"5e5e770e-232e-4fa1-bb48-7317ecd0f7a0","t":"傍紐詩 三","a":"無名氏","d":"唐","g":"短诗","p":["雲生遮麗月，波動亂遊魚。","涼風便入體，寒氣漸鑽膚。"],"s":"trad","f":"simp"},{"i":"844571c6-89df-4060-873a-54bc2d47c492","t":"正紐詩 一","a":"無名氏","d":"唐","g":"短诗","p":["撫琴起和曲，疊管泛鳴驅（王利器云：「疑當作『謳』」）。","停軒未忍去，白日小踟蹰。","。"],"s":"mixed","f":"simp"},{"i":"acc3e24f-bfe2-4e00-8ee4-be5df1b82659","t":"正紐詩 二","a":"無名氏","d":"唐","g":"短诗","p":["心中肝如割，腹（一作「腸」）裏氣便燋。","逢風迴無信，早雁轉成遙。"],"s":"mixed","f":"simp"},{"i":"336ac529-8750-4084-88df-8a576df986d1","t":"春詩 一","a":"無名氏","d":"唐","g":"短诗","p":["沼萍遍水纈，榆莢滿枝錢。"],"s":"trad","f":"simp"},{"i":"c57aa97e-e1c6-4a0b-a748-dd5b4670a256","t":"春詩 二","a":"無名氏","d":"唐","g":"短诗","p":["斜雲朝列陳，迴娥夜抱弦。","（二聯爲水渾病）。"],"s":"mixed","f":"simp"},{"i":"b5dd8ebf-dfcf-4077-a9d7-fb5690692a2e","t":"閨怨詩 一","a":"無名氏","d":"唐","g":"短诗","p":["塵暗離後鏡，帶永別前腰。"],"s":"trad","f":"simp"},{"i":"da11e559-7b9b-4051-8920-1cc901652d8e","t":"閨怨詩 二","a":"無名氏","d":"唐","g":"短诗","p":["怨心千過絕，啼眼百迴垂。","（二聯爲火滅病）。"],"s":"mixed","f":"simp"},{"i":"2d93a549-cc6a-43d0-850c-68101b65457a","t":"秋詩 一","a":"無名氏","d":"唐","g":"短诗","p":["金風晨泛菊，玉露宵沾蘭（一作「懸珠」）。"],"s":"trad","f":"simp"},{"i":"99b70640-cf37-4e98-b66b-2b7a205c604c","t":"秋詩 二","a":"無名氏","d":"唐","g":"短诗","p":["玉輪夜進轍，金車晝滅途。","（二聯爲木枯病）。"],"s":"mixed","f":"simp"},{"i":"e07bd050-ad50-4cd8-9e8b-f40964c39f40","t":"寒詩 一","a":"無名氏","d":"唐","g":"短诗","p":["獸炭陵晨送，魚燈徹宵燃。"],"s":"trad","f":"simp"},{"i":"166e3b3f-ba29-4ca4-8b8c-2b5e53dcf0b3","t":"寒詩 二","a":"無名氏","d":"唐","g":"短诗","p":["狐裘朝除冷，褻褥夜排寒。","（二聯爲金缺病）。"],"s":"mixed","f":"simp"},{"i":"549adcf4-e5ef-4894-9e2b-4dab53c4dccf","t":"述懷詩 一","a":"無名氏","d":"唐","g":"短诗","p":["鳴琴四五弄，桂酒復盈杯。"],"s":"trad","f":"simp"},{"i":"5b43c429-a3c4-40d9-8914-64ce148bd449","t":"述懷詩 二","a":"無名氏","d":"唐","g":"短诗","p":["夜夜憐琴酒，優遊足暢情。","（二聯爲闕偶病）。"],"s":"mixed","f":"simp"},{"i":"10a87876-8e41-47d4-abf0-fe73a20c66f9","t":"缺偶詩","a":"無名氏","d":"唐","g":"短诗","p":["蘇秦時刺股，勤學我便耽。"],"s":"trad","f":"simp"},{"i":"ad4f5d46-c052-4ded-8e5f-dcb427a908f9","t":"不缺偶詩","a":"無名氏","d":"唐","g":"短诗","p":["刺股君稱麗，懸頭我未能。"],"s":"trad","f":"simp"},{"i":"388d397a-1317-4662-8e12-0d32219020e3","t":"對酒詩 一","a":"無名氏","d":"唐","g":"短诗","p":["清觴酒恒滿，綠酒會盈杯。"],"s":"mixed","f":"simp"},{"i":"f1bcd338-1fe3-4b4f-aaf3-766b713cc41a","t":"對酒詩 二","a":"無名氏","d":"唐","g":"短诗","p":["滿酌余當進，彌甌我自傾。"],"s":"mixed","f":"simp"},{"i":"b9b7cfc2-bbf3-44e6-9dea-68c2d7491fce","t":"詩","a":"無名氏","d":"唐","g":"短诗","p":["遠岫開翠雰，遙山卷青靄。","（以上三聯爲繁說病）。"],"s":"mixed","f":"simp"},{"i":"b767e380-cf46-4284-b12f-b71f6a72014e","t":"不犯支離詩","a":"無名氏","d":"唐","g":"短诗","p":["春人對春酒，新樹間新花。"],"s":"trad","f":"simp"},{"i":"9190bb9e-83e2-4994-a15a-8b2e0805fca8","t":"犯支離詩","a":"無名氏","d":"唐","g":"短诗","p":["人人皆偃息，唯我獨從戎。"],"s":"trad","f":"simp"},{"i":"f064bae4-f724-4551-afe3-adee6c9a2b7f","t":"犯相濫詩","a":"無名氏","d":"唐","g":"短诗","p":["玉繩耿長漢，金波麗碧空。","星光暗雲裏，月影碎簾中。"],"s":"mixed","f":"simp"},{"i":"339d7d1c-0f1d-41d9-80ae-df6d53579f14","t":"詠月詩","a":"無名氏","d":"唐","g":"短诗","p":["玉鉤千丈掛，金波萬里遙。","蚌虧輪影滅，蓂落桂陰銷。","入風花氣馥，出樹鳥聲嬌。","獨使高樓婦，空度可憐宵。"],"s":"mixed","f":"simp"},{"i":"6da8444f-2257-4a2b-bd7f-0b31f7c0b3f4","t":"詠春詩","a":"無名氏","d":"唐","g":"短诗","p":["何處覓消愁？春園可暫遊。","菊黃堪泛酒，梅紅可插頭。","（以上二首爲落節詩）。"],"s":"mixed","f":"simp"},{"i":"40e00273-5e23-4322-8d48-ce5fa44712ae","t":"憶友詩","a":"無名氏","d":"唐","g":"短诗","p":["思君不可見，徒令年鬢秋。","獨驚積寒暑，迢遰阻風牛。","奧余慕樵隱，蕭然重一丘。","（此爲雜亂詩）。"],"s":"mixed","f":"simp"},{"i":"e472ac9c-835d-4e10-9eb6-246ce361ab8f","t":"秋詩","a":"無名氏","d":"唐","g":"短诗","p":["熠燿庭中度，蟋蟀傍窗吟。","條間垂白露，菊上帶黃金。"],"s":"trad","f":"simp"},{"i":"6f995887-e270-4c39-b4c2-18fe37938dcb","t":"詠秋詩","a":"無名氏","d":"唐","g":"短诗","p":["熠燿流寒火，蟋蟀動秋音。","凝露如懸玉，攢菊似披金。"],"s":"trad","f":"simp"},{"i":"2966f277-55d3-4dcf-b9d4-e9f304cb9f32","t":"句 一","a":"無名氏","d":"唐","g":"短诗","p":["渭濱迎宰相。"],"s":"trad","f":"simp"},{"i":"25675e4b-995b-4db1-aadc-ebabbf3fe810","t":"句 二","a":"無名氏","d":"唐","g":"短诗","p":["樹蔭逢歇馬，魚潭見洗船。"],"s":"trad","f":"simp"},{"i":"6b77be7f-c920-42a6-ae1b-16b1a4b08f19","t":"句 三","a":"無名氏","d":"唐","g":"短诗","p":["隔花遙勸酒，就水更移床。","（以上均爲文贅詩）。"],"s":"mixed","f":"simp"},{"i":"885d0dbf-f0a9-44a2-968e-0235d55341e0","t":"相反詩","a":"無名氏","d":"唐","g":"短诗","p":["晴雲開極野，積霧掩長洲。","。"],"s":"trad","f":"simp"},{"i":"38243641-3857-47b6-b0ca-b619813d81c8","t":"相重詩","a":"無名氏","d":"唐","g":"古体","p":["驅馬清渭濱，飛鑣犯夕塵。","川波張遠蓋，山日下遙輪。","柳葉眉行盡，桃花騎轉新。","（自《平頭詩》以下二十八題均見《文鏡秘府論》西卷《文二十八種病》）（按：《文二十八種病》節，爲弘法大師綜合劉善經、元兢、崔融及《文筆式》等諸家之說而成。","所引作品，可考知者有六朝及初唐人之作，多數爲作者無考之佚詩佚句。","今將可考知出某家著作所引者另錄，餘皆附於此，雖難定時代，爲六朝至初唐人作則無問題。","）。"],"s":"mixed","f":"simp"},{"i":"043b3f44-be78-492d-ba8a-3c7b17f6a8cc","t":"的名對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["東圃青梅發，西園綠草開。","砌下花徐去，階前絮緩來。"],"s":"trad","f":"simp"},{"i":"8ba5cf7d-9baa-439e-aa94-e03d9c3b0c59","t":"的名對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["手披黃卷盡，目送白雲征。","玉霜摧草色，金風斷雁聲。","片雲愁近戍，半月隱遙城。"],"s":"mixed","f":"simp"},{"i":"1600b923-6505-49c0-ae15-472e56194bdb","t":"的名對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["鮮光葉上動，艷彩花中出。","疏桐映蘭閣，密柳蓋荷池。"],"s":"trad","f":"simp"},{"i":"2459c3d8-9248-4c38-aa3e-b743bf8ffb67","t":"隔句對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["昨夜越溪難，含悲赴上蘭。","今朝逾嶺易，抱笑入長安。"],"s":"trad","f":"simp"},{"i":"578ab26a-89aa-4a2b-a6b5-bf246e302f75","t":"隔句對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["月映茱萸錦，艷起桃花頰。","風發蒲桃秀，香生雲母帖。"],"s":"trad","f":"simp"},{"i":"995f2d43-9ab3-4aeb-9cbe-bfd5b9ceb729","t":"隔句對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["翠苑翠峰外，單蜂拾蘂歸。","芳園芳樹裏，雙燕歷花飛。"],"s":"mixed","f":"simp"},{"i":"8b5e3a9c-1642-4d68-8c68-5e7c5825b3ef","t":"雙擬對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["夏暑夏不衰，秋陰秋未歸。","炎至炎難却，涼消涼易追。","。"],"s":"mixed","f":"simp"},{"i":"84d31dd4-99b3-4ec3-af25-cb5c075f6286","t":"雙擬對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["乍行乍理髮，或笑或看衣。"],"s":"trad","f":"simp"},{"i":"271f5b41-1538-4b08-b908-a7c1ef454794","t":"雙擬對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["結萼結花九，飛嵐飛葉始。"],"s":"trad","f":"simp"},{"i":"3e938bd4-e1c6-416c-a2f2-5a37c654169b","t":"聯綿對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["看山山已峻，望水水仍清。","聽蟬蟬響急，思鄉鄉別情。"],"s":"trad","f":"simp"},{"i":"fb153457-ea9c-48b9-8ad7-5f6dbc21721a","t":"聯綿對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["嫩荷荷似頰，淺河河似帶，初月月似眉。"],"s":"trad","f":"simp"},{"i":"e79d4560-e17a-4554-be3f-2a8d355acf0d","t":"聯綿對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["煙離離萬代，雨絕絕千年。"],"s":"trad","f":"simp"},{"i":"ad61b90c-ff6c-4af0-9c20-42ed9fb08094","t":"聯綿對詩 四","a":"無名氏","d":"唐","g":"短诗","p":["望日日已晚，懷人人不歸。"],"s":"trad","f":"simp"},{"i":"d53b3604-4500-4774-80cf-e9738dea69eb","t":"聯綿對詩 五","a":"無名氏","d":"唐","g":"短诗","p":["霏霏歛夕霧，赫赫吐晨曦。","軒軒多秀氣，奕奕有光儀。"],"s":"trad","f":"simp"},{"i":"51e397d6-b162-4dcc-8449-44ac66f1828c","t":"聯綿對詩 六","a":"無名氏","d":"唐","g":"短诗","p":["視日日將晚，望雲雲漸積。"],"s":"trad","f":"simp"},{"i":"bd1471a6-32ee-436b-8ab3-0ff1012d840c","t":"互成對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["天地心間靜，日月眼中明。","麟鳳千年貴，金銀一代榮。"],"s":"trad","f":"simp"},{"i":"cd0e8a04-7ad4-44c1-9433-a7f137a8e496","t":"互成對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["玉釵丹翠纏，象榻金銀鏤。","青㫙丹碧度，輕霧歷簷飛。"],"s":"trad","f":"simp"},{"i":"2f71c53e-7bb6-46ed-b7a3-670d9173c804","t":"互成對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["歲時傷道路，親友念東西。"],"s":"trad","f":"simp"},{"i":"0cb7439d-27ac-4f4a-95f8-5e4206b002b5","t":"異類對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["天清時雲外，山峻紫微中。","鳥飛隨去影，花落逐搖風。"],"s":"trad","f":"simp"},{"i":"5f0a15dd-5915-4999-a6b0-6fea8240498d","t":"異類對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["鯉躍排荷戲，燕舞拂泥飛。","琴上丹花拂，酒側黃鸝度。","。"],"s":"trad","f":"simp"},{"i":"81ce3a94-de36-4070-a426-cbabd1b6272f","t":"賦體對詩 一","a":"無名氏","d":"唐","g":"短诗","p":["褭褭樹驚風，麗麗雲蔽月。"],"s":"trad","f":"simp"},{"i":"e0181a8f-c786-4a0c-b848-3b94773e7371","t":"賦體對詩 二","a":"無名氏","d":"唐","g":"短诗","p":["皎皎夜蟬鳴，曬曬曉光發。","（二聯爲句首重字）。"],"s":"mixed","f":"simp"},{"i":"d85c24e0-08e9-4825-9bb9-9b3529359bac","t":"賦體對詩 三","a":"無名氏","d":"唐","g":"短诗","p":["漢月朝朝暗，胡風夜夜寒。","（句腹重字）。"],"s":"trad","f":"simp"},{"i":"2ca4f9be-f93d-4ac2-b9c9-b9382037a441","t":"賦體對詩 四","a":"無名氏","d":"唐","g":"短诗","p":["月蔽雲曬曬，風驚樹褭褭。","（句尾重字）。"],"s":"trad","f":"simp"},{"i":"8c93cb16-22fc-4c2b-8b6a-cec7984fa6c4","t":"賦體對詩 五","a":"無名氏","d":"唐","g":"短诗","p":["徘徊四顧望，悵悢獨心愁。","（句首疊韻）。"],"s":"trad","f":"simp"},{"i":"7cf8ca53-116f-444e-96ad-aec3068da345","t":"賦體對詩 六","a":"無名氏","d":"唐","g":"短诗","p":["君赴燕然戍，妾坐逍遙樓。","（句腹疊韻）。"],"s":"trad","f":"simp"},{"i":"4f74fd01-185a-4b77-bcab-4cde6b8f2598","t":"賦體對詩 七","a":"無名氏","d":"唐","g":"短诗","p":["疏雲雨滴瀝，薄霧樹朦朧。","（句尾疊韻）。"],"s":"trad","f":"simp"},{"i":"e0af3c61-83a6-4b7e-8d4f-a5552e1cf18e","t":"賦體對詩 八","a":"無名氏","d":"唐","g":"短诗","p":["留連千里賓，留待一年春。","（句首雙聲）。"],"s":"trad","f":"simp"},{"i":"0174d813-84db-41cb-b804-038a7d755164","t":"賦體對詩 九","a":"無名氏","d":"唐","g":"短诗","p":["我陟崎嶇嶺，君行嶢崅山。","（句腹雙聲）。"],"s":"trad","f":"simp"},{"i":"87fa38ce-a707-4f27-8e62-23d2027cbc32","t":"賦體對詩 十","a":"無名氏","d":"唐","g":"短诗","p":["妾意逐行雲，君身入暮門。","（句尾雙聲）。"],"s":"trad","f":"simp"},{"i":"e2f9f1f8-9938-4bc1-b35f-af084b90eb2e","t":"賦體對詩 十一","a":"無名氏","d":"唐","g":"短诗","p":["團團月掛嶺，納納（《文鏡秘府論校注》引日本密僧伽維寶《文鏡秘府論箋》云：「『納』疑當作『細』。","」）露沾衣。","（頭）。"],"s":"mixed","f":"simp"},{"i":"658f3430-4bec-45ec-8145-3d6a7f6d8b81","t":"賦體對詩 十二","a":"無名氏","d":"唐","g":"短诗","p":["花承滴滴露，風垂褭褭衣。","（腹）。"],"s":"trad","f":"simp"}]