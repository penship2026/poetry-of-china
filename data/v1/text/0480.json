[{"i":"6da05223-3b72-42fb-9658-38fdaec440ce","t":"又嘲","a":"無名氏","d":"唐","g":"短诗","p":["李生來，跋君怕。","不意今日却增價，不畫羅漢畫駝馬。"]},{"i":"44bc6d62-8d14-45e7-9d65-1ed935fb9419","t":"蜀選人嘲韓昭","a":"無名氏","d":"唐","g":"短诗","p":["嘉眉邛蜀，侍郎骨肉。","導江青城，侍郎情親。","果閬二州，侍郎自留。","巴蓬集壁，侍郎不識。"]},{"i":"40d7d764-f91d-4df8-ba85-df33d0541d65","t":"嘲傴僂人","a":"無名氏","d":"唐","g":"短诗","p":["拄杖欲似乃，播笏還似及。","逆風盪雨行，面乾頂額溼。","著衣牀上坐，肚緩脊皮急。","城門爾許高，故自匍匐入。"]},{"i":"8038ea3f-a055-4b6b-9bd0-0890a963906d","t":"曲中唱語","a":"無名氏","d":"唐","g":"短诗","p":["張公喫酒李公顛，盛六生兒鄭九憐。","舍下雄雞傷一德，南頭小鳳納三千。"]},{"i":"5c63464d-69b0-429a-ab53-36103c0b73a7","t":"改唱","a":"無名氏","d":"唐","g":"短诗","p":["張公喫酒李公顛，盛六生兒鄭九憐。","舍下雄雞失一足，街頭小福拉三拳。"]},{"i":"29d21c88-83d0-4fdb-b472-eb79ed7ab89f","t":"街中又唱","a":"無名氏","d":"唐","g":"短诗","p":["莫將龐大作荍團，龐大皮中的不乾。","不怕鳳皇當額打，更將雞脚用筋纏。"]},{"i":"ae73c78d-eb09-4f15-86c6-31b5830979ed","t":"吹火詩 一","a":"無名氏","d":"唐","g":"短诗","p":["吹火朱脣動，添薪玉腕斜。","遙看煙裏面，大似霧中花。"]},{"i":"9c79e8e7-0b15-4065-81bc-7363c8ebf2c4","t":"吹火詩 二","a":"無名氏","d":"唐","g":"短诗","p":["吹火青脣動，添薪黑腕斜。","遙看煙裏面，恰似鳩盤荼。"]},{"i":"2516272c-7d3f-400c-91a8-b8d995bab96b","t":"劉黑闥解嘲人語 一","a":"無名氏","d":"唐","g":"短诗","p":["水惡，頭如鎌杓尾如鑿，河裏搦魚無僻錯。"]},{"i":"9675ec54-ca70-4c0f-8acf-045d8c8f85c2","t":"劉黑闥解嘲人語 二","a":"無名氏","d":"唐","g":"短诗","p":["駱駝，項曲綠蹄，被他負物多。"]},{"i":"564634ff-045a-4be3-90db-9d99402787d1","t":"村人學解嘲人語","a":"無名氏","d":"唐","g":"短诗","p":["緜絹，割兩耳，只有面。"]},{"i":"b519377e-7d5e-4ecd-94c6-1f8254036ccc","t":"嘲劉師老","a":"無名氏","d":"唐","g":"短诗","p":["大府朝天升穆老，尚書倒地落劉郎。"]},{"i":"1fef721e-4cb9-437d-82de-131a272a0ca2","t":"嘲鄭薫","a":"無名氏","d":"唐","g":"短诗","p":["主司頭腦太冬烘，錯認顏標作魯公。"]},{"i":"1671bdf8-5039-41ec-bffb-40dc5eda4b08","t":"嘲蔣蟠金丹","a":"無名氏","d":"唐","g":"短诗","p":["張鵠只消千馱絹，蔣蟠惟用一丸丹。"]},{"i":"5198b618-4dcd-4c30-af3f-732476c12663","t":"注苗張二進士題名","a":"無名氏","d":"唐","g":"短诗","p":["一雙前進士，兩箇阿孩兒。"]},{"i":"adfe4786-20c0-42d3-87f9-104351ae2929","t":"袁州人謔彭伉","a":"無名氏","d":"唐","g":"短诗","p":["湛賁及第，彭伉落驢。"]},{"i":"dc07c340-a81b-4fdb-9f86-381dad6081d1","t":"洛中人語","a":"無名氏","d":"唐","g":"短诗","p":["昔樓師德園，今袁德師樓。"]},{"i":"98db2114-6d06-4715-b152-59705771eb38","t":"嘲毛炳彭會","a":"無名氏","d":"唐","g":"短诗","p":["彭生作賦茶三片，毛氏傳詩酒半升。"]},{"i":"d9ff621c-f53b-4ba2-b784-8d9bdd85845e","t":"右威衛嘲語","a":"無名氏","d":"唐","g":"短诗","p":["門緣御史塞，廳被校書侵。"]},{"i":"ccec185e-cbe6-4797-9523-5debbb8252dc","t":"南唐伶人獻先主詞","a":"無名氏","d":"唐","g":"短诗","p":["惟願普天多瑞慶，柳條結絮鵝雙生。"]},{"i":"7580f868-fbc8-4b48-bf03-0f3534700ddc","t":"閩伶官戲主延政語","a":"無名氏","d":"唐","g":"短诗","p":["只聞有泗州和尚，不見有五縣天子。"]},{"i":"4feab68b-4a3d-4a97-ab54-6100b5dfa08c","t":"言志","a":"無名氏","d":"唐","g":"短诗","p":["腰纏十萬貫，騎鶴上揚州。"]},{"i":"9209f946-c955-4693-bd46-750bffe36fae","t":"題洛陽縣壁","a":"李兼","d":"唐","g":"短诗","p":["猾吏畏服，縣妖破膽。","好錄政聲，聞於御覽。"]},{"i":"a8443bd6-5b54-4313-9e9d-3ceeac3329b0","t":"題書卷後語","a":"杜兼","d":"唐","g":"短诗","p":["倩俸寫來手自校，汝曹讀之知聖道，墜之鬻之爲不孝。"]},{"i":"e66a11bf-1cd1-488e-bd56-d04fd91bcdd4","t":"題李陽冰玉箸篆詞","a":"舒元輿","d":"唐","g":"古体","p":["斯去千年，冰生唐時。","冰復去矣，後來者誰。","後千年有人，誰來待之。","後千年無人，篆止於斯。","嗚呼主人，爲吾寶之。"]},{"i":"d31261bd-f276-46f4-98da-3b33e997b3bb","t":"判誤書紙背","a":"裴諝","d":"唐","g":"短诗","p":["這畔似那畔，那畔似這畔。","我也不辭與你判，笑殺門前著鞾漢。"]},{"i":"38c223e9-27da-4342-a0aa-13e57cbb758f","t":"又判爭貓兒狀","a":"裴諝","d":"唐","g":"短诗","p":["貓兒不識主，傍家搦老鼠。","兩家不須爭，將來與裴諝。"]},{"i":"a3e24873-d22c-4333-80dd-3dcc33378eec","t":"斷僧通狀","a":"李翱","d":"唐","g":"短诗","p":["上歲童子，二十受戒。","君王不朝，父母不拜。","口稱貧道，有錢放債。","量決十下，牒出東界。"]},{"i":"cc810091-de2b-4690-b53a-01e6d6a8c1d1","t":"判僧雲晏五人聚賭喧諍語","a":"韓滉","d":"唐","g":"短诗","p":["正法何曾執貝，空門不積餘財。","白日既能賭博，通宵必醉尊罍。","強說天堂難到，又言地獄長開。","竝付江神收管，波中便是泉臺。"]},{"i":"31478bee-8a3d-4f10-9cad-f107425159d0","t":"判道士黃山隱","a":"皇甫大夫","d":"唐","g":"短诗","p":["道士黃山隱，輕人復重財。","太山將比甑，東海只容杯。","綠綬藏雲帔，烏巾換鹿胎。","黃泉六箇鬼，今夜待君來。"]},{"i":"da8dc3ec-92fa-4a81-b1ed-c61be4034e18","t":"碾驢鞍判","a":"羅紹威","d":"唐","g":"短诗","p":["鄴城大道甚寬，何故駕車碾鞍。","領鞴驢漢子科決，待駕車漢子喜歡。"]},{"i":"de88950a-1521-4601-9299-28bc59e91c6a","t":"批州符","a":"蕭結","d":"唐","g":"短诗","p":["秧開五葉，蠶長三眠。","人皆忙迫，划甚閑船。"]},{"i":"a7641490-8a0a-477f-ba22-899956ca194f","t":"判部民訴主簿牒","a":"王魯","d":"唐","g":"短诗","p":["汝雖打草，吾已驚蛇。"]},{"i":"42f598a7-4bf4-406d-acb7-777db826b5b5","t":"戲爲冥吏判","a":"伶人","d":"唐","g":"短诗","p":["焦湖百里，一任作獺。"]},{"i":"c744e1ac-f7a5-4555-9259-2abe1cfe174b","t":"自狀","a":"張翱","d":"唐","g":"短诗","p":["有張翱兮，寓止淮陰。","來綺席兮，放恣胸襟。"]},{"i":"323ca1fe-a14b-4c9e-ae1d-cf47caff24e0","t":"刺左右膊詩","a":"趙武建","d":"唐","g":"短诗","p":["野鴨灘頭宿，朝朝被鶻梢。","忽驚飛入水，留命到今朝。"]},{"i":"5734785e-d2ac-4de7-98d5-d003460e8560","t":"刺左臂膊詩","a":"宋元素","d":"唐","g":"短诗","p":["昔日已前家未貧，苦將錢物結交親。","如今失路尋知己，行盡關山無一人。"]},{"i":"0beba024-21de-41e7-90d2-296710dae268","t":"刺左右膊句","a":"張幹","d":"唐","g":"短诗","p":["生不怕京兆尹，死不畏閻羅王。"]},{"i":"9f5e0ea5-f41a-4cd4-a777-62f9e909db06","t":"廉州人歌","a":"不詳","d":"唐","g":"短诗","p":["廉州顏有道，性行同莊老。","愛民如赤子，不殺非時草。"]},{"i":"f3ff3491-11de-4b09-a69a-87a928eaf626","t":"滄州百姓歌","a":"不詳","d":"唐","g":"短诗","p":["新河得通舟楫利，直達滄海魚鹽至。","昔日徒行今騁駟，美哉薛公德滂被。"]},{"i":"6f9d034e-c8a3-42dd-b925-5038877a8d83","t":"薛將軍歌","a":"不詳","d":"唐","g":"短诗","p":["將軍三箭定天山，戰士長歌入漢關。"]},{"i":"30a4a41c-c494-41ea-bddb-f93fedfb8eaa","t":"郢州人歌","a":"不詳","d":"唐","g":"短诗","p":["父母育我田使君，精神爲人上天聞。","田中致雨山出雲，但願常在不患貧。"]},{"i":"1ec01a6b-6def-4ba6-88ca-893c80e5d81b","t":"雒縣輿人誦","a":"不詳","d":"唐","g":"短诗","p":["我有聖帝撫令君，遭暴昏椽惸寡紛。","民戶流散日月曛，君去來兮惠我仁，百姓蘇矣見陽春。"]},{"i":"7e0c0f23-3184-4f95-b532-557ba6f1ec21","t":"黃麞歌","a":"不詳","d":"唐","g":"短诗","p":["黃麞黃麞草裏藏，彎弓射爾傷。"]},{"i":"45b14007-517b-4395-b605-6aa2c596bd45","t":"桑條歌","a":"不詳","d":"唐","g":"短诗","p":["桑條韋也，女時韋也樂。"]},{"i":"81e6b195-a2e8-4e80-891e-b6b639567a8c","t":"景龍中嘲宰相歌","a":"不詳","d":"唐","g":"短诗","p":["禮賢不解開東閣，燮理惟能閉北門。"]},{"i":"5e1c8c16-5f05-4061-851c-d3dc8495c1fb","t":"選人歌","a":"不詳","d":"唐","g":"短诗","p":["今年選數恰相當，都由座主無文章。","案後一腔凍豬肉，所以名爲姜侍郎。"]},{"i":"896aa8ec-e49e-48d0-9270-7d02200030b1","t":"魯城民歌","a":"不詳","d":"唐","g":"短诗","p":["魯地抑種稻，一概被水沫。","年年索蟹夫，百姓不可活。"]},{"i":"e9e71817-fe54-4513-a974-e30342a6a0d2","t":"王法曹歌","a":"不詳","d":"唐","g":"短诗","p":["前得尹佛子，後得王癩獺。","判事驢齩瓜，喚人牛嚼沫。","見錢滿面喜，無鏹從頭喝。","常逢餓夜叉，百姓不可活。"]},{"i":"90eafc7b-3e02-4a91-8b8a-8ba4e135a45a","t":"得体歌","a":"不詳","d":"唐","g":"短诗","p":["得体紇那也，紇囊得体那。","潭裏船車鬧，揚州銅器多。","三郎當殿坐，聽唱得体歌。"]},{"i":"dc2cf25b-c135-48a9-8554-7e6c125201e7","t":"得寶歌","a":"不詳","d":"唐","g":"短诗","p":["得寶耶，弘農耶。","弘農耶，得寶耶。"]},{"i":"b4829441-d859-4e16-840d-814c9d5487f4","t":"崔成甫飜得寶歌","a":"不詳","d":"唐","g":"短诗","p":["得寶弘農野，弘農得寶那。","潭裏船車鬧，揚州銅器多。","三郎當殿坐，聽唱得寶歌。"]},{"i":"d8b03efb-eb16-4b46-b900-22b27e17214b","t":"袁仁敬歌","a":"不詳","d":"唐","g":"短诗","p":["天不恤冤人兮，何奪我慈親兮。","有理無申兮，痛哉安訴陳兮。"]},{"i":"b2b4d1c9-9dcb-48b0-b9fe-fa9591ff4bc8","t":"京兆二尹歌","a":"不詳","d":"唐","g":"短诗","p":["前尹赫赫，具瞻允若。","後尹熙熙，具瞻允斯。"]},{"i":"773861bf-936b-4c1e-b448-347360f05cc2","t":"黃州左公歌","a":"不詳","d":"唐","g":"短诗","p":["我欲逃鄉里，我欲去墳墓。","左公今既來，誰忍棄之去。"]},{"i":"e614240c-957a-48ab-bbdd-b3896325e818","t":"又歌","a":"不詳","d":"唐","g":"短诗","p":["吾鄉有鬼巫，惑人人不知。","天子正尊信，左公能殺之。"]},{"i":"09cb80b0-0414-425b-a7a8-3e555fa7a622","t":"舒州人歌","a":"不詳","d":"唐","g":"短诗","p":["鄰邑谷不登，我土豐粢盛。","禾稼美如雲，實繫我使君。"]},{"i":"aae5d506-db9d-48df-a491-6d0be69ff50b","t":"建州人歌 一","a":"不詳","d":"唐","g":"短诗","p":["令我州郡泰，令我戶口裕。","令我活計大，陸員外。"]},{"i":"be8607c3-f3e3-4d88-bbf4-7e5262440aa7","t":"建州人歌 二","a":"不詳","d":"唐","g":"短诗","p":["令我家不分，令我馬成羣。","令我稻滿囷，陸使君。"]},{"i":"c1d178d6-2b66-4ad7-a582-f3edcbe16dc7","t":"吳人歌","a":"不詳","d":"唐","g":"短诗","p":["朝判長洲暮判吳，道不拾遺人不孤。"]},{"i":"5e33a3f4-3de4-49d9-aabe-a6ef5eff7871","t":"汴州人歌 一","a":"不詳","d":"唐","g":"短诗","p":["濁流洋洋，有闢其郛。","闐道歡呼，公來之初。","今公之歸，公在喪車。"]},{"i":"a5e9ef55-de31-444e-8009-1c14ee7696ad","t":"汴州人歌 二","a":"不詳","d":"唐","g":"短诗","p":["公既來止，東人以完。","今公歿矣，人誰與安。"]},{"i":"ea104cad-fd33-4747-a9be-258e5216a8be","t":"建昌民歌","a":"不詳","d":"唐","g":"短诗","p":["我有父，何易于。","昔無儲，今有餘。"]},{"i":"476730d9-bec6-4649-b20b-e79c48f272b2","t":"巴州薛刺史歌","a":"不詳","d":"唐","g":"短诗","p":["日出而耕，日入而歸。","吏不到門，夜不掩扉。","有孩有童，願以名垂。","何以字之，薛孫薛兒。"]},{"i":"1dab8453-d93d-4c64-809d-1d2310ee9d97","t":"高苑令歌","a":"不詳","d":"唐","g":"短诗","p":["高苑之樹枯已榮，淄川之水渾已澄，鄒邑之民仆已行。"]},{"i":"8db84576-ab49-46c2-8d6e-af645456df88","t":"九龍帳歌","a":"不詳","d":"唐","g":"短诗","p":["誰謂九龍帳，惟貯一歸郎。"]},{"i":"b1a33c6f-9e44-426e-bee5-b6c5b638f215","t":"僞蜀鴛鴦樹歌","a":"不詳","d":"唐","g":"短诗","p":["願作墳上鴛鴦，來作雙飛，去作雙歸。"]},{"i":"f