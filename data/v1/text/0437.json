[{"i":"eeb4c966-5e88-4788-8764-4181d8a30ffa","t":"懷遠","a":"廉氏","d":"唐","g":"短诗","p":["隟塵何微微，朝夕通其輝。","人生各有託，君去獨不歸。","青林有蟬響，赤日無鳥飛。","裴回東南望，雙淚空霑衣。"],"s":"trad","f":"simp"},{"i":"5849d3ad-78b6-4993-8282-6fc8a82c09e0","t":"寄征人","a":"廉氏","d":"唐","g":"短诗","p":["淒淒北風吹鴛被，娟娟西月生蛾眉。","誰知獨夜相思處，淚滴寒塘蕙草時。"],"s":"mixed","f":"simp"},{"i":"9820b8b8-cd3f-4f5a-8c00-44a17c5e7327","t":"寄遠","a":"田娥","d":"唐","g":"短诗","p":["憶昨會詩酒，終日相逢迎。","今來成故事，歲月令人驚。","淚流紅粉薄，風度羅衣輕。","難爲子猷志，虛負文君名。"],"s":"mixed","f":"simp"},{"i":"5d9d9ede-c866-4998-a3ad-56b555fda913","t":"攜手曲","a":"田娥","d":"唐","g":"短诗","p":["攜手共惜芳菲節，鶯啼錦花滿城闕。","行樂逶迤念容色，色衰秪恐君恩歇。","鳳笙龍管白日陰，盈虧自感青天月。"],"s":"trad","f":"simp"},{"i":"c4cb36e5-ee18-4734-96bd-bdccb2fee3b1","t":"長信宮","a":"田娥","d":"唐","g":"短诗","p":["團圓手中扇，昔爲君所持。","今日君棄捐，復值秋風時。","悲將入篋笥，自歎知何爲。"],"s":"mixed","f":"simp"},{"i":"b974b7b2-1ab0-4f2f-9edb-4f5660769962","t":"句","a":"田娥","d":"唐","g":"短诗","p":["春至偏無興，秋來秪是眠。"],"s":"trad","f":"simp"},{"i":"ab994ff1-9f7f-40d8-af58-7966593e7c08","t":"中秋夜泊武昌","a":"劉淑柔","d":"唐","g":"短诗","p":["兩城相對峙，一水向東流。","今夜素娥月，何年黃鶴樓。","悠悠蘭棹晚，渺渺荻花秋。","無奈柔腸斷，關山總是愁。"],"s":"trad","f":"simp"},{"i":"8835ee02-a5ec-4f9c-b812-e2d9d373607c","t":"賦荆門","a":"薛瓊","d":"唐","g":"短诗","p":["黃鳥翻紅樹，青牛臥綠苔。","渚宮歌舞地，輕霧鎖樓臺。"],"s":"mixed","f":"simp"},{"i":"db8979f4-2816-450f-8c0d-f42aa28489b2","t":"戲贈","a":"趙虛舟","d":"唐","g":"短诗","p":["砌下梧桐葉正齊，花繁雨後壓枝低。","報道不須鵶鳥亂，他家自有鳳凰棲。"],"s":"trad","f":"simp"},{"i":"ae42fd73-831d-4411-919e-0fc62a2218b0","t":"銅雀臺","a":"張瑛","d":"唐","g":"短诗","p":["君王冥漠不可見，銅雀歌舞空裴回。","西陵嘖嘖悲宿鳥，高殿沈沈閉青苔。","青苔無人跡，紅粉空相哀。"],"s":"trad","f":"simp"},{"i":"39862216-ed03-4c0f-9d5f-6e8745f0dd67","t":"望月","a":"張瑛","d":"唐","g":"短诗","p":["天漢涼秋夜，澄澄一鏡明。","山空猨屢嘯，林靜鶴頻驚。"],"s":"trad","f":"simp"},{"i":"691c2c25-fefa-4a1b-8976-1e51bb881ab4","t":"荅外","a":"長孫佐轉妻","d":"唐","g":"古体","p":["征人去年戍邊水，夜得邊書字盈紙。","揮刀就燭裁紅綺，結作同心荅千里。","君寄邊書書莫絕，妾荅同心心自結。","同心再解不心離，離字頻看字愁滅。","結成一衣和淚封，封書只在懷袖中。","莫如書故字難久，願學同心長可同。"],"s":"mixed","f":"simp"},{"i":"05f044ce-6285-45b0-916a-10849d942b1b","t":"早梅","a":"劉元載妻","d":"唐","g":"短诗","p":["南枝向暖北枝寒，一種春風有兩般。","憑仗高樓莫吹笛，大家留取倚闌干。"],"s":"mixed","f":"simp"},{"i":"eb2b878b-df90-4d93-8cb0-590dd31e1453","t":"明月堂 一","a":"劉氏婦","d":"唐","g":"短诗","p":["蟬鬢驚秋華髮新，可憐紅隙盡埃塵。","西山一夢何年覺，明月堂前不見人。"],"s":"trad","f":"simp"},{"i":"cabfa0f5-1f99-47b2-b9e5-047fd7ff7657","t":"明月堂 二","a":"劉氏婦","d":"唐","g":"短诗","p":["玉鉤風急響丁東，回首西山似夢中。","明月堂前人不到，庭梧一夜老秋風。"],"s":"trad","f":"simp"},{"i":"92556558-bf3f-4720-888b-78a4a0c5e634","t":"和潘雍","a":"葛氏女","d":"唐","g":"短诗","p":["九天天遠瑞煙濃，駕鶴驂鸞意已同。","從此三山山上月，瓊花開處照春風。"],"s":"trad","f":"simp"},{"i":"99654625-2d53-4cb0-9bf6-83c88b781506","t":"寄詩","a":"李主簿姬","d":"唐","g":"短诗","p":["去時盟約與心違，秋日離家春不歸。","應是維揚風景好，恣情歡笑到芳菲。"],"s":"trad","f":"simp"},{"i":"5aa2d13b-6f5a-4a95-b875-0998ec6f9fc4","t":"題興元明珠亭","a":"京兆女子","d":"唐","g":"短诗","p":["寂寥滿地落花紅，獨有離人萬恨中。","回首池塘更無語，手彈珠淚與春風。"],"s":"trad","f":"simp"},{"i":"802382ff-a138-439a-99c2-5697ae2ef2f4","t":"題玉泉溪","a":"湘驛女子","d":"唐","g":"短诗","p":["紅葉醉秋色，碧溪彈夜弦。","佳期不可再，風雨杳如年。"],"s":"trad","f":"simp"},{"i":"43597c78-90ae-45d4-90d7-206258606649","t":"題三鄉詩","a":"若耶溪女子","d":"唐","g":"短诗","p":["昔逐良人西入關，良人身歿妾空還。","謝娘衛女不相待，爲雨爲雲歸此山。"],"s":"mixed","f":"simp"},{"i":"4ad62f19-486f-4c9e-aedb-2839b134bd27","t":"題沙鹿門","a":"誰氏女","d":"唐","g":"短诗","p":["昔逐良人去上京，良人身歿妾東征。","同來不得同歸去，永負朝雲暮雨情。"],"s":"mixed","f":"simp"},{"i":"a14f739c-f704-4690-bc56-3d64a436d84a","t":"聯句","a":"光\t威\t裒","d":"唐","g":"古体","p":["朱樓影直日當午，玉樹陰低月已三。","膩粉暗銷銀鏤合，錯刀閑翦泥金衫。","繡牀怕引烏龍吠，錦字愁教青鳥銜。","百味鍊來憐益母，千花開處鬬宜男。","鴛鴦有伴誰能羨，鸚鵡無言我自慚。","浪喜游蜂飛撲撲，佯驚孤燕語喃喃。","偏憐愛數螆蛦掌，每憶光抽玳瑁簪。","煙洞幾年悲尚在，星橋一夕帳空含。","窗前時節羞虛擲，世上風流笑苦諳。","獨結香綃偷餉送，暗垂檀袖學通參。","須知化石心難定，却是爲雲分易甘。","看見風光零落盡，弦聲猶逐望江南。"],"s":"mixed","f":"simp"},{"i":"1d939efa-882f-4309-a6d1-e308c20efafb","t":"聯句","a":"越溪楊女","d":"唐","g":"短诗","p":["珠簾半牀月，青竹滿林風。","何事今宵景，無人解語同。"],"s":"mixed","f":"simp"},{"i":"c5851073-c8d2-4767-9aa4-368b0ddf5241","t":"春日","a":"越溪楊女","d":"唐","g":"短诗","p":["春盡花隨盡，其如自是花。","從來說花意，不過此容華。","明月易虧輪，好花難戀春。","常將花月恨，幷作可憐人。"],"s":"trad","f":"simp"},{"i":"cdd65817-92c0-418b-b438-ae8a2191bfde","t":"句","a":"曹文姬","d":"唐","g":"短诗","p":["鑿開天外長生地，煉出人間不死丹。"],"s":"trad","f":"simp"},{"i":"ff3fa1e4-a19d-4174-a3a2-df0cc4d92e6f","t":"燕子樓三首 一","a":"關盼盼","d":"唐","g":"短诗","p":["樓上殘燈伴曉霜，獨眠人起合歡牀。","相思一夜情多少，地角天涯不是長。"],"s":"mixed","f":"simp"},{"i":"ac228bec-b314-4f29-9055-f6a7656826cc","t":"燕子樓三首 二","a":"關盼盼","d":"唐","g":"短诗","p":["北邙松柏鎖愁煙，燕子樓中思悄然。","自埋劒履歌塵散，紅袖香銷一十年。"],"s":"trad","f":"simp"},{"i":"90de0390-09b6-4600-93f9-785b76ad77bb","t":"燕子樓三首 三","a":"關盼盼","d":"唐","g":"短诗","p":["適看鴻雁岳陽迴，又覩玄禽逼社來。","瑤瑟玉簫無意緒，任從蛛網任從灰。"],"s":"mixed","f":"simp"},{"i":"2a0a4812-c838-4110-aaed-21557ce2cc49","t":"和白公詩","a":"關盼盼","d":"唐","g":"短诗","p":["自守空樓斂恨眉，形同春後牡丹枝。","舍人不會人深意，訝道泉臺不去隨。"],"s":"trad","f":"simp"},{"i":"0d13dcd5-c6c6-4bf8-92fd-b2e2aee78e3b","t":"句","a":"關盼盼","d":"唐","g":"短诗","p":["兒童不識沖天物，漫把青泥污雪毫。"],"s":"mixed","f":"simp"},{"i":"e858f015-2cf5-420c-870a-621f1e85dd2c","t":"囉嗊曲六首 一","a":"劉采春","d":"唐","g":"短诗","p":["不喜秦淮水，生憎江上船。","載兒夫壻去，經歲又經年。"],"s":"mixed","f":"simp"},{"i":"c693bf0e-7b67-4502-a0b6-19753aa799bb","t":"囉嗊曲六首 二","a":"劉采春","d":"唐","g":"短诗","p":["借問東園柳，枯來得幾年。","自無枝葉分，莫怨太陽偏。"],"s":"mixed","f":"simp"},{"i":"a2a74af8-d559-4941-80f0-1b7d3c427f52","t":"囉嗊曲六首 三","a":"劉采春","d":"唐","g":"短诗","p":["莫作商人婦，金釵當卜錢。","朝朝江口望，錯認幾人船。"],"s":"mixed","f":"simp"},{"i":"3f3b5d49-4baf-4326-b9f7-8ca654d0c3f9","t":"囉嗊曲六首 四","a":"劉采春","d":"唐","g":"短诗","p":["那年離別日，只道住桐廬。","桐廬人不見，今得廣州書。"],"s":"mixed","f":"simp"},{"i":"80f7584f-ac84-40ce-b4ec-86e8edbb9637","t":"囉嗊曲六首 五","a":"劉采春","d":"唐","g":"短诗","p":["昨日勝今日，今年老去年。","黃河清有日，白髮黑無緣。"],"s":"mixed","f":"simp"},{"i":"5b3b6c87-dfbf-47d5-8b47-ff210190740e","t":"囉嗊曲六首 六","a":"劉采春","d":"唐","g":"短诗","p":["昨日北風寒，牽船浦裏安。","潮來打纜斷，搖櫓始知難。"],"s":"mixed","f":"simp"},{"i":"daa34fe1-59ef-4a15-8c16-882b758d5e06","t":"寄歐陽詹","a":"太原妓","d":"唐","g":"短诗","p":["自從別後減容光，半是思郎半恨郎。","欲識舊來雲髻樣，爲奴開取縷金箱。"],"s":"mixed","f":"simp"},{"i":"dfef5c19-8a9c-4c05-be51-d24cb2c1ce76","t":"續韋蟾句","a":"武昌妓","d":"唐","g":"短诗","p":["悲莫悲兮生別離，登山臨水送將歸。","武昌無限新栽柳，不見楊花撲面飛。"],"s":"trad","f":"simp"},{"i":"aef49398-d683-436d-9884-3145cfb7f8a8","t":"獻李觀察","a":"舞柘枝女","d":"唐","g":"短诗","p":["湘江舞罷忽成悲，便脫蠻靴出絳帷。","誰是蔡邕琴酒客，魏公懷舊嫁文姬。"],"s":"trad","f":"simp"},{"i":"13ca1660-45c6-4d77-81a1-8e6d98d0f75b","t":"贈盧夫人","a":"常浩","d":"唐","g":"短诗","p":["佳人惜顏色，恐逐芳菲歇。","日暮出畫堂，下堦拜新月。","拜月如有詞，傍人那得知。","歸來投玉枕，始覺淚痕垂。"],"s":"trad","f":"simp"},{"i":"42213986-9ad5-4b3a-bbe9-38f1aaf69cc8","t":"寄遠","a":"常浩","d":"唐","g":"古体","p":["年年二月時，十年期別期。","春風不知信，軒蓋獨遲遲。","今日無端捲珠箔，始見庭花復零落。","人心一往不復歸，歲月來時未嘗錯。","可憐熒熒玉鏡臺，塵飛冪冪幾時開。","却念容華非昔好，畫眉猶自待君來。"],"s":"mixed","f":"simp"},{"i":"574c4ef0-3e5f-402e-9663-c34a9e871094","t":"送武補闕","a":"襄陽妓","d":"唐","g":"短诗","p":["弄珠灘上欲銷魂，獨把離懷寄酒尊。","無限煙花不留意，忍教芳草怨王孫。"],"s":"trad","f":"simp"},{"i":"39c27e90-6c08-4eca-91f4-d595476a3c43","t":"題孫棨詩後","a":"王福娘","d":"唐","g":"短诗","p":["苦把文章邀勸人，吟看好箇語言新。","雖然不及相如賦，也直黃金一二斤。"],"s":"trad","f":"simp"},{"i":"2003f214-004c-47e5-ba88-3b3d0922ae2e","t":"問棨詩","a":"王福娘","d":"唐","g":"短诗","p":["日日悲傷未有圖，嬾將心事話凡夫。","非同覆水應收得，只問仙郎有意無。"],"s":"trad","f":"simp"},{"i":"0c6b743d-67eb-4201-97cf-1ae1b8d8fd7c","t":"謝棨詩","a":"王福娘","d":"唐","g":"短诗","p":["久賦恩情欲託身，已將心事再三陳。","泥蓮既沒移栽分，今日分離莫恨人。"],"s":"mixed","f":"simp"},{"i":"fdc0e48f-426e-49f6-b00a-3c0b056323ce","t":"荅小子弟詩","a":"楊萊兒","d":"唐","g":"短诗","p":["黃口小兒口莫憑，逡巡看取第三名。","孝廉持水添缾子，莫向街頭亂椀鳴。"],"s":"trad","f":"simp"},{"i":"705323cd-0250-475f-99fc-de605dd37c80","t":"和趙光遠題壁","a":"楊萊兒","d":"唐","g":"短诗","p":["長者車塵每到門，長卿非慕卓王孫。","定知羽翼難隨鳳，却喜波濤未化鯤。","嬌別翠鈿黏去袂，醉歌金雀碎殘尊。","多情多病年應促，早辦名香爲返魂。"],"s":"mixed","f":"simp"},{"i":"001f0948-aab3-462e-abab-bb2b819cda0a","t":"貽鄭昌圖","a":"楚兒","d":"唐","g":"短诗","p":["應是前生有宿冤，不期今世惡因緣。","蛾眉欲碎巨靈掌，雞肋難勝子路拳。","秪擬嚇人傳鐵券，未應教我踏青蓮。","曲江昨日君相遇，當下遭他數十鞭。"],"s":"trad","f":"simp"},{"i":"c9cd16aa-876f-4bb9-b871-ea629ceb4104","t":"和李標","a":"王蘇蘇","d":"唐","g":"短诗","p":["怪得犬驚雞亂飛，羸童瘦馬老麻衣。","阿誰亂引閑人到，留住青蚨熱趕歸。"],"s":"trad","f":"simp"},{"i":"87bd24e2-01df-4a79-abfb-efb95d837171","t":"臨終召客","a":"顏令賓","d":"唐","g":"短诗","p":["氣餘三五喘，花剩兩三枝。","話別一尊酒，相邀無後期。"],"s":"trad","f":"simp"},{"i":"57168810-72bc-4465-9d8d-469e45e3d948","t":"寄故人","a":"張窈窕","d":"唐","g":"短诗","p":["淡淡春風花落時，不堪愁望更相思。","無金可買長門賦，有恨空吟團扇詩。"],"s":"trad","f":"simp"},{"i":"d78fc260-abdc-4de9-a29b-58274b9636a6","t":"上成都在事","a":"張窈窕","d":"唐","g":"短诗","p":["昨日賣衣裳，今日賣衣裳。","衣裳渾賣盡，羞見嫁時箱。","有賣愁仍緩，無時心轉傷。"],"s":"trad","f":"simp"},{"i":"e2ffe758-af77-4a7c-b246-fe47ca00414b","t":"春思二首 一","a":"張窈窕","d":"唐","g":"短诗","p":["門前梅柳爛春輝，閉妾深閨繡舞衣。","雙燕不知腸欲斷，銜泥故故傍人飛。"],"s":"trad","f":"simp"},{"i":"7dfdd875-80b6-4595-b41a-af4bf573f2d1","t":"春思二首 二","a":"張窈窕","d":"唐","g":"短诗","p":["井上梧桐是妾移，夜來花發最高枝。","若教不向深閨種，春過門前爭得知。"],"s":"trad","f":"simp"},{"i":"4074a45c-dec2-4bbd-bc7d-683b73ac7fac","t":"西江行","a":"張窈窕","d":"唐","g":"短诗","p":["日下西塞山，南來洞庭客。","晴空白鳥度，萬里秋光碧。"],"s":"mixed","f":"simp"},{"i":"e699650a-5b53-4a8a-b058-69a4d0835457","t":"贈所思","a":"張窈窕","d":"唐","g":"短诗","p":["與君咫尺長離別，遣妾容華爲誰說。","夕望層城眼欲穿，曉臨明鏡腸堪絕。"],"s":"mixed","f":"simp"},{"i":"9cedf269-5e30-4b83-8152-021819148eac","t":"句","a":"張窈窕","d":"唐","g":"短诗","p":["滿院花飛人不到，含情欲語燕雙雙。"],"s":"mixed","f":"simp"},{"i":"82b32c76-2612-4e64-bafa-62900044331c","t":"贈裴思謙","a":"平康妓","d":"唐","g":"短诗","p":["銀釭斜背解明璫，小語偷聲賀玉郎。","從此不知蘭麝貴，夜來新惹桂枝香。"],"s":"trad","f":"simp"},{"i":"88bb632d-cfbf-49dd-803b-69f1a5de4eac","t":"迷香洞","a":"史鳳","d":"唐","g":"短诗","p":["洞口飛瓊佩羽霓，香風飄拂使人迷。","自從邂逅芙蓉帳，不數桃花流水溪。"],"s":"trad","f":"simp"},{"i":"477dd50e-337e-4b46-b80d-22c5db42b19e","t":"神雞枕","a":"史鳳","d":"唐","g":"短诗","p":["枕繪鴛鴦久與棲，新裁霧縠鬬神雞。","與郎酣夢渾忘曉，雞亦留連不肯啼。"],"s":"trad","f":"simp"},{"i":"6b354f44-4b85-44a9-8077-e85f01a4ea23","t":"鎖蓮燈","a":"史鳳","d":"唐","g":"短诗","p":["燈鎖蓮花花照罍，翠鈿同醉楚臺巍。","殘灰剔罷攜纖手，也勝金蓮送轍回。"],"s":"trad","f":"simp"},{"i":"05cab70c-2a39-4101-b376-1931d6ecdc98","t":"鮫紅被","a":"史鳳","d":"唐","g":"短诗","p":["肱被當年僅禦寒，青樓慣染血猩紈。","牙牀舒卷鵷鸞共，正值窗櫺月一團。"],"s":"mixed","f":"simp"},{"i":"fa8419f0-2bb4-4017-8f7c-95df04afc84f","t":"傳香枕","a":"史鳳","d":"唐","g":"短诗","p":["韓壽香從何處傳，枕邊芳馥戀嬋娟。","休疑粉黛加鋌刃，玉女旃檀侍佛前。"],"s":"trad","f":"simp"},{"i":"1f9e5ad2-b4ed-43a1-a234-31a80c2ec780","t":"八分羊","a":"史鳳","d":"唐","g":"短诗","p":["党家風味足肥羊，綺閣留人漫較量。","萬羊亦是男兒事，莫學狂夫取次嘗。"],"s":"mixed","f":"simp"},{"i":"ee8c9fc6-237d-4f41-bf87-6988452fde55","t":"閉門羮","a":"史鳳","d":"唐","g":"短诗","p":["一豆聊供游冶郎，去時忙喚鎖倉琅。","入門獨慕相如侶，欲撥瑤琴彈鳳凰。"],"s":"mixed","f":"simp"},{"i":"779b5d60-21da-4e85-900d-6454a7ad0972","t":"突厥三臺","a":"盛小叢","d":"唐","g":"短诗","p":["雁門山上雁初飛，馬邑闌中馬正肥。","日旰山西逢驛使，殷勤南北送征衣。"],"s":"trad","f":"simp"},{"i":"c52848f8-4ef6-4ae2-9ef6-299d0013d090","t":"雲鬟","a":"趙鸞鸞","d":"唐","g":"短诗","p":["擾擾香雲溼未乾，鴉領蟬翼膩光寒。","側邊斜插黃金鳳，妝罷夫君帶笑看。"],"s":"trad","f":"simp"},{"i":"28c5c0de-ac5a-44dd-83ab-3098d024dc2b","t":"柳眉","a":"趙鸞鸞","d":"唐","g":"短诗","p":["彎彎柳葉愁邊戲，湛湛菱花照處頻。","嫵媚不煩螺子黛，春山畫出自精神。"],"s":"trad","f":"simp"},{"i":"5eeb0ce1-7161-4efd-b810-0337d82ffb3f","t":"檀口","a":"趙鸞鸞","d":"唐","g":"短诗","p":["銜杯微動櫻桃顆，咳唾輕飄茉莉香。","曾見白家樊素口，瓠犀顆顆綴榴芳。"],"s":"trad","f":"simp"},{"i":"d9f339e1-2cf0-45e3-946f-44073e873f43","t":"纖指","a":"趙鸞鸞","d":"唐","g":"短诗","p":["纖纖軟玉削春葱，長在香羅翠袖中。","昨日琵琶弦索上，分明滿甲染猩紅。"],"s":"mixed","f":"simp"},{"i":"81532429-ef36-40f8-b756-bcc520acb994","t":"酥乳","a":"趙鸞鸞","d":"唐","g":"短诗","p":["粉香汗溼瑤琴軫，春逗酥融綿雨膏。","浴罷檀郎捫弄處，靈華涼沁紫葡萄。"],"s":"trad","f":"simp"},{"i":"aac890b1-7a13-4ed1-baba-e784b32b1bef","t":"獻陳陶處士","a":"蓮花妓","d":"唐","g":"短诗","p":["蓮花爲號玉爲腮，珍重尚書遣妾來。","處士不生巫峽夢，虛勞神女下陽臺。"],"s":"mixed","f":"simp"},{"i":"1c4ddf5e-4ed1-4fe1-aeaa-bb76fbb37e24","t":"敘懷","a":"徐月英","d":"唐","g":"短诗","p":["爲失三從泣淚頻，此身何用處人倫。","雖然日逐笙歌樂，長羨荆釵與布裙。"],"s":"mixed","f":"simp"},{"i":"59097b44-1d00-4614-b1f3-ecbf1f4027cb","t":"送人","a":"徐月英","d":"唐","g":"短诗","p":["惆悵人間萬事違，兩人同去一人歸。","生憎平望亭前水，忍照鴛鴦相背飛。"],"s":"trad","f":"simp"},{"i":"05253125-0031-4cd3-969a-77e338bd9c64","t":"句","a":"徐月英","d":"唐","g":"短诗","p":["枕前淚與階前雨，隔箇窗兒滴到明。"],"s":"trad","f":"simp"},{"i":"9f5d6ccd-45e1-4cec-8a3a-d95d85266008","t":"句","a":"韓襄客","d":"唐","g":"短诗","p":["連理枝前同設誓，丁香樹下共論心。"],"s":"trad","f":"simp"},{"i":"d3e2897b-9c85-4b01-b8cb-3d9638721a9a","t":"酬人雨後翫竹","a":"薛濤","d":"唐","g":"短诗","p":["南天春雨時，那鑒雪霜姿。","衆類亦云茂，虛心能自持。","多留晉賢醉，早伴舜妃悲。","晚歲君能賞，蒼蒼勁節奇。"],"s":"mixed","f":"simp"},{"i":"19341330-b123-450b-ab52-ea269709799f","t":"春望詞四首 一","a":"薛濤","d":"唐","g":"短诗","p":["花開不同賞，花落不同悲。","欲問相思處，花開花落時。"],"s":"trad","f":"simp"},{"i":"439d558d-d67f-449d-b4b8-6566b27406cb","t":"春望詞四首 二","a":"薛濤","d":"唐","g":"短诗","p":["攬草結同心，將以遺知音。","春愁正斷絕，春鳥復哀吟。"],"s":"trad","f":"simp"},{"i":"ba4c1606-3635-4e6a-bf0b-5324389eec27","t":"春望詞四首 三","a":"薛濤","d":"唐","g":"短诗","p":["風花日將老，佳期猶渺渺。","不結同心人，空結同心草。"],"s":"trad","f":"simp"},{"i":"b6d87441-72e8-481a-9c57-9395380c3041","t":"春望詞四首 四","a":"薛濤","d":"唐","g":"短诗","p":["那堪花滿枝，翻作兩相思。","玉筯垂朝鏡，春風知不知。"],"s":"trad","f":"simp"},{"i":"7a5d5a0e-d6b0-441a-99dd-da6091a65dfc","t":"宣上人見示與諸公唱和","a":"薛濤","d":"唐","g":"短诗","p":["許廁高齋唱，涓泉定不如。","可憐譙記室，流水滿禪居。"],"s":"trad","f":"simp"},{"i":"04073662-f94a-4147-9d4a-0d67f32b0ea0","t":"風","a":"薛濤","d":"唐","g":"短诗","p":["獵蕙微風遠，飄弦唳一聲。","林梢鳴淅瀝，松徑夜淒清。"],"s":"trad","f":"simp"},{"i":"256a243c-0921-4612-b5dc-29571f75f517","t":"月","a":"薛濤","d":"唐","g":"短诗","p":["魄依鉤樣小，扇逐漢機團。","細影將圓質，人間幾處看。"],"s":"trad","f":"simp"},{"i":"09d6c628-a2f3-4172-ab93-61c63644680e","t":"蟬","a":"薛濤","d":"唐","g":"短诗","p":["露滌清音遠，風吹數葉齊。","聲聲似相接，各在一枝棲。"],"s":"trad","f":"simp"},{"i":"4d40c55d-a851-4643-89e1-1f690f707f26","t":"池上雙鳥","a":"薛濤","d":"唐","g":"短诗","p":["雙棲綠池上，朝暮共飛還。","更憶將雛日，同心蓮葉間。"],"s":"trad","f":"simp"},{"i":"c5857f45-77b0-4006-ab95-b61a6f0718b2","t":"鴛鴦草","a":"薛濤","d":"唐","g":"短诗","p":["綠英滿香砌，兩兩鴛鴦小。","但娛春日長，不管秋風早。"],"s":"trad","f":"simp"},{"i":"4825eddd-ed4f-49ff-9987-fb897838c041","t":"罰赴邊有懷上韋令公二首 一","a":"薛濤","d":"唐","g":"短诗","p":["聞道邊城苦，今來到始知。","羞將門下曲，唱與隴頭兒。"],"s":"trad","f":"simp"},{"i":"eaa5f34d-3d7b-4e11-b493-37c66d13d981","t":"罰赴邊有懷上韋令公二首 二","a":"薛濤","d":"唐","g":"短诗","p":["黠虜猶違命，烽煙直北愁。","却教嚴譴妾，不敢向松州。"],"s":"mixed","f":"simp"},{"i":"0e60f1a6-4ec3-4b0e-ad50-d9707e9a9797","t":"詠八十一顆","a":"薛濤","d":"唐","g":"短诗","p":["色比丹霞朝日，形如合浦篔簹。","開時九九如數，見處雙雙頡頏。"],"s":"trad","f":"simp"},{"i":"3ef14b41-4086-4330-b6c2-4e5150852042","t":"謁巫山廟","a":"薛濤","d":"唐","g":"短诗","p":["亂猨啼處訪高唐，路入煙霞草木香。","山色未能忘宋玉，水聲猶是哭襄王。","朝朝夜夜陽臺下，爲雨爲雲楚國亡。","惆悵廟前多少柳，春來空鬬畫眉長。"],"s":"mixed","f":"simp"},{"i":"9d06526a-f145-4a6d-89a2-02e94b937926","t":"牡丹","a":"薛濤","d":"唐","g":"短诗","p":["去春零落暮春時，淚溼紅箋怨別離。","常恐便同巫峽散，因何重有武陵期。","傳情每向馨香得，不語還應彼此知。","只欲欄邊安枕席，夜深閑共說相思。"],"s":"mixed","f":"simp"},{"i":"a49b1116-a19b-4ab9-a350-ddf0ac19d3e7","t":"賊平後上高相公","a":"薛濤","d":"唐","g":"短诗","p":["驚看天地白荒荒，瞥見青山舊夕陽。","始信大威能照映，由來日月借生光。"],"s":"trad","f":"simp"},{"i":"1d521658-87fc-448e-b859-5fcd006cc482","t":"送友人","a":"薛濤","d":"唐","g":"短诗","p":["水國蒹葭夜有霜，月寒山色共蒼蒼。","誰言千里自今夕，離夢杳如關塞長。"],"s":"trad","f":"simp"},{"i":"ad4a9e5b-eb18-448c-878a-450bc7f8909f","t":"聽僧吹蘆管","a":"薛濤","d":"唐","g":"短诗","p":["曉蟬嗚咽暮鶯愁，言語殷勤十指頭。","罷閱梵書聊一弄，散隨金磬泥清秋。"],"s":"trad","f":"simp"},{"i":"76faf698-ecaa-440a-802b-36038adc896a","t":"酬郭簡州寄柑子","a":"薛濤","d":"唐","g":"短诗","p":["霜規不讓黃金色，圓質仍含御史香。","何處同聲情最異，臨川太守謝家郎。"],"s":"trad","f":"simp"},{"i":"6e8e0144-a717-4467-b6ab-c9ad3a0dc8a2","t":"上川主武元衡相國二首 一","a":"薛濤","d":"唐","g":"短诗","p":["落日重城夕霧收，玳筵雕俎薦諸侯。","因令朗月當庭燎，不使珠簾下玉鉤。"],"s":"trad","f":"simp"},{"i":"e3d356bf-bd83-4aa9-aa30-3a2f4c47e4a3","t":"上川主武元衡相國二首 二","a":"薛濤","d":"唐","g":"短诗","p":["東閣移尊綺席陳，貂簪龍節更宜春。","軍城畫角三聲歇，雲幕初垂紅燭新。"],"s":"trad","f":"simp"},{"i":"f0642653-c834-4a31-9fe4-d60d50a4ca8c","t":"憶荔枝","a":"薛濤","d":"唐","g":"短诗","p":["傳聞象郡隔南荒，絳實豐肌不可忘。","近有青衣連楚水，素漿還得類瓊漿。"],"s":"trad","f":"simp"},{"i":"eea14da6-9c31-4559-beb0-1e9ad1bcc617","t":"斛石山曉望寄呂侍御","a":"薛濤","d":"唐","g":"短诗","p":["曦輪初轉照仙扃，旋擘煙嵐上窅冥。","不得玄暉同指點，天涯蒼翠漫青青。"],"s":"trad","f":"simp"}]