[{"i":"c-9b7c9ceb4c31","t":"转调二郎神・二郎神","a":"张孝祥","d":"宋","g":"词","p":["闷来无那，暗数尽、残更不寐。","念楚馆香车，吴溪兰棹，多少愁云恨水。","阵阵回风吹雪霰，更旅雁、一声沙际。","想静拥孤衾，频挑寒灺，数行珠泪。","凝睇。","傍人笑我，终朝如醉。","便锦织回鸾，素传双鲤，难写衷肠密意。","绿鬓点霜，玉肌消雪，两处十分憔悴。","争忍见，旧时娟娟素月，照人千里。"],"s":"simp","f":"trad"},{"i":"c-971ab29ea43f","t":"满江红","a":"张孝祥","d":"宋","g":"词","p":["秋满蘅皋，烟芜外、吴山历历。","风乍起，兰舟不住，浪花摇碧。","离岸橹声惊渐远，盈襟泪颗凄犹滴。","问此情、能有几人知，新相识。","追往事，欢连夕。","经旧馆，人非昔。","把轻颦浅笑，细思重忆。","红叶题诗谁与寄，青楼薄幸空遗迹。","但长洲、茂苑草萋萋，愁如织。"],"s":"simp","f":"trad"},{"i":"c-6cd57a337967","t":"满江红","a":"张孝祥","d":"宋","g":"词","p":["千古凄凉，兴亡事、但悲陈迹。","凝望眼、吴波不动，楚山丛碧。","巴滇绿骏追风远，武昌云旆连江赤。","笑老奸、遗臭到如今，留空壁。","边书静，烽烟息。","通轺传，销锋镝。","仰太平天子，坐收长策。","蹙踏扬州开帝里，渡江天马龙为匹。","看东南、佳气郁葱葱，传千亿。"],"s":"simp","f":"trad"},{"i":"c-a40a884dc4b3","t":"满江红","a":"张孝祥","d":"宋","g":"词","p":["秋满漓源，瘴云净、晓山如簇。","动远思、空江小艇，高丘乔木。","策策西风双鬓底，晖晖斜日朱栏曲。","试侧身、回首望京华，迷南北。","思归梦，天边鹄。","游宦事，蕉中鹿。","想一年好处，砌红堆绿。","罗帕分柑霜落齿，冰磐剥芡珠盈掬。","倩春纤、缕鲙捣香齑，新篘熟。"],"s":"simp","f":"trad"},{"i":"c-d71a6855eb2d","t":"青玉案","a":"张孝祥","d":"宋","g":"词","p":["红尘冉冉长安路。","看风度、凝然去。","唱彻阳关留不住。","甘棠庭院，芰荷香渚。","尽是相思处。","龟鱼从此谁为主。","好记江湖断肠句。","万斛离愁休更诉。","洞庭烟棹，楚楼风露。","去作为霖雨。"],"s":"simp","f":"trad"},{"i":"c-ddee92ffbf13","t":"蓦山溪","a":"张孝祥","d":"宋","g":"词","p":["清都绛阕，我自经行惯。","璧月带珠星，引钧天、笙箫不断。","宝簪瑶佩，玉立拱清班。","天一笑，物皆春，结得清虚伴。","还丹九转。","凡骨亲曾换。","携剑到人间，偶相逢、依然青眼。","狂歌醉舞，心事有谁知，明月下，好风前，相对纶巾岸。"],"s":"simp","f":"trad"},{"i":"c-4c28faa3cc99","t":"蝶恋花","a":"张孝祥","d":"宋","g":"词","p":["漠漠飞来双属玉。","一片秋光，染就潇湘绿。","雪转寒芦花蔌蔌。","晚风细起波纹縠。","落日闲云归意促。","小倚蓬窗，写作思家曲。","过尽碧湾三十六。","扁舟只在滩头宿。"],"s":"simp","f":"trad"},{"i":"c-d3671c6c6300","t":"蝶恋花","a":"张孝祥","d":"宋","g":"词","p":["恰则杏花红一树，拈指来时，结子青无数。","漠漠春阴缠柳絮。","一天风雨将春去。","春到家山须小住。","芍药樱桃，更是寻芳处。","绕院碧莲三百亩。","留春伴我春应许。"],"s":"simp","f":"trad"},{"i":"c-0f58d0caa309","t":"蝶恋花","a":"张孝祥","d":"宋","g":"词","p":["画戟斿闲刀入鞘。","安石榴花，影落红栏小。","似劝先生须饮釂。","枕中鸿宝微传妙。","衮衮锋车还急诏。","满眼潇湘，总是恩波渺。","归去槐庭思楚峤。","觚稜月晓期分照。"],"s":"mixed","f":"trad"},{"i":"c-d4a21e16ed3c","t":"蝶恋花","a":"张孝祥","d":"宋","g":"词","p":["君泛仙槎银海去。","后日相思，地角天涯路。","草草杯磐深夜语。","冥冥四月黄梅雨。","莫拾明珠并翠羽。","但使邦人，爱我如慈母。","待得政成民按堵。","朝天衣袂翩翩举。"],"s":"simp","f":"trad"},{"i":"c-1229a4b45eaa","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["咏彻琼章夜向阑。","天移星斗下人间。","九光倒影腾青简，一气回春绕绛坛。","瞻北阕，祝南山。","遥知仙仗簇清班。","何人曾侍传柑宴，翡翠帘开识圣颜。"],"s":"simp","f":"trad"},{"i":"c-ba86efbea031","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["子夜封章扣紫清。","五霞光里佩环声。","驿传风火龙鸾舞，步入烟宵孔翠迎。","瑶简重，羽衣轻。","金童双引到通明。","三湘五管同民乐，万岁千秋与帝龄。"],"s":"simp","f":"trad"},{"i":"c-7f4483809307","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["忆昔追游翰墨场。","武夷仙伯较文章。","琅函奏号银台省，毡笔书名御苑墙。","经十载，过三湘。","横楣丽锦照传觞。","醉馀吐出胸中墨，只欠彭宣到后堂。"],"s":"simp","f":"trad"},{"i":"c-7c8b2d743e5a","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["月地云阶欢意阑。","仙姿不合住人间。","骖鸾已恨车尘远，泣凤空馀烛影残。","情脉脉，泪珊珊。","梅花音信隔关山。","只应楚雨清留梦，不那吴霜绿易斑。"],"s":"simp","f":"trad"},{"i":"c-5f5d46e6eeec","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["去日清霜菊满丛。","归来高柳絮缠空。","长驱万里山收瘴，径度层波海不风。","阴得遍，岭西东。","天教慈母寿无穷。","遥知今夕称觞处，衣彩还将衣绣同。"],"s":"simp","f":"trad"},{"i":"c-b751de9ecf52","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["阿母蟠桃不记春。","长沙星里寿星明。","金花罗纸新裁诏，贝叶旁行别授经。","同犬子，祝龟龄。","天教二老鬓长青。","明年今日称觞处，更有孙枝满谢庭。"],"s":"simp","f":"trad"},{"i":"c-694060086fd3","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["舞凤飞龙五百年。","尽将锦绣裹山川。","王家券册诸孙嗣，主第笙歌故国传。","居玉铉，拥金蝉。","祗今门户庆蝉联。","君侯合侍明光殿，且作横槎海上仙。"],"s":"simp","f":"trad"},{"i":"c-a214d019e763","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["浴殿西头白玉堂。","湘江东畔碧玉幢。","北辰躔次瞻星象，南国山川解印章。","随步武，谢恩光。","送公归趣舍人装。","它年若肯传衣钵，今日应须传寿觞。"],"s":"simp","f":"trad"},{"i":"c-c35d05508eac","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["昼得游嬉夜得眠。","农桑欲遍楚山川。","问看百姓知公否，馀子纷纷定不然。","思主眷，酌民言。","与民称寿拜公前。","只将心与天通处，合住人间五百年。"],"s":"simp","f":"trad"},{"i":"c-b375e9ee9bc7","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["割镫难留乘马东。","花枝争看袅长红。","衮衣空使斯民恋，绿竹谁歌入相同。","回武事，致年丰。","几多遗爱在湘中。","须知楚水枫林下，不似初闻长乐钟。"],"s":"simp","f":"trad"},{"i":"c-25f2a7674716","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["楚楚吾家千里驹。","老人心事正关渠。","风流合是阶除玉，爱惜真成掌上珠。","纡彩绶，荐芳壶。","老人还醉弟兄扶。","问将何物为儿寿，付与家传万卷书。"],"s":"simp","f":"trad"},{"i":"c-1c584932eb88","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["又向荆州住半年。","西风催放五湖船。","来时露菊团金颗，去日池荷叠绿钱。","斟别酒，扣离弦。","一时宾从最多贤。","今宵拼醉花迷坐，后夜相思月满川。"],"s":"simp","f":"trad"},{"i":"c-cb20b314c48e","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["忆昔彤庭望日华。","匆匆枯笔梦生花。","郁轮袍曲惭新奏，风送银湾犯斗槎。","追往事，甫新瓜。","飞蓬何事及兰麻。","一江湘水流馀润，十里河堤筑浅沙。"],"s":"simp","f":"trad"},{"i":"c-bc8307ef59bc","t":"鹧鸪天","a":"张孝祥","d":"宋","g":"词","p":["瞻跸门前识个人。","柳眉桃脸不胜春。","短襟衫子新来棹，四直冠儿内样新。","秋色净，晓妆匀。","不知何事在风尘。","主翁若也怜幽独，带取妖饶上玉宸。"],"s":"simp","f":"trad"},{"i":"c-1b5582e63b1b","t":"虞美人","a":"张孝祥","d":"宋","g":"词","p":["庐敖夫妇骖鸾侣。","相敬如宾主。","森然兰玉满尊前。","举案齐眉乐事、看年年。","我家白发双垂雪。","已是经年别。","今宵归梦楚江滨。","也学君家儿子、寿吾亲。"],"s":"simp","f":"trad"},{"i":"c-15c1129fe2c3","t":"虞美人","a":"张孝祥","d":"宋","g":"词","p":["雪花一尺江南北。","薪尽炊无粟。","老仙活国拭刀圭。","十万人家生意、与春回。","天公一笑酬阴德。","赐与长生籍。","今朝雪霁寿尊前。","看我双亲都是、地行仙。"],"s":"simp","f":"trad"},{"i":"c-4aa166559e61","t":"虞美人","a":"张孝祥","d":"宋","g":"词","p":["雪消烟涨清江浦。","碧草春无数。","江南几树夕阳红。","点点归帆吹尽、晚来风。","楼头自擫昭华管。","我已无肠断。","断行双雁向人飞。","织锦回文空住、寄它谁。"],"s":"simp","f":"trad"},{"i":"c-d65bc225ad7c","t":"虞美人","a":"张孝祥","d":"宋","g":"词","p":["溪西竹榭溪东路。","溪上山无数。","小舟却在晚烟中。","更看萧萧微雨、打疏篷。","无聊情绪如中酒。","此意君知否。","年时曾向此中行。","有个人人相对、坐调筝。"],"s":"simp","f":"trad"},{"i":"c-4a84c66571f4","t":"虞美人","a":"张孝祥","d":"宋","g":"词","p":["柳梢梅萼春全未。","谁曾伤春意。","一年好处是新春。","柳底梅边只欠、那人人。","凭春约住梅和柳。","略待些时候。","锦帆风送彩舟来。","却遗香包娇叶、一齐开。"],"s":"simp","f":"trad"},{"i":"c-9464b6348e73","t":"虞美人","a":"张孝祥","d":"宋","g":"词","p":["罗衣怯雨轻寒透。","陡做伤春瘦。","个人无奈语佳期。","徙倚黄昏池阁、等多时。","当初不似休来好。","来后空烦恼。","倩人传语更商量。","只得千金一笑、也甘当。"],"s":"simp","f":"trad"},{"i":"c-2d44d50a880f","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["北窗凉透，南窗月上，浴罢满怀风露。","不知何处有花来，但怪底、清香无数。","炎州珍产，吴儿未识，天与幽芳独步。","冰肌玉骨岁寒时，倩间止、堂中留住。"],"s":"simp","f":"trad"},{"i":"c-0368b7846988","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["吹香成阵，飞花如雪，不那朝来风雨。","可怜无处避春寒，但玉立、仙衣数缕。","清愁万斛，柔肠千结，醉里一时分付。","与君不用叹飘零，待结子、成阴归去。"],"s":"simp","f":"trad"},{"i":"c-e93f2c2c3213","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["横波滴素，遥山蹙翠，江北江南肠断。","不知何处驭风来。","云雾里、钗横鬓乱。","香罗叠恨，蛮笺写意，付与瑶台女伴。","醉时言语醒时羞，道醒了、休教再看。"],"s":"simp","f":"trad"},{"i":"c-6c9a6cb64117","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["湘江东畔，去年今日，堂上簪缨罗绮。","弟兄同拜寿尊前，共一笑、欢欢喜喜。","渚宫风月，边城鼓角，更好亲庭一醉。","醉时同唱去年词，愿来岁、强如今岁。"],"s":"simp","f":"trad"},{"i":"c-36260cf76b9a","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["南州名酒，北园珍果，都与黄香为寿。","风流文物是家传，睨血指、旁观袖手。","东风消息，西山爽气，总聚君家户牖。","旧时曾识玉堂仙，在帝所、频开荐口。"],"s":"simp","f":"trad"},{"i":"c-ade47acac43d","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["明珠盈斗，黄金作屋，占了湘中秋色。","金风玉露不胜情，看天上、人间今夕。","枝头一点，琴心三叠，算有诗名消得。","野堂从此不萧疏，问何日、尊前唤客。"],"s":"simp","f":"trad"},{"i":"c-b16ce962452d","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["黄陵庙下，送君归去，上水船儿一只。","离歌声断酒杯空，容易里、东西南北。","重湖风月，九秋天气，冉冉清愁如织。","我家住在楚江滨，为频寄、双鱼素尺。"],"s":"simp","f":"trad"},{"i":"c-febf7375a1f8","t":"鹊桥仙","a":"张孝祥","d":"宋","g":"词","p":["东明大士，吾家老子，是一元知非二。","共携甘雨趁生朝，做万里、丰年欢喜。","司空山上，长沙星里，乞与无边祥瑞。","仙家日月镇常春，笑人说、长生久视。"],"s":"simp","f":"trad"},{"i":"c-739075eacabe","t":"南乡子","a":"张孝祥","d":"宋","g":"词","p":["江上送归船。","风雨排空浪拍天。","赖有清尊浇别恨，凄然。","宝蜡烧花看吸川。","楚舞对湘弦。","暖响围春锦帐毡。","坐上定知无俗客，俱贤。","便是朱张与少连。"],"s":"simp","f":"trad"},{"i":"c-8d8098aa189f","t":"画堂春","a":"张孝祥","d":"宋","g":"词","p":["蟠桃一熟九千年。","仙家春色无边。","书堂日暖卷非烟。","昼永风妍。","看取蔬封汤沐，何妨频棹觥船。","方瞳绿发对儒仙。","岁岁尊前。"],"s":"simp","f":"trad"},{"i":"c-7116a5897ca1","t":"柳梢青","a":"张孝祥","d":"宋","g":"词","p":["重阳时节。","满城风雨，更催行色。","陇树寒轻，海山秋老，清愁如织。","一杯莫惜留连，我亦是、天涯倦客。","后夜相思，水长山远，东西南北。"],"s":"simp","f":"trad"},{"i":"c-28fede6e659b","t":"柳梢青","a":"张孝祥","d":"宋","g":"词","p":["今年元夕。","探尽江梅，都无消息。","草市梢头，柳庄深处，雪花如席。","一尊邻里相过，也随分、移时换节。","玉辇端门，红旗夜市、凭君休说。"],"s":"simp","f":"trad"},{"i":"c-f5b8983480a7","t":"柳梢青","a":"张孝祥","d":"宋","g":"词","p":["溪南溪北。","玉香消尽，翠娇无力。","月淡黄昏，烟横清晓，都无消息。","无聊更绕空枝，断魂远、重招怎得。","驿使归来，戍楼吹断，空成凄恻。"],"s":"simp","f":"trad"},{"i":"c-c60a85f8dfe0","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["杨柳东风，海棠春雨。","清愁冉冉无来处。","曲径惊飞蛱蝶丛，回塘冻湿鸳鸯侣。","舞彻霓裳，歌残金缕。","蘼芜白芷愁烟渚。","不识阳台梦里云，试听华表归来语。"],"s":"simp","f":"trad"},{"i":"c-8422a378eed4","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["洛下根株，江南栽种。","天香国色千金重。","花边三阁建康春，风前十里扬州梦。","油壁轻车，青丝短鞚。","看花日日催宾从。","而今何许定王城，一枝且为邻翁送。"],"s":"simp","f":"trad"},{"i":"c-d4bf8c8d1310","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["旋葺荒园，初开小径。","物华还与东风竞。","曲槛晖晖落照明，高城冉冉孤烟暝。","柳色金寒，梅花雪静。","道人随处成幽兴。","一杯不惜小淹留，归期已理沧浪艇。"],"s":"simp","f":"trad"},{"i":"c-d83a882ce979","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["万里扁舟，五年三至。","故人相见犹堪喜。","山阴乘兴不须回，毗耶问疾难为对。","不药身轻，高谈心会。","匆匆我又成归计。","它时江海肯相寻，绿蓑青弱看清贵。"],"s":"simp","f":"trad"},{"i":"c-86d78c4022df","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["藕叶池塘，榕阴庭院。","年时好月今宵见。","云鬓玉臂共清寒，冰绡雾縠谁裁剪。","扑粉口绵，侵尘宝扇。","遥知掩抑成凄怨。","去程何许是归程，离觞为我深深劝。"],"s":"simp","f":"trad"},{"i":"c-f862e071c390","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["古屋丛祠，孤舟野渡。","长年与客分携处。","漠漠愁阴岭上云，萧萧别意溪边树。","我已北归，君方南去。","天涯客里多歧路。","须君早出瘴烟来，江南山色青无数。"],"s":"simp","f":"trad"},{"i":"c-0a60337d9254","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["时雨初晴，诏书随至。","邦人父老为君喜。","十年江海始归来，祥曦殿里搀班对。","日月开明，风云感会。","切须稳上平戎计。","天教慈母寿无穷，看君黄发腰金贵。"],"s":"simp","f":"trad"},{"i":"c-bf903315084e","t":"踏莎行","a":"张孝祥","d":"宋","g":"词","p":["桂岭南边，湘江东畔。","三年两见生申旦。","知君心地与天通，天教仙骨年年换。","趁此仙风，乘槎宵汉。","看看黄纸书来唤。","但令丹鼎汞频添，莫辞酒盏春无算。"],"s":"simp","f":"trad"},{"i":"c-52480f849094","t":"丑奴儿・采桑子","a":"张孝祥","d":"宋","g":"词","p":["年年有个人生日，谁似君家。","谁似君家。","八十慈亲发未华。","棠阴阁上棠阴满，满劝流霞。","满劝流霞。","来岁应添宰路沙。"],"s":"simp","f":"trad"},{"i":"c-524ab45c8767","t":"丑奴儿・采桑子","a":"张孝祥","d":"宋","g":"词","p":["伯鸾德耀贤夫妇，见说宜家。","见说宜家。","庭砌森森长玉华。","天公遣注长生籍，服日餐霞。","服日餐霞。","寿纪应须海算沙。"],"s":"simp","f":"trad"},{"i":"c-7d41ecdf815f","t":"丑奴儿・采桑子","a":"张孝祥","d":"宋","g":"词","p":["十年闻说查山好，何日追游。","木落霜秋。","梦想云溪不那愁。","主人好事长留客，尊酒夷犹。","一笑登楼。","兴在西峰上上头。"],"s":"simp","f":"trad"},{"i":"c-31ebf55cd64d","t":"丑奴儿・采桑子","a":"张孝祥","d":"宋","g":"词","p":["十分济楚邦之媛，此日追游。","雨霁云收。","梦入潇湘不那愁。","主人白玉堂中老，曾侍凝旒。","满酌琼舟。","即上虚皇香案头。"],"s":"simp","f":"trad"},{"i":"c-4db8ae700220","t":"丑奴儿・采桑子","a":"张孝祥","d":"宋","g":"词","p":["珠灯璧月年时节，织手同携。","今夕谁知，自拈梅花劝一卮。","逢人问道归来也，日日佳期。","管有来时。","趁得手灯也未迟。"],"s":"simp","f":"trad"},{"i":"c-65e42e136d9d","t":"丑奴儿・采桑子","a":"张孝祥","d":"宋","g":"词","p":["无双谁似黄郎子，自郐无讥。","月满星稀。","想见歌场夜打围。","画眉京兆风流甚，应赋蛜蝛。","杨柳依依。","何日文箫共驾归。"],"s":"simp","f":"trad"},{"i":"c-0585f1a3bce3","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["卷旗直入蔡州城。","只倚精忠不要兵。","贼营半夜落妖星。","万旅云屯看整暇，十眉环坐却娉婷。","白麻早晚下天庭。"],"s":"simp","f":"trad"},{"i":"c-c0869a1e4188","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["玉节珠幢出翰林。","诗书谋帅眷方深。","威声虎啸复龙吟。","我是先生门下士，相逢有酒且教斟。","高山流水遇知音。"],"s":"simp","f":"trad"},{"i":"c-89ea6f1552ce","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["绝代佳人淑且真。","雪为肌骨月为神。","烛前花底不胜春。","倚竹袖长寒卷翠，凌波袜小暗生尘。","十分京落旧家人。"],"s":"simp","f":"trad"},{"i":"c-04db4b1b01f9","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["妙手何人为写真。","只难传处是精神。","一枝占断洛城春。","暮雨不堪巫峡梦，西风莫障瘐公尘。","扁舟湖海要诗人。"],"s":"simp","f":"trad"},{"i":"c-0eda0f5a1864","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["腊后春前别一般。","梅花枯淡水仙寒。","翠云裘著紫霞冠。","仙品只今推第一，清香元不是人间。","为君更拭小龙团。"],"s":"simp","f":"trad"},{"i":"c-c4ae394581c1","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["宝蜡烧春夜影红。","梅花枝傍锦薰笼。","曲琼低卷瑞香风。","万里江山供燕几，一时宾主看谈锋。","问君归计莫匆匆。"],"s":"simp","f":"trad"},{"i":"c-3da8aa484d35","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["六客西来共一舟。","吴儿踏浪剪轻鸥。","水光山色翠相浮。","我欲吹箫明月下，略须停棹晚风头。","从前五度到蕲州。"],"s":"simp","f":"trad"},{"i":"c-5e04167e4b6a","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["已是人间不系舟。","此心元自不惊鸥。","卧看骇浪与天浮。","对月只应频举酒，临风何必更搔头。","暝烟多处是神州。"],"s":"simp","f":"trad"},{"i":"c-dfc7097b91f6","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["冉冉幽香解钿囊。","兰桡烟雨暗春江。","十分清瘦为箫郎。","遥忆牙樯收楚缆，应将玉箸点吴妆。","有人萦断九回肠。"],"s":"simp","f":"trad"},{"i":"c-c56b268e5e0a","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["楼下西流水拍堤。","楼头日日望春归。","雪晴风静燕来迟。","留得梅花供半额，要将杨叶画新眉。","莫教辜负早春时。"],"s":"simp","f":"trad"},{"i":"c-2f5610af615b","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["方舡载酒下江东。","箫鼓喧天浪拍空。","万山紫翠映云重。","拟看岳阳楼上月，不禁石首岸头风。","作笺我欲问龙公。"],"s":"simp","f":"trad"},{"i":"c-be2d68a7b303","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["罗袜生尘洛浦东。","美人春梦琐窗空。","眉山蹙恨几千重。","海上蟠桃留结子，渥洼天马去追风。","不须多怨主人公。"],"s":"simp","f":"trad"},{"i":"c-7bb742a85f0d","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["一片西飞一片东。","高情已逐落花空。","旧欢休问几时重。","结习正如刀舔蜜，扫除须著絮因风。","请君持此问龙公。"],"s":"simp","f":"trad"},{"i":"c-95b0e500d9d6","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["鳷鹊楼高晚雪融。","鸳鸯池暖暗潮通。","郁金黄染柳丝风。","油壁不来春草绿，栏干倚遍夕阳红。","江南山色有无中。"],"s":"simp","f":"trad"},{"i":"c-ed1f3035319d","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["妒妇滩头十八姨。","颠狂无赖占佳期。","唤它滕六把春欺。","﹀︽莺莺并燕燕，凄惶柳柳与梅梅。","东君独自落便宜。"],"s":"simp","f":"trad"},{"i":"c-fb56e94a375e","t":"浣溪沙","a":"张孝祥","d":"宋","g":"词","p":["行尽潇湘到洞庭。","楚天阔处数峰青。","旗梢不动晚波平。","红蓼一湾纹缬乱，白鱼双尾玉刀明。","夜凉船影浸疏星。"],"s":"simp","f":"trad"},{"i":"c-41812e7177fc","t":"浪淘沙","a":"宋先生","d":"宋","g":"词","p":["师指炼金丹。","牢锁金关。","工夫进火莫交闲。","向己澄心观内景，闪电眉间。","妙用在泥丸。","神思难看。","愚迷不悟隔千山。","悟即如同观返掌，出世何难。"],"s":"simp","f":"trad"},{"i":"c-e96cc7fcfd4c","t":"浪淘沙","a":"宋先生","d":"宋","g":"词","p":["铅汞要加添。","火候频煎。","体中气足返阳全。","养就婴儿并姹女，同坐同眠。","髓实自身坚。","运满三田。","刀圭服了得神仙。","只候功成并行满，独步朝元。"],"s":"simp","f":"trad"},{"i":"c-c023ee9b0ed0","t":"糖多令・唐多令","a":"宋先生","d":"宋","g":"词","p":["搬载渡黄河。","金关牢闭锁。","运九还、须是功多。","光透帘帏红似火。","见金钱、万千朵。","过水涌银波。","充开牛斗过。","进工夫、□□蹉跎。","见个真人便是我。","暗欢喜、笑呵呵。"],"s":"simp","f":"trad"},{"i":"c-5f21667c59ba","t":"桃源忆故人","a":"宋先生","d":"宋","g":"词","p":["自从师指天机道。","万卷仙经都晓。","若会连精归脑。","颜貌长不老。","真铅真汞人知少。","乌兔烹煎成宝。","身外有身方了。","玉帝金书召。"],"s":"simp","f":"trad"},{"i":"c-76cfc3be49e9","t":"惜黄花","a":"宋先生","d":"宋","g":"词","p":["天机大道。","达者稀少。","运戊己、龙蟠更虎绕。","这一颗丹砂，凡世人难晓。","间木金、坎离颠倒。","阳全阴尽，形容不老。","将水火烹煎，自然炉灶。","待行功成就，炼无价宝。","去朝元、七祖都了。"],"s":"simp","f":"trad"},{"i":"c-cf9f49067801","t":"阮郎归","a":"宋先生","d":"宋","g":"词","p":["一轮明月照三峰。","彩霞飞满空。","分明见我主人公。","明珠透上宫。","丹药炼，鼎中红。","频频要用功。","功成定是出樊笼。","闲游仙洞中。"],"s":"simp","f":"trad"},{"i":"c-5a9ca3199165","t":"武陵春","a":"宋先生","d":"宋","g":"词","p":["七返阳全阴去尽，精髓满三田。","修道无为必自然。","论甚后和先。","认取五行真水火，须要识根源。","自己丹砂著意看。","何用外寻丹。"],"s":"simp","f":"trad"},{"i":"c-840d36fbedbc","t":"西江月","a":"叶适","d":"宋","g":"词","p":["识贯事中枢纽，笔开象外精神。","传观弓力异常钧。","衣我六铢羞问。","周后数茎命粒，鲁儒一点芳心。","啄残栖老付谁论。","谩要睡馀支枕。"],"s":"simp","f":"trad"},{"i":"c-2b008ac2c8a4","t":"望江南・忆江南","a":"王","d":"宋","g":"词","p":["三杰后，福寿两无涯。","食乳相君功未既，妩眉京兆眷方兹。","富贵莫推辞。","门两戟，却棹一纶丝。","莼菜秋风鲈鲙美，桃花春水鳜鱼肥。","笑傲霅溪湄。"],"s":"simp","f":"trad"},{"i":"c-3a4aa73a3ff7","t":"水龙吟","a":"刘褒","d":"宋","g":"词","p":["东风初縠池波，轻阴未放游丝堕。","新春歌管，丰年笑语，六街灯火。","绣毂雕鞍，飞尘卷雾，水流云过。","恍扬州十里，三生梦觉，卷珠箔、映青琐。","金猊戏掣星桥锁。","博山香、烟浓百和。","使君行乐，绛纱万炬，雪梅千朵。","羯鼓轰空，鵾弦沸晓，樱梢微破。","想明年更好，传柑侍宴，醉扶狨座。"],"s":"mixed","f":"trad"},{"i":"c-f570917352ce","t":"雨中花慢","a":"刘褒","d":"宋","g":"词","p":["缥蒂缃枝，玉叶翡英，百梢争赴春忙。","正雨后、蜂黏落絮，燕扑晴香。","遗策谁家荡子，唾花何处新妆。","想流红有恨，拾翠无心，往事凄凉。","春愁如海，客思翻空，带围只看东阳。","更那堪、玉笙度曲，翠羽传觞。","红泪不胜闺怨，白云应老他乡。","梦回羁枕，风惊庭树，月在西厢。"],"s":"simp","f":"trad"},{"i":"c-def7eef020d2","t":"满庭芳","a":"刘褒","d":"宋","g":"词","p":["柳袅金丝，梨铺香雪，一年春事方中。","烛前一见，花艳觉羞红。","枕臂香痕未落，舟横岸、作计匆匆。","明朝去，暮天平水，双桨碧云东。","隔离歌一阕，琵琶声断，燕子楼空。","叹阳台梦杳，行雨无踪。","后会芙蕖未老，从今去、日望归鸿。","愁如织，断肠啼鴂，饶舌诉东风。"],"s":"simp","f":"trad"},{"i":"c-0c41ce0bc2c2","t":"六州歌头","a":"刘褒","d":"宋","g":"词","p":["凭深负阻，蜂舞肆奔腾。","龙江上，妖氛涨，鲸海外，白波惊。","羽檄交飞急，玉帐静，金韬閟，恢远驭，振长樱。","密分兵。","细草黄沙渺渺，西关路、风袅高旌。","听飞霜令肃，坚壁夜无声。","鼓角何神。","地中鸣。","看追风骑，攒云槊，雷野毂，激天钲。","飞箭集，旄头坠，长围掩，郭东倾。","振旅观旋凯，笳鼓竞，绣旗明。","刀换犊，戈藏革，士休营。","黄色赤云交映，论功何止蔡州平。","想环城苍玉，深刻入青冥。","永诏来今。"],"s":"simp","f":"trad"},{"i":"c-fc5c11cd5fe5","t":"水调歌头","a":"刘褒","d":"宋","g":"词","p":["天淡四垂幕，云细不成衣。","西风扫尽绣翳，凉我鬓边丝。","破匣菱花飞动，跨海清光无际，草露滴明玑。","杯到莫停手，何用问来期。","坐虚堂，揩病眼，溯流辉。","云山应有幽恨，瑶瑟掩金徽。","河汉无声自转，玉兔有情亦老，世事巧相违。","一写谪仙怨，双泪满君颐。"],"s":"simp","f":"trad"},{"i":"c-5b76a81703a5","t":"水调歌头","a":"熊以宁","d":"宋","g":"词","p":["天地有英气，锺秀在人间。","流虹甫近华旦，维岳预生贤。","千载明良会遇，三世勋庸忠烈，谁得似家传。","高论排风俗，抗志遏狂澜。","记年时，胡尘外，拥朱幡。","洪枢紫府功业，指日复青毡。","拭目泥封飞下，趁取梅花消息，去去簉朝班。","骨相元不老，何必颂南山。"],"s":"simp","f":"trad"},{"i":"c-506b28466df6","t":"醉蓬莱","a":"熊以宁","d":"宋","g":"词","p":["渐荷收绿盖，桂吐金英，嫩凉天气。","香案仙官，向人间游戏。","道貌孤高，灵扃恬淡，有寿星标致。","梦得文章，水心谈论，家声相继。","芙蓉上幕，龙藩胜地。","剡荐交飞，宸衷简记。","行趣朝班，便鸾坡螭陛。","赞画堂中，垂弧节届，且举觞一醉。","试问桩椿，春秋多少，八千馀岁。"],"s":"simp","f":"trad"},{"i":"c-c5bbcfc0a0f5","t":"鹊桥仙","a":"熊以宁","d":"宋","g":"词","p":["隐君仙裔，帅垣佳配。","谁似硕人清贵。","几番鸾诰自天来，森绿绶、彩衣当砌。","莲开十丈，蓂留十荚，迟十日、瑶池秋至。","殷勤祝寿指蟠桃，更重数、三千馀岁。"],"s":"simp","f":"trad"},{"i":"c-95f976debad2","t":"失调名","a":"詹克爱","d":"宋","g":"词","p":["天孙亲织云锦，一笑天下河西。"],"s":"simp","f":"trad"},{"i":"c-ca238651b364","t":"失调名","a":"詹克爱","d":"宋","g":"词","p":["空将别泪，洒作人间雨。"],"s":"simp","f":"trad"},{"i":"c-7cdf31777d82","t":"失调名","a":"詹克爱","d":"宋","g":"词","p":["后会不知谁健，茱萸莫厌重看。"],"s":"simp","f":"trad"},{"i":"c-ba666406060d","t":"齐天乐","a":"李寅仲","d":"宋","g":"词","p":["摩挲阅古堂前柳，尽是世臣乔木。","故国风流，中兴事业，都写南山修竹。","商颜自绿。","甚当日君王，浩歌鸿鹄。","谁识宫中，有人先定大横卜。","簪貂更鸣佩玉。","退朝归较晚，留传黄屋。","雨露无边，风云在手，宜享长生福。","神京未复。","看先取鸿沟，次封函谷。","岁岁初寒，小桃花下跨青鹿。"],"s":"simp","f":"trad"},{"i":"c-792dc9d8fb3d","t":"长相思","a":"张鎡","d":"宋","g":"词","p":["晴时看。","雨时看。","红绿云中驾彩鸾。","阳台梦未阑。","咏伊难。","画伊难。","服透东皇九转丹。","光生玉炼颜。"],"s":"mixed","f":"trad"},{"i":"c-afc41b60e0de","t":"梦游仙・戚氏","a":"张鎡","d":"宋","g":"词","p":["骖鸾侣，娇小怯云期。","柳戏花游能几日，顿抛尘幻学希夷。","清梦到瑶池。","霞袂稳，那顾缕金衣。","自与长生分姓谱，恰逢长老铸丹时。","此意有谁知。"],"s":"mixed","f":"trad"},{"i":"c-b59ece2a7f39","t":"梦游仙・戚氏","a":"张鎡","d":"宋","g":"词","p":["晴昼永，闲步小园中。","羽帔云轻苍佩响，宝冠星莹绀纱笼。","波秀浅蛾峰。","琳洞窈，人静理丝桐。","泛指馀音摇桂影，过墙高韵入松风。","月上翠楼东。"],"s":"mixed","f":"trad"},{"i":"c-e09a7a2d452a","t":"梦游仙・戚氏","a":"张鎡","d":"宋","g":"词","p":["飞梦去，闲到玉京游。","尘隔天高那得暑，月明云薄淡於秋。","宫殿锁金虬。","冰佩冷，风扬紫绡裘。","五色光中瞻帝所，方知碧落胜炎洲。","香雾湿帘钩。"],"s":"mixed","f":"trad"},{"i":"c-f771b89940bc","t":"梦游仙・戚氏","a":"张鎡","d":"宋","g":"词","p":["归兴动，骑鹤下青冥。","几点山河浮色界，一簪风露拂寒星。","银汉悄无声。","鸾啸舞，仙乐送霓旌。","摘得琪花飞散了，却将何物送仙卿。","衣上彩云轻。"],"s":"mixed","f":"trad"},{"i":"c-16ca32dc805b","t":"昭君怨","a":"张鎡","d":"宋","g":"词","p":["拂晓拿舟东去。","细看荷花垂露。","红绿总吹香。","一般凉。","会享人天清福。","休把两眉轻蹙。","谁道做神仙。","戴貂蝉。"],"s":"mixed","f":"trad"}]