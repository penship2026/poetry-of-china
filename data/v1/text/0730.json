[{"i":"c-b96c40defd50","t":"望江南・忆江南","a":"吴文英","d":"宋","g":"词","p":["三月暮，花落更情浓。","人去秋千闲挂月，马停杨柳倦嘶风。","堤畔画船空。","恹恹醉，长日小帘栊。","宿燕夜归银烛外，啼莺声在绿阴中。","无处觅残红。"],"s":"simp","f":"trad"},{"i":"c-eaadc7a8f755","t":"采桑子","a":"吴文英","d":"宋","g":"词","p":["水亭花上三更月，扇与人闲。","弄影阑干。","玉燕重抽拢坠簪。","心期偷卜新莲子，秋入眉山。","翠破红残。","半簟湘波生晓寒。"],"s":"simp","f":"trad"},{"i":"c-bda29a832965","t":"清平乐","a":"吴文英","d":"宋","g":"词","p":["柔柯翦翠。","胡蝶双飞起。","谁堕玉细花径里。","香带熏风临水。","露红滴□秋枝。","金泥不染禅衣。","结得同心成了，任教春去多时。"],"s":"simp","f":"trad"},{"i":"c-7c846d407d54","t":"燕归梁","a":"吴文英","d":"宋","g":"词","p":["白玉搔头坠髻松。","怯冷翠裙重。","当时离佩解丁东。","澹云低、暮江空。","青丝结带鸳鸯盏，岁华晚、又相逢。","绿尘湘水避春风。","步归来、月宫中。"],"s":"simp","f":"trad"},{"i":"c-319eafb80274","t":"西江月","a":"吴文英","d":"宋","g":"词","p":["江上桃花流水，天涯芳草青山。","楼台春锁碧湾。","都入行人望眼。","一镜波平鸥去，千林日落鸦还。","天风袅袅送轻帆。","蓦过星槎银汉。"],"s":"simp","f":"trad"},{"i":"c-4c3e55d812d0","t":"满江红","a":"吴文英","d":"宋","g":"词","p":["翠暮深庭，露红晚、闲花自发。","春不断、亭台成趣，翠阴蒙密。","紫燕雏飞帘额静，金鳞影转池心阔。","有花香、竹色赋闲情，供吟笔。","闲问字，评风月。","时载酒，调冰雪。","似初秋入夜，浅凉欺葛。","人境不教车马近，醉乡莫放笙歌歇。","倩双成、一曲紫云回，红莲折。"],"s":"simp","f":"trad"},{"i":"c-c5dbd4afa81a","t":"夜行船","a":"吴文英","d":"宋","g":"词","p":["鸦带斜阳归远树。","无人听、数声钟暮。","日与愁长，心灰香断，月冷竹房扃户。","画扇青山吴苑路。","傍怀袖、梦飞不去。","忆别西池，红绡盛泪，肠断粉莲啼路。"],"s":"simp","f":"trad"},{"i":"c-9626ea39b99b","t":"好事近","a":"吴文英","d":"宋","g":"词","p":["翠冷石床云，海上偷传新曲。","弹作一檐风雨，碎芭蕉寒绿。","冰泉轻泻翠筒香，林果荐红玉。","早是一分秋意，到临窗修竹。"],"s":"simp","f":"trad"},{"i":"c-40f27a25c690","t":"虞美人影・桃源忆故人","a":"吴文英","d":"宋","g":"词","p":["黄包先著风霜劲。","独占一年佳景。","点点吴盐雪凝。","玉脍和齑冷。","洋园谁识黄金径。","一棹洞庭秋兴。","香荐兰皋汤鼎。","残酒西窗醒。"],"s":"simp","f":"trad"},{"i":"c-709504354410","t":"花上月令","a":"吴文英","d":"宋","g":"词","p":["文园消渴爱江清。","酒肠怯，怕深觥。","玉舟曾洗芙蓉水，泻清冰。","秋梦浅，醉云轻。","庭竹不收帘影去，人睡起，月空明。","瓦瓶汲井和秋叶，荐吟醒。","夜深重，怨遥更。"],"s":"simp","f":"trad"},{"i":"c-32b87b304af5","t":"卜算子","a":"吴文英","d":"宋","g":"词","p":["凉挂晓云轻，声度西风小。","井上梧桐应未知，一叶云鬟袅。","来雁带书迟，别燕归程早。","频探秋香开未开，恰似春来了。"],"s":"simp","f":"trad"},{"i":"c-ad4ea458ebaf","t":"凤栖梧・蝶恋花","a":"吴文英","d":"宋","g":"词","p":["开过南枝花满院。","新月西楼，相约同针线。","高树数声蝉送晚。","归家梦向斜阳断。","夜色银河情一片。","轻账偷欢，银烛罗屏怨。","陈迹晓风吹雾散。","帘钩空带蛛丝卷。"],"s":"simp","f":"trad"},{"i":"c-bc29ae495471","t":"霜天晓角","a":"吴文英","d":"宋","g":"词","p":["烟林褪叶。","红藉游人屧。","十里秋声松路，岚云重、翠涛涉。","伫立。","闲素箑。","画屏萝嶂叠。","明月双成归去，天风里、凤笙浃。"],"s":"simp","f":"trad"},{"i":"c-c4fc864570ef","t":"乌夜啼","a":"吴文英","d":"宋","g":"词","p":["西风先到岩扃。","月笼明。","金露啼珠滴翠，小银屏。","一颗颗，一星星。","是秋情。","香裂碧窗烟破，醉魂醒。"],"s":"simp","f":"trad"},{"i":"c-f373d0917601","t":"夜行船","a":"吴文英","d":"宋","g":"词","p":["逗晓阑干沾露水。","归期杳、画檐鹊喜。","粉汗馀香，伤秋中酒，月落桂花影里。","屏曲巫山和梦倚。","行云重、梦飞不起。","红叶中庭，绿尘斜□，应是宝筝慵理。"],"s":"simp","f":"trad"},{"i":"c-8f6137f8fd27","t":"凤栖梧・蝶恋花","a":"吴文英","d":"宋","g":"词","p":["湘水烟中相见早。","罗盖低笼，红拂犹娇小。","妆镜明星争晚照。","西风日送凌波杳。","惆怅来迟羞窈窕。","一霎留连，相伴阑干悄。","今夜西池明月到。","馀香翠被空秋晓。"],"s":"simp","f":"trad"},{"i":"c-b877a7b7b85e","t":"生查子","a":"吴文英","d":"宋","g":"词","p":["当楼月半奁，曾买菱花处。","愁影背阑干，素发残风露。","神前鸡酒盟，歌断秋香户。","泥落画梁空，梦想青春语。"],"s":"simp","f":"trad"},{"i":"c-ce08a09216d6","t":"霜天晓角","a":"吴文英","d":"宋","g":"词","p":["香莓幽径滑。","索绕秋曲折。","帘额红摇波影，鱼惊坠、暗吹沫。","浪阔。","轻棹拨。","武陵曾话别。","一点烟红春小，桃花梦、半林月。"],"s":"simp","f":"trad"},{"i":"c-4d54211eba89","t":"西江月","a":"吴文英","d":"宋","g":"词","p":["添线绣床人倦，翻香罗暮烟斜。","五更箫鼓贵人家。","门外晓寒嘶马。","帽压半檐朝雪，镜开千靥春霞。","小帘沽酒看梅花。","梦到林逋山下。"],"s":"simp","f":"trad"},{"i":"c-607cc251d14b","t":"恋绣衾","a":"吴文英","d":"宋","g":"词","p":["频摩书眼怯细文。","小窗阴、天气似昏。","兽炉暖、慵添困，带茶烟、微润宝薰。","少年娇马西风冷，旧春衫、犹涴酒痕。","梦不到、梨花路，断长桥、无限暮云。"],"s":"simp","f":"trad"},{"i":"c-df00c53c50e3","t":"杏花天","a":"吴文英","d":"宋","g":"词","p":["鬓棱初翦玉纤弱。","早春入、屏山四角。","少年买困成欢谑。","人在浓香绣幄。","霜丝换、梅残梦觉。","夜寒重、长安紫陌。","东风入户先情薄。","吹老灯花半萼。"],"s":"simp","f":"trad"},{"i":"c-918ffe7529da","t":"醉桃源・阮郎归","a":"吴文英","d":"宋","g":"词","p":["五更枥马静无声。","邻鸡犹怕惊。","日华平晓弄春明。","暮寒愁翳生。","新岁梦，去年情。","残宵半酒醒。","春风无定落梅轻。","断鸿长短亭。"],"s":"simp","f":"trad"},{"i":"c-c49f1ed444e4","t":"好事近","a":"吴文英","d":"宋","g":"词","p":["雁外雨丝丝，将恨和愁都织。","玉骨西风添瘦，减尊前歌力。","袖香曾枕醉红腮，依约唾痕碧。","花下凌波入梦，引春雏双鶒。"],"s":"simp","f":"trad"},{"i":"c-4a88f400340a","t":"忆旧游","a":"吴文英","d":"宋","g":"词","p":["送人犹未苦，苦送春、随人去天涯。","片红都飞尽，正阴阴润绿，暗裹啼鸦。","赋情顿雪双鬓，飞梦逐尘沙。","叹病渴凄凉，分香瘦减，两地看花。","西湖断桥路，想系马垂杨，依旧敧斜。","葵麦迷烟处，问离巢孤燕，飞过谁家。","故人为写深怨，空壁扫秋蛇。","但醉上吴台，残阳草色归思赊。"],"s":"simp","f":"trad"},{"i":"c-b5cf7ead602f","t":"宴清都","a":"吴文英","d":"宋","g":"词","p":["病渴文园久。","梨花月，梦残春故人旧。","愁弹枕雨，衰翻帽雪，为情僝僽。","千金醉跃骄骢，试问取、朱桥翠柳。","痛恨不、买断斜阳，西湖酝入春酒。","吴宫乱水斜烟，留连倦客，慵更回首。","幽蛩韵苦，哀鸿叫绝，断音难偶。","题红泛叶零乱，想夜冷、江枫暗瘦。","付与谁、一半悲秋，行云在否。"],"s":"simp","f":"trad"},{"i":"c-591e50c9478f","t":"金缕歌・贺新郎","a":"吴文英","d":"宋","g":"词","p":["乔木生云气。","访中兴、英雄陈迹，暗追前事。","战舰东风悭借便，梦断神州故里。","旋小筑、吴宫闲地。","华表月明归夜鹤，叹当时、花竹今如此。","枝上露，溅清泪。","遨头小簇行春队。","步苍苔、寻幽别坞，问梅开未。","重唱梅边吸度曲，催发寒梢冻蕊。","此心与、东君同意。","后不如今非昔，两无言、相对沧浪水。","怀此恨，寄残醉。"],"s":"simp","f":"trad"},{"i":"c-5fae2806cef4","t":"醉落魄・一斛珠","a":"吴文英","d":"宋","g":"词","p":["柔怀难托。","老天如水人情薄。","烛痕犹刻西窗约。","歌断梨云，留梦绕罗幕。","寒更唱遍吹梅角。","香消臂趁弓弰削。","主家衣在羞重著。","独掩营门，春尽柳花落。"],"s":"simp","f":"trad"},{"i":"c-1475809ca9c7","t":"朝中措","a":"吴文英","d":"宋","g":"词","p":["晚妆慵理瑞云盘。","针线傍灯前。","燕子不归帘卷，海棠一夜孤眠。","踏青人散，遗细满路，雨打秋千。","尚有落花寒在，绿杨未褪春绵。"],"s":"simp","f":"trad"},{"i":"c-fdc35bd762b2","t":"青玉案","a":"吴文英","d":"宋","g":"词","p":["短亭芳草长亭柳。","记桃叶，烟江口。","今日江村重载酒。","残杯不到，乱红青冢，满地闲春绣。","翠阴曾摘梅枝嗅。","还忆秋千玉葱手。","红索倦将春去后。","蔷薇花落，故园胡蝶，粉薄残香瘦。"],"s":"simp","f":"trad"},{"i":"c-507a808d01cd","t":"青玉案","a":"吴文英","d":"宋","g":"词","p":["新腔一唱双金斗。","正霜落、分甘手。","已是红窗人倦绣。","春词裁烛，夜香温被，怕减银壶漏。","吴天雁晓云飞后。","百感情怀顿疏酒。","彩扇何时翻翠袖。","歌边拌取，醉魂和梦，化作梅边瘦。"],"s":"simp","f":"trad"},{"i":"c-6ba5686b30bb","t":"好事近","a":"吴文英","d":"宋","g":"词","p":["飞露洒银床，叶叶怨梧啼碧。","蕲竹粉连香汗，是秋来陈迹。","藕丝空缆宿湖船，梦阔水云窄。","还系鸳鸯不在，老红香月白。"],"s":"simp","f":"trad"},{"i":"c-5a5e0738d076","t":"杏花天","a":"吴文英","d":"宋","g":"词","p":["幽欢一梦成炊黍。","知绿暗、汀菰几度。","竹西歌断芳尘去。","宽尽经年臂缕。","梅黄后、林梢更雨。","小池面、啼红怨暮。","当时明月重生处。","楼上宫眉在否。"],"s":"simp","f":"trad"},{"i":"c-da753603bf51","t":"浪淘沙","a":"吴文英","d":"宋","g":"词","p":["灯火雨中船。","客思绵绵。","离亭春草又秋烟。","似与轻鸥盟未了，来去年年。","往事一潸然。","莫过西园。","凌波香断绿苔钱。","燕子不知春事改，时立秋千。"],"s":"simp","f":"trad"},{"i":"c-62d201720063","t":"思佳客","a":"吴文英","d":"宋","g":"词","p":["迷蝶无踪晓梦沈。","寒香深闭小庭心。","欲知湖上春多少，但看楼前柳浅深。","愁自遣，酒孤斟。","一帘芳景燕同吟。","杏花宜带斜阳看，几阵东风晚又阴。"],"s":"simp","f":"trad"},{"i":"c-058df5abb678","t":"采桑子慢","a":"吴文英","d":"宋","g":"词","p":["桐敲露井，残照西窗人起。","怅玉手、曾携乌纱，笑整风敧。","水叶沈红，翠微云冷雁慵飞。","楼高莫上，魂消正在，摇落江蓠。","走马断桥，玉台妆榭，罗帕香遗。","叹人老、长安灯外，愁换秋衣。","醉把茱萸，细看清泪湿芳枝。","重阳重处，寒花怨蝶，新月东篱。"],"s":"simp","f":"trad"},{"i":"c-12cbb1440c7f","t":"古香慢","a":"吴文英","d":"宋","g":"词","p":["怨娥坠柳，离佩摇荭，霜讯南圃。","漫忆桥扉，倚竹袖寒日暮。","还问月中游，梦飞过、金风翠羽。","把残云、剩水万顷，暗熏冷麝凄苦。","渐浩渺、凌山高处。","秋澹无光，残照谁主。","露粟侵肌，夜约羽林轻误。","翦碎惜秋心，更肠断、珠尘藓路。","怕重阳，又催近、满城细雨。"],"s":"simp","f":"trad"},{"i":"c-feab62564bfd","t":"蹋莎行・踏莎行","a":"吴文英","d":"宋","g":"词","p":["杨柳风流，蕙花清润。","苹□未数张三影。","沈香倚醉调清平，新辞□□□□□。","鲛室裁绡，□□□□。","□□白雪争歌郢。","西湖同结杏花盟，东风休赋丁香恨。"],"s":"mixed","f":"trad"},{"i":"c-e6adbd119255","t":"失调名","a":"吴文英","d":"宋","g":"词","p":["霜杵敲寒，风灯摇梦。"],"s":"simp","f":"trad"},{"i":"c-f33151cf7ee7","t":"烛影摇红","a":"翁元龙","d":"宋","g":"词","p":["蜀锦华堂，宝筝频送花前酒。","妖娆全在半开时，人试单衣后。","花面围春竞秀。","如红潮、玉腮微透。","欲苏还坠，浅醉扶头，朦胧晴昼。","金屋名姝，眼情空伫闲眉岫。","世间还有此娉婷，拼尽珠量斗。","真艳可令消受。","倩莺催、天香共袖。","冷烟庭院，淡月梨花，空教春瘦。"],"s":"simp","f":"trad"},{"i":"c-b0cca7591754","t":"齐天乐","a":"翁元龙","d":"宋","g":"词","p":["曲廊连苑吹笙道，重来暗尘都满。","种石生云，移花带月，犹欠藏春庭院。","年华过眼。","便梅谢兰销，舞沈歌断。","露井寒蛩，为谁清夜诉幽怨。","人生乐事最少，有时得意处，光阴偏短。","树色凝红，山眉弄碧，不与朱颜相恋。","临风念远。","叹蝶梦难追，鹭盟重换。","一片斜阳，送人归骑晚。"],"s":"simp","f":"trad"},{"i":"c-ebbee66396bb","t":"菩萨蛮","a":"翁元龙","d":"宋","g":"词","p":["春心莫共花争发。","花开不管连环缺。","梦断小楼空。","杜鹃啼晓红。","眼看连理树。","纤手移筝柱。","调遍错成声。","无人知此情。"],"s":"simp","f":"trad"},{"i":"c-d13fb6b5e1b4","t":"菩萨蛮","a":"翁元龙","d":"宋","g":"词","p":["玉纤闲捻花间集。","赤阑干对芭蕉立。","薤叶晚生凉。","竹阴移小床。","拗莲牵藕线。","藕断丝难断。","弹水没鸳鸯。","教寻波底香。"],"s":"simp","f":"trad"},{"i":"c-8b1e65450d3f","t":"倦寻芳","a":"翁元龙","d":"宋","g":"词","p":["燕帘挂晚。","莺槛迷晴，花思零乱。","试觅娉婷，日日傍湖亭苑。","掷果墙阴窥驻马，采香深迳抛春扇。","醉归来，任钗云半落，绣帘慵卷。","念灿锦、年华如旧，飞絮游丝，萦恨难翦。","蜀羽无情，早带怨红啼断，厚约轻辞寒食夜，行云空梦梨花院。","莫凭阑，正斜阳、淡烟平远。"],"s":"simp","f":"trad"},{"i":"c-a2805cef33eb","t":"瑞龙吟","a":"翁元龙","d":"宋","g":"词","p":["清明近。","还是递趱东风，做成花讯。","芳时一刻千金，半晴半雨、酬春未准。","雁归尽。","离字向人欲写，暗云难认。","西园猛忆逢迎，翠纨障面，花间笑隐。","曲径池莲平砌，绛裙曾与，濯香湔粉。","无奈燕幕莺帘，轻负娇俊。","青榆巷陌，蹋马红成寸。","十年梦、秋千吊影，袜罗尘褪。","事往凭谁问。","昼长病酒添新恨。","烟冷斜阳紧。","山黛远、曲曲阑干凭损。","柳丝万尺，不如轻鬓。"],"s":"simp","f":"trad"},{"i":"c-9fcb775d4594","t":"隔浦莲近・隔浦莲近拍","a":"翁元龙","d":"宋","g":"词","p":["街檐插缀翠柳。","憔悴清明后。","泪蜡堆香径，一夜海棠中酒。","枝上酸似豆。","莺声骤。","恨软弹筝手。","搵眉袖。","嘶骢过尽平芜，绿衬飞绣。","沈红入水，渐做小莲离藕。","亭冷沈香梦似旧。","花瘦。","欲留春住时候。"],"s":"mixed","f":"trad"},{"i":"c-6b05b66b1994","t":"玲珑四犯","a":"翁元龙","d":"宋","g":"词","p":["窗外啼莺，报数日西园，花事都空。","绣屋专房，姚魏渐邀新宠。","葱翠试剪春畦，羞对酒、夜寒犹重。","误暗期、绿架香洞。","月黯小阶云冻。","算春将揽邮亭鞚。","柳成圈、记人迎送。","蜀魂怨染岩花色，泥径红成陇。","楼上半揭画帘，料看雨、玉笙寒拥。","怕骤晴，无事消遣，日长清梦。"],"s":"simp","f":"trad"},{"i":"c-a3bf0c9aea0f","t":"风流子","a":"翁元龙","d":"宋","g":"词","p":["天阔玉屏空。","轻阴弄、淡墨画秋容。","正凉挂半蟾，酒醒窗下，露催新雁，人在山中。","又一片，好秋花占了，香换却西风。","箫女夜归，帐栖青凤，镜娥妆冷，钗坠金虫。","西湖花深窈，闲庭砌、曾占席地歌钟。","载取断云归去，几处房栊。","恨小帘灯暗，粟肌消瘦，薰炉烟减，珠袖玲珑。","三十六宫清梦，还与谁同。"],"s":"simp","f":"trad"},{"i":"c-d6bf53795663","t":"西江月","a":"翁元龙","d":"宋","g":"词","p":["山色低衔小苑，春云暗宿空庭。","秋千无月冷双绳。","闲却画栏人静。","一夜海棠如梦，半窗银烛多情。","好花留不到清明。","日日阴晴无定。"],"s":"simp","f":"trad"},{"i":"c-091da3ae3443","t":"忆秦娥","a":"翁元龙","d":"宋","g":"词","p":["三月时。","杨花飞尽无花飞。","无花飞。","不教春去，争得春归。","高楼望断黄金羁。","绿窗眉黛伤新离。","伤新离。","好将别后，长做归时。"],"s":"simp","f":"trad"},{"i":"c-c3dd6bbaa49a","t":"恋绣衾","a":"翁元龙","d":"宋","g":"词","p":["兽炉烟重火半焦。","卷帘时、雪意又销。","过数点、残鸦外，想梅花、寒在灞桥。","谢娘春恨深如柳，未东风、先遣絮飘。","且莫把、冰丝剪，有灯球、红绣未描。"],"s":"simp","f":"trad"},{"i":"c-044ee892985f","t":"水龙吟","a":"翁元龙","d":"宋","g":"词","p":["画楼红湿斜阳，素妆褪出山眉翠。","街声暮起，尘侵灯户，月来舞地。","宫柳招莺，水荭飘雁，隔年春意。","黯梨云，散作人间好梦，琼箫在、锦屏底。","乐事轻随流水。","暗兰消、作花心计。","情丝万轴，因春织就，愁罗恨绮。","昵沈迷香，占帘看夜，旧游轻醉。","任孤山、剩雪残梅，渐懒跨、东风骑。"],"s":"mixed","f":"trad"},{"i":"c-8130993601c0","t":"醉桃源・阮郎归","a":"翁元龙","d":"宋","g":"词","p":["千丝风雨万丝晴。","年年长短亭。","暗黄看到绿成阴。","春由他送迎。","莺思重，燕愁轻。","如人离别情。","绕湖烟冷罩波明。","画船移玉笙。"],"s":"simp","f":"trad"},{"i":"c-a0c2d4fd886c","t":"谒金门","a":"翁元龙","d":"宋","g":"词","p":["莺树暖。","弱絮欲成芳茧。","流水惜花流不远。","小桥红欲满。","原上草迷离苑。","金勒晚风嘶断。","等得日长春又短。","愁深山翠浅。"],"s":"simp","f":"trad"},{"i":"c-680e95f27bd1","t":"绛都春","a":"翁元龙","d":"宋","g":"词","p":["花娇半面。","记蜜烛夜阑，同醉深院。","衣袖粉香，犹未经年如年远。","玉颜不趁秋容换。","但换却、春游同伴。","梦回前度，邮亭倦客，又拈笺管。","慵按。","梁州旧曲，怕离柱断弦，惊破金雁。","霜被睡浓，不比花前良宵短。","秋娘羞占东篱畔。","待说与、深宫幽怨。","恨他情淡陶郎，旧缘较浅。"],"s":"simp","f":"trad"},{"i":"c-70a2d76ffc49","t":"江城子","a":"翁元龙","d":"宋","g":"词","p":["一年箫鼓又疏钟。","爱东风。","恨东风。","吹落灯花，移在杏梢红。","玉靥翠钿无半点，空湿透，绣罗弓。","燕魂莺梦渐惺松。","月帘栊。","影迷濛。","催趁年华，都在艳歌中。","明日柳边春意思，便不与，夜来同。"],"s":"mixed","f":"trad"},{"i":"c-7adae7cf3a8c","t":"西江月","a":"翁元龙","d":"宋","g":"词","p":["画阁换黏春贴，宝筝抛学银钩。","东风轻滑玉钗流。","织就燕纹莺绣。","隔帐灯花微笑，倚窗云叶低收。","双鸳刺罢底尖头。","剔雪闲寻豆蔻。"],"s":"simp","f":"trad"},{"i":"c-bb4767fee38b","t":"朝中措","a":"翁元龙","d":"宋","g":"词","p":["花情偏与夜相投。","心事鬓边羞。","薰醒半床凉梦，能消几个开头。","风轮慢卷，冰壶低架，香雾飕飕。","更著月华相恼，木犀淡了中秋。"],"s":"simp","f":"trad"},{"i":"c-de3c19d17e2e","t":"鹊桥仙","a":"翁元龙","d":"宋","g":"词","p":["天长地久，风流云散，惟有离情无算。","从分金镜不成圆，到此夜、年年一半。","轻罗暗网，蛛丝得意，多似妆楼针线。","晓看玉砌淡无痕，但吹落、梧桐几片。"],"s":"simp","f":"trad"},{"i":"c-8f56ded48598","t":"烛影摇红","a":"翁孟寅","d":"宋","g":"词","p":["楼倚春城，锁窗曾共巢春燕。","人生好梦比春风，不似杨花健。","旧事如天渐远。","奈情缘、素丝未断。","镜尘埋恨，带粉栖香，曲屏寒浅。","环佩空归，故园羞见桃花面。","轻烟残照下阑干，独自疏帘卷。","一信狂风又晚。","海棠花、随风满院。","乱鸦归后，杜宇啼时，一声声怨。"],"s":"simp","f":"trad"},{"i":"c-1e6b2124335e","t":"阮郎归","a":"翁孟寅","d":"宋","g":"词","p":["月高楼外柳花明。","单衣怯露零。","小桥灯影落残星。","寒烟蘸水萍。","歌袖窄，舞鬟轻。","梨花梦满城。","落红啼鸟两无情。","春愁添晓酲。"],"s":"simp","f":"trad"},{"i":"c-de81ddedc00b","t":"齐天乐","a":"翁孟寅","d":"宋","g":"词","p":["幽香不受春料理，青青尚馀秋鬓。","磵曲岩隈，烟梳露浴，甘与菰蒲共隐。","芳标瘦迥。","看缨结丁香，带萦晴荇。","恨水东流，楚江憔悴乱云暝。","凄凉梦游故苑，纵妒花风暴，吹梦难醒。","艳李妖桃，纡青佩紫，争似广文官冷。","尘波万顷。","算谁是同心，自怜孤影。","收敛风流，素弦清夜永。"],"s":"simp","f":"trad"},{"i":"c-7ea8689151d7","t":"齐天乐","a":"翁孟寅","d":"宋","g":"词","p":["红香十里铜驼梦，如今旧游重省。","节序飘零，欢娱老大，慵立灯光蟾影。","伤心对景。","怕回首东风，雨晴难准。","曲巷幽坊，管弦一片笑声近。","飞棚浮动翠葆，看金钗半溜，春妒红粉。","凤辇鳌山，云收雾敛，迤逦铜壶漏迥。","霜风渐紧。","展一幅青绡，净悬孤镜。","带醉扶归，晓酲春梦稳。"],"s":"simp","f":"trad"},{"i":"c-fa3631fb113a","t":"摸鱼儿","a":"翁孟寅","d":"宋","g":"词","p":["卷西风、方肥塞草，带钩何事东去。","月明万里关河梦，吴楚几番风雨。","江上路。","二十载头颅，凋落今如许。","凉生弄尘。","叹江左夷吾，隆中诸葛，谈笑已尘土。","寒汀外，还见来时鸥鹭。","重来应是春暮。","轻裘岘首陪登眺，马上落花飞絮。","拼醉舞。","谁解道，断肠贺老江南句。","沙津少驻。","举目送飞鸿，幅巾老子，楼上正凝伫。"],"s":"simp","f":"trad"},{"i":"c-288d24bc0a60","t":"蝶恋花","a":"万俟绍之","d":"宋","g":"词","p":["啼鴂一声云榭晚。","好梦惊回，蓬岛疑行遍。","无绪东风帘自卷。","香苞云压荼䕷院。","似有还无烟色展。","絮暖鱼肥，时复吹池面。","扇影著花蜂蝶见。","药栏春静红尘远。"],"s":"simp","f":"trad"},{"i":"c-e064d6ba1fa8","t":"风入松","a":"万俟绍之","d":"宋","g":"词","p":["一春心事与谁同。","绿聚眉峰。","小楼彻夜听鸣雨，想西园、锦绣成空。","栏漾金鱼池水，钩闲紫燕帘风。","年时忻折海棠红。","来比芳容。","如今玉减香销似，怕轻寒、懒出房栊。","尘满谢娘吟卷，从教飞絮濛濛。"],"s":"mixed","f":"trad"},{"i":"c-8b827e72467a","t":"贺新郎","a":"万俟绍之","d":"宋","g":"词","p":["决眦入飞鸟。","正江南、梅雨初晴，乱山浮晓。","凤去台空箫声断，惟有疏林鸦噪。","但空锁、吴时花草。","指点中原青山外，奈征尘、迷望愁云绕。","佳丽地，谩凝眺。","清风助我舒长啸。","问其中、虚帘曲槛，阅人多少。","风景不殊江山在，况是英雄未老。","且拚与、尊前一笑。","欲说前朝兴亡事，唤谪仙、来共传清醥。","归路晚，月明照。"],"s":"mixed","f":"trad"},{"i":"c-6105e85f6583","t":"江神子・江城子","a":"万俟绍之","d":"宋","g":"词","p":["十年心事上眉端。","梦惊残。","琐窗寒。","云絮随风，千里度关山。","琴里知音无觅处，妆粉淡，钏金宽。","瑶箱吟卷懒重看。","忆前欢。","泪偷弹。","我已相将，飞棹过长安。","为说崔徽憔悴损，须觅取，锦笺还。"],"s":"simp","f":"trad"},{"i":"c-de32191e7991","t":"水龙吟","a":"丁宥","d":"宋","g":"词","p":["雁风吹裂云痕，小楼一线斜阳影。","残蝉抱柳，寒蛩入户，凄音忍听。","愁不禁秋，梦还惊客，青灯孤枕。","未更深，早是梧桐泫露，那更度、兰宵永。","空叹银屏金井。","醉乡醒、温柔乡冷。","征尘倦扑，闲花谩舞，何心管领。","葱指冰弦，蕙怀春锦，楚梅风韵。","怅芙蓉城杳，蓝云依黯，锁巫峰暝。"],"s":"simp","f":"trad"},{"i":"c-0e15ac7681b0","t":"法曲献仙音","a":"丁宥","d":"宋","g":"词","p":["蝉碧句花，雁红攒月。"],"s":"simp","f":"trad"},{"i":"c-2cdd9aa669fe","t":"失调名","a":"丁宥","d":"宋","g":"词","p":["疏绮笼寒，浅云栖月。"],"s":"simp","f":"trad"},{"i":"c-7d85cf74fe51","t":"六么令","a":"丁宥","d":"宋","g":"词","p":["清阴一架，颗颗蒲萄醉花碧。"],"s":"simp","f":"trad"},{"i":"c-a4dd3aba5e85","t":"瑞鹤仙","a":"周氏","d":"宋","g":"词","p":["画楼帘卷翠。","正柳约东风，摇荡春霁。","缃桃雨才洗。","似妆临宝镜。","脂凝铅水。","云偏髻子。","坠钗梁、羞看燕垒。","最堪怜，锦绣香中，早有片红飘砌。","闲记。","琴弹古调，曲按清商，旧年时事。","屏山画里。","江南信，梦中寄。","感春浓怀抱，午酲初解，浅酌依然又醉。","傍阑干、犹怯馀寒，倦和袖倚。"],"s":"simp","f":"trad"},{"i":"c-840ad63f3f57","t":"水龙吟","a":"潘牥","d":"宋","g":"词","p":["（上缺）玉带悬鱼，黄金铸印，侯封万户。","待从头，缴纳君王，觅取爱卿归去。"],"s":"simp","f":"trad"},{"i":"c-2aec2777f4ba","t":"南乡子","a":"潘牥","d":"宋","g":"词","p":["生怕倚阑干。","阁下溪声阁外山。","惟有旧时山共水，依然。","暮雨朝云去不远。","应是蹑飞鸾。","月下时时整佩环。","月又渐低霜又下，更阑。","折得梅花独自看。"],"s":"simp","f":"trad"},{"i":"c-c2de960ef654","t":"乌夜啼","a":"潘牥","d":"宋","g":"词","p":["无端小雪廉纤。","入平檐。","金鸭旋添龙饼，莫开帘。","寻梅约。","开还落。","可曾忺。","合作一年春恨，上眉尖。"],"s":"simp","f":"trad"},{"i":"c-18d4d9ca3f10","t":"满江红","a":"潘牥","d":"宋","g":"词","p":["筑室依崖，春风送、一帘山色。","沙岛外，渔樵而已，别无闲客。","醉后和友眠犊背，醒来瀹茗寻泉脉。","把心情、分付陇头云，溪边石。","身未老，头先白。","人不见，山空碧。","约钓竿共把，自惭钩直。","相蜀吞吴成底事，何如只抱隆中膝。","漫长歌、歌罢悄无言，看青壁。"],"s":"simp","f":"trad"},{"i":"c-13854c707426","t":"洞仙歌","a":"潘牥","d":"宋","g":"词","p":["雕檐绮户，倚晴空如画。","曾是吴王旧台榭。","自浣纱去后，落日平芜，行云断，几见花开花谢。","凄凉阑干外，一簇江山，多少图王共争霸。","莫闲愁、金杯潋滟，对酒当歌，欢娱地、梦中兴亡休话。","渐倚遍、西风晚潮生，明月里、鹭鹚背人飞下。"],"s":"simp","f":"trad"},{"i":"c-783891521d19","t":"霜天晓角","a":"赵希��","d":"宋","g":"词","p":["姮娥戏剧。","手种长生粒。","宝干婆娑千古，飘芳吹满虚碧。","韵色。","檀露滴。","人间秋第一。","金粟如来境界，谁移在、小亭侧。"],"s":"simp","f":"trad"},{"i":"c-dab7ef26742c","t":"秋蕊香","a":"赵希□","d":"宋","g":"词","p":["髻稳冠宜翡翠。","压鬓彩丝金蕊。","远山碧浅蘸秋水。","香暖榴裙衬地。","亭亭二八馀年纪。","恼春意。","玉云凝重步尘细。","独立花阴宝砌。"],"s":"simp","f":"trad"},{"i":"c-6f9e36ab4809","t":"摸鱼儿","a":"孙吴会","d":"宋","g":"词","p":["八窗空、展宽秋影，长江流入尊俎。","天围绀碧低群岫，斜日去鸿堪数。","沈别浦。","但目断、烟芜莽苍连平楚。","晨钟暮鼓。","算触景多愁，关人底事，倚槛听鸣橹。","英雄恨，赢得名存北府。","寄奴今寄何所。","西风依旧潮来去，山海颉颃吞吐。","霜月古。","直耐冷、相随燕我瑶芝圃。","掀髯起舞。","看羱伏苍苔，龙吟翠葆，天籁奏韶舞。"],"s":"simp","f":"trad"},{"i":"c-4e0a8ce0f106","t":"临江仙","a":"赵溍","d":"宋","g":"词","p":["堤曲朱墙近远，山明碧瓦高低。","好风二十四花期。","骄骢穿柳去，文艗挟春飞。","箫鼓晴雷殷殷，笑歌香雾霏霏，闲情不受酒禁持。","断肠无立处，斜日欲归时。"],"s":"simp","f":"trad"},{"i":"c-75a2485f457a","t":"吴山青・长相思","a":"赵溍","d":"宋","g":"词","p":["金璞明。","玉璞明。","小小杯柈翠袖擎。","满将春色盛。","仙佩鸣。","玉佩鸣。","雪月花中过洞庭。","此时人独清。"],"s":"simp","f":"trad"},{"i":"c-810b1fd2360d","t":"庆宫春・高阳台","a":"刘澜","d":"宋","g":"词","p":["春翦绿波，日明金渚，镜光尽浸寒碧。","喜溢双蛾，迎风一笑，两情依旧脉脉。","那时同醉，锦袍湿、乌纱敧侧。","英雄何在，满目青山，飞下孤白。","片帆谁上天门，我亦明朝，是天门客。","平生高兴，青莲一叶，从此飘然八极。","矶头绿树，见白马、书生破敌。","百年前事，欲问东风，酒醒长笛。"],"s":"simp","f":"trad"},{"i":"c-a41b6b197d10","t":"瑞鹤仙","a":"刘澜","d":"宋","g":"词","p":["向阳看未足。","更露立阑干，日高人独。","江空佩鸣玉。","问烟鬟霞脸，为谁膏沐。","情闲景淑。","嫁东风、无媒自卜。","凤台高，贪伴吹笙，惊下九天霜鸪。","红蹙。","花开不到，杜老溪庄，已公茅屋。","山城水国。","欢易断，梦难续。","记年时马上，人酣花醉，乐奏开元旧曲。","夜归来，驾锦漫天，绛纱万烛。"],"s":"simp","f":"trad"},{"i":"c-d568dec4f535","t":"齐天乐","a":"刘澜","d":"宋","g":"词","p":["玉钗分向金华后，回头路迷仙苑。","落翠惊风，流红逐水，谁信人间重见。","花深半面。","尚歌得新词，柳家三变。","绿叶阴阴，可怜不似那时看。","刘郎今度更老，雅怀都不到，书带题扇。","花信风高，苕溪月冷，明日云帆天远。","尘缘较短。","怪一梦轻回，酒阑歌散。","别鹤惊心，感时花泪溅。"],"s":"simp","f":"trad"},{"i":"c-3d9d27e8ebee","t":"买陂塘・摸鱼儿","a":"刘澜","d":"宋","g":"词","p":["御风来、翠乡深处，连天云锦平远。","卧游已动蓬舟兴，那在芙蓉城畔。","巾懒岸。","任压顶嵯峨，满鬓丝零乱。","飞吟水殿。","载十丈青青，随波弄粉，菰雨泪如霰。","斜阳外，也有新妆半面。","无言应对花怨。","西湖千顷腥尘暗。","更忆鉴湖一片。","何日见。","试折藕占丝，丝与肠俱断。","遐征渐倦。","当颍尾湖头，绿波彩笔，相伴老坡健。"],"s":"simp","f":"trad"},{"i":"c-7d6a1632a627","t":"水调歌头","a":"魏庭玉","d":"宋","g":"词","p":["璧月挂银汉，冷浸一江秋。","天公付我清赏，仙籍桂香浮。","极目江山如画，际晚云烟凝紫，秋色豁羁愁。","领看上雄观，波影动帘钩。","雁排空，渔唱晚，楚天幽。","湖阴一曲千载，成败倩谁筹。","试问谪仙何处，唤起于湖同醉，小为作遨头。","老子欲起舞，摆脱利名休。"],"s":"simp","f":"trad"},{"i":"c-3228d7827abe","t":"贺新凉・贺新郎","a":"魏庭玉","d":"宋","g":"词","p":["暮雨初收霁。","凭阑干、一江新绿，远山凝翠。","漠漠春阴添客思，怅望天涯无际。","又猛省、平生行止。","楚尾吴头多少恨，付吟边、醉里消磨矣。","浮世事，只如此。","阳关三叠徒劳耳。","也何须、琵琶江上，掩青衫泪。","一斗百篇乘逸兴，要借青天为纸。","儿辈诧、龙蛇飞起。","今夜月明呼酒处，待明朝、酒醒帆千里。","且为我，唱新制。"],"s":"simp","f":"trad"},{"i":"c-79a5b000d970","t":"晴偏好","a":"李霜涯","d":"宋","g":"词","p":["平湖百顷生芳草。","芙蓉不照红颠倒。","东坡道。","波光潋滟晴偏好。"],"s":"simp","f":"trad"},{"i":"c-d2fe3bad81a6","t":"渔父词・渔父","a":"王谌","d":"宋","g":"词","p":["兰芷流来水亦香。","满汀鸥鹭动斜阳。","声诶乃，间鸣榔。","侬家只合岸西旁。"],"s":"simp","f":"trad"},{"i":"c-22666629fcd3","t":"渔父词・渔父","a":"王谌","d":"宋","g":"词","p":["翁妪齐眉妇亦贤。","小姑颜貌正笄年。","头发乱，髻鬟偏。","爱把花枝立舵前。"],"s":"simp","f":"trad"},{"i":"c-7b8e6bcd0269","t":"渔父词・渔父","a":"王谌","d":"宋","g":"词","p":["湘妃泪染竹痕斑。","风雨连朝下钓难。","春浪急，石矶寒。","买得茅柴味亦酸。"],"s":"simp","f":"trad"},{"i":"c-360d29e79b28","t":"渔父词・渔父","a":"王谌","d":"宋","g":"词","p":["满湖飞雪搅长空。","急起呼儿上短蓬。","箬笠具，画图同。","铁笛声长曲未终。"],"s":"simp","f":"trad"},{"i":"c-aa0b44642a76","t":"渔父词・渔父","a":"王谌","d":"宋","g":"词","p":["离骚读罢怨声声。","曾向江边问屈平。","醒还醉，醉还醒。","笑指沧浪可濯缨。"],"s":"simp","f":"trad"},{"i":"c-21cc56760152","t":"渔父词・渔父","a":"王谌","d":"宋","g":"词","p":["白发髼松不记年。","扁舟泊在荻花边。","天上月，水中天。","夜夜烟波得意眠。"],"s":"simp","f":"trad"},{"i":"c-bfbab0e3ceae","t":"渔父词・渔父","a":"王谌","d":"宋","g":"词","p":["只在青山可卜邻。","妻儿笑语意全真。","休识字，莫嫌贫。","方是安闲第一人。"],"s":"simp","f":"trad"},{"i":"c-57e9b7b598d7","t":"万年欢","a":"厉寺正","d":"宋","g":"词","p":["卫武期颐，与文公福艾，俱号贤相。","今我元台，齿德又居其上。","玉立擎天一柱，似泰华、气凌秋庄。","明良会，千载风云，长为龙衮凭仗。","清知孔山叠嶂。","有猿吟鹤舞，日俟鸠杖。","无忝苍生依依，未容高尚。","待整顿、乾坤了当，与蓬岛、神仙来往。","摩铜狄，点检笙歌，菊浮香泛新酿。"],"s":"simp","f":"trad"},{"i":"c-bcaf89bc0d46","t":"摸鱼儿","a":"施枢","d":"宋","g":"词","p":["柳蒙茸、暗凌波路。","烟飞惨淡平楚。","七香车驻猊环掩，遥认翠华云母。","芳景暮。","鸳甃悄、铢衣来按飞琼舞。","凄凉洛浦。","渐玉漏沈沈，清阴满地，乘月步虚去。","销凝处。","谁说三生小杜。","翔螭声断箫鼓。","情知禁苑酥尘涴，羞与倡红同谱。","春几度。","想依旧、苔痕长印唐昌土。","风流千古。","人在小红楼，朱帘半卷，香注玉壶露。"],"s":"simp","f":"trad"},{"i":"c-afb7d0c1463b","t":"疏影","a":"施枢","d":"宋","g":"词","p":["低枝亚实。","望翠阴护晓，幽梦难觅。","凄楚霓裳，琼阙瑶台，经年暗锁清逸。","春风似怪重门掩，未许入、玉堂吟笔。","想寿阳，却厌新妆，倦抹粉花宫额。","还记孤山旧路，未应便负了，波冷蟾白。","莫寄相思，惟有寒烟，伴我骚人闲寂。","东君须自怜疏影，又何待、山前雪积。","好试敲、羯鼓声催，与约鼎羹消息。"],"s":"simp","f":"trad"},{"i":"c-3a61d96e98e6","t":"柳梢青","a":"施枢","d":"宋","g":"词","p":["飞露初霜。","冷侵金井，响到银床。","懊恨碧梧，不留一叶，月占纱窗。","雁声做尽凄凉。","又陡顿、衾寒夜长。","曲曲屏山，重重客梦，无限思量。"],"s":"simp","f":"trad"}]