[{"i":"6f3490a4-e938-481e-8a93-c415b7ccbc20","t":"辭蜀相妻女詩","a":"黃崇嘏","d":"唐","g":"短诗","p":["一辭拾翠碧江湄，貧守蓬茅但賦詩。","自服藍衫居郡掾，永拋鸞鏡畫蛾眉。","立身卓爾青松操，挺志鏗然白璧姿。","幕府若容爲坦腹，願天速變作男兒。"],"s":"mixed","f":"simp"},{"i":"a45ceb95-2a3e-4844-a36f-9e46ea2e3b2f","t":"荅諸姊妹戒飲","a":"蔣氏","d":"唐","g":"短诗","p":["平生偏好酒，勞爾勸吾餐。","但得杯中滿，時光度不難。"],"s":"trad","f":"simp"},{"i":"02ef842b-bb93-4a59-8960-3dde22d8d6b2","t":"書壁","a":"周仲美","d":"唐","g":"古体","p":["愛妾不愛子，爲問此何理。","棄官更棄妻，人情寧可已。","永訣泗之濱，遺言空在耳。","三載無朝昏，孤幃淚如洗。","婦人義從夫，一節誓生死。","江鄉感殘春，腸斷晚煙起。","西望太華峰，不知幾千里。"],"s":"mixed","f":"simp"},{"i":"745a9b04-89e7-4b5d-bf35-d328d2403ecc","t":"溪口雲","a":"張文姬","d":"唐","g":"短诗","p":["溶溶溪口雲，纔向溪中吐。","不復歸溪中，還作溪中雨。"],"s":"mixed","f":"simp"},{"i":"ded41575-fb8a-4f5b-99d6-3c339fd75dc6","t":"池上竹","a":"張文姬","d":"唐","g":"短诗","p":["此君臨此池，枝低水相近。","碧色綠波中，日日流不盡。"],"s":"trad","f":"simp"},{"i":"ba2fd465-d362-495b-a27e-b01e371d8470","t":"沙上鷺","a":"張文姬","d":"唐","g":"短诗","p":["沙頭一水禽，鼓翼揚清音。","只待高風便，非無雲漢心。"],"s":"trad","f":"simp"},{"i":"e614ecf9-9216-4c20-9e30-b2215fcac6cd","t":"雙槿樹","a":"張文姬","d":"唐","g":"短诗","p":["綠影競扶疎，紅姿相照灼。","不學桃李花，亂向春風落。"],"s":"trad","f":"simp"},{"i":"426e4caa-937e-46b9-ba0b-10f149c2ba3b","t":"獄中書情上使君","a":"程長文","d":"唐","g":"古体","p":["妾家本住鄱陽曲，一片貞心比孤竹。","當年二八盛容儀，紅牋草隸恰如飛。","盡日閑窗刺繡坐，有時極浦採蓮歸。","誰道居貧守都邑，幽閨寂寞無人識。","海燕朝歸衾枕寒，山花夜落階墀溼。","強暴之男何所爲，手持白刃向簾幃。","一命任從刀下死，千金豈受暗中欺。","我心匪石情難轉，志奪秋霜意不移。","血濺羅衣終不恨，瘡黏錦袖亦何辭。","縣僚曾未知情緒，即便教人縶囹圄。","朱脣滴瀝獨銜冤，玉筯闌干歎非所。","十月寒更堪思人，一聞擊柝一傷神。","高髻不梳雲已散，蛾眉罷埽月仍新。","三尺嚴章難可越，百年心事向誰說。","但看洗雪出圜扉，始信白圭無玷缺。"],"s":"mixed","f":"simp"},{"i":"f90106b9-fcd0-431c-99f5-47f7b728524b","t":"銅雀臺怨","a":"程長文","d":"唐","g":"短诗","p":["君王去後行人絕，簫箏不響歌喉咽。","雄劒無威光彩沈，寶琴零落金星滅。","玉階寂寞墜秋露，月照當時歌舞處。","當時歌舞人不迴，化爲今日西陵灰。"],"s":"mixed","f":"simp"},{"i":"e800e312-b8d9-4708-ae5b-00d2aa31be4c","t":"春閨怨","a":"程長文","d":"唐","g":"短诗","p":["[綺]陌香飄柳如線，時光瞬息如流電。","良人何處事功名，十載相思不相見。"],"s":"trad","f":"simp"},{"i":"5c1c52e6-2e37-4d73-8a28-b3eb6b6bfbc0","t":"荅韓翃","a":"柳氏","d":"唐","g":"短诗","p":["楊柳枝，芳菲節，可恨年年贈離別。","一葉隨風忽報秋，縱使君來豈堪折。"],"s":"trad","f":"simp"},{"i":"a7196d94-63d7-4fe4-aef6-6a8a65d0a5d0","t":"歸李江州後寄別王氏","a":"程洛賓","d":"唐","g":"短诗","p":["魚鴈回時寫報音，難憑剉蘖數年心。","雖然情斷沙吒後，爭奈平生怨恨深。"],"s":"mixed","f":"simp"},{"i":"43897f0e-e5bc-499e-b38a-f13fa2bdd7b3","t":"憶崔生","a":"紅綃妓","d":"唐","g":"短诗","p":["深洞鶯啼恨阮郎，偷來花下解珠璫。","碧雲飄斷音書絕，空倚玉簫愁鳳皇。"],"s":"trad","f":"simp"},{"i":"5f4006c4-d20f-452e-b5ce-9842d8b77e31","t":"寄文茂","a":"晁采","d":"唐","g":"短诗","p":["花箋製葉寄郎邊，的的尋魚爲妾傳。","幷蒂已看靈鵲報，倩郎早覓買花船。"],"s":"mixed","f":"simp"},{"i":"38d5772d-c185-4c22-a232-caddf97c2ecc","t":"秋日再寄","a":"晁采","d":"唐","g":"短诗","p":["珍簟生涼夜漏餘，夢中恍惚覺來初。","魂離不得空成病，面見無由浪寄書。","窗外江村鐘響絕，枕邊梧葉雨聲疎。","此時最是思君處，腸斷寒猨定不如。"],"s":"mixed","f":"simp"},{"i":"1236566a-1088-490a-91e9-16760e6bb973","t":"春日送夫之長安","a":"晁采","d":"唐","g":"短诗","p":["思君遠別妾心愁，踏翠江邊送畫舟。","欲待相看遲此別，只憂紅日向西流。"],"s":"mixed","f":"simp"},{"i":"6566189d-711d-4771-a6c0-d265def3635d","t":"雨中憶夫 一","a":"晁采","d":"唐","g":"短诗","p":["窗前細雨日啾啾，妾在閨中獨自愁。","何事玉郎久離別，忘憂總對豈忘憂。"],"s":"mixed","f":"simp"},{"i":"911f631b-dcb2-4a6a-8890-9ae0fdf31057","t":"雨中憶夫 二","a":"晁采","d":"唐","g":"短诗","p":["春風送雨過窗東，忽憶良人在客中。","安得妾身今似雨，也隨風去與郎同。"],"s":"mixed","f":"simp"},{"i":"8d39d972-81c8-40ce-a3d2-9fb82a1daa0b","t":"子夜歌十八首 一","a":"晁采","d":"唐","g":"短诗","p":["儂既剪雲鬟，郎亦分絲髮。","覓向無人處，綰作同心結。"],"s":"mixed","f":"simp"},{"i":"cee37ed2-dbe3-411d-b652-d274e05b7702","t":"子夜歌十八首 二","a":"晁采","d":"唐","g":"短诗","p":["夜夜不成寐，擁被啼終夕。","郎不信儂時，但看枕上跡。"],"s":"mixed","f":"simp"},{"i":"64df80be-7000-42bb-9c86-decf28286053","t":"子夜歌十八首 三","a":"晁采","d":"唐","g":"短诗","p":["何時得成匹，離恨不復牽。","金針刺菡萏，夜夜得見蓮。"],"s":"mixed","f":"simp"},{"i":"82e22c1d-77a5-4561-9dba-7005a5c737c2","t":"子夜歌十八首 四","a":"晁采","d":"唐","g":"短诗","p":["相逢逐涼候，黃花忽復香。","顰眉臘月露，愁殺未成霜。"],"s":"mixed","f":"simp"},{"i":"c174ebbf-0dc4-44c4-8348-6a41a4d13262","t":"子夜歌十八首 五","a":"晁采","d":"唐","g":"短诗","p":["明窗弄玉指，指甲如水晶。","翦之特寄郎，聊當攜手行。"],"s":"mixed","f":"simp"},{"i":"fc9e96e8-466a-4de7-b71b-1646656baa78","t":"子夜歌十八首 六","a":"晁采","d":"唐","g":"短诗","p":["寄語閨中娘，顏色不常好。","含笑對棘實，歡娛須是棗。"],"s":"mixed","f":"simp"},{"i":"b05e9e06-1e7a-4bfc-af7c-0fb9205563df","t":"子夜歌十八首 七","a":"晁采","d":"唐","g":"短诗","p":["良會終有時，勸郎莫得怒。","薑蘖畏春蠶，要綿須辛苦。"],"s":"mixed","f":"simp"},{"i":"53ff9de3-f372-4951-b7b1-0516bc449c9b","t":"子夜歌十八首 八","a":"晁采","d":"唐","g":"短诗","p":["醉夢幸逢郎，無奈烏啞啞。","中山如有酒，敢借千金價。"],"s":"mixed","f":"simp"},{"i":"dd25c1b1-34ef-4ef7-be11-dea18d41bc53","t":"子夜歌十八首 九","a":"晁采","d":"唐","g":"短诗","p":["信使無虛日，玉醞寄盈觥。","一年一日雨，底事太多晴。"],"s":"mixed","f":"simp"},{"i":"b5cc3885-ba50-4465-9665-6b220aad4ea4","t":"子夜歌十八首 十","a":"晁采","d":"唐","g":"短诗","p":["繡房擬會郎，四窗日離離。","手自施屏障，恐有女伴窺。"],"s":"mixed","f":"simp"},{"i":"9109c348-3946-40cd-a55a-229f94d9c690","t":"子夜歌十八首 十一","a":"晁采","d":"唐","g":"短诗","p":["相思百餘日，相見苦無期。","褰裳摘藕花，要蓮敢恨池。"],"s":"mixed","f":"simp"},{"i":"26ce7874-d932-4474-b787-d96bc75fddd7","t":"子夜歌十八首 十二","a":"晁采","d":"唐","g":"短诗","p":["金盆盥素手，焚香誦普門。","來生何所願，與郎爲一身。"],"s":"mixed","f":"simp"},{"i":"46bdf6bb-df79-4811-bd72-d49e5a54d514","t":"子夜歌十八首 十三","a":"晁采","d":"唐","g":"短诗","p":["花池多芳水，玉杯挹贈郎。","避人藏袖裏，溼却素羅裳。"],"s":"mixed","f":"simp"},{"i":"e17e862d-214b-4ebd-ae94-a96b4afc6b25","t":"子夜歌十八首 十四","a":"晁采","d":"唐","g":"短诗","p":["感郎金鍼贈，欲報物俱輕。","一雙連素縷，與郎聊定情。"],"s":"mixed","f":"simp"},{"i":"14407943-9c68-4823-902d-516291d26e7d","t":"子夜歌十八首 十五","a":"晁采","d":"唐","g":"短诗","p":["寒風響枯木，通夕不得臥。","早起遣問郎，昨宵何以過。"],"s":"mixed","f":"simp"},{"i":"3b8a76d2-d017-4cda-8f8a-3021c48c378a","t":"子夜歌十八首 十六","a":"晁采","d":"唐","g":"短诗","p":["得郎日嗣音，令人不可覩。","熊膽磨作墨，書來字字苦。"],"s":"mixed","f":"simp"},{"i":"f9587780-178c-4756-8251-9af0eb6cc636","t":"子夜歌十八首 十七","a":"晁采","d":"唐","g":"短诗","p":["輕巾手自製，顏色爛含桃。","先懷儂袖裏，然後約郎腰。"],"s":"mixed","f":"simp"},{"i":"3f146ab5-f1a2-4b9e-9e1d-04c7486bfdfd","t":"子夜歌十八首 十八","a":"晁采","d":"唐","g":"短诗","p":["儂贈綠絲衣，郎遺玉鉤子。","即欲繫儂心，儂思著郎體。"],"s":"mixed","f":"simp"},{"i":"07bdeb64-f528-4187-9b4c-525f1d5e6e5b","t":"荅張生","a":"崔鶯鶯","d":"唐","g":"短诗","p":["待月西廂下，迎風戶半開。","拂牆花影動，疑是玉人來。"],"s":"trad","f":"simp"},{"i":"4eb5b013-93f1-48bd-a808-2793bb75920d","t":"寄詩","a":"崔鶯鶯","d":"唐","g":"短诗","p":["自從銷瘦減容光，萬轉千迴嬾下牀。","不爲傍人羞不起，爲郎憔悴却羞郎。"],"s":"mixed","f":"simp"},{"i":"7c211667-c614-419c-97da-fd7c8d73fb6c","t":"告絕詩","a":"崔鶯鶯","d":"唐","g":"短诗","p":["棄置今何道，當時且自親。","還將舊來意，憐取眼前人。"],"s":"trad","f":"simp"},{"i":"5fdf5b41-d838-4c3a-8866-9ce89ac30990","t":"荅趙子","a":"步非煙","d":"唐","g":"短诗","p":["綠慘雙蛾不自持，只緣幽恨在新詩。","郎心應似琴心怨，脈脈春情更泥誰。"],"s":"trad","f":"simp"},{"i":"661ebc1b-808b-418f-955d-204d5ca66807","t":"又荅趙象獨坐","a":"步非煙","d":"唐","g":"短诗","p":["無力嚴妝倚繡櫳，暗題蟬錦思難窮。","近來贏得傷春病，柳弱花敧怯曉風。"],"s":"trad","f":"simp"},{"i":"d427c8bb-101f-4974-984b-a1b920df8480","t":"寄懷","a":"步非煙","d":"唐","g":"短诗","p":["畫簷春燕須同宿，蘭浦雙鴛肯獨飛。","長恨桃源諸女伴，等閑花裏送郎歸。"],"s":"mixed","f":"simp"},{"i":"939d8171-0196-4fb4-9eb5-faa10768dce0","t":"荅趙象","a":"步非煙","d":"唐","g":"短诗","p":["相思只恨難相見，相見還愁却別君。","願得化爲松上鶴，一雙飛去入行雲。"],"s":"mixed","f":"simp"},{"i":"e5552adc-0429-470b-a7a3-45d70100bd97","t":"臨行獻李尚書","a":"崔紫雲","d":"唐","g":"短诗","p":["從來學製斐然詩，不料霜臺御史知。","忽見便教隨命去，戀恩腸斷出門時。"],"s":"trad","f":"simp"},{"i":"c6def4d8-1454-4dbc-81d2-cc36cbe54c25","t":"怨詩效徐淑體","a":"姚月華","d":"唐","g":"古体","p":["妾生兮不辰，盛年兮逢屯。","寒暑兮心結，夙夜兮眉顰。","循環兮不息，如彼兮車輪。","車輪兮可歇，妾心兮焉伸。","雜沓兮無緒，如彼兮絲棼。","絲棼兮可理，妾心兮焉分。","空閨兮岑寂，妝閣兮生塵。","萱草兮徒樹，茲憂兮豈泯。","幸逢兮君子，許結兮殷勤。","分香兮翦髮，贈玉兮共珍。","指天兮結誓，願爲兮一身。","所遭兮多舛，玉體兮難親。","損餐兮減寢，帶緩兮羅裙。","菱鑑兮慵啓，博鑪兮焉熏。","整襪兮欲舉，塞路兮荆榛。","逢人兮欲語，鞈匝兮頑嚚。","煩冤兮憑胸，何時兮可論。","願君兮見察，妾死兮何瞋。"],"s":"mixed","f":"simp"},{"i":"f6ce334f-8962-4a1e-af61-2abc7ebf27e4","t":"製履贈楊達","a":"姚月華","d":"唐","g":"短诗","p":["金刀翦紫羢，與郎作輕履。","願化雙仙鳧，飛來入閨裏。"],"s":"mixed","f":"simp"},{"i":"c1294222-3a2c-4827-b4e1-0fa0b4a6571a","t":"有期不至","a":"姚月華","d":"唐","g":"短诗","p":["銀燭清尊久延佇，出門入門天欲曙。","月落星稀竟不來，煙柳朧朣鵲飛去。"],"s":"trad","f":"simp"},{"i":"564dbde0-e6ed-4e73-b800-719862aa9011","t":"怨詩寄楊達 一","a":"姚月華","d":"唐","g":"短诗","p":["春水悠悠春草綠，對此思君淚相續。","羞將離恨向東風，理盡秦箏不成曲。"],"s":"trad","f":"simp"},{"i":"c444dd3d-0512-41a5-b1bb-96f6e84eccab","t":"怨詩寄楊達 二","a":"姚月華","d":"唐","g":"短诗","p":["與君形影分吳越，玉枕經年對離別。","登臺北望煙雨深，回身泣向寥天月。"],"s":"trad","f":"simp"},{"i":"1621b0d9-b848-4127-bb11-a003297f475a","t":"楚妃怨","a":"姚月華","d":"唐","g":"短诗","p":["梧桐葉下黃金井，橫架轆轤牽素綆。","美人初起天未明，手拂銀瓶秋水冷。"],"s":"trad","f":"simp"},{"i":"84896f78-dbd0-46e1-a52b-f7170773fd3b","t":"獨遊家園","a":"孟氏","d":"唐","g":"短诗","p":["可惜春時節，依前獨自遊。","無端兩行淚，長只對花流。"],"s":"trad","f":"simp"},{"i":"dcf51fd3-bc36-4bac-9c61-b200cba4fd88","t":"荅少年","a":"孟氏","d":"唐","g":"短诗","p":["誰家少年兒，心中暗自欺。","不道終不可，可即恐郎知。"],"s":"trad","f":"simp"},{"i":"632e2169-cc1f-4863-9f98-c1a128f6c138","t":"寄情","a":"趙氏","d":"唐","g":"短诗","p":["春風白馬紫絲韁，正值蠶娘未採桑。","五夜有心隨暮雨，百年無節抱秋霜。","重尋繡帶朱藤合，却忍羅裙碧草長。","爲報西遊減離恨，阮郎纔去嫁劉郎。"],"s":"mixed","f":"simp"},{"i":"4f0750ec-0fd5-4a06-bbd3-9f60a31d6748","t":"書紅綃帕 一","a":"李節度姬","d":"唐","g":"短诗","p":["囊裹真香誰見竊，鮫綃滴淚染成紅。","殷勤遺下輕綃意，好與情郎懷袖中。"],"s":"trad","f":"simp"},{"i":"d8076177-1331-45f7-a771-fbf8f6987a71","t":"書紅綃帕 二","a":"李節度姬","d":"唐","g":"短诗","p":["金珠富貴吾家事，常渴佳期乃寂寥。","偶用志誠求雅合，良媒未必勝紅綃。"],"s":"trad","f":"simp"},{"i":"039b706f-19ca-45b0-a622-fa8049f1895e","t":"會張生述懷","a":"李節度姬","d":"唐","g":"短诗","p":["門前畫戟尋常設，堂上犀簪取次看。","最是惱人情緒處，鳳皇樓上月華寒。"],"s":"trad","f":"simp"},{"i":"f349de32-aed1-4e1d-8ef3-b62508aa1df2","t":"別韋洵美詩","a":"崔素娥","d":"唐","g":"短诗","p":["妾閉閑房君路岐，妾心君恨兩依依。","神魂倘遇巫娥伴，猶逐朝雲暮雨歸。"],"s":"trad","f":"simp"},{"i":"5b0a781a-b0e6-4fb2-9f68-74d97725152e","t":"送韋生酒","a":"鮑家四弦","d":"唐","g":"短诗","p":["白露溼庭砌，皓月臨前軒。","此時去留恨，含思獨無言。"],"s":"trad","f":"simp"},{"i":"348d83bb-ab8d-420b-bbbc-6e7fbaf9ea04","t":"送鮑生酒","a":"鮑家四弦","d":"唐","g":"短诗","p":["風颭荷珠難暫圓，多情信有短姻緣。","西樓今夜三更月，還照離人泣斷弦。"],"s":"trad","f":"simp"},{"i":"3f43e36e-87d8-47e2-a45e-ddf115e77c37","t":"贈別","a":"[嚴]續姬","d":"唐","g":"短诗","p":["風柳搖搖無定枝，陽臺雲雨夢中歸。","他年蓬島音塵絕，留取尊前舊舞衣。"],"s":"trad","f":"simp"},{"i":"5f445666-231e-415d-8e86-7f9f7ef1b621","t":"採桑","a":"郎大家宋氏","d":"唐","g":"短诗","p":["春來南鴈歸，日去西蠶遠。","妾思粉何極，客遊殊未返。"],"s":"trad","f":"simp"},{"i":"67710f4c-2d97-4ce1-8b4d-aa983d74b963","t":"宛轉歌二首 一","a":"郎大家宋氏","d":"唐","g":"短诗","p":["風已清，月朗琴復鳴。","掩抑非千態，殷勤是一聲。","歌宛轉，宛轉和且長。","願爲雙鴻鵠，比翼共翺翔。"],"s":"mixed","f":"simp"},{"i":"e585dee0-0fc8-4b06-86b9-7531598d5d4f","t":"宛轉歌二首 二","a":"郎大家宋氏","d":"唐","g":"短诗","p":["日已暮，長簷鳥聲度。","此時望君君不來，此時思君君不顧。","歌宛轉，宛轉那能異棲宿。","願爲形與影，出入恆相逐。"],"s":"mixed","f":"simp"},{"i":"f6b704e7-b568-4c5c-a17c-2f16efcf67b3","t":"長相思","a":"郎大家宋氏","d":"唐","g":"短诗","p":["長相思，久離別。","關山阻，風煙絕。","臺上鏡文銷，袖中書字滅。","不見君形影，何曾有歡悅。"],"s":"trad","f":"simp"},{"i":"7e46a7b6-1e3a-4a44-a4c1-a44687af1022","t":"朝雲引","a":"郎大家宋氏","d":"唐","g":"短诗","p":["巴西巫峽指巴東，朝雲觸石上朝空。","巫山巫峽高何已，行雨行雲一時起。","一時起，三春暮。","若言來，且就陽臺路。"],"s":"trad","f":"simp"},{"i":"a7607e42-9b69-40e6-b963-6e02393010bc","t":"宿巫山寄遠人","a":"梁瓊","d":"唐","g":"古体","p":["巫山雲，巫山雨，朝雲暮雨無定所。","南峰忽暗北峰晴，空裏仙人語笑聲。","曾侍荆王枕席處，直至如今如有靈。","春風澹澹白雲閑，驚湍流水響千山。","一夜此中對明月，憶得此中與君別。","感物情懷如舊時，君今渺渺在天涯。","曉看襟上淚流處，點點血痕猶在衣。"],"s":"mixed","f":"simp"},{"i":"e04bafcb-6d5c-4b40-83c1-67dfa8fe205c","t":"昭君怨","a":"梁瓊","d":"唐","g":"短诗","p":["自古無和親，貽災到妾身。","朔風嘶去馬，漢月出行輪。","衣薄狼山雪，妝成虜塞春。","迴看父母國，生死畢胡塵。"],"s":"trad","f":"simp"},{"i":"14aaf7ac-4e70-4ce6-b3c1-4fd0594f2844","t":"銅雀臺","a":"梁瓊","d":"唐","g":"短诗","p":["歌扇向陵開，齊行奠玉杯。","舞時飛燕列，夢裏片雲來。","月色空餘恨，松聲莫更哀。","誰憐未死妾，掩袂下銅臺。"],"s":"mixed","f":"simp"},{"i":"20348cf3-482b-4139-ac8d-cb71ecd3fe29","t":"遠意","a":"梁瓊","d":"唐","g":"短诗","p":["脉脉長攄氣，微微不離心。","叩頭從此去，煩惱阿誰禁。"],"s":"mixed","f":"simp"},{"i":"9ecb7481-6658-45ad-af00-4b0817d856b7","t":"句","a":"梁瓊","d":"唐","g":"短诗","p":["玉枕空流別後淚，羅衣已盡去時香。"],"s":"trad","f":"simp"},{"i":"022554eb-12fc-47cb-882e-522994b100b1","t":"有所思","a":"劉雲","d":"唐","g":"短诗","p":["朝亦有所思，暮亦有所思。","登樓望君處，藹藹蕭關道。","掩淚向浮雲，誰知妾懷抱。","玉井蒼苔春院深，桐花落盡無人埽。"],"s":"trad","f":"simp"},{"i":"58977f8f-2c1b-4aa8-b6d6-6da8742d923a","t":"婕妤怨","a":"劉雲","d":"唐","g":"短诗","p":["君恩不可見，妾豈如秋扇。","秋扇尚有時，妾身永微賤。","莫言朝花不復落，嬌容幾奪昭陽殿。"],"s":"trad","f":"simp"},{"i":"6613ee43-6bdb-45eb-9b35-3c2ba5400fd7","t":"望月","a":"劉雲","d":"唐","g":"短诗","p":["天漢涼秋夜，澄澄一鏡明。","山空猨屢嘯，林靜鵲頻驚。"],"s":"trad","f":"simp"},{"i":"8a287784-fd73-4e42-8204-45f245be1b09","t":"古意","a":"崔萱","d":"唐","g":"古体","p":["灼灼葉中花，夏萎春又芳。","明明天上月，蟾缺圓復光。","未如君子情，朝違夕已忘。","玉帳枕猶暖，紈扇思何長。","願因西南風，吹上玳瑁牀。","嬌眠錦衾裏，展轉雙鴛鴦。"],"s":"mixed","f":"simp"},{"i":"5f81228e-9ff6-4963-97a9-886011eddae0","t":"敘別","a":"崔萱","d":"唐","g":"短诗","p":["碧池漾漾春水綠，中有佳禽暮棲宿。","願持此意永相貽，祗慮君情中反覆。"],"s":"trad","f":"simp"},{"i":"7df18d30-ba0e-477a-9cac-b0bc87005307","t":"豪家子","a":"崔萱","d":"唐","g":"短诗","p":["年少家藏累代金，紅樓盡日醉沈沈。","馬非躞蹀寧酬價，人不嬋娟肯動心。"],"s":"trad","f":"simp"},{"i":"253445ea-863a-4807-80c4-c280e4ac96e4","t":"句","a":"崔萱","d":"唐","g":"短诗","p":["豈知一隻鳳釵價，沽得數村蝸舍人。"],"s":"trad","f":"simp"},{"i":"4e2dc532-9d81-43c0-ad23-e222570b599c","t":"贈所思","a":"崔仲容","d":"唐","g":"短诗","p":["所居幸接隣，相見不相親。","一似雲間月，何殊鏡裏人。","丹誠空有夢，腸斷不禁春。","願作梁間燕，無由變此身。"],"s":"mixed","f":"simp"},{"i":"d7c7644e-06d3-4446-96ef-7c560ee9d785","t":"戲贈","a":"崔仲容","d":"唐","g":"短诗","p":["暫到崑崙未得歸，阮郎何事教人非。","如今身佩上清籙，莫遣落花霑羽衣。"],"s":"trad","f":"simp"},{"i":"9e3e0148-8399-4005-a0af-d3248343a9c8","t":"贈歌姬","a":"崔仲容","d":"唐","g":"短诗","p":["水翦雙眸霧翦衣，當筵一曲媚春輝。","瀟湘夜瑟怨猶在，巫峽曉雲愁不稀。","皓齒乍分寒玉細，黛眉輕蹙遠山微。","渭城朝雨休重唱，滿眼陽關客未歸。"],"s":"trad","f":"simp"},{"i":"2c8a4ae5-8871-4227-ac2e-350b29222c34","t":"句","a":"崔仲容","d":"唐","g":"短诗","p":["妾心合君心，一似影隨形。","梁燕無情困，雙棲語此時。","不覺紅顏去，空嗟白髮生。","桐花落盡春又盡，紫塞征人猶未歸。"],"s":"mixed","f":"simp"},{"i":"92a3eaf7-155e-4e0b-b601-776f35aea623","t":"獨夜詞","a":"崔公遠","d":"唐","g":"短诗","p":["晴天霜落寒風急，錦帳羅幃羞更入。","秦箏不復續斷弦，回身掩淚挑燈立。"],"s":"trad","f":"simp"},{"i":"c75e95b1-23b1-4b83-b595-671bd6fb55d9","t":"句","a":"崔公遠","d":"唐","g":"短诗","p":["看花獨不語，裴回雙淚澘。","君今遠戍在何處，遣妾秋來長望天。"],"s":"trad","f":"simp"},{"i":"2ddb055c-d9e1-48c6-8f85-b050b76fed21","t":"春詞二首 一","a":"張琰","d":"唐","g":"短诗","p":["垂柳鳴黃鸝，關關若求友。","春情不可耐，愁殺閨中婦。","日暮登高樓，誰憐小垂手。"],"s":"trad","f":"simp"},{"i":"4b52f305-e197-4c72-a5a6-3087de41607d","t":"春詞二首 二","a":"張琰","d":"唐","g":"短诗","p":["昨日桃花飛，今朝梨花吐。","春色能幾時，那堪此愁緒。","蕩子遊不歸，春來淚如雨。"],"s":"trad","f":"simp"},{"i":"70e737a7-547d-4d01-8280-03a4b2d374e9","t":"銅雀臺","a":"張琰","d":"唐","g":"短诗","p":["君王冥漠不可見，銅雀歌舞空裴回。","西陵嘖嘖悲宿鳥，高殿沈沈閉青苔。","青苔無人跡，紅粉空自哀。"],"s":"trad","f":"simp"},{"i":"9f7bfbd7-17d6-4a8f-a738-6d1278d2bc94","t":"句","a":"張琰","d":"唐","g":"短诗","p":["年年人自老，日日水東流。","庭芳自搖落，永念結中腸。"],"s":"trad","f":"simp"},{"i":"245ce2db-d956-4851-a514-faa5a56bad89","t":"哭夫二首 一","a":"裴羽仙","d":"唐","g":"短诗","p":["風卷平沙日欲曛，狼煙遙認犬羊羣。","李陵一戰無歸日，望斷胡天哭塞雲。"],"s":"mixed","f":"simp"},{"i":"19d0cc5c-d597-4a67-a87c-24437cfd4a78","t":"哭夫二首 二","a":"裴羽仙","d":"唐","g":"短诗","p":["良人平昔逐蕃渾，力戰輕行出塞門。","從此不歸成萬古，空留賤妾怨黃昏。"],"s":"trad","f":"simp"},{"i":"eefaeb9a-a9a2-4c8d-96ac-4d49dcb5bda4","t":"長門怨 一","a":"劉媛","d":"唐","g":"短诗","p":["雨滴梧桐秋夜長，愁心和雨到昭陽。","淚痕不學君恩斷，拭却千行更萬行。"],"s":"mixed","f":"simp"},{"i":"41047ebd-0b03-47ca-8ea8-1b7a9d2d9358","t":"長門怨 二","a":"劉媛","d":"唐","g":"短诗","p":["學畫蛾眉獨出羣，當時人道便承恩。","經年不見君王面，花落黃昏空掩門。"],"s":"mixed","f":"simp"},{"i":"10048cdb-c87c-4f88-8286-a4fca4960105","t":"送遠","a":"劉媛","d":"唐","g":"短诗","p":["聞道瞿塘灩澦堆，青山流水近陽臺。","知君此去無還日，妾亦隨波不復迴。"],"s":"trad","f":"simp"},{"i":"d0b58412-a066-4c0c-b4d9-2e9f2a9e080c","t":"句","a":"劉媛","d":"唐","g":"短诗","p":["春風報梅柳，一夜發南枝。","傍人那得知心事，一面殘妝空淚痕。"],"s":"trad","f":"simp"},{"i":"653cf90b-8503-48b6-8ec2-aa75ae6b16cf","t":"懷良人","a":"葛鵶兒","d":"唐","g":"短诗","p":["蓬鬢荆釵世所稀，布裙猶是嫁時衣。","胡麻好種無人種，正是歸時不見歸。"],"s":"mixed","f":"simp"},{"i":"9a22d583-2fd0-44d0-a399-e798fd738936","t":"會仙詩 一","a":"葛鵶兒","d":"唐","g":"短诗","p":["彩鳳搖搖下翠微，煙光漠漠徧芳枝。","玉窗仙會何人見，唯有春風仔細知。"],"s":"trad","f":"simp"},{"i":"fcac029e-2cce-449b-a39d-1264307f8e34","t":"會仙詩 二","a":"葛鵶兒","d":"唐","g":"短诗","p":["煙霞迤邐接蓬萊，宮殿參差曉日開。","羣玉山前人別處，紫鸞飛起望仙臺。"],"s":"mixed","f":"simp"},{"i":"f2d5ac7b-8c72-4d84-a819-b732fef697cd","t":"暗別離","a":"劉瑤","d":"唐","g":"古体","p":["槐花結子桐葉焦，單飛越鳥啼青霄。","翠軒輾雲輕遙遙，燕脂淚迸紅線條。","瑤草歇芳心耿耿，玉佩無聲畫屏冷。","朱弦暗斷不見人，風動花枝月中影。","青鸞脉脉西飛去，海闊天高不知處。"],"s":"mixed","f":"simp"},{"i":"05042944-c6de-4a97-b22f-32965fbb0774","t":"古意曲","a":"劉瑤","d":"唐","g":"短诗","p":["梧桐階下月團團，洞房如水秋夜闌。","吳刀翦破機頭錦，茱萸花墜相思枕。","綠窗寂寞背燈時，暗數寒更不成寢。"],"s":"trad","f":"simp"},{"i":"d45f6b65-1141-41ac-9666-31b4735f19bb","t":"闔閭城懷古","a":"劉瑤","d":"唐","g":"短诗","p":["五湖春水接遙天，國破君亡不記年。","唯有妖娥曾舞處，古臺寂寞起愁煙。"],"s":"trad","f":"simp"},{"i":"dca98db5-1fdc-47d1-a17c-45a52aa94b83","t":"峽中即事","a":"廉氏","d":"唐","g":"短诗","p":["清秋三峽此中去，鳴鳥孤猨不可聞。","一道水聲多亂石，四時天色少晴雲。","日暮泛舟溪漵口，那堪夜永思氛氳。"],"s":"trad","f":"simp"}]