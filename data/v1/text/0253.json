[{"i":"6ad839a1-3447-4915-b278-1f90219729d4","t":"山居送僧","a":"李涉","d":"唐","g":"短诗","p":["失意因休便買山，白雲深處寄柴關。","若逢城邑人相問，報道花時也不閑。"]},{"i":"826589fd-2be5-41f9-9bfe-57c38f4e12e4","t":"過襄陽上于司空頔","a":"李涉","d":"唐","g":"短诗","p":["方城漢水舊城池，陵谷依然世自移。","歇馬獨來尋故事，逢人唯說峴山碑。"]},{"i":"e16ef8d4-c50c-48da-971f-cda8c41d5d10","t":"送魏簡能東遊二首 一","a":"李涉","d":"唐","g":"短诗","p":["獻賦論兵命未通，却乘羸馬出關東。","灞陵原上重回首，十載長安似夢中。"]},{"i":"0c74bb0b-650d-41ff-9ed7-9ab81cc54cd5","t":"送魏簡能東遊二首 二","a":"李涉","d":"唐","g":"短诗","p":["燕市悲歌又送君，目隨征鴈過寒雲。","孤亭宿處時看劒，莫使塵埃蔽斗文。"]},{"i":"3cf3e7cd-58bb-4359-9c92-a2ae5b29872f","t":"中秋夜君山臺望月","a":"李涉","d":"唐","g":"短诗","p":["大堤花裏錦江前，詩酒同遊四十年。","不料中秋最明夜，洞庭湖上見當天。"]},{"i":"cf80c19d-9ccb-4870-a50b-6653f4c33241","t":"酬彭伉","a":"李涉","d":"唐","g":"短诗","p":["公孫閣裏見君初，衣錦南歸二十餘。","莫歎屈聲猶未展，同年今日在中書。"]},{"i":"abae4b57-fa93-49e7-99ac-ac6d9095d595","t":"硤石遇赦","a":"李涉","d":"唐","g":"短诗","p":["天網初開釋楚囚，殘骸已廢自知休。","荷簑不是人間事，歸去滄江有釣舟。"]},{"i":"c7d3a8fc-7992-46f6-acb6-e4f010e4c659","t":"贈龍泉洞塵上人","a":"李涉","d":"唐","g":"短诗","p":["八十山僧眼未昏，獨尋流水到窮源。","自言共得龍神語，擬作茅菴住洞門。"]},{"i":"6bb2b030-facf-4f9b-8ea8-ab97c6a64a02","t":"題湖臺","a":"李涉","d":"唐","g":"短诗","p":["山有松門江有亭，不勞他處問青冥。","有時帶月牀舁到，一陣風來酒盡醒。"]},{"i":"4178b4f8-a5ac-4bcf-9057-b5a1867b6ea6","t":"送妻入道","a":"李涉","d":"唐","g":"短诗","p":["人無回意似波瀾，琴有離聲爲一彈。","縱使空門再相見，還如秋月水中看。"]},{"i":"f40308b6-f294-4a5d-aefb-ad0948b721e7","t":"遇湖州妓宋態宜二首 一","a":"李涉","d":"唐","g":"短诗","p":["曾識雲仙至小時，芙蓉頭上綰青絲。","當時驚覺高唐夢，唯有如今宋玉知。"]},{"i":"e0b57905-7c1e-4ada-95c1-205482e6a57c","t":"遇湖州妓宋態宜二首 二","a":"李涉","d":"唐","g":"短诗","p":["陵陽夜會使君筵，解語花枝出眼前。","一從明[月]西沉海，不見嫦娥二十年。"]},{"i":"d868572a-423c-45d8-9567-283cfcecea5c","t":"逢舊二首 一","a":"李涉","d":"唐","g":"短诗","p":["碧落高高雲萬重，當時孤鶴去無蹤。","不期陵谷遷朝市，今日遼東特地逢。"]},{"i":"d0ab234f-ecba-4505-bfbc-5a7cc95ad934","t":"逢舊二首 二","a":"李涉","d":"唐","g":"短诗","p":["將作乘槎去不還，便尋雲海住三山。","不知留得支機石，却逐黃河到世間。"]},{"i":"cd1d93ca-b688-4ec1-a1e6-c4cf880695b7","t":"潤州聽暮角","a":"李涉","d":"唐","g":"短诗","p":["江城吹角水茫茫，曲引邊聲怨思長。","驚起暮天沙上鴈，海門斜去兩三行。"]},{"i":"1bd22d03-97d2-4f6f-8f08-11fe9302c109","t":"頭陀寺看竹","a":"李涉","d":"唐","g":"短诗","p":["寺前新笋已成竿，策馬重來獨自看。","可惜班皮空滿地，無人解取作頭冠。"]},{"i":"684798dd-31d7-4eaa-90c1-ebf806bc3dfd","t":"奉使京西","a":"李涉","d":"唐","g":"短诗","p":["盧龍已復兩河平，烽火樓邊處處耕。","何事書生走羸馬，原州城下又添兵。"]},{"i":"de1401d7-e100-4070-a35d-ad3d7de7b73c","t":"題連雲堡","a":"李涉","d":"唐","g":"短诗","p":["由來天地有關扃，斷壑連山接杳冥。","一出縱知邊上事，滿朝誰信語堪聽。"]},{"i":"0ff3d44e-8d09-4b83-a13c-aa090b481f59","t":"再宿武關","a":"李涉","d":"唐","g":"短诗","p":["遠別秦城萬里遊，亂山高下出商州。","關門不鎖寒溪水，一夜潺湲送客愁。"]},{"i":"a84d43ca-8824-4e60-ac90-04dee72870bf","t":"長安悶作","a":"李涉","d":"唐","g":"短诗","p":["宵分獨坐到天明，又策羸驂信脚行。","每日除書空滿紙，不曾聞有介推名。"]},{"i":"bdb3a548-2a04-474a-805f-e240048510f7","t":"和尚書舅見寄","a":"李涉","d":"唐","g":"短诗","p":["欲隨流水去幽棲，喜伴歸雲入虎溪。","深謝陳蕃憐寂寞，遠飛芳字警沉迷。"]},{"i":"9de495a6-9a74-4dc7-b14e-8577611ba318","t":"送王六覲巢縣叔父二首 一","a":"李涉","d":"唐","g":"短诗","p":["巢岸南分戰鳥山，水雲程盡到東關。","弦歌自是君家事，莫怪今來一邑閑。"]},{"i":"3a07b10d-d744-4217-9ed1-39199b7ec44f","t":"送王六覲巢縣叔父二首 二","a":"李涉","d":"唐","g":"短诗","p":["長憶山陰舊會時，王家兄弟盡相隨。","老來放逐瀟湘路，淚滴秋風引獻之。"]},{"i":"530443f2-e2ae-41a4-965b-d2169ed04759","t":"偶懷","a":"李涉","d":"唐","g":"短诗","p":["轉知名宦是悠悠，分付空源始到頭。","待送妻兒下山了，便隨雲水一生休。"]},{"i":"6045f0ab-faa4-4f0e-aaf3-5aa5486447cc","t":"秋夜題夷陵水館","a":"李涉","d":"唐","g":"短诗","p":["凝碧初高海氣秋，桂輪斜落到江樓。","三更浦上巴歌歇，山影沉沉水不流。"]},{"i":"fdca6404-1889-4dde-bcca-820d8c84a19b","t":"與梧州劉中丞","a":"李涉","d":"唐","g":"短诗","p":["三代盧龍將相家，五分符竹到天涯。","瘴山江上重相見，醉裏同看荳蔲花。"]},{"i":"6dbefd46-1e0e-413e-8b57-407004454af3","t":"聽多美唱歌","a":"李涉","d":"唐","g":"短诗","p":["黃鶯慢轉引秋蟬，衝斷行雲直入天。","一曲梁州聽初了，爲君別唱想夫憐。"]},{"i":"33a209ae-7252-42fe-b235-01d6086e64f6","t":"題澗飲寺","a":"李涉","d":"唐","g":"短诗","p":["百年如夢竟何成，白髮重來此地行。","還似蕭郎許玄度，再看庭石悟前生。"]},{"i":"aff6f954-43c1-41cf-840c-01540f5b4494","t":"題蘇仙宅枯松","a":"李涉","d":"唐","g":"短诗","p":["幾年蒼翠在仙家，一旦枝枯類海槎。","不如酸澀棠梨樹，却占高城獨放花。"]},{"i":"d02e730c-f618-46e8-9441-0f2f38b50878","t":"山居","a":"李涉","d":"唐","g":"短诗","p":["一從身世兩相遺，往往關門到午時。","想得俗流應大笑，不知年老識便宜。"]},{"i":"d01d58c0-3e3c-492b-8a5f-c403d26a0d8e","t":"聽鄰女吟","a":"李涉","d":"唐","g":"短诗","p":["含情遙夜幾人知，閑詠風流小謝詩。","還似霓旌下煙露，月邊吹落上清詞。"]},{"i":"bc669dfe-f2a1-4943-8995-09a55eb09188","t":"題宇文秀才櫻桃","a":"李涉","d":"唐","g":"短诗","p":["風光莫占少年家，白髮殷勤最戀花。","今日顛狂任君笑，趂愁得醉眼麻茶。"]},{"i":"2386d800-7a20-48c4-a1ac-b8a1919efb93","t":"漢上偶題","a":"李涉","d":"唐","g":"短诗","p":["謫仙唐世游茲郡，花下聽歌醉眼迷。","今日漢江煙樹盡，更無人唱白銅鞮。"]},{"i":"95f586e7-f277-4eb0-ac7f-b9304458f354","t":"送楊敬之倅湖南","a":"李涉","d":"唐","g":"短诗","p":["久嗟塵匣掩青萍，見說除書試一聽。","聞君却作長沙傅，便逐秋風過洞庭。"]},{"i":"f241fb38-5750-41e2-b05c-f1c04a8abe00","t":"送孫堯夫赴舉","a":"李涉","d":"唐","g":"短诗","p":["自說軒皇息戰威，萬方無復事戎衣。","却教孫子藏兵法，空把文章向禮闈。"]},{"i":"80e98e34-908e-4480-9240-b0a874b552e0","t":"題水月臺","a":"李涉","d":"唐","g":"短诗","p":["平流白日無人愛，橋上閑行若箇知。","水似晴天天似水，兩重星點碧琉璃。"]},{"i":"a3512f84-94d1-4088-87e2-c05dbb8ca17b","t":"早春霽後發頭陀寺寄院中","a":"李涉","d":"唐","g":"短诗","p":["紅樓金剎倚晴岡，雨雪初收望漢陽。","草檄可中能有暇，迎春一醉也無妨。"]},{"i":"c60e45bd-f986-4ebd-9675-f14a22fa109d","t":"哭田布","a":"李涉","d":"唐","g":"短诗","p":["魏師臨陣却抽營，誰管豺狼作信兵。","縱使將軍能伏劒，何人島上哭田橫。"]},{"i":"e1cb19db-f7cd-4fa3-8cac-7b988ec69fb7","t":"黃葵花","a":"李涉","d":"唐","g":"短诗","p":["此花莫遣俗人看，新染鵝黃色未乾。","好逐秋風上天去，紫陽宮女要頭冠。"]},{"i":"51e72bcd-15c0-421d-a1c1-179ada1ee595","t":"別南溪二首 一","a":"李涉","d":"唐","g":"短诗","p":["如雲不厭蒼梧遠，似鴈逢春又北飛。","唯有隱山溪上月，年年相望兩依依。"]},{"i":"ff5e1838-e8b0-476d-9427-ed82ace09959","t":"別南溪二首 二","a":"李涉","d":"唐","g":"短诗","p":["常歎春泉去不回，我今此去更難來。","欲知別後留情處，手種巖花次第開。"]},{"i":"ca749313-844a-420f-90e4-41c58dcaacee","t":"井欄砂宿遇夜客","a":"李涉","d":"唐","g":"短诗","p":["暮雨蕭蕭江上村，綠林豪客夜知聞。","他時不用逃名姓，世上如今半是君。"]},{"i":"bff69f38-a9de-47a9-aa2b-ae8c4a47b7b8","t":"謝王連州送海陽圖","a":"李涉","d":"唐","g":"短诗","p":["謝家爲郡實風流，畫得青山寄楚囚。","驚起草堂寒氣晚，海陽潮水到牀頭。"]},{"i":"5abbdcae-657e-4d2b-9f2e-856b4377fe10","t":"再謫夷陵題長樂寺","a":"李涉","d":"唐","g":"短诗","p":["當時謫宦向夷陵，願得身閑便作僧。","誰知漸漸因緣重，羞見長燃一盞燈。"]},{"i":"36062ad8-6800-4112-bee0-39b859d791a8","t":"譴謫康州先寄弟渤","a":"李涉","d":"唐","g":"短诗","p":["唯將直道信蒼蒼，可料無名抵憲章。","陰隲却應先有謂，已交鴻鴈早隨陽。"]},{"i":"f8a77c24-880b-4d01-bfd0-4430f0f05579","t":"贈廖道士","a":"李涉","d":"唐","g":"短诗","p":["膏已明煎信矣哉，二年人世不歸來。","庭前爲報仙桃樹，今歲花時好好開。"]},{"i":"06c5b925-7d25-4399-8830-586a37ccc559","t":"山花","a":"李涉","d":"唐","g":"短诗","p":["六出花開赤玉盤，當中紅濕耐春寒。","長安若在五侯宅，誰肯將錢買牡丹。"]},{"i":"87d53b66-87e0-4656-8f57-1f4e7132f30d","t":"聽歌","a":"李涉","d":"唐","g":"短诗","p":["颯颯先飛梁上塵，朱脣不動翠眉顰。","願得春風吹更遠，直教愁殺滿城人。"]},{"i":"ad812479-1174-48dc-b2ec-316a2572bd5b","t":"送顏覺赴舉","a":"李涉","d":"唐","g":"短诗","p":["顏子將才應四科，料量時輩更誰過。","居然一片荆山玉，可怕無人是卞和。"]},{"i":"970c11f2-a334-4c76-889c-aaa531a0fddc","t":"題五松驛","a":"李涉","d":"唐","g":"短诗","p":["雲木蒼蒼數萬株，此中言命的應無。","人生不得如松樹，却遇秦封作大夫。"]},{"i":"0bd9e0ad-b498-479b-a5b6-f2c43a868013","t":"湘妃廟","a":"李涉","d":"唐","g":"短诗","p":["班竹林邊有古祠，鳥啼花發盡堪悲。","當時惆悵同今日，南北行人可得知。"]},{"i":"d15a28d4-a1c4-4cdf-a3b3-0108e89eb5c5","t":"贈長安小主人","a":"李涉","d":"唐","g":"短诗","p":["上清真子玉童顏，花態嬌羞月思閑。","仙路迷人應有術，桃源不必在深山。"]},{"i":"9ecde9d1-fa45-4970-9a54-f47b43f77906","t":"邠州詞獻高尚書三首 一","a":"李涉","d":"唐","g":"短诗","p":["單于都護再分疆，西引雙旌出帝鄉。","朝日詔書添戰馬，即聞千騎取河湟。"]},{"i":"ec5e206f-58af-4be3-92aa-5601e7f3b6c0","t":"邠州詞獻高尚書三首 二","a":"李涉","d":"唐","g":"短诗","p":["將家難立是威聲，不見多傳衛霍名。","一自元和平蜀後，馬頭行處即長城。"]},{"i":"0b5cddc7-551d-4eab-87a0-a724d0653cdc","t":"邠州詞獻高尚書三首 三","a":"李涉","d":"唐","g":"短诗","p":["朔方忠義舊來閑，盡是邠城父子軍。","今日兵符歸上將，旄頭不用更妖氛。"]},{"i":"d9997019-b1f3-4aeb-b0ca-3d92a11af799","t":"游西林寺","a":"李涉","d":"唐","g":"短诗","p":["十地初心在此身，水能生月即離塵。","如今再結林中社，可羨當年會裏人。"]},{"i":"076fa225-c4f1-444d-a7cf-391b8e7e6fbb","t":"題白鹿蘭若","a":"李涉","d":"唐","g":"短诗","p":["只去都門十里強，竹陰流水遶回廊。","滿城車馬皆知有，每喚同游盡道忙。"]},{"i":"91c6fef3-85d2-405c-90c6-1f53f88704fa","t":"寄趙準乞湘川山居","a":"李涉","d":"唐","g":"短诗","p":["閑說班超有舊居，山橫水曲占商於。","知君不用磻溪石，乞取終年獨釣魚。"]},{"i":"eb95ba48-c5e4-41b2-b9ef-681e683d6398","t":"曉過函谷關","a":"李涉","d":"唐","g":"短诗","p":["因韓爲趙兩游秦，十月冰霜渡孟津。","縱使雞鳴遇關吏，不知余也是何人。"]},{"i":"993579a0-64a0-49de-a0b0-fe1a03656f0c","t":"奉和九弟渤見寄絕句","a":"李涉","d":"唐","g":"短诗","p":["忽啓新緘吟近詩，詩中韻出碧雲詞。","且喜陟岡愁已散，登舟只恨渡江遲。"]},{"i":"89eff5b8-5af5-43de-91a8-877632675189","t":"贈友人孩子","a":"李涉","d":"唐","g":"短诗","p":["驪龍頷下亦生珠，便與人間衆寶殊。","他時若要追風日，須得君家萬里駒。"]},{"i":"ac1877d8-60fa-44ef-b446-21c3ece68e05","t":"奉宣慰使魚十四郎","a":"李涉","d":"唐","g":"短诗","p":["年纔二十衆知名，孤鶴儀容徹骨清。","口傳天語來人世，却逐祥雲上玉京。"]},{"i":"6afa1cd6-6cb8-4a8c-823d-1e2330e0a0a8","t":"題善光寺","a":"李涉","d":"唐","g":"短诗","p":["雲門天竺舊姻緣，臨老移家住玉泉。","早到可中溳南寺，免得翻經住幾年。"]},{"i":"582c7f2f-dcf3-46d8-9461-b49eb45616cc","t":"題宣化寺道光上人居","a":"李涉","d":"唐","g":"短诗","p":["二十年前不繫身，草堂曾與雪爲鄰。","常思和尚當時語，衣鉢留將與此人。"]},{"i":"9b8f9ff5-ec06-4f60-9980-b116842374ec","t":"柳枝詞","a":"李涉","d":"唐","g":"短诗","p":["錦池江上柳垂橋，風引蟬聲送寂寥。","不必如絲千萬縷，只禁離恨兩三條。"]},{"i":"a2f0bafa-8c94-4d34-96bb-b4225ed18be0","t":"竹枝詞","a":"李涉","d":"唐","g":"短诗","p":["十二山晴花盡開，楚宮雙闕對陽臺。","細腰爭舞君沈醉，白日秦兵天下來。"]},{"i":"860e5ed3-642d-4ec0-a5a9-f2c67c532b74","t":"竹裏","a":"李涉","d":"唐","g":"短诗","p":["竹裏編茅倚石[根]，竹莖疎處見前村。","閑眠盡日無人到，自有春風爲掃門。"]},{"i":"4e7b084a-3107-4f8a-9f3c-2d2cf8939700","t":"失題","a":"李涉","d":"唐","g":"短诗","p":["華表千年一鶴歸，丹砂爲頂雪爲衣。","泠泠仙語人聽盡，却向五雲翻翅飛。"]},{"i":"0129f386-cc7e-44fa-aa48-e75b2d1dd050","t":"雲安公主下降奉詔作催粧詩","a":"陸暢","d":"唐","g":"短诗","p":["雲安公主貴，出嫁五侯家。","天母親調粉，日兄憐賜花。","催鋪百子帳，待障七香車。","借問妝成未，東方欲曉霞。"]},{"i":"71b52a42-55e2-4a93-87ab-c86f12b2b55f","t":"山出雲","a":"陸暢","d":"唐","g":"古体","p":["靈山蓄雲彩，紛郁出清晨。","望樹繁花白，看峰小雪新。","映松張蓋影，依澗布魚鱗。","高似從龍處，低如觸石頻。","濃光藏半岫，淺色類飄塵。","玉葉開天際，遙憐占早春。"]},{"i":"020daf94-ea22-4e97-aee6-89aa43fe562b","t":"驚雪","a":"陸暢","d":"唐","g":"短诗","p":["怪得北風急，前庭如月輝。","天人寧許巧，翦水作花飛。"]},{"i":"6f8c9481-4569-4d4c-be32-fbb4d8d181ae","t":"聞早蟬","a":"陸暢","d":"唐","g":"短诗","p":["落日早蟬急，客心聞更愁。","一聲來枕上，夢裏故園秋。"]},{"i":"2f197211-3d07-45c5-9144-fbdc19d82947","t":"別劉端公","a":"陸暢","d":"唐","g":"短诗","p":["連騎出都門，秋蟬噪高柳。","落日辭故人，自醉不關酒。"]},{"i":"13816ee9-b5c3-456c-947c-6b8cab1c4f4e","t":"新晴愛月","a":"陸暢","d":"唐","g":"短诗","p":["野性平生惟愛月，新晴半夜覩嬋娟。","起來自擘紗窗破，恰漏清光落枕前。"]},{"i":"751f96ce-ae00-4c17-b636-db5b09ee5554","t":"雲安公主出降雜詠催粧二首 一","a":"陸暢","d":"唐","g":"短诗","p":["天上瓊花不避秋，今宵織女嫁牽牛。","萬人惟待乘鸞出，乞巧齊登明月樓。"]},{"i":"36e7ab00-1fec-401c-907c-b5390dd2196b","t":"雲安公主出降雜詠催粧二首 二","a":"陸暢","d":"唐","g":"短诗","p":["少粧銀粉飾金鈿，端正天花貴自然。","聞道禁中時節異，九秋香滿鏡臺前。"]},{"i":"4ae13d11-1588-40e9-84d9-ae22ae90e878","t":"坐障","a":"陸暢","d":"唐","g":"短诗","p":["白玉爲竿丁字成，黃金繡帶短長輕。","強遮天上花顏色，不隔雲中語笑聲。"]},{"i":"314b83af-633b-414a-af05-c3bd260ace2f","t":"簾","a":"陸暢","d":"唐","g":"短诗","p":["勞將素手捲蝦鬚，瓊室流光更綴珠。","玉漏報來過半夜，可憐潘岳立踟躕。"]},{"i":"625dedd4-8269-41cb-b375-a9de73c65fb1","t":"階","a":"陸暢","d":"唐","g":"短诗","p":["甃玉編金次第平，花紋隱起踏無聲。","幾重便上華堂裏，得見天人吹鳳笙。"]},{"i":"fcb671fa-4d77-4dd4-859a-40d8be9d1e4c","t":"扇","a":"陸暢","d":"唐","g":"短诗","p":["寶扇持來入禁宮，本教花下動香風。","姮娥須逐彩雲降，不可通宵在月中。"]},{"i":"ef7bfbca-f432-48a7-8aef-071c366262d5","t":"解內人嘲","a":"陸暢","d":"唐","g":"短诗","p":["粉面仙郎選聖朝，偶逢秦女學吹簫。","須教翡翠聞王母，不奈烏鳶噪鵲橋。"]},{"i":"a387c843-567b-439a-ac50-d41b3f50c583","t":"成都贈別席夔","a":"陸暢","d":"唐","g":"短诗","p":["不值分流二江水，定應猶得且同行。","三千里外情人別，更被子規啼數聲。"]},{"i":"578523ba-355b-4d06-8712-167e08b76262","t":"遊城東王駙馬亭","a":"陸暢","d":"唐","g":"短诗","p":["城外無塵水間松，秋天木落見山容。","共尋蕭史江亭去，一望終南紫閣峰。"]},{"i":"502400a5-4514-4981-a304-cf170774fc25","t":"望毛女峰","a":"陸暢","d":"唐","g":"短诗","p":["我種東峰千葉蓮，此峰毛女始求仙。","今朝暗算當時事，已是人間七萬年。"]},{"i":"1bed1ca0-5e53-4b34-9961-e0557d87b314","t":"送李山人歸山","a":"陸暢","d":"唐","g":"短诗","p":["來從千山萬山裏，歸向千山萬山去。","山中白雲千萬重，却望人間不知處。"]},{"i":"580d480c-8c0f-4639-8a13-0acdf798bb44","t":"長安新晴","a":"陸暢","d":"唐","g":"短诗","p":["九重深淺人不知，金殿玉樓倚朝日。","一夜城中新雨晴，御溝流得宮花出。"]},{"i":"51e76f1b-82f4-452e-aaa1-d2845d291d3a","t":"出藍田關寄董使君","a":"陸暢","d":"唐","g":"短诗","p":["萬里煙蘿錦帳間，雲迎水送度藍關。","七盤九折難行處，盡是龔黃界外山。"]},{"i":"a13dbda0-85d1-426a-b4e6-a15c4bdecbd1","t":"題悟公禪室","a":"陸暢","d":"唐","g":"短诗","p":["臨壇付法十三春，家本長城若下人。","芸閣少年應不識，南山鈔主是前身。"]},{"i":"35a1a7f0-4644-4ca3-9a7d-48d5cb171cd6","t":"宿陝府北樓奉酬崔大夫二首 一","a":"陸暢","d":"唐","g":"短诗","p":["樓壓黃河山滿坐，風清水涼誰忍臥。","人定軍州禁漏傳，不妨秋月城頭過。"]},{"i":"67f1d84b-aa3a-4104-8512-09586d600b28","t":"宿陝府北樓奉酬崔大夫二首 二","a":"陸暢","d":"唐","g":"短诗","p":["一別朱門三四春，再來應笑尚風塵。","昨宵唯有樓前月，識是謝公詩酒人。"]},{"i":"d70b3a28-0ff7-43f3-818d-c2ba98479eb0","t":"陝州逢竇鞏同宿寄江陵韋協律","a":"陸暢","d":"唐","g":"短诗","p":["共出丘門歲九霜，相逢悽愴對離觴。","荆南爲報韋從事，一宿同眠御史牀。"]},{"i":"4ff0b835-4837-40d4-a264-c2ace9051b8e","t":"夜到泗州酬崔使君","a":"陸暢","d":"唐","g":"短诗","p":["徐城洪盡到淮頭，月裏山河見泗州。","聞道泗濱清廟磬，雅聲今在謝家樓。"]},{"i":"bc336f06-f9fc-43ca-a7b9-12b47c3b3c70","t":"送崔員外使回入京金鉤驛逢因贈","a":"陸暢","d":"唐","g":"短诗","p":["六星宮裏一星歸，行到金鉤近紫微。","侍史別來經歲月，今宵應夢護香衣。"]},{"i":"f9dcbfdf-c6bd-4c6c-a974-10718827d5f9","t":"成都送別費冠卿","a":"陸暢","d":"唐","g":"短诗","p":["紅椒花落桂花開，萬里同遊俱未回。","莫厭客中頻送客，思鄉獨上望鄉臺。"]},{"i":"6b4abe66-a315-4d17-baa0-f4c95bbd7acc","t":"題商山廟","a":"陸暢","d":"唐","g":"短诗","p":["商洛秦時四老翁，人傳羽化此山空。","若無仙眼何由見，總在廟前花洞中。"]},{"i":"c6148328-6ccd-497b-9094-f083a44efc13","t":"題獨孤少府園林","a":"陸暢","d":"唐","g":"短诗","p":["四面青山是四隣，煙霞成伴草成茵。","年年洞口桃花發，不記曾經迷幾人。"]},{"i":"8850b9b6-4019-4c0b-b5a1-a887c3078a87","t":"送獨孤秀才下第歸太白山","a":"陸暢","d":"唐","g":"短诗","p":["逸翮暫時成落羽，將歸太白賞靈蹤。","須尋最近碧霄處，擬倩和雲買一峰。"]},{"i":"232e8dc7-428a-4962-a762-f26c5943eb99","t":"下第後病中","a":"陸暢","d":"唐","g":"短诗","p":["獻玉頻年命未通，窮秋成病悟真空。","笑看朝市趨名者，不病那知在病中。"]},{"i":"32d01daf-c054-427c-a3f4-097ec0aff53b","t":"送深上人歸江南","a":"陸暢","d":"唐","g":"短诗","p":["留得蓮花偈付誰，獨攜金策欲歸時。","江南無限蕭家寺，曾與白雲何處期。"]},{"i":"7c3efe0a-27ee-4199-a746-a5a5a5d5bfa9","t":"題自然觀","a":"陸暢","d":"唐","g":"短诗","p":["劒閣門西第一峰，道陵成道有高蹤。","行人若上升仙處，須撥白雲三四重。"]}]