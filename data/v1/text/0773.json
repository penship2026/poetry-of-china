[{"i":"c-e69218640d5e","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["孤馆深沉，晓寒天气。","解鞍独自阑干倚。","暗香浮动月黄昏，落梅风送沾衣袂。","待写红笺，凭谁与寄。","先教觅取嬉游地。","到家正是晚春时，小桃花下拼沉醉。"],"s":"simp","f":"trad"},{"i":"c-42d33f0f8618","t":"青玉案","a":"无名氏","d":"宋","g":"词","p":["征鞍不见邯郸路。","莫便匆匆去，秋风萧条何以度。","明窗小酌，暗灯清话，最好留连处。","相逢各自伤迟暮，犹把新诗诵奇句。","盐絮家风人所许。","如今憔悴，但馀衰泪，一似黄梅雨。"],"s":"simp","f":"trad"},{"i":"c-2d912a7d01ab","t":"沁园春","a":"无名氏","d":"宋","g":"词","p":["法从西清，雅志山东，超然燕怡。","笑洛城卢老，贫来屋破，花溪杜叟，雨里床移。","晚乃经营，欢言结架，夭矫晴虹朝已跻。","开山了，一灯灯相续，第一宗师。","乘闲小隐幽栖。","天与人谋应此时。","算春霆震响，不教龙蛰，甘霖布润，待倩云飞。","宥密思贤，明谟经远，共指神州克复归。","归来也，更身名煊赫，锦绣光辉。"],"s":"simp","f":"trad"},{"i":"c-559237399d9d","t":"水调歌头","a":"无名氏","d":"宋","g":"词","p":["蹑足半天下，作意赋归欤。","燕申经始不日，胸次出规模。","千古神峰拥护，万古横江缭绕，佳致足方壶。","一饮一词美，还得似君无。","十步楼、五步阁，恣安居。","薰蒸和气，袭人盎盎觉春如。","况是庄椿不老，那更徐鸡并秀，父子看名俱。","驷马高车盖，不减汉之于。"],"s":"simp","f":"trad"},{"i":"c-9d6143391ef2","t":"水调歌头","a":"无名氏","d":"宋","g":"词","p":["三径当松竹，五亩足烟霞。","个中卜宅，蓬山佳致足君家。","前有书江环绕，后有横岗崪嵂，万象总森罗。","输奂翬飞处，此屋岂无华。","绿窗开，朱户敞，绣帘遮。","燕闲自适，百篇斗酒是生涯。","种善善根未绝，延桂桂枝可待，谁子为君夸。","佳嗣一夔足，荣耀必多嘉。"],"s":"mixed","f":"trad"},{"i":"c-e3249e481518","t":"金缕衣・贺新郎","a":"无名氏","d":"宋","g":"词","p":["帝遣司花女。","炯琼琚瑶佩，新来满空飞舞。","飞到水晶宫阙处，还被六丁迎住。","唤月娣、天孙说与。","道是云溪新洞府，粲玉虹、拥出神仙宇。","齐星汉，切云雾。","朝来细把虹梁举。","命日兄、催上金鸦，高高腾翥。","云母卷帘三万数，不碍风斤月斧。","真个是、去天尺五。","恰则紫皇香案近，那砖花、院柳宜年少。","双鬓绿，朝天去。"],"s":"simp","f":"trad"},{"i":"c-5d2954a6ac6f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["金猊香冷。"],"s":"simp","f":"trad"},{"i":"c-1efa6718639b","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["宝鸭香凝袖。"],"s":"simp","f":"trad"},{"i":"c-289a3feb895f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["梅传春信。"],"s":"simp","f":"trad"},{"i":"c-c50c5e86da41","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["海棠著雨透胭脂。"],"s":"simp","f":"trad"},{"i":"c-ceed39a01703","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["碧玉堂前金粟斗。"],"s":"simp","f":"trad"},{"i":"c-96cc0e47167c","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["王孙去后多芳草。"],"s":"simp","f":"trad"},{"i":"c-52c5bc9cfe68","t":"江城梅花引","a":"无名氏","d":"宋","g":"词","p":["逋仙千载独知心。","别无人。","泪痕深。","长是自开自落自成阴。","白石后来疏影句，饶绮丽，总输他、清浅吟。","伤情。","伤情。","角中声。","夜沉沉。","更捣砧。","欲雪未雪、天欲老，云气昏昏。","梦绕西湖路渐不堪行。","人已骑驴毡笠去，留恨也，仗梅花、说与君。"],"s":"simp","f":"trad"},{"i":"c-a25e31c6ae79","t":"踏莎行","a":"无名氏","d":"宋","g":"词","p":["瘦影横斜，断桥路小。","如今梦断孤山了。","冷魂趁鹤不归来，荒山没尽深深草。","月下罗浮，一樽自笑。","旧枝尚记幽禽抱。","王令人梦里说相思，被谁惊破霜天晓。"],"s":"simp","f":"trad"},{"i":"c-132a91d94f18","t":"满江红","a":"无名氏","d":"宋","g":"词","p":["雪后郊原，烟林静、梅花初拆。","春初半、犹自探春消息。","一眼平芜看不尽，夜来小雨催新碧。","笑去年、携酒折花时，君应识。","兰舟漾，城南陌。","云影淡，天容窄。","绕风漪十顷，遥浮晴色。","恰似槎头收钓处，坐中仍有江南客。","试与问、何如两桨下苕溪，吞梦泽。"],"s":"simp","f":"trad"},{"i":"c-029398ff2273","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["月宫仙桂、被嫦娥试手，移来山谷。"],"s":"simp","f":"trad"},{"i":"c-f73af654e227","t":"献仙桃","a":"无名氏","d":"宋","g":"词","p":["元宵嘉会赏春光。","盛事当年忆上阳。","尧颡喜瞻天北极，舜衣深拱殿中央。","欢声浩荡连韶曲，和气氤氲带御香。","壮观大平何以报，蟠桃一朵献千祥。"],"s":"simp","f":"trad"},{"i":"c-5751aa5e7626","t":"献天寿慢・献天寿","a":"无名氏","d":"宋","g":"词","p":["日暖风和春更迟。","是太平时。","我从蓬岛整容姿。","来降贺丹墀。","幸逢灯夕真佳会，喜近天威。","神仙寿算远无期。","献君寿、万千斯。"],"s":"simp","f":"trad"},{"i":"c-53501327dffd","t":"献天寿令","a":"无名氏","d":"宋","g":"词","p":["阆苑人间虽隔，遥闻圣德弥高。","西离仙镜下云霄。","来献千岁灵桃。","上祝皇龄齐天久，犹舞蹈、贺贺圣朝。","梯航交凑四方遥。","端拱永保宗祧。"],"s":"simp","f":"trad"},{"i":"c-2845c867ad24","t":"金盏子慢・金盏子","a":"无名氏","d":"宋","g":"词","p":["丽日舒长，正葱葱瑞气，遍满神京。","九重天上，五云开处，丹楼碧阁峥嵘。","盛宴初开，锦帐绣幕交横。","应上元佳节，君臣际会，共乐升平。","广庭。","罗绮纷盈。","动一部、笙歌尽新声。","蓬莱宫殿神仙景。","浩荡春光，逦迤王城。","烟收雨歇，天色夜更澄清。","又千寻火树，灯山参差，带月鲜明。"],"s":"simp","f":"trad"},{"i":"c-019abe91852a","t":"金盏子令","a":"无名氏","d":"宋","g":"词","p":["东风报暖，到头嘉气渐融怡。","巍峨凤阙，起鳌山万仞，争耸云涯。","梨园弟子，齐奏新曲，半是埙篪。","见满筵、簪绅醉饱，颂鹿鸣诗。"],"s":"simp","f":"trad"},{"i":"c-220ad476f433","t":"瑞鹧鸪慢・瑞鹧鸪","a":"无名氏","d":"宋","g":"词","p":["海东今日太平天。","喜望龙云庆会筵。","尾扇初开明黼座，画帘高卷罩祥烟。","梯航交凑端门外，玉帛森罗殿陛前。","妾献皇龄千万岁，封人何更祝遐年。"],"s":"simp","f":"trad"},{"i":"c-815596b27f81","t":"瑞鹧鸪慢・瑞鹧鸪","a":"无名氏","d":"宋","g":"词","p":["北暴东顽，纳款慕义争来。","日新君德更明哉。","歌咏载衢街。","清宁海宇无馀事，乐与民同燕春台。","一年一度上元回。","愿醉万年杯。"],"s":"simp","f":"trad"},{"i":"c-f67cf3311dbe","t":"寿延长中腔令・寿延长","a":"无名氏","d":"宋","g":"词","p":["彤云映彩色相映，御座中、天簇簪缨。","万花铺锦满高庭。","庆敞需宴欢声。","千龄启统乐功成。","同意贺、元珪丰擎。","宝觞频举侠群英。","万万载、乐升平。"],"s":"simp","f":"trad"},{"i":"c-706e0f9545b5","t":"寿延长破字令","a":"无名氏","d":"宋","g":"词","p":["青春玉殿和风细。","奏箫韶络绎。","瑞绕行云飘飘曳。","泛金尊、流霞艳溢。","瑞日晖晖临丹扆。","广布慈德宸遐迩。","愿听歌声舞缀。","万万年、仰瞻宴启。"],"s":"simp","f":"trad"},{"i":"c-706e55904b6e","t":"步虚子令","a":"无名氏","d":"宋","g":"词","p":["碧烟笼晓海波闲。","江上数峰寒。","佩环声里，异香飘落人间。","弭绛节、五云端。","宛然共指嘉禾瑞，开一笑、破朱颜。","九重嶢阙，望中三祝高天。","万万载、对南山。"],"s":"mixed","f":"trad"},{"i":"c-f922d3bf177b","t":"破字令","a":"无名氏","d":"宋","g":"词","p":["缥缈三山岛。","十万岁、方分昏晓。","春风开遍碧桃花，为东君一笑。","祥飙暂引香尘到。","祝高龄、后天难老。","瑞烟散碧，归云弄暖，一声长啸。"],"s":"simp","f":"trad"},{"i":"c-fcbdc873d4c3","t":"抛球乐折花令・抛球乐","a":"无名氏","d":"宋","g":"词","p":["翠幕华筵，相将正是多欢宴。","举舞袖、回旋遍。","罗绮簇宫商，共歌清羡。","当琼浆泛泛满金尊，莫惜沉醉，莫惜沉醉，永日长游衍。","愿乐嘉宾，嘉宾式燕。"],"s":"simp","f":"trad"},{"i":"c-c6d65048c613","t":"抛球乐水龙吟令・抛球乐","a":"无名氏","d":"宋","g":"词","p":["洞天景色常春，嫩红浅白开轻萼。","琼筵镇起，金炉烟重，香凝锦幄。","窈窕神仙，妙呈歌舞，攀花相约。","彩云月转，朱丝网徐在，语笑抛球乐。","绣袂风翻凤举，转星眸、柳腰柔弱。","头筹得胜，欢声近地，光容约。","满座佳宾，喜听仙乐，交传觥爵。","龙吟欲罢，彩云摇曳，相将归去寥廓。"],"s":"simp","f":"trad"},{"i":"c-930bc44fd0f9","t":"抛球乐小抛球乐・抛球乐","a":"无名氏","d":"宋","g":"词","p":["两行花窍占风流。","缕金罗带系抛球。","玉纤高指红丝网，大家著意胜头筹。"],"s":"simp","f":"trad"},{"i":"c-be5e9a510a5d","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["满庭箫鼓簇飞球。","丝竿红网总台头。"],"s":"simp","f":"trad"},{"i":"c-714585268fd4","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["频歌覆手抛将过，两行人待看回筹。"],"s":"simp","f":"trad"},{"i":"c-8a7d84d48dc1","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["五花心里看抛球。","香腮红嫩柳烟稠。"],"s":"simp","f":"trad"},{"i":"c-d663bbf82c8c","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["清歌叠鼓连催促，这里不让第三头。"],"s":"simp","f":"trad"},{"i":"c-7fcf1df667ba","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["箫鼓声声且莫催。","彩球高下意难裁。"],"s":"simp","f":"trad"},{"i":"c-c9db72da3620","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["恐将脂粉均妆面，羞被狂毫抹污来。"],"s":"simp","f":"trad"},{"i":"c-a7e798bbda1c","t":"清平令破子・清平乐","a":"无名氏","d":"宋","g":"词","p":["满庭罗绮流粲。","清朝画楼开宴。","似初发芙蓉正烂熳。","金尊莫惜频劝。","近看柳腰似折。","更看舞回流雪。","是欢乐、宴游时节。","且莫催、欢歌声阕。"],"s":"simp","f":"trad"},{"i":"c-f0314e5a79e2","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["春早皇都冰泮。","宫沼东风布轻暖。","梅粉飘香，柳带弄色，瑞霭祥烟凝浅。","正值元宵，行乐同民总无闲。","肆情怀，何惜相邀，是处里容款。"],"s":"simp","f":"trad"},{"i":"c-4b882f38d9ab","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["无算。","仗委东君遍。","有风光、占五陵闲散。","从把千金，五夜继赏，并彻春宵游玩。","借问花灯，金琐琼瑰果曾罕。","洞天里，一掠蓬瀛，第恐今宵短。"],"s":"simp","f":"trad"},{"i":"c-8635aa74177e","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["夸帝里。","万灵咸集，永卫紫陌青楼，富臻既庶矣。","四海升平，文武功勋盖世。","赖圣主，兴贤佐，恁致理。","气绪凝和，会景新、访雅致。","列群公锡宴在迩。","上元循典，胜古高超荣异。","望绛霄、龙香飘飘旖旎。"],"s":"simp","f":"trad"},{"i":"c-c4baff12002a","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["景云披靡。","露浥轻寒若水。","尽是游人美。","陌尘润、宝沉递。","笑指扬鞭，多少高门胜会。","况是。","只有今夕誓无寐。"],"s":"simp","f":"trad"},{"i":"c-cc4e80c87bb8","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["盛日凝理。","羽巢可窥。","阆苑金关启扉。","烬连宵、宁防避。","暗尘随马，明月逐人无际。","调戏。","相歌秾李末阑已。"],"s":"simp","f":"trad"},{"i":"c-4295770150a6","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["骋轮纵勒，翠羽花钿比织。","并雅同陪，共越九衢遍，尽遨逸。","料峭云容，香惹风、萦怀袂。","遍寓目，几处瑶席绣帟。"],"s":"simp","f":"trad"},{"i":"c-5ba257f58557","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["莫如胜慨，景压天街际。","彩鳌举、百仞耸倚。","凤舞龙骧，满目红光宝翠。","动霁色，馀霞映，散成绮。"],"s":"simp","f":"trad"},{"i":"c-b56a7bff1653","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["渐灼兰膏，覆满青烟罩地。","簇宫花、撋荡纷委。","万姓瞻仰，苒苒云龙香细。","共稽首，同乐与，众方纪。"],"s":"simp","f":"trad"},{"i":"c-70fc6295bf3a","t":"惜奴娇","a":"无名氏","d":"宋","g":"词","p":["楼起霄宫里。","五福中天纷绛瑞。","弦管齐谐，清宛振逸天外。","万舞低回纷绕，罗纨摇曳。","顷刻转轮归去，念感激天意。","幸列熙台，洞天遥遥望圣梓。","五夕华胥，鱼钥并开十二。","圣景难逢无比。","人间动且经岁。","娩婉踌躇，再拜五云迤逦。"],"s":"simp","f":"trad"},{"i":"c-a2de8d523c88","t":"万年欢慢・万年欢","a":"无名氏","d":"宋","g":"词","p":["禁篽初晴，见万年枝上，工啭莺声。","藻殿连云，萍曦高照檐楹。","好是帘开丽景，袅金炉、香暖烟轻。","传呼道、天跸来临，两行拱引簪缨。","看看筵敞三清。","洞宝玉杯中，满酌犀觥。","烂熳芳葩，斜簪庆快春情。","更有箫韶九奏，簇鱼龙、百戏俱呈。","吾皇愿、永保洪图，四方长乐升平。"],"s":"simp","f":"trad"},{"i":"c-fac29bb26d44","t":"万年欢慢・万年欢","a":"无名氏","d":"宋","g":"词","p":["当今圣主，理化感四塞，永减狼烟。","太平朝野无征战，国内晏然。","风调雨顺歌声喧。","箫韶韵，九奏钧天。","愿王永寿，比南山、更奏延年。"],"s":"simp","f":"trad"},{"i":"c-46523f194708","t":"万年欢慢・万年欢","a":"无名氏","d":"宋","g":"词","p":["婥妁要肢轻婀娜。","学内样、深深梳果。","如五凤双鸾相对舞，随腰带、乍游琐。","莺幕、满头花，见绿杨摸蔌。","金阶献，一庭细管繁弦里，谁把ㄉ抛过。","舞鸾双翥，香兽低。","散瑞景烟微。","投袂翩翩，趁拍迟迟。","按曲度瑶池。","曲遍新声，敛绣衣跪。","彩袖高捧琼卮。","指月中丹桂。","春难老，祝仙寿维祺。"],"s":"simp","f":"trad"},{"i":"c-d3d508e8674b","t":"忆吹箫慢・凤凰台上忆吹箫","a":"无名氏","d":"宋","g":"词","p":["血洒霜罗，泪薄艳锦，伊方教我成行。","渐望断、斜桥暮柳，曲水归云。","月暗风高露冷，独自才抵孤城。","江南远，今夜就中，愁损行人。","愁人。","旧香遗粉，空淡淡馀暖，隐隐残痕。","到这里、思量是我，忒□无情。","水更无情侣我，催画航、一日三程。","休烦恼，相见定约新春。"],"s":"simp","f":"trad"},{"i":"c-c34b4ddcbaa0","t":"月华清慢・月华清","a":"无名氏","d":"宋","g":"词","p":["雨洗天开，风将云去，极目都无纤翳。","当遇中秋夜，静月华如水。","素光晃、金屋楼台，清气彻、玉壶天地。","此际。","比无常三五，婵娟特异。","因念玉人千里。","待尽把愁肠，分付沉醉。","只恐难当漏尽，又还经岁。","最堪恨、独守书帏，空对景、不成欢意。","除是。","问姮娥觅取，一枝仙桂。"],"s":"simp","f":"trad"},{"i":"c-2c5093212a03","t":"感皇恩令・感皇恩","a":"无名氏","d":"宋","g":"词","p":["和袖把金鞭，腰如束素。","骑介驴儿过门去。","禁街人静，一阵香风满路。","凤鞋宫样小，弯弯露。","蓦地被他，回眸一顾。","便是令人断肠处。","愿随鞭镫，又被名缰勒住。","恨身不做个，闲男女。"],"s":"simp","f":"trad"},{"i":"c-1d2c5d090d8c","t":"醉太平","a":"无名氏","d":"宋","g":"词","p":["厌厌闷着。","厌厌闷着。","奴儿近日听人咬，把初心忘却。","教人病深谩摧拙。","凭谁与我分说破，仔细思量怎奈何，见了伏些弱。"],"s":"simp","f":"trad"},{"i":"c-0be694e99b81","t":"还宫乐","a":"无名氏","d":"宋","g":"词","p":["喜贺我皇，有感蓬莱，尽降神仙。","到乘鸾驾鹤御楼前。","来献长寿仙丹。","玉殿阶前排筵会，今宵秋日到神仙。","笙歌寥亮呈玉庭，为报圣寿万年。"],"s":"simp","f":"trad"},{"i":"c-39df91c0ae9c","t":"清平乐","a":"无名氏","d":"宋","g":"词","p":["真主玉历成康。","德睿宁安国中良。","时和岁丰稔，民阜乐、何情泚，瑞木呈日五色，月华重有光。","更羽鹤来仪凤凰。","万邦乡。","齐供明皇。","祝遐龄、圣寿无疆。"],"s":"simp","f":"trad"},{"i":"c-cf049e7f9d04","t":"荔子丹","a":"无名氏","d":"宋","g":"词","p":["斗巧宫妆扫翠眉。","相唤折花枝。","晓来深入艳芳里，红香散，露浥在罗衣。","盈盈巧笑咏新词。","舞态画娇姿。","袅娜文回迎宴处，簇神仙、会赴瑶池。"],"s":"simp","f":"trad"},{"i":"c-cca7e9a9c7b6","t":"水龙吟慢・水龙吟","a":"无名氏","d":"宋","g":"词","p":["玉皇金阙长春，民仰高天欣载。","年年一度定佳期，风情多感慨。","绮罗竞交会。","争折花枝两相对。","舞袖翩翩歌声妙，掩粉面、斜窥翠黛。","锦额门开彩架，球儿裳、先秀神仙队。","融香拂席霓裳动，铿锵环珮。","宝座巍巍五云密，欢呼争拜退。","管弦众作欲归去，愿吾皇、万年恩爱。"],"s":"simp","f":"trad"},{"i":"c-6c525c98d682","t":"太平年慢・太平年","a":"无名氏","d":"宋","g":"词","p":["皇州春满群芳丽。","散异香旖旎。","鳌宫开宴赏佳致。","举笙歌鼎沸。","永日迟迟和风媚。","柳色烟凝翠。","唯恐日西坠。","且乐欢醉。"],"s":"simp","f":"trad"},{"i":"c-bdb3a4d6b015","t":"金殿乐慢","a":"无名氏","d":"宋","g":"词","p":["驾紫鸾軿。","乘风缥缈游仙。","红霓蘸影，近瑶池、鹤戏芝田。","临蕙圃、饮琼泉。","上萧台、遥瞻九天。","对真人蕊书亲授，已向南宫住长年。"],"s":"simp","f":"trad"},{"i":"c-33af484c81e5","t":"安平乐・安平乐慢","a":"无名氏","d":"宋","g":"词","p":["开琼筵，庆佳辰。","彩帟当中月华明。","笙歌乐、如梦幻，望丹山彩凤，飞舞邃庭。","遐艳异、寿杯同斟。","抃舞讴歌浃欢声。","方今永永太平。","更衍多男，共集锦昌寿恩。"],"s":"simp","f":"trad"},{"i":"c-f0a6e0fa96ce","t":"爱月夜眠迟慢","a":"无名氏","d":"宋","g":"词","p":["禁鼓初敲，觉六街夜悄，车马人稀。","暮天澄淡，云收雾卷，亭亭皎月如珪。","冰轮碾出遥空，无私照临千里。","最堪怜、有情风，送得丹桂香微。","唯愿素魄长圆，把流霞对饮，满泛觥卮。","醉凭栏处、赏玩不忍，辜却好景良时。","清歌妙舞连宵，踟蹰懒入罗帏。","任佳人、尽嗔我，爱月每夜眠迟。"],"s":"simp","f":"trad"},{"i":"c-1d44980b6cd5","t":"惜花春起早慢","a":"无名氏","d":"宋","g":"词","p":["向春来，睹林园，绣出满槛鲜萼。","流莺海棠枝上弄舌，紫燕飞绕池阁。","三眠细柳，垂万条、罗带柔弱。","为思量，昨夜去看花，犹自斑驳。","须拌尽日樽前，当媚景良辰，且恁欢谑。","更阑夜深秉烛，对花酌、莫辜轻喏。","邻鸡唱晓，惊觉来、连忙梳掠。","向西园、惜群葩，恐怕狂风吹落。"],"s":"simp","f":"trad"},{"i":"c-ce611ed6fec8","t":"千秋岁令・千秋岁引","a":"无名氏","d":"宋","g":"词","p":["想风流态，种种般般媚。","恨别离时大容易。","香笺欲写相思意。","相思泪滴香笺字。","画堂深，银烛暗，重门闭。","似当日、欢娱何日遂。","愿早早相逢重设誓。","美景良辰莫轻拌，鸳鸯帐里鸳鸯被。","鸳鸯枕上鸳鸯睡。","似恁地，长恁地，千秋岁。"],"s":"simp","f":"trad"},{"i":"c-e769376ab2dd","t":"风中柳令・谢池春","a":"无名氏","d":"宋","g":"词","p":["爱鬓云长，惜眉山，寻乍相见，一时眠起。","为伊尚验，未欲将言相戏。","早樽前、会人深意。","霎时间阻，眼儿早巴巴地。","便也解、封题相寄。","怎生是款曲，终成连理。","管胜如、旧来识底。"],"s":"simp","f":"trad"},{"i":"c-68183ae36c57","t":"汉宫春慢・汉宫春","a":"无名氏","d":"宋","g":"词","p":["春日迟迟。","称游人、尽日赏燕芳菲。","新荷泛水，渐入夏景云奇。","炎光易息，又早是、零落风西。","白露点，黄金菊蕊，朝云暮雪霏霏。","光阴迅速如飞。","邀酒朋共欢，且恁开眉。","清歌妙舞，更兼玉管瑶篪。","人生易老，遇太平、且乐嬉嬉。","莫待解，朱颜顿觉，年来不似当时。"],"s":"simp","f":"trad"},{"i":"c-f94cd836760e","t":"花心动慢・花心动","a":"无名氏","d":"宋","g":"词","p":["暑逼芳襟，甚全无因依，便教人恶。","赖有枕溪百尺，朱楼映日，数重香箔。","驮冰围定犹嫌暖，红日绽、雨收残脚。","漫试取，红绡弄雪，碎琼推削。","妆罢低云未稤。","叶叶地仙衣，剪轻裁薄。","汗洒泪珠，急捧金盘，向前颗颗盛却。","凤凰双扇相交扇，越撋就、越腰肢弱。","待做个、青纱罩儿罩著。"],"s":"simp","f":"trad"},{"i":"c-5b8a45593d17","t":"行香子慢","a":"无名氏","d":"宋","g":"词","p":["瑞景光融。","换中天霁烟、佳气葱葱。","皇居崇壮丽，金碧辉空。","彤霄外、瑶殿深处，帘卷花影重重。","迎步辇、几簇真仙，贺庆寿新宫。","方逢。","圣主飞龙。","正休盛大宁，朝野欢同。","何妨宴赏，奉宸意慈容。","韶音按、露觞将进，蕙炉飘馥香浓。","长愿承颜，千秋万岁，明月清风。"],"s":"simp","f":"trad"},{"i":"c-8287daa60a67","t":"雨中花慢","a":"无名氏","d":"宋","g":"词","p":["宴阙倚栏郊外，乍别芳姿，醉登长陌。","渐觉联绵离绪，淡薄秋色。","宝马频嘶，寒蝉晚、正伤行客。","念少年踪迹。","风流声价，泪珠偷滴。","从前与、酒朋花侣，镇赏画楼瑶席。","今夜里、清风明月，水村山驿。","往事悠悠似梦，新愁苒苒如织。","断肠望极。","重逢何处，暮云凝碧。"],"s":"simp","f":"trad"},{"i":"c-4f8651df9490","t":"迎春乐令・迎春乐","a":"无名氏","d":"宋","g":"词","p":["神州丽景春先到。","看看是、韶光早。","园林深处东风过，红杏里、莺声好。","漠漠青烟远远道。","触目是、绿杨芳草。","莫惜醉重游，逡巡又、年华老。"],"s":"simp","f":"trad"},{"i":"c-cd5a5aa2d7ae","t":"西江月慢","a":"无名氏","d":"宋","g":"词","p":["烟笼细柳，映粉墙、垂丝轻袅。","正岁稍暖律风和，装点后苑台沼。","见乍开、桃若燕脂染，便须信、江南春早。","又数枝、零乱残花，飘满地、未曾扫。","幸到此、芳菲时渐好。","恨间阻、佳期尚杳。","听几声、云里悲鸿，动感怨愁多少。","谩送目、层阁天涯远，甚无人、音书来到。","又只恐、别有深情，盟言忘了。"],"s":"simp","f":"trad"},{"i":"c-2de71d0137ba","t":"游月宫令","a":"无名氏","d":"宋","g":"词","p":["当今圣主座龙楼，圣寿应天长，实钱喷香烟，玄宗游月宫。","海晏河清，盛朝侍，群臣喜呼万岁，万人民，开乐业，愿吾皇、增福寿。"],"s":"simp","f":"trad"},{"i":"c-0e78071f4d4d","t":"桂枝香慢・桂枝香","a":"无名氏","d":"宋","g":"词","p":["暖风迟日，正韶阳时节，淑景明媚。","一霎雨打红桃，花落满地。","□闺独坐帘高卷，困春容、懒临香砌。","自从檀郎，金门献赋，不绝朱翠。","闻上国、才有书回，应贤良明庭，已擢高第。","拆破香笺，离恨却成新喜。","早教宴罢琼林苑，愿归来、永同连理。","这回良夜，从他桂枝，香惹鸳被。"],"s":"simp","f":"trad"},{"i":"c-74f58bf1dbad","t":"庆金枝令・庆金枝","a":"无名氏","d":"宋","g":"词","p":["莫惜金缕衣。","劝君惜、少年时。","花开堪折直须折，莫待折空枝。","一朝杜宇才鸣后，便从此、歇芳菲。","有花有酒且开眉。","莫待满头丝。"],"s":"simp","f":"trad"},{"i":"c-aa839c6ac688","t":"百宝妆・新雁过妆楼","a":"无名氏","d":"宋","g":"词","p":["一抹弦器，初宴画堂，琵琶人把当头。","髻云腰素，仍占绝风流。","轻拢慢拈，生情艳态，翠眉黛颦，无愁谩似愁。","变新声曲，自成获索，共听一奏梁州。","弹到遍急敲颖，分明似语，争知指面纤柔。","坐中无语，惟断续金虬。","曲终暗会王孙意，转步莲、徐徐卸凤钩。","捧瑶觞，为喜知音，劝佳人、沉醉迟留。"],"s":"simp","f":"trad"},{"i":"c-b47b11e28b73","t":"满朝欢令","a":"无名氏","d":"宋","g":"词","p":["未央宫阙丹霞住。","十二玉楼挥锦绣。","云开雉扇卷珠帘，烟粉龙香添瑞兽。","瑶觞一举箫韶奏。","环佩千官齐拜首。","南山翠应北华高，共献君王千万岁。"],"s":"simp","f":"trad"},{"i":"c-2b52de8ba857","t":"天下乐令・减字木兰花","a":"无名氏","d":"宋","g":"词","p":["寿星明久。","寿曲高歌沉醉后。","寿烛荧煌。","手把金炉，燃一寿香。","满斟寿酒。","我意殷勤来祝寿。","问寿如何。","寿比南山福更多。"],"s":"simp","f":"trad"},{"i":"c-2c0c6c3875e1","t":"感恩多令・山花子","a":"无名氏","d":"宋","g":"词","p":["罗帐半垂门半开。","残灯孤月照窗台。","北斗渐移天欲曙、漏更催。","携手劝君离别酒，泪和红粉滴金杯。","呜咽问君今夜去、几时回。"],"s":"simp","f":"trad"},{"i":"c-a1a80224d9c0","t":"解佩令","a":"无名氏","d":"宋","g":"词","p":["脸儿端正。","心儿峭俊。","眉儿长、眼儿入鬓。","鼻儿隆隆，口儿小、舌儿香软。","耳垛儿、就中红润。","项如琼玉，发如云鬓。","眉如削、手如春笋。","奶儿甘甜，腰儿细、脚儿去紧。","那些儿、更休要问。"],"s":"simp","f":"trad"},{"i":"c-4f9806bbb888","t":"沁园春","a":"无名氏","d":"宋","g":"词","p":["道过江南，泥墙粉壁，石具在前。","述某州某县，某乡某里，住何人地，佃何人田。","气象萧条，生灵憔悴，经略从来未必然。","惟何甚，为官为已，不把人怜。","思量几许山川。","况土地分张又百年。","正西蜀巉岩，云迷鸟道，两淮清野，日警狼烟。","宰相弄权，奸人罔上，谁念干戈未息肩。","掌大地，何须经理，万取千焉。"],"s":"simp","f":"trad"},{"i":"c-b298e2470eb4","t":"糖多令・唐多令","a":"无名氏","d":"宋","g":"词","p":["天上谪星班。","青牛初度关。","幻出蓬莱新院宇，花外竹，竹边山。","轩冕傥来闲。","人生闲最难。","算真闲、不到人间。","一半神仙先占取，留一半、与公闲。"],"s":"simp","f":"trad"},{"i":"c-8141681a1d1c","t":"长相思","a":"无名氏","d":"宋","g":"词","p":["去年秋。","今年秋。","湖上人家乐复忧。","西湖依旧流。","吴循州。","贾循州。","十五年前一转头。","人生放下休。"],"s":"simp","f":"trad"},{"i":"c-1210edf598e0","t":"祝英台近","a":"无名氏","d":"宋","g":"词","p":["掩琵琶，临别语，把酒泪如洗。","似恁春时，仓卒去何意。","牡丹恰则开园，荼䕷厮句，便下得、一帆千里。","好无谓。","复道明日行呵，如何恋得你。","一叶船儿，休要更沉醉。","后梅子青时，杨花飞絮，侧耳听，喜鹊□哩。"],"s":"simp","f":"trad"},{"i":"c-e61f30070dc4","t":"汉宫春","a":"无名氏","d":"宋","g":"词","p":["横吹声沉，倚危楼红日，江转天斜。","黄尘边火澒洞，何处吾家。","胎禽怨夜，半乘风、玄露丹霞。","先生笑，飞空一剑，东风犹自天涯。","情知道山中好，早翠嚣含隐，瑶草新芽。","青溪故人信断，梦逐飙车。","乾坤星火，归来兮、煮石煎砂。","回首处、幅巾蒲帐，云边独笑桃花。"],"s":"simp","f":"trad"},{"i":"c-487cf2714da4","t":"水调歌头","a":"无名氏","d":"宋","g":"词","p":["握虎符，持玉节，佩金鱼。","三十正当方面，此事世间无。","寄语东淮父老，夺我诗书元帅，於汝抑安乎。","早早归廊庙，天下尽欢娱。"],"s":"mixed","f":"trad"},{"i":"c-65eb37cb174e","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["夜深青女湿微妆。"],"s":"simp","f":"trad"},{"i":"c-77681ee17fcd","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["曾教入夜月添白。"],"s":"simp","f":"trad"},{"i":"c-23624bceb48c","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["自有松篁为伴侣。"],"s":"simp","f":"trad"},{"i":"c-90147565af6f","t":"忆秦娥","a":"无名氏","d":"宋","g":"词","p":["烟漠漠。","水天摇荡蓬莱阁。","蓬莱阁，朱甍碧瓦，半浸寥廓。","三山谩有长生药。","茫茫云海风涛恶。","风涛恶。","仙槎不见，暮沙潮落。"],"s":"simp","f":"trad"},{"i":"c-2528203529da","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["汉宫梳罢女真妆，望金仙、朝朝暮暮。"],"s":"simp","f":"trad"},{"i":"c-f3a2f035f3a6","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["愁烟恨粉。"],"s":"simp","f":"trad"},{"i":"c-b8495539b75f","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["三生春梦。"],"s":"simp","f":"trad"},{"i":"c-8cb312e8f12f","t":"减字木兰花","a":"无名氏","d":"宋","g":"词","p":["舞台歌院。","雨后西风寒翦翦。","翠掩屏风。","花与残霞一样红。","宫裀隐绣。","香软巧随莲步绉。","不怕露寒。","日日拼教醉画栏。"],"s":"simp","f":"trad"},{"i":"c-9a242b3c18fe","t":"虞美人","a":"无名氏","d":"宋","g":"词","p":["秋深犹带秋初热。","未放秋香发。","爱他楼下木芙蓉。","妆罢三千美女、出唐宫。","西湖虽小风光胜。","分得钱塘景。","这些林木这些山。","恰似三贤堂后、凭阑干。"],"s":"simp","f":"trad"},{"i":"c-964e77321bf4","t":"念奴娇","a":"无名氏","d":"宋","g":"词","p":["晓来雨过，见三点两点，催花开却。","满目园林如锦绣，低亚阑干西角。","魏紫风流，姚黄妖艳，桃李皆粗俗。","金刀翦下，燕鸳窥妒惊愕。","雅称似玉人人，淡妆才罢，粉衬胭脂薄。","蝉翼轻笼云鬓巧，斜插一枝红萼。","睡足杨妃，醉沉西子，娇困铅华落。","多情风蝶，晚来犹更随著。"],"s":"simp","f":"trad"},{"i":"c-0c127ebfadcb","t":"望江南・忆江南","a":"无名氏","d":"宋","g":"词","p":["左右字，从古不曾闻。","未必书生能点墨，安知荫子不能文。","尔汝今朝。","除去了，多谢圣明恩。","既不可高谈阔论，又不敢藐视同群。","但请换头巾。"],"s":"simp","f":"trad"},{"i":"c-157efefe77bd","t":"朝中措","a":"无名氏","d":"宋","g":"词","p":["与君同是饱齑盐。","先达后何淹。","任玉东西醉倒，明朝病酒厌厌。","后年三月，凤池春满，雁塔名添。","记取西风桂影，一枝先上银蟾。"],"s":"simp","f":"trad"},{"i":"c-d037eed27fc2","t":"忆秦娥","a":"无名氏","d":"宋","g":"词","p":["花蹊侧。","秦楼夜访金钗客。","金钗客。","江梅风韵，野棠颜色。","尊前醉倒君休惜。","不成去后空相忆。","空相忆。","山长水远，几时来得。"],"s":"simp","f":"trad"},{"i":"c-b00eee384efe","t":"失调名","a":"无名氏","d":"宋","g":"词","p":["往来与月为俦，舒展和天也蔽。"],"s":"simp","f":"trad"},{"i":"c-86ac0cb3f108","t":"倚西楼","a":"无名氏","d":"宋","g":"词","p":["禁鼓初传时下打。","虚过清风明月夜。","眼如鱼目几曾乾，心似酒旗终日挂。","银汉低垂星斗斜。","院宇空寥烛卸。","西楼萧洒有谁知，教我独自上来、独自下。"],"s":"mixed","f":"trad"},{"i":"c-f5d952714b39","t":"捣练子","a":"无名氏","d":"宋","g":"词","p":["云鬓乱，晚妆残。","带恨眉儿远岫攒。","斜托香腮春笋懒，为谁和泪倚阑干。"],"s":"simp","f":"trad"}]