[{"i":"c-696c1e4eb6a5","t":"霜天晓角","a":"刘辰翁","d":"宋","g":"词","p":["良宵七七。","又近中元日。","桥上老人有约，后五日、重来觅。","婵娟银海出。","木犀新雨湿。","惟有延平剑气，箕斗外、广寒逼。"]},{"i":"c-cb3c9c766227","t":"霜天晓角","a":"刘辰翁","d":"宋","g":"词","p":["归来把菊。","春瓮今朝熟。","苦苦留君不得，携孺子、到汾曲。","庐山真面目。","冰清还映玉。","长笑欧公老懒，君且住，饮螺绿。"]},{"i":"c-716f02f36e4e","t":"霜天晓角","a":"刘辰翁","d":"宋","g":"词","p":["问春来未。","也似辛壬癸。","如此男儿五十，又过却、孔融二。","画堂孙子子。","新桃如故垒。","不管明朝后日，春满眼、是千岁。"]},{"i":"c-7add48e557dc","t":"霜天晓角","a":"刘辰翁","d":"宋","g":"词","p":["□□□□。","□□□□□。","□□□□□□，□□□、□□□。","治中心似佛。","治中心似日。","人祝治中千岁，似翁福、似翁德。"]},{"i":"c-629f53ba1a94","t":"卜算子","a":"刘辰翁","d":"宋","g":"词","p":["不是重看灯，重见河边女。","长是蛾儿作队行，路转风吹去。","十载废元宵，满耳番腔鼓。","欲识尊前太守谁，起向尊前舞。"]},{"i":"c-4fc666306644","t":"卜算子","a":"刘辰翁","d":"宋","g":"词","p":["早已是三年，父老依依借。","顾与天公借几年，保我鸡豚社。","□□□□□，□□□□□。","□□□□□□□，□□□□□。"]},{"i":"c-8815c927049b","t":"菩萨蛮","a":"刘辰翁","d":"宋","g":"词","p":["芭蕉叶上三更雨。","人生只合随他去。","便不到天涯。","天涯也是家。","屏山三五叠。","处处飞胡蝶。","正是菊堪看。","东篱独自寒。"]},{"i":"c-1e832fb8f34e","t":"菩萨蛮","a":"刘辰翁","d":"宋","g":"词","p":["黄鸡喔喔催人起。","困不成眠窗似水。","清露不曾寒。","朝来起自难。","家人当睡美。","又忆归程几。","不管湿阑干。","芙蓉花自看。"]},{"i":"c-0b39b1fb7ef9","t":"菩萨蛮","a":"刘辰翁","d":"宋","g":"词","p":["画梁语透帘栊晓。","坼桐风送杨花老。","细雨绿阴寒。","罗襟只似单。","青门三里道。","个个游芳草。","比似嫁来看。","踏青难更难。"]},{"i":"c-78b0bcff336c","t":"菩萨蛮","a":"刘辰翁","d":"宋","g":"词","p":["江波何似西湖曲。","村烟相对峰南北。","何处不青青。","青青是汉茔。","长亭芳草路。","寒食谁家墓。","旧日厌残红。","人行九里松。"]},{"i":"c-684f2be31f46","t":"菩萨蛮","a":"刘辰翁","d":"宋","g":"词","p":["殷勤欲送春归去。","白首题将断肠句。","春去自依依。","欲归无处归。","天涯同是寓。","握手留春住。","小住碧桃枝。","桃根不属谁。"]},{"i":"c-140db5e99692","t":"菩萨蛮","a":"刘辰翁","d":"宋","g":"词","p":["八仙名姓当时少。","污尊牛饮同倾倒。","惟有我公荣。","旁人笑独醒。","多年村落走。","泥饮无升斗。","入了玉门关。","人生一醉难。"]},{"i":"c-7aad52150981","t":"好事近","a":"刘辰翁","d":"宋","g":"词","p":["□后百年闲，元度自伤来暮。","打破虚空无碍，共乘龙飞去。","更参末后句如何，此事未能付。","前遇小桥风雪，是君诗成处。"]},{"i":"c-9bf52296fb51","t":"谒金门","a":"刘辰翁","d":"宋","g":"词","p":["娇点点。","困倚春光欲软。","滴尽守宫难可染。","浓欺红烛艳。","寂寂露珠啼脸。","翠袖不禁风飐。","芳径相逢惊笑靥。","日长初睡转。"]},{"i":"c-641d524ee83f","t":"谒金门","a":"刘辰翁","d":"宋","g":"词","p":["花露湿。","红泪裛成珠粒。","比似昭阳恩未得。","睡来添醉色。","一笑娇波滴滴。","再顾羞潮拂拂。","恨血千年明的皪。","千年人共忆。"]},{"i":"c-327d9a038826","t":"谒金门","a":"刘辰翁","d":"宋","g":"词","p":["游赏竞。","看取落红阵阵。","花睡不成娇似病。","春寒空受尽。","旧日不知繁盛。","欲饮如今无兴。","恨满东风无绿鬓。","东风还自恨。"]},{"i":"c-1dbd1c79bd4e","t":"长相思","a":"刘辰翁","d":"宋","g":"词","p":["上元晴。","上元晴。","待得晴时坐触屏。","山禽三两声。","欲归城。","未归城。","见说城中处处灯。","明年处处行。"]},{"i":"c-0d7ebcbc1e9b","t":"忆秦娥","a":"刘辰翁","d":"宋","g":"词","p":["烧灯节。","朝京道上风和雪。","风和雪。","江山如旧，朝京人绝。","百年短短兴亡别。","与君犹对当时月。","当时月。","照人烛泪，照人梅发。"]},{"i":"c-c64015125e9e","t":"忆秦娥","a":"刘辰翁","d":"宋","g":"词","p":["惊雷节。","梅花冉冉销成雪。","销成雪。","一年一度，为君肠绝。","古人长恨中年别。","馀年又过新正月。","新正月。","不堪临镜，不堪垂发。"]},{"i":"c-6e766db2fa9f","t":"忆秦娥","a":"刘辰翁","d":"宋","g":"词","p":["梅花节。","白头卧起餐毡雪。","餐毡雪。","上林雁断，上林书绝。","伤心最是河梁别。","无人共拜天边月。","天边月。","一尊对影，一编残发。"]},{"i":"c-47c1f1c440ac","t":"忆秦娥","a":"刘辰翁","d":"宋","g":"词","p":["收灯节。","霖铃又似龟山雪。","龟山雪。","今宵清绝，今宵愁绝。","老人似少终然别。","痴痴更望春三月。","春三月。","花如人面，自羞余发。"]},{"i":"c-1a94d4dca222","t":"忆秦娥","a":"刘辰翁","d":"宋","g":"词","p":["春如昨。","晓风吹透胭脂阁。","胭脂阁。","满园茅草，冷烟城郭。","青衫泪尽楼头角。","佳人梦断花间约。","花间约。","黄昏细雨，一枝零落。"]},{"i":"c-35572abdf462","t":"西江月","a":"刘辰翁","d":"宋","g":"词","p":["天上低昂似旧，人间儿女成狂。","夜来处处试新妆。","却是人间天上。","不觉新凉似水，相思两鬓如霜。","梦从海底跨枯桑。","阅尽银河风浪。"]},{"i":"c-9979ae3576ed","t":"西江月","a":"刘辰翁","d":"宋","g":"词","p":["曾与回翁把手，自宜老子如龙。","怀胎不敢问春冬。","等待鞭鸾笞凤。","昨夜又迟黄石，今朝重叩鸿濛。","碧桃花下醉相逢。","说尽鹏游蝶梦。"]},{"i":"c-3912919025f7","t":"西江月","a":"刘辰翁","d":"宋","g":"词","p":["玉帐传心如镜，青龙绕指成轮。","尘中多少白头人。","乾里寻壬难认。","世事说来都了，鬼神见也须瞋。","迷槎问我是何津。","向道先生昼困。"]},{"i":"c-062e0e7816d9","t":"清平乐","a":"刘辰翁","d":"宋","g":"词","p":["深红半面。","一似墙头见。","草树池塘青一片。","独倚阑干几遍。","更谁绛袖朱唇。","火云相对英英。","笑杀牡丹正午，离披不任看承。"]},{"i":"c-2b0d108914a0","t":"清平乐","a":"刘辰翁","d":"宋","g":"词","p":["君词为寿。","绝妙孙辛妇。","但恨杯无露添酒。","空等待梅花久。","喜君白首还玄。","人间合信天缘。","如此相从至老，我亦何倦馀年。"]},{"i":"c-be4f2a2653f4","t":"归国遥","a":"刘辰翁","d":"宋","g":"词","p":["初雨歇。","照水绿腰裙带熟。","杨花不做人情雪。","风流欲过前村蝶。","羞成别。","回头却恨春三月。"]},{"i":"c-d444ab18de67","t":"昭君怨","a":"刘辰翁","d":"宋","g":"词","p":["月出东山之上。","长忆御街人唱。","恨我不能琴。","有琴心。","徙倚秋波平莹。","渐久玉肌清冷。","待更下阑干。","起来看。"]},{"i":"c-5af28fbb66d9","t":"浣溪沙","a":"刘辰翁","d":"宋","g":"词","p":["远远游蜂不记家。","数行新柳自啼鸦。","寻思旧事即天涯。","睡起有情和画卷，燕归无语傍人斜。","晚风吹落小瓶花。"]},{"i":"c-8a5e70c416a7","t":"浣溪沙","a":"刘辰翁","d":"宋","g":"词","p":["点点疏林欲雪天。","竹篱斜闭自清妍。","为伊憔悴得人怜。","欲与那人携素手，粉香和泪落君前。","相逢恨恨总无言。"]},{"i":"c-6cdf3a414264","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["何须翦纸。","依旧一团圆照水。","莫倚空寒。","柳下池边也只般。","君何忽忽。","宇宙人生都是客。","月在云端。","人自愁人不解看。"]},{"i":"c-bd8b6b6a1c39","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["旧游山路。","落在秋阴最深处。","风雨重阳。","无蝶无花更断肠。","天知老矣。","莫累门生与儿子。","不用登高。","高处风吹帽不牢。"]},{"i":"c-1d835967d4e6","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["东风似客。","醉里落花南又北。","客似东风。","携手斜阳一笑中。","佳人怨我。","不寄江南春一朵。","我怨佳人。","憔悴江南不似春。"]},{"i":"c-814c70bfaeb3","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["腊销三五。","月向雪山云外吐。","烟水黄昏。","梅柳依稀笛断魂。","今宵豫赏。","便作香尘随步想。","莫待元宵。","灯火零星雨寂寥。"]},{"i":"c-96f536e64022","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["无灯可看。","雨水从教正月半。","探茧推盘。","探得千秋字字看。","铜驼故老。","说著宣和似天宝。","五百年前。","曾向杭州看上元。"]},{"i":"c-44ae7391909a","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["送春待晓。","春是五更先去了。","我醉方知。","春正怜伊怕别伊。","留君不可。","归到海边方忆我。","做尽花归。","欲赠君时少一枝。"]},{"i":"c-cf92cdb7ab5f","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["相州锦好。","待到相州人已老。","颍水归田。","白鹭惊猜已十年。","太师尚父。","晚遇明时方用武。","大笑相逢。","把酒家乡是客中。"]},{"i":"c-7b9d39ff7ad2","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["不能管得。","欲雨能教天地黑。","待得开晴。","不用吾言也自行。","一杯亦醉。","万事无能吾欲睡。","旧亦能诗。","说旧时诗问是谁。"]},{"i":"c-61e8ad570e3e","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["清欢昨日。","十事不如人六七。","试数从前。","素素相从得几年。","子兮子兮。","再拣一枝何处起。","翠斧峰驼。","客好其如良夜何。"]},{"i":"c-411e9cad9c9a","t":"减字木兰花","a":"刘辰翁","d":"宋","g":"词","p":["脾神喜乐。","寿酒一杯胜服药。","过却明朝。","顶上新霜也合销。","小春三日。","便觉春暄梅影出。","醉把梅看。","比似茱萸更耐寒。"]},{"i":"c-31e63af69f6a","t":"山花子","a":"刘辰翁","d":"宋","g":"词","p":["东风解手即天涯。","曲曲青山不可遮。","如此苍茫君莫怪，是归家。","阊阖相迎悲最苦，英雄知道鬓先华。","更欲徘徊春尚肯，已无花。"]},{"i":"c-5624cbcb01b1","t":"山花子","a":"刘辰翁","d":"宋","g":"词","p":["此处情怀欲问天。","相期相就复何年。","行过章江三十里，泪依然。","早宿半程芳草路，犹寒欲雨暮春天。","小小桃花三两处，得人怜。"]},{"i":"c-2faf18014297","t":"柳梢青","a":"刘辰翁","d":"宋","g":"词","p":["铁马蒙毡，银花洒泪，春人愁城。","笛里番腔，街头戏鼓，不是歌声。","那堪独坐青灯。","想故国、高台月明。","辇下风光，山中岁月，海上心情。"]},{"i":"c-e70972b2d560","t":"南歌子","a":"刘辰翁","d":"宋","g":"词","p":["搔困麻仙爪，含暄忍客衣。","夜长窗月露成帏。","不说明朝风雨、自当归。"]},{"i":"c-3fd0e315c4d1","t":"南歌子","a":"刘辰翁","d":"宋","g":"词","p":["篘熟双投美，香飘一缕丝。","霜前雁到蟹螯持。","自试小窗醉墨、作新诗。"]},{"i":"c-0e80627d9ce1","t":"朝中措","a":"刘辰翁","d":"宋","g":"词","p":["炼花为露玉为瓶。","佳客为频倾。","耐得风霜满鬓，此身合是金茎。","墙头竹外，洞房初就，画阁新成。","嚼得梅花透骨，何愁不会长生。"]},{"i":"c-f453f8f36de8","t":"太常引","a":"刘辰翁","d":"宋","g":"词","p":["便晴也是不曾晴。","不怕金吾禁行。","风雨动乡情。","梦灯火、扬州化城。","少年跌宕，谁家娇小，绕带到天明。","昨夜月还生。","但惊破、霓裳数声。"]},{"i":"c-67d47c839ee9","t":"太常引","a":"刘辰翁","d":"宋","g":"词","p":["此公去暑似新秋。","吏毒一句句。","行县胜监州。","觉甘雨、随车应求。","鹭清为酒，螺清为寿，起舞祝君侯。","急召也须留。","廿四考、中书到头。"]},{"i":"c-92a617b00f1c","t":"玉楼春","a":"刘辰翁","d":"宋","g":"词","p":["霜风不动晴明好。","探梅有约城东道。","桥边失却老仙期，城门落日人归早。","野田一望迷芳草。","除是腾空君后到。","立马三周黛佛头，参差中路令人老。"]},{"i":"c-6fa66c2b458f","t":"玉楼春","a":"刘辰翁","d":"宋","g":"词","p":["龙山歌舞无人道。","只说先生狂落帽。","秋风亦是可怜人，要令天意知人老。","菊花不为重阳早。","自爱古人诗句恼。","与君郑重说□□，残年惟有重阳好。"]},{"i":"c-5049f175f86c","t":"乌夜啼","a":"刘辰翁","d":"宋","g":"词","p":["犹疑薰透帘栊。","是东风。","不分榴花更胜、一春红。","新雨过，绿连空。","蝶飞慵。","间过绿阴深院、小花浓。"]},{"i":"c-85e9518b0c02","t":"乌夜啼","a":"刘辰翁","d":"宋","g":"词","p":["素娥醉语曾留。","又中秋。","待得重圆谁妒、两悠悠。","向愁旱，今愁水，没中洲。","看取明朝晴去、不须愁。"]},{"i":"c-54a7b65c3aee","t":"乌夜啼","a":"刘辰翁","d":"宋","g":"词","p":["何年似永和年。","记湖船。","如此晴天无处、望新烟。","江南女，裙四尺，合秋千。","昨日老人曾见、久潸然。"]},{"i":"c-59fea2ebdbf2","t":"行香子","a":"刘辰翁","d":"宋","g":"词","p":["雪履无痕。","溪影传神。","著坡诗、请自清温。","朝朝不去，夕夕空勤。","似梦中云，云外雪，雪中春。","四野昏昏。","匹马巡巡。","拣一枝、寄与芳尊。","更谁兴到，於我情真。","是白家宾，江南路，陇头人。"]},{"i":"c-e779b06b4756","t":"行香子","a":"刘辰翁","d":"宋","g":"词","p":["玉立风尘。","光动黄银。","便谈文、也到夜分。","无人烛下，壁上传神。","记老婆心，寒士语，道人身。","极意形容，下语难亲。","更万分、无一分真。","醉翁去后，往往愁人。","顾滴山泉，衔丘冢，化龙云。"]},{"i":"c-52d1cd955202","t":"行香子","a":"刘辰翁","d":"宋","g":"词","p":["海水成尘。","河水无银。","恨幽明、我与公分。","青山独往，回首伤神。","叹魏阙心，磻石魄，汨罗身。","除却相思，四海无亲。","识风流、还贺季真。","而今天上，笑谪仙人。","但病伤春，愁厌雨，泪看云。"]},{"i":"c-511a57cbeedc","t":"行香子","a":"刘辰翁","d":"宋","g":"词","p":["月露吾痕。","雪得吾神。","更荒寒、不傍人温。","山人去后，车马来勤。","但梦朝云，愁暮雨，怨阳春。","说著东昏。","记著南巡。","泪盈盈、檀板金尊。","怜君素素，念我真真。","叹古来言，新样客，旧时人。"]},{"i":"c-2b49ef59ffd4","t":"品令","a":"刘辰翁","d":"宋","g":"词","p":["满庭芳草。","更昨日、落红如扫。","绿阴正似人怀抱。","一声睍睆，春色何曾老。","幸自不须人起早。","寂寞如相恼。","旧时闻处青门道。","禁烟时候，柳下人家好。"]},{"i":"c-3639432ee07b","t":"鹊桥仙","a":"刘辰翁","d":"宋","g":"词","p":["乘鸾著色，痴蝇误拂。","不及羲之醉墨。","偶然入手送东阳，便看取、薰时清适。","清风去暑，闲题当日。","宰相纱笼谁识。","封丘门外定何人，这一点、瞒他不得。"]},{"i":"c-3af316d68e32","t":"鹊桥仙","a":"刘辰翁","d":"宋","g":"词","p":["看人掷果，看人罢织。","难得团栾七夕。","蟠桃只在屋东头，庆西母、年开八ど。","去年今日。","今年今日。","添个曾孙抱膝。","人间乐事有多般，算此乐、人间第一。"]},{"i":"c-fc7ea4c2116a","t":"鹊桥仙","a":"刘辰翁","d":"宋","g":"词","p":["轻风澹月，年年去路。","谁识小年初度。","桥边曾弄碧莲花，悄不记、人间今古。","吹箫江上，沾衣微露。","依约凌波曾步。","寒机何意待人归，但寂历、小窗斜雨。"]},{"i":"c-d2d0e11e1bcd","t":"鹊桥仙","a":"刘辰翁","d":"宋","g":"词","p":["天香吹下，烟霏成路。","飒飒神光暗度。","桥边犹记泛槎人，看赤岸、苔痕如古。","长空皓月，小风斜露。","寂寞江头独步。","人间何处得飘然，归梦入、梨花春雨。"]},{"i":"c-b36f0dec7682","t":"一翦梅","a":"刘辰翁","d":"宋","g":"词","p":["万事如花不可期。","花不堪持。","酒不堪持。","江天雪意使人迷。","翦一枝枝。","歌一枝枝。","歌者不来今几时。","姜影无词。","张影无词。","不歌不醉不成诗。","歌也迟迟。","雪也迟迟。"]},{"i":"c-5575d24e2b1c","t":"一翦梅","a":"刘辰翁","d":"宋","g":"词","p":["人生总受业风吹。","三岁儿儿。","八十儿儿。","深闺空谷把还持。","啼看人知。","啼怕人知。","客中自种绿猗猗。","月下横枝。","雪下横枝。","尊前百岁且开眉。","今岁今时。","前岁今时。"]},{"i":"c-73f83214238e","t":"夜飞鹊・夜飞鹊慢","a":"刘辰翁","d":"宋","g":"词","p":["何曾见飞渡，年又年痴。","今古相望犹疑。","朱颜一去似流水，断桥魂梦参差。","何堪更嗟迟暮，听旁人说与，此夕佳期。","深深代籍，盼悠悠、北地胭脂。","谁寄扬州破镜，遍海角天涯，空待人归。","自小秦楼望巧，吴机回锦，歌舞为谁。","星萍耿耿，算欢娱，未省流离。","但秋衾梦浅，云闲曲远，薄命同时。"]},{"i":"c-41eaca99cf69","t":"疏影","a":"刘辰翁","d":"宋","g":"词","p":["香篝素被。","听花犯低低，瑶花开未。","长记那时，炽炭围炉，瘦妻换酒行试。","当家人在销金帐，约莫是、打围归际。","又谁知、别忆烹茶，冷落故家愁思。","闻道滕骄巽懒，今朝待檄与，翻云须易。","白白不成，又不教晴，做尽黄昏情味。","银河本是冰冰底。","怎忍向、东风成水。","待满城、玉宇琼楼，却报卧庐人起。"]},{"i":"c-0759ff744248","t":"摘红英","a":"刘辰翁","d":"宋","g":"词","p":["花朝月。","朦胧别。","朦胧也胜檐声咽。","亲曾说。","令人悦。","落花情绪，上坟时节。","花阴雪。","花阴灭。","柳风一似秋千掣。","晴未决。","晴还缺。","一番寒食，满村啼鴂。"]},{"i":"c-9b9eaeb52624","t":"千秋岁","a":"刘辰翁","d":"宋","g":"词","p":["新篘熟也，借问谁家早。","梅影里，蜂儿绕。","三更残月上，一夜霜天晓。","溪桥小，春风有意年年到。","当年青鸟去，落叶无人扫。","铜柱仄，瑶池老。","残钟长乐树，坠马咸阳道。","空回首，御街人卖南京枣。"]},{"i":"c-e828e291cd75","t":"促拍丑奴儿","a":"刘辰翁","d":"宋","g":"词","p":["送岁可无诗。","得团栾、忍不开眉。","不记去年今夕梦，江东怀抱，江西信息，舍北妻儿。","五十扊扅炊。","待五十、富贵成痴。","百年苦乐乘除看，今年一半，明年一半，更似儿时。"]},{"i":"c-7597033f5730","t":"促拍丑奴儿","a":"刘辰翁","d":"宋","g":"词","p":["世事莫寻思。","待说来、天也应悲。","百年已是中年后，西州垂泪，东山携手，几个斜晖。","也莫苦吟诗。","苦吟诗，待有谁知。","多□不是无才气，文时不遇，武时不遇，更说今时。"]},{"i":"c-920122b8897a","t":"最高楼","a":"刘辰翁","d":"宋","g":"词","p":["银河水，洗得世间清。","山色雨馀青。","老子纶巾棋别墅，人家鼾睡柝秋城。","定谁劳，定谁福，定谁能。","常恨著、景升儿不似。","又恨著、景升牛小耳。","空相望，愧平生。","我欲临风扶玉树，自攀承露酌金茎。","看昆明，鳞石长，海桑晴。"]},{"i":"c-82d7f02b9925","t":"最高楼","a":"刘辰翁","d":"宋","g":"词","p":["朱顶字，八十正平头。","添作八千秋。","无能也自收郿坞，到今恨不贬潮州。","看几人，炎又冷，老还羞。","也不学、太公忙把火。","也不学、申公轮转磨。","休莫莫，莫休休。","小迟授业何曾吃，更迟食乳不须愁。","且从容，某水钓，某丘游。"]},{"i":"c-f37812cef3db","t":"最高楼","a":"刘辰翁","d":"宋","g":"词","p":["非是雪，只是玉楼成。","屑不尽云英。","东边老树颓然折，西头稚柳爆然声。","试平安，松丈丈，竹兄兄。","有谁向、金船呼小玉，又谁怜、纸帐梦飞琼。","怪疏影，坠娉婷。","唤起老张寒蔌蔌，好歌白雪与君听。","但党家，人笑道，太粗生。"]},{"i":"c-0aa164d285d9","t":"最高楼","a":"刘辰翁","d":"宋","g":"词","p":["花上雪。","信手捻来成。","屑不就琼英。","昨朝已见诗成卷，今朝又试曲成声。","更催催，莫不做，水仙兄。","终须待、晴时携斗酒。","更须待、老夫吟数首。","休更叠，□娉婷。","已无翠鸟传花信，又无羯鼓与花听。","更催催，迟数日，是春生。"]},{"i":"c-66baed3603e2","t":"桂枝香","a":"刘辰翁","d":"宋","g":"词","p":["吹箫人去。","但桂影徘徊，荒杯承露。","东望鞭芙缥缈，寒光如注。","去年夜半横江梦，倚危樯，参差曾赋。","茫茫角动，回舟尽兴，未惊鸥鹭。","情知道、明年何处。","漫待客黄楼，尘波前度。","二十四桥，颇有杜书记否。","二三字者今如此，看使君、角巾东路。","人间俯仰，悲欢何限，团圆如故。"]},{"i":"c-7b58f2eb25f0","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["丞相衮衣朝戏彩，年年庆事如新。","尊前一笑共儿孙。","人间传寿酒，天上送麒麟。","缥缈祥烟连北阙，天颜有喜生春。","蓬莱清浅海光平。","今年初甲子，重试碧桃根。"]},{"i":"c-368f833c0ba8","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["闻道城东鹤会，欣然一笑乘风。","不知一鹤在墙东。","神仙人不识，未始出吾宗。","弟子有年於此，先生之道如龙。","碧桃花子落壶中。","化为三五粒，元是北边松。"]},{"i":"c-c9ba7fd567b6","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["天际何分南与北，五更纵又成横。","夜来拾得断河星。","化为一片石，持去问君平。","老大看天一笑，儿童问我须应。","向来牛女本无名。","要知天上事，亦似谤先生。"]},{"i":"c-735f3c32bd6c","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["二十年前此日，女兄庆我生儿。","簪萱弄彩听孙啼。","典衣沽美酒，数待冠昏时。","乱后飘零独在，紫荆墓棘风吹。","尊前万事莫寻思。","儿童看有子，白发故应衰。"]},{"i":"c-e54a33a3cf0c","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["旧日诗肠论斗酒，风流怀抱如倾。","几年不听渭城声。","尊前无贺老，卷里少弥明。","闻说语言都好，便应步履全轻。","长生第一是风僧。","额前书八十，能说又能行。"]},{"i":"c-5b352481f637","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["西曲罥衣迷去路，雪销断岸无痕。","寻花不拟到前村。","暖风初转袖，小径忽开门。","却忆临塘桥下马，暗香不是黄昏。","人生南北与谁论。","岭梅花树下，闲听蜜蜂喧。"]},{"i":"c-ee06eb7300fd","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["老去尚呼张丈，醉中自惜熊儿。","越王台上鹧鸪啼。","三朝臣不遇，无复好文时。","情绪幽幽似结，鬓丝索索禁吹。","病来魂不到相思。","散人腰已散，倚杖叹吾衰。"]},{"i":"c-49fec3e9e8b1","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["海日轻红通似脸，小窗明丽新晴。","满怀著甚是真情。","不知春睡美，为爱晓寒轻。","说似吴山楼万叠，雪销未尽宫城。","湖边柳色渐啼莺。","才听朝马动，一巷卖花声。"]},{"i":"c-d313411a3afd","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["过雁天边信息，两宫池上心情。","沉思海角愤难平。","山风欺客梦，耿耿到天明。","幸自不争名利，闲愁夜夜如惊。","明朝鬓白两三茎。","世人都不念，似汝复何成。"]},{"i":"c-74edd0cf08e7","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["睡过花阴一丈，愁深酒力千锺。","梦魂不得似游蜂。","瓶花无密约，到处自神通。","天上西湖似锦，人间骄马如龙。","今年不与去年同。","飘零终不恨，难与故人逢。"]},{"i":"c-0ce0a2f27909","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["幸自不须端帖子，闲中一句如无。","爱他午日午时书。","惟应三五字，便是辟兵符。","久雨石鲸未没，小风纨扇相疏。","邀朋一笑共菖蒲。","去年初禁酒，今日漫提壶。"]},{"i":"c-37598c85ae66","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["我去就他甚易，他来认我良难。","悟时到处是壶天。","古诗寻一句，危坐看香烟。","金玉满堂不守，菁华岁月空迁。","从今饱饭更安眠。","丹经都不看，闲坐一千年。"]},{"i":"c-34bbc7766ec2","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["旧日采莲羞半面，至今回首忽忽。","梦穿斜日水云红。","痴心犹独自，等待郑公风。","海上颓云潮不返，侧身空坠辽东。","人间天上几时同。","宫衣元不遇，无语醉醒中。"]},{"i":"c-7d3009d843c2","t":"临江仙","a":"刘辰翁","d":"宋","g":"词","p":["昔走都门终夜雨，明朝泥淖堪惊。","疏疏点点忽难鸣。","数峰青似染，快活早来晴。","十五年间春梦断，乱山寒食清明。","无人挑菜踏青行。","青鸠啼雨外，闲听寺中声。"]},{"i":"c-f5ab4b488833","t":"鹧鸪天","a":"刘辰翁","d":"宋","g":"词","p":["白白江南一信霜。","过都字不到衡阳。","老嘉破帽并吹却，未省西风似此狂。","攀北斗，酌天浆。","月香满似菊花黄。","神仙暗度龙山劫，鸡犬人间百战场。"]},{"i":"c-feaa70ac752a","t":"鹧鸪天","a":"刘辰翁","d":"宋","g":"词","p":["白发平津起褎然。","燕飞定远望生还。","世间最有团栾乐，又是平平过一年。","银信近，玉鞭先。","东来西去爵衔鳝。","人生有命迟迟好，且喜称觞寿母前。"]},{"i":"c-cfd072b4be09","t":"鹧鸪天","a":"刘辰翁","d":"宋","g":"词","p":["占得春风五日先。","至今住处是开元。","写真若遇丹元子，只著当时宫锦船。","松戴雪，自苍然。","八公花下少如前。","看来天上多辛苦，且住人间五百年。"]},{"i":"c-a7c76ddac177","t":"鹧鸪天","a":"刘辰翁","d":"宋","g":"词","p":["自入孤山分外香。","南枝不改旧时妆。","为曾盘里承青眼，一见溪头道胜常。","商山乐，又相羊。","上方不复记传觞。","橘中个个盘深窈，依倚东风局意长。"]},{"i":"c-74f323f3aac0","t":"鹧鸪天","a":"刘辰翁","d":"宋","g":"词","p":["去年太岁田间土，明日香烟壁下尘。","马上新人红又紫，眼前歌妓送还迎。","钗头燕，胜金紃。","燕歌赵舞动南人。","遗民植杖唐巾起，闲伴儿童看立春。"]},{"i":"c-525d41f35863","t":"鹧鸪天","a":"刘辰翁","d":"宋","g":"词","p":["旧日桃符管送迎。","灯毯爆竹斗先嬴。","鹿门乱走团栾久，才到城门有鼓声。","梅弄雪，柳窥晴。","残年犹自冷如冰。","欲知春色招人醉，须是元宵与踏青。"]},{"i":"c-0c29f5e11aa6","t":"鹧鸪天","a":"刘辰翁","d":"宋","g":"词","p":["暖逼酥枝渐渐融。","双飞谁识蝶雌雄。","歌声已逐行云去，花片偏来酒盏中。","眉月冷，画楼空。","酒阑犹未见情锺。","直须把烛穿花帐，方见佳人玉面红。"]},{"i":"c-23e44175dd6a","t":"青玉案","a":"刘辰翁","d":"宋","g":"词","p":["稠塘旧是花千树。","曾泛入、溪深误。","前度刘郎重唤渡。","漫山寂寂，年时花下，往往无寻处。","一年一度相思苦。","恨不抛人过江去。","及至来时春未暮。","兔葵燕麦，冷风斜雨，长恨稠塘路。"]},{"i":"c-b64e6f3dc679","t":"青玉案","a":"刘辰翁","d":"宋","g":"词","p":["雪销未尽残梅树。","又风送、黄昏雨。","长记小红楼畔路。","杵歌串串，鼓声叠叠，预赏元宵舞。","天涯客鬓愁成缕。","海上传柑梦中去。","今夜上元何处度。","乱山茅屋，寒炉败壁，渔火青荧处。"]},{"i":"c-e93eea218bf5","t":"青玉案","a":"刘辰翁","d":"宋","g":"词","p":["里中上大人谁大。","人上大、仁难作。","八十六翁闲处坐。","小生懒惰。","近来高卧。","忘却今朝贺。","甲申还是连珠麽。","胜有老人星一个。","白发朱颜堪婆娑。","灵光殿火。","昆明劫过。","角绮园黄我。"]}]