[{"i":"d6eb289e-bb50-431a-999a-18ba72044392","t":"秋燕","a":"司空圖","d":"唐","g":"短诗","p":["從撲香塵拂面飛，憐渠只爲解相依。","經冬好近深爐暖，何必千巖萬水歸。"]},{"i":"cfb19962-a9bc-4d38-98ea-ffbae58ac842","t":"見後鴈有感","a":"司空圖","d":"唐","g":"短诗","p":["笑爾窮通亦似人，高飛偶滯莫悲辛。","却緣風雪頻相阻，只向關中待得春。"]},{"i":"a3d738c0-0e82-4a31-b70a-2396690083a9","t":"移桃栽","a":"司空圖","d":"唐","g":"短诗","p":["獨臨官路易傷摧，從遣春風恣意開。","禪客笑移山上看，流鶯直到檻前來。"]},{"i":"3edf7c1e-4b19-417e-b178-25b711542bdb","t":"憶中條","a":"司空圖","d":"唐","g":"短诗","p":["燕辭旅舍人空在，螢出疎籬菊正芳。","堪恨昔年聯句地，念經僧掃過重陽。"]},{"i":"f75b4a85-1195-4795-bb42-4d7d52303414","t":"樂府","a":"司空圖","d":"唐","g":"短诗","p":["五更窗下簇妝臺，已怕堂前阿母催。","滿鴨香薰鸚鵡睡，隔簾燈照牡丹開。"]},{"i":"54df2b6a-ecb1-4a11-a567-0dfbc1370d40","t":"放龜二首 一","a":"司空圖","d":"唐","g":"短诗","p":["却爲多知自不靈，今朝教汝卜長生。","若求深處無深處，只有依人會有情。"]},{"i":"31b050df-3193-4236-ba0c-67c2d361dcd9","t":"放龜二首 二","a":"司空圖","d":"唐","g":"短诗","p":["世外猶迷不死庭，人間莫恃自無營。","本期滄海堪投跡，却向朱門待放生。"]},{"i":"a9e8098f-844e-4ffa-bb18-c83c83c4bb79","t":"燈花三首 一","a":"司空圖","d":"唐","g":"短诗","p":["蜀柳絲絲冪畫樓，窗塵滿鏡不梳頭。","幾時金鴈傳歸信，剪斷香魂一縷愁。"]},{"i":"a943e422-5bc0-451f-9b29-1e1ad75a9a12","t":"燈花三首 二","a":"司空圖","d":"唐","g":"短诗","p":["姊姊教人且抱兒，逐他女伴卸頭遲。","明朝鬬草多應喜，剪得燈花自掃眉。"]},{"i":"43a0aa0c-00d8-47e7-bcb5-38532790c332","t":"燈花三首 三","a":"司空圖","d":"唐","g":"短诗","p":["閏前小雪過經旬，猶自依依向主人。","開盡菊花憐強舞，與教弟子待新春。"]},{"i":"e27ba0b4-74a1-46d2-8684-23b3060e3a15","t":"偶題三首 一","a":"司空圖","d":"唐","g":"短诗","p":["浮世悠悠旋一空，多情偏解挫英雄。","風光只在歌聲裏，不必樓前萬樹紅。"]},{"i":"16c7220f-25ff-4ffa-af79-2474714bf7d9","t":"偶題三首 二","a":"司空圖","d":"唐","g":"短诗","p":["小池隨事有風荷，燒酹傾壺一曲歌。","欲待秋塘擎露看，自憐生意已無多。"]},{"i":"481ce1c7-296d-4125-b08c-f147b30e70f8","t":"偶題三首 三","a":"司空圖","d":"唐","g":"短诗","p":["遼陽音信近來稀，縱有虛傳逼節歸。","永日無人新睡覺，小窗晴暖螖蟲飛。"]},{"i":"8b2a898c-bb52-463e-8a8a-989eacb2ce54","t":"華下對菊","a":"司空圖","d":"唐","g":"短诗","p":["清香裛露對高齋，泛酒偏能浣旅懷。","不似春風逞紅豔，鏡前空墜玉人釵。"]},{"i":"99a4b6b4-2408-4827-ae5d-91a91e098389","t":"與都統參謀書有感","a":"司空圖","d":"唐","g":"短诗","p":["驚鸞迸鷺盡歸林，弱羽低垂分獨沈。","帶病深山猶草檄，昭陵應識老臣心。"]},{"i":"c875271f-d47b-4010-b4b4-d9b3f3b9c5f5","t":"漫題","a":"司空圖","d":"唐","g":"短诗","p":["無宦無名拘逸興，有歌有酒任他鄉。","看看萬里休征戍，莫向新詞寄斷腸。"]},{"i":"43e3ad85-c2f1-4ea3-bd10-52b921888b99","t":"商山二首 一","a":"司空圖","d":"唐","g":"短诗","p":["清溪一路照羸身，不似雲臺畫像人。","國史數行猶有志，只將談笑繼英塵。"]},{"i":"25326f18-48cc-4720-af69-b2aa233f1ac7","t":"商山二首 二","a":"司空圖","d":"唐","g":"短诗","p":["馬上搜奇已數篇，籍中猶愧是頑仙。","關頭傳說開元事，指點多疑孟浩然。"]},{"i":"ca92128a-9106-4005-b434-e67244e6f007","t":"與伏牛長老偈二首 一","a":"司空圖","d":"唐","g":"短诗","p":["不算菩提與闡提，惟應執著便生迷。","無端指箇清涼地，凍殺胡僧雪嶺西。"]},{"i":"7b7899bb-1a57-4288-964b-7bdeeda5ed36","t":"與伏牛長老偈二首 二","a":"司空圖","d":"唐","g":"短诗","p":["長繩不見繫空虛，半偈傳心亦未疎。","推倒我山無一事，莫將文字縛真如。"]},{"i":"dcdaacef-225a-4e18-be7b-6858ab7c563d","t":"客中重九","a":"司空圖","d":"唐","g":"短诗","p":["楚老相逢淚滿衣，片名薄宦已知非。","他鄉不似人間路，應共東流更不歸。"]},{"i":"67ffac96-3f1d-4458-9b34-ff8451c58b08","t":"柳二首 一","a":"司空圖","d":"唐","g":"短诗","p":["誰家按舞傍池塘，已見繁枝嫩眼黃。","漫說早梅先得意，不知春力暗分張。"]},{"i":"6ea4fbda-55b6-4644-bdfb-bb55ade4b775","t":"柳二首 二","a":"司空圖","d":"唐","g":"短诗","p":["似擬凌寒妬早梅，無端弄色傍高臺。","折來未有新枝長，莫遣佳人更折來。"]},{"i":"c703eead-d107-4bbd-a80e-ef5dc643249b","t":"光啓丁未別山","a":"司空圖","d":"唐","g":"短诗","p":["草堂琴畫已判燒，猶託鄰僧護燕巢。","此去不緣名利去，若逢逋客莫相嘲。"]},{"i":"cf2eff6a-4ba8-4cc5-bbd0-20db73deea71","t":"石楠","a":"司空圖","d":"唐","g":"短诗","p":["客處偷閑未是閑，石楠雖好懶頻攀。","如何風葉西歸路，吹斷寒雲見故山。"]},{"i":"8e404e90-20f9-41d9-8679-47823e26ae7c","t":"力疾馬上走筆","a":"司空圖","d":"唐","g":"短诗","p":["釀黍長添不盡杯，只憂花盡客空回。","垂楊且爲晴遮日，留遇重陽即放開。"]},{"i":"f2168941-acbf-4852-8bb5-500827b47458","t":"華陰縣樓","a":"司空圖","d":"唐","g":"短诗","p":["丹霄能有幾層梯，懶更揚鞭聳翠蜺。","偶凭危欄且南望，不勞高掌欲相攜。"]},{"i":"49bb7bf9-2594-4a85-a84e-f9cf96751952","t":"南至四首 一","a":"司空圖","d":"唐","g":"短诗","p":["今冬臘後無殘日，故國燒來有幾家。","却恨早梅添旅思，強偷春力報年華。"]},{"i":"bedbeff9-86b6-44f6-9c03-a1de472ca63e","t":"南至四首 二","a":"司空圖","d":"唐","g":"短诗","p":["花時不是偏愁我，好事應難總取他。","已被詩魔長役思，眼中莫厭早梅多。"]},{"i":"edfd3ec4-eaa3-4d89-b90e-6b023d1a4d7a","t":"南至四首 三","a":"司空圖","d":"唐","g":"短诗","p":["年華亂後偏堪惜，世路拋來已自生。","猶有玉真長命縷，樽前時唱緩羇情。"]},{"i":"c2896779-22ab-4794-b6a1-c7e8584a1e7a","t":"南至四首 四","a":"司空圖","d":"唐","g":"短诗","p":["一任喧闐遶四鄰，閑忙皆是自由身。","人來客去還須議，莫遣他人作主人。"]},{"i":"a528c2bf-ede7-4fe5-9b32-4e1ce6ae204f","t":"蓮峰前軒","a":"司空圖","d":"唐","g":"短诗","p":["人間上壽若能添，只向人間也不嫌。","看著四鄰花競發，高樓從此莫垂簾。"]},{"i":"c3831d44-dbc6-4ad8-87e2-d39388ddc2f2","t":"步虛","a":"司空圖","d":"唐","g":"短诗","p":["阿母親教學步虛，三元長遣下蓬壺。","雲韶韻俗停瑤瑟，鸞鶴飛低拂寶爐。"]},{"i":"5f93b1bc-5812-499c-a335-d1d21f21ee76","t":"劒器","a":"司空圖","d":"唐","g":"短诗","p":["樓下公孫昔擅場，空教女子愛軍裝。","潼關一敗吳兒喜，簇馬驪山看御湯。"]},{"i":"14dc4dda-013d-450d-89a9-274d48be6d06","t":"乙丑人日","a":"司空圖","d":"唐","g":"短诗","p":["自怪扶持七十身，歸來又見故鄉春。","今朝人日逢人喜，不料偷生作老人。"]},{"i":"8ddc9c94-c95c-47fb-b52f-6b9a2ee94b25","t":"攜仙籙九首 一","a":"司空圖","d":"唐","g":"短诗","p":["嶽北秋空渭北川，晴雲漸薄薄如煙。","坐來還見微風起，吹散殘陽一片蟬。"]},{"i":"5ffd8c76-a8f3-481f-8282-0af4b34af10a","t":"攜仙籙九首 二","a":"司空圖","d":"唐","g":"短诗","p":["一半晴空一半雲，遠籠仙掌日初曛。","洞天有路不知處，絕頂異香難更聞。"]},{"i":"1212ae62-bd88-49c2-b180-3aadadbb7ea6","t":"攜仙籙九首 三","a":"司空圖","d":"唐","g":"短诗","p":["決事還須更事酬，清譚妙理一時休。","漁翁亦被機心誤，眼暗汀邊結釣鉤。"]},{"i":"5fb5eddd-72e5-4568-817b-f1d147bd5b95","t":"攜仙籙九首 四","a":"司空圖","d":"唐","g":"短诗","p":["迹不趨時分不侯，功名身外最悠悠。","聽君總畫麒麟閣，還我閑眠舴艋舟。"]},{"i":"b760d250-680a-4cee-9c94-b5b3be2045aa","t":"攜仙籙九首 五","a":"司空圖","d":"唐","g":"短诗","p":["仙凡路阻兩難留，煙樹人間一片秋。","若道陰功能濟活，且將方寸自焚修。"]},{"i":"31e4b7cc-0c92-475c-bc45-eef841195088","t":"攜仙籙九首 六","a":"司空圖","d":"唐","g":"短诗","p":["若有陰功救未然，玉皇品籍亦搜賢。","應知譚笑還高謝，別就滄洲贊上仙。"]},{"i":"b1002cb9-95e8-4407-af27-605ce4cc42ca","t":"攜仙籙九首 七","a":"司空圖","d":"唐","g":"短诗","p":["英名何用苦搜奇，不朽才銷一句詩。","却賴風波阻三島，老臣猶得戀明時。"]},{"i":"21a2d8ee-081e-4e5d-a6bd-fc816d1fc598","t":"攜仙籙九首 八","a":"司空圖","d":"唐","g":"短诗","p":["剪取紅雲剩寫詩，年年高會趂花時。","水精樓閣分明見，只欠霞漿別着旗。"]},{"i":"dc4f2355-6494-4a20-9294-d00f856064a2","t":"攜仙籙九首 九","a":"司空圖","d":"唐","g":"短诗","p":["此生得作太平人，只向塵中便出塵。","移取碧桃花萬樹，年年自樂故鄉春。"]},{"i":"958de4ab-6af8-4f35-9242-286f7fdeda4a","t":"浪淘沙","a":"司空圖","d":"唐","g":"短诗","p":["不必長漂玉洞花，曲中偏愛浪淘沙。","黃河却勝天河水，萬里縈紆入漢家。"]},{"i":"1fae27a5-d0fc-40ef-83b2-c93f921d8c99","t":"贈日東鑒禪師","a":"司空圖","d":"唐","g":"短诗","p":["故國無心度海潮，老禪方丈倚中條。","夜深雨絕松堂靜，一點飛螢照寂寥。"]},{"i":"2704fd10-b4df-4513-933b-f9b3098cd33a","t":"暮春對柳二首 一","a":"司空圖","d":"唐","g":"短诗","p":["縈愁惹恨奈楊花，閉戶垂簾亦滿家。","惱得閑人作酒病，剛須又撲越溪茶。"]},{"i":"a62909bd-51e3-4666-a2a4-d5185a50f331","t":"暮春對柳二首 二","a":"司空圖","d":"唐","g":"短诗","p":["洞中猶說看桃花，輕絮狂飛自俗家。","正是階前開遠信，小娥旋拂碾新茶。"]},{"i":"361bc5af-cc1c-47d5-a5ba-1f66e2e69dc2","t":"戊午三月晦二首 一","a":"司空圖","d":"唐","g":"短诗","p":["隨風逐浪劇蓬萍，圓首何曾解最靈。","筆硯近來多自棄，不關妖氣暗文星。"]},{"i":"da82f6b2-0628-4572-b66d-dbc5c16a8185","t":"戊午三月晦二首 二","a":"司空圖","d":"唐","g":"短诗","p":["牛誇棋品無勍敵，謝占詩家作上流。","豈似小敷春水漲，年年鸞鶴待仙舟。"]},{"i":"2c0d7433-4a8a-4602-954f-04287b3ec27f","t":"偶書五首 一","a":"司空圖","d":"唐","g":"短诗","p":["情知了得未如僧，客處高樓莫強登。","鶯也解啼花也發，不關心事最堪憎。"]},{"i":"e619df05-df8e-4ff2-a5bf-26e7c6e5c9f3","t":"偶書五首 二","a":"司空圖","d":"唐","g":"短诗","p":["自有池荷作扇搖，不關風動愛芭蕉。","只憐直上抽紅蘂，似我丹心向本朝。"]},{"i":"e399cb40-2190-4b8c-ae1a-20940e59d16f","t":"偶書五首 三","a":"司空圖","d":"唐","g":"短诗","p":["曾看輕舟渡遠津，無風著岸不經旬。","只緣命蹇須知命，却是人爭阻得人。"]},{"i":"0e7ddeba-3e22-440f-b112-38b84cb3fd57","t":"偶書五首 四","a":"司空圖","d":"唐","g":"短诗","p":["上谷何曾解有情，有情人自惜君行。","證因池上今生願，的的他生作化生。"]},{"i":"52f104ba-5eab-4fb7-bae2-b830f50bc7a4","t":"偶書五首 五","a":"司空圖","d":"唐","g":"短诗","p":["新店南原後夜程，黃河風浪信難平。","渡頭楊柳知人意，爲惹官船莫放行。"]},{"i":"974d5acc-2ebd-487b-a20b-927e9c962f00","t":"喜山鵲初歸三首 一","a":"司空圖","d":"唐","g":"短诗","p":["翠衿紅觜便知機，久避重羅穩處飛。","只爲從來偏護惜，窗前今賀主人歸。"]},{"i":"498ed5e4-b26a-469b-a51e-4d474fc1252e","t":"喜山鵲初歸三首 二","a":"司空圖","d":"唐","g":"短诗","p":["山中只是惜珍禽，語不分明識爾心。","若使解言天下事，燕臺今築幾千金。"]},{"i":"6b84bfbf-dee5-4fa6-83ae-ef185aa0577e","t":"喜山鵲初歸三首 三","a":"司空圖","d":"唐","g":"短诗","p":["阻他羅網到柴扉，不奈偷倉雀轉肥。","賴爾林塘添景趣，剩留山果引教歸。"]},{"i":"fbc4987b-3cac-48cf-98a0-373f32939e9b","t":"虞鄉北原","a":"司空圖","d":"唐","g":"短诗","p":["澤北邨貧煙火獰，稚田冬旱倩牛耕。","老人惆悵逢人訴，開盡黃花麥未金。"]},{"i":"1f68c9f6-23cf-41e2-9d60-db076b223392","t":"洛中三首 一","a":"司空圖","d":"唐","g":"短诗","p":["秋風團扇未驚心，笑看妝臺落葉侵。","繡鳯不教金縷暗，青樓何處有寒砧。"]},{"i":"7f7f2b10-12cc-4f06-8a4b-913b8f4dd3ac","t":"洛中三首 二","a":"司空圖","d":"唐","g":"短诗","p":["不用頻嗟世路難，浮生各自繫悲懽。","風霜一夜添羇思，羅綺誰家待早寒。"]},{"i":"c388ab65-833b-4b5d-9d4c-69a9dba6ab0e","t":"洛中三首 三","a":"司空圖","d":"唐","g":"短诗","p":["燕巢空後誰相伴，鴛被縫來不忍薰。","薄命敢辭長滴淚，倡家未必肯留君。"]},{"i":"3713db20-ade8-4870-a3b0-a4dcc2eb0b45","t":"寓筆","a":"司空圖","d":"唐","g":"短诗","p":["年年鑷鬢到花飄，依舊花繁鬢易凋。","撩亂一塲人更恨，春風誰道勝輕飆。"]},{"i":"3590d458-2afb-4d5e-95f6-12d45efa7399","t":"戲題試衫","a":"司空圖","d":"唐","g":"短诗","p":["朝班盡說人宜紫，洞府應無鶴着緋。","從此玉皇須破例，染霞裁賜地仙衣。"]},{"i":"1c4a014d-a068-49c3-afc9-2efafdc27aa6","t":"汴柳半枯因悲柳中隱","a":"司空圖","d":"唐","g":"短诗","p":["行人莫歎前朝樹，已占河堤幾百春。","惆悵題詩柳中隱，柳衰猶在自無身。"]},{"i":"75ddcd58-c79c-4b3a-9ca4-7e84c1cfc267","t":"上方","a":"司空圖","d":"唐","g":"短诗","p":["花落更同悲木落，鶯聲相續即蟬聲。","榮枯了得無多事，只是閑人漫繫情。"]},{"i":"0092ded3-c8f1-48bd-a28e-4d1c40081910","t":"寄王贊學","a":"司空圖","d":"唐","g":"短诗","p":["黃卷不關兼濟業，青山自保老閑身。","一行萬里纖塵靜，可要張儀更入秦。"]},{"i":"237c217b-edba-4bce-964c-d48c994b2188","t":"新節","a":"司空圖","d":"唐","g":"短诗","p":["轉悲新歲重於山，不似輕鷗肯復還。","朱紱縱教金印換，青雲未勝白頭閑。"]},{"i":"61cd8313-81aa-4d92-813d-06250a628bff","t":"自河西歸山二首 一","a":"司空圖","d":"唐","g":"短诗","p":["一水悠悠一葉危，往來長恨阻歸期。","鄉關不是無華表，自爲多驚獨上遲。"]},{"i":"819bc650-9daf-4dbb-9950-dafd26e7f2f1","t":"自河西歸山二首 二","a":"司空圖","d":"唐","g":"短诗","p":["水闊風驚去路危，孤舟欲上更遲遲。","鶴羣長擾三珠樹，不借人間一隻騎。"]},{"i":"81d1fa49-b5db-494a-bfd5-8ad54f431464","t":"王官二首 一","a":"司空圖","d":"唐","g":"短诗","p":["風荷似醉和花舞，沙鳥無情伴客閑。","總是此中皆有恨，更堪微雨半遮山。"]},{"i":"f4ca2498-6dca-448f-ac44-a6972689d266","t":"王官二首 二","a":"司空圖","d":"唐","g":"短诗","p":["荷塘煙罩小齋虛，景物皆宜入畫圖。","盡日無人只高臥，一雙白鳥隔紗廚。"]},{"i":"e9520446-4980-44ee-904f-4a5425f355a2","t":"賀翰林侍郎二首 一","a":"司空圖","d":"唐","g":"短诗","p":["太白東歸鶴背吟，鏡湖空在酒船沈。","今朝忽見銀臺事，早晚重徵入翰林。"]},{"i":"124914f9-eabf-4d4c-8723-e771ac1478bc","t":"賀翰林侍郎二首 二","a":"司空圖","d":"唐","g":"短诗","p":["玉版徵書洞裏看，沈羲新拜侍郎官。","文星喜氣連台曜，聖主方知四海安。"]},{"i":"0403ebdb-e3c8-43bf-95f6-45a48d85bc4a","t":"寄王十四舍人","a":"司空圖","d":"唐","g":"短诗","p":["幾年汶上約同遊，擬爲蓮峰別置樓。","今日鳳皇池畔客，五千仞雪不回頭。"]},{"i":"88dd221c-b53c-4d3b-8414-61edbaa93ab8","t":"綸閣有感","a":"司空圖","d":"唐","g":"短诗","p":["風濤曾阻化鱗來，誰料蓬瀛路却開。","欲去遲遲還自笑，狂才應不是仙才。"]},{"i":"a3c2f0e7-0940-4496-a686-ef586df5e2ad","t":"狂題十八首 一","a":"司空圖","d":"唐","g":"短诗","p":["莫恨艱危日日多，時情其奈倖門何。","貔貅睡穩蛟龍渴，猶把燒殘朽鐵磨。"]},{"i":"3e76ffa2-243e-40dc-a0ea-e174f97aa97e","t":"狂題十八首 二","a":"司空圖","d":"唐","g":"短诗","p":["別鶴淒涼指法存，戴逵能耻近王門。","世間第一風流事，借得王公玉枕痕。"]},{"i":"327c574e-005d-4b9e-94cd-9411f8e8b68a","t":"狂題十八首 三","a":"司空圖","d":"唐","g":"短诗","p":["交疎自古戒言深，肝膽徒傾致鑠金。","不是史遷書與說，誰知孤負李陵心。"]},{"i":"91bac00e-9fb4-470a-90f9-285f027ec696","t":"狂題十八首 四","a":"司空圖","d":"唐","g":"短诗","p":["南華落筆似荒唐，若肯經綸亦不狂。","偶作客星侵帝座，却應虛薄是嚴光。"]},{"i":"26d4e897-048c-486a-8c31-b259aa3a3e72","t":"狂題十八首 五","a":"司空圖","d":"唐","g":"短诗","p":["不勞世路更相猜，忍到須休惜得材。","幾度懶乘風水便，抝船折舵恐難回。"]},{"i":"93e45c6f-f636-4235-a942-1bbd7c6cc264","t":"狂題十八首 六","a":"司空圖","d":"唐","g":"短诗","p":["由來相愛只詩僧，怪石長松自得朋。","却怕他生還識字，依前日下作孤燈。"]},{"i":"b794d29b-4f8e-4a4b-847c-4371fdf15c04","t":"狂題十八首 七","a":"司空圖","d":"唐","g":"短诗","p":["老禪乘仗莫過身，遠岫孤雲見亦頻。","應是佛邊猶怕鬧，信緣須作且閑人。"]},{"i":"6e1088f8-ad3f-4949-abb2-5ef9d7cca51e","t":"狂題十八首 八","a":"司空圖","d":"唐","g":"短诗","p":["止竟閑人不愛閑，只偷無事閉柴關。","轟霆攪破蛟龍窟，也被狂風卷出山。"]},{"i":"6402c50c-a59c-4c76-aefb-f14e9be09d6b","t":"狂題十八首 九","a":"司空圖","d":"唐","g":"短诗","p":["地下修文著作郎，生前飢處倒空墻。","何如神爽騎星去，猶自研幾助玉皇。"]},{"i":"29ef590f-4cfe-43b9-b7af-301961889799","t":"狂題十八首 十","a":"司空圖","d":"唐","g":"短诗","p":["雨洗芭蕉葉上詩，獨來憑檻晚晴時。","故園雖恨風荷膩，新句閑題亦滿池。"]},{"i":"8efe24b3-cd66-4fd4-8925-832d6547bf14","t":"狂題十八首 十一","a":"司空圖","d":"唐","g":"短诗","p":["初時拄杖向鄰村，漸到清明亦杜門。","三十年來辭病表，今朝臥病感皇恩。"]},{"i":"71dac7b3-b68c-42fb-8304-72647303dfe2","t":"狂題十八首 十二","a":"司空圖","d":"唐","g":"短诗","p":["來時雖恨失青氊，自見芭蕉幾十篇。","應是阿劉還宿債，剩拚才思折供錢。"]},{"i":"679071df-6555-4827-ad61-c1942fea2fc5","t":"狂題十八首 十三","a":"司空圖","d":"唐","g":"短诗","p":["芭蕉叢畔碧嬋娟，免更悠悠擾蜀川。","應到去時題不盡，不勞分寄校書牋。"]},{"i":"5b3bf849-ab1b-42c6-8874-96a096965024","t":"狂題十八首 十四","a":"司空圖","d":"唐","g":"短诗","p":["自傷衰病漸難平，永夜禪牀雨滴聲。","聞道虎瘡仍帶鏃，吼來和痛亦橫行。"]},{"i":"2926ddf8-9d99-4c0a-87c9-56db60e5cb75","t":"狂題十八首 十五","a":"司空圖","d":"唐","g":"短诗","p":["昨日流鶯今日蟬，起來又是夕陽天。","六龍飛轡長相窘，更忍乘危自着鞭。"]},{"i":"8e14e835-02de-42ae-8626-2d1a0bdd7d41","t":"狂題十八首 十六","a":"司空圖","d":"唐","g":"短诗","p":["有是有非還有慮，無心無跡亦無猜。","不平便激風波險，莫向安時稔禍胎。"]},{"i":"26a72b9d-81cf-4a87-8b09-8f6ce0d2146b","t":"狂題十八首 十七","a":"司空圖","d":"唐","g":"短诗","p":["十年三署讓官頻，認得無才又索身。","莫道太行同一路，大都安穩屬閑人。"]},{"i":"57a61020-f4a2-4f4c-8b8d-0143d22c94da","t":"狂題十八首 十八","a":"司空圖","d":"唐","g":"短诗","p":["曾聞劫火到蓬壺，縮盡鼇頭海亦枯。","今日家山同此恨，人歸未得鶴歸無。"]},{"i":"75af1049-35a3-42ae-bffd-90089bf3ef27","t":"遊仙二首 一","a":"司空圖","d":"唐","g":"短诗","p":["蛾眉新畫覺嬋娟，鬬走將花阿母邊。","仙曲教成慵不理，玉階相簇打金錢。"]},{"i":"4e36541b-bb38-416a-8d20-8cf76dbad6e5","t":"遊仙二首 二","a":"司空圖","d":"唐","g":"短诗","p":["劉郎相約事難諧，雨散雲飛自此乖。","月姊殷勤留不住，碧空遺下水精釵。"]},{"i":"266f1bd0-a44c-4bbf-b64d-d626e5ebe52e","t":"漫書五首 一","a":"司空圖","d":"唐","g":"短诗","p":["長擬求閑未得閑，又勞行役出秦關。","逢人漸覺鄉音異，却恨鶯聲似故山。"]},{"i":"f6e45696-6548-47cf-8324-83cda0fa7de0","t":"漫書五首 二","a":"司空圖","d":"唐","g":"短诗","p":["溪邊隨事有桑麻，盡日山程十數家。","莫怪行人頻悵望，杜鵑不是故鄉花。"]},{"i":"ab3be046-ac42-425a-8e9f-def1a53542b3","t":"漫書五首 三","a":"司空圖","d":"唐","g":"短诗","p":["海上昔聞麋愛鶴，山中今日鹿憎龜。","愛憎止竟須關分，莫把微才望所知。"]},{"i":"4446a7e3-637f-4903-8e8a-ea3b5dfc335c","t":"漫書五首 四","a":"司空圖","d":"唐","g":"短诗","p":["世路快心無好事，恩門嘉話合書紳。","神藏鬼伏能千變，亦勝忘機避要津。"]}]