[{"i":"c-fd2feec43250","t":"清平乐","a":"欧阳修","d":"宋","g":"词","p":["小庭春老。","碧砌红萱草。","长忆小阑闲共绕。","携手绿丛含笑。","别来音信全乖。","旧期前事堪猜。","门掩日斜人静，落花愁点青苔。"],"s":"simp","f":"trad"},{"i":"c-21402ea2c16d","t":"凉州令・梁州令","a":"欧阳修","d":"宋","g":"词","p":["翠树芳条飐。","的的裙腰初染。","佳人携手弄芳菲，绿阴红影，共展双纹簟。","插花照影窥鸾鉴。","只恐芳容减。","不堪零落春晚，青苔雨后深红点。","一去门闲掩。","重来却寻朱槛。","离离秋实弄轻霜，娇红脉脉，似见胭脂脸。","人非事往眉空敛。","谁把佳期赚。","芳心只愿长依旧，春风更放明年艳。"],"s":"simp","f":"trad"},{"i":"c-bdfb2a978b9e","t":"南乡子","a":"欧阳修","d":"宋","g":"词","p":["翠密红繁。","水国凉生未是寒。","雨打荷花珠不定，轻翻。","冷泼鸳鸯锦翅斑。","尽日凭阑。","弄蕊拈花仔细看。","偷得袅蹄新铸样，无端。","藏在红房艳粉间。"],"s":"simp","f":"trad"},{"i":"c-e468b9e53abc","t":"南乡子","a":"欧阳修","d":"宋","g":"词","p":["雨后斜阳。","细细风来细细香。","风定波平花映水，休藏。","照出轻盈半面妆。","路隔秋江。","莲子深深隐翠房。","意在莲心无问处，难忘。","泪裛红腮不记行。"],"s":"simp","f":"trad"},{"i":"c-398453ddae6c","t":"鹊桥仙","a":"欧阳修","d":"宋","g":"词","p":["月波清霁，烟容明淡，灵汉旧期还至。","鹊迎桥路接天津，映夹岸、星榆点缀。","云屏未卷，仙鸡催晓，肠断去年情味。","多应天意不教长，恁恐把、欢娱容易。"],"s":"simp","f":"trad"},{"i":"c-55ad2a7b3e7f","t":"圣无忧・乌夜啼","a":"欧阳修","d":"宋","g":"词","p":["珠帘卷，暮云愁。","垂杨暗锁青楼。","烟雨濛濛如画，轻风吹旋收。","香断锦屏新别，人闲玉簟初秋。","多少旧欢新恨，书杳杳、梦悠悠。"],"s":"mixed","f":"trad"},{"i":"c-3160a39f6f3c","t":"摸鱼儿","a":"欧阳修","d":"宋","g":"词","p":["卷绣帘、梧桐秋院落，一霎雨添新绿。","对小池闲立残妆浅，向晚水纹如縠。","凝远目。","恨人去寂寂，凤枕孤难宿。","倚阑不足。","看燕拂风檐，蝶翻露草，两两长相逐。","双眉促。","可惜年华婉娩，西风初弄庭菊。","况伊家年少，多情未已难拘束。","那堪更趁凉景，追寻甚处垂杨曲。","佳期过尽，但不说归来，多应忘了，云屏去时祝。"],"s":"simp","f":"trad"},{"i":"c-bf7c92d99198","t":"少年游","a":"欧阳修","d":"宋","g":"词","p":["去年秋晚此园中。","携手玩芳丛。","拈花嗅蕊，恼烟撩雾，拼醉倚西风。","今年重对芳丛处，追往事、又成空。","敲遍阑干，向人无语，惆怅满枝红。"],"s":"simp","f":"trad"},{"i":"c-1809ebac72c0","t":"少年游","a":"欧阳修","d":"宋","g":"词","p":["肉红圆样浅心黄。","枝上巧如装。","雨轻烟重，无憀天气，啼破晓来妆。","寒轻贴体风头冷，忍抛弃、向秋光。","不会深心，为谁惆怅，回面恨斜阳。"],"s":"simp","f":"trad"},{"i":"c-587af6a48c5a","t":"少年游","a":"欧阳修","d":"宋","g":"词","p":["玉壶冰莹兽炉灰。","人起绣帘开。","春从一夜，六花开尽，不待剪刀催。","洛阳城阙中天起，高下遍楼台。","絮乱风轻，拂鞍沾袖，归路似章街。"],"s":"simp","f":"trad"},{"i":"c-b551f0f6d1ab","t":"鹧鸪天","a":"欧阳修","d":"宋","g":"词","p":["学画宫眉细细长。","芙蓉出水斗新妆。","只知一笑能倾国，不信相看有断肠。","双黄鹄，两鸳鸯。","迢迢云水恨难忘。","早知今日长相忆，不及从初莫作双。"],"s":"simp","f":"trad"},{"i":"c-d3857943e18c","t":"千秋岁","a":"欧阳修","d":"宋","g":"词","p":["罗衫满袖，尽是忆伊泪。","残妆粉，馀香被。","手把金尊酒，未饮先如醉。","但向道，厌厌成病皆因你。","离思迢迢远，一似长江水。","去不断，来无际。","红笺著意写，不尽相思意。","为个甚，相思只在心儿里。"],"s":"simp","f":"trad"},{"i":"c-cab1f90d7cd0","t":"千秋岁","a":"欧阳修","d":"宋","g":"词","p":["画堂人静，翡翠帘前月。","鸾帷凤枕虚铺设。","风流难管束，一去音书歇。","到而今，高梧冷落西风切。","未语先垂泪，滴尽相思血。","魂欲断，情难绝。","都来些子事，更与何人说。","为个甚，心头见底多离别。"],"s":"simp","f":"trad"},{"i":"c-5653ba4240e3","t":"醉蓬莱","a":"欧阳修","d":"宋","g":"词","p":["见羞容敛翠，嫩脸匀红，素腰袅娜。","红药阑边，恼不教伊过。","半掩娇羞，语声低颤，问道有人知麽。","强整罗裙，偷回波眼，佯行佯坐。","更问假如，事还成后，乱了云鬟，被娘猜破。","我且归家，你而今休呵。","更为娘行，有些针线，诮未曾收囉。","却待更阑，庭花影下，重来则个。"],"s":"mixed","f":"trad"},{"i":"c-0ea3d4360584","t":"于飞乐","a":"欧阳修","d":"宋","g":"词","p":["宝奁开，美鉴静，一掬清蟾。","新妆脸，旋学花添。","蜀红衫，双绣蝶、裙缕鹣鹣。","寻思前事，小屏风、仍画江南。","怎空教、草解宜男。","柔桑密、又过春蚕。","正阴晴天气，更暝色相兼。","佳期消息，曲房西、碎月筛帘。"],"s":"simp","f":"trad"},{"i":"c-6abfb4eec035","t":"鼓笛慢・水龙吟","a":"欧阳修","d":"宋","g":"词","p":["缕金裙窣轻纱，透红莹玉真堪爱。","多情更把，眼儿斜盼，眉儿敛黛。","舞态歌阑，困偎香脸，酒红微带。","便直饶、更有丹青妙手，应难写、天然态。","长恐有时不见，每饶伊、百般娇呆。","眼穿肠断，如今千种，思量无奈。","花谢春归，梦回云散，欲寻难再。","暗消魂，但觉鸳衾凤枕，有馀香在。"],"s":"simp","f":"trad"},{"i":"c-36eea165d485","t":"看花回","a":"欧阳修","d":"宋","g":"词","p":["晓色初透东窗，醉魂方觉。","恋恋绣衾半拥，动万感脉脉，春思无托。","追想少年，何处青楼贪欢乐。","当媚景，恨月愁花，算伊全妄凤帏约。","空泪滴、真珠暗落。","又被谁、连宵留著。","不晓高天甚意，既付与风流，却恁情薄。","细把身心自解，只与猛拼却。","又及至、见来了，怎生教人恶。"],"s":"simp","f":"trad"},{"i":"c-5f59b733a3c5","t":"蝶恋花","a":"欧阳修","d":"宋","g":"词","p":["几度兰房听禁漏。","臂上残妆，印得香盈袖。","酒力融融香汗透。","春娇入眼横波溜。","不见些时眉已皱。","水阔山遥，乍向分飞后。","大抵有情须感旧。","肌肤拼为伊销瘦。"],"s":"simp","f":"trad"},{"i":"c-0d377c2d8d1c","t":"蝶恋花","a":"欧阳修","d":"宋","g":"词","p":["宝琢珊瑚山样瘦。","缓髻轻拢，一朵云生袖。","昨夜佳人初命偶。","论情旋旋移相就。","几叠鸳衾红浪皱。","暗觉金钗，磔磔声相扣。","一自楚台人梦后。","凄凉暮雨沾裀绣。"],"s":"simp","f":"trad"},{"i":"c-ab2a7e766447","t":"蝶恋花","a":"欧阳修","d":"宋","g":"词","p":["一掬天和金粉腻。","莲子心中，自有深深意。","意密莲深秋正媚。","将花寄恨无人会。","桥上少年桥下水。","小棹归时，不语牵红袂。","浪溅荷心圆又碎。","无端欲伴相思泪。"],"s":"simp","f":"trad"},{"i":"c-202a2849029d","t":"蝶恋花","a":"欧阳修","d":"宋","g":"词","p":["百种相思千种恨。","早是伤春，那更春醪困。","薄幸辜人终不愤。","何时枕畔分明问。","懊恼风流心一寸。","强醉偷眠，也即依前闷。","此意为君君不信。","泪珠滴尽愁难尽。"],"s":"simp","f":"trad"},{"i":"c-128542ebda7d","t":"武陵春","a":"欧阳修","d":"宋","g":"词","p":["宝幄华灯相见夜，妆脸小桃红。","斗帐香檀翡翠笼。","携手恨匆匆。","金泥双结同心带，留与记情浓。","却望行云十二峰。","肠断月斜锺。"],"s":"simp","f":"trad"},{"i":"c-edbaa58f0e96","t":"梁州令","a":"欧阳修","d":"宋","g":"词","p":["红杏墙头树。","紫萼香心初吐。","新年花发旧时枝，徘徊千绕，独共东风语。","阳台一梦如云雨。","为问今何处。","离情别恨多少，条条结向垂杨缕。","此事难分付。","初心本谁先许。","窃香解佩两沈沈，知他而今，记得当初否。","谁教薄幸轻相误。","不信道、相思苦。","如今却恁空追悔，元来也会忆人去。"],"s":"simp","f":"trad"},{"i":"c-a61dbb3f7ecc","t":"渔家傲","a":"欧阳修","d":"宋","g":"词","p":["为爱莲房都一柄。","双苞双蕊双红影。","雨势断来风色定。","秋水静。","仙郎彩女临鸾镜。","妾有容华君不省。","花无恩爱犹相并。","花却有情人薄幸。","心耿耿。","因花又染相思病。"],"s":"simp","f":"trad"},{"i":"c-8939a8fac192","t":"渔家傲","a":"欧阳修","d":"宋","g":"词","p":["昨日采花花欲尽。","隔花闻道潮来近。","风猎紫荷声又紧。","低难奔。","莲茎刺惹香腮损。","一缕艳痕红隐隐。","新霞点破秋蟾晕。","罗袖挹残心不稳。","羞人问。","归来剩把胭脂衬。"],"s":"simp","f":"trad"},{"i":"c-ef8b117ccf4f","t":"渔家傲","a":"欧阳修","d":"宋","g":"词","p":["一夜越溪秋水满。","荷花开过溪南岸。","贪采嫩香星眼慢。","疏回眄。","郎船不觉来身畔。","罢采金英收玉腕。","回身急打船头转。","荷叶又浓波又浅。","无方便。","教人只得抬娇面。"],"s":"simp","f":"trad"},{"i":"c-3584f2de4e3e","t":"渔家傲","a":"欧阳修","d":"宋","g":"词","p":["近日门前溪水涨。","郎船几度偷相访。","船小难开红斗帐。","无计向。","合欢影里空惆怅。","愿妾身为红菡萏。","年年生在秋江上。","重愿郎为花底浪。","无隔障。","随风逐雨长来往。"],"s":"simp","f":"trad"},{"i":"c-69b2c8237e80","t":"渔家傲","a":"欧阳修","d":"宋","g":"词","p":["妾解清歌并巧笑。","郎多才俊兼年少。","何事抛儿行远道。","无音耗。","江头又绿王孙草。","昔日采花呈窈窕。","玉容长笑花枝老。","今日采花添懊恼。","伤怀抱。","玉容不及花枝好。"],"s":"simp","f":"trad"},{"i":"c-24a8e2de0f82","t":"一斛珠","a":"欧阳修","d":"宋","g":"词","p":["今朝祖宴。","可怜明夜孤灯馆。","酒醒明月空床满。","翠被重重，不似香肌暖。","愁肠恰似沈香篆。","千回万转萦还断。","梦中若得相寻见。","却愿春宵，一夜如年远。"],"s":"mixed","f":"trad"},{"i":"c-08d990967277","t":"惜芳时・思归乐","a":"欧阳修","d":"宋","g":"词","p":["因倚兰台翠云亸。","睡未足、双眉尚锁。","潜身走向伊行坐。","孜孜地、告他梳裹。","发妆酒冷重温过。","道要饮、除非伴我。","丁香嚼碎偎人睡，犹记恨、夜来些个。"],"s":"simp","f":"trad"},{"i":"c-b89490bee1fa","t":"洞仙歌令・洞仙歌","a":"欧阳修","d":"宋","g":"词","p":["楼前乱草，是离人方寸。","倚遍阑干意无尽。","罗巾掩，宿粉残眉、香未减，人与天涯共远。","香闺知人否，长是厌厌，拟写相思寄归信。","未写了，泪成行、早满香笺。","相思字、一时滴损。","便直饶、伊家总无情，也拼了一生，为伊成病。"],"s":"simp","f":"trad"},{"i":"c-7115c0aded62","t":"洞仙歌令・洞仙歌","a":"欧阳修","d":"宋","g":"词","p":["情知须病，奈自家先肯。","天甚教伊恁端正。","忆年时、兰棹独倚春风，相怜处、月影花光相映。","别来凭谁诉，空寄香笺，拟问前欢甚时更。","后约与新期，易失难寻，空肠断、损风流心性。","除只把、芳尊强开颜，奈酒到愁肠，醉了还醒。"],"s":"simp","f":"trad"},{"i":"c-4bed3cd9f24b","t":"鹊踏枝・蝶恋花","a":"欧阳修","d":"宋","g":"词","p":["一曲尊前开画扇。","暂近还遥，不语仍低面。","直至情多缘少见。","千金不直双回眄。","苦恨行云容易散。","过尽佳期，争向年芳晚。","百种寻思千万遍。","愁肠不似情难断。"],"s":"simp","f":"trad"},{"i":"c-111ddfec16ab","t":"品令","a":"欧阳修","d":"宋","g":"词","p":["渐素景。","金风劲。","早是凄凉孤冷。","那堪闻、蛩吟穿金井。","唤愁绪难整。","懊恼人人薄幸。","负云期雨信。","终日望伊来，无凭准。","闷损我、也不定。"],"s":"simp","f":"trad"},{"i":"c-fa0840ee930e","t":"燕归梁","a":"欧阳修","d":"宋","g":"词","p":["风摆红藤卷绣帘。","宝鉴慵拈。","日高梳洗几时忺。","金盆水、弄纤纤。","髻云谩亸残花淡，和娇媚、瘦岩岩。","离情更被宿酲兼。","空惹得、病厌厌。"],"s":"simp","f":"trad"},{"i":"c-ae6a22d45e51","t":"燕归梁","a":"欧阳修","d":"宋","g":"词","p":["屏里金炉帐外灯。","掩春睡腾腾。","绿云堆枕乱鬅鬙。","犹依约、那回曾。","人生少有，相怜到老，宁不被天憎。","而今前事总无凭。","空赢得、瘦稜稜。"],"s":"mixed","f":"trad"},{"i":"c-10f0cff5ba83","t":"圣无忧・乌夜啼","a":"欧阳修","d":"宋","g":"词","p":["相别重相遇。","恬如一梦须臾。","尊前今日欢娱事，放盏旋成虚。","莫惜斗量珠玉，随他雪白髭须。","人间长久身难得，斗在不如吾。"],"s":"simp","f":"trad"},{"i":"c-bd2ac3c0abd3","t":"锦香囊","a":"欧阳修","d":"宋","g":"词","p":["一寸相思无著处。","甚夜长难度。","灯花前、几转寒更，桐叶上、数声秋雨。","真个此心终难负。","况少年情绪。","已交共、春茧缠绵，终不学、钿筝移柱。"],"s":"simp","f":"trad"},{"i":"c-3a352947b0a8","t":"系裙腰","a":"欧阳修","d":"宋","g":"词","p":["水轩檐幕透薰风。","银塘外、柳烟浓。","方床遍展鱼鳞簟，碧纱笼。","小墀面、对芙蓉。","玉人共处霜鸳枕，和娇困、睡朦胧。","起来意懒含羞态，汗香融。","系裙腰，映酥胸。"],"s":"simp","f":"trad"},{"i":"c-aeed8525ec72","t":"阮郎归","a":"欧阳修","d":"宋","g":"词","p":["浓香搓粉细腰肢。","青螺深画眉。","玉钗撩乱挽人衣。","娇多长睡迟。","绣帘角，月痕低。","仙郎东路归。","泪红满面湿胭脂。","兰房怨别离。"],"s":"simp","f":"trad"},{"i":"c-9b3a20903711","t":"阮郎归","a":"欧阳修","d":"宋","g":"词","p":["去年今日落花时。","依前又见伊。","淡匀双脸浅匀眉。","青衫透玉肌。","才会面，便相思。","相思无尽期。","这回相见好相知。","相知已是迟。"],"s":"simp","f":"trad"},{"i":"c-93c60177bd7c","t":"阮郎归","a":"欧阳修","d":"宋","g":"词","p":["玉肌花脸柳腰肢。","红妆浅黛眉。","翠鬟斜亸语声低。","娇羞云雨时。","伊怜我，我怜伊。","心儿与眼儿。","绣屏深处说深期。","幽情谁得知。"],"s":"simp","f":"trad"},{"i":"c-43794425d61a","t":"怨春郎","a":"欧阳修","d":"宋","g":"词","p":["为伊家，终日闷。","受尽恓惶谁问。","不知不觉上心头，悄一霎身心，顿也没处顿。","恼愁肠，成寸寸。","已恁莫把人萦损。","奈每每人前道著伊，空把相思泪眼和衣搵。"],"s":"mixed","f":"trad"},{"i":"c-3836e0856b77","t":"滴滴金","a":"欧阳修","d":"宋","g":"词","p":["尊前一把横波溜。","彼此心儿有。","曲屏深幌解香罗，花灯微透。","偎人欲语眉先皱。","红玉困春酒。","为问鸳衾这回后。","几时重又。"],"s":"simp","f":"trad"},{"i":"c-b2fe54d733db","t":"卜算子","a":"欧阳修","d":"宋","g":"词","p":["极得醉中眠，迤逦翻成病。","莫是前生负你来，今世里、教孤冷。","言约全无定。","是谁先薄幸。","不惯孤眠惯成双，奈奴子、心肠硬。"],"s":"simp","f":"trad"},{"i":"c-01be4e07c713","t":"感庭秋・撼庭秋","a":"欧阳修","d":"宋","g":"词","p":["红笺封了还重拆。","这添追忆。","且教伊见我，别来翠减香销端的。","渌波平远，暮山重叠，算难凭鳞翼。","倚危楼极目，无情细草长天色。"],"s":"simp","f":"trad"},{"i":"c-32ef72af5c3b","t":"满路花・促拍满路花","a":"欧阳修","d":"宋","g":"词","p":["铜荷融烛泪，金兽啮扉环。","兰堂春夜疑，惜更残。","落花风雨，向晓作轻寒。","金龟朝早，香衾馀暖，殢娇由自慵眠。","小鬟无事须来唤，呵破点唇檀。","回身还、却背屏山。","春禽飞下，帘外日三竿。","起来云鬓乱，不妆红粉，下阶且上秋千。"],"s":"simp","f":"trad"},{"i":"c-20b674561898","t":"好女儿令・好女儿","a":"欧阳修","d":"宋","g":"词","p":["眼细眉长。","宫样梳妆。","靸鞋儿走向花下立著。","一身绣出，两同心字，浅浅金黄。","早是肌肤轻渺，抱著了、暖仍香。","姿姿媚媚端正好，怎教人别后，从头仔细，断得思量。"],"s":"simp","f":"trad"},{"i":"c-b1b679500291","t":"南乡子","a":"欧阳修","d":"宋","g":"词","p":["浅浅画双眉。","取次梳妆也便宜。","洒着胭脂红扑面，须知。","更有何人得似伊。","宝帐烛残时。","好个温柔模样儿。","月里仙郎清似玉，相期。","些子精神更与谁。"],"s":"simp","f":"trad"},{"i":"c-ed9c73c00bc9","t":"南乡子","a":"欧阳修","d":"宋","g":"词","p":["好个人人，深点唇儿淡抹腮。","花下相逢、忙走怕人猜。","遗下弓弓小绣鞋。","剗袜重来。","半亸乌云金凤钗。","行笑行行连抱得，相挨。","一向娇痴不下怀。"],"s":"mixed","f":"trad"},{"i":"c-8a14a722c497","t":"踏莎行","a":"欧阳修","d":"宋","g":"词","p":["碧藓回廊，绿杨深院。","偷期夜入帘犹卷。","照人无奈月华明，潜身却恨花深浅。","密约如沈，前欢未便。","看看掷尽金壶箭。","阑干敲遍不应人，分明帘下闻裁剪。"],"s":"simp","f":"trad"},{"i":"c-21c041378d77","t":"踏莎行","a":"欧阳修","d":"宋","g":"词","p":["云母屏低，流苏帐小。","矮床薄被秋将晓。","乍凉天气未寒时，平明窗外闻啼鸟。","困殢榴花，香添蕙草。","佳期须及朱颜好。","莫言多病为多情，此身甘向情中老。"],"s":"simp","f":"trad"},{"i":"c-d3eab0a0b8e9","t":"诉衷情","a":"欧阳修","d":"宋","g":"词","p":["歌时眉黛舞时腰。","无处不娇饶。","初剪菊、欲登高。","天气怯鲛绡。","紫丝障，绿杨桥。","路迢迢。","酒阑歌罢，一度归时，一度魂消。"],"s":"simp","f":"trad"},{"i":"c-2308ad9f55c0","t":"诉衷情","a":"欧阳修","d":"宋","g":"词","p":["离怀酒病两忡忡。","倚枕梦无踪。","可怜有人今夜，胆小怯房空。","杨柳绿，杏梢红。","负春风。","迢迢别恨，脉脉归心，付与征鸿。"],"s":"simp","f":"trad"},{"i":"c-8cea6ac65ab8","t":"恨春迟","a":"欧阳修","d":"宋","g":"词","p":["欲借江梅荐饮。","望陇驿、音息沈沈。","住在柳州东，彼此相思，梦回云去难寻。","归燕来时花期浸。","淡月坠、将晓还阴。","争奈多情易感，风信无凭，如何消遣初心。"],"s":"simp","f":"trad"},{"i":"c-c4d0d38c2912","t":"盐角儿","a":"欧阳修","d":"宋","g":"词","p":["增之太长，减之太短，出群风格。","施朱太赤，施粉太白，倾城颜色。","慧多多，娇的的。","天付与、教谁怜惜。","除非我、偎著抱著，更有何人消得。"],"s":"simp","f":"trad"},{"i":"c-69acb52c1ed1","t":"盐角儿","a":"欧阳修","d":"宋","g":"词","p":["人生最苦，少年不得，鸳帏相守。","西风时节，那堪话别，双蛾频皱。","暗消魂，重回首。","奈心儿里、彼此皆有。","后时我、两个相见，管取一双清瘦。"],"s":"simp","f":"trad"},{"i":"c-c9d1da087105","t":"忆秦娥","a":"欧阳修","d":"宋","g":"词","p":["十五六，脱罗裳，长恁黛眉蹙。","红玉暖，入人怀，春困熟。","展香裀，帐前明画烛。","眼波长，斜浸鬓云绿。","看不足。","苦残宵、更漏促。"],"s":"simp","f":"trad"},{"i":"c-7b5ce1b0cd64","t":"少年游","a":"欧阳修","d":"宋","g":"词","p":["绿云双亸插金翘。","年纪正妖饶。","汉妃束素，小蛮垂柳，都占洛城腰。","锦屏春过衣初减，香雪暖凝消。","试问当筵眼波恨，滴滴为谁娇。"],"s":"simp","f":"trad"},{"i":"c-06c8deb6d84a","t":"踏莎行慢","a":"欧阳修","d":"宋","g":"词","p":["独自上孤舟。","倚危樯目断。","难成暮雨，更朝云散。","凉劲残叶乱。","新月照、澄波浅。","今夜里，厌厌离绪难销遣。","强来就枕，灯残漏永，合相思眼。","分明梦见如花面。","依前是、旧庭院。","新月照，罗幕挂，珠帘卷。","渐向晓，脉然睡觉如天远。"],"s":"simp","f":"trad"},{"i":"c-3b010b586983","t":"蕙香囊・鹊桥仙","a":"欧阳修","d":"宋","g":"词","p":["身作琵琶，调全宫羽，佳人自然用意。","宝檀槽在雪胸前，倚香脐、横枕琼臂。","组带金钩，背垂红绶，纤指转弦韵细。","愿伊只恁拨梁州，且多时、得在怀里。"],"s":"simp","f":"trad"},{"i":"c-941806dbffca","t":"玉楼春","a":"欧阳修","d":"宋","g":"词","p":["艳冶风情天与措。","清瘦肌肤冰雪妒。","百年心事一宵同，愁听鸡声窗外度。","信阻青禽云雨暮。","海月空惊人两处。","强将离恨倚江楼，江水不能流恨去。"],"s":"simp","f":"trad"},{"i":"c-86f70cab59a6","t":"玉楼春","a":"欧阳修","d":"宋","g":"词","p":["半辐霜绡亲手剪。","香染青蛾和泪卷。","画时横接媚霞长，印处双沾愁黛浅。","当时付我情何限。","欲使妆痕长在眼。","一回忆著一拈看，便似花前重见面。"],"s":"simp","f":"trad"},{"i":"c-f2b2999e2ecb","t":"玉楼春","a":"欧阳修","d":"宋","g":"词","p":["红楼昨夜相将饮。","月近珠帘花近枕。","银缸照客酒方酣，玉漏催人街已禁。","晚潮去棹浮清浸。","古岸平芜萧索甚。","大都薄宦足离愁，不放双鸳长恁恁。"],"s":"simp","f":"trad"},{"i":"c-9d253d4322a4","t":"玉楼春","a":"欧阳修","d":"宋","g":"词","p":["金雀双鬟年纪小。","学画蛾眉红淡扫。","尽人言语尽人怜，不解此情惟解笑。","稳着舞衣行动俏。","走向绮筵呈曲妙。","刘郎大有惜花心，只恨寻花来较早。"],"s":"simp","f":"trad"},{"i":"c-121042175f3d","t":"玉楼春","a":"欧阳修","d":"宋","g":"词","p":["夜来枕上争闲事。","推倒屏山褰绣被。","尽人求守不应人，走向碧纱窗下睡。","直到起来由自殢。","向道夜来真个醉。","大家恶发大家休，毕竟到头谁不是。"],"s":"simp","f":"trad"},{"i":"c-7c9994758e39","t":"定风波","a":"欧阳修","d":"宋","g":"词","p":["把酒花前欲问伊。","问伊还记那回时。","黯淡梨花笼月影。","人静。","画堂东畔药阑西。","及至如今都不认。","难问。","有情谁道不相思。","何事碧窗春睡觉。","偷照。","粉痕匀却湿胭脂。"],"s":"simp","f":"trad"},{"i":"c-f091da93b6ea","t":"减字木兰花","a":"欧阳修","d":"宋","g":"词","p":["去年残腊。","曾折梅花相对插。","人面而今。","空有花开无处寻。","天天不远。","把酒拈花重发愿。","愿得和伊。","偎雪眠香似旧时。"],"s":"simp","f":"trad"},{"i":"c-1480967c7b85","t":"减字木兰花","a":"欧阳修","d":"宋","g":"词","p":["年来方寸。","十日幽欢千日恨。","未会此情。","白尽人头可得平。","区区堪比。","水趁浮萍风趁水。","试望瑶京。","芳草随人上古城。"],"s":"simp","f":"trad"},{"i":"c-c7b838df6011","t":"迎春乐","a":"欧阳修","d":"宋","g":"词","p":["薄纱衫子裙腰匝。","步轻轻、小罗靸。","人前爱把眼儿札。","香汗透、胭脂蜡。","良夜永、幽期欢则洽。","约重会、玉纤频插。","执手临归，犹且更待留时霎。"],"s":"simp","f":"trad"},{"i":"c-1ef86dc67ad8","t":"一落索","a":"欧阳修","d":"宋","g":"词","p":["小桃风撼香红碎。","满帘笼花气。","看花何事却成愁，悄不会、春风意。","窗在梧桐叶底。","更黄昏雨细。","枕前前事上心来，独自个、怎生睡。"],"s":"simp","f":"trad"},{"i":"c-d6f4b05f2771","t":"夜行船","a":"欧阳修","d":"宋","g":"词","p":["闲把鸳衾横枕。","损眉尖、泪痕红沁。","花时良夜不归来，忍频听、漏移清禁。","一饷无言都未寝。","忆当初、是谁先恁。","及至如今，教人成病，风流万般徒甚。"],"s":"simp","f":"trad"},{"i":"c-6c52650d0ecb","t":"夜行船","a":"欧阳修","d":"宋","g":"词","p":["轻捧香腮低枕。","眼波媚、向人相浸。","佯娇佯醉索如今，这风情、怎教人禁。","却与和衣推未寝。","低声地、告人休恁。","月夕花朝，不成虚过，芳年嫁君徒甚。"],"s":"simp","f":"trad"},{"i":"c-ec4073dea009","t":"望江南・忆江南","a":"欧阳修","d":"宋","g":"词","p":["江南柳，花柳两相柔。","花片落时粘酒盏，柳条低处拂人头。","各自是风流。","江南月，如镜复如钩。","似镜不侵红粉面，似钩不挂画帘头。","长是照离愁。"],"s":"simp","f":"trad"},{"i":"c-bdd81d3c52b8","t":"望江南・忆江南","a":"欧阳修","d":"宋","g":"词","p":["江南柳，叶小未成阴。","人为丝轻那忍折，莺嫌枝嫩不胜吟。","留著待春深。","十四五，闲抱琵琶寻。","阶上簸钱阶下走，恁时相见早留心。","何况到如今。"],"s":"simp","f":"trad"},{"i":"c-3e0a9347e21a","t":"宴瑶池・越江吟","a":"欧阳修","d":"宋","g":"词","p":["恋眼哝心终未改。","向意间长在。","都缘为、颜色殊常，见馀花、尽无心爱。","都为是风流㬠。","至他人、强来厮壤。","从今后、若得相逢，绣帏里、痛惜娇态。"],"s":"simp","f":"trad"},{"i":"c-f0acef43b2a9","t":"解仙佩","a":"欧阳修","d":"宋","g":"词","p":["有个人人牵系。","泪成痕、滴尽罗衣。","问海约山盟何时。","镇教人、目断魂飞。","梦里似偎人睡。","肌肤依旧骨香腻。","觉来但堆鸳被。","想忡忡、那里争知。"],"s":"simp","f":"trad"},{"i":"c-0b65d932281d","t":"渔家傲","a":"欧阳修","d":"宋","g":"词","p":["战胜归来飞捷奏。","倾贺酒。","玉阶遥献南山寿。"],"s":"simp","f":"trad"},{"i":"c-00a0bbe96273","t":"少年游","a":"欧阳修","d":"宋","g":"词","p":["阑干十二独凭春。","晴碧远连云。","千里万里，二月三月，行色苦愁人。","谢家池上，江淹浦畔，吟魄与离魂。","那堪疏雨滴黄昏。","更特地、忆王孙。"],"s":"simp","f":"trad"},{"i":"c-f181ece848e0","t":"桃源忆故人","a":"欧阳修","d":"宋","g":"词","p":["碧纱影弄东风晓。","一夜海棠开了。","枝上数声啼鸟。","妆点愁多少。","妒云恨雨腰支袅。","眉黛不忺重扫。","薄幸不来春老。","羞带宜男草。"],"s":"simp","f":"trad"},{"i":"c-18a27f00a113","t":"阮郎归","a":"欧阳修","d":"宋","g":"词","p":["雪霜林际见依稀。","清香已暗期。","前村已遍倚南枝。","群花犹未知。","情似旧，赏休迟。","看看陇上吹。","便从今日赏芳菲。","韶华取次归。"],"s":"simp","f":"trad"},{"i":"c-7f849d91f74d","t":"南乡子","a":"荣","d":"宋","g":"词","p":["江上野梅芳。","粉色盈盈照路傍。","闲折一枝和雪嗅，思量。","似个人人玉体香。","特地起愁肠。","此恨谁人与寄将。","山馆寂寥天欲暮，凄凉。","人转迢迢路转长。"],"s":"simp","f":"trad"},{"i":"c-c37368204cfe","t":"定风波","a":"王琪","d":"宋","g":"词","p":["把酒花前欲问天。","春来秋去苦茫然。","风雨满枝花满地。","何事。","却教纤草占流年。","试把钿筝重促柱。","无绪。","酒阑清泪滴朱弦。","赖有玉人相顾好。","轻笑。","却疑春色在婵娟。"],"s":"simp","f":"trad"},{"i":"c-93212050a7f0","t":"祝英台・祝英台近","a":"王琪","d":"宋","g":"词","p":["可堪妒柳羞花，下床都懒，便瘦也教春知道。"],"s":"simp","f":"trad"},{"i":"c-0b4e3810ec51","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南柳，烟穗拂人轻。","愁黛空长描不似，舞腰虽瘦学难成。","天意与风情。","攀折处，离恨几时平。","已纵柔条萦客棹，更飞狂絮扑旗亭。","三月乱莺声。"],"s":"simp","f":"trad"},{"i":"c-f3f2399d7f9c","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南酒，何处味偏浓。","醉卧春风深巷里，晓寻香旆小桥东。","竹叶满金锺。","檀板醉，人面粉生红。","青杏黄梅朱阁上，鲥鱼苦笋玉盘中。","酩酊任愁攻。"],"s":"simp","f":"trad"},{"i":"c-ab5dc8f1dd7a","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南燕，轻扬绣帘风。","二月池塘新社过，六朝宫殿旧巢空。","颉颃恣西东。","王谢宅，曾入绮堂中。","烟径掠花飞远远，晓窗惊梦语匆匆。","偏占杏园红。"],"s":"simp","f":"trad"},{"i":"c-212fc07848f1","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南竹，清润绝纤埃。","深径欲留双凤宿，后庭偏映小桃开。","风月影徘徊。","寒玉瘦，霜霰信相催。","粉泪空流妆点在，羊车曾傍翠枝来。","龙笛莫轻裁。"],"s":"simp","f":"trad"},{"i":"c-89768c030c63","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南草，如种复如描。","深映落花莺舌乱，绿迷南浦客魂消。","日日斗青袍。","风欲转，柔态不胜娇。","远翠天涯经夜雨，冷痕沙上带昏潮。","谁梦与兰苕。"],"s":"simp","f":"trad"},{"i":"c-3e4587781f2b","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南雨，风送满长川。","碧瓦烟昏沈柳岸，红绡香润入梅天。","飘洒正潇然。","朝与暮，长在楚峰前。","寒夜愁敧金带枕，暮江深闭木兰船。","烟浪远相连。"],"s":"mixed","f":"trad"},{"i":"c-83dda794cea9","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南水，江路转平沙。","雨霁高烟收素练，风晴细浪吐寒花。","迢递送星槎。","名利客，飘泊未还家。","西塞山前渔唱远，洞庭波上雁行斜。","征棹宿天涯。"],"s":"simp","f":"trad"},{"i":"c-05d9cfc1d1ed","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南岸，云树半晴阴。","帆去帆来天亦老，潮生潮落日还沈。","南北别离心。","兴废事，千古一沾襟。","山下孤烟渔市晓，柳边疏雨酒家深。","行客莫登临。"],"s":"simp","f":"trad"},{"i":"c-ef5157256d4b","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南月，清夜满西楼。","云落开时冰吐鉴，浪花深处玉沈钩。","圆缺几时休。","星汉迥，风露入新秋。","丹桂不知摇落恨，素娥应信别离愁。","天上共悠悠。"],"s":"simp","f":"trad"},{"i":"c-9b1bc73f5ee4","t":"望江南・忆江南","a":"王琪","d":"宋","g":"词","p":["江南雪，轻素剪云端。","琼树忽惊春意早，梅花偏觉晓香寒。","冷影褫清欢。","蟾玉迥，清夜好重看。","谢女联诗衾翠幕，子猷乘兴泛平澜。","空惜舞英残。"],"s":"simp","f":"trad"},{"i":"c-ef00674dc89b","t":"失调名","a":"王琪","d":"宋","g":"词","p":["金斗熨秋江。"],"s":"simp","f":"trad"},{"i":"c-503a4f75c3d9","t":"一络索・一落萦","a":"陈凤仪","d":"宋","g":"词","p":["蜀江春色浓如雾。","拥双旌归去。","海棠也似别君难，一点点、啼红雨。","此去马蹄何处。","沙堤新路。","禁林赐宴赏花时，还忆著、西楼否。"],"s":"simp","f":"trad"},{"i":"c-7f74b1feb6ec","t":"水调歌头","a":"苏舜钦","d":"宋","g":"词","p":["潇洒太湖岸，淡伫洞庭山。","鱼龙隐处，烟雾深锁渺弥间。","方念陶朱张翰，忽有扁舟急桨，撇浪载鲈还。","落日暴风雨，归路绕汀湾。","丈夫志，当景盛，耻疏闲。","壮年何事憔悴，华发改朱颜。","拟借寒潭垂钓，又恐鸥鸟相猜，不肯傍青纶。","刺棹穿芦荻，无语看波澜。"],"s":"simp","f":"trad"},{"i":"c-0a92fa84fd82","t":"永遇乐","a":"解","d":"宋","g":"词","p":["风暖莺娇，露浓花重，天气和煦。","院落烟收，垂杨舞困，无奈堆金缕。","谁家巧纵，青楼弦管，惹起梦云情绪。","忆当时、纹衾粲枕，未尝暂孤鸳侣。","芳菲易老，故人难聚。","到此翻成轻误。","阆苑仙遥，蛮笺纵写、何计传深诉。","青山绿水，古今长在，惟有旧欢何处。","空赢得、斜阳暮草，淡烟细雨。"],"s":"simp","f":"trad"},{"i":"c-7658e3b38ba2","t":"阳台梦","a":"解","d":"宋","g":"词","p":["仙姿本寓。","十二峰前住。","千里行云行雨。","偶因鹤驭过巫阳。","邂逅他、楚襄王。","无端宋玉夸才赋。","诬诞人心素。","至今狂客到阳台。","也有痴心，望妾入、梦中来。"],"s":"simp","f":"trad"},{"i":"c-8cb88927ec41","t":"点绛唇","a":"韩琦","d":"宋","g":"词","p":["病起恹恹，画堂花谢添憔悴。","乱红飘砌。","滴尽胭脂泪。","惆怅前春，谁向花前醉。","愁无际。","武陵回睇。","人远波空翠。"],"s":"simp","f":"trad"}]