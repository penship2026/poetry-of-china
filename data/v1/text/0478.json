[{"i":"8006fc56-8f6e-4f87-a8d1-463632c8b3db","t":"秦夢詩三首 一","a":"沈亞之","d":"唐","g":"短诗","p":["泣葬一枝紅，生同死不同。","金鈿墜芳草，香繡滿春風。","舊日聞簫處，高樓當月中。","梨花寒食夜，深閉翠微宮。"],"s":"trad","f":"simp"},{"i":"518c5bb0-46ca-4937-bb3c-521419f7d84e","t":"秦夢詩三首 二","a":"沈亞之","d":"唐","g":"短诗","p":["擊髆舞，恨滿煙光無處所。","淚如雨，欲擬著辭不成語。","金鳳銜紅舊繡衣，幾度宮中同看舞。","人間春日正歡樂，日暮東風何處去。"],"s":"trad","f":"simp"},{"i":"c0135625-b581-4537-9dc8-7281af2b4273","t":"秦夢詩三首 三","a":"沈亞之","d":"唐","g":"短诗","p":["君王多感放東歸，從此秦宮不復期。","春景似傷秦喪主，落花如雨淚燕脂。"],"s":"trad","f":"simp"},{"i":"51b1fb56-a714-4666-9fb4-939d90464ca0","t":"夢中詩","a":"盧獻卿","d":"唐","g":"短诗","p":["卜築郊原古，青山無四鄰。","扶疎遶屋樹，寂寞獨歸人。"],"s":"trad","f":"simp"},{"i":"f0875b11-a161-49cc-9bda-6a5337996edf","t":"夢爲吳泰伯作勝兒歌","a":"劉景復","d":"唐","g":"古体","p":["繁弦已停雜吹歇，勝兒調弄邏娑撥。","四弦攏撚三五聲，喚起邊風駐明月。","大聲嘈嘈奔淈淈，浪蹙波翻倒溟渤。","小弦切切怨颸颸，鬼哭神悲秋窸窣。","倒腕斜挑摯流電，春雷直戛騰秋鶻。","漢妃徒得端正名，秦女虛誇有仙骨。","我聞天寶十年前，涼州未作西戎窟。","麻衣右衽皆漢民，不省胡塵暫蓬勃。","太平之末狂胡亂，犬豕崩騰恣唐突。","玄宗未到萬里橋，東洛西京一時沒。","漢土民皆沒爲虜，飲恨吞聲空嗢咽。","時看漢月望漢天，怨氣衝星成彗孛。","國門之西八九鎮，高城深壘閉閑卒。","河湟咫尺不能收，輓粟推車徒兀兀。","今朝聞奏涼州曲，使我心神暗超忽。","勝兒若向邊塞彈，征人淚血應闌干。"],"s":"mixed","f":"simp"},{"i":"0290882c-a58a-42c6-a885-adc856521bc3","t":"夢中辭","a":"郭仁表","d":"唐","g":"短诗","p":["飄風暴雨可思惟，鶴望巢門歛翅飛，吾道之宗正可依。"],"s":"trad","f":"simp"},{"i":"aaa35a16-6b58-44c9-b85a-f43d701e4f4b","t":"夢崔嘏妻詩","a":"國邵南","d":"唐","g":"短诗","p":["莫以真留妾，從他理管弦。","容華難久駐，知得幾多年。"],"s":"mixed","f":"simp"},{"i":"836fe1c0-1ada-4158-8669-378e166e6347","t":"夢白衣婦人歌詞 一","a":"盧絳","d":"唐","g":"短诗","p":["玉京人去秋簫索，畫簷鵲起梧桐落。","欹枕悄無言，月和殘夢圓。","背燈惟暗泣，甚處碪聲急。","眉黛小山攢，芭蕉生暮寒。"],"s":"trad","f":"simp"},{"i":"798c2db1-a126-4f31-bd61-fed5d6e87026","t":"夢白衣婦人歌詞 二","a":"盧絳","d":"唐","g":"短诗","p":["清風明月夜深時，箕箒盧郎恨已遲。","他日孟家坡上約，再來相見是佳期。"],"s":"trad","f":"simp"},{"i":"98368183-d8a9-4d4b-a45b-c6fbbaea78e1","t":"夢舜撫琴歌","a":"張生","d":"唐","g":"短诗","p":["南風薰薰兮草芊芊，妙有之音兮歸清弦。","蕩蕩之教兮由自然，熈熈之化兮吾道全，薰薰兮思何傳。"],"s":"trad","f":"simp"},{"i":"81693941-5773-4626-b828-65416b22ebd9","t":"夢康仙示詩","a":"漳郡守","d":"唐","g":"短诗","p":["賣藥因循未得還，却因耽酒到人間。","有心只戀琵琶坂，無意更登山上山。"],"s":"mixed","f":"simp"},{"i":"8f68f36e-80ab-45ae-bfe6-318ae1fbb473","t":"夢中歌","a":"獨孤遐叔妻白氏","d":"唐","g":"短诗","p":["今夕何夕，存耶沒耶。","良人去兮天之涯，園樹傷心兮三見花。"],"s":"trad","f":"simp"},{"i":"15f660ce-d6c6-48b1-a38c-787bc38874e6","t":"夢中歌 一","a":"張生妻","d":"唐","g":"短诗","p":["歎衰草，絡緯聲切切。","良人一去不復還，今夕坐愁鬢如雪。"],"s":"trad","f":"simp"},{"i":"5f8a2d08-2a69-4f8a-86df-8bc7a677c157","t":"夢中歌 二","a":"張生妻","d":"唐","g":"短诗","p":["勸君酒，君莫辭。","落花徒繞枝，流水無返期。"],"s":"trad","f":"simp"},{"i":"2e315b31-af38-4361-8147-571ee2cde3c5","t":"夢中歌 三","a":"張生妻","d":"唐","g":"短诗","p":["怨空閨，秋日亦難暮。","夫壻斷音書，遙天鴈空度。"],"s":"trad","f":"simp"},{"i":"100e82db-454f-48fd-8f2d-2862c0d8b89e","t":"夢中歌 四","a":"張生妻","d":"唐","g":"短诗","p":["切切夕風急，露滋庭草濕。","良人去不回，焉知掩閨泣。"],"s":"trad","f":"simp"},{"i":"a6308ad2-713e-4866-a3ae-776ffb5ff69c","t":"夢中歌 五","a":"張生妻","d":"唐","g":"短诗","p":["螢火穿白楊，悲風入荒草。","疑是夢中遊，愁迷故園道。"],"s":"trad","f":"simp"},{"i":"8d5d5a9d-ab75-4ad0-88ff-d14cb6536d5e","t":"夢中歌 六","a":"張生妻","d":"唐","g":"短诗","p":["花前始相見，花下又相送。","何必言夢中，人生盡如夢。"],"s":"trad","f":"simp"},{"i":"f4340ea4-f288-4ab2-9085-feee0fcfe948","t":"夢王尚書口授吟","a":"張氏女","d":"唐","g":"短诗","p":["鬟梳鬧掃學宮妝，獨立閑庭納夜涼。","手把玉簪敲砌竹，清歌一曲月如霜。"],"s":"trad","f":"simp"},{"i":"92827562-54bf-4aa0-8db0-1ccb15c93a01","t":"歌 一","a":"病狂人","d":"唐","g":"短诗","p":["踏陽春，人間三月雨和塵。","陽春踏，秋風起，腸斷人間白髮人。"],"s":"trad","f":"simp"},{"i":"28122823-f99f-49a0-a7b1-b2019a77a36a","t":"歌 二","a":"病狂人","d":"唐","g":"短诗","p":["五靈華，曉玲瓏，天府由來汝府中。","惆悵此情言不盡，一丸蘿蔔火吾宮。"],"s":"trad","f":"simp"},{"i":"597f9b00-dbab-49ac-b9a4-38e7ea891af0","t":"題禪窟蘭若","a":"陳季卿","d":"唐","g":"短诗","p":["霜鐘鳴時夕風急，亂鴉又望寒林集。","此時輟櫂悲且吟，獨向蓮華一峰立。"],"s":"trad","f":"simp"},{"i":"e95b166d-5bbc-4c13-9b3f-dd0382ee6435","t":"題潼關普通院門","a":"陳季卿","d":"唐","g":"短诗","p":["度關悲失志，萬緒亂心機。","下坂馬無力，掃門塵滿衣。","計謀多不就，心口自相違。","已作羞歸計，還勝羞不歸。"],"s":"trad","f":"simp"},{"i":"e46afb60-4162-47d7-8622-667cd957ebc3","t":"江亭晚望題書齋","a":"陳季卿","d":"唐","g":"短诗","p":["立向江亭滿目愁，十年前事信悠悠。","田園已逐浮雲散，鄉里半隨逝水流。","川上莫逢諸釣叟，浦邊難得舊沙鷗。","不緣齒發未遲暮，吟對遠山堪白頭。"],"s":"mixed","f":"simp"},{"i":"2d151bde-42b8-4e4d-8ed8-e3f1d47a8d27","t":"別妻","a":"陳季卿","d":"唐","g":"短诗","p":["月斜寒露白，此夕去留心。","酒至添愁飲，詩成和淚吟。","離歌悽鳳管，別鶴怨瑤琴。","明夜相思處，秋風吹半衾。"],"s":"trad","f":"simp"},{"i":"a45a02ed-ec8f-4516-9f36-c5d542cdeb87","t":"別兄弟","a":"陳季卿","d":"唐","g":"短诗","p":["謀身非不早，其奈命來遲。","舊友皆霄漢，此身猶路岐。","北風微雪後，晚景有雲時。","惆悵清江上，區區趁試期。"],"s":"trad","f":"simp"},{"i":"a5e77086-1ce8-433b-a28a-3e7fe95fc389","t":"夢中句","a":"周延翰","d":"唐","g":"短诗","p":["紫髯之伴有丹砂。"],"s":"trad","f":"simp"},{"i":"2666126c-e959-4244-8de8-3eece65eec8d","t":"夢中和句","a":"任玠","d":"唐","g":"短诗","p":["故國路遙歸去來，春風天遠望不盡。"],"s":"trad","f":"simp"},{"i":"cf6dd7ae-a2bc-4f6d-80cc-565192ae63d6","t":"夢中語","a":"杜牧","d":"唐","g":"短诗","p":["辭春不及秋，昆脚與皆頭。"],"s":"mixed","f":"simp"},{"i":"e195121c-3ace-4c2c-968b-082772f9597b","t":"夢中詩","a":"胥偃","d":"唐","g":"短诗","p":["昔作樹頭花，今爲塚中骨。"],"s":"mixed","f":"simp"},{"i":"2b295157-55b9-4ef1-b480-d66d1e626e60","t":"夢中語","a":"曾崇範妻","d":"唐","g":"短诗","p":["田頭有鹿跡，由尾著日炙。"],"s":"trad","f":"simp"},{"i":"a57f658a-f9fe-44f0-bba4-5fb3666e8a56","t":"紀夢句","a":"張孜","d":"唐","g":"短诗","p":["上天知我憶其人，使向人間夢中見。"],"s":"trad","f":"simp"},{"i":"e91b22e8-ba3f-4ecf-bab0-01f48a13fee1","t":"嘲蘇世長","a":"高祖","d":"唐","g":"短诗","p":["名長意短，口正心邪。","棄忠貞於鄭國，忘信義於吾家。"],"s":"trad","f":"simp"},{"i":"2e7923c1-27ba-4e95-bd7d-ed572fa60f8b","t":"戲題畫","a":"睿宗","d":"唐","g":"短诗","p":["喚出眼，何用苦深藏。","縮却鼻，何畏不聞香。"],"s":"mixed","f":"simp"},{"i":"f8c40dac-d201-4bf5-80b2-a4c3e889b288","t":"嘲蕭瑀射","a":"歐陽詢","d":"唐","g":"短诗","p":["急風吹緩箭，弱手馭強弓。","欲高飜復下，應西還更東。","十迴俱著地，兩手幷擎空。","借問誰爲此，乃應是宋公。"],"s":"mixed","f":"simp"},{"i":"70652987-854b-46c9-ac28-36eae35702a0","t":"與歐陽詢互嘲 一","a":"長孫無忌","d":"唐","g":"短诗","p":["聳膊成山字，埋肩不出頭。","誰家麟角上，畫此一獼猴。"],"s":"trad","f":"simp"},{"i":"c856a9b8-f782-4410-9439-86de2e9a8cb6","t":"與歐陽詢互嘲 二","a":"長孫無忌","d":"唐","g":"短诗","p":["索頭連背暖，漫襠畏肚寒。","只因心渾渾，所以面團團。"],"s":"trad","f":"simp"},{"i":"b7f111d9-7d30-4a69-920f-f55998e470b9","t":"爲溫僕射嘲竹","a":"裴略","d":"唐","g":"短诗","p":["竹，風吹青肅肅，凌冬葉不凋，經春子不熟。","虚心未得待國士，皮上何湏生節目。"],"s":"mixed","f":"simp"},{"i":"b104cf65-4ad6-4010-a19d-395125b685ee","t":"又嘲屏牆","a":"裴略","d":"唐","g":"短诗","p":["高下八九尺，東西六七步。","突兀當廳坐，幾許遮賢路。"],"s":"trad","f":"simp"},{"i":"59b057b4-f271-488a-b3f7-70a07ca537d0","t":"嘲崔左丞","a":"省吏","d":"唐","g":"短诗","p":["崔子曲如鉤，隨例得封侯。","髆上全無項，胸前別有頭。"],"s":"trad","f":"simp"},{"i":"5c73fe42-22f2-4348-9e02-69b511867818","t":"嘲高士廉木履","a":"選人","d":"唐","g":"短诗","p":["刺鼻何曾嚏，蹋面不知嗔。","高生兩箇齒，自謂得勝人。"],"s":"trad","f":"simp"},{"i":"01347646-dd39-47d2-8870-2fc1a11fc74c","t":"書化度藏院壁","a":"裴玄智","d":"唐","g":"短诗","p":["將肉遣狼守，置骨向狗頭。","自非阿羅漢，焉能免得偷。"],"s":"trad","f":"simp"},{"i":"fae5cb13-5506-411c-a957-f3eee4b0f57d","t":"嘲許子儒","a":"竇昉","d":"唐","g":"古体","p":["不能專習禮，虛心強覓階。","一年辭爵弁，半歲履麻鞋。","瓦惡頻蒙𢸗，墻虛屢被扠。","映樹便側睡，過匱即放乖。","歲暮良工畢，言是越朋儕。","今日綸言降，方知愚計喎。"],"s":"trad","f":"simp"},{"i":"104fd722-b3f4-4240-8b82-71b8e3f6fc49","t":"與趙神德互嘲","a":"梁寶","d":"唐","g":"短诗","p":["趙神德，天上既無雲，閃電何以無準則。","向者入門來，案後惟見一挺墨。","官裏料朱砂，半眼供一國。","磨公小拇指，塗得太社北。"],"s":"mixed","f":"simp"},{"i":"ffe8b26f-8d79-466d-973c-9d8269e8e425","t":"與講師互謔","a":"釋元康","d":"唐","g":"短诗","p":["甘桃不結實，苦李壓低枝。","輪王千箇子，巷伯勿孫兒。"],"s":"trad","f":"simp"},{"i":"463f6093-4493-495e-99cc-f2c034c8c874","t":"詠興善寺佛殿災","a":"李榮","d":"唐","g":"短诗","p":["道善何曾善，言興且不興。","如來燒赤盡，惟有一羣僧。"],"s":"mixed","f":"simp"},{"i":"8d51deb0-399b-4ee2-8288-56f650ee7e9b","t":"敘可笑事","a":"張元一","d":"唐","g":"短诗","p":["朱前疑著綠，逯仁傑著朱。","閻知微騎馬，馬吉甫騎驢。","將名作姓李千里，將姓作名吳栖梧。","左臺胡御史，右臺御史胡。"],"s":"mixed","f":"simp"},{"i":"b105b34b-bfa9-4d35-b307-f5e90a3d7740","t":"嘲武懿宗","a":"張元一","d":"唐","g":"短诗","p":["長弓短度箭，蜀馬臨階騗。","去賊七百里，隈墻獨自戰。","忽然逢著賊，騎豬向南𧾩。"],"s":"trad","f":"simp"},{"i":"42fa29ca-dafd-4616-90f0-da2f1b802955","t":"又嘲武懿宗","a":"張元一","d":"唐","g":"短诗","p":["裹頭極草草，掠鬢不菶菶。","未見桃花面皮，漫作杏子眼孔。"],"s":"trad","f":"simp"},{"i":"278596d5-b47a-4379-9429-2b98a732ad40","t":"詠靜樂縣主","a":"張元一","d":"唐","g":"短诗","p":["馬帶桃花錦，帬銜綠草羅。","定知幃帽底，儀容似大哥。"],"s":"trad","f":"simp"},{"i":"232e79ed-ed88-4110-a038-fc2dd71a5df2","t":"嘲格輔元","a":"杜易簡","d":"唐","g":"短诗","p":["有恥宿龍門，精彩先瞰渾。","眼瘦呈近店，睡響徹遙林。","埒囊將舊識，製被異新婚。","誰言驄馬使，飜作蟄熊蹲。"],"s":"trad","f":"simp"},{"i":"71c1a098-46fb-485f-9d19-d47361bef04b","t":"始平諧詩","a":"石抱忠","d":"唐","g":"短诗","p":["平明發始平，薄暮至何城。","庫墖朝雲上，晃池夜月明。","略彴橋頭逢長史，櫺星門外揖司兵。","一羣縣尉驢騾驟，數箇參軍鵝鴨行。"],"s":"mixed","f":"simp"},{"i":"c790ecf1-5730-493d-920f-fbc5a7b5b009","t":"詠傅巖監祠","a":"梁載言","d":"唐","g":"短诗","p":["聞道監中霤，初言是大祠。","很傍索傳馬，𬾠動出安徽。","衛司無帟幕，供膳乏鮮肥。","形容消瘦盡，空往復空歸。"],"s":"trad","f":"simp"},{"i":"61728213-0a86-4629-978c-bc36e755ba36","t":"嘲崔生","a":"劉行敏","d":"唐","g":"短诗","p":["崔生犯夜行，武候正嚴更。","幞頭拳下落，高髻掌中擎。","杖迹胸前出，繩文腕後生。","愁人不惜夜，隨意曉參橫。"],"s":"mixed","f":"simp"},{"i":"2eefd72c-00fc-40aa-a3da-2e9c53e5eb00","t":"又嘲楊文瓘","a":"劉行敏","d":"唐","g":"短诗","p":["武陵敬愛客，終宴不知疲。","遣共渾王飲，錯宴延陀兒。","始被鴻臚識，終蒙御史知。","精神既如此，長歎復何爲。"],"s":"mixed","f":"simp"},{"i":"a87ae15a-f618-4585-96c3-a23eff99e74d","t":"嘲李叔慎賀蘭僧伽杜善賢","a":"劉行敏","d":"唐","g":"短诗","p":["叔慎騎烏馬，僧伽把漆弓。","喚取長安令，共獵北山熊。"],"s":"trad","f":"simp"},{"i":"c8ab327a-94f5-4cd2-ac5c-118ce26089d1","t":"嘲父","a":"陸子","d":"唐","g":"短诗","p":["陸餘慶，筆頭無力觜頭硬。","一朝受辭訟，十日判不竟。"],"s":"trad","f":"simp"},{"i":"8b26a219-0097-4fd7-9a3a-3ac3512e4582","t":"迴波詞","a":"楊廷玉","d":"唐","g":"短诗","p":["迴波爾時廷玉，打獠取錢未足。","阿姑婆見作天子，傍人不得棖觸。"],"s":"trad","f":"simp"},{"i":"e15865c3-e43c-41d7-bc4e-7d625f37960a","t":"迴波詞","a":"中宗朝優人","d":"唐","g":"短诗","p":["迴波爾時栲栳，怕婦也是大好。","外邊祗有裴談，內里無過李老。"],"s":"mixed","f":"simp"},{"i":"6fe30e4c-25d1-437a-ade1-bc97d0add9e3","t":"乞金魚詞","a":"崔日用","d":"唐","g":"短诗","p":["臺中鼠子直須諳，信足跳梁上壁龕。","倚飜燈脂汚張五，還來齧帶報韓三。","莫浪語，直王相，大家必若賜金龜，賣却貓兒相報賞。"],"s":"mixed","f":"simp"},{"i":"c5d0b985-9e6a-4799-8a28-63623f119228","t":"又賜宴自歌","a":"崔日用","d":"唐","g":"短诗","p":["東館總是鵷鸞，南臺自多杞梓。","日用讀書萬卷，何忍不蒙學士。","墨制簾下出來，微臣眼看喜死。"],"s":"trad","f":"simp"},{"i":"f51d8b7b-116e-42fb-88f3-d68b1888b378","t":"詠癡","a":"吳人","d":"唐","g":"短诗","p":["榆兒復榆婦，造屋兼造車。","十七八九夜，還書復借書。"],"s":"mixed","f":"simp"},{"i":"7d4caf45-52b5-4a97-bbb0-8fd7900fcb2b","t":"歇後","a":"封抱一","d":"唐","g":"短诗","p":["面作天地玄，鼻有雁門紫。","既無左達承，何勞罔談彼。"],"s":"trad","f":"simp"},{"i":"477ea2b0-981b-482c-986d-d4b4ed725539","t":"送司功入京","a":"麴崇裕","d":"唐","g":"短诗","p":["崇裕有幸會，得遇明流行。","司士向京去，曠野哭聲哀。"],"s":"trad","f":"simp"},{"i":"fcb52ce7-3cde-4b77-bdf8-ec58a5aebd1c","t":"嶺南歸後獻詩","a":"權龍褒","d":"唐","g":"短诗","p":["龍褒有何罪，天恩放嶺南。","敕知無罪過，追來與將軍。"],"s":"trad","f":"simp"},{"i":"30543d11-40a3-473d-8c9c-004e05d05bc6","t":"初到滄州呈州官","a":"權龍褒","d":"唐","g":"短诗","p":["遙看滄海城，楊柳鬱青青。","中央一羣漢，聚坐打杯觥。"],"s":"mixed","f":"simp"},{"i":"d5cb87ff-7aa7-4095-8274-ad6c9993b73c","t":"秋日述懷","a":"權龍褒","d":"唐","g":"短诗","p":["檐前飛七百，雪白後園彊。","飽食房裏側，家糞集野蜋。"],"s":"mixed","f":"simp"},{"i":"00626b70-9005-4cf7-9e75-30972b6e1877","t":"喜雨","a":"權龍褒","d":"唐","g":"短诗","p":["暗去也沒雨，明來也沒雲。","日頭赫赤出，地上綠氤氳。"],"s":"trad","f":"simp"},{"i":"ca065bd5-de7e-4b4a-8b65-53b5b973e6ac","t":"皇太子夏日賜宴詩","a":"權龍褒","d":"唐","g":"短诗","p":["嚴霜白浩浩，明月赤團團。"],"s":"trad","f":"simp"},{"i":"77ee1a89-aed7-49e6-9b72-7cf6d6259780","t":"哭李嶠詩","a":"崔泰之","d":"唐","g":"短诗","p":["臺閣神仙地，衣冠君子鄉。","昨朝猶對坐，今日忽云亡。","魂隨司命鬼，魄逐見閻王。","此時罷歡笑，無復向朝堂。"],"s":"mixed","f":"simp"},{"i":"0a0848bc-da0e-4623-9dd0-0a6995e3feae","t":"詠尹字","a":"蘇頲","d":"唐","g":"短诗","p":["丑雖有足，甲不全身。","見君無口，知伊少人。"],"s":"mixed","f":"simp"},{"i":"4436e5bd-a636-474f-b081-c188212be626","t":"詠王主敬","a":"張敬忠","d":"唐","g":"短诗","p":["有意嫌兵部，專心望考功。","誰知脚踜蹬，却落省牆東。"],"s":"mixed","f":"simp"},{"i":"9a172985-54b3-4388-953b-60ea0e16b42f","t":"嘲邵景蕭嵩","a":"韋鏗","d":"唐","g":"短诗","p":["一雙胡子著緋袍，一箇鬚多一鼻高。","相對廳前捺且立，自慙身品世間毛。"],"s":"mixed","f":"simp"},{"i":"1ae6672e-58e1-4c66-8e4d-91ba617c36bc","t":"嘲韋鏗","a":"邵景","d":"唐","g":"短诗","p":["飄風忽起團團旋，倒地還如著脚䭔。","莫怪殿上空行事，却爲元非五品才。"],"s":"mixed","f":"simp"},{"i":"ac792b8c-adeb-4bde-9f9a-f962cfd54255","t":"詠毀天樞","a":"李休烈","d":"唐","g":"短诗","p":["天門街上倒天樞，火急先須卸火珠。","計合一條麻線挽，何勞兩縣索人夫。"],"s":"trad","f":"simp"},{"i":"2ec2a3cc-702b-4015-a9f9-ff0fbae6f7af","t":"與李全交詩","a":"石惠泰","d":"唐","g":"短诗","p":["御史非常任，參軍不久居。","待君遷轉後，此職還到余。"],"s":"mixed","f":"simp"},{"i":"94685790-d054-4585-b093-645d7141beaa","t":"嘲劉文樹","a":"黃幡綽","d":"唐","g":"短诗","p":["可憐好箇劉文樹，髭鬚共頦頤別住。","文樹面孔不似猢猻，猢猻面孔強似文樹。"],"s":"trad","f":"simp"},{"i":"b631320e-73fc-43f7-8d4d-3f9ac668d155","t":"尚書省門吟","a":"祖詠","d":"唐","g":"短诗","p":["落去他，兩兩三三戴帽子。","日暮祖侯吟一聲，長安竹柏皆枯死。"],"s":"trad","f":"simp"},{"i":"706a6715-b027-4a1e-acd6-3cc910974dd7","t":"上馬當山神","a":"王昌齡","d":"唐","g":"短诗","p":["青驄一匹崑崙牽，奏上大王不取錢。","直爲猛風波滾驟，莫怪昌齡不下船。"],"s":"mixed","f":"simp"},{"i":"84e07753-e67b-46d4-99d1-02e7b43341ca","t":"竊李義府詩","a":"張懷慶","d":"唐","g":"短诗","p":["生情鏤月爲歌扇，出性裁雲作舞衣。","照鏡自憐迴雪影，來時好取洛川歸。"],"s":"mixed","f":"simp"},{"i":"4fec622e-42ba-4f8e-951f-b6c3c1e89b91","t":"荅朝士","a":"賀知章","d":"唐","g":"短诗","p":["鈒鏤銀盤盛蛤蜊，鏡湖蓴菜亂如絲。","鄉曲近來佳此味，遮渠不道是吳兒。"],"s":"trad","f":"simp"},{"i":"b8568c12-f9f1-4a46-8ba2-01b7efecd580","t":"和知章詩","a":"顧況","d":"唐","g":"短诗","p":["鈒鏤銀盤盛炒鰕，鏡湖蓴菜亂如麻。","漢兒女嫁吳兒婦，吳兒盡是漢兒爺。"],"s":"trad","f":"simp"},{"i":"ef209680-bd61-4f71-84b2-64994e2e20a4","t":"續茅山秀才吟","a":"顧況","d":"唐","g":"短诗","p":["駐馬上山阿，風來屎氣多。"],"s":"trad","f":"simp"},{"i":"3e1edd84-b808-4f24-b79e-51f4d28987f1","t":"櫻桃子詩","a":"史思明","d":"唐","g":"短诗","p":["櫻桃子，半赤半已黃。","一半與懷王，一半與周至。"],"s":"trad","f":"simp"},{"i":"e45731a3-8d0b-4a18-8fb0-c1cf57807d2c","t":"譏元載詩","a":"高亭","d":"唐","g":"短诗","p":["上元官吏務剝削，江淮之人皆白著。"],"s":"trad","f":"simp"},{"i":"72cb7f32-233f-4647-af45-3fce77dd380e","t":"嘲趙謙光","a":"賀遂涉","d":"唐","g":"短诗","p":["員外由來美，郎中望亦優。","寧知粉署裏，飜作土山頭。"],"s":"mixed","f":"simp"},{"i":"e3546170-8ec5-420c-a9b6-432ce63eb74e","t":"荅賀遂涉","a":"趙謙光","d":"唐","g":"短诗","p":["錦帳隨情設，金爐任意熏。","唯愁員外置，不應列星文。"],"s":"mixed","f":"simp"},{"i":"98d96fce-fb78-4dd9-b959-0e7785dc5f43","t":"上浙東孟尚書","a":"孔顒","d":"唐","g":"短诗","p":["有箇將軍不得名，唯教健卒喝書生。","尚書近日清如鏡，天子官街不許行。"],"s":"trad","f":"simp"},{"i":"663a3af4-1d97-4908-b074-e464c3fc56da","t":"嘲柳州柳子厚","a":"呂溫","d":"唐","g":"短诗","p":["柳州柳刺史，種柳柳江邊。","柳管依然在，千秋柳拂天。"],"s":"trad","f":"simp"},{"i":"dfcdd0c6-3836-4f46-9646-bdfa15b2323b","t":"嘲黔南觀察南卓","a":"呂溫","d":"唐","g":"短诗","p":["終南南太守，南郡在雲南。","閑向南亭醉，南風變俗談。"],"s":"trad","f":"simp"},{"i":"7268a30a-29ba-490f-8406-a9e9601fd770","t":"戲簡朱壇詩","a":"張祜","d":"唐","g":"短诗","p":["昔人有玉盌，擊之千里鳴。","今日覩斯文，盌有當時聲。"],"s":"trad","f":"simp"},{"i":"970a59a2-d0fe-427f-8aaa-976634ca8eae","t":"戲顏郎官騎獵詩","a":"張祜","d":"唐","g":"短诗","p":["忽聞射獵出軍城，人著戎衣馬帶纓。","倒把角弓呈一箭，滿山狐兔當頭行。"],"s":"trad","f":"simp"},{"i":"0e40419a-1211-46e0-8106-02d94f6bcaba","t":"嘲張祜","a":"朱沖和","d":"唐","g":"短诗","p":["白在東都元已薨，蘭臺鳳閣少人登。","冬瓜堰下逢張祜，牛屎堆旁說我能。"],"s":"trad","f":"simp"},{"i":"a5c84fd2-74a7-4475-87b8-9120c86e987f","t":"嘲妓 一","a":"崔涯","d":"唐","g":"短诗","p":["雖得蘇方木，猶貪玳瑁皮。","懷胎十箇月，生下崑崙兒。"],"s":"trad","f":"simp"},{"i":"da28348b-fe36-444c-8afb-7cf28a5aaf08","t":"嘲妓 二","a":"崔涯","d":"唐","g":"短诗","p":["布袍披襖火燒氈，紙補箜篌麻接弦。","更著一雙皮屐子，紇梯紇榻出門前。"],"s":"trad","f":"simp"},{"i":"281f8298-4f01-497a-b8d5-0552c1f70c6b","t":"嘲李端端 一","a":"崔涯","d":"唐","g":"短诗","p":["黃昏不語不知行，鼻似煙窗耳似鐺。","獨把象牙梳插鬢，崑崙山上月初明。"],"s":"trad","f":"simp"},{"i":"6ccae3e5-c56b-4215-9fe2-3aa41198f5ce","t":"嘲李端端 二","a":"崔涯","d":"唐","g":"短诗","p":["覓得黃騮鞁繡鞍，善和坊裏取端端。","揚州近日渾成差，一朵能行白牡丹。"],"s":"mixed","f":"simp"},{"i":"2a334abf-0c25-46cf-9026-180e37973021","t":"詠崔雲娘","a":"李宣古","d":"唐","g":"短诗","p":["何事最堪悲，雲娘只首奇。","瘦拳拋令急，長嘯出歌遲。","只見肩侵鬢，唯憂骨透皮。","不須當戶立，頭上有鍾馗。"],"s":"trad","f":"simp"},{"i":"dc6d5586-5da2-4481-97e2-24680f43c0b9","t":"嘲妓","a":"杜牧","d":"唐","g":"短诗","p":["盤古當時有遠孫，尚令今日逞家門。","一車白土將泥項，十幅紅旗補破裩。","瓦官寺裏逢行跡，華嶽山前見掌痕。","不須惆悵憂難嫁，待與將書問樂坤。"],"s":"mixed","f":"simp"},{"i":"8e84f6d7-fabd-41b7-bb11-16dbf9235a23","t":"嘲游使君","a":"盧肇","d":"唐","g":"短诗","p":["白帝城頭二月時，忍教清醒看花枝。","莫言世上無袁許，客子由來是相師。"],"s":"mixed","f":"simp"}]