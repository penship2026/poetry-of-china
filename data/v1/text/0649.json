[{"i":"c-ece46ce0da74","t":"青玉案","a":"曹勋","d":"宋","g":"词","p":["尘埃踏遍长安道。","念云水、归来好。","趁得梅花先春到。","冷云疏雨，暗香寒艳，万玉明清晓。","青鞋黄帽从渠笑。","粲十里、冰姿步时绕。","正怕和风都过了。","已输高士，锦囊翻句，醉后先倾倒。"]},{"i":"c-d656ebef4876","t":"虞美人","a":"曹勋","d":"宋","g":"词","p":["风流贺监栽培好。","梅最妍姿巧。","娟娟占得入时妆。","秀影横斜香并、彩鸳鸯。","汉皋解佩当时遇。","绿满经行处。","如今清梦已惊残。","赖向君家窗户、得重看。"]},{"i":"c-9eac01bc8f4d","t":"虞美人","a":"曹勋","d":"宋","g":"词","p":["芙蓉露下闲庭晚。","犹觉秋容浅。","惊心莫道岁华赊。","已有官梅轻放、小春花。","西风河汉溪流月。","月下疏疏雪。","新妆喜是寿阳人。","鸾鉴不劳呵手、对寒云。"]},{"i":"c-c07e36d0ee27","t":"阮郎归","a":"曹勋","d":"宋","g":"词","p":["谁将春信到长安。","江南腊向残。","玉妃何事在人间。","冰肌莹素颜。","新月上，怯轻寒。","香心破紫檀。","数枝斜傍小亭闲。","黄昏人倚阑。"]},{"i":"c-264a8f868656","t":"阮郎归","a":"曹勋","d":"宋","g":"词","p":["玉宸赐得水云身。","初欣不佩绅。","烟霞一任著衣巾。","朝中散袒人。","湖水静，了无尘。","语兼天上春。","道人相见肯情亲。","银钩墨尚新。"]},{"i":"c-1ec7e798ab2e","t":"菩萨蛮","a":"曹勋","d":"宋","g":"词","p":["乱山影直危楼起。","天涯目断雕阑倚。","寂寞过东风。","行宫烟雨中。","长安何处日。","城郭今寒食。","谁待翠华归。","片云天际飞。"]},{"i":"c-c2c0c7934eab","t":"菩萨蛮","a":"曹勋","d":"宋","g":"词","p":["天台不是登长道。","浑如弱水烟波渺。","楼上指归程。","春风无限情。","石桥书不到。","雁阵横空杳。","愁绪比遥峰。","依依千万重。"]},{"i":"c-2ba6c9159ad9","t":"菩萨蛮","a":"曹勋","d":"宋","g":"词","p":["琴堂窗户清无暑。","宫妆争捧黄金注。","劝我醉秋风。","难辞两脸红。","别来三堕叶。","同是修门客。","十载叹萍蓬。","方欣一笑同。"]},{"i":"c-0fc9761bc288","t":"清平乐","a":"曹勋","d":"宋","g":"词","p":["去年春破。","强半途中过。","日日篷窗眠了坐。","饱听吴音楚些。","今年犹在天涯。","客情触处思家。","柳密何人深院，竹疏特地桃花。"]},{"i":"c-1f56f8d6fd00","t":"清平乐","a":"曹勋","d":"宋","g":"词","p":["风休雨罢。","三五春寒夜。","翠额重帘何妨下。","一炷非兰非麝。","红莲开遍吴宫。","华灯小试房栊。","客里愁须强遣，从来我辈情锺。"]},{"i":"c-84a7eefe4bd8","t":"清平乐","a":"曹勋","d":"宋","g":"词","p":["春前别后。","常是双眉皱。","生怕莺声催残漏。","梦破闲衾堆绣。","又还玉露金风。","秋声先到房栊。","川上不传尺素，云间犹望飞鸿。"]},{"i":"c-de1f6f212031","t":"点绛唇","a":"曹勋","d":"宋","g":"词","p":["秋雨弥空，冷侵窗户琴书润。","四檐成韵。","孤坐无人问。","壮志消沈，喜入清闲运。","常安分。","炷烟飘尽。","更拨馀香烬。"]},{"i":"c-4d1fd0da2a60","t":"点绛唇","a":"曹勋","d":"宋","g":"词","p":["惨惨春阴，画桡寒漾梅风去。","冷风吹度。","愁入淮山路。","歌扇归期，只恐春城暮。","人何处。","柳汀烟渚。","听尽篷窗雨。"]},{"i":"c-d0e3ac863f13","t":"点绛唇","a":"曹勋","d":"宋","g":"词","p":["晓日浓阴，冷云遮断山无数。","雁飞筝柱。","都向愁边去。","帘影沈沈，一缕芳香度。","深庭户。","且寻欢聚。","雪意还成雨。"]},{"i":"c-c564fcd3054d","t":"点绛唇","a":"曹勋","d":"宋","g":"词","p":["昏旦交时，个中已有甘香味。","咽同真液。","便觉温温地。","八一高蟠，光动重楼外。","但留意。","自然和气。","香满昆仑水。"]},{"i":"c-f1ab3fc7eadb","t":"浣溪沙","a":"曹勋","d":"宋","g":"词","p":["翠袖携持婉有情。","湘筠犀轴巧装成。","声随一苇更分明。","倚竹双丝明玉细，低眉数曲语莺轻。","转移新韵几多声。"]},{"i":"c-580a9b8401ef","t":"浣溪沙","a":"曹勋","d":"宋","g":"词","p":["玉柱檀槽立锦筵。","低眉信手曲初传。","凤凰飞上四条弦。","杨柳已吹三叠韵，何须人在九江船。","夜凉人与月婵娟。"]},{"i":"c-86ea41e22a12","t":"酒泉子","a":"曹勋","d":"宋","g":"词","p":["霜护云低，竹外斜枝初璀璨，仙风吹堕玉钿新。","度清芬。","叹寒冰艳了无尘。","不占纷纷桃李径，一庭疏影冷摇春。","月黄昏。"]},{"i":"c-0945ca60306e","t":"酒泉子","a":"曹勋","d":"宋","g":"词","p":["爱景催暄。","初向晴梢舒玉点，修筠霭霭隔婵娟。","更清妍。","东风欲到冷霜天。","常记孤山残雪路，一枝流水小桥边。","卧疏烟。"]},{"i":"c-e99c7b5bfe8d","t":"酒泉子","a":"曹勋","d":"宋","g":"词","p":["惨惨西风。","人与两州俱不见，一江残照落霞红。","橹声中。","汀花苹草六朝空。","人向赏心增远恨，闲云犹绕建康宫。","古今同。"]},{"i":"c-1c3babdd5c1a","t":"酒泉子","a":"曹勋","d":"宋","g":"词","p":["帘幕闲垂。","密密围毡红兽暖，有人陌上冷征衣。","未成归。","檐间鹊语卜归期。","应是疑人犹驻马，琐窗日影又还西。","翠眉低。"]},{"i":"c-ee92eb38069c","t":"朝中措","a":"曹勋","d":"宋","g":"词","p":["一封清诏下金鸾。","临遣讲邻欢。","谁问火云挥汗，要看易水摇寒。","何妨谈笑，平生志节，可障狂澜。","预约黄花前后，殊庭瞻对宸颜。"]},{"i":"c-e565abc68dfb","t":"朝中措","a":"曹勋","d":"宋","g":"词","p":["宝筝偏劝酒杯深。","歌舞乍沈沈。","秀指十三弦上，挑吟击玉锵金。","牙台锦面，轻移雁柱，低转新音。","妙是不须银甲，向人说尽芳心。"]},{"i":"c-53431f995638","t":"朝中措","a":"曹勋","d":"宋","g":"词","p":["鸣珂揽辔玉霄东。","持节散陈红。","子舍已先多士，一鞭同袅春风。","西瓯旧治，棠阴秀茂，竹马迎逢。","正焙行驰金殿，仙班看缀夔龙。"]},{"i":"c-610dc675067e","t":"西江月","a":"曹勋","d":"宋","g":"词","p":["弦泛龙香细拨，声回花底莺雏。","低眉信手巧工夫。","犹带巫烟楚雨。","人占东风秀色，花笼宝髻真珠。","锦绦金凤要人扶。","只恐乘鸾飞去。"]},{"i":"c-6c1656120893","t":"西江月","a":"曹勋","d":"宋","g":"词","p":["春绣东风疑早，映檐翠箔低笼。","氤氲不是梦云空。","叶密香翻侵冻。","折桂广寒手段，移来点检珍丛。","醉归满载紫云浓。","抱膝庵中仙种。"]},{"i":"c-611458489f37","t":"菩萨蛮","a":"胡铨","d":"宋","g":"词","p":["银河牛女年年渡。","相逢未款还忧去。","珠斗欲阑干。","盈盈一水间。","玉人偷拜月。","苦恨匆匆别。","此意愿天怜。","今宵长似年。"]},{"i":"c-eacc59d4be54","t":"减字木兰花","a":"胡铨","d":"宋","g":"词","p":["渭阳佳梦。","瓦变成璋真妙弄。","不是勾回。","汤饼冤家唤得来。","不分利市。","要我开尊真倒置。","试问坡翁。","此事如何著得侬。"]},{"i":"c-b3e7229e277f","t":"醉落魄・一斛珠","a":"胡铨","d":"宋","g":"词","p":["百年强半。","高秋犹在天南畔。","幽怀已被黄花乱。","更恨银蟾，故向愁人满。","招呼诗酒颠狂伴。","羽觞到手判无算。","浩歌箕踞巾聊岸。","酒欲醒时，兴在庐仝碗。"]},{"i":"c-06ec27138c80","t":"醉落魄・一斛珠","a":"胡铨","d":"宋","g":"词","p":["千岩竞秀。","西湖好是春时候。","谁知梅雪飘零久。","藏白收香，空袖和羹手。","天涯万里情难逗。","眉峰岂为伤春皱。","片愁未信花能绣。","若说相思，只恐天应瘦。"]},{"i":"c-c91d121cb1d3","t":"鹧鸪天","a":"胡铨","d":"宋","g":"词","p":["梦绕松江属玉飞。","秋风莼美更鲈肥。","不因入海求诗句，万里投荒亦岂宜。","青箬笠，绿荷衣。","斜风细雨也须归。","崖州险似风波海，海里风波有定时。"]},{"i":"c-a44adf18023d","t":"鹧鸪天","a":"胡铨","d":"宋","g":"词","p":["一忆西湖太瘦生。","十年不到梦曾行。","空濛山色烟霏晚，淡沲湖光雾縠轻。","芳草远，暮云平。","雨馀空翠入帘明。","梦回一饷难存济，这错都因自打成。"]},{"i":"c-97c66ef53cc4","t":"朝中措","a":"胡铨","d":"宋","g":"词","p":["崖州何有水连空。","人在浪花中。","月屿一声横竹，云帆万里雄风。","多情太守，三千珠履，二肆歌锺。","日下即归黄霸，海南长想文翁。"]},{"i":"c-dc5f360aa03a","t":"采桑子","a":"胡铨","d":"宋","g":"词","p":["山浮海上青螺远，决眦归鸿。","闲倚东风。","叠叠层云欲荡胸。","弄琴细写清江引，一洗愁容。","木杪黄封。","贤圣都堪日日中。"]},{"i":"c-2cb3624ed9df","t":"临江仙","a":"胡铨","d":"宋","g":"词","p":["我与梅花真莫逆，别来长恐因循。","几年不见岭头春。","栩然蝴蝶梦，魂梦竟非真。","浪蕊浮花空满眼，愁眉不展长颦。","此君还似不羁人。","月边风畔，千里淡相亲。"]},{"i":"c-94f7c53dbde2","t":"如梦令","a":"胡铨","d":"宋","g":"词","p":["谁念新州人老。","几度斜阳芳草。","眼雨欲晴时，梅雨故来相恼。","休恼。","休恼。","今岁荔枝能好。"]},{"i":"c-b74b47485164","t":"玉楼春","a":"胡铨","d":"宋","g":"词","p":["十年目断鲸波阔。","万里相逢歌怨咽。","髻鬟春雾翠微重，眉黛秋山烟雨抹。","小槽旋滴真珠滑。","断送一生花十八。","醉中扶上木肠儿，酒醒梦回空对月。"]},{"i":"c-490eb79f529d","t":"清平乐","a":"胡铨","d":"宋","g":"词","p":["深深花院。","雨虐风饕遍。","只欠画屏并羽扇。","谁领略春风面。","愁须诗酒相禁。","少陵底事慵吟。","不是为梅牵兴，怕渠恼乱春心。"]},{"i":"c-d64f31486cb9","t":"青玉案","a":"胡铨","d":"宋","g":"词","p":["宜霜开尽秋光老。","感节物、愁多少。","尘事难逢开口笑。","满林风雨，一江烟水，飒爽惊吹帽。","玉堂金马何须道。","且斗取、尊前玉山倒。","燕寝香清官事了。","紫萸黄菊，皂罗红袂，花与人俱好。"]},{"i":"c-e25c4e117dd0","t":"好事近","a":"胡铨","d":"宋","g":"词","p":["富贵本无心，何事故乡轻别。","空使猿惊鹤怨，误薜萝风月。","囊锥刚要出头来，不道甚时节。","欲驾巾车归去，有豺狼当辙。"]},{"i":"c-638c03612bca","t":"“僮至”念奴娇","a":"俞处","d":"宋","g":"词","p":["残蝉断雁，政西风萧索，夕阳流水。","落木无边幽眺处，云拥登山屐齿。","岁月如驰，古今同梦，惟有悲欢异。","绿尊空对，故人相望千里。","追念淮海当年，五云行殿，咫尺天颜喜。","清晓胪传仙仗里，衣染玉龙香细。","今日天涯，黄花零乱，满眼重阳泪。","艰难多病，二陵无奈秋思。"]},{"i":"c-de4fc6cabd74","t":"小重山","a":"岳飞","d":"宋","g":"词","p":["昨夜寒蛩不住鸣。","惊回千里梦，已三更。","起来独自绕阶行。","人悄悄，帘外月胧明。","白首为功名。","旧山松竹老，阻归程。","欲将心事付瑶琴。","知音少，弦断有谁听。"]},{"i":"c-9e0684b6f87f","t":"满江红","a":"岳飞","d":"宋","g":"词","p":["遥望中原，荒烟外、许多城郭。","想当年、花遮柳护，凤楼龙阁。","万岁山前珠翠绕，蓬壶殿里笙歌作。","到而今、铁骑满郊畿，风尘恶。","兵安在，膏锋锷。","民安在，填沟壑。","叹江山如故，千村寥落。","何日请缨提锐旅，一鞭直渡清河洛。","却归来、再续汉阳游，骑黄鹤。"]},{"i":"c-75a9868f3716","t":"满庭芳","a":"邵缉","d":"宋","g":"词","p":["落日旌旗，清霜剑戟，塞角声唤严更。","论兵慷慨，齿颊带风生。","坐拥貔貅十万，衔枚勇、云槊交横。","笑谈顷，匈奴授首，千里静欃枪。","荆襄，人按堵，提壶劝酒，布谷催耕。","芝夫荛子，歌舞威名。","好是轻裘缓带，驱营阵、绝漠横行。","功谁纪，风神宛转，麟阁画丹青。"]},{"i":"c-aff8fa65f316","t":"水调歌头","a":"吴芾","d":"宋","g":"词","p":["九月二十六，公相纪生辰。","橙黄橘绿时候，天气暖於春。","奎画有堂辉焕，中著台星一点，长伴寿星明。","衮衮有家庆，未羡古徐卿。","谢元枢，营绿野，避洪名。","六年裁剸国事，曾费几精神。","歇了傅岩霖雨，闲了孤舟野渡，旒冕合知心。","吾道苟尊尚，元不在蒲轮。"]},{"i":"c-7882b6f37ddd","t":"滴滴金","a":"孙道绚","d":"宋","g":"词","p":["月光飞入林前屋。","风策策，度庭竹。","夜半江城击柝声，动寒梢栖宿。","等闲老去年华促。","只有江梅伴幽独。","梦绕夷门旧家山，恨惊回难续。"]},{"i":"c-66ad28132c07","t":"醉蓬莱","a":"孙道绚","d":"宋","g":"词","p":["看鸥翻波溅，苹末风轻，水轩消暑。","云叠奇峰，破桐阴亭午。","列岫连环，溜泉鸣玉，对幅巾芒履。","况有清时，风流故人，剧谈挥麈。","才冠一时，论高两汉，书扇豪踪，吐凤辞语。","昼锦归来，庆长年老母。","且尽绿尊，莫怀归兴，听扇歌高举。","会见登庸，泥封诏下，促朝天去。"]},{"i":"c-4bda48c834e4","t":"菩萨蛮","a":"孙道绚","d":"宋","g":"词","p":["栏干六曲天围碧。","松风亭下梅初白。","腊尽见春回。","寒梢花又开。","曲琼闲不卷。","沈燎看星转。","凝伫小徘徊。","云间征雁来。"]},{"i":"c-1696c7c05426","t":"少年游","a":"孙道绚","d":"宋","g":"词","p":["雨晴云敛，烟花澹荡，遥山凝碧。","驱车问征路，赏春风南陌。","正雨后、梨花幽艳白。","悔匆匆、过了寒食。","归家渐春暮，探酴醿消息。"]},{"i":"c-7a795e7f7b17","t":"忆秦娥","a":"孙道绚","d":"宋","g":"词","p":["秋寂寞。","秋风夜雨伤离索。","伤离索。","老怀无奈，泪珠零落。","故人一去无期约。","迟书忽寄西飞鹤。","西飞鹤。","故人何在，水村山郭。"]},{"i":"c-4ce0abf11c8a","t":"醉思仙","a":"孙道绚","d":"宋","g":"词","p":["晚霞红。","看山迷暮霭，烟暗孤松。","动翩翩风袂，轻若惊鸿。","心似鉴，鬓如云，弄清影，月明中。","谩悲凉，岁冉冉，蕣华潜改衰容。","前事销凝久，十年光景匆匆。","念云轩一梦，回首春空。","彩凤远，玉箫寒，夜悄悄，恨无穷。","叹黄尘久埋玉，断肠挥泪东风。"]},{"i":"c-c1ba9cee0be7","t":"如梦令","a":"孙道绚","d":"宋","g":"词","p":["翠柏红蕉影乱。","月上朱栏一半。","风自碧空来，吹落歌珠一串。","不见。","不见。","人被绣帘遮断。"]},{"i":"c-a0dce28f22d7","t":"清平乐","a":"孙道绚","d":"宋","g":"词","p":["悠悠扬扬。","做尽轻模样。","半夜萧萧窗外响。","多在梅边竹上。","朱楼向晓帘开。","六花片片飞来。","无奈熏炉烟雾，腾腾扶上金钗。"]},{"i":"c-b4fffe245581","t":"临江仙","a":"何蓑衣道人","d":"宋","g":"词","p":["在世为仙须有分，不须素食持斋。","寸丝不著挂形骸。","蓑衣为伴侣，箬笠作家怀。","行满三千上界，奉敕宣至金台。","传言问汝有何哉。","人生长富贵，阴骘种将来。"]},{"i":"c-d1051d0e9606","t":"夜游宫","a":"陆凝之","d":"宋","g":"词","p":["东风捏就腰儿细。","系滴粉裙儿不起。","从来只惯掌中看，怎忍在、烛花影里。","酒红应是铅华褪。","暗蹙损、眉峰双翠。","夜深点緉绣鞋儿，靠那个、屏风立地。"]},{"i":"c-cc4afbcdbf06","t":"念奴娇","a":"陆凝之","d":"宋","g":"词","p":["远山一带，溯晴空、极目天涯浮白。","枫落鸦翻谈笑处，不觉云涛横席。","酒病方苏，睡魔犹殢，一扫无留迹。","吴帆越棹，恍然飞上空碧。","长记草赋梁园，凌云笔势，倒三江秋色。","对此惊心空怅望，老作红尘闲客。","别浦烟平，小楼人散，回首千波寂。","西风归路，为君重喷霜笛。"]},{"i":"c-9913b1e697ba","t":"采莲延遍・采莲令","a":"史浩","d":"宋","g":"词","p":["霞霄上，有寿乡广袤无际。","东极沧海，缥缈虚无，蓬莱弱水。","风生屋浪，鼓楫扬旍，不许凡人得至。","甚幽邃。","试右望金枢外。","西母楼阁，玉阙瑶池。","万顷琉璃。","双成倩巧，方朔诙谐。","来往徜徉，霓裳飘摇宝砌。","更稀奇。"]},{"i":"c-f13ca7a2294d","t":"采莲摇捱遍・采莲令","a":"史浩","d":"宋","g":"词","p":["南邻幄丹宫，赤伏显符记。","朱陵曜绮绣，箕翼炯、瑞光腾起。","每岁秋分老人见，表皇家、袭庆迎祺。","天子当膺，无疆万岁。","北窥玄冥，魁杓拥佳气。","长拱极、终古无移。","论南北东西。","相直何啻千万里。","信难计。"]},{"i":"c-7cef18555310","t":"采莲入破・采莲令","a":"史浩","d":"宋","g":"词","p":["璇穹层云上覆，光景如梭逝。","惟此过隙缓征辔。","垂象森列昭回。","碧落卓然躔度，炳曜更腾辉。","永永清光晔炜。","绵四野、金璧为地。","蕊珠馆，琼玖室，俱高峙。","千种奇葩，松椿可比。","暗香幽馥，岁岁长春，阳乌何曾西委。"]},{"i":"c-0f44e9badb52","t":"采莲衮遍・采莲令","a":"史浩","d":"宋","g":"词","p":["遍此境，人乐康，挟难老术，悟长生理。","尽阿僧祗劫，赤松王令安期。","彭篯盛矣。","尚为婴稚。","鹤算龟龄，绛老休夸甲子。","鲐背耸、黄发垂髻。","更童颜，长鼓腹、同游戏。","真是华胥。","行有歌，坐有乐，献笑都是神仙，时见群翁启齿。"]},{"i":"c-7ab9bf7ffe6e","t":"采莲实催・采莲令","a":"史浩","d":"宋","g":"词","p":["露华霞液，云桨椒醑，姿玉斝金罍。","交酬成雅会。","拚沈醉。","中山千日，未为长久，今此陶陶一饮，动经万祀。","陈果蓏，皆是奇异。","似瓜如斗尽备。","三千岁。","一熟珍味。","饤坐中，莹似玉、爽口流涎，三偷不枉，西真指议。"]},{"i":"c-d39a6931b7a7","t":"采莲衮・采莲令","a":"史浩","d":"宋","g":"词","p":["有珍馔，时时馈。","滑甘丰腻。","紫芝荧煌，嫩菊秀媚。","贮玛瑙琥珀精器。","延年益寿莫拟。","人间烹饪徒费。","休说龙肝凤髓。","动妙乐、仙音鼎沸。","玉箫清，瑶瑟美。","龙笛脆。","杂还飞鸾，花裀上、趁拍红牙，馀韵悠扬，竟海变桑田未止。"]},{"i":"c-e3fcc7809718","t":"采莲歇拍・采莲令","a":"史浩","d":"宋","g":"词","p":["其间有洞天侣，思游尘世。","珠葆摇曳。","华表真人，清江使者，相从密议。","此老遨嬉。","我辈应须随侍。","正举步、忽思同类。","十八公、方耸壑，宜邀致。","夙驾星言，人争图绘。","朅来鄞山甬水。","因此崇成，四明里第。"]},{"i":"c-6532eecc7b9c","t":"采莲煞衮・采莲令","a":"史浩","d":"宋","g":"词","p":["吾皇喜。","光宠无贰。","玉带金鱼荣贵。","或者疑之。","岂识圣明，曾主斯乡，尝相与尽缱绻，胶漆何可相离。","今日风云合契。","此实天意。","吾皇圣寿无极，享晏粲千载相逢，我翁亦昌炽。","永作升平上瑞。"]},{"i":"c-c846f5125417","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["练光浮，烟敛澄波渺。","燕脂湿、靓妆初了。","绿云伞上露滚滚，的皪真珠小。","笼娇媚、轻盈伫眺。","无言不见仙娥，凝望蓬岛。","玉阙葱葱，镇锁佳丽春难老。","银潢急、星槎飞到。","暂离金砌，为爱此、极目香红绕。","倚兰棹。","清歌缥缈。","隔花初见，楚楚风流年少。"]},{"i":"c-35b8c69d6551","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["蕊沼清冷涓滴水。","迢迢烟浪三千里。","微孕青房包绣绮。","薰风里。","幽芳洗尽闲桃李。","羽氅飘萧尘外侣。","相呼短棹轻偎倚。","一片清歌天际起。","声尤美。","双双惊起鸳鸯睡。"]},{"i":"c-c09dd335998c","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["翠盖参差森玉柄。","迎风浥露香无定。","不著尘沙真体净。","芦花径。","酒侵酥脸霞相映。","棹拨木兰烟水暝。","月华如练秋空静。","一曲悠扬沙鹭听。","牵清兴。","香红已满蒹葭艇。"]},{"i":"c-7f140c41a161","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["草软沙平风掠岸。","青蓑一钓烟江畔。","荷叶为裀花作幔。","知谁伴。","醇醪只把鲈鱼换。","盘缕银丝杯自暖。","篷窗醉著无人唤。","逗得醒来横脆管。","清歌缓。","彩鸾飞去红云乱。"]},{"i":"c-3e306fc5cd0a","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["太华峰头冰玉沼。","开花十丈干云杪。","风散天香闻四表。","知多少。","亭亭碧叶何曾老。","试问霏烟登鸟道。","丹崖步步祥光绕。","折得一枝归月峤。","蓬莱岛。","霞裾侍女争言好。"]},{"i":"c-dd12d63a5ca8","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["珠露漙漙清玉宇。","霞标绰约消烦暑。","时驭清风之帝所。","寻旧侣。","三千仙仗临烟渚。","舴艋飘摇来复去。","渔翁问我居何处。","笑把红蕖呼鹤驭。","回头语。","壶中自有朝天路。"]},{"i":"c-6fb73d4e5f7e","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["彤霞出水弄幽姿。","娉婷玉面相宜。","棹歌先得一枝枝。","波上画鲸飞。","向此画堂高会，幽馥散、堪引瑶卮。","幸然逢此太平时。","不醉可无归。"]},{"i":"c-c3cb8cd7300c","t":"采莲舞","a":"史浩","d":"宋","g":"词","p":["蕊宫阆苑。","听钧天帝乐，知他几遍。","争似人间，一曲采莲新传。","柳腰轻，莺舌啭。","逍遥烟浪谁羁绊。","无奈天阶，早已催班转。","却驾彩鸾，芙蓉斜盼。","愿年年，陪此宴。"]},{"i":"c-e84f2fe739e4","t":"太清舞","a":"史浩","d":"宋","g":"词","p":["武陵自古神仙府。","有渔人迷路。","洞户迸寒泉，泛桃花容与。","寻花逶逦见灵光，舍扁舟、飘然入去。","注目渺红霞，有人家无数。"]},{"i":"c-3a0e12baaa78","t":"太清舞","a":"史浩","d":"宋","g":"词","p":["须臾却有人相顾。","把肴桨来聚。","礼数既雍容，更衣冠淳古。","渔人方问此何乡，众颦眉、皆能深诉。","元是避嬴秦，共携家来住。"]},{"i":"c-f1109d8ee711","t":"太清舞","a":"史浩","d":"宋","g":"词","p":["当时脱得长城苦。","但熙熙朝暮。","上帝锡长生，任跳丸乌兔。","种桃千万已成阴，望家乡、杳然何处。","从此与凡人，隔云霄烟雨。"]},{"i":"c-bdef911085bc","t":"太清舞","a":"史浩","d":"宋","g":"词","p":["渔舟之子来何所。","尽相猜相语。","夜宿玉堂空，见火轮飞舞。","凡心有虑尚依然，复归指、维舟沙浦。","回首已茫茫，叹愚迷不悟。"]},{"i":"c-266b00b9bed8","t":"太清舞","a":"史浩","d":"宋","g":"词","p":["我今来访烟霞侣。","沸华堂箫鼓。","疑是奏钧天，宴瑶池金母。","却将桃种散阶除，俾华实、须看三度。","方记古人言，信有缘相遇。"]},{"i":"c-386e7ddacf4d","t":"太清舞","a":"史浩","d":"宋","g":"词","p":["云軿羽幰仙风举。","指丹霄烟雾。","行作玉京朝，趁两班鹓鹭。","玲珑环佩拥霓裳，却自有、箫韶随步。","含笑嘱芳筵，后会须来赴。"]},{"i":"c-3aaf4c8e2940","t":"太清舞","a":"史浩","d":"宋","g":"词","p":["游尘世、到仙乡。","喜君王。","跻治虞唐。","文德格遐荒。","四裔尽来王。","干戈偃息岁丰穰。","三万里农桑。","归去告穹苍。","锡圣寿无疆。"]},{"i":"c-7650a5229690","t":"柘枝舞","a":"史浩","d":"宋","g":"词","p":["□人奉圣□□朝□□□□主□□□□□留伊。","得荷云戏、幸遇文明，尧阶上、太平时。","□□□□何不罢岁□征舞柘枝。"]},{"i":"c-a83aa73a5e81","t":"柘枝舞","a":"史浩","d":"宋","g":"词","p":["我是柘枝娇女。","□□多风措。","□□□、□住深□，妙学得柘枝舞。","□□头戴凤冠，□□□纤腰束素。","□□遍体锦衣装，来献呈歌舞。"]},{"i":"c-781e87bb13a5","t":"柘枝舞","a":"史浩","d":"宋","g":"词","p":["回头却望尘寰去。","喧画堂箫鼓。","整云鬟、摇曳青绡，爱一曲柘枝舞。","好趁华封盛祝笑，共指南山烟雾。","蟠桃仙酒醉升平，望凤楼归路。"]},{"i":"c-5e1eacd7c86e","t":"花舞","a":"史浩","d":"宋","g":"词","p":["贵客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-d9fdc0632c19","t":"花舞","a":"史浩","d":"宋","g":"词","p":["嘉客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-fc2a813c9a91","t":"花舞","a":"史浩","d":"宋","g":"词","p":["素客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-273315009597","t":"花舞","a":"史浩","d":"宋","g":"词","p":["幽客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-7183b378d173","t":"花舞","a":"史浩","d":"宋","g":"词","p":["野客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-49c7dd1fc319","t":"花舞","a":"史浩","d":"宋","g":"词","p":["雅客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-72173aee7322","t":"花舞","a":"史浩","d":"宋","g":"词","p":["净客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-26982cf39144","t":"花舞","a":"史浩","d":"宋","g":"词","p":["仙客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-43f4f72731ae","t":"花舞","a":"史浩","d":"宋","g":"词","p":["寿客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-f37c7b9e7925","t":"花舞","a":"史浩","d":"宋","g":"词","p":["清客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-329dde74cb99","t":"花舞","a":"史浩","d":"宋","g":"词","p":["近客之名从此有。","多谢风流，飞驭陪尊酒。","持此一卮同劝后。","愿花长在人长寿。"]},{"i":"c-5c37ea346f3b","t":"花舞","a":"史浩","d":"宋","g":"词","p":["算仙家，真巧数，能使众芳长绣组。","羽軿芝葆，曾到世间，谁共凡花为伍。","桃李漫夸艳阳，百卉又无香可取。","岁岁年年长是春，何用芳菲分四序。"]},{"i":"c-ca8c1c1c3193","t":"花舞","a":"史浩","d":"宋","g":"词","p":["对芳辰，成良聚，珠服龙妆环宴俎。","我御清风，来此纵观，还须折枝归去。","归去蕊珠绕头，一一是东君为主。","隐隐青冥怯路遥，且向台中寻伴侣。"]},{"i":"c-b12b8aa67e37","t":"花舞","a":"史浩","d":"宋","g":"词","p":["叹尘寰，乌兔走，花谢花开能几许。","十分春色，一半遣愁，那堪飘零风雨。","争似此花自然，悄不待、根生下土。","花既无凋春又长，好带花枝倾寿醑。"]},{"i":"c-8749fa1688e8","t":"花舞","a":"史浩","d":"宋","g":"词","p":["是非场，名利海，得丧炎凉徒自苦。","至乐陶陶，唯有醉乡，谁向此间知趣。","花下一杯一杯，且莫把、光阴虚度。","八极神游长寿仙，蜾蠃螟蠕休更觑。"]},{"i":"c-0e3fa46aaa31","t":"剑舞","a":"史浩","d":"宋","g":"词","p":["荧荧巨阙。","左右凝霜雪。","且向玉阶掀舞，终当有、用时节。","唱彻。","人尽说。","宝此制无折。","内使奸雄落胆，外须遣、豺狼灭。"]},{"i":"c-e7c7beaffe18","t":"渔夫舞","a":"史浩","d":"宋","g":"词","p":["细雨斜风都不管。","柔蓝软绿烟堤畔。","鸥鹭忘机为主伴。","无羁绊。","等闲莫许金章换。"]},{"i":"c-eba3433e807a","t":"渔夫舞","a":"史浩","d":"宋","g":"词","p":["好景侬家披得去。","前村雪屋云深处。","一棹清歌归晚浦。","真佳趣。","知谁画得归缣素。"]}]