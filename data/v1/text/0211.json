[{"i":"ec33550f-5cd0-433f-ab85-a86a288eeeab","t":"象人","a":"元稹","d":"唐","g":"短诗","p":["被色空成象，觀空色異真。","自悲人是假，那復假爲人。"],"s":"mixed","f":"simp"},{"i":"d6b9f2e8-6fd8-4b1c-9492-b6c5cd780ada","t":"與楊十二巨源盧十九經濟同遊大安亭各賦二物各爲五韻探得松石","a":"元稹","d":"唐","g":"古体","p":["片石與孤松，曾經物外逢。","月臨棲鶴影，雲抱老人峰。","蜀客君當問，秦官我舊封。","積膏當琥珀，新劫長芙蓉。","待補蒼蒼去，樛柯早變龍。"],"s":"mixed","f":"simp"},{"i":"98cf143d-0917-47aa-8a24-ce3db79ce765","t":"賦得春雪映早梅","a":"元稹","d":"唐","g":"古体","p":["飛舞先春雪，因依上番梅。","一枝方漸秀，六出已同開。","積素光逾密，真花節暗催。","摶風飄不散，見晛忽偏摧。","郢曲琴空奏，羌音笛自哀。","今朝兩成詠，翻挾昔人才。"],"s":"trad","f":"simp"},{"i":"012cfe29-e025-4b76-97ad-b096c3c25975","t":"賦得玉巵無當","a":"元稹","d":"唐","g":"古体","p":["共惜連城寶，翻成無當巵。","詎慙君子貴，深訝巧工隳。","泛蟻功全小，如虹色不移。","可憐殊礫石，何計辨糟醨。","江海誠難滿，盤筵莫忘施。","縱乖斟酌意，猶得對光儀。"],"s":"trad","f":"simp"},{"i":"dac18257-d38e-4150-a334-fd228d6a3bd3","t":"賦得數蓂","a":"元稹","d":"唐","g":"古体","p":["將課司天曆，先觀近砌蓂。","一旬開應月，五日數從星。","桂滿叢初合，蟾虧影漸零。","辨時長有素，數閏或餘青。","墜葉推前事，新芽察未形。","堯年始今歲，方欲瑞千齡。"],"s":"trad","f":"simp"},{"i":"dd96aa7d-7490-44c0-8c76-f9499f44b62a","t":"賦得九月盡","a":"元稹","d":"唐","g":"短诗","p":["霜降三旬後，蓂餘一葉秋。","玄陰迎落日，涼魄盡殘釣。","半夜灰移琯，明朝帝御裘。","潘安過今夕，休詠賦中愁。"],"s":"trad","f":"simp"},{"i":"89ef0c6f-d36b-4825-9659-120c77e2bec5","t":"賦得雨後花","a":"元稹","d":"唐","g":"短诗","p":["紅芳憐靜色，深與雨相宜。","餘滴下纖蘂，殘珠墮細枝。","浣花江上思，啼粉鏡中窺。","念此低回久，風光幸一吹。"],"s":"mixed","f":"simp"},{"i":"4c609eb2-61d7-4af4-9233-bfe611c6edfa","t":"早歸","a":"元稹","d":"唐","g":"短诗","p":["春靜曉風微，凌晨帶酒歸。","遠山籠宿霧，高樹影朝暉。","飲馬魚驚水，穿花露滴衣。","嬌鶯似相惱，含囀傍人飛。"],"s":"trad","f":"simp"},{"i":"798fd01e-5640-491a-b856-20f3f58be019","t":"晚秋","a":"元稹","d":"唐","g":"短诗","p":["竹露滴寒聲，離人曉思驚。","酒醒秋簟冷，風急夏衣輕。","寢倦解幽夢，慮閑添遠情。","誰憐獨欹枕，斜月透窗明。"],"s":"trad","f":"simp"},{"i":"dad4f0cb-e7a1-4cde-877e-a181b7c8b7d7","t":"送林復夢赴韋令辟","a":"元稹","d":"唐","g":"短诗","p":["蜀路危於劒，憐君自坦途。","幾回曾啖炙，千里遠銜珠。","野性便荒飲，時風忌酒徒。","相門多禮讓，前後莫相踰。"],"s":"mixed","f":"simp"},{"i":"c9599c93-9d2d-4ca0-9ff3-1ee8df809789","t":"憶楊十二","a":"元稹","d":"唐","g":"短诗","p":["楊子愛言詩，春天好詠時。","戀花從馬滯，聯句放杯遲。","日映含煙竹，風牽臥柳絲。","南山更多興，須作白雲期。"],"s":"trad","f":"simp"},{"i":"9a095532-df23-4c16-b7d7-02dd9fc3e563","t":"夜合","a":"元稹","d":"唐","g":"短诗","p":["綺樹滿朝陽，融融有露光。","雨多疑濯錦，風散似分妝。","葉密煙蒙火，枝低繡拂牆。","更憐當暑見，留詠日偏長。"],"s":"trad","f":"simp"},{"i":"f19beb4c-5135-4a1c-8534-3945c8430474","t":"新竹","a":"元稹","d":"唐","g":"短诗","p":["新篁纔解籜，寒色已青蔥。","冉冉偏凝粉，蕭蕭漸引風。","扶疎多透日，寥落未成叢。","惟有團團節，堅貞大小同。"],"s":"mixed","f":"simp"},{"i":"b7eac3f3-b918-4887-885d-d49e71f8764a","t":"秋相望","a":"元稹","d":"唐","g":"短诗","p":["檐月驚殘夢，浮涼滿夏衾。","蠨蛸低戶網，螢火度牆陰。","爐暗燈光短，牀空帳影深。","此時相望久，高樹憶橫岑。"],"s":"mixed","f":"simp"},{"i":"dac5ab62-cc19-4f32-9667-4ed0077ee6c3","t":"春病","a":"元稹","d":"唐","g":"短诗","p":["病來閑臥久，因見靜時心。","殘月曉窗迥，落花幽院深。","望山移坐榻，行藥步牆陰。","車馬門前度，遙聞哀苦吟。"],"s":"trad","f":"simp"},{"i":"30c10188-d6da-4384-a219-25b8bf00bff8","t":"山竹枝","a":"元稹","d":"唐","g":"短诗","p":["深院虎溪竹，遠公身自栽。","多慙折君節，扶我出山來。","貴宅安危步，難將混俗材。","還投輞川水，從作老龍回。"],"s":"trad","f":"simp"},{"i":"3d086a93-0b1d-4a07-a994-6e76198a17d6","t":"悟禪三首寄胡果 一","a":"元稹","d":"唐","g":"短诗","p":["近聞胡隱士，潛認得心王。","不恨百年促，翻悲萬劫長。","有修終有限，無事亦無殃。","慎莫通方便，應機不頓忘。"],"s":"trad","f":"simp"},{"i":"2b7ae190-430b-47fa-99a4-3c5dfaf383df","t":"悟禪三首寄胡果 二","a":"元稹","d":"唐","g":"短诗","p":["百年都幾日，何事苦囂然。","晚歲倦爲學，閑心易到禪。","病宜多宴坐，貧似少攀緣。","自笑無名字，因名自在天。"],"s":"mixed","f":"simp"},{"i":"6d6865db-c817-450d-9c4f-42b95c941275","t":"悟禪三首寄胡果 三","a":"元稹","d":"唐","g":"短诗","p":["近見新章句，因知見在心。","春游晉祠水，晴上霍山岑。","問法僧當偈，還丹客贈金。","莫驚頭欲白，禪觀老彌深。"],"s":"mixed","f":"simp"},{"i":"97b21fcf-2c71-4ade-b6dd-744e6618accf","t":"東臺去","a":"元稹","d":"唐","g":"短诗","p":["陶君喜不遇，予每爲君言。","今日東臺去，澄心在陸渾。","旋抽隨日俸，幷買近山園。","千萬崔兼白，殷勤承主恩。"],"s":"mixed","f":"simp"},{"i":"b1764691-f3e8-453a-b9c8-ec3dfa2e27c8","t":"戴光弓","a":"元稹","d":"唐","g":"短诗","p":["潞府筋角勁，戴光因合成。","因君懷膽氣，贈我定交情。","不擬閑穿葉，那能枉始生。","唯調一隻箭，飛入破聊城。"],"s":"trad","f":"simp"},{"i":"89403a0f-4a7e-496f-980b-ab261d5a1d0e","t":"劉頗詩","a":"元稹","d":"唐","g":"短诗","p":["一言感激士，三世義忠臣。","破甕嫌妨路，燒莊恥屬人。","迥分遼海氣，閑蹋洛陽塵。","儻使權由我，還君白馬津。"],"s":"trad","f":"simp"},{"i":"cd9d3425-7ad3-42c0-aca0-c8328a19d8c7","t":"夜飲","a":"元稹","d":"唐","g":"短诗","p":["燈火隔簾明，竹梢風雨聲。","詩篇隨意贈，杯酒越巡行。","漫唱江朝曲，閑徵藥草名。","莫辭終夜飲，朝起又營營。"],"s":"trad","f":"simp"},{"i":"80c921a7-8d8a-4e92-9952-49bf6e5654d3","t":"襃城驛","a":"元稹","d":"唐","g":"短诗","p":["嚴秦修此驛，兼漲驛前池。","已種千竿竹，又栽千樹棃。","四年三月半，新筍晚花時。","悵望東川去，等閑題作詩。"],"s":"trad","f":"simp"},{"i":"c91be134-8bc6-4a1b-8577-021ce2f8abc4","t":"閑二首 一","a":"元稹","d":"唐","g":"短诗","p":["晻澹洲煙白，籬篩日脚紅。","江喧過雲雨，船泊打頭風。","艇子收魚市，鴉兒噪荻叢。","不堪堤上立，滿眼是蚊蟲。"],"s":"mixed","f":"simp"},{"i":"259c50f9-2131-4404-a442-35bd3b70e6c3","t":"閑二首 二","a":"元稹","d":"唐","g":"短诗","p":["青衫經夏黕，白髮望鄉稠。","雨冷新秋簟，星稀欲曙樓。","連鴻盡南去，雙鯉本東流。","北信無人寄，蟬聲滿樹頭。"],"s":"trad","f":"simp"},{"i":"873d6894-bc6d-447d-8042-7a8847e0f44a","t":"欲曙","a":"元稹","d":"唐","g":"短诗","p":["江隄閱暗流，漏鼓急殘籌。","片月低城堞，稀星轉角樓。","鶴媒華表上，{篦𥫗+鳥}鵊柳枝頭。","不爲來趨府，何因欲曙遊。"],"s":"mixed","f":"simp"},{"i":"fcd7ec50-36c9-4c76-bba5-d1abc18c15cd","t":"寄胡靈之","a":"元稹","d":"唐","g":"短诗","p":["早歲顛狂伴，城中共幾年。","有時潛步出，連夜小亭眠。","月影侵牀上，花叢在眼前。","今宵正風雨，空宅楚江邊。"],"s":"mixed","f":"simp"},{"i":"64167d4a-dae8-4bd9-8725-6f2a2fd0334b","t":"夜雨","a":"元稹","d":"唐","g":"短诗","p":["水怪潛幽草，江雲擁廢居。","雷驚空屋柱，電照滿牀書。","竹瓦風頻裂，茅檐雨漸疎。","平生滄海意，此去怯爲魚。"],"s":"mixed","f":"simp"},{"i":"7a1f6e57-20f4-4ff9-922d-8aac1a118229","t":"酬李六醉後見寄口號","a":"元稹","d":"唐","g":"古体","p":["頓愈頭風疾，因吟口號詩。","文章紛似繡，珠玉布如棊。","健羨觥飛酒，蒼黃日映籬。","命童寒色倦，撫穉晚啼飢。","潦倒慙相識，平生頗自奇。","明公將有問，林下是靈龜。"],"s":"trad","f":"simp"},{"i":"4e0acb89-0bc3-4682-87a2-701cc0494fbc","t":"歸田","a":"元稹","d":"唐","g":"短诗","p":["陶君三十七，挂綬出都門。","我亦今年去，商山淅岸邨。","冬修方丈室，春種桔橰園。","千萬人間事，從茲不復言。"],"s":"mixed","f":"simp"},{"i":"7642989a-74c8-4e46-8ab1-3c0b3b97aa95","t":"緣路","a":"元稹","d":"唐","g":"短诗","p":["總是玲瓏竹，兼藏淺漫溪。","沙平深見底，石亂不成泥。","煙火遙邨落，桑麻隔稻畦。","此中如有問，甘被到頭迷。"],"s":"trad","f":"simp"},{"i":"39b96ab4-54a6-4083-bd94-3147ec1b07e6","t":"誚盧戡與予數約遊三寺戡獨沈醉而不行","a":"元稹","d":"唐","g":"短诗","p":["乘興無羈束，閑行信馬蹄。","路幽穿竹遠，野迥望雲低。","素帚茅花亂，圓珠稻實齊。","如何盧進士，空戀醉如泥。"],"s":"trad","f":"simp"},{"i":"f918b6f5-8cd9-468c-b3a9-0e192436a66f","t":"遣春三首 一","a":"元稹","d":"唐","g":"短诗","p":["楊公三不惑，我惑兩般全。","逢酒判身病，拈花盡意憐。","水生低岸沒，梅蹙小珠連。","千萬紅顏輩，須驚又一年。"],"s":"trad","f":"simp"},{"i":"e1630277-c5c5-42d3-b5c9-190f346c00ce","t":"遣春三首 二","a":"元稹","d":"唐","g":"短诗","p":["柳眼開渾盡，梅心動已闌。","風光好時少，杯酒病中難。","學問慵都廢，聲名老更判。","唯餘看花伴，未免憶長安。"],"s":"trad","f":"simp"},{"i":"4ac218bc-c596-4eba-822c-e42344cf124f","t":"遣春三首 三","a":"元稹","d":"唐","g":"短诗","p":["失却遊花伴，因風浪引將。","柳堤遙認馬，梅徑誤尋香。","晚景行看謝，春心漸欲狂。","園林都不到，何處枉風光。"],"s":"mixed","f":"simp"},{"i":"da350090-e297-4f80-8fd3-3d440b97f166","t":"歲日","a":"元稹","d":"唐","g":"短诗","p":["一日今年始，一年前事空。","淒涼百年事，應與一年同。"],"s":"trad","f":"simp"},{"i":"a7dcb73d-37ac-4df5-858b-ea11bfcab662","t":"湘南登臨湘樓","a":"元稹","d":"唐","g":"短诗","p":["高處望瀟湘，花時萬井香。","雨餘憐日嫩，歲閏覺春長。","霞剎分危牓，煙波透遠光。","情知樓上好，不是仲宣鄉。"],"s":"trad","f":"simp"},{"i":"f01afb00-59b5-484a-b2f3-e76bb1717686","t":"晚宴湘亭","a":"元稹","d":"唐","g":"短诗","p":["晚日宴清湘，晴空走豔陽。","花低愁露醉，絮起覺春狂。","舞旋紅裙急，歌垂碧袖長。","甘心出童羖，須一盡時荒。"],"s":"trad","f":"simp"},{"i":"2a3cb0d0-89e9-4dc4-bca0-da2bc61718f7","t":"酒醒","a":"元稹","d":"唐","g":"短诗","p":["飲醉日將盡，醒時夜已闌。","暗燈風燄曉，春席水窗寒。","未解縈身帶，猶傾墜枕冠。","呼兒問狼藉，疑是夢中歡。"],"s":"trad","f":"simp"},{"i":"7dc2316f-aced-4ab3-a30a-41e8c1b5d6e0","t":"獨遊","a":"元稹","d":"唐","g":"短诗","p":["遠地難逢侶，閑人且獨行。","上山隨老鶴，接酒待殘鸎。","花當西施面，泉勝衛玠清。","鵜鶘滿春野，無限好同聲。"],"s":"trad","f":"simp"},{"i":"67c3da71-0821-41bf-a3db-ca498688fb4b","t":"洞庭湖","a":"元稹","d":"唐","g":"短诗","p":["人生除泛海，便到洞庭波。","駕浪沉西日，吞空接曙河。","虞巡竟安在，軒樂詎曾過。","唯有君山下，狂風萬古多。"],"s":"trad","f":"simp"},{"i":"51974ef1-b8d8-4166-baca-7d4b9e8c147b","t":"雪天","a":"元稹","d":"唐","g":"短诗","p":["故鄉千里夢，往事萬重悲。","小雪沈陰夜，閑窗老病時。","獨聞歸去鴈，偏詠別來詩。","慚愧紅妝女，頻驚兩鬢絲。"],"s":"trad","f":"simp"},{"i":"f9cb9e32-4eac-41f3-a19a-52a4f044a04c","t":"贈熊士登","a":"元稹","d":"唐","g":"短诗","p":["平生本多思，況復老逢春。","今日梅花下，他鄉值故人。"],"s":"trad","f":"simp"},{"i":"30cc1776-1373-48e5-b49d-c67fde633d71","t":"別嶺南熊判官","a":"元稹","d":"唐","g":"短诗","p":["十年常遠道，不忍別離聲。","況復三巴外，仍逢萬里行。","桐花新雨氣，梨葉晚春晴。","到海知何日，風波從此生。"],"s":"mixed","f":"simp"},{"i":"ca73e2e5-6e5a-438e-a481-372a8831d7ce","t":"水上寄樂天","a":"元稹","d":"唐","g":"短诗","p":["眼前明月水，先入漢江流。","漢水流江海，西江過庾樓。","庾樓今夜月，君豈在樓頭。","萬一樓頭望，還應望我愁。"],"s":"trad","f":"simp"},{"i":"93def192-bc98-416c-9057-3664a224bede","t":"夏陽亭臨望寄河陽侍御堯","a":"元稹","d":"唐","g":"短诗","p":["望遠音書絕，臨川意緒長。","殷勤眼前水，千里到河陽。"],"s":"trad","f":"simp"},{"i":"1351b044-b89a-4fc3-85e3-d9e17297f0ed","t":"日高睡","a":"元稹","d":"唐","g":"短诗","p":["隔是身如夢，頻來不爲名。","憐君近南住，時得到山行。"],"s":"mixed","f":"simp"},{"i":"2360a884-4907-4da4-93e1-3ebc4dc3c053","t":"輞川","a":"元稹","d":"唐","g":"短诗","p":["世累爲身累，閑忙不自由。","殷勤輞川水，何事出山流。"],"s":"mixed","f":"simp"},{"i":"8ba94648-c512-4152-b3a1-3a5f4e53b4d5","t":"天壇歸","a":"元稹","d":"唐","g":"短诗","p":["爲結區中累，因辭洞裏花。","還來舊城郭，煙火萬人家。"],"s":"mixed","f":"simp"},{"i":"716d0de3-1d63-44c7-adc2-6632a34c7857","t":"雨後","a":"元稹","d":"唐","g":"短诗","p":["倦寢數殘更，孤燈暗又明。","竹梢餘雨重，時復拂簾驚。"],"s":"trad","f":"simp"},{"i":"d715a486-a4c6-4694-b408-9dae3ecd8707","t":"晴日","a":"元稹","d":"唐","g":"短诗","p":["多病苦虛羸，晴明強展眉。","讀書心緒少，閑臥日長時。"],"s":"trad","f":"simp"},{"i":"12ad9a59-b634-4fd1-a0f5-eeefc89443d9","t":"直臺","a":"元稹","d":"唐","g":"短诗","p":["麋入神羊隊，烏驚海鷺眠。","仍教百餘日，迎送直廳前。"],"s":"trad","f":"simp"},{"i":"5f99986f-0c0c-4efa-b660-5160aa94dea4","t":"醉行","a":"元稹","d":"唐","g":"短诗","p":["秋風方索漠，霜貌足暌攜。","今日騎驄馬，街中醉蹋泥。"],"s":"trad","f":"simp"},{"i":"6f0b2bc8-134b-460f-8a7d-b7540d063e9b","t":"指巡胡","a":"元稹","d":"唐","g":"短诗","p":["遣悶多憑酒，公心只仰胡。","挺身唯直指，無意獨欺愚。"],"s":"trad","f":"simp"},{"i":"bca9c210-fdbf-4b02-9bef-bf9bc3acbaae","t":"飲新酒","a":"元稹","d":"唐","g":"短诗","p":["聞君新酒熟，況值菊花秋。","莫怪平生志，圖銷盡日愁。"],"s":"trad","f":"simp"},{"i":"59577abf-ce99-4aa1-a172-0af65d1c00c7","t":"香毬","a":"元稹","d":"唐","g":"短诗","p":["順俗唯團轉，居中莫動搖。","愛君心不惻，猶訝火長燒。"],"s":"trad","f":"simp"},{"i":"5d842a27-5a1a-48d8-87bf-b6bf55304f93","t":"景申秋八首 一","a":"元稹","d":"唐","g":"短诗","p":["年年秋意緒，多向雨中生。","漸欲煙火近，稍憐衣服輕。","詠詩閑處立，憶事夜深行。","濩落尋常慣，淒涼別爲情。"],"s":"mixed","f":"simp"},{"i":"d54a89ca-a73e-442b-98e9-0ad6df390d48","t":"景申秋八首 二","a":"元稹","d":"唐","g":"短诗","p":["蚊幌雨來卷，燭蛾燈上稀。","啼兒冷秋簟，思婦問寒衣。","簾斷螢火入，窗明蝙蝠飛。","良辰日夜去，漸與壯心違。"],"s":"trad","f":"simp"},{"i":"408db686-9dc4-42b9-b417-6e6f3109e980","t":"景申秋八首 三","a":"元稹","d":"唐","g":"短诗","p":["嗢嗢簷霤凝，丁丁窗雨繁。","枕傾筒簟滑，幔颭案燈翻。","喚魘兒難覺，吟詩婢苦煩。","強眠終不著，閑臥暗消魂。"],"s":"trad","f":"simp"},{"i":"cfc8e033-081e-4cea-bd80-fabc0ab807de","t":"景申秋八首 四","a":"元稹","d":"唐","g":"短诗","p":["瓶瀉高簷雨，窗來激箭風。","病憎燈火暗，寒覺薄幃空。","婢報樵蘇竭，妻愁院落通。","老夫慵計數，教想蔡城東。"],"s":"trad","f":"simp"},{"i":"380e9a6b-777e-4842-877b-50d2b0b91641","t":"景申秋八首 五","a":"元稹","d":"唐","g":"短诗","p":["風頭難著枕，病眼厭看書。","無酒銷長夜，回燈照小餘。","三元推廢王，九曜入乘除。","廊廟應多算，參差斡太虛。"],"s":"trad","f":"simp"},{"i":"008ea4f5-5596-4c20-a485-3195084c2686","t":"景申秋八首 六","a":"元稹","d":"唐","g":"短诗","p":["經雨籬落壞，入秋田地荒。","竹垂哀折節，蓮敗惜空房。","小片慈菇白，低叢柚子黃。","眼前撩亂輩，無不是同鄉。"],"s":"trad","f":"simp"},{"i":"edf23bd7-766e-4427-8b6a-39419e902624","t":"景申秋八首 七","a":"元稹","d":"唐","g":"短诗","p":["雨柳枝枝弱，風光片片斜。","蜻蜓憐曉露，蛺蝶戀秋花。","飢啅空籬雀，寒棲滿樹鴉。","荒涼池館內，不似有人家。"],"s":"trad","f":"simp"},{"i":"ab1dc725-a463-466a-bb8b-a70ff7eee1f9","t":"景申秋八首 八","a":"元稹","d":"唐","g":"短诗","p":["病苦十年後，連陰十日餘。","人方教作鼠，天豈遣爲魚。","鮫綻酆城劒，蟲凋鬼火書。","出聞泥濘盡，何地不摧車。"],"s":"mixed","f":"simp"},{"i":"c45a54fc-1535-4029-b28e-d8b230e01109","t":"遣行十首 一","a":"元稹","d":"唐","g":"短诗","p":["慘切風雨夕，沉吟離別情。","燕辭前日社，蟬是每年聲。","暗淚深相感，危心亦自驚。","不如元不識，俱作路人行。"],"s":"trad","f":"simp"},{"i":"172ba709-45f7-4228-933b-cad93131e78c","t":"遣行十首 二","a":"元稹","d":"唐","g":"短诗","p":["十五年前事，恓惶無限情。","病僮更借出，羸馬共馳聲。","射葉楊纔破，聞弓鴈已驚。","小年辛苦學，求得苦辛行。"],"s":"mixed","f":"simp"},{"i":"abea8f2d-9e51-46ad-b122-fdaf1c004361","t":"遣行十首 三","a":"元稹","d":"唐","g":"短诗","p":["徙倚簷宇下，思量去住情。","暗螢穿竹見，斜雨隔窗聲。","就枕回轉數，聞雞撩亂驚。","一家同草草，排比送君行。"],"s":"trad","f":"simp"},{"i":"88b9cf01-87da-4ac1-abb8-e4ddcc62e941","t":"遣行十首 四","a":"元稹","d":"唐","g":"短诗","p":["已愴朋交別，復懷兒女情。","相兄亦相舊，同病又同聲。","白髮年年剩，秋蓬處處驚。","不堪身漸老，頻送異鄉行。"],"s":"trad","f":"simp"},{"i":"26f55d2e-80e3-44c4-9269-f37ce0720105","t":"遣行十首 五","a":"元稹","d":"唐","g":"短诗","p":["塞上風雨思，城中兄弟情。","北隨鵷立位，南送鴈來聲。","遇適尤兼恨，聞書喜復驚。","唯應遙料得，知我伴君行。"],"s":"trad","f":"simp"},{"i":"2813ccde-f3e5-4eb9-b1e7-6fa273b30143","t":"遣行十首 六","a":"元稹","d":"唐","g":"短诗","p":["暮欲歌吹樂，暗衝泥水情。","稻花秋雨氣，江石夜灘聲。","犬吠穿籬出，鷗眠起水驚。","愁君明月夜，獨自入山行。"],"s":"trad","f":"simp"},{"i":"d89a661a-974b-4215-b831-beb3479417f1","t":"遣行十首 七","a":"元稹","d":"唐","g":"短诗","p":["七過襃城驛，回回各爲情。","八年身世夢，一種水風聲。","尋覓詩章在，思量歲月驚。","更悲西塞別，終夜繞池行。"],"s":"mixed","f":"simp"},{"i":"1890307f-3123-4b81-aed9-b32600e5f84f","t":"遣行十首 八","a":"元稹","d":"唐","g":"短诗","p":["襃縣驛前境，曲江池上情。","南堤衰柳意，西寺晚鐘聲。","雲水興方遠，風波心已驚。","可憐皆老大，不得自由行。"],"s":"trad","f":"simp"},{"i":"26d65a96-fa9b-4df4-bd9b-752927d7957e","t":"遣行十首 九","a":"元稹","d":"唐","g":"短诗","p":["見說巴風俗，都無漢性情。","猿聲蘆管調，羌笛竹雞聲。","迎候人應少，平安火莫驚。","每逢危棧處，須作貫魚行。"],"s":"trad","f":"simp"},{"i":"8ac61d90-5ce4-4999-90c9-a969abb9c978","t":"遣行十首 十","a":"元稹","d":"唐","g":"短诗","p":["聞道陰平郡，翛然古戍情。","橋兼麋鹿蹋，山應鼓鼙聲。","羌婦梳頭緊，蕃牛護尾驚。","憐君閑悶極，只傍白江行。"],"s":"trad","f":"simp"},{"i":"f5170856-6ead-4edf-b076-f7378a593959","t":"生春二十首 一","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生雲色中。","籠蔥閑著水，晻淡欲隨風。","度曉分霞態，餘光庇雪融。","晚來低漠漠，渾欲泥幽叢。"],"s":"trad","f":"simp"},{"i":"9a4ef431-d432-4382-8bcc-ba64a8352846","t":"生春二十首 二","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生漫雪中。","渾無到地片，唯逐入樓風。","屋上些些薄，池心旋旋融。","自悲銷散盡，誰假入蘭叢。"],"s":"trad","f":"simp"},{"i":"ee3cdbe7-145e-48ac-995a-77ca43f2d81e","t":"生春二十首 三","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生霽色中。","遠林橫返照，高樹亞東風。","水凍霜威庇，泥新地氣融。","漸知殘雪薄，杪近最憐叢。"],"s":"trad","f":"simp"},{"i":"c31dfe5e-f537-41fc-8e29-865ecf856220","t":"生春二十首 四","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生曙火中。","星圍分暗陌，煙氣滿晴風。","宮樹棲鵶亂，城樓帶雪融。","競排閶闔側，珂傘自相叢。"],"s":"trad","f":"simp"},{"i":"82b5aad9-2e43-4717-9aab-04da6afd869c","t":"生春二十首 五","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生曉禁中。","殿階龍斾日，漏閣寶箏風。","藥樹香煙重，天顏瑞氣融。","柳梅渾未覺，青紫已叢叢。"],"s":"trad","f":"simp"},{"i":"a8fc8df0-c6ac-4f7b-8476-8eb464b2c1a0","t":"生春二十首 六","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生江路中。","雨移臨浦市，晴候過湖風。","蘆筍錐猶短，凌澌玉漸融。","數宗船載足，商婦兩眉叢。"],"s":"trad","f":"simp"},{"i":"d62d3a70-1742-45fd-a08d-0be5ba5733f9","t":"生春二十首 七","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生野墅中。","病翁閑向日，征婦嬾成風。","斫筤天雖暖，穿區凍未融。","鞭牛縣門外，爭土蓋蠶叢。"],"s":"mixed","f":"simp"},{"i":"76206acd-40e7-41bc-a957-12a30e59dd7e","t":"生春二十首 八","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生冰岸中。","尚憐扶臘雪，漸覺受東風。","織女雲橋斷，波神玉貌融。","便成嗚咽去，流恨與蓮叢。"],"s":"trad","f":"simp"},{"i":"c746891e-189b-49e8-8459-459317031476","t":"生春二十首 九","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生柳眼中。","芽新纔綻日，茸短未含風。","綠誤眉心重，黃驚蠟淚融。","碧條殊未合，愁緒已先叢。"],"s":"mixed","f":"simp"},{"i":"fb1e142c-039f-4630-aa60-ea6c311ecbe0","t":"生春二十首 十","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生梅援中。","蘂排難犯雪，香乞擬來風。","隴迥羌聲怨，江遙客思融。","年年最相惱，緣未有諸叢。"],"s":"trad","f":"simp"},{"i":"14140e43-736f-4e66-94e3-77a7297124b7","t":"生春二十首 十一","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生鳥思中。","鵲巢移舊歲，䳒羽旋高風。","鴻鴈驚沙暖，鴛鴦愛水融。","最憐雙翡翠，飛入小梅叢。"],"s":"trad","f":"simp"},{"i":"9077071d-8e11-463f-b540-cd3e65bd328c","t":"生春二十首 十二","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生池榭中。","鏤瓊冰陷日，文縠水廻風。","柳愛和身動，梅愁合樹融。","草芽猶未出，挑得小萱叢。"],"s":"trad","f":"simp"},{"i":"62991599-6a5c-46c4-b197-4f07e39893ad","t":"生春二十首 十三","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生稚戲中。","亂騎殘爆竹，爭唾小旋風。","駡雨愁妨走，呵冰喜旋融。","女兒針線盡，偷學五辛叢。"],"s":"trad","f":"simp"},{"i":"4579fbab-df7b-4e90-ba1d-35bb35b4db41","t":"生春二十首 十四","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生人意中。","曉妝雖近火，晴戲漸憐風。","暗入心情嬾，先添酒思融。","預知花好惡，偏在最深叢。"],"s":"trad","f":"simp"},{"i":"55542850-61a0-4958-9f15-a65ca013f0b6","t":"生春二十首 十五","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生半睡中。","見燈如見霧，聞雨似聞風。","開眼猶殘夢，擡身便恐融。","却成雙翅蝶，還繞庳花叢。"],"s":"mixed","f":"simp"},{"i":"5c69fb38-d8a5-4dc1-a713-c17d084adcd0","t":"生春二十首 十六","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生曉鏡中。","手寒勻面粉，鬟動倚簾風。","宿霧梅心滴，朝光幕上融。","思牽梳洗嬾，空拔綠絲叢。"],"s":"mixed","f":"simp"},{"i":"7f22aec4-e20a-47f2-b637-6c81be69f2b6","t":"生春二十首 十七","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生綺戶中。","玉櫳穿細日，羅幔張輕風。","柳軟腰支嫩，梅香密氣融。","獨眠傍妬物，偷鏟合歡叢。"],"s":"trad","f":"simp"},{"i":"c6203fcb-4ab3-4af2-9b2a-4fa906d6cc94","t":"生春二十首 十八","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生老病中。","土膏蒸足腫，天暖癢頭風。","似覺肌膚展，潛知血氣融。","又添新一歲，衰白轉成叢。"],"s":"trad","f":"simp"},{"i":"f0a8c0eb-fbe9-478d-9e65-a6e9370a4b54","t":"生春二十首 十九","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生客思中。","旅魂驚北鴈，鄉信是東風。","縱有心灰動，無由鬢雪融。","未知開眼日，空繞未開叢。"],"s":"trad","f":"simp"},{"i":"3605d246-f841-4fc9-9af4-81e50af7ff21","t":"生春二十首 二十","a":"元稹","d":"唐","g":"短诗","p":["何處生春早，春生濛雨中。","裛塵微有氣，拂面細如風。","柳誤啼珠密，梅驚粉汗融。","滿空愁淡淡，應豫憶芳叢。"],"s":"trad","f":"simp"},{"i":"3ceee809-a65a-4eac-91d7-8b2859b4fa4e","t":"嘉陵水","a":"元稹","d":"唐","g":"短诗","p":["爾是無心水，東流有恨無。","我心無說處，也共爾何殊。"],"s":"trad","f":"simp"},{"i":"2070aa40-e05d-4f56-8cd5-81dc52349125","t":"漫天嶺贈僧","a":"元稹","d":"唐","g":"短诗","p":["五上兩漫天，因師懺業緣。","漫天無盡日，浮世有窮年。"],"s":"trad","f":"simp"},{"i":"3a5a05fc-b27d-4506-afb8-6a1e6aebeff0","t":"百牢關","a":"元稹","d":"唐","g":"短诗","p":["天上無窮路，生期七十間。","那堪九年內，五度百牢關。"],"s":"trad","f":"simp"},{"i":"8d86248a-1761-4971-bdf8-ee2ed0ed10a6","t":"二月十九日酬王十八全素","a":"元稹","d":"唐","g":"短诗","p":["君念世上川，嗟予老瘴天。","那堪十日內，又長白頭年。"],"s":"trad","f":"simp"},{"i":"90d7fd77-5000-4cfd-8d58-0d1f0c8c6006","t":"滎陽鄭公以稹寓居嚴茅有池塘之勝寄詩四首因有意獻","a":"元稹","d":"唐","g":"短诗","p":["激射分流闊，灣環此地多。","暫停隨梗浪，猶閱敗霜荷。","恨阻還江勢，思深到海波。","自傷才畎澮，其奈贈珠何。"],"s":"trad","f":"simp"}]