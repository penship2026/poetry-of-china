[{"i":"494d0e6c-6ba8-4675-8346-f2d3c2dc31e1","t":"遇薛明府謁聰上人","a":"王昌齡","d":"唐","g":"短诗","p":["欣逢柏梁故，共謁聰公禪。","石室無人到，繩牀見虎眠。","陰崖常抱雪，枯澗爲生泉。","出處雖雲異，同歡在法筵。"],"s":"mixed","f":"simp"},{"i":"10f0af8f-fc6d-4567-a0c4-99ae6c552a60","t":"謁焦鍊師","a":"王昌齡","d":"唐","g":"短诗","p":["中峯青苔壁，一點雲生時。","豈意石堂裏，得逢焦鍊師。","爐香淨琴案，松影閑瑤墀。","拜受長年藥，翩翻西海期。"],"s":"mixed","f":"simp"},{"i":"bbd3b9f0-53a9-468a-a6ec-96498624d8a9","t":"宿京江口期劉昚虛不至","a":"王昌齡","d":"唐","g":"短诗","p":["霜天起長望，殘月生海門。","風靜夜潮滿，城高寒氣昏。","故人何寂寞，久已乖清言。","明發不能寐，徒盈江上尊。"],"s":"trad","f":"simp"},{"i":"53464ad6-c788-4688-b38d-4634a524a2f6","t":"寒食即事","a":"王昌齡","d":"唐","g":"短诗","p":["晉陽寒食地，風俗舊來傳。","雨滅龍蛇火，春生鴻雁天。","泣多流水漲，歌發舞雲旋。","西見之推廟，空爲人所憐。"],"s":"mixed","f":"simp"},{"i":"ba7f3fd4-cf73-48c1-b6bc-2e26b66bf75a","t":"九日登高","a":"王昌齡","d":"唐","g":"短诗","p":["青山遠近帶皇州，霽景重陽上北樓。","雨歇亭臯仙菊潤，霜飛天苑御梨秋。","茱萸插鬢花宜壽，翡翠橫釵舞作愁。","謾說陶潛籬下醉，何曾得見此風流。"],"s":"trad","f":"simp"},{"i":"6f7e5cd4-f302-4cc4-b79d-2abb0b6e3088","t":"萬歲樓","a":"王昌齡","d":"唐","g":"短诗","p":["江上巍巍萬歲樓，不知經歷幾千秋。","年年喜見山長在，日日悲看水獨流。","猿狖何曾離暮嶺，鸕鶿空自泛寒洲。","誰堪登望雲烟裏，向晚茫茫發旅愁。"],"s":"mixed","f":"simp"},{"i":"607042a4-3dbc-46f3-8491-91baf1566991","t":"夏月花萼樓酺宴應制","a":"王昌齡","d":"唐","g":"古体","p":["土德三元正，堯心萬國同。","汾陰備冬禮，長樂應和風。","賜慶垂天澤，流歡舊渚宮。","樓臺生海上，簫鼓出天中。","霧曉筵初接，宵長曲未終。","雨隨青幕合，月照舞羅空。","玉陛分朝列，文章發聖聰。","愚臣忝書賦，歌詠頌絲桐。"],"s":"trad","f":"simp"},{"i":"c8280b48-5458-437b-908b-4cbf50cd982b","t":"送歐陽會稽之任","a":"王昌齡","d":"唐","g":"古体","p":["懷祿貴心賞，東流山水長。","官移會稽郡，地邇上虞鄉。","緩帶屏紛雜，漁舟臨訟堂。","逶迤迴谿趣，猿嘯飛鳥行。","萬室霽朝雨，千峰迎夕陽。","輝輝遠洲暎，曖曖澄湖光。","白髮有高士，青春期上皇。","應須枉車歇，爲我訪荷裳。"],"s":"mixed","f":"simp"},{"i":"aebc05f0-516c-4909-83c3-f9e51a2a1a6c","t":"同王維集青龍寺曇壁上人兄院五韻","a":"王昌齡","d":"唐","g":"古体","p":["本來清淨所，竹樹引幽陰。","簷外含山翠，人間出世心。","圓通無有象，聖境不能侵。","真是吾兄法，何妨友弟深。","天香自然會，靈異識鐘音。"],"s":"trad","f":"simp"},{"i":"c18e5b00-f843-4768-a1d7-a12394d603ea","t":"東谿翫月","a":"王昌齡","d":"唐","g":"古体","p":["月從斷山口，遙吐柴門端。","萬木分空霽，流陰中夜攢。","光連虛象白，氣與風露寒。","谷靜秋泉響，巖深青靄殘。","澄清入幽夢，破影抱空巒。","恍惚琴窗裏，松谿曉思難。"],"s":"mixed","f":"simp"},{"i":"f8878861-e55c-453c-ac79-3f728e9d0842","t":"朝來曲","a":"王昌齡","d":"唐","g":"短诗","p":["月昃鳴珂動，花連繡戶春。","盤龍玉臺鏡，唯待畫眉人。"],"s":"trad","f":"simp"},{"i":"33a97617-dcc4-4a08-81d6-24063abfd0e8","t":"從軍行","a":"王昌齡","d":"唐","g":"短诗","p":["大將軍出戰，白日暗榆關。","三面黃金甲，單于破膽還。"],"s":"mixed","f":"simp"},{"i":"351313ad-b817-4198-93c5-ef305c824210","t":"答武陵田太守","a":"王昌齡","d":"唐","g":"短诗","p":["仗劒行千里，微軀感一言。","曾爲大梁客，不負信陵恩。"],"s":"mixed","f":"simp"},{"i":"efa00292-744f-487f-8940-e86c65c23a3f","t":"題灞池二首 一","a":"王昌齡","d":"唐","g":"短诗","p":["腰鎌欲何之，東園刈秋韭。","世事不復論，悲歌和樵叟。"],"s":"trad","f":"simp"},{"i":"850a9520-0620-445c-98e9-ed842822cf9e","t":"題灞池二首 二","a":"王昌齡","d":"唐","g":"短诗","p":["開門望長川，薄暮見漁者。","借問白頭翁，垂綸幾年也。"],"s":"trad","f":"simp"},{"i":"f7d3f6a6-75be-486c-96ae-4b9590b35695","t":"題僧房","a":"王昌齡","d":"唐","g":"短诗","p":["椶櫚花滿院，苔蘚入閑房。","彼此名言絕，空中聞異香。"],"s":"trad","f":"simp"},{"i":"beff880b-695c-4643-8115-250be332ddc0","t":"擊磬老人","a":"王昌齡","d":"唐","g":"短诗","p":["雙峰褐衣久，一磬白眉長。","誰識野人意，徒看春草芳。"],"s":"trad","f":"simp"},{"i":"4529cb2e-4db1-4a15-a062-1f4d83e45989","t":"送胡大","a":"王昌齡","d":"唐","g":"短诗","p":["荆門不堪別，況乃瀟湘秋。","何處遙望君，江邊明月樓。"],"s":"mixed","f":"simp"},{"i":"d878a2ff-a8ba-498f-a325-6cc5d54ff4ab","t":"送郭司倉","a":"王昌齡","d":"唐","g":"短诗","p":["暎門淮水綠，留騎主人心。","明月隨良掾，春潮夜夜深。"],"s":"trad","f":"simp"},{"i":"e49dac06-6bd7-4be3-bee9-dfe76bfb648e","t":"送李十五","a":"王昌齡","d":"唐","g":"短诗","p":["怨別秦楚深，江中秋雲起。","天長杳無隔，月影在寒水。"],"s":"trad","f":"simp"},{"i":"c1275df2-d211-448e-88d6-554a7dccc11e","t":"送張四","a":"王昌齡","d":"唐","g":"短诗","p":["楓林已愁暮，楚水復堪悲。","別後冷山月，清猿無斷時。"],"s":"trad","f":"simp"},{"i":"7382129c-d8e3-407e-9a23-d9d22738aada","t":"武陵田太守席送司馬盧谿","a":"王昌齡","d":"唐","g":"短诗","p":["諸侯分楚郡，飲餞五谿春。","山水清暉遠，俱憐一逐臣。"],"s":"trad","f":"simp"},{"i":"0fa83a19-32a8-4404-8bd3-27716ab651c6","t":"送譚八之桂林","a":"王昌齡","d":"唐","g":"短诗","p":["客心仍在楚，江館復臨湘。","別意猿鳥外，天寒桂水長。"],"s":"trad","f":"simp"},{"i":"5dc35e8f-eb85-4bfb-9426-f8c53cb97408","t":"送劉十五之郡","a":"王昌齡","d":"唐","g":"短诗","p":["平明江霧寒，客馬江上發。","扁舟事洛陽，窅窅含楚月。"],"s":"trad","f":"simp"},{"i":"0ac86eeb-6fbe-4fea-bbb2-f2cabb97d68e","t":"從軍行七首 一","a":"王昌齡","d":"唐","g":"短诗","p":["烽火城西百尺樓，黃昏獨上海風秋。","更吹羌笛關山月，無那金閨萬里愁。"],"s":"mixed","f":"simp"},{"i":"7b657130-529b-4128-b4bb-279af91baed1","t":"從軍行七首 二","a":"王昌齡","d":"唐","g":"短诗","p":["琵琶起舞換新聲，總是關山舊別情。","撩亂邊愁聽不盡，高高秋月照長城。"],"s":"trad","f":"simp"},{"i":"80f4b4f0-96e5-46a9-a634-f152b9f390d8","t":"從軍行七首 三","a":"王昌齡","d":"唐","g":"短诗","p":["關城榆葉早疎黃，日暮雲沙古戰場。","表請回軍掩塵骨，莫教兵士哭龍荒。"],"s":"trad","f":"simp"},{"i":"fb92a089-72f0-44c2-93f8-060124eaa0a9","t":"從軍行七首 四","a":"王昌齡","d":"唐","g":"短诗","p":["青海長雲暗雪山，孤城遙望玉門關。","黃沙百戰穿金甲，不破樓蘭終不還。"],"s":"trad","f":"simp"},{"i":"924151b2-fb99-456c-8788-a3265159792e","t":"從軍行七首 五","a":"王昌齡","d":"唐","g":"短诗","p":["大漠風塵日色昏，紅旗半捲出轅門。","前軍夜戰洮河北，已報生擒吐谷渾。"],"s":"trad","f":"simp"},{"i":"e19fbd6b-a7de-46b8-be86-125c3941777f","t":"從軍行七首 六","a":"王昌齡","d":"唐","g":"短诗","p":["胡瓶落膊紫薄汗，碎葉城西秋月團。","明敕星馳封寶劒，辭君一夜取樓蘭。"],"s":"trad","f":"simp"},{"i":"ca7390ce-3f21-4291-a03b-de83e46060f9","t":"從軍行七首 七","a":"王昌齡","d":"唐","g":"短诗","p":["玉門山嶂幾千重，山北山南總是烽。","人依遠戍須看火，馬踏深山不見蹤。"],"s":"trad","f":"simp"},{"i":"25e93094-40d5-45ee-845d-b15dc6a5c1c3","t":"出塞二首 二","a":"王昌齡","d":"唐","g":"短诗","p":["騮馬新跨白玉鞍，戰罷沙場月色寒。","城頭鐵鼓聲猶振，匣裏金刀血未乾。"],"s":"mixed","f":"simp"},{"i":"84f40b5c-4c5b-43c4-822a-d2b92c7b41e1","t":"采蓮曲二首 一","a":"王昌齡","d":"唐","g":"短诗","p":["吳姬越豔楚王妃，爭弄蓮舟水濕衣。","來時浦口花迎入，采罷江頭月送歸。"],"s":"mixed","f":"simp"},{"i":"5383487f-7c1f-43ee-9cf9-c1f44a4a0e45","t":"采蓮曲二首 二","a":"王昌齡","d":"唐","g":"短诗","p":["荷葉羅裙一色裁，芙蓉向臉兩邊開。","亂入池中看不見，聞歌始覺有人來。"],"s":"mixed","f":"simp"},{"i":"1e1e21da-a20a-4c12-9c5d-5ae05d2df153","t":"殿前曲二首 一","a":"王昌齡","d":"唐","g":"短诗","p":["貴人妝梳殿前催，香風吹入殿後來。","仗引笙歌大宛馬，白蓮花發照池臺。"],"s":"trad","f":"simp"},{"i":"5432f819-f445-4cb3-bf9a-e6692bbd033a","t":"殿前曲二首 二","a":"王昌齡","d":"唐","g":"短诗","p":["胡部笙歌西殿頭，梨園弟子和涼州。","新聲一段高樓月，聖主千秋樂未休。"],"s":"trad","f":"simp"},{"i":"3b5f5a9f-754b-4dda-8b18-bac4598eb0fe","t":"西宮春怨","a":"王昌齡","d":"唐","g":"短诗","p":["西宮夜靜百花香，欲捲珠簾春恨長。","斜抱雲和深見月，朦朧樹色隱昭陽。"],"s":"trad","f":"simp"},{"i":"786a91cb-4e20-4cdb-951e-70abfcf1af85","t":"西宮秋怨","a":"王昌齡","d":"唐","g":"短诗","p":["芙蓉不及美人妝，水殿風來珠翠香。","誰分含啼掩秋扇，空懸明月待君王。"],"s":"trad","f":"simp"},{"i":"913bf762-71a5-46bf-88d9-af85385191c6","t":"長信秋詞五首 一","a":"王昌齡","d":"唐","g":"短诗","p":["金井梧桐秋葉黃，珠簾不捲夜來霜。","熏籠玉枕無顏色，臥聽南宮清漏長。"],"s":"mixed","f":"simp"},{"i":"620823bf-6fe5-4db1-aef1-ea1e91b97397","t":"長信秋詞五首 二","a":"王昌齡","d":"唐","g":"短诗","p":["高殿秋砧響夜闌，霜深猶憶御衣寒。","銀燈青瑣裁縫歇，還向金城明主看。"],"s":"trad","f":"simp"},{"i":"88ffb109-8e3f-4175-9352-8e02c28a4d9f","t":"長信秋詞五首 三","a":"王昌齡","d":"唐","g":"短诗","p":["奉帚平明金殿開，且將團扇暫裴回。","玉顏不及寒鴉色，猶帶[昭]陽日影來。"],"s":"trad","f":"simp"},{"i":"e2c2c33b-fd1d-4aa2-9558-2b55137adec4","t":"長信秋詞五首 四","a":"王昌齡","d":"唐","g":"短诗","p":["真成薄命久尋思，夢見君王覺後疑。","火照西宮知夜飲，分明複道奉恩時。"],"s":"trad","f":"simp"},{"i":"058b2020-c2cd-44fb-9657-358a5468ac2d","t":"長信秋詞五首 五","a":"王昌齡","d":"唐","g":"短诗","p":["長信宮中秋月明，昭陽殿下擣衣聲。","白露堂中細草跡，紅羅帳裏不勝情。"],"s":"mixed","f":"simp"},{"i":"3af49c81-e4be-4724-9b7b-1b41966e9d69","t":"青樓曲二首 一","a":"王昌齡","d":"唐","g":"短诗","p":["白馬金鞍從武皇，旌旗十萬宿長楊。","樓頭小婦鳴箏坐，遙見飛塵入建章。"],"s":"trad","f":"simp"},{"i":"d12908bf-0ec6-4137-9ea8-fce8383fda4a","t":"青樓曲二首 二","a":"王昌齡","d":"唐","g":"短诗","p":["馳道楊花滿御溝，紅妝縵綰上青樓。","金章紫綬千餘騎，夫壻朝回初拜侯。"],"s":"trad","f":"simp"},{"i":"1fea4e9e-800a-4d1d-bad2-2a4019ae787b","t":"青樓怨","a":"王昌齡","d":"唐","g":"短诗","p":["香幃風動花入樓，高調鳴箏緩夜愁。","腸斷關山不解說，依依殘月下簾鉤。"],"s":"trad","f":"simp"},{"i":"8209ce8e-92c6-4123-b130-1186ed714dfa","t":"浣紗女","a":"王昌齡","d":"唐","g":"短诗","p":["錢塘江邊是誰家，江上女兒全勝花。","吳王在時不得出，今日公然來浣紗。"],"s":"trad","f":"simp"},{"i":"3286b733-02a6-4c21-951d-c873830a08b8","t":"甘泉歌","a":"王昌齡","d":"唐","g":"短诗","p":["乘輿執玉已登壇，細草霑衣春殿寒。","昨夜雲生拜初月，萬年甘露水晶盤。"],"s":"trad","f":"simp"},{"i":"cb12783c-1c1b-44c4-82ce-7cf9e3096a9e","t":"蕭駙馬宅花燭","a":"王昌齡","d":"唐","g":"短诗","p":["青鸞飛入合歡宮，紫鳳銜花出禁中。","可憐今夜千門裏，銀漢星回一道通。"],"s":"mixed","f":"simp"},{"i":"92f55a8c-7778-4802-9991-d76b0e4fdb48","t":"觀獵","a":"王昌齡","d":"唐","g":"短诗","p":["角鷹初下秋草稀，鐵驄拋鞚去如飛。","少年獵得平原兔，馬後橫捎意氣歸。"],"s":"trad","f":"simp"},{"i":"033dcca7-d4de-479e-b804-2cadf83a1ff6","t":"寄穆侍御出幽州","a":"王昌齡","d":"唐","g":"短诗","p":["一從恩譴度瀟湘，塞北江南萬里長。","莫道薊門書信少，鴈飛猶得到衡陽。"],"s":"mixed","f":"simp"},{"i":"86637a29-5545-453f-9bbf-fc2a0a83c6d1","t":"寄陶副使","a":"王昌齡","d":"唐","g":"短诗","p":["聞道將軍破海門，如何遠謫渡湘沅。","春來明主封西嶽，自有還君紫綬恩。"],"s":"trad","f":"simp"},{"i":"26f3af10-4553-416c-9d86-c110264a16dc","t":"至南陵答皇甫岳","a":"王昌齡","d":"唐","g":"短诗","p":["與君同病復漂淪，昨夜宣城別故人。","明主恩深非歲久，長江還共五谿濱。"],"s":"mixed","f":"simp"},{"i":"d60591c0-2c20-48b3-aa03-8f40188cb455","t":"西江寄越弟","a":"王昌齡","d":"唐","g":"短诗","p":["南浦逢君嶺外還，沅谿更遠洞庭山。","堯時恩澤如春雨，夢裏相逢同入關。"],"s":"mixed","f":"simp"},{"i":"94054365-0488-4baa-ad3c-ff7fffaebf1d","t":"李四倉曹宅夜飲","a":"王昌齡","d":"唐","g":"短诗","p":["霜天留後故情歡，銀燭金爐夜不寒。","欲問吳江別來意，青山明月夢中看。"],"s":"trad","f":"simp"},{"i":"7a64addc-bcd1-4e2a-91ff-4f060a803ecb","t":"宴春源","a":"王昌齡","d":"唐","g":"短诗","p":["源向春城花幾重，江明深翠引諸峯。","與君醉失松溪路，山館寥寥傳暝鐘。"],"s":"mixed","f":"simp"},{"i":"7646be95-fa97-4cc3-b7e2-3ae09962288d","t":"龍標野宴","a":"王昌齡","d":"唐","g":"短诗","p":["沅溪夏晚足涼風，春酒相攜就竹叢。","莫道絃歌愁遠謫，青山明月不曾空。"],"s":"trad","f":"simp"},{"i":"a52785c6-d98a-45ed-a53d-60043e8b5de7","t":"聽流人水調子","a":"王昌齡","d":"唐","g":"短诗","p":["孤舟微月對楓林，分付鳴箏與客心。","嶺色千重萬重雨，斷絃收與淚痕深。"],"s":"trad","f":"simp"},{"i":"d4cf1877-336f-42e8-be4d-5164d41e698a","t":"梁苑","a":"王昌齡","d":"唐","g":"短诗","p":["梁園秋竹古時烟，城外風悲欲暮天。","萬乘旌旗何處在？平臺賓客有誰憐。"],"s":"mixed","f":"simp"},{"i":"ddb632ea-fedf-4c02-8eec-770487b01d18","t":"武陵龍興觀黃道士房問易因題","a":"王昌齡","d":"唐","g":"短诗","p":["齋心問易太陽宮，八卦真形一氣中。","仙老言餘鶴飛去，玉清壇上雨濛濛。"],"s":"trad","f":"simp"},{"i":"8e03215e-a131-48cf-9e89-3544a6cdc967","t":"送魏二","a":"王昌齡","d":"唐","g":"短诗","p":["醉別江樓橘柚香，江風引雨入舟涼。","憶君遙在瀟湘月，愁聽清猿夢裏長。"],"s":"mixed","f":"simp"},{"i":"fe05e0de-1a35-4213-accd-f7e7b8f0938e","t":"別李浦之京","a":"王昌齡","d":"唐","g":"短诗","p":["故園今在灞陵西，江畔逢君醉不迷。","小弟鄰莊尚漁獵，一封書寄數行啼。"],"s":"trad","f":"simp"},{"i":"c6a15f09-69eb-40aa-b596-8fe565c97980","t":"送狄宗亨","a":"王昌齡","d":"唐","g":"短诗","p":["秋在水清山暮蟬，洛陽樹色鳴臯烟。","送君歸去愁不盡，又惜空度涼風天。"],"s":"mixed","f":"simp"},{"i":"e793ba8b-96b3-4124-964a-e29324b00d4b","t":"送薛大赴安陸","a":"王昌齡","d":"唐","g":"短诗","p":["津頭雲雨暗湘山，遷客離憂楚地顏。","遙送扁舟安陸郡，天邊何處穆陵關。"],"s":"trad","f":"simp"},{"i":"31d3f836-d70b-48d7-875d-9c3aa4bcada4","t":"芙蓉樓送辛漸二首 二","a":"王昌齡","d":"唐","g":"短诗","p":["丹陽城南秋海陰，丹陽城北楚雲深。","高樓送客不能醉，寂寂寒江明月心。"],"s":"trad","f":"simp"},{"i":"7f24db79-b073-4320-99ef-04d7c8098ec3","t":"重別李評事","a":"王昌齡","d":"唐","g":"短诗","p":["莫道秋江離別難，舟船明日是長安。","吳姬緩舞留君醉，隨意青楓白露寒。"],"s":"trad","f":"simp"},{"i":"412f7f57-4b3c-474d-822c-dc07d62cd331","t":"別陶副使歸南海","a":"王昌齡","d":"唐","g":"短诗","p":["南越歸人夢海樓，廣陵新月海亭秋。","寶刀留贈長相憶，當取戈船萬戶侯。"],"s":"trad","f":"simp"},{"i":"d2acbe16-2b35-4ed8-b78c-17b46cb7f29f","t":"送人歸江夏","a":"王昌齡","d":"唐","g":"短诗","p":["寒江綠水楚雲深，莫道離憂遷遠心。","曉夕雙帆歸鄂渚，愁將孤月夢中尋。"],"s":"trad","f":"simp"},{"i":"46b46545-ecff-4c12-9bc7-eb965242a575","t":"送李五","a":"王昌齡","d":"唐","g":"短诗","p":["玉盌金罍傾送君，江西日入起黃雲。","扁舟乘月暫來去，誰道滄浪吳楚分。"],"s":"trad","f":"simp"},{"i":"2a01bf09-a6fb-492e-a45c-218178f36768","t":"送十五舅","a":"王昌齡","d":"唐","g":"短诗","p":["深林秋水近日空，歸棹演漾清陰中。","夕浦離觴意何已，草根寒露悲鳴蟲。"],"s":"trad","f":"simp"},{"i":"feebecab-b17a-4a26-b13e-9d600b007ae3","t":"留別郭八","a":"王昌齡","d":"唐","g":"短诗","p":["長亭駐馬未能前，井邑蒼茫含暮煙。","醉別何須更惆悵，回頭不語但垂鞭。"],"s":"trad","f":"simp"},{"i":"cbdf6e69-b4c1-477f-92f7-d529b4f0d54e","t":"送竇七","a":"王昌齡","d":"唐","g":"短诗","p":["清江月色傍林秋，波上熒熒望一舟。","鄂渚輕帆須早發，江邊明月爲君留。"],"s":"mixed","f":"simp"},{"i":"4aeb5456-eac8-4a62-abf0-ec9114edeb02","t":"巴陵送李十二","a":"王昌齡","d":"唐","g":"短诗","p":["搖曳巴陵洲渚分，清江傳語便風聞。","山長不見秋城色，日暮蒹葭空水雲。"],"s":"trad","f":"simp"},{"i":"08769eec-7058-49ba-952d-e72368eadce5","t":"送裴圖南","a":"王昌齡","d":"唐","g":"短诗","p":["黃河渡頭歸問津，離家幾日茱萸新。","漫道閨中飛破鏡，猶看陌上別行人。"],"s":"trad","f":"simp"},{"i":"06fbf086-4bf5-46ce-aa6e-4ba5f8c8b4b1","t":"留別司馬太守","a":"王昌齡","d":"唐","g":"短诗","p":["辰陽太守念王孫，遠謫沅谿何可論。","黃鶴青雲當一舉，明珠吐著抱君恩。"],"s":"trad","f":"simp"},{"i":"12c81418-a970-476b-a48d-698a7bf84a58","t":"盧溪主人","a":"王昌齡","d":"唐","g":"短诗","p":["武陵溪口駐扁舟，溪水隨君向北流。","行到荆門上三峽，莫將孤月對猿愁。"],"s":"mixed","f":"simp"},{"i":"ceb0c2f7-ffaf-4fee-a995-10cda09ea1e1","t":"送程六","a":"王昌齡","d":"唐","g":"短诗","p":["冬夜傷離在五溪，青魚雪落鱠橙虀。","武岡前路看斜月，片片舟中雲向西。"],"s":"mixed","f":"simp"},{"i":"e6b1b4f5-49c9-47d5-9e05-ebd77e98bdc8","t":"送朱越","a":"王昌齡","d":"唐","g":"短诗","p":["遠別舟中蔣山暮，君行舉首燕城路。","薊門秋月隱黃雲，期向金陵醉江樹。"],"s":"trad","f":"simp"},{"i":"b3d5c955-93ef-4b75-a83b-0d23b9e959bd","t":"別辛漸","a":"王昌齡","d":"唐","g":"短诗","p":["別館蕭條風雨寒，扁舟月色渡江看。","酒酣不識關西道，却望春江雲尚殘。"],"s":"mixed","f":"simp"},{"i":"789c0699-8187-42a6-b910-fb9b999d75bd","t":"送柴侍御","a":"王昌齡","d":"唐","g":"短诗","p":["流水通波接武岡，送君不覺有離傷。","青山一道同雲雨，眀月何曽是兩鄉。"],"s":"trad","f":"simp"},{"i":"f4edca98-5fd3-4ddd-9702-aa7d2f367947","t":"送萬大歸長沙","a":"王昌齡","d":"唐","g":"短诗","p":["桂陽秋水長沙縣，楚竹離聲爲君變。","青山隱隱孤舟微，白鶴雙飛忽相見。"],"s":"mixed","f":"simp"},{"i":"27e987a5-b66b-4738-baf5-68e205f3c08e","t":"送吳十九往沅陵","a":"王昌齡","d":"唐","g":"短诗","p":["沅江流水到辰陽，谿口逢君驛路長。","遠謫誰知望雷雨，明年春水共還鄉。"],"s":"trad","f":"simp"},{"i":"70205727-903d-4bde-8c28-07e9bf09d538","t":"別皇甫五","a":"王昌齡","d":"唐","g":"短诗","p":["漵浦潭陽隔楚山，離尊不用起愁顏。","明祠靈響期昭應，天澤俱從此路還。"],"s":"trad","f":"simp"},{"i":"82f43aa2-768a-47e3-a45f-acbb1bab2f6a","t":"送崔參軍往龍溪","a":"王昌齡","d":"唐","g":"短诗","p":["龍溪只在龍標上，秋月孤山兩相向。","譴謫離心是丈夫，鴻恩共侍春江漲。"],"s":"trad","f":"simp"},{"i":"6138239c-63b4-4622-a5ca-279a8031be4b","t":"送鄭判官","a":"王昌齡","d":"唐","g":"短诗","p":["東楚吳山驛樹微，軺車銜命奉恩輝。","英僚攜出新豐酒，半道遙看驄馬歸。"],"s":"trad","f":"simp"},{"i":"5e0db2d1-597f-4634-a8e8-bd1c907824ba","t":"送姚司法歸吳","a":"王昌齡","d":"唐","g":"短诗","p":["吳掾留觴楚郡心，洞庭秋雨海門陰。","但令意遠扁舟近，不道滄江百丈深。"],"s":"trad","f":"simp"},{"i":"f893ef56-fa7c-49ef-a8aa-fa2cb9b3fc52","t":"送高三之桂林","a":"王昌齡","d":"唐","g":"短诗","p":["留君夜飲對瀟湘，從此歸舟客夢長。","嶺上梅花侵雪暗，歸時還拂桂花香。"],"s":"trad","f":"simp"},{"i":"159c125a-24c6-4756-bb38-8f6a893ae608","t":"旅望","a":"王昌齡","d":"唐","g":"短诗","p":["白花原頭望京師，黃河水流無盡時。","窮秋曠野行人絕，馬首東來知是誰。"],"s":"trad","f":"simp"},{"i":"6298051e-adce-4496-809f-634dcf2a1125","t":"題朱鍊師山房","a":"王昌齡","d":"唐","g":"短诗","p":["叩齒焚香出世塵，齋壇鳴磬步虛人。","百花仙醞能留客，一飯胡麻度幾春。"],"s":"trad","f":"simp"},{"i":"4b0c70cb-8ae5-4ffe-867e-3835b1352408","t":"武陵開元觀黃鍊師院三首 一","a":"王昌齡","d":"唐","g":"短诗","p":["松間白髮黃尊師，童子燒香禹步時。","欲訪桃源入溪路，忽聞雞犬使人疑。"],"s":"trad","f":"simp"},{"i":"31370c6a-1ac6-4416-884d-32eddb837892","t":"武陵開元觀黃鍊師院三首 二","a":"王昌齡","d":"唐","g":"短诗","p":["先賢盛說桃花源，塵忝何堪武陵郡。","聞道秦時避地人，至今不與人通問。"],"s":"trad","f":"simp"},{"i":"74430fb7-b24d-4751-9904-4fa4a574788a","t":"武陵開元觀黃鍊師院三首 三","a":"王昌齡","d":"唐","g":"短诗","p":["山觀空虛清靜門，從官役吏擾塵喧。","暫因問俗到真境，便欲投誠依道源。"],"s":"trad","f":"simp"},{"i":"0305b271-93d4-435e-ab64-43cb17ccd5e4","t":"河上老人歌","a":"王昌齡","d":"唐","g":"短诗","p":["河上老人坐古槎，合丹只用青蓮花。","至今八十如四十，口道滄溟是我家。"],"s":"trad","f":"simp"},{"i":"3195d94e-02ec-4277-8cd9-6afff518cb82","t":"春怨","a":"王昌齡","d":"唐","g":"短诗","p":["音書杜絕白狼西，桃李無顏黃鳥啼。","寒雁春深歸去盡，出門腸斷草萋萋。"],"s":"trad","f":"simp"},{"i":"3e4a693d-49d2-4791-bb34-f49ddd202d49","t":"句","a":"王昌齡","d":"唐","g":"古体","p":["朝薦抱良策，獨倚江城樓。","昨從金陵邑，遠謫沅溪濱。","娟魄已三孕。","駕幸溫泉日，嚴霜子月初。","長亭酒未醒，千里風動地。","蒼荻寒滄江，石頭岸邊飲。","天仗森森練雪凝，身騎鐵驄自臂鷹。"],"s":"trad","f":"simp"},{"i":"5c83eace-eff6-404e-9186-bb5407c4a0bb","t":"送陸擢","a":"常建","d":"唐","g":"短诗","p":["聖代多才俊，陸生何考槃。","南山高松樹，不合空摧殘。","九月湖上別，北風秋雨寒。","殷勤歎孤鳳，早食金琅玕。"],"s":"trad","f":"simp"},{"i":"e5db693e-8b72-43e3-aefa-2d56bf112d61","t":"送李十一尉臨溪","a":"常建","d":"唐","g":"短诗","p":["泠泠花下琴，君唱渡江吟。","天際一帆影，預懸離別心。","以言神仙尉，因致瑤華音。","回軫撫商調，越溪澄碧林。"],"s":"trad","f":"simp"},{"i":"0c965b46-4730-40b0-9b01-f117a107cfb7","t":"江上琴興","a":"常建","d":"唐","g":"短诗","p":["江上調玉琴，一弦清一心。","泠泠七弦遍，萬木澄幽陰。","能使江月白，又令江水深。","始知梧桐枝，可以徽黃金。"],"s":"mixed","f":"simp"},{"i":"1ce9062d-4aed-4cb1-9dd7-ad3c723be7c7","t":"湖中晚霽","a":"常建","d":"唐","g":"古体","p":["湖廣舟自輕，江天欲澄霽。","是時清楚望，氣色猶霾曀。","踟躕金霞白，波上日初麗。","煙虹落鏡中，樹木生天際。","杳杳涯欲辨，蒙蒙雲復閉。","言乘星漢明，又覩寰瀛勢。","微興從此愜，悠然不知歲。","試歌滄浪清，遂覺乾坤細。","豈念客衣薄，將期永投袂。","遲回漁父間，一鴈聲嘹唳。"],"s":"mixed","f":"simp"},{"i":"0cd46838-b0ae-4a8a-bc10-4366c585f4a1","t":"送楚十少府","a":"常建","d":"唐","g":"古体","p":["微風吹霜氣，寒影明前除。","落日未能別，蕭蕭林木虛。","愁煙閉千里，仙尉其何如。","因送別鶴操，贈之雙鯉魚。","鯉魚在金盤，別鶴哀有餘。","心事則如此，請君開素書。"],"s":"trad","f":"simp"}]