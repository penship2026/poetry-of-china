[{"i":"247d6876-899a-4ee0-99e0-37fbcb40d56a","t":"荅裴令公雪中訝白二十二與諸公不相訪之什","a":"劉禹錫","d":"唐","g":"短诗","p":["玉樹瓊樓滿眼新，的知開閤待諸賓。","遲遲未去非無意，擬作梁園坐右人。"],"s":"trad","f":"simp"},{"i":"9ff2f610-cf75-436c-9a08-a5d05aa0514d","t":"吳方之見示聽江西故吏朱幼恭歌三篇頗有懷故林之想吟諷不足因而和之","a":"劉禹錫","d":"唐","g":"短诗","p":["侯家故吏歌聲發，逸處能高怨處低。","今歲洛中無雨雪，眼前風景是江西。"],"s":"trad","f":"simp"},{"i":"e33e6019-5068-4775-a82c-93017558495b","t":"裴令公見示誚樂天寄奴買馬絕句斐言仰和且戲樂天","a":"劉禹錫","d":"唐","g":"短诗","p":["常奴安得似方回，爭望追風絕足來。","若把翠娥酬騄耳，始知天下有奇才。"],"s":"trad","f":"simp"},{"i":"07201c67-20e9-4f48-b984-270a576a9fca","t":"酬思黯代書見戲","a":"劉禹錫","d":"唐","g":"短诗","p":["官冷如漿病滿身，凌寒不易過天津。","少年留取多情興，請待花時作主人。"],"s":"trad","f":"simp"},{"i":"bdbac9b7-a27a-42c8-bedb-058acd358421","t":"荅張侍御賈喜再登科後自洛赴上都贈別","a":"劉禹錫","d":"唐","g":"短诗","p":["又被時人寫姓名，春風引路入京城。","知君憶得前身事，分付鶯花與後生。"],"s":"trad","f":"simp"},{"i":"087353c5-04ce-4b56-8ff5-53cb393316d7","t":"赴連州途經洛陽諸公置酒相送張員外賈以詩見贈率爾酬之","a":"劉禹錫","d":"唐","g":"短诗","p":["謫在三湘最遠州，邊鴻不到水南流。","如今暫寄罇前笑，明日辭君步步愁。"],"s":"trad","f":"simp"},{"i":"f36a6e25-4b16-4a1b-b233-bdb1e6e7d0c4","t":"贈元九侍御文石枕以詩獎之","a":"劉禹錫","d":"唐","g":"短诗","p":["文章似錦氣如虹，宜薦華簪綠殿中。","縱使涼飆生旦夕，猶堪拂拭愈頭風。"],"s":"trad","f":"simp"},{"i":"cc66bd2e-bfd3-4f97-b7c4-1f4b2714a5ea","t":"酬元九院長自江陵見寄","a":"劉禹錫","d":"唐","g":"短诗","p":["無事尋花至仙境，等閑栽樹比封君。","金門通籍真多士，黃紙除書每日聞。"],"s":"trad","f":"simp"},{"i":"2beb9853-953e-41d8-bd7e-25063ff7a2dc","t":"酬楊侍郎憑見寄","a":"劉禹錫","d":"唐","g":"短诗","p":["翔鸞闕底謝皇恩，纓上滄浪舊水痕。","疎傅揮金忽相憶，遠擎長句與招魂。"],"s":"trad","f":"simp"},{"i":"ae51f029-6b26-429a-8b37-002b0326b07d","t":"酬馬大夫登洭口戍見寄","a":"劉禹錫","d":"唐","g":"短诗","p":["新辭將印拂朝纓，臨水登山四體輕。","猶念天涯未歸客，瘴雲深處守孤城。"],"s":"trad","f":"simp"},{"i":"606bdb0c-ec97-43a2-b996-b753278b7306","t":"荅楊八敬之絕句","a":"劉禹錫","d":"唐","g":"短诗","p":["飽霜孤竹聲偏切，帶火焦桐韻本悲。","今日知音一留聽，是君心事不平時。"],"s":"trad","f":"simp"},{"i":"580191cd-73ba-4ba6-bf15-1b3c9ac7a667","t":"重寄表臣二首 一","a":"劉禹錫","d":"唐","g":"短诗","p":["對酒臨流奈別何，君今已醉我蹉跎。","分明記取星星鬢，他日相逢應更多。"],"s":"trad","f":"simp"},{"i":"b61b2193-eb61-4161-ad99-2d0d0539fa83","t":"重寄表臣二首 二","a":"劉禹錫","d":"唐","g":"短诗","p":["世間人事有何窮，過後思量盡是空。","早晚同歸洛陽陌，卜隣須近祝雞翁。"],"s":"trad","f":"simp"},{"i":"a438183d-15cb-4056-a55c-5e95c4e84630","t":"重寄絕句","a":"劉禹錫","d":"唐","g":"短诗","p":["淮西既是平安地，鴉路今無羽檄飛。","聞道唐州最清靜，戰場耕盡野花稀。"],"s":"trad","f":"simp"},{"i":"4cb3f2a0-7987-4666-9eb4-38d04290e78a","t":"酬楊八副使將赴湖南途中見寄一絕","a":"劉禹錫","d":"唐","g":"短诗","p":["知逐征南冠楚材，遠勞書信到陽臺。","明朝若上君山上，一道巴江自此來。"],"s":"trad","f":"simp"},{"i":"67dec81a-f8f6-4544-a14c-2d552b86124d","t":"遙和韓睦州元相公二君子","a":"劉禹錫","d":"唐","g":"短诗","p":["玉人紫綬相輝映，却要霜鬚一兩莖。","其奈無成空老去，每臨明鏡若爲情。"],"s":"mixed","f":"simp"},{"i":"1d3ca14e-2e41-419e-b30a-d58ff94c4f93","t":"吳興敬郎中見惠斑竹杖兼示一絕聊以謝之","a":"劉禹錫","d":"唐","g":"短诗","p":["一莖炯炯琅玕色，數節重重玳瑁文。","挂到高山未登處，青雲路上願逢君。"],"s":"mixed","f":"simp"},{"i":"1921fb0d-1d20-418e-831e-29e91b1a3117","t":"奉和裴令公夜宴","a":"劉禹錫","d":"唐","g":"短诗","p":["天下蒼生望不休，東山雖有但時游。","從來海上仙桃樹，肯逐人間風露秋。"],"s":"mixed","f":"simp"},{"i":"d5543626-4658-4fca-bba0-b768fdcba4d9","t":"秋夜安國觀聞笙","a":"劉禹錫","d":"唐","g":"短诗","p":["織女分明銀漢秋，桂枝梧葉共颼飀。","月露滿庭人寂寂，霓裳一曲在高樓。"],"s":"trad","f":"simp"},{"i":"bd8ac638-7b92-4579-8d9a-53c10c0d0dc4","t":"酬僕射牛相公晉國池上別後至甘棠館忽夢同游因成口號見寄","a":"劉禹錫","d":"唐","g":"短诗","p":["已嗟池上別魂驚，忽報夢中攜手行。","此夜獨歸還乞夢，老人無睡到天明。"],"s":"mixed","f":"simp"},{"i":"dc12da6b-c150-4fd6-9140-b33d122be8d2","t":"裴侍郎大尹雪中遺酒一壺兼示眼疾平一絕有閑行把酒之句斐然仰酬","a":"劉禹錫","d":"唐","g":"短诗","p":["卷盡輕雲月更明，金箆不用且閑行。","若傾家釀招來客，何必池塘春草生。"],"s":"trad","f":"simp"},{"i":"64a95c24-a37e-4308-a30a-c61a1d4ea1c3","t":"和滑州李尚書上巳憶江南禊事","a":"劉禹錫","d":"唐","g":"短诗","p":["白馬津頭春日遲，沙州歸鴈拂旌旗。","柳營唯有軍中戲，不似江南三月時。"],"s":"trad","f":"simp"},{"i":"3baef3db-7066-4b26-8732-e3756c6fa05b","t":"酬柳柳州家雞之贈","a":"劉禹錫","d":"唐","g":"短诗","p":["日日臨池弄小雛，還思寫論付官奴。","柳家新樣元和脚，且盡畺芽歛手徒。"],"s":"mixed","f":"simp"},{"i":"e0fbd8da-2fab-4130-8ee1-d38436a12db8","t":"荅前篇","a":"劉禹錫","d":"唐","g":"短诗","p":["小兒弄筆不能嗔，涴壁書窗且當勤。","聞彼夢熊猶未兆，女中誰是衛夫人。"],"s":"trad","f":"simp"},{"i":"f7bb766e-56a6-4911-ab96-cb0370840034","t":"荅後篇","a":"劉禹錫","d":"唐","g":"短诗","p":["昔日慵工記姓名，遠勞辛苦寫西京。","近來漸有臨池興，爲報元常欲抗行。"],"s":"mixed","f":"simp"},{"i":"06243529-9b64-47b1-9e94-327a5e8b34ce","t":"重荅柳柳州","a":"劉禹錫","d":"唐","g":"短诗","p":["弱冠同懷長者憂，臨岐回想盡悠悠。","耦耕若便遺身老，黃髮相看萬事休。"],"s":"trad","f":"simp"},{"i":"d45d1a69-5c37-4fed-9a29-b1bbe28861fd","t":"登清暉樓","a":"劉禹錫","d":"唐","g":"短诗","p":["潯陽江色潮添滿，彭蠡秋聲鴈送來。","南望廬山千萬仞，共誇新出棟梁材。"],"s":"trad","f":"simp"},{"i":"45db64c4-1d26-4999-bab2-030e6b238467","t":"赴和州於武昌縣再遇毛仙翁十八兄因成一絕","a":"劉禹錫","d":"唐","g":"短诗","p":["武昌山下蜀江東，重向仙舟見葛洪。","又得案前親禮拜，大羅天訣玉函封。"],"s":"trad","f":"simp"},{"i":"7f6cfb1c-8353-4c96-b3c5-d5438cdffbe4","t":"寄毘陵楊給事三首 一","a":"劉禹錫","d":"唐","g":"短诗","p":["揮毫起制來東省，躡足修名謁外臺。","好著櫜鞬莫惆悵，出文入武是全才。"],"s":"mixed","f":"simp"},{"i":"c0aad144-a03a-48b6-8dca-e24f3198f7e7","t":"寄毘陵楊給事三首 二","a":"劉禹錫","d":"唐","g":"短诗","p":["曾主魚書輕刺史，今朝自請左魚來。","青雲直上無多地，却要斜飛取勢回。"],"s":"mixed","f":"simp"},{"i":"ee360a5d-3e15-43e3-ae2d-3a4ec809c6d4","t":"寄毘陵楊給事三首 三","a":"劉禹錫","d":"唐","g":"短诗","p":["東城南陌昔同游，坐上無人第二流。","屈指如今已零落，且須歡喜作鄰州。"],"s":"mixed","f":"simp"},{"i":"8050ae95-4a63-41a6-996b-e568fbc097e4","t":"陪崔大尚書及諸閣老宴杏園","a":"劉禹錫","d":"唐","g":"短诗","p":["更將何面上春臺，白事無成老又催。","唯有落花無俗態，不嫌憔悴滿頭來。"],"s":"trad","f":"simp"},{"i":"63db8912-cff4-4e22-a1e9-08ebaeedee3d","t":"曹剛","a":"劉禹錫","d":"唐","g":"短诗","p":["大弦嘈囋小弦清，噴雪含風意思生。","一聽曹剛彈薄媚，人生不合出京城。"],"s":"trad","f":"simp"},{"i":"675c1a2d-bf76-45f3-b490-2d5f6ce0fac8","t":"寄湖州韓中丞","a":"劉禹錫","d":"唐","g":"短诗","p":["老郎日日憂蒼鬢，遠守年年厭白蘋。","終日相思不相見，長頻相見是何人。"],"s":"trad","f":"simp"},{"i":"769f3296-489b-4b0f-bfca-409e01cc1987","t":"楊柳枝","a":"劉禹錫","d":"唐","g":"短诗","p":["楊子江頭煙景迷，隋家宮樹拂金堤。","嵯峨猶有當時色，半蘸波中水鳥棲。"],"s":"trad","f":"simp"},{"i":"6c325e83-c41b-4bf6-a1fd-2d4b21f05ffb","t":"田順郎歌","a":"劉禹錫","d":"唐","g":"短诗","p":["清歌不是世間音，玉殿嘗聞稱主心。","唯有順郎全學得，一聲飛出九重深。"],"s":"trad","f":"simp"},{"i":"b997da15-3d6f-4e01-950c-b6bc7f01eb85","t":"夜聞商人船中箏","a":"劉禹錫","d":"唐","g":"短诗","p":["大艑高帆一百尺，新聲促柱十三弦。","揚州市裏商人女，來占江西明月天。"],"s":"mixed","f":"simp"},{"i":"f873a7af-a47b-4a37-bde9-fec49f8ec633","t":"聞道士彈思歸引","a":"劉禹錫","d":"唐","g":"短诗","p":["仙公一奏思歸引，逐客初聞自泫然。","莫怪殷勤悲此曲，越聲長苦已三年。"],"s":"trad","f":"simp"},{"i":"1f83a870-f855-49e3-81e9-897096a072d3","t":"喜康將軍見訪","a":"劉禹錫","d":"唐","g":"短诗","p":["謫君愁寂似幽棲，百草當門茅舍低。","夜獵將軍忽相訪，鷓鴣驚起繞籬啼。"],"s":"trad","f":"simp"},{"i":"47affb55-71ba-4ec3-9544-f52890c5640a","t":"贈劉景擢第","a":"劉禹錫","d":"唐","g":"短诗","p":["湘中才子是劉郎，望在長沙住桂陽。","昨日鴻都新上第，五陵年少讓清光。"],"s":"trad","f":"simp"},{"i":"9b64dd5a-fad5-44ee-ab8a-a95341fb0760","t":"赴連山途次德宗山陵寄張員外","a":"劉禹錫","d":"唐","g":"短诗","p":["常時並冕奉天顏，委佩低簪彩仗間。","今日獨來張樂地，萬重雲水望橋山。"],"s":"trad","f":"simp"},{"i":"2da45dd5-10b3-4d7c-93df-3e86997313f5","t":"嘗茶","a":"劉禹錫","d":"唐","g":"短诗","p":["生拍芳叢鷹觜芽，老郎封寄謫仙家。","今宵更有湘江月，照出菲菲滿盌花。"],"s":"trad","f":"simp"},{"i":"5427e8da-e121-4b37-b206-0359bbe7a1c1","t":"梁國祠","a":"劉禹錫","d":"唐","g":"短诗","p":["梁國三郎威德尊，女巫簫鼓走鄉村。","萬家長見空山上，雨氣蒼茫生廟門。"],"s":"trad","f":"simp"},{"i":"63f618fd-aa42-48ed-806c-41176fec9abe","t":"望洞庭","a":"劉禹錫","d":"唐","g":"短诗","p":["湖光秋月兩相和，潭面無風鏡未磨。","遙望洞庭山水翠，白銀盤裏一青螺。"],"s":"mixed","f":"simp"},{"i":"fe4b1751-5414-444e-9f9e-7fae7d38cdff","t":"楊柳枝","a":"劉禹錫","d":"唐","g":"短诗","p":["春江一曲柳千條，二十年前舊板橋。","曾與美人橋上別，恨無消息到今朝。"],"s":"trad","f":"simp"},{"i":"29e12604-4708-4c68-9d61-6d313c3a7a01","t":"樓上","a":"劉禹錫","d":"唐","g":"短诗","p":["江上樓高二十梯，梯梯登徧與雲齊。","人從別浦經年去，天向平蕪盡處低。"],"s":"trad","f":"simp"},{"i":"d5ac076b-9170-4aa1-b6a4-c67a96445b79","t":"洛濱病臥戶部李侍郎見惠藥物謔以文星之句斐然仰謝","a":"劉禹錫","d":"唐","g":"短诗","p":["隱几支頤對落暉，故人書信到柴扉。","周南留滯商山老，星象如今屬少微。"],"s":"mixed","f":"simp"},{"i":"59f8f90e-1d85-45e9-9f1f-37e0c41f1e54","t":"故洛城古牆","a":"劉禹錫","d":"唐","g":"短诗","p":["粉落椒飛知幾春，風吹雨灑旋成塵。","莫言一片危基在，猶過無窮來往人。"],"s":"trad","f":"simp"},{"i":"8bd51641-ede0-4569-9ddc-12fdb255ff2e","t":"句","a":"劉禹錫","d":"唐","g":"短诗","p":["湖上收宿雨，故國思如此。","若爲天外心，東屯滄海闊。","南讓洞庭寬，翠粒照晴露。","銀花垂院牓，翠羽撼絛鈴。"],"s":"mixed","f":"simp"},{"i":"da254237-36a9-4eec-b44c-47058833c411","t":"山亭懷古","a":"張弘靖","d":"唐","g":"短诗","p":["叢石依古城，懸泉灑清池。","高低袤丈內，衡霍相蔽虧。","歸田竟何因，爲郡豈所宜。","誰能辨人野，寄適聊在斯。"],"s":"mixed","f":"simp"},{"i":"12917272-66e2-4bf0-907d-2d259a3b8b10","t":"和張相公太原山亭懷古詩","a":"韓察","d":"唐","g":"短诗","p":["公府政多暇，思與仁智全。","爲山想巖穴，引水聽潺湲。","軒冕迹自逸，塵俗無由牽。","蒼生方矚望，詎得賦歸田。"],"s":"mixed","f":"simp"},{"i":"7f252a74-bab6-43d4-ae9c-5572a0530c42","t":"和張相公太原山亭懷古詩","a":"崔恭","d":"唐","g":"短诗","p":["高情樂閑放，寄跡山水中。","朝霞鋪座右，虛白貯清風。","潛竇激飛泉，石路躋且崇。","步武有勝概，不與俗情同。"],"s":"trad","f":"simp"},{"i":"96fd51b9-ca03-4a78-87e2-b760e7d95a74","t":"和張相公太原山亭懷古詩","a":"陸瀍","d":"唐","g":"短诗","p":["激水瀉飛瀑，寄懷良在茲。","如何謝安石，要結東山期。","入座蘭蕙馥，當軒松桂滋。","於焉悟幽道，境寂心自怡。"],"s":"trad","f":"simp"},{"i":"4538510b-62de-4da9-8791-4b5b45eceaa5","t":"和張相公太原亭懷古詩","a":"胡[証]","d":"唐","g":"短诗","p":["飛泉天台狀，峭石蓬萊姿。","潺湲與青翠，咫尺當幽奇。","居然盡精道，得以書妍詞。","豈無他山勝，懿此清軒墀。"],"s":"trad","f":"simp"},{"i":"9d68c454-9ece-40e2-b65e-207175f540c0","t":"句","a":"胡[証]","d":"唐","g":"短诗","p":["詩書入京國，旌斾過鄉關。"],"s":"trad","f":"simp"},{"i":"56b4c2ad-8c27-4d0a-ac7c-4f4e4f266701","t":"和太原山亭懷古詩","a":"張賈","d":"唐","g":"短诗","p":["中庭起崖谷，漱玉下漣漪。","丹丘誰云遠，寓象得心期。","豈不貴鍾鼎，至懷在希夷。","唯當蓬萊閣，靈鳳復來儀。"],"s":"mixed","f":"simp"},{"i":"b65fa19a-721a-40c6-b64b-d6867ffb8a8b","t":"和裴司空答張祕書贈馬詩","a":"張賈","d":"唐","g":"短诗","p":["閣下從容舊客卿，寄來駿馬賞高情。","任追煙景騎仍醉，知有文章倚便成。","步步自憐春日影，蕭蕭猶起朔風聲。","須知上宰吹噓意，送入天門上路行。"],"s":"mixed","f":"simp"},{"i":"707a92e3-4560-47e5-8bbe-5ceff0e85bc2","t":"句","a":"張賈","d":"唐","g":"短诗","p":["夫子生知者，相期妙理中。"],"s":"trad","f":"simp"},{"i":"080ad915-4f82-48a9-820a-7d25758e5742","t":"吳興三絕","a":"張文規","d":"唐","g":"短诗","p":["蘋洲須覺池沼俗，苧布直勝羅紈輕。","清風樓下草初出，明月峽中茶始生。","吳興三絕不可捨，勸子強爲吳會行。"],"s":"mixed","f":"simp"},{"i":"f44b8de6-f634-4dcd-9976-675e2f0e9507","t":"湖州貢焙新茶","a":"張文規","d":"唐","g":"短诗","p":["鳳輦尋春半醉回，僊娥進水御簾開。","牡丹花笑金鈿動，傳奏吳興紫筍來。"],"s":"trad","f":"simp"},{"i":"b3217593-db7c-425d-bbc2-012c956c9b7d","t":"句","a":"張文規","d":"唐","g":"短诗","p":["誰云隼旟吏，長對虎頭巖。"],"s":"mixed","f":"simp"},{"i":"6fe52a30-0b0b-4be5-aa09-b2c992d4ef65","t":"緱山鶴","a":"張仲素","d":"唐","g":"古体","p":["羽客驂仙鶴，將飛駐碧山。","映松殘雪在，度嶺片雲還。","清唳因風遠，高姿對水閑。","笙歌憶天上，城郭歎人間。","幾變霜毛潔，方殊藻質斑。","迢迢煙路逸，奮翮詎能攀。"],"s":"trad","f":"simp"},{"i":"7102c9d2-43aa-4f28-81c5-7882e900053e","t":"夜聞洛濱吹笙","a":"張仲素","d":"唐","g":"古体","p":["王子千年後，笙音五夜聞。","逶迤繞清洛，斷續下仙雲。","泄泄飄難定，啾啾曲未分。","松風助幽律，波月動輕文。","鳳管聽何遠，鸞聲若在羣。","暗空思羽蓋，餘氣自氛氳。"],"s":"mixed","f":"simp"},{"i":"bfd2fd75-564e-464c-873a-c851f04155dd","t":"上元日聽太清宮步虛","a":"張仲素","d":"唐","g":"古体","p":["仙客開金籙，元辰會玉京。","靈歌賓紫府，雅韻出層城。","磬雜音徐徹，風飄響更清。","紆餘空外盡，斷續聽中生。","舞鶴紛將集，流雲住未行。","誰知九陌上，塵俗仰遺聲。"],"s":"trad","f":"simp"},{"i":"07fd95d4-b5ff-4b27-a23f-2df0264d0bf8","t":"玉繩低建章","a":"張仲素","d":"唐","g":"古体","p":["迢迢玉繩下，芒彩正闌干。","稍復臨鳷鵲，方疑近露寒。","微明連粉堞，的皪映仙盤。","橫接河流照，低將夜色殘。","天榆隨影沒，宮樹與光攢。","遐想西垣客，長吟欲罷難。"],"s":"mixed","f":"simp"},{"i":"e38d4be8-d632-4acc-afab-0f200ce3ea20","t":"寒雲輕重色","a":"張仲素","d":"唐","g":"古体","p":["佳期當可許，託思望雲端。","鱗影朝猶落，繁陰暮自寒。","因風方嫋嫋，間石已漫漫。","隱映看鴻度，霏微覺樹攢。","凝空多似黛，引素乍如紈。","每向愁中覽，含毫欲狀難。"],"s":"trad","f":"simp"},{"i":"a385e885-39f8-428b-aead-929a3f7e4e42","t":"聖明樂","a":"張仲素","d":"唐","g":"短诗","p":["九陌祥煙合，千春瑞月明。","宮花將苑柳，先發鳳皇城。"],"s":"trad","f":"simp"},{"i":"531c80b8-2306-4399-a1a8-33a92e6f6991","t":"獻壽詞","a":"張仲素","d":"唐","g":"短诗","p":["玉帛殊方至，歌鐘比屋聞。","華夷今一貫，同賀聖朝君。"],"s":"trad","f":"simp"},{"i":"37b9dfcd-837c-477d-9069-e4026b35aa81","t":"宮中樂五首 一","a":"張仲素","d":"唐","g":"短诗","p":["網戶交如綺，紗窗薄似煙。","樂吹天上曲，人是月中仙。"],"s":"trad","f":"simp"},{"i":"1245f38c-fb63-46df-8976-2c6fd8c30723","t":"宮中樂五首 二","a":"張仲素","d":"唐","g":"短诗","p":["翠匣開寒鏡，珠釵挂步搖。","妝成祗畏曉，更漏促春宵。"],"s":"mixed","f":"simp"},{"i":"fec98322-0461-4f6b-8a31-4b54da2e3890","t":"宮中樂五首 三","a":"張仲素","d":"唐","g":"短诗","p":["紅果瑤池實，金盤露井冰。","甘泉將避暑，臺殿曉光凝。"],"s":"trad","f":"simp"},{"i":"aeec615f-6ccf-44b0-a885-a81ecb51d0e0","t":"宮中樂五首 四","a":"張仲素","d":"唐","g":"短诗","p":["月采浮鸞殿，砧聲隔鳳樓。","笙歌臨水檻，紅燭乍迎秋。"],"s":"mixed","f":"simp"},{"i":"6eef2cdc-f074-40f3-be85-f762ce7bd198","t":"宮中樂五首 五","a":"張仲素","d":"唐","g":"短诗","p":["奇樹留寒翠，神池結夕波。","黃山一夜雪，渭水瀉聲多。"],"s":"trad","f":"simp"},{"i":"887e948b-092f-4c6c-94e0-581cb1d8ef5b","t":"春遊曲三首 一","a":"張仲素","d":"唐","g":"短诗","p":["煙柳飛輕絮，風榆落小錢。","濛濛百花裏，羅綺競鞦韆。"],"s":"mixed","f":"simp"},{"i":"3e33777f-d29f-4955-9bf6-e5a40175c817","t":"春遊曲三首 二","a":"張仲素","d":"唐","g":"短诗","p":["騁望登香閣，爭高下砌臺。","林間踏青去，席上寄牋來。"],"s":"trad","f":"simp"},{"i":"3265f523-2b3a-4af0-a213-2fafc6d868c7","t":"春遊曲三首 三","a":"張仲素","d":"唐","g":"短诗","p":["行樂三春節，林花百和香。","當年重意氣，先占鬬雞場。"],"s":"mixed","f":"simp"},{"i":"481cbbd4-2440-4c33-82e6-272cc85f7917","t":"春閨思","a":"張仲素","d":"唐","g":"短诗","p":["裊裊城邊柳，青青陌上桑。","提籠忘采葉，昨夜夢漁陽。"],"s":"mixed","f":"simp"},{"i":"9a8ce7ec-47e5-4071-b5b7-932571395d17","t":"春江曲二首 一","a":"張仲素","d":"唐","g":"短诗","p":["家寄征河岸，征人幾歲遊。","不如潮水信，每日到沙頭。"],"s":"mixed","f":"simp"},{"i":"f854f545-3e40-41a5-a079-0eee70760591","t":"春江曲二首 二","a":"張仲素","d":"唐","g":"短诗","p":["乘曉南湖去，參差疊浪橫。","前洲在何處，霜裏鴈嚶嚶。"],"s":"mixed","f":"simp"},{"i":"a40752d1-7e06-44ac-aaee-2aa810d164c8","t":"太平詞","a":"張仲素","d":"唐","g":"短诗","p":["聖德超千古，皇威靜四方。","蒼生今息戰，無事覺時良。"],"s":"trad","f":"simp"},{"i":"b1f281bf-93f2-4046-b80f-9a086648288d","t":"隴上行","a":"張仲素","d":"唐","g":"短诗","p":["行到黃雲隴，唯聞羌戍鼙。","不如山下水，猶得任東西。"],"s":"trad","f":"simp"},{"i":"927896fd-566d-4aba-841d-0ffdf6253809","t":"思君恩","a":"張仲素","d":"唐","g":"短诗","p":["紫禁香如霧，青天月似霜。","雲韶何處奏，祗是在朝陽。"],"s":"trad","f":"simp"},{"i":"a6994348-8a80-47bd-8eb7-54c51c8f2e2f","t":"王昭君","a":"張仲素","d":"唐","g":"短诗","p":["仙娥今下嫁，驕子自同和。","劒戟歸田盡，牛羊繞塞多。"],"s":"trad","f":"simp"},{"i":"1bb3a910-fafa-425e-8c88-bfb7647fe041","t":"秋夜曲","a":"張仲素","d":"唐","g":"短诗","p":["丁丁漏水夜何長，漫漫輕雲露月光。","秋逼暗蟲通夕響，征衣未寄莫飛霜。"],"s":"trad","f":"simp"},{"i":"6ab3d8b6-f095-4266-8289-51a05cfa6748","t":"秋思贈遠","a":"張仲素","d":"唐","g":"短诗","p":["博山沉燎絕餘香，蘭燼金檠怨夜長。","爲問青青河畔草，幾回經雨復經霜。"],"s":"mixed","f":"simp"},{"i":"e09ba4e3-92e5-47a0-93cb-8f1e83d7419b","t":"塞上曲","a":"張仲素","d":"唐","g":"短诗","p":["卷斾生風喜氣新，早持龍節靜邊塵。","漢家天子圖麟閣，身是當今第一人。"],"s":"trad","f":"simp"},{"i":"d8cf1ef0-2fa2-48c0-b5d9-d5ee381d2904","t":"塞下曲五首 一","a":"張仲素","d":"唐","g":"短诗","p":["三戍漁陽再渡遼，騂弓在臂劒橫腰。","匈奴似若知名姓，休傍陰山更射雕。"],"s":"mixed","f":"simp"},{"i":"7be12bdf-03cf-4670-9466-89db4ef0f1dd","t":"塞下曲五首 二","a":"張仲素","d":"唐","g":"短诗","p":["獵馬千行鴈幾雙，燕然山下碧油幢。","傳聲漠北單于破，火照旌旗夜受降。"],"s":"mixed","f":"simp"},{"i":"9202aa26-8e4f-4828-9fdc-237729e175f7","t":"塞下曲五首 三","a":"張仲素","d":"唐","g":"短诗","p":["朔雪飄飄開鴈門，平沙歷亂卷蓬根。","功名耻計擒生數，直斬樓蘭報國恩。"],"s":"mixed","f":"simp"},{"i":"bfe82b29-9ada-44f1-9a46-30824df16333","t":"塞下曲五首 四","a":"張仲素","d":"唐","g":"短诗","p":["隴水潺湲隴樹秋，征人到此淚雙流。","鄉關萬里無因見，西戍河源早晚休。"],"s":"mixed","f":"simp"},{"i":"832b9a46-3471-49c3-a3eb-6d6077d1a5a3","t":"塞下曲五首 五","a":"張仲素","d":"唐","g":"短诗","p":["陰磧茫茫塞草肥，桔槔烽上暮雲飛。","交河北望天連海，蘇武曾將漢節歸。"],"s":"trad","f":"simp"},{"i":"0c6d66a8-1fda-4008-be00-00b59e8b432d","t":"秋思二首 一","a":"張仲素","d":"唐","g":"短诗","p":["碧窗斜日藹深暉，愁聽寒螿淚濕衣。","夢裏分明見關塞，不知何路向金微。"],"s":"mixed","f":"simp"},{"i":"795f99c5-30cc-4e7e-8473-64d952646600","t":"秋思二首 二","a":"張仲素","d":"唐","g":"短诗","p":["秋天一夜靜無雲，斷續鴻聲到曉聞。","欲寄征衣問消息，居延城外又移軍。"],"s":"trad","f":"simp"},{"i":"f7eba4eb-71a4-4f2f-b648-9eec4f7a0071","t":"漢苑行二首","a":"張仲素","d":"唐","g":"短诗","p":["回鴈高飛太液池，新花低發上林枝。","年光到處皆堪賞，春色人間總不知。"],"s":"trad","f":"simp"},{"i":"ae156321-4ecb-456c-bf03-50ff6f759113","t":"漢苑行二首 二","a":"張仲素","d":"唐","g":"短诗","p":["春風淡蕩景悠悠，鶯囀高枝燕入樓。","千步回廊聞鳳吹，珠簾處處上銀鉤。"],"s":"mixed","f":"simp"},{"i":"99425c56-1131-40e3-b17d-050d00595775","t":"天馬辭二首 一","a":"張仲素","d":"唐","g":"短诗","p":["天馬初從渥水來，郊歌曾唱得龍媒。","不知玉塞沙中路，苜蓿殘花幾處開。"],"s":"trad","f":"simp"},{"i":"43e882d6-e931-4bf5-8b4a-4f8f7cac363a","t":"天馬辭二首 二","a":"張仲素","d":"唐","g":"短诗","p":["躞蹀宛駒齒未齊，摐金噴玉向風嘶。","來時欲盡金河道，獵獵輕風在碧蹄。"],"s":"trad","f":"simp"},{"i":"1c7b87cc-6a9f-48ae-bc40-8c42e728fbbf","t":"燕子樓詩三首 一","a":"張仲素","d":"唐","g":"短诗","p":["樓上殘燈伴曉霜，獨眠人起合歡牀。","相思一夜情多少，地角天涯不是長。"],"s":"mixed","f":"simp"},{"i":"759dcb8a-b3d8-4663-bba1-070dfc772779","t":"燕子樓詩三首 二","a":"張仲素","d":"唐","g":"短诗","p":["北邙松栢鎖愁煙，燕子樓人思悄然。","自埋劒履歌塵散，紅袖香消已十年。"],"s":"trad","f":"simp"},{"i":"ccee06f6-eba9-4e98-be08-1191da6d4319","t":"燕子樓詩三首 三","a":"張仲素","d":"唐","g":"短诗","p":["適看鴻鴈岳陽回，又覩玄禽逼社來。","瑤瑟玉簫無意緒，任從蛛網任從灰。"],"s":"mixed","f":"simp"}]