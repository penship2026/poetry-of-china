[{"i":"1ef28160-09b6-4f5e-9592-d6d4b9a3a797","t":"思歸","a":"顧況","d":"唐","g":"短诗","p":["不能經綸大經，甘作草莽閑臣。","青[瑣]應須長別，白雲漫與相親。"],"s":"trad","f":"simp"},{"i":"64bd69e4-ef0a-4190-b60f-e33856617f88","t":"歸山作","a":"顧況","d":"唐","g":"短诗","p":["心事數莖白髮，生涯一片青山。","空林有雪相待，古道無人獨還。"],"s":"trad","f":"simp"},{"i":"684e16f6-839b-4600-b680-996ac541ced0","t":"過山農家","a":"顧況","d":"唐","g":"短诗","p":["板橋人渡泉聲，茆簷日午雞鳴。","莫嗔焙茶煙暗，却喜曬穀天晴。"],"s":"mixed","f":"simp"},{"i":"3118709c-e27c-4f00-ac3e-1fd2cf0dda53","t":"代佳人贈別","a":"顧況","d":"唐","g":"短诗","p":["萬里行人欲渡溪，千行珠淚滴爲泥。","已成殘夢隨君去，猶有驚烏半夜啼。"],"s":"mixed","f":"simp"},{"i":"ad10840a-e59a-4a43-801e-2b622abe2290","t":"憶故園","a":"顧況","d":"唐","g":"短诗","p":["惆悵多山人復稀，杜鵑啼處淚霑衣。","故園此去千餘里，春夢猶能夜夜歸。"],"s":"mixed","f":"simp"},{"i":"39a18f10-005c-4200-ba56-70b7e35adea4","t":"題葉道士山房","a":"顧況","d":"唐","g":"短诗","p":["水邊垂柳赤欄橋，洞裏仙人碧玉簫。","近得麻姑音信否，潯陽江上不通潮。"],"s":"mixed","f":"simp"},{"i":"afcea24d-248f-494b-8c94-99eae104160d","t":"送李秀才入京","a":"顧況","d":"唐","g":"短诗","p":["五湖秋葉滿行船，八月靈槎欲上天。","君向長安余適越，獨登秦望望秦川。"],"s":"mixed","f":"simp"},{"i":"be7b7b24-a1d7-4256-9f30-7e745c4caeb5","t":"越中席上看弄老人","a":"顧況","d":"唐","g":"短诗","p":["不到山陰十二春，鏡中相見白頭新。","此生不復爲年少，今日從他弄老人。"],"s":"mixed","f":"simp"},{"i":"d7a6694c-e3be-4400-8477-aae52dd95da8","t":"聽劉安唱歌","a":"顧況","d":"唐","g":"短诗","p":["子夜新聲何處傳，悲翁更憶太平年。","即今法曲無人唱，已逐霓裳飛上天。"],"s":"trad","f":"simp"},{"i":"f9747c4d-c1e5-4d2c-8bce-10889bba41b4","t":"櫻桃曲","a":"顧況","d":"唐","g":"短诗","p":["百舌猶來上苑花，遊人獨自憶京華。","遙知寢廟嘗新後，敕賜櫻桃向幾家。"],"s":"trad","f":"simp"},{"i":"1acbe7fa-59b9-45be-8a64-fafc21bcf140","t":"山中","a":"顧況","d":"唐","g":"短诗","p":["野人愛向山中宿，況在葛洪丹井西。","庭前有箇長松樹，夜半子規來上啼。"],"s":"trad","f":"simp"},{"i":"9aa45c93-0eca-4b64-b800-f0d6722ec3a0","t":"贈朱放","a":"顧況","d":"唐","g":"短诗","p":["野客歸時無四鄰，黔婁別久案常貧。","漁樵舊路不堪入，何處空山猶有人。"],"s":"trad","f":"simp"},{"i":"66312123-6671-49e5-a4ed-790959f4157e","t":"江村亂後","a":"顧況","d":"唐","g":"短诗","p":["江村日暮尋遺老，江水東流橫浩浩。","竹裏閑窗不見人，門前舊路生青草。"],"s":"mixed","f":"simp"},{"i":"15dcb3cf-f2c9-4448-9a65-24a31619a142","t":"望簡寂觀","a":"顧況","d":"唐","g":"短诗","p":["青嶂青溪直復斜，白雞白犬到人家。","仙人住在最高處，向晚春泉流白花。"],"s":"trad","f":"simp"},{"i":"8b0b4e67-a813-428e-9938-88083f5cda7a","t":"五兩歌送張夏","a":"顧況","d":"唐","g":"短诗","p":["竿頭五兩風褭褭，水上雲帆逐飛鳥。","送君初出揚州時，靄靄曈曈江溢曉。"],"s":"trad","f":"simp"},{"i":"a444eb74-e3d9-47b8-abce-2b847a91e708","t":"臨海所居三首 一","a":"顧況","d":"唐","g":"短诗","p":["此是昔年征戰處，曾經永日絕人行。","千家寂寂對流水，唯有汀洲春草生。"],"s":"mixed","f":"simp"},{"i":"a8109695-edde-4e9e-826a-eb98ff50bc49","t":"臨海所居三首 二","a":"顧況","d":"唐","g":"短诗","p":["此去臨溪不是遙，樓中望見赤城標。","不知疊嶂重霞裏，更有何人度石橋。"],"s":"mixed","f":"simp"},{"i":"2f78a46d-939f-4a36-ae0e-c8b1ea54d683","t":"臨海所居三首 三","a":"顧況","d":"唐","g":"短诗","p":["家在雙峰蘭若邊，一聲秋磬發孤煙。","山連極浦鳥飛盡，月上青林人未眠。"],"s":"trad","f":"simp"},{"i":"8035a2d8-6e7f-4045-93f3-e689eb83f6c8","t":"聽角思歸","a":"顧況","d":"唐","g":"短诗","p":["故園黃葉滿青苔，夢後城頭曉角哀。","此夜斷腸人不見，起行殘日影徘徊。"],"s":"trad","f":"simp"},{"i":"8b86f9b3-708e-4939-b35a-5292571f9406","t":"酬柳相公","a":"顧況","d":"唐","g":"短诗","p":["天下如今已太平，相公何事喚狂生。","箇身恰似籠中鶴，東望滄溟呌數聲。"],"s":"trad","f":"simp"},{"i":"a116bb6f-30ad-48b4-ac26-e759aa68c4aa","t":"題明霞臺","a":"顧況","d":"唐","g":"短诗","p":["野人本自不求名，欲向山中過一生。","莫嫌憔悴無知己，別有煙霞似弟兄。"],"s":"trad","f":"simp"},{"i":"a1cfb449-4657-4634-9823-3eb97333f4fa","t":"哭絢法師","a":"顧況","d":"唐","g":"短诗","p":["楚客停橈欲問誰，白沙江草麴塵絲。","生公手種殿前樹，唯有花開鶗鴂悲。"],"s":"trad","f":"simp"},{"i":"d3e37fe7-24cf-41a3-aab4-66398019be30","t":"送柳宜城葬","a":"顧況","d":"唐","g":"短诗","p":["鳴笳已逐春風咽，匹馬猶依舊路嘶。","遙望柳家門外樹，恐聞黃鳥向人啼。"],"s":"trad","f":"simp"},{"i":"298ebbb2-b6d6-4254-a074-1b5b65ffcfe8","t":"宮詞五首 一","a":"顧況","d":"唐","g":"短诗","p":["禁柳煙中聞曉烏，風吹玉漏盡銅壺。","內官先向蓬萊殿，金合開香瀉御鑪。"],"s":"trad","f":"simp"},{"i":"3498d3d4-04ed-4195-86e4-6cdaf4288a5b","t":"宮詞五首 三","a":"顧況","d":"唐","g":"短诗","p":["玉階容衛宿千官，風獵青旂曉仗寒。","侍女先來薦瓊蘂，露漿新下九霄盤。"],"s":"trad","f":"simp"},{"i":"80a533a0-196f-47cf-ad55-33711b796415","t":"宮詞五首 四","a":"顧況","d":"唐","g":"短诗","p":["九重天樂降神仙，步舞分行踏錦筵。","嘈囋一聲鐘鼓歇，萬人樓下拾金錢。"],"s":"trad","f":"simp"},{"i":"80cb803f-b016-450c-a5b3-70d95155b0ef","t":"宮詞五首 五","a":"顧況","d":"唐","g":"短诗","p":["金吾持戟護新簷，天樂聲傳萬姓瞻。","樓上美人相倚看，紅妝透出水精簾。"],"s":"trad","f":"simp"},{"i":"f96d878f-bb81-4d27-a814-c89692c7f34b","t":"尋桃花嶺潘三姑臺","a":"顧況","d":"唐","g":"短诗","p":["桃花嶺上覺天低，人上青山馬隔溪。","行到三姑學仙處，還有劉阮二郎迷。"],"s":"trad","f":"simp"},{"i":"e7592bdb-3362-44e0-ac0d-0462b6355554","t":"夜中望仙觀","a":"顧況","d":"唐","g":"短诗","p":["日暮銜花飛鳥還，月明溪上見青山。","遙知玉女窗前樹，不是仙人不得攀。"],"s":"trad","f":"simp"},{"i":"d50edf1b-c48c-490f-adbf-847c232e9b05","t":"送李侍御往吳興","a":"顧況","d":"唐","g":"短诗","p":["世間只有情難說，今夜應無不醉人。","若向洞庭山下過，暗知澆瀝聖姑神。"],"s":"trad","f":"simp"},{"i":"22b4dc84-3bab-4e4d-8477-23567ca52a23","t":"奉和韓晉公晦日呈諸判官","a":"顧況","d":"唐","g":"短诗","p":["江南無處不聞歌，晦日中軍樂更多。","不是風光催柳色，却緣威令動陽和。"],"s":"mixed","f":"simp"},{"i":"ce7ba4c1-33d6-45cc-a71b-854e42a2e9df","t":"子規","a":"顧況","d":"唐","g":"短诗","p":["杜宇冤亡積有時，年年啼血動人悲。","若敎恨魄皆能化，何樹何山着子規。"],"s":"mixed","f":"simp"},{"i":"03734aa5-4f4e-4577-90ca-317ca63d77c6","t":"海鷗詠","a":"顧況","d":"唐","g":"短诗","p":["萬里飛來爲客鳥，曾蒙丹鳳借枝柯。","一朝鳳去梧桐死，滿目鴟鳶奈爾何。"],"s":"mixed","f":"simp"},{"i":"b21455ef-3df1-4c89-b02b-369890f2edf9","t":"贈韋清將軍","a":"顧況","d":"唐","g":"短诗","p":["身執金吾主禁兵，腰間寶劍重橫行。","接輿亦是狂歌者，更就將軍乞一聲。"],"s":"trad","f":"simp"},{"i":"082f73c5-c6bc-4256-841c-13fb732f11bb","t":"贈僧二首 一","a":"顧況","d":"唐","g":"短诗","p":["家住義興東舍溪，溪邊莎草雨無泥。","上人一向心入定，春鳥年年空自啼。"],"s":"trad","f":"simp"},{"i":"08d7b6c7-7471-422c-8bdc-353b98ddf6ea","t":"贈僧二首 二","a":"顧況","d":"唐","g":"短诗","p":["出頭皆是新年少，何處能容老病翁。","更把浮榮喻生滅，世間無事不虛空。"],"s":"trad","f":"simp"},{"i":"068ebef7-dc84-4cbd-bb7e-77a9d4cebd4b","t":"登樓望水","a":"顧況","d":"唐","g":"短诗","p":["鳥啼花發柳含煙，擲却風光憶少年。","更上高樓望江水，故鄉何處一歸船。"],"s":"mixed","f":"simp"},{"i":"4c0957b5-dd32-4391-b11c-cef4e57019c3","t":"湖中","a":"顧況","d":"唐","g":"短诗","p":["青草湖邊日色低，黃茅嶂裏鷓鴣啼。","丈夫飄蕩今如此，一曲長歌楚水西。"],"s":"mixed","f":"simp"},{"i":"b64c656c-1346-4fce-9667-57d2472ab4f2","t":"歲日作","a":"顧況","d":"唐","g":"短诗","p":["不覺老將春共至，更悲攜手幾人全。","還丹寂寞羞明鏡，手把屠蘇讓少年。"],"s":"trad","f":"simp"},{"i":"27b254dd-2016-446f-98cf-d55786e671b0","t":"山中贈客","a":"顧況","d":"唐","g":"短诗","p":["山中好處無人別，澗梅僞作山中雪。","野客相逢夜不眠，山中童子燒松節。"],"s":"mixed","f":"simp"},{"i":"a430fc14-8402-4e73-a6c6-b46041986d07","t":"王郎中妓席五詠 箜篌","a":"顧況","d":"唐","g":"短诗","p":["玉作搔頭金步搖，高張苦調響連宵。","欲知寫盡相思夢，度水尋雲不用橋。"],"s":"trad","f":"simp"},{"i":"e0526a65-b0e0-47d4-b141-43443bc76606","t":"王郎中妓席五詠 舞","a":"顧況","d":"唐","g":"短诗","p":["汗浥新裝畫不成，絲催急節舞衣輕。","落花遶樹疑無影，回雪從風暗有情。"],"s":"mixed","f":"simp"},{"i":"aa28008b-e95f-4b32-a869-12a16f34d987","t":"王郎中妓席五詠 歌","a":"顧況","d":"唐","g":"短诗","p":["柳拂青樓花滿衣，能歌宛轉世應稀。","空中幾處聞清響，欲遶行雲不遣飛。"],"s":"trad","f":"simp"},{"i":"d1f5c7c4-3fe6-408c-8865-db6c31ab518b","t":"王郎中妓席五詠 箏","a":"顧況","d":"唐","g":"短诗","p":["秦聲楚調怨無窮，隴水胡笳咽復通。","莫遣黃鶯花裏囀，參差撩亂妬春風。"],"s":"mixed","f":"simp"},{"i":"f228b77d-1c21-478f-a6f1-59ed877adc14","t":"王郎中妓席五詠 笙","a":"顧況","d":"唐","g":"短诗","p":["欲寫人間離別心，須聽鳴鳳似龍吟。","江南曲盡歸何處，洞水山雲知淺深。"],"s":"trad","f":"simp"},{"i":"50defe07-70d9-4bea-8dc8-f6258bbec03e","t":"送李山人還玉溪","a":"顧況","d":"唐","g":"短诗","p":["好鳥共鳴臨水樹，幽人獨欠買山錢。","若爲種得千竿竹，引取君家一眼泉。"],"s":"mixed","f":"simp"},{"i":"797eb1a3-4a26-4075-adb0-52b09464228b","t":"送少微上人還鹿門","a":"顧況","d":"唐","g":"短诗","p":["少微不向吳中隱，爲箇生緣在鹿門。","行入漢江秋月色，襄陽耆舊幾人存。"],"s":"mixed","f":"simp"},{"i":"2a44af03-7327-40d4-88c0-f09fb6bbd5db","t":"宿昭應","a":"顧況","d":"唐","g":"短诗","p":["武帝祈靈太乙壇，新豐樹色繞千官。","那知今夜長生殿，獨閉山門月影寒。"],"s":"trad","f":"simp"},{"i":"05dcdf54-0d4d-4d22-a2c8-916b38ba00e4","t":"題琅邪上方","a":"顧況","d":"唐","g":"短诗","p":["東晉王家在此溪，南朝樹色隔窗低。","碑沈字滅昔人遠，谷鳥猶向寒花啼。"],"s":"trad","f":"simp"},{"i":"1b75367f-b4bb-48da-a7fa-6d98d3d95322","t":"安仁港口望仙人城","a":"顧況","d":"唐","g":"短诗","p":["樓臺采翠遠分明，聞說仙家在此城。","欲上仙城無路上，水邊花裏有人聲。"],"s":"mixed","f":"simp"},{"i":"22936d54-909d-468d-bbb0-c5268bbdf0d6","t":"寄祕書包監","a":"顧況","d":"唐","g":"短诗","p":["一別長安路幾千，遙知舊日主人憐。","賈生只是三年謫，獨自無才已四年。"],"s":"mixed","f":"simp"},{"i":"cf75254e-a399-47c0-b188-79c3b0be396b","t":"小孤山","a":"顧況","d":"唐","g":"短诗","p":["古廟楓林江水邊，寒鴉接飯雁橫天。","大孤山遠小孤出，月照洞庭歸客船。"],"s":"trad","f":"simp"},{"i":"3d46a51d-3295-440e-88f0-1a2985aae729","t":"送李秀才遊嵩山","a":"顧況","d":"唐","g":"短诗","p":["嵩山石壁挂飛流，無限神仙在上頭。","采得新詩題石壁，老人惆悵不同遊。"],"s":"mixed","f":"simp"},{"i":"9559b3b8-a288-47a0-9494-2be54f934ab5","t":"從剡溪至赤城","a":"顧況","d":"唐","g":"短诗","p":["靈溪宿處接靈山，窈映高樓向月閑。","夜半鶴聲殘夢裏，猶疑琴曲洞房閒。"],"s":"mixed","f":"simp"},{"i":"65c4e93c-38d0-4247-a7cc-b19c6ee77743","t":"葉上題詩從苑中流出","a":"顧況","d":"唐","g":"短诗","p":["花落深宮鶯亦悲，上陽宮女斷腸時。","君恩不閉東流水，葉上題詩寄與誰。"],"s":"trad","f":"simp"},{"i":"74cd7154-770a-41c4-b55d-1e27ac1ba628","t":"崦裏桃花","a":"顧況","d":"唐","g":"短诗","p":["崦裏桃花逢女冠，林間杏葉落仙壇。","老人方授上清籙，夜聽步虛山月寒。"],"s":"mixed","f":"simp"},{"i":"c3186f0a-f6a1-4d01-81a2-f3533de1826d","t":"聽子規","a":"顧況","d":"唐","g":"短诗","p":["棲霞山中子規鳥，口邊血出啼不了。","山僧後夜初出定，聞似不聞山月曉。"],"s":"trad","f":"simp"},{"i":"7343f60d-c51e-44a0-9b6d-30fb63783ab0","t":"竹枝曲","a":"顧況","d":"唐","g":"短诗","p":["帝子蒼梧不復歸，洞庭葉下荆雲飛。","巴人夜唱竹枝後，腸斷曉猿聲漸稀。"],"s":"mixed","f":"simp"},{"i":"ee152d89-4839-4572-b606-46d8c3a1d744","t":"尋僧二首 一","a":"顧況","d":"唐","g":"短诗","p":["方丈玲瓏花竹閑，已將心印出人閒。","家家門外長安道，何處相逢是寶山。"],"s":"trad","f":"simp"},{"i":"6e310a1e-e27f-4316-854a-0a0543fa9e85","t":"尋僧二首 二","a":"顧況","d":"唐","g":"短诗","p":["彌天釋子本高情，往往山中獨自行。","莫怪狂人游楚國，蓮花只在淤泥生。"],"s":"mixed","f":"simp"},{"i":"02430665-d8b1-4830-8b51-744091ebcc22","t":"桃花曲","a":"顧況","d":"唐","g":"短诗","p":["魏帝宮人舞鳳樓，隋家天子泛龍舟。","君王夜醉春眠晏，不覺桃花逐水流。"],"s":"trad","f":"simp"},{"i":"74e40685-01eb-443a-a7e7-e6d99f61bed8","t":"贈遠","a":"顧況","d":"唐","g":"短诗","p":["暫出河邊思遠道，却來窗下聽新鶯。","故人一別幾時見，春草還從舊處生。"],"s":"mixed","f":"simp"},{"i":"00ede8d1-4ba1-4b59-9021-bddf471b00e4","t":"早春思歸有唱竹枝歌者坐中下淚","a":"顧況","d":"唐","g":"短诗","p":["渺渺春生楚水波，楚人齊唱竹枝歌。","與君皆是思歸客，拭淚看花奈老何。"],"s":"trad","f":"simp"},{"i":"d9bbd52c-6e49-44de-94c2-6b2ca60c265c","t":"送郭秀才","a":"顧況","d":"唐","g":"短诗","p":["故人曾任丹徒令，買得青山擬獨耕。","不作草堂招遠客，却將垂柳借啼鶯。"],"s":"mixed","f":"simp"},{"i":"5372fb27-5a56-4669-85c2-1c418a0f2330","t":"宮詞","a":"顧況","d":"唐","g":"七言绝句","p":["長樂宮連上苑春，玉樓金殿豔歌新。","君門一入無由出，唯有宮鶯得見人。"],"s":"trad","f":"simp"},{"i":"78640ca3-a8de-4f88-bdf6-543291b41a66","t":"悼稚","a":"顧況","d":"唐","g":"短诗","p":["稚子比來騎竹馬，猶疑只在屋東西。","莫言道者無悲事，曾聽巴猿向月啼。"],"s":"trad","f":"simp"},{"i":"0f0fa394-0bb8-419b-8dd8-1e027ec081a3","t":"山僧蘭若","a":"顧況","d":"唐","g":"短诗","p":["絕頂茅庵老此生，寒雲孤木伴經行。","世人那得知幽徑，遙向青峰禮磬聲。"],"s":"trad","f":"simp"},{"i":"47b0116c-2801-4d4c-a723-8ca10f1c4f92","t":"句","a":"顧況","d":"唐","g":"古体","p":["崦合桃花水，窗鳴柳谷泉。","頹垣化爲陂，陸地堪乘舟。","汀洲渺渺江籬短，疑是疑非兩斷腸。","巫峽朝雲暮不歸，洞庭春水晴空滿。","龍吟四澤欲興雨，鳳引九雛警宿烏。","新婦磯邊月明，女兒浦口潮平。"],"s":"mixed","f":"simp"},{"i":"8e61bd73-2066-410f-88f8-ec41840eeee7","t":"發南康夜泊灨石中","a":"耿湋","d":"唐","g":"古体","p":["倦客乘歸舟，春溪杳將暮。","羣林結暝色，孤泊有佳趣。","夜山轉長江，赤月吐深樹。","颯颯松上吹，泛泛花間露。","險石俯潭渦，跳湍礙沿泝。","豈唯垂堂戒，兼以臨深懼。","稍出回雁峰，明登斬蛟柱。","連雲向重山，杳未見鍾路。"],"s":"mixed","f":"simp"},{"i":"209afb70-f536-43bb-ae56-c7570238e31b","t":"過王山人舊居","a":"耿湋","d":"唐","g":"短诗","p":["故宅春山中，來逢夕陽入。","汲少井味變，開稀戶樞澀。","樹朽鳥不栖，階閑雲自濕。","先生何處去，惆悵空獨立。"],"s":"mixed","f":"simp"},{"i":"b8822c39-6342-4a93-beac-06eaad45d8f4","t":"晚次昭應","a":"耿湋","d":"唐","g":"短诗","p":["落日向林路，東風吹麥隴。","藤草蔓古渠，牛羊下荒冢。","驪宮戶久閉，溫谷泉長湧。","爲問全盛時，何人最榮寵。"],"s":"mixed","f":"simp"},{"i":"d90307e8-fc70-4353-a2d4-cf008322dde7","t":"聽早蟬歌","a":"耿湋","d":"唐","g":"古体","p":["蟬鳴兮夕曛，聲和兮夏雲。","白日兮將短，秋意兮已滿。","乍悲鳴兮欲長，猶嘶澀兮多斷。","風蕭蕭兮轉清，韻嘒嘒兮初成。","依婆娑之古樹，思遼落之荒城。","閑院支頤，深林倚策。","猶惆悵而無語，鬢星星而已白。"],"s":"trad","f":"simp"},{"i":"2db18954-20bd-4410-b595-49d8f32b8d5e","t":"蘆花動","a":"耿湋","d":"唐","g":"短诗","p":["連素穗，翻秋氣，細節疎莖任長吹。","共作月中聲，孤舟發鄉思。"],"s":"trad","f":"simp"},{"i":"d6820c44-408f-46be-938f-dc372e44eb17","t":"賦得寒蛩","a":"耿湋","d":"唐","g":"短诗","p":["爾誰造，鳴何早，趯趯連聲徧階草。","復與夜雨和，遊人聽堪老。"],"s":"trad","f":"simp"},{"i":"f10cccfc-93f2-45be-808c-7b327d8a5807","t":"宣城逢張二南史","a":"耿湋","d":"唐","g":"短诗","p":["全家宛陵客，文雅世難逢。","寄食年將老，干時計未從。","秋來句曲水，雨後敬亭峯。","西北長安遠，登臨恨幾重。"],"s":"mixed","f":"simp"},{"i":"64b9d6dd-2c1a-4cfe-a0e5-bc43e0b7f585","t":"題童子寺","a":"耿湋","d":"唐","g":"短诗","p":["半偈留何處，全身棄此中。","雨餘沙塔壞，月滿雪山空。","聳剎臨回磴，朱樓間碧叢。","朝朝日將暮，長對晉陽宮。"],"s":"trad","f":"simp"},{"i":"9ac28964-b002-4665-a07d-3c04899ec754","t":"夏日寄東溪隱者","a":"耿湋","d":"唐","g":"短诗","p":["日華浮野水，草色合遙空。","處處山依舊，年年事不同。","閑田孤壘外，暑雨片雲中。","惆悵多塵累，無由訪釣翁。"],"s":"trad","f":"simp"},{"i":"102f802b-bc9f-4d5b-becf-9484e98317eb","t":"之江淮留別京親故","a":"耿湋","d":"唐","g":"短诗","p":["長雲迷一雁，漸遠向南聲。","已帶千霜鬢，初爲萬里行。","繁蟲滿夜草，連雨暗秋城。","前路諸侯貴，何人重客卿。"],"s":"mixed","f":"simp"},{"i":"0d07749c-1d5d-4233-94f1-2780ee059be6","t":"太原送許侍御出幕歸東都","a":"耿湋","d":"唐","g":"短诗","p":["昔隨劉越石，今日獨歸時。","汾水風煙冷，幷州花木遲。","荒庭增別夢，野雨失行期。","莫向山陽過，隣人夜笛悲。"],"s":"trad","f":"simp"},{"i":"aff8feec-b805-46d8-ade9-9cf59570b91f","t":"華州客舍奉和崔端公春城曉望","a":"耿湋","d":"唐","g":"短诗","p":["不語看芳徑，悲春嬾獨行。","向人微月在，報雨早霞生。","貧病催年齒，風塵掩姓名。","賴逢驄馬客，郢曲緩羇情。"],"s":"trad","f":"simp"},{"i":"8fdd485a-d24c-40b3-846c-8f4ebf79dcc4","t":"題清蘿翁雙泉","a":"耿湋","d":"唐","g":"短诗","p":["側弁向清漪，門中夕照移。","異源生暗石，疊響落秋池。","葉擁沙痕沒，流回草蔓隨。","泠泠無限意，不獨遠公知。"],"s":"trad","f":"simp"},{"i":"e32d79ae-1339-4a75-b9cd-fb3e2dc37d5d","t":"酬李文","a":"耿湋","d":"唐","g":"短诗","p":["落照長楊苑，秋天渭水濱。","初飛萬木葉，又長一年人。","貧病仍爲客，艱虞更問津。","多慙惠然意，今日肯相親。"],"s":"mixed","f":"simp"},{"i":"f43953a9-cc58-4d6f-b3a4-4382e30c2f70","t":"贈嚴維","a":"耿湋","d":"唐","g":"短诗","p":["許詢清論重，寂寞住山陰。","野路接寒寺，閑門當古林。","海田秋熟早，湖水夜漁深。","世上窮通理，誰人奈此心。"],"s":"trad","f":"simp"},{"i":"4ceed844-05e4-493f-a345-b26e9230b080","t":"春日題苗發竹亭","a":"耿湋","d":"唐","g":"短诗","p":["春亭及策上，郎吏謝玄暉。","閑詠疎篁近，高眠遠岫微。","偏宜留野客，暫得解朝衣。","猶憶東溪裏，雷雲掩故扉。"],"s":"mixed","f":"simp"},{"i":"a9dcb041-8bd0-4676-9c21-e8668bd4d033","t":"題孝子陵","a":"耿湋","d":"唐","g":"短诗","p":["荒墳秋陌上，霜露正霏霏。","松柏自成拱，苫廬長不歸。","浮埃積蓬鬢，流血在麻衣。","何必曾參傳，千年至行稀。"],"s":"trad","f":"simp"},{"i":"b4e7cec1-f391-4b59-a09e-7815b6675fff","t":"題莊上人房","a":"耿湋","d":"唐","g":"短诗","p":["不語焚香坐，心知道已成。","流年衰此世，定力見他生。","暮雪餘春冷，寒燈續晝明。","尋常五侯至，敢望下階迎。"],"s":"trad","f":"simp"},{"i":"45047fc8-5ad9-4690-ba4b-7569476147b1","t":"宋中","a":"耿湋","d":"唐","g":"短诗","p":["日暮黃雲合，年深白骨稀。","舊村喬木在，秋草遠人歸。","廢井莓苔厚，荒田路徑微。","唯餘近山色，相對似依依。"],"s":"trad","f":"simp"},{"i":"8cdf127d-5b6d-4007-abf8-06b9c7519951","t":"秋夜思歸","a":"耿湋","d":"唐","g":"短诗","p":["來時猶暑服，今已露漫漫。","多雨逢初霽，深秋生夜寒。","投人心似切，爲客事皆難。","何處無留滯，誰能暫問看。"],"s":"mixed","f":"simp"},{"i":"11e7bd38-4c1f-44bc-a488-c1fd8ac4b9fa","t":"送李端","a":"耿湋","d":"唐","g":"短诗","p":["世上許劉楨，洋洋風雅聲。","客來空改歲，歸去未成名。","遠近天初暮，關河雪半晴。","空懷諫書在，回首戀承明。"],"s":"trad","f":"simp"},{"i":"30927692-01e2-485b-9429-752ad939be03","t":"送崔明府赴青城","a":"耿湋","d":"唐","g":"短诗","p":["清冬賓御出，蜀道翠微間。","遠霧開羣壑，初陽照近關。","霜潭浮紫菜，雪棧繞青山。","當似遺民去，柴桑政自閑。"],"s":"mixed","f":"simp"},{"i":"2c48ce10-3a5a-429d-9bda-9f9969467ce5","t":"送王將軍出塞","a":"耿湋","d":"唐","g":"短诗","p":["漢家邊事重，竇憲出臨戎。","絕漠秋山在，陽關舊路通。","列營依茂草，吹角向高風。","更就燕然石，行看奏虜功。"],"s":"trad","f":"simp"},{"i":"37654f5b-fbaf-4436-96e5-3c35fd80c9ba","t":"雨中留別","a":"耿湋","d":"唐","g":"短诗","p":["東西無定客，風雨未休時。","憫默此中別，飄零何處期。","青山違舊隱，白髮入新詩。","歲歲迷津路，生涯漸可悲。"],"s":"trad","f":"simp"},{"i":"b244fa50-b7bf-4901-b030-464f18c1c455","t":"送楊將軍","a":"耿湋","d":"唐","g":"短诗","p":["一身良將後，萬里討烏孫。","落日邊陲靜，秋風鼓角喧。","遠山當磧路，茂草向營門。","生死酬恩寵，功名豈敢論。"],"s":"mixed","f":"simp"},{"i":"ecbd9ad4-caee-4838-bbdf-0dee571d4a62","t":"送夏侯審遊蜀","a":"耿湋","d":"唐","g":"短诗","p":["暮峰和玉壘，回望不通秦。","更問蜀城路，但逢巴語人。","石林鶯囀曉，板屋月明春。","若訪嚴夫子，無嫌卜肆貧。"],"s":"trad","f":"simp"},{"i":"20f79063-78b0-4a87-a9cd-c196a9496474","t":"送張侍御赴郴州別駕","a":"耿湋","d":"唐","g":"短诗","p":["佐郡人難料，分襟日復斜。","一帆隨遠水，百口過長沙。","明月江邊夜，平陵夢裏家。","王孫對芳草，愁思杳無涯。"],"s":"mixed","f":"simp"},{"i":"c8d60923-6a4b-4d83-a8a4-357971ac8a9e","t":"送苗贇赴陽翟丞","a":"耿湋","d":"唐","g":"短诗","p":["夕陽秋草上，去馬弟兄看。","年少初辭闕，時危遠效官。","山行獨夜雨，旅宿二陵寒。","詩興生何處，嵩陽羽客壇。"],"s":"trad","f":"simp"},{"i":"5f27426c-86f1-41bf-ab9f-91830376df53","t":"送絳州郭參軍","a":"耿湋","d":"唐","g":"短诗","p":["遠事諸侯出，青山古晉城。","連行麴水閣，獨入議中兵。","夜雨新田濕，春風曙角鳴。","人傳府公政，記室有參卿。"],"s":"trad","f":"simp"},{"i":"612964e5-7287-489d-b2c2-5a5d40f3a7c4","t":"常州留別","a":"耿湋","d":"唐","g":"短诗","p":["萬里南天外，求書禹穴間。","往來成白首，旦暮見青山。","夜浦涼雲過，秋塘好月閑。","殷勤陽羨桂，別此幾時攀。"],"s":"mixed","f":"simp"},{"i":"44bc39df-233c-4668-87af-6ad92c897c17","t":"關山月","a":"耿湋","d":"唐","g":"短诗","p":["月明邊徼靜，戍客望鄉時。","塞古柳衰盡，關寒榆發遲。","蒼蒼萬里道，戚戚十年北。","今夜青樓上，還應照所思。"],"s":"mixed","f":"simp"},{"i":"142a8072-b662-48d1-90b3-a11f6609c0db","t":"代宋州將淮上乞師","a":"耿湋","d":"唐","g":"短诗","p":["脣齒幸相依，危亡故遠歸。","身輕百戰出，家在數重圍。","上將堅深壘，殘兵鬬落暉。","常聞鐵劒利，早晚借餘威。"],"s":"mixed","f":"simp"}]