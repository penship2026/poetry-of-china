[{"i":"f904d8e2-1cf4-4e4e-bbaa-1111e07063c2","t":"秋日望倚帝山","a":"吳筠","d":"唐","g":"古体","p":["楚服多奇山，靈表先倚帝。","孤秀白雲裏，青冥何崇麗。","秋天已晴朗，晚日更澄霽。","遠峰列在目，杳與神襟契。","倏忽遺世間，宛如再登詣。","伊予抱斯志，代處人煙閉。","何事牽俗網，悠然負芝桂。","朅來從隱淪，式保羨門計。"],"s":"mixed","f":"simp"},{"i":"6719377f-8be8-4c5e-b5f7-2bb9be74d1ba","t":"薔薇花","a":"李冶","d":"唐","g":"短诗","p":["翠融紅綻渾無力，斜倚欄干似詫人。","深處最宜香惹蝶，摘時兼恐焰燒春。","當空巧結玲瓏帳，著地能鋪錦繡裀。","最好凌晨和露看，碧紗窗外一枝新。"],"s":"mixed","f":"simp"},{"i":"e5cb1c78-9034-4076-85c4-529968ac34a5","t":"柳","a":"李冶","d":"唐","g":"短诗","p":["最愛纖纖曲水濱，夕陽移影過青蘋。","東風又染一年綠，楚客更傷千里春。","低葉已藏依岸櫂，高枝應閉上樓人。","舞腰漸重煙光老，散作飛綿惹翠裀。"],"s":"trad","f":"simp"},{"i":"df549d8e-42c9-480e-870e-e850117366e5","t":"好時光","a":"明皇帝","d":"唐","g":"短诗","p":["寶髻偏宜宮樣，蓮臉嫩，體紅香。","眉黛不須張敞畫，天教入鬢長。","莫倚傾國貌，嫁取箇，有情郎。","彼此當年少，莫負好時光。"],"s":"trad","f":"simp"},{"i":"83d3c6fd-88ac-4ca0-9562-d04667679278","t":"巫山一段雲 一","a":"昭宗皇帝","d":"唐","g":"短诗","p":["縹緲雲間質，盈盈波上身。","袖羅斜舉動埃塵，明豔不勝春。","翠鬢晚妝煙重，寂寂陽臺一夢。","冰眸蓮臉見長新，巫峽更何人。"],"s":"trad","f":"simp"},{"i":"e3532bea-0327-47f6-945c-87158ad3b99d","t":"巫山一段雲 二","a":"昭宗皇帝","d":"唐","g":"短诗","p":["蝶舞棃園雪，鶯啼柳帶煙。","小池殘日豔陽天，苧蘿山又山。","青鳥不來愁絕，忍看鴛鴦雙結。","春風一等少年心，閑情恨不禁。"],"s":"mixed","f":"simp"},{"i":"130b361d-eb7c-4795-a133-182b70d16fe0","t":"菩薩蠻 一","a":"昭宗皇帝","d":"唐","g":"短诗","p":["登樓遙望秦宮殿，茫茫只見雙飛燕。","渭水一條流，千山與萬丘。","遠煙籠碧樹，陌上行人去。","安得有英雄，迎歸大內中。"],"s":"trad","f":"simp"},{"i":"cbc32a17-7b68-4c01-babe-d1a794540564","t":"菩薩蠻 二","a":"昭宗皇帝","d":"唐","g":"短诗","p":["飄飄且在三峰下，秋風往往堪霑灑。","腸斷憶仙宮，朦朧煙霧中。","思夢時時睡，不語長如醉。","早晚是歸期，蒼穹知不知。"],"s":"trad","f":"simp"},{"i":"6c9a932b-bd56-4e72-9ab0-fc8b319616a4","t":"一葉落","a":"後唐莊宗","d":"唐","g":"短诗","p":["一葉落，搴朱箔，此時景物正蕭索。","畫樓月影寒，西風吹羅幕。","吹羅幕，往事思量著。"],"s":"trad","f":"simp"},{"i":"8ab387cd-6e1b-4cb9-aa88-5e0113b45a21","t":"如夢令","a":"後唐莊宗","d":"唐","g":"短诗","p":["曾宴桃源深洞，一曲清歌舞鳳。","長記別伊時，和淚出門相送。","如夢，如夢，殘月落花煙重。"],"s":"trad","f":"simp"},{"i":"f903077a-e55d-4f38-82b9-5ac800650a2e","t":"陽臺夢","a":"後唐莊宗","d":"唐","g":"短诗","p":["薄羅衫子金泥縫，困纖腰怯銖衣重。","笑迎移步小蘭叢，嚲金翹玉鳳。","嬌多情脈脈，羞把同心撚弄。","楚天雲雨却相和，又入陽臺夢。"],"s":"mixed","f":"simp"},{"i":"c0c41411-2fdb-49c1-97ce-1f7e298fb6b6","t":"歌頭","a":"後唐莊宗","d":"唐","g":"古体","p":["賞芳春，暖風飄箔。","鶯啼綠樹，輕煙籠晚閣。","杏桃紅，開繁萼。","靈和殿，禁柳千行斜，金絲絡。","夏雲多，奇峰如削，紈扇動微涼，輕綃薄。","梅雨霽，火雲爍。","臨水檻，永日逃繁暑，泛觥酌。","露華濃，冷高梧。","彫萬葉，一霎晚風。","蟬聲新雨歇，惜惜此光陰，如流水，東籬菊殘時，歎蕭索。","繁陰積，歲時暮。","景難留，不覺朱顏失却。","好容光，且且須呼賓友。","西園長宵，讌雲謠。","歌皓齒，且行樂。"],"s":"mixed","f":"simp"},{"i":"15ec3147-5815-4d39-8b56-5de943732033","t":"浣溪沙","a":"南唐嗣主李璟","d":"唐","g":"短诗","p":["風壓輕雲貼水飛，乍晴池館燕爭泥，沈郎多病不勝衣。","沙上未聞鴻雁信，竹間時聽鷓鴣啼，此情惟有落花知。"],"s":"trad","f":"simp"},{"i":"85ae4de5-86e8-4289-b094-a54a38026f38","t":"攤破浣溪沙 一","a":"南唐嗣主李璟","d":"唐","g":"短诗","p":["菡萏香銷翠葉殘，西風愁起綠波間。","還與韶光共顦顇，不堪看。","細雨夢回雞塞遠，小樓吹徹玉笙寒。","多少淚珠何限恨，倚闌干。"],"s":"mixed","f":"simp"},{"i":"f0df0cf6-8562-4040-9bcb-b4b98de81d78","t":"攤破浣溪沙 二","a":"南唐嗣主李璟","d":"唐","g":"短诗","p":["手卷真珠上玉鉤，依前春恨鎖重樓。","風裏落花誰是主，思悠悠。","青鳥不傳雲外信，丁香空結雨中愁。","回首淥波三峽暮，接天流。"],"s":"mixed","f":"simp"},{"i":"4b2dbf7b-accc-43ff-9417-01b63042eefd","t":"漁父 一","a":"後主煜","d":"唐","g":"短诗","p":["浪花有意千里雪，桃花無言一隊春。","一壺酒，一竿身，快活如儂有幾人。"],"s":"trad","f":"simp"},{"i":"6b181549-9b0b-4b8a-acbd-850117557c39","t":"漁父 二","a":"後主煜","d":"唐","g":"短诗","p":["一櫂春風一葉舟，一綸繭縷一輕鉤。","花滿渚，酒滿甌，萬頃波中得自由。"],"s":"trad","f":"simp"},{"i":"6436c19b-b93a-41f9-96ba-8f6cc02e9012","t":"憶江南 一","a":"後主煜","d":"唐","g":"短诗","p":["多少恨，昨夜夢魂中。","還似舊時遊上苑，車如流水馬如龍，花月正春風。"],"s":"trad","f":"simp"},{"i":"fc5d6d53-e6aa-4e1a-8ce5-98069da65a40","t":"憶江南 二","a":"後主煜","d":"唐","g":"短诗","p":["多少淚，霑袖復橫頤。","心事莫將和淚滴，鳳笙休向月明吹，腸斷更無疑。"],"s":"trad","f":"simp"},{"i":"3ebe04ef-6213-4f12-b696-958a955c088e","t":"憶江南 三","a":"後主煜","d":"唐","g":"短诗","p":["閑夢遠，南國正芳春。","船上管弦江面綠，滿城飛絮混輕塵，愁殺看花人。"],"s":"mixed","f":"simp"},{"i":"d887dc7a-137b-4b39-9943-a012cb397f56","t":"憶江南 四","a":"後主煜","d":"唐","g":"短诗","p":["閑夢遠，南國正清秋。","千里江山寒色暮，蘆花深處泊孤舟，笛在月明樓。"],"s":"trad","f":"simp"},{"i":"087babd8-0706-4fa7-a114-1b60a189d1de","t":"擣練子 一","a":"後主煜","d":"唐","g":"短诗","p":["深院靜，小庭空，斷續寒砧斷續風。","無奈夜長人不寐，數聲和月到簾櫳。"],"s":"trad","f":"simp"},{"i":"324936b5-b8c7-4445-aec2-0ced76d124fe","t":"擣練子 二","a":"後主煜","d":"唐","g":"短诗","p":["雲鬟亂，晚妝殘，帶恨眉兒遠岫攢。","斜托香顋春筍嬾，爲誰和淚倚闌干。"],"s":"mixed","f":"simp"},{"i":"6cf494bc-da88-441b-8190-f51a1cd33239","t":"相見歡 一","a":"後主煜","d":"唐","g":"短诗","p":["林花謝了春紅，太悤悤。","無奈朝來寒雨，晚來風。","胭脂淚，相留醉，幾時重。","自是人生長恨，水長東。"],"s":"trad","f":"simp"},{"i":"fed4281e-1e15-41dd-a156-b4d97553b5be","t":"相見歡 二","a":"後主煜","d":"唐","g":"短诗","p":["無言獨上西樓，月如鉤。","寂寞梧桐深院，鎖清秋。","翦不斷，理還亂，是離愁。","別是一般滋味，在心頭。"],"s":"trad","f":"simp"},{"i":"25bc24c7-fde4-4be6-8d0e-a16b1525ea4e","t":"長相思 一","a":"後主煜","d":"唐","g":"短诗","p":["一重山，兩重山。","山遠天高煙水寒，相思楓葉丹。","菊花開，菊花殘。","塞雁高飛人未還，一簾風月閑。"],"s":"trad","f":"simp"},{"i":"191e4990-2397-4208-b5e8-39813345f6af","t":"長相思 二","a":"後主煜","d":"唐","g":"短诗","p":["雲一緺，玉一梭。","澹澹衫兒薄薄羅，輕顰雙黛螺。","秋風多，雨如和。","簾外芭蕉三兩窠，夜長人奈何。"],"s":"trad","f":"simp"},{"i":"1d9fc470-fa99-4139-8b5a-321d331c01f3","t":"浣溪沙 一","a":"後主煜","d":"唐","g":"短诗","p":["紅日已高三丈透，金鑪次第添香獸，紅錦地衣隨步皺。","佳人舞點金釵溜，酒惡時拈花蘂齅，別殿遙聞簫鼓奏。"],"s":"trad","f":"simp"},{"i":"11d72852-47c9-4659-971a-9b8b95277122","t":"浣溪沙 二","a":"後主煜","d":"唐","g":"短诗","p":["轉燭飄蓬一夢歸，欲尋陳迹悵人非，天教心願與身違。","待月池臺空逝水，蔭花樓閣漫斜暉，登臨不惜更霑衣。"],"s":"mixed","f":"simp"},{"i":"2d5f5235-966d-42c1-9d59-68d280a7386d","t":"采桑子 一","a":"後主煜","d":"唐","g":"短诗","p":["轆轤金井梧桐晚，幾樹驚秋，晝雨如愁，百尺蝦鬚上玉鉤。","瓊窗春斷雙蛾皺，回首邊頭，欲寄鱗游，九曲寒波不泝流。"],"s":"mixed","f":"simp"},{"i":"c893ac3e-c25e-49e9-afd0-a8bcc3d34f73","t":"采桑子 二","a":"後主煜","d":"唐","g":"短诗","p":["亭前春逐紅英盡，舞態徘徊，細雨霏微，不放雙眉時暫開。","綠窗冷靜芳音斷，香印成灰，可奈情懷，欲睡朦朧入夢來。"],"s":"mixed","f":"simp"},{"i":"eabb0b49-b82e-4047-a130-fa5b687f4948","t":"菩薩蠻 一","a":"後主煜","d":"唐","g":"短诗","p":["花明月暗籠輕霧，今宵好向郎邊去。","剗韤步香階，手提金縷鞋。","畫堂南畔見，一晌偎人顫。","好爲出來難，教君恣意憐。"],"s":"mixed","f":"simp"},{"i":"4a6be65e-27bf-4728-b8a7-95197ab48d07","t":"菩薩蠻 二","a":"後主煜","d":"唐","g":"短诗","p":["蓬萊院閉天台女，畫堂晝寢無人語。","拋枕翠雲光，繡衣聞異香。","潛來珠鎖動，驚覺鴛鴦夢。","慢臉笑盈盈，相看無限情。"],"s":"trad","f":"simp"},{"i":"f2f641d9-18c6-4a1c-89d0-5ddf84704730","t":"菩薩蠻 三","a":"後主煜","d":"唐","g":"短诗","p":["銅簧韻脆鏘寒竹，新聲慢奏移纖玉。","眼色暗相鉤，秋波橫欲流。","雨雲深繡戶，來便諧衷素。","宴罷又成空，夢迷春睡中。"],"s":"trad","f":"simp"},{"i":"72ffbb94-d801-4c39-bf26-75150f2ce7a0","t":"菩薩蠻 四","a":"後主煜","d":"唐","g":"短诗","p":["人生愁恨何能免，消魂獨我情何限。","故國夢重歸，覺來雙淚垂。","高樓誰與上，長記秋晴望。","往事已成空，還如一夢中。"],"s":"trad","f":"simp"},{"i":"e79bf420-dc28-48da-97f9-d3e07b3cb5f6","t":"清平樂","a":"後主煜","d":"唐","g":"短诗","p":["別來春半，觸目愁腸斷。","砌下落梅如雪亂，拂了一身還滿。","雁來音信無憑，路遙歸夢難成。","離恨却如春草，更行更遠還生。"],"s":"mixed","f":"simp"},{"i":"7cf30f0e-9821-4fe2-b899-bc2703f5159d","t":"喜遷鶯","a":"後主煜","d":"唐","g":"短诗","p":["曉月墜，宿雲微，無語枕頻欹。","夢回芳草思依依，天遠雁聲稀。","啼鶯散，餘花亂，寂寞畫堂深院。","片紅休埽儘從伊，留待舞人歸。"],"s":"trad","f":"simp"},{"i":"1c02731a-b355-4a8d-bbb6-1acb8284bf67","t":"阮郎歸","a":"後主煜","d":"唐","g":"短诗","p":["東風吹水日銜山，春來長是閑。","落花狼藉酒闌珊，笙歌醉夢間。","春睡覺，晚妝殘，無人整翠鬟。","留連光景惜朱顏，黃昏獨倚闌。"],"s":"trad","f":"simp"},{"i":"692040b8-0c49-4532-b34c-0046af74232a","t":"錦堂春","a":"後主煜","d":"唐","g":"短诗","p":["昨夜風兼雨，簾幃颯颯秋聲。","燭殘漏滴頻欹枕，起坐不能平。","世事漫隨流水，算來一夢浮生。","醉鄉路穩宜頻到，此外不堪行。"],"s":"trad","f":"simp"},{"i":"70c60aed-dd54-448a-a2da-207469cf71e5","t":"應天長","a":"後主煜","d":"唐","g":"短诗","p":["一鉤初月臨妝鏡，蟬鬢鳳釵慵不整。","重簾靜，層樓迥，惆悵落花風不定。","柳堤芳草徑，夢斷轆轤金井。","昨夜更闌酒醒，春愁過却病。"],"s":"mixed","f":"simp"},{"i":"079eab76-b38a-4a82-8a13-ac00e92b67c0","t":"望遠行","a":"後主煜","d":"唐","g":"短诗","p":["碧砌花光照眼明，朱扉長日鎮長扃。","餘寒欲去夢難成，爐香煙冷自亭亭。","遼陽月，秣陵砧，不傳消息但傳情。","黃金臺下忽然驚，征人歸日二毛生。"],"s":"mixed","f":"simp"},{"i":"377b9884-059e-4076-8104-25857ae7d84e","t":"浪淘沙 一","a":"後主煜","d":"唐","g":"短诗","p":["簾外雨潺潺，春意闌珊。","羅衾不耐五更寒，夢裏不知身是客，一晌貪歡。","獨自暮凭闌，無限江山。","別時容易見時難，流水落花春去也，天上人間。"],"s":"mixed","f":"simp"},{"i":"d9317285-0e91-4c01-8202-d97b2cd5abf4","t":"浪淘沙 二","a":"後主煜","d":"唐","g":"短诗","p":["往事只堪哀，對景難排。","秋風庭院蘚侵階，一桁珠簾閑不卷，終日誰來。","金劒已沈埋，壯氣蒿萊。","晚涼天淨月華開，想得玉樓瑤殿影，空照秦淮。"],"s":"trad","f":"simp"},{"i":"f32e4bf5-94ee-476e-871f-c547e24d1fc1","t":"木蘭花","a":"後主煜","d":"唐","g":"短诗","p":["曉妝初了明肌雪，春殿嬪娥魚貫列。","鳳簫聲斷水雲閑，重按霓裳歌徧徹。","臨風誰更飄香屑，醉拍闌干情未切。","歸時休放燭花紅，待蹋馬蹄清夜月。"],"s":"mixed","f":"simp"},{"i":"5b30f0ee-7708-4caa-b878-17b2fa3dbf65","t":"虞美人 一","a":"後主煜","d":"唐","g":"短诗","p":["風回小院庭蕪綠，柳眼春相續。","凭闌半日獨無言，依舊竹聲新月，似當年。","笙歌未散尊罍在，池面冰初解。","燭明香暗畫樓深，滿鬢清霜殘雪，思難禁。"],"s":"mixed","f":"simp"},{"i":"b769cd89-478e-40af-9cdc-80cdc7423473","t":"虞美人 二","a":"後主煜","d":"唐","g":"短诗","p":["春花秋月何時了，往事知多少。","小樓昨夜又東風，故國不堪回首，月明中。","雕闌玉砌應猶在，只是朱顏改。","問君能有幾多愁，恰似一江春水，向東流。"],"s":"trad","f":"simp"},{"i":"fcd2fbf3-006b-455f-b1c3-e35c2270331a","t":"一斛珠","a":"後主煜","d":"唐","g":"短诗","p":["晚妝初過，沈檀輕注些兒箇，向人微露丁香顆。","一曲清歌，暫引櫻桃破。","羅袖裛殘殷色可，杯深旋被香醪涴，繡牀斜凭嬌無那。","爛嚼紅茸，笑向檀郎唾。"],"s":"mixed","f":"simp"},{"i":"572f4c5e-0cb4-4643-98f9-cfbed581b50e","t":"臨江仙","a":"後主煜","d":"唐","g":"短诗","p":["櫻桃落盡春歸去，蝶飜輕粉雙飛。","子規啼月小樓西，玉鉤羅幕，惆悵暮煙垂。","別巷寂寥人散後，望殘煙草低迷。","爐香閑嫋鳳皇兒，空持羅帶，回首恨依依。"],"s":"trad","f":"simp"},{"i":"cee2c436-21bb-419b-a1c5-dedfa2b9df6b","t":"蝶戀花","a":"後主煜","d":"唐","g":"短诗","p":["遙夜亭臯閑信步，纔過清明，漸覺傷春暮。","數點雨聲風約住，朦朧澹月雲來去。","桃李依依香暗度，誰在鞦韆，笑裏輕輕語。","一片芳心千萬緒，人間沒箇安排處。"],"s":"mixed","f":"simp"},{"i":"efee393d-cdbb-4780-8220-d4c29d69b15e","t":"破陳子","a":"後主煜","d":"唐","g":"短诗","p":["四十年來家國，三千里地山河。","鳳闕龍樓連霄漢，玉樹瓊枝作煙蘿，幾曾識干戈？","一旦歸爲臣虜，沈腰潘鬢銷磨。","最是蒼黃辭廟日，教坊獨奏別離歌，垂淚對宮娥。"],"s":"mixed","f":"simp"},{"i":"cf6d988a-d303-448b-a273-3b5c931a8fea","t":"醉妝詞","a":"蜀主王衍","d":"唐","g":"短诗","p":["者邊走，那邊走，只是尋花柳。","那邊走，者邊走，莫厭金杯酒。"],"s":"mixed","f":"simp"},{"i":"b53c33bc-5951-4623-b974-7da3cea14c00","t":"甘州曲","a":"蜀主王衍","d":"唐","g":"短诗","p":["畫羅裙，能解束。","稱腰身，柳眉桃臉不勝春。","薄媚足精神，可惜淪落在風塵。"],"s":"trad","f":"simp"},{"i":"94abda6b-1345-4fe2-9817-85ca2796bc39","t":"木蘭花","a":"後蜀主孟昶","d":"唐","g":"短诗","p":["冰肌玉骨清無汗，水殿風來暗香滿。","繡簾一點月窺人，欹枕釵橫雲鬢亂。","起來瓊戶啓無聲，時見疎星渡河漢。","屈指西風幾時來，只恐流年暗中換。"],"s":"mixed","f":"simp"},{"i":"a7980a53-95de-40a8-9a87-95dd9c93208d","t":"回波樂","a":"李景伯","d":"唐","g":"短诗","p":["回波爾時酒巵，微臣職在箴規。","侍宴既過三爵，諠譁竊恐非儀。"],"s":"trad","f":"simp"},{"i":"f3c17135-5240-4731-b63e-f2b8f38a4174","t":"回波樂","a":"沈佺期","d":"唐","g":"短诗","p":["回波爾時佺期，流向嶺外生歸。","身名已蒙齒錄，袍笏未復牙緋。"],"s":"trad","f":"simp"},{"i":"e3a3e537-35fb-4b2c-946c-b534996f5027","t":"回波樂","a":"裴談","d":"唐","g":"短诗","p":["回波爾時栲栳，怕婦也是大好。","外邊祗有裴談，內裏無過李老。"],"s":"mixed","f":"simp"},{"i":"411f845b-3a45-4c82-b91a-363d77f4c36f","t":"舞馬詞 一","a":"張說","d":"唐","g":"短诗","p":["萬玉朝宗鳳扆，千金率領龍媒。","眄鼓凝驕蹀躞，聽歌弄影徘徊。"],"s":"trad","f":"simp"},{"i":"a4e4c3a0-ad43-4032-9399-9269529d1445","t":"舞馬詞 二","a":"張說","d":"唐","g":"短诗","p":["天鹿遙徵衛叔，日龍上借羲和。","將共兩驂爭舞，來隨八駿齊歌。"],"s":"trad","f":"simp"},{"i":"5c4d085a-6d18-4a8e-b8a3-9bd113b64202","t":"舞馬詞 三","a":"張說","d":"唐","g":"短诗","p":["綵旄八佾成行，時龍五色因方。","屈膝銜杯赴節，傾心獻壽無疆。"],"s":"trad","f":"simp"},{"i":"da38e39b-fa6d-47f0-a4a6-66254560c765","t":"舞馬詞 四","a":"張說","d":"唐","g":"短诗","p":["帝皁龍駒沛艾，星闌驥子權奇。","騰倚驤洋應節，繁驕接迹不移。"],"s":"mixed","f":"simp"},{"i":"2ec43f54-be64-4219-8f1a-b0234cc347b3","t":"舞馬詞 五","a":"張說","d":"唐","g":"短诗","p":["二聖先天合德，羣靈率土可封。","擊石驂驔紫燕，摐金顧步蒼龍。"],"s":"mixed","f":"simp"},{"i":"3cd4c930-9c6e-48d1-9e99-a11829d26134","t":"舞馬詞 六","a":"張說","d":"唐","g":"短诗","p":["聖君出震應籙，神馬浮河獻圖。","足蹋天庭鼓舞，心將帝樂踟躕。"],"s":"trad","f":"simp"},{"i":"d0927bec-fc6f-4c90-a66c-5c770dd47b1d","t":"蹋歌詞 一","a":"崔液","d":"唐","g":"短诗","p":["綵女迎金屋，仙姬出畫堂。","鴛鴦裁錦袖，翡翠貼花黃。","歌響舞分行，豔色動流光。"],"s":"trad","f":"simp"},{"i":"a41345e0-994a-4afc-af0d-f64fab5f8950","t":"蹋歌詞 二","a":"崔液","d":"唐","g":"短诗","p":["庭際花微落，樓前漢已橫。","金壺催夜盡，羅袖舞寒輕。","樂笑暢歡情，未半著天明。"],"s":"trad","f":"simp"},{"i":"9a305428-c083-4b95-acb1-855ebcd09873","t":"桂殿秋 一","a":"李白","d":"唐","g":"短诗","p":["仙女下，董雙成，漢殿夜涼吹玉笙。","曲終却從仙官去，萬戶千門惟月明。"],"s":"mixed","f":"simp"},{"i":"861a8e22-08c6-4c52-a1f0-bf481d0ccbe7","t":"桂殿秋 二","a":"李白","d":"唐","g":"短诗","p":["河漢女，玉鍊顏，雲軿往往在人間。","九霄有路去無跡，嫋嫋香風生佩環。"],"s":"trad","f":"simp"},{"i":"64d66549-1b3e-4a28-84be-590777c9b5b5","t":"連理枝 一","a":"李白","d":"唐","g":"短诗","p":["雪蓋宮樓閉，羅幕昏金翠。","鬬壓闌干，香心澹薄，梅梢輕倚。","噴寶猊香燼麝煙濃，馥紅綃翠被。"],"s":"mixed","f":"simp"},{"i":"f5e39c65-60fd-49d1-ba82-3f46a6be880d","t":"連理枝 二","a":"李白","d":"唐","g":"短诗","p":["淺畫雲垂帔，點滴昭陽淚。","咫尺宸居，君恩斷絕，似遙千里。","望水晶簾外竹枝寒，守羊車未至。"],"s":"trad","f":"simp"},{"i":"f98b9110-23de-481c-bd87-bcdf2c14d05c","t":"菩薩蠻","a":"李白","d":"唐","g":"短诗","p":["平林漠漠煙如織，寒山一帶傷心碧。","暝色入高樓，有人樓上愁。","玉階空佇立，宿鳥歸飛急。","何處是歸程，長亭更短亭。"],"s":"trad","f":"simp"},{"i":"35f9a3a0-9e54-4450-930d-f6bdc051ba1f","t":"憶秦娥","a":"李白","d":"唐","g":"短诗","p":["簫聲咽，秦娥夢斷秦樓月。","秦樓月，年年柳色，灞陵傷別。","樂遊原上清秋節，咸陽古道音塵絕。","音塵絕，西風殘照，漢家陵闕。"],"s":"mixed","f":"simp"},{"i":"eae8a09d-b5b5-42bc-b196-2853ba90fc32","t":"清平樂 一","a":"李白","d":"唐","g":"短诗","p":["禁庭春晝，鶯羽披新繡。","百草巧求花下鬬，祗賭珠璣滿斗。","日晚却理殘妝，御前閑舞霓裳。","誰道腰肢窈窕，折旋笑得君王。"],"s":"mixed","f":"simp"},{"i":"12a47c99-b1dd-47cf-8a1a-d0aed438ee47","t":"清平樂 二","a":"李白","d":"唐","g":"短诗","p":["禁闈秋夜，月探金窗罅。","玉帳鴛鴦噴蘭麝，時落銀燈香灺。","女伴莫話孤眠，六宮羅綺三千。","一笑皆生百媚，宸衷教在誰邊。"],"s":"trad","f":"simp"},{"i":"32654d69-48c7-4d34-ab41-939387e218f3","t":"清平樂 三","a":"李白","d":"唐","g":"短诗","p":["煙深水闊，音信無由達。","惟有碧天雲外月，偏照懸懸離別。","盡日感事傷懷，愁眉似鎖難開。","夜夜長留半被，待君魂夢歸來。"],"s":"trad","f":"simp"},{"i":"a56513d2-5de0-4941-b2f1-e0d33d681f20","t":"清平樂 四","a":"李白","d":"唐","g":"短诗","p":["鸞衾鳳褥，夜夜常孤宿。","更被銀臺紅蠟燭，學妾淚珠相續。","花貌些子時光，拋人遠泛瀟湘。","欹枕悔聽寒漏，聲聲滴斷愁腸。"],"s":"trad","f":"simp"},{"i":"b1815804-563b-47ad-ace0-013a657a2454","t":"清平樂 五","a":"李白","d":"唐","g":"短诗","p":["畫堂晨起，來報雪花墜。","高卷簾櫳看佳瑞，皓色遠迷庭砌。","盛氣光引爐煙，素草寒生玉佩。","應是天仙狂醉，亂把白雲揉碎。"],"s":"trad","f":"simp"},{"i":"a651660b-9ffb-4a39-bade-6f08a9a191c8","t":"欸乃曲 一","a":"元結","d":"唐","g":"短诗","p":["偶存名跡在人間，順俗與時未安閑。","來謁大官兼問政，扁舟却入九疑山。"],"s":"mixed","f":"simp"},{"i":"825b4d77-f788-4fe9-8d4c-d03295a8d129","t":"欸乃曲 二","a":"元結","d":"唐","g":"短诗","p":["湘江二月春水平，滿月和風宜夜行。","唱橈欲過平陽戍，守吏相呼問姓名。"],"s":"trad","f":"simp"},{"i":"47b69d9d-22a9-4cd2-8034-4a66ba168d04","t":"欸乃曲 三","a":"元結","d":"唐","g":"短诗","p":["千里楓林煙雨深，無朝無暮有猨吟。","倚橈靜聽曲中意，好似雲山韶濩音。"],"s":"trad","f":"simp"},{"i":"cafd6c88-e504-478a-817d-5fc1928fe196","t":"欸乃曲 四","a":"元結","d":"唐","g":"短诗","p":["零陵郡北湘水東，浯溪形勝滿湘中。","溪口石顛堪自逸，誰能相伴作漁翁。"],"s":"trad","f":"simp"},{"i":"319a4c84-ee02-4d8c-b2db-a10bb20d7b1f","t":"欸乃曲 五","a":"元結","d":"唐","g":"短诗","p":["下瀧船似入深淵，上瀧船似欲升天。","瀧南始到九疑郡，應絕高人乘興船。"],"s":"mixed","f":"simp"},{"i":"d7916ae3-233e-46e1-97e1-7d561fb204f9","t":"漁父 一","a":"張志和","d":"唐","g":"短诗","p":["西塞山前白鷺飛，桃花流水鱖魚肥。","青箬笠，綠蓑衣，斜風細雨不須歸。"],"s":"trad","f":"simp"},{"i":"ec66e4c3-c21a-4d18-99f1-a21d0efcb1d7","t":"漁父 二","a":"張志和","d":"唐","g":"短诗","p":["釣臺漁父褐爲裘，兩兩三三舴艋舟。","能縱櫂，慣乘流，長江白浪不曾憂。"],"s":"mixed","f":"simp"},{"i":"6d4c05b5-a879-4d95-b890-8774117b6f9f","t":"漁父 三","a":"張志和","d":"唐","g":"短诗","p":["霅溪灣裏釣魚翁，舴艋爲家西復東。","江上雪，浦邊風，笑著荷衣不歎窮。"],"s":"mixed","f":"simp"},{"i":"0f61f362-16e8-495e-bfbd-5914a758f42f","t":"漁父 四","a":"張志和","d":"唐","g":"短诗","p":["松江蟹舍主人歡，菰飯蓴羹亦共餐。","楓葉落，荻花乾，醉宿漁舟不覺寒。"],"s":"trad","f":"simp"},{"i":"37f68ce7-c771-45ee-96cc-c9107e641ec1","t":"漁父 五","a":"張志和","d":"唐","g":"短诗","p":["青草湖中月正圓，巴陵漁父櫂歌連。","釣車子，橛頭船，樂在風波不用仙。"],"s":"trad","f":"simp"},{"i":"d2d0b16b-1d7b-4735-8773-324bf0191675","t":"漁父","a":"張松齡","d":"唐","g":"短诗","p":["樂是風波釣是閑，草堂松檜已勝攀。","太湖水，洞庭山，狂風浪起且須還。"],"s":"trad","f":"simp"},{"i":"0a815f47-0331-40fe-9500-3a1b698b2deb","t":"章臺柳","a":"韓翃","d":"唐","g":"短诗","p":["章臺柳，章臺柳，往日依依今在否？縱使長條似舊垂，也應攀折他人手。"],"s":"trad","f":"simp"},{"i":"c467bd98-a27b-4810-8178-38eb61269796","t":"三臺 一","a":"韋應物","d":"唐","g":"短诗","p":["一年一年老去，明日後日花開。","未報長安平定，萬國豈得銜杯。"],"s":"trad","f":"simp"},{"i":"a4a3ccdd-a8e6-45da-afcc-12a1db60f2c5","t":"三臺 二","a":"韋應物","d":"唐","g":"短诗","p":["冰泮寒塘水綠，雨餘百草皆生。","朝來衡門無事，晚下高齋有情。"],"s":"trad","f":"simp"},{"i":"ee3f8beb-8c76-4c7f-930c-ce1d566cced3","t":"調笑令 一","a":"韋應物","d":"唐","g":"短诗","p":["胡馬，胡馬，遠放燕支山下。","跑沙跑雪獨嘶，東望西望路迷。","迷路，迷路，邊草無窮日暮。"],"s":"trad","f":"simp"},{"i":"ab3d4352-40f7-4d0c-9809-d591da9f2c45","t":"調笑令 二","a":"韋應物","d":"唐","g":"短诗","p":["河漢，河漢，曉挂秋城漫漫。","愁人起望相思，塞北江南別離。","離別，離別，河漢雖同路絕。"],"s":"mixed","f":"simp"},{"i":"4826c899-c283-4054-84a9-6a290c6c62db","t":"三臺 一","a":"王建","d":"唐","g":"短诗","p":["魚藻池邊射鴨，芙蓉苑裏看花。","日色柘袍相似，不著紅鸞扇遮。"],"s":"mixed","f":"simp"},{"i":"fc2e8477-7436-4e4c-9b8c-bf242a325691","t":"三臺 二","a":"王建","d":"唐","g":"短诗","p":["池北池南草綠，殿前殿後花紅。","天子千秋萬歲，未央明月清風。"],"s":"trad","f":"simp"},{"i":"55ea44f4-fd09-4fc2-a06c-b0012ff44281","t":"三臺 三","a":"王建","d":"唐","g":"短诗","p":["揚州橋邊小婦，長干市裏商人。","三年不得消息，各自拜鬼求神。"],"s":"mixed","f":"simp"},{"i":"a6d96ec6-f3d5-429e-9e29-52c108f34561","t":"三臺 四","a":"王建","d":"唐","g":"短诗","p":["青草湖邊草色，飛猨嶺上猨聲。","萬里三湘客到，有風有雨人行。"],"s":"mixed","f":"simp"},{"i":"4325ee75-6b58-4d3e-b6ad-3b3df49f7f24","t":"三臺 五","a":"王建","d":"唐","g":"短诗","p":["樹頭花落花開，道上人去人來。","朝愁暮愁即老，百年幾度三臺。"],"s":"trad","f":"simp"},{"i":"50b9cd44-6c49-4e7e-95d0-ef47fc4a00a0","t":"三臺 六","a":"王建","d":"唐","g":"短诗","p":["鬬身彊健且爲，頭白齒落難追。","準擬百年千歲，能得幾許多時。"],"s":"mixed","f":"simp"},{"i":"53640410-5611-4d86-83ed-c0aa7f2e4930","t":"調笑令 一","a":"王建","d":"唐","g":"乐府","p":["團扇，團扇，美人竝來遮面。","玉顏顦顇三年，誰復商量管弦。","弦管，弦管，春草昭陽路斷。"],"s":"mixed","f":"simp"},{"i":"1b5ad1b1-6a9c-492b-860b-936e922323da","t":"調笑令 二","a":"王建","d":"唐","g":"短诗","p":["胡蝶，胡蝶，飛上金枝玉葉。","君前對舞春風，百葉桃花樹紅。","紅樹，紅樹，燕語鶯啼日暮。"],"s":"trad","f":"simp"},{"i":"7324810b-af18-4a39-af66-bbf93c45f247","t":"調笑令 三","a":"王建","d":"唐","g":"短诗","p":["羅袖，羅袖，暗舞春風依舊。","遙看歌舞玉樓，好日新妝坐愁。","愁坐，愁坐，一世虛生虛過。"],"s":"trad","f":"simp"}]