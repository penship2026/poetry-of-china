[{"i":"c-ec858f110b3e","t":"鼓笛令","a":"黄庭坚","d":"宋","g":"词","p":["见来两个宁宁地。","眼厮打、过如拳踢。","恰得尝些香甜底。","苦杀人、遭谁调戏。","腊月望州坡上地。","冻著你、影亸村鬼。","你但那些一处睡。","烧沙糖、管好滋味。"]},{"i":"c-1721613a8d14","t":"鼓笛令","a":"黄庭坚","d":"宋","g":"词","p":["见来便觉情於我。","厮守著、新来好过。","人道他家有婆婆。","与一口、管教�拍ァ�","副靖传语木大。","鼓儿里、且打一和。","更有些儿得处囉。","烧沙糖、香药添和。"]},{"i":"c-a033b5dfc842","t":"好女儿","a":"黄庭坚","d":"宋","g":"词","p":["春去几时还。","问桃李无言。","燕子归栖风劲，梨雪乱西园。","唯有月婵娟。","似人人、难近如天。","愿教清影常相见，更乞取团圆。"]},{"i":"c-e0d1420775d9","t":"好女儿","a":"黄庭坚","d":"宋","g":"词","p":["粉泪一行行。","啼破晓来妆。","懒系酥胸罗带，羞见绣鸳鸯。","拟待不思量。","怎奈向、目下恓惶。","假饶来后，教人见了，却去何妨。"]},{"i":"c-71d8153c1b2c","t":"采桑子","a":"黄庭坚","d":"宋","g":"词","p":["虚堂密候参同火，梨枣枝繁。","深锁三关。","不要樊姬与小蛮。","遥知风雨更阑夜，犹梦巫山。","浓丽清闲。","晓镜新梳十二鬟。"]},{"i":"c-628f319742fa","t":"采桑子","a":"黄庭坚","d":"宋","g":"词","p":["投荒万里无归路，雪点鬓繁。","度鬼门关。","已拼儿童作楚蛮。","黄云苦竹啼归去，绕荔枝山。","蓬户身闲。","歌板谁家教小鬟。"]},{"i":"c-8a71c5316282","t":"采桑子","a":"黄庭坚","d":"宋","g":"词","p":["樱桃著子如红豆，不管春归。","闻道开时。","蜂惹香须蝶惹衣。","楼台灯火明珠翠，酒恋歌迷。","醉玉东西。","少个人人暖被携。"]},{"i":"c-864211c3789c","t":"采桑子","a":"黄庭坚","d":"宋","g":"词","p":["城南城北看桃李，依倚年华。","杨柳藏鸦。","又是无言飐落花。","春风一面长含笑，偷顾羞遮。","分付谁家。","把酒花前试问他。"]},{"i":"c-d520d5ba936e","t":"丑奴儿・采桑子","a":"黄庭坚","d":"宋","g":"词","p":["济楚好得些。","憔悴损、都是因它。","那回得句闲言语，傍人尽道，你管又还鬼那人唦。","得过口儿嘛。","直勾得、风了自家。","是即好意也毒害，你还甜杀人了，怎生申报孩儿。"]},{"i":"c-386f103db34e","t":"菩萨蛮","a":"黄庭坚","d":"宋","g":"词","p":["细腰宫外清明雨。","云阳台上烟如缕。","云雨暗巫山。","流人殊未还。","阿谁知此意。","解遣双壶至。","不是白头新。","周郎旧可人。"]},{"i":"c-0507fb94f921","t":"鹧鸪天","a":"黄庭坚","d":"宋","g":"词","p":["塞雁初来秋影寒。","霜林风过叶声乾。","龙山落帽千年事，我对西风犹整冠。","兰委佩，菊堪餐。","人情时事半悲欢。","但将酩酊酬佳节，更把茱萸仔细看。"]},{"i":"c-b1e9ba679483","t":"鹧鸪天","a":"黄庭坚","d":"宋","g":"词","p":["节去蜂愁蝶不知。","晓庭环绕折残枝。","自然今日人心别，未必秋香一夜衰。","无闲事，即芳期。","菊花须插满头归。","宜将酩酊酬佳节，不用登临送落晖。"]},{"i":"c-dec49adad531","t":"鹧鸪天","a":"黄庭坚","d":"宋","g":"词","p":["闻说君家有翠娥。","施朱施粉总嫌多。","背人语处藏珠履，覰得羞时整玉梭。","拖远岫，压横波。","何时传酒更传歌。","为君写就黄庭了，不要山阴道士鹅。"]},{"i":"c-87980a8bc288","t":"少年心","a":"黄庭坚","d":"宋","g":"词","p":["对景惹起愁闷。","染相思、病成方寸。","是阿谁先有意，阿谁薄幸。","斗顿恁、少喜多嗔。","合下休传音问。","你有我、我无你分。","似合欢桃核，真堪人恨。","心儿里、有两个人人。"]},{"i":"c-76ee6413d292","t":"少年心","a":"黄庭坚","d":"宋","g":"词","p":["心里人人，暂不见、霎时难过。","天生你要憔悴我。","把心头从前鬼，著手摩挲。","抖擞了、百病销磨。","见说那厮脾鳖热。","大不成我便与拆破。","待来时、鬲上与厮噷则个。","温存著、且教推磨。"]},{"i":"c-c16e506b5c49","t":"点绛唇","a":"黄庭坚","d":"宋","g":"词","p":["几日无书，举头欲问西来燕。","世情梦幻。","复作如斯观。","自叹人生，分合常相半。","戎虽远。","念中相见。","不托鱼和雁。"]},{"i":"c-3a502b4c6e29","t":"点绛唇","a":"黄庭坚","d":"宋","g":"词","p":["罗带双垂，妙香长恁携纤手。","半妆红豆。","各自相思瘦。","闻道伊家，终日眉儿皱。","不能勾。","泪珠轻溜。","裛损揉蓝袖。"]},{"i":"c-7aa233697505","t":"南乡子","a":"黄庭坚","d":"宋","g":"词","p":["诸将说封侯。","短笛长歌独倚楼。","万事尽随风雨去，休休。","戏马台南金络头。","催酒莫迟留。","酒味今秋似去秋。","花向老人头上笑，羞羞。","白发簪花不解愁。"]},{"i":"c-b58441edb2a7","t":"南歌子","a":"黄庭坚","d":"宋","g":"词","p":["槐绿低窗暗，榴红照眼明。","玉人邀我少留行。","无奈一帆烟雨、画船轻。","柳叶随歌皱，梨花与泪倾。","别时不似见时情。","今夜月明江上、酒初醒。"]},{"i":"c-6c58590c6ef1","t":"更漏子","a":"黄庭坚","d":"宋","g":"词","p":["体妖娆，鬟婀娜。","玉甲银筝照座。","危柱促，曲声残。","王孙带笑看。","休休休，莫莫莫。","愁拨个丝中索。","了了了，玄玄玄。","山僧无碗禅。"]},{"i":"c-03ae7e00f2b6","t":"好事近","a":"黄庭坚","d":"宋","g":"词","p":["歌罢酒阑时，潇洒座中风色。","主礼到君须尽，奈宾朋南北。","暂时分散总寻常，难堪久离拆。","不似建溪春草，解留连佳客。"]},{"i":"c-b726a426c55e","t":"好事近","a":"黄庭坚","d":"宋","g":"词","p":["一弄醒心弦，情在两山斜叠。","弹到古人愁处，有真珠承睫。","使君来去本无心，休泪界红颊。","自恨老来憎酒，负十分金叶。"]},{"i":"c-976734ed5777","t":"好事近","a":"黄庭坚","d":"宋","g":"词","p":["不见片时霎，魂梦镇相随著。","因甚近新无据，误窃香深约。","思量模样忔憎儿，恶又怎生恶。","终待共伊相见，与佯佯奚落。"]},{"i":"c-9dd179c77bf1","t":"喝火令","a":"黄庭坚","d":"宋","g":"词","p":["见晚情如旧，交疏分已深。","舞时歌处动人心。","烟水数年魂梦，无处可追寻。","昨夜灯前见，重题汉上襟。","便愁云雨又难寻。","晓也星稀，晓也月西沈。","晓也雁行低度，不会寄芳音。"]},{"i":"c-0e6ccb198623","t":"留春令","a":"黄庭坚","d":"宋","g":"词","p":["江南一雁横秋水。","叹咫尺、断行千里。","回纹机上字纵横，欲寄远、凭谁是。","谢客池塘春都未。","微微动、短墙桃李。","半阴才暖却清寒，是瘦损、人天气。"]},{"i":"c-9d4eedcf18db","t":"宴桃源・如梦令","a":"黄庭坚","d":"宋","g":"词","p":["天气把人僝僽。","落絮游丝时候。","茶饭可曾忺，镜中赢得销瘦。","生受。","生受。","更被养娘催绣。"]},{"i":"c-198069144151","t":"雪花飞","a":"黄庭坚","d":"宋","g":"词","p":["携手青云路稳，天声迤逦传呼。","袍笏恩章乍赐，春满皇都。","何处难忘酒，琼花照玉壶。","归袅丝梢竞醉，雪舞郊衢。"]},{"i":"c-588885655cf0","t":"下水船","a":"黄庭坚","d":"宋","g":"词","p":["总领神仙侣。","齐到青云歧路。","丹禁风微，咫尺谛闻天语。","尽荣遇。","看即如龙变化，一掷灵梭风雨。","真游处。","上苑寻春去。","芳草芊芊迎步。","几曲笙歌，樱桃艳里欢聚。","瑶觞举。","回祝尧龄万万，端的君恩难负。"]},{"i":"c-1ffb4cf7f091","t":"贺圣朝","a":"黄庭坚","d":"宋","g":"词","p":["脱霜披茜初登第。","名高得意。","樱桃荣宴玉墀游，领群仙行缀。","佳人何事轻相戏。","道得之何济。","君家声誉古无双，且均平居二。"]},{"i":"c-64345da52718","t":"青玉案","a":"黄庭坚","d":"宋","g":"词","p":["烟中一线来时路。","极目送、归鸿去。","第四阳关云不度。","山胡新啭，子规言语。","正在人愁处。","忧能损性休朝暮。","忆我当年醉时句。","渡水穿云心已许。","暮年光景，小轩南浦。","同卷西山雨。"]},{"i":"c-df3c9dae1a4b","t":"沁园春","a":"黄庭坚","d":"宋","g":"词","p":["把我身心，为伊烦恼，算天便知。","恨一回相见，百方作计，未能偎倚，早觅东西。","镜里拈花，水中捉月，觑著无由得近伊。","添憔悴，镇花销翠减，玉瘦香肌。","奴儿。","又有行期。","你去即无妨我共谁。","向眼前常见，心犹未足，怎生禁得，真个分离。","地角天涯，我随君去。","掘井为盟无改移。","君须是，做些儿相度，莫待临时。"]},{"i":"c-744b5872de29","t":"千秋岁","a":"黄庭坚","d":"宋","g":"词","p":["苑边花外。","记得同朝退。","飞骑轧，鸣珂碎。","齐歌云绕扇，赵舞风回带。","岩鼓断，杯盘狼藉犹相对。","洒泪谁能会。","醉卧藤阴盖。","人已去，词空在。","兔园高宴悄，虎观英游改。","重感慨，波涛万顷珠沈海。"]},{"i":"c-0b93183415c0","t":"千秋岁","a":"黄庭坚","d":"宋","g":"词","p":["世间好事。","恰恁厮当对。","乍夜永，凉天气。","雨稀帘外滴，香篆盘中字。","长入梦，如今见也分明是。","欢极娇无力，玉软花敧坠。","钗罥袖，云堆臂。","灯斜明媚眼，汗浃瞢腾醉。","奴奴睡，奴奴睡也奴奴睡。"]},{"i":"c-1f5075a6487c","t":"河传","a":"黄庭坚","d":"宋","g":"词","p":["心情老懒。","对歌对舞，犹是当时眼。","巧笑靓妆，近我衰容华鬓。","似扶著、卖卜算。","思量好个当年见。","催酒催更，只怕归期短。","饮散灯稀，背锁落花深院。","好杀人、天不管。"]},{"i":"c-ef6311505384","t":"望江东","a":"黄庭坚","d":"宋","g":"词","p":["江水西头隔烟树。","望不见、江东路。","思量只有梦来去。","更不怕、江阑住。","灯前写了书无数。","算没个、人传与。","直饶寻得雁分付。","又还是、秋将暮。"]},{"i":"c-70bb6172789b","t":"桃源忆故人","a":"黄庭坚","d":"宋","g":"词","p":["碧天露洗春容净。","淡月晓收残晕。","花上密烟飘尽。","花底莺声嫩。","云归楚峡厌厌困。","两点遥山新恨。","和泪暗弹红粉。","生怕人来问。"]},{"i":"c-0d141697c993","t":"卜算子","a":"黄庭坚","d":"宋","g":"词","p":["要见不得见，要近不得近。","试问得君多少怜，管不解、多於恨。","禁止不得泪，忍管不得闷。","天上人间有底愁，向个里、都谙尽。"]},{"i":"c-5d079f88affe","t":"蝶恋花","a":"黄庭坚","d":"宋","g":"词","p":["海角芳菲留不住。","笔下风生，吹入青云去。","仙籍有名天赐与。","致君事业安排取。","要识世间平坦路。","当使人人，各有安身处。","黑发便逢尧舜主。","笑人白首耕南亩。"]},{"i":"c-7726d79880fc","t":"浣溪沙","a":"黄庭坚","d":"宋","g":"词","p":["飞鹊台前晕翠蛾。","千金新买帝青螺。","最难如意为情多。","几处泪痕留醉袖，一春愁思近横波。","远山低尽不成歌。"]},{"i":"c-f9da4e39e81b","t":"浣溪沙","a":"黄庭坚","d":"宋","g":"词","p":["一叶扁舟卷画帘。","老妻学饮伴清谈。","人传诗句满江南。","林下猿垂窥涤砚，岩前鹿卧看收帆。","杜鹃声乱水如环。"]},{"i":"c-5fd048059ec4","t":"诉衷情","a":"黄庭坚","d":"宋","g":"词","p":["小桃灼灼柳鬖鬖。","春色满江南。","雨晴风暖烟淡，天气正醺酣。","山泼黛，水挼蓝。","翠相搀。","歌楼酒旆，故故招人，权典青衫。"]},{"i":"c-308c1e9cb58d","t":"诉衷情","a":"黄庭坚","d":"宋","g":"词","p":["旋揎玉指著红靴。","宛宛斗弯讹。","天然自有殊态，供愁黛、不须多。","分远岫，压横波。","妙难过。","自敧枕处，独倚阑时，不奈颦何。"]},{"i":"c-9f5512c072d6","t":"诉衷情","a":"黄庭坚","d":"宋","g":"词","p":["珠帘绣幕卷轻霜。","呵手试梅妆。","都缘自有离恨，故画作、远山长。","思往事，惜流光。","恨难忘。","未歌先敛，欲笑还颦，最断人肠。"]},{"i":"c-5e697bab3b74","t":"昼夜乐","a":"黄庭坚","d":"宋","g":"词","p":["夜深记得临歧语。","说花时、归来去。","教人每日思量，到处与谁分付。","其奈冤家无定据。","约云朝、又还雨暮。","将泪入鸳衾，总不成行步。","元来也解知思虑。","一封书、深相许。","情知玉帐堪欢，为向金门进取。","直待腰金拖紫后，有夫人、县君相与。","争奈会分疏，没嫌伊门路。"]},{"i":"c-e9f6abee9d6c","t":"一落索","a":"黄庭坚","d":"宋","g":"词","p":["谁道秋来烟景素。","任游人不顾。","一番时态一番新，到得意、皆欢慕。","紫萸黄菊繁华处。","对风庭月露。","愁来即便去寻芳，更作甚、悲秋赋。"]},{"i":"c-198f9fd85019","t":"满庭芳","a":"黄庭坚","d":"宋","g":"词","p":["风力驱寒，云容呈瑞，晓来到处花飞。","遍装琼树，春意到南枝。","便是渔蓑旧画，纶竿重、横玉低垂。","今宵里，香闺邃馆，幽赏事偏宜。","风流，金马客，歌鬟醉拥，乌帽斜敧。","问人间何处，鹏运天池。","且共周郎按曲，音微误、首已先回。","同心事，丹山路稳，长伴彩鸾归。"]},{"i":"c-f12542c33747","t":"西江月","a":"黄庭坚","d":"宋","g":"词","p":["细细风清撼竹，迟迟日暖开花。","香帏深卧醉人家。","媚语娇声娅姹。","姹娅声娇语媚，家人醉卧深帏。","香花开暖日迟迟。","竹撼清风细细。"]},{"i":"c-a194a74a5941","t":"失调名","a":"黄庭坚","d":"宋","g":"词","p":["直须把、茱萸遍插，看满座、细嗅清香。"]},{"i":"c-01c997ab23a1","t":"好事近","a":"黄庭坚","d":"宋","g":"词","p":["潇洒荐冰盘，满座暗惊香集。","久后一般风味，问几人知得。","画堂饮散已归来，清润转更惜。","留取酒醒时候，助茗瓯春色。"]},{"i":"c-0c77827acd0d","t":"瑞鹤仙","a":"黄庭坚","d":"宋","g":"词","p":["环滁皆山也。","望蔚然深秀，琅琊山也。","山行六七里，有翼然泉上，醉翁亭也。","翁之乐也。","得之心、寓之酒也。","更野芳佳木，风高日出，景无穷也。","游也。","山肴野蔌，酒冽泉香，沸筹觥也。","太守醉也。","喧哗众宾欢也。","况宴酣之乐、非丝非竹，太守乐其乐也。","问当时、太守为谁，醉翁是也。"]},{"i":"c-5cfac4fae4f0","t":"蓦山溪","a":"黄庭坚","d":"宋","g":"词","p":["朝来风日，陡觉春衫便。","翠柳艳明眉，戏秋千、谁家倩盼。","烟匀露洗，草色媚横塘，平沙软。","雕轮转。","行乐闻弦管。","追思年少，走马寻芳伴。","一醉几缠头，过扬州、珠帘尽卷。","而今老矣，花似雾中看，欢喜浅。","天涯远。","信马归来晚。"]},{"i":"c-19bb1d843d4f","t":"捣练子","a":"黄庭坚","d":"宋","g":"词","p":["梅凋粉，柳摇金。","微雨轻风敛陌尘。","厚约深盟何处诉，除非重见那人人。"]},{"i":"c-8a8dd22d5b61","t":"减字浣溪沙・浣溪沙","a":"贺铸","d":"宋","g":"词","p":["浮动花钗影鬓烟。","浅妆浓笑有馀妍。","酒醺檀点语凭肩。","留不住时分钿镜，旧曾行处失金莲。","碧云芳草恨年年。"]},{"i":"c-aef080263a91","t":"减字浣溪沙・浣溪沙","a":"贺铸","d":"宋","g":"词","p":["两点春山一寸波。","当筵娇甚不成歌。","动人情态可须多。","金井露寒风下叶，画桥云断月侵河。","厌厌此夜奈愁何。"]},{"i":"c-47df23d6f100","t":"减字浣溪沙・浣溪沙","a":"贺铸","d":"宋","g":"词","p":["清浅陂塘藕叶乾。","细风蔬雨鹭鸶寒。","半垂帘幕倚阑干。","惆怅窃香人不见，几回憔悴后庭兰。","行云可是渡江难。"]},{"i":"c-5f60cf8a47fd","t":"相思引","a":"贺铸","d":"宋","g":"词","p":["团扇单衣杨柳陌。","花似春风□无迹。","赖白玉香奁供汾泽。","借秀色。","添春色。","借秀色。","添春色。","云幕华灯张绮席。","半醉客。","留醒客。","半醉客。","留醒客。","渐促膝倾鬟琴差拍。","问此夕。","知何夕。","问此夕。","知何夕。"]},{"i":"c-d72b81b783dd","t":"献金杯・厌金杯","a":"贺铸","d":"宋","g":"词","p":["风软香迟，花深漏短。","可怜宵、画堂春半。","碧纱窗影，卷帐蜡灯红，鸳枕畔。","密写乌丝一段。","采苹溪晚。","拾翠沙空，尽愁倚、梦云飞观。","木兰艇子，几日渡江来，心目断。","桃叶青山隔岸。"]},{"i":"c-60e4aeb49d74","t":"清平乐","a":"贺铸","d":"宋","g":"词","p":["阴晴未定。","薄日烘云影。","临水朱门花一径。","尽日鸟啼人静。","厌厌几许春情。","可怜老去兰成。","看取镊残双鬓，不随芳草重生。"]},{"i":"c-4f0e64d6ad3e","t":"清平乐","a":"贺铸","d":"宋","g":"词","p":["小桃初谢。","双燕还来也。","记得年时寒食下。","紫陌青门游冶。","楚城满目春华。","可堪游子思家。","惟有夜来归梦，不知身在天涯。"]},{"i":"c-0df55318e404","t":"摊破浣溪沙・山花子","a":"贺铸","d":"宋","g":"词","p":["湖上秋深藕叶黄。","清霜销瘦损垂杨。","洲嘴嫩沙斜照暖，睡鸳鸯。","红粉莲娃何处在，西风不为管馀香。","今夜月明闻水调，断人肠。"]},{"i":"c-d05d4d4f77c8","t":"摊破浣溪沙・山花子","a":"贺铸","d":"宋","g":"词","p":["双凤箫声隔彩霞。","朱门深闭七香车。","何处探春寻旧约，谢娘家。","旖旎细风飘水麝，玲珑残雪浸山茶。","饮罢西厢帘影外，玉蟾斜。"]},{"i":"c-5914dd88802e","t":"惜双双・惜分飞","a":"贺铸","d":"宋","g":"词","p":["皎镜平湖三十里。","碧玉山围四际。","莲荡香风里。","彩鸳鸯觉双飞起。","明月多情随舵尾。","偏照空床翠被。","回首笙歌地。","醉更衣处长相记。"]},{"i":"c-13380ce57dd6","t":"思越人・朝天子","a":"贺铸","d":"宋","g":"词","p":["紫府东风放夜时。","步莲秾李伴人归。","五更钟动笙歌散，十里月明灯火稀。","香苒苒，梦依依。","天涯寒尽减春衣。","凤凰城阕知何处，寥落星河一雁飞。"]},{"i":"c-6cf8a24a3c5e","t":"思越人・朝天子","a":"贺铸","d":"宋","g":"词","p":["怊怅离亭断采襟。","碧云明月两关心。","几行书尾情何限，一尺裙腰瘦不禁。","遥夜半，曲房深。","有时昵语话如今。","侵窗冷雨灯生晕，泪湿罗笺楚调吟。"]},{"i":"c-b814ecfd027a","t":"鹤冲天","a":"贺铸","d":"宋","g":"词","p":["冬冬鼓动，花外沈残漏。","华月万枝灯，还清昼。","广陌衣香度，飞盖影、相先后。","个处频回首。","锦房西去，期约武陵西口。","当时早恨欢难偶。","可堪流浪远，分携久。","小畹兰英在，轻付与、何人手。","不似长亭柳。","舞枫眠雨，伴我一春销瘦。"]},{"i":"c-c570dd793f54","t":"小重山","a":"贺铸","d":"宋","g":"词","p":["飘径梅英雪未融。","芳菲消息到，杏梢红。","隔年欢事水西东。","凝思久，不语坐书空。","回想夹城中。","采山箫鼓沸，绮罗丛。","钿轮珠网玉花骢。","香陌上，谁与斗春风。"]},{"i":"c-39e4fa4772dc","t":"六州歌头","a":"贺铸","d":"宋","g":"词","p":["少年侠气，交结五都雄。","肝胆洞。","毛发耸。","立谈中。","死生同。","一诺千金重。","推翘勇。","衿豪踪。","轻盖拥。","聊飞鞚。","斗城东。","轰饮酒炉，春色浮寒瓮。","吸海垂虹。","闲呼鹰嗾犬，白羽摘雕弓。","狡穴俄空。","乐匆匆。","似黄粱梦。","辞丹凤。","明月共。","漾孤篷。","官冗从。","怀倥偬。","落尘笼。","薄书从。","鶡弁如云众。","共粗用。","忽奇功。","笳鼓动。","渔阳弄。","思悲翁。","不请长缨，系取天娇种。","剑吼西风。","恨登山临水，手寄七弦桐。","目送归鸿。"]},{"i":"c-fd20c06e0aae","t":"浣溪沙","a":"贺铸","d":"宋","g":"词","p":["翠縠参差拂水风。","暖云如絮扑低空。","丽人波脸觉春融。","缨挂宝钗初促席，檀高微注玉杯红。","芳醪何似此情浓。"]},{"i":"c-55214865f32b","t":"浣溪沙","a":"贺铸","d":"宋","g":"词","p":["云母窗前歇绣针。","低鬟凝思坐调琴。","玉纤纤按十三金。","归卧文园犹带酒，柳花飞度画堂阴。","只凭双燕话春心。"]},{"i":"c-626eff7e109f","t":"浣溪沙","a":"贺铸","d":"宋","g":"词","p":["叠鼓新歌百样娇。","铜丸玉腕促云谣。","揭帘飞瓦雹声焦。","九渠池边杨柳陌，香轮轧轧马箫箫。","细风妆面酒痕销。"]},{"i":"c-f68d51d4208b","t":"江城子","a":"贺铸","d":"宋","g":"词","p":["麝熏微度绣芙蓉。","翠衾重。","画堂空。","前夜偷期，相见却匆匆。","心事两知何处问，依约是，梦中逢。","坐疑行听竹窗风。","出帘栊。","杳无踪。","已过黄昏，缠动寺楼钟。","暮雨不来春又去，花满地，月朦胧。"]},{"i":"c-c7e64a7c8092","t":"浪淘沙","a":"贺铸","d":"宋","g":"词","p":["一叶忽惊秋。","分付东流。","殷勤为过白苹洲。","洲上小楼帘半卷，应认归舟。","回首恋朋游。","迹去心留。","歌尘萧散梦云收。","惟有尊前曾见月，相伴人愁。"]},{"i":"c-b72a49ea0ad7","t":"木兰花・玉楼春","a":"贺铸","d":"宋","g":"词","p":["佩环声认腰肢软。","风里麝熏知近远。","此身常羡玉妆台，得见晓来梳画面。","回廊几步通深院。","一桁绣衣帘不卷。","酒阑歌罢欲黄昏，肠断归巢双燕燕。"]},{"i":"c-c8704cef0c1a","t":"木兰花・玉楼春","a":"贺铸","d":"宋","g":"词","p":["银黄雁柱香檀拨。","镂板三声催细抹。","舞腰轻怯绛裙长，羞按筑球花十八。","东城柳岸匆匆发。","画舫一篙烟水阔。","可怜单枕欲眠时，还见尊前前夜月。"]},{"i":"c-e8793049704a","t":"蝶恋花","a":"贺铸","d":"宋","g":"词","p":["小院朱扉开一扇。","内样新妆，镜里分明见。","眉晕半深唇注浅。","朵云冠子偏宜面。","被掩芙蓉熏麝煎。","帘影沈沈，祗有双飞燕。","心事向人犹腼腆。","强来窗下寻针线。"]},{"i":"c-e4eea72e90d9","t":"失调名","a":"贺铸","d":"宋","g":"词","p":["罗帷映月，玉研生冰。"]},{"i":"c-189b6a71e5f8","t":"失调名","a":"贺铸","d":"宋","g":"词","p":["风头梦、吹无迹。"]},{"i":"c-94cb6116ba1b","t":"减字木兰花","a":"贺铸","d":"宋","g":"词","p":["簪花照镜。","客鬓萧萧都不整。","拟倩东□。","化作尊前如梦云。","风香月影。","信是瑶台清夜永。","深闭重门。","牵绊刘郎别后魂。"]},{"i":"c-80b18e62f886","t":"凤栖梧・蝶恋花","a":"贺铸","d":"宋","g":"词","p":["为问宛溪桥畔柳。","拂水倡条，几赠行人手。","一样叶眉偏解皱。","白绵飞尽因谁瘦。","今日离亭还对酒。","唱断青青，好去休回首。","美阴向人疏似旧。","何须更待秋风后。"]},{"i":"c-92b5849e0a58","t":"南柯子・南歌子","a":"贺铸","d":"宋","g":"词","p":["斗酒才供泪，扁舟只载愁。","画桥青柳小朱楼。","犹记出城车马、为迟留。","有恨花空委，无情水自流。","河阳新鬓尽禁秋。","萧散楚云巫雨、生此休。"]},{"i":"c-a8bab9748692","t":"谒金门","a":"贺铸","d":"宋","g":"词","p":["杨花落。","燕子横川朱阁。","常恨春醪如水薄。","闲愁无处著。","绿野带江山络角。","桃叶参差前约。","历历短樯沙外泊。","东风晚来恶。"]},{"i":"c-417763f928b8","t":"小梅花・梅花引","a":"贺铸","d":"宋","g":"词","p":["思前别。","记时节。","美人颜色如花发。","美人归。","天一涯。","娟娟姮娥，三五满还亏。","翠眉蝉鬓生离诀。","遥望青楼心欲绝。","梦中寻。","卧巫云。","觉来珠泪，滴向湘水深。","愁无已。","奏绿绮。","历历高山与流水。","妙通神。","觉知音。","不知暮雨朝云、何山岑。","相思无计堪可比。","珠箔雕阑集千里。","漏将分。","月窗明。","一夜梅花忽开、疑是君。"]},{"i":"c-81cbdfdd19ce","t":"乌啼月・乌夜啼","a":"贺铸","d":"宋","g":"词","p":["牛女相望处，星桥不碍东西。","重墙未抵蓬山远，却恨画楼低。","细字频传幽怨，凝缸长照单栖。","城乌可是知人意，偏向月明啼。"]},{"i":"c-1810446b8cba","t":"簇水近","a":"贺铸","d":"宋","g":"词","p":["一笛清风弄袖，新月梳云缕。","澄凉夜色，缠过几点黄昏雨。","侠少朋游，正喜九陌消尘土。","鞭穗袅、紫骝花步。","过朱户。","认得宫妆，为谁重扫新眉妩。","徘徊片响难问，桃李都无语。","十二青楼下，指灯火章台路。","不念人、肠断归去。"]},{"i":"c-afe7d0ba5a24","t":"画眉郎・好女儿","a":"贺铸","d":"宋","g":"词","p":["雪絮雕章。","梅粉华妆。","小芒台、榧机罗湘素，鼓铜蟾砚滴，金雕琴写，玉燕钗梁。","五马徘徊长路，漫非意、凤求凰。","认兰情、自有怜才处，似题桥贵客，栽花潘令，真画眉郎。"]},{"i":"c-a025a4151160","t":"试周郎・诉衷情","a":"贺铸","d":"宋","g":"词","p":["乔家深闭郁金堂。","朝镜事梅妆。","云鬟翠钿浮动，微步拥钗梁。","情尚秘，色犹庄。","递瞻相。","弄丝调管，时误新声，翻试周郎。"]},{"i":"c-a231438f434f","t":"新念别・夜游宫","a":"贺铸","d":"宋","g":"词","p":["湖上兰舟暮发。","扬州梦断灯明灭。","想见琼花开似雪。","帽檐香，玉纤纤，曾为折。","渔管吹还咽。","问何意、煎人愁绝。","江北江南新念别。","掩芳尊，与谁同，今夜月。"]},{"i":"c-2fefff8bcf9b","t":"谒金门","a":"贺铸","d":"宋","g":"词","p":["溪声急。","无数落花漂出。","燕子分泥蜂酿蜜。","迟迟艳风日。","须信芳菲随失。","况复佳期难必。","拟把此情书万一。","愁多翻阁笔。"]},{"i":"c-4ddd9012e41a","t":"减字木兰花","a":"贺铸","d":"宋","g":"词","p":["冷香浮动。","望处欲声胡蝶梦。","晓日曈昽。","愁见凝酥暖渐融。","鼓催歌送。","芳酒一尊谁与共。","寂寞墙东。","门掩黄昏满院风。"]},{"i":"c-2b933c4a0341","t":"摊破浣溪沙・山花子","a":"贺铸","d":"宋","g":"词","p":["锦鞯未弦瑟瑟徽。","玉纤新拟凤双飞。","缥缈烛烟花暮暗，就更衣。","约略整环钗影动，迟回顾步佩声微。","宛是春风胡蝶舞，带香归。"]},{"i":"c-2e3363c43fba","t":"瑶台第一层","a":"赵仲御","d":"宋","g":"词","p":["嶰管声催。","人报道、嫦娥步月来。","凤灯鸾矩，寒轻廉箔，光泛楼台。","万年春未老，更帝乡日月蓬莱。","从仙仗，看星河银界，锦绣天街。","欢陪。","千官万骑，九霄人在五云堆。","紫袍光里，星球宛转，花影徘徊。","未央宫漏水，散异香、龙阙崔嵬。","翠舆回。","奏仙歌韶吹，宝殿尊罍。"]},{"i":"c-c3042c2f1302","t":"蓦山溪","a":"仲殊","d":"宋","g":"词","p":["清江平淡，疏雨和烟染。","春在广寒宫，付江梅、先开素艳。","年年第一，相见越溪东，云体态，雪精神，不把年华占。","山亭水榭，别恨多销黯。","又是主人来，更不辜、香心一点。","题诗才思，清似玉壶冰，轻回顾，落尊前，桃杏声华减。"]},{"i":"c-a8a8eb660f0c","t":"鹊踏枝・蝶恋花","a":"仲殊","d":"宋","g":"词","p":["斜日平山寒已薄。","雪过松梢，犹有残英落。","晚色际天天似幕。","一尊先与东风约。","邀得红梅同宴乐。","酒面融春，春满纤纤萼。","客意为伊浑忘却。","归船且傍花阴泊。"]},{"i":"c-6980efbfd6bd","t":"点绛唇","a":"仲殊","d":"宋","g":"词","p":["春遇瑶池，长空飞下残英片。","素光围练。","寒透笙歌院。","莫把寿阳，妆信传书箭。","掩香面。","汉宫寻遍。","月里还相见。"]},{"i":"c-e4c8e13470f9","t":"南歌子","a":"仲殊","d":"宋","g":"词","p":["十里青山远，潮平陆带沙。","数声啼鸟怨年华。","又是凄凉时候、在天涯。","白露收残暑，清风衬晚霞。","绿杨堤畔闹荷花。","记得年时沽酒、那人家。"]},{"i":"c-f23960881bb2","t":"减字木兰花","a":"仲殊","d":"宋","g":"词","p":["谁将妙笔。","写就素缣三百匹。","天下应无。","此是钱塘江上图。","一般奇绝。","云淡天低秋夜月。","费尽丹青。","只这些儿画不成。"]},{"i":"c-be1a1e26c3e2","t":"减字木兰花","a":"仲殊","d":"宋","g":"词","p":["江南三月。","犹有枝头千点雪。","邀上芳尊。","却占东君一半春。","尊前眼底。","南国风光都在此。","移过江来。","从此江南不复开。"]},{"i":"c-57a8ba6ae3c9","t":"南歌子","a":"仲殊","d":"宋","g":"词","p":["解舞清平乐，如今说向谁。","红炉片雪上钳锤。","打就金毛狮子、也堪疑。","木女明开眼，泥人暗皱眉。","蟠桃已是著花迟。","不向春风一笑、待何时。"]},{"i":"c-30c5bfcdc743","t":"踏莎行","a":"仲殊","d":"宋","g":"词","p":["浓润侵衣，暗香飘砌。","雨中花色添憔悴。","凤鞋湿透立多时，不言不语厌厌地。","眉上新愁，手中文字。","因何不倩鳞鸿寄。","想伊只诉薄情人，官中谁管闲公事。"]},{"i":"c-2ded787ce24e","t":"金蕉叶","a":"仲殊","d":"宋","g":"词","p":["丛霄逸韵祥烟渺。","摇金翠、玲珑三岛。","地控全吴，山横旧楚春来早。","千里断云芳草。","六朝遗恨连江表。","都分付、倚楼吟啸。","铁瓮城头，一声画角吹残照。","带夜潮来到。"]}]